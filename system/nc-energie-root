#!/bin/bash
# nc-energie-root : l'assistant root des profils d'énergie poussés (nc-energie). Il ne fait QUE les réglages de la liste
# ci-dessous, avec des valeurs de la liste. Installé par install.sh dans /usr/local/bin (root:root 0755), avec une règle
# sudo à commandes exactes (une ligne par sous-commande et valeur : « nc-energie-root sudoers UTILISATEUR » l'écrit).
#
#   nc-energie-root etat                      l'état lu (clé=valeur), sans rien écrire ni exiger root
#   nc-energie-root epp performance|balance_performance|balance_power|power
#   nc-energie-root boost on|off
#   nc-energie-root freqmax 100|80|60         fréquence maximale du processeur, en % de cpuinfo_max_freq
#   nc-energie-root platform low-power|quiet|cool|balanced|balanced-performance|performance
#                                             (seulement si le noyau le propose : platform_profile_choices ; la valeur est
#                                             relue après l'écriture, et les contrôleurs de /sys/class/platform-profile
#                                             aussi, en lecture seule, toutes les 0,2 s pendant 5 s au plus : un autre résultat = code 4 ou 5, jamais un faux succès)
#   nc-energie-root nvidia-pm auto|on         gestion d'énergie de la carte NVIDIA (power/control)
#   nc-energie-root nvidia-pl 0|1|2|3         limite de puissance NVIDIA : 0 = minimum, 3 = maximum, entre les deux en
#                                             paliers égaux ; seulement si la carte est ACTIVE (jamais réveillée pour ça)
#   nc-energie-root wifi-ps on|off            économie d'énergie du Wi-Fi (iw)
#   nc-energie-root usb-autosuspend on|off    mise en veille des périphériques USB, sauf ceux de saisie (clavier, souris)
#   nc-energie-root eth-pm on|off             veille des cartes Ethernet PCI (classe 0x0200) : on = permise (auto), off = jamais
#   nc-energie-root audio-ps on|off           économie d'énergie de la puce audio (snd_hda_intel)
#   nc-energie-root kbd 0|1|2|3               niveau du clavier lumineux (borné au maximum du clavier)
#   nc-energie-root rapl jeu-30-45|jeu-45-65|normal
#                                             limites PL1/PL2 du processeur (intel-rapl:0) ; l'origine est gardée au premier
#                                             passage en jeu (/var/lib/nc-energie/rapl-origine, 0600) et relue par « normal »
#   nc-energie-root ventilateurs max|auto     ventilateurs du portable Acer Nitro (nitro_sense), seulement s'ils existent
#   nc-energie-root gpu-frequence jeu|normal  fréquence de la carte NVIDIA (nvidia-smi -lgc 210,1500 / -rgc), seulement si
#                                             la carte n'est PAS endormie (jamais réveillée pour ça)
#   nc-energie-root puissance                 énergie du paquet (et de psys s'il existe), en mJ, lecture seule ; une
#                                             lecture par seconde au plus (code 5 entre deux)
#   nc-energie-root sudoers UTILISATEUR       la ligne sudo exacte pour ce compte (sans rien écrire)
#
# Garanties : les chemins de /sys sont construits ICI, jamais reçus ; chaque écriture vérifie que le fichier existe ;
# aucune chaîne libre n'est acceptée (sous-commande et valeur sont comparées à une liste) ; ventilateurs seulement
# max ou auto, ni undervolt, ni TDP brut, ni écriture libre. Rien n'est réappliqué tout seul au démarrage.
# Codes de sortie : 0 fait, 1 échec ou pas root, 2 sous-commande ou valeur refusée, 3 rien de tel sur ce PC,
# 4 écrit mais la valeur relue est différente ou instable (réécrite par un service, ou refusée par le firmware),
# 5 profil global juste mais un contrôleur de la plateforme garde un autre profil.
# Essais : NC_ENERGIE_RACINE (faux /sys) et NC_ENERGIE_BIN (faux outils) ne sont lus QUE hors root (sudo les efface de
# toute façon) : lancé en root, cet assistant ne regarde que le vrai /sys et le PATH système.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C   # jamais le PATH ni la langue de l'appelant (appel en root sans secure_path)
S=/sys
ESSAI=0
if [ "$(id -u)" != 0 ] && [ -n "${NC_ENERGIE_RACINE:-}" ]; then
  S="$NC_ENERGIE_RACINE"; ESSAI=1
  [ -n "${NC_ENERGIE_BIN:-}" ] && PATH="$NC_ENERGIE_BIN:$PATH"
fi
LIB=/var/lib/nc-energie   # la sauvegarde de rapl ; remplaçable seulement hors root (essais)
RUN=/run/nc-energie       # la date de la dernière lecture de « puissance » ; idem
[ "$ESSAI" = 1 ] && RUN="${NC_ENERGIE_RUN:-$S/../nc-energie-run}"   # essai sans dossier donné : à côté du faux /sys
[ "$ESSAI" = 1 ] && [ -n "${NC_ENERGIE_LIB:-}" ] && LIB="$NC_ENERGIE_LIB"

# Les listes (la seule source de vérité : le test de sudoers les relit par « sudoers »)
EPP="performance balance_performance balance_power power"
ONOFF="on off"
FREQ="100 80 60"
PLATEFORME="low-power quiet cool balanced balanced-performance performance"
NVPM="auto on"
NVPL="0 1 2 3"
KBD="0 1 2 3"
RAPL="jeu-30-45 jeu-45-65 normal"
VENT="max auto"
GPUF="jeu normal"

refus() { echo "nc-energie-root: $*" >&2; exit 2; }
absent() { echo "nc-energie-root: $*" >&2; exit 3; }
echec() { echo "nc-energie-root: $*" >&2; exit 1; }
dans() { local x="$1"; shift; local y; for y in "$@"; do [ "$x" = "$y" ] && return 0; done; return 1; }
# Un mot dans une liste lue (séparée par des espaces)
dans_mots() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
# Valeur : un mot de la liste, rien d'autre (« -- » et tout motif sont donc refusés avant d'aller plus loin)
valeur() {   # valeur V liste…
  local v="$1"; shift
  [ -n "$v" ] || refus "valeur manquante"
  dans "$v" "$@" || refus "valeur refusée"
}
racine() {
  [ "$ESSAI" = 1 ] && return 0
  [ "$(id -u)" = 0 ] || echec "à lancer avec sudo."
}
lire() { local f="$1"; [ -r "$f" ] && { read -r l < "$f"; printf '%s' "$l"; }; }
# Écrit dans un fichier qui existe déjà, jamais dans un fichier créé
ecrire() {   # ecrire VALEUR FICHIER
  [ -f "$2" ] || return 1
  printf '%s\n' "$1" 2>/dev/null > "$2"
}

# Cartes NVIDIA : périphériques PCI de classe 0x03xxxx et de fabricant 0x10de
nvidia() {
  local d
  for d in "$S"/bus/pci/devices/*; do
    [ -f "$d/vendor" ] && [ "$(lire "$d/vendor")" = 0x10de ] || continue
    case "$(lire "$d/class")" in 0x03*) printf '%s\n' "$d" ;; esac
  done
}
# Interfaces Wi-Fi : celles qui ont un dossier « wireless » ; le nom vient de /sys et reste un mot simple
wifis() {
  local d n
  for d in "$S"/class/net/*; do
    [ -d "$d/wireless" ] || continue
    n="${d##*/}"
    case "$n" in *[!a-zA-Z0-9_.-]*|''|-*) continue ;; esac
    printf '%s\n' "$n"
  done
}
# Périphériques USB (pas les interfaces « 1-1:1.0 ») jamais mis en veille s'ils sont, ou ont une interface, de saisie
# (03 : clavier, souris), audio (01 : un casque coupé au milieu d'un son), d'impression (07) ou Bluetooth (e0 : la souris
# et le casque sans fil passent par lui)
usbs() {
  local d i garde
  for d in "$S"/bus/usb/devices/*; do
    case "${d##*/}" in *:*) continue ;; esac
    [ -f "$d/power/control" ] || continue
    garde=0
    case "$(lire "$d/bDeviceClass")" in 03|01|07|e0|E0) garde=1 ;; esac
    for i in "$d"/*:*/bInterfaceClass; do
      [ -f "$i" ] || continue
      case "$(lire "$i")" in 03|01|07|e0|E0) garde=1 ;; esac
    done
    [ "$garde" = 0 ] && printf '%s\n' "$d"
  done
}
# Cartes réseau filaires PCI (classe 0x0200xx) dont la veille est réglable ; le nom doit être une adresse PCI
# (dddd:bb:ee.f), rien d'autre (le Wi-Fi est en 0x0280 : jamais touché ici)
eths() {
  local d
  for d in "$S"/bus/pci/devices/*; do
    case "${d##*/}" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]) ;; *) continue ;; esac
    [ -f "$d/power/control" ] || continue
    case "$(lire "$d/class")" in 0x0200[0-9a-f][0-9a-f]) printf '%s\n' "$d" ;; esac
  done
}
politiques() { local p; for p in "$S"/devices/system/cpu/cpufreq/policy[0-9]*; do [ -d "$p" ] && printf '%s\n' "$p"; done; }

do_epp() {
  local p n=0
  for p in $(politiques); do
    [ -f "$p/energy_performance_preference" ] || continue
    dans_mots "$1" "$(lire "$p/energy_performance_available_preferences")" || continue
    ecrire "$1" "$p/energy_performance_preference" || echec "écriture impossible (epp)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de préférence énergie/performance sur ce PC"
}
do_boost() {
  local f="$S/devices/system/cpu/cpufreq/boost" g="$S/devices/system/cpu/intel_pstate/no_turbo"
  if [ -f "$f" ]; then
    if [ "$1" = on ]; then ecrire 1 "$f"; else ecrire 0 "$f"; fi || echec "écriture impossible (boost)"
  elif [ -f "$g" ]; then
    if [ "$1" = on ]; then ecrire 0 "$g"; else ecrire 1 "$g"; fi || echec "écriture impossible (boost)"
  else
    absent "pas de réglage du boost sur ce PC"
  fi
}
do_freqmax() {
  local p n=0 max v
  for p in $(politiques); do
    [ -f "$p/scaling_max_freq" ] && [ -r "$p/cpuinfo_max_freq" ] || continue
    max="$(lire "$p/cpuinfo_max_freq")"
    case "$max" in ''|*[!0-9]*) continue ;; esac
    v=$((max * $1 / 100))
    ecrire "$v" "$p/scaling_max_freq" || echec "écriture impossible (freqmax)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de fréquence maximale réglable sur ce PC"
}
# Contrôleurs de profil du noyau (/sys/class/platform-profile/*) : le nom du dossier est un mot simple, jamais écrit ici
controleurs() {
  local d n
  for d in "$S"/class/platform-profile/platform-profile-*; do
    [ -d "$d" ] || continue
    n="${d##*/}"
    case "$n" in *[!a-zA-Z0-9_.-]*|''|-*) continue ;; esac
    printf '%s\n' "$d"
  done
}
# Texte lu dans /sys pour un message : lettres, chiffres, espaces et « _ . - » seulement, court
propre() { printf '%s' "$1" | tr -cd 'a-zA-Z0-9 _.-' | cut -c1-80; }
do_platform() {
  local f="$S/firmware/acpi/platform_profile" c="$S/firmware/acpi/platform_profile_choices"
  local choix apres d bad="" p
  [ -f "$f" ] && [ -r "$c" ] || absent "pas de profil de plateforme sur ce PC"
  choix="$(lire "$c")"
  # Le profil demandé doit être l'un des choix COMMUNS à tous les contrôleurs (c'est ce que le noyau annonce ici)
  dans_mots "$1" "$choix" || absent "ce PC ne propose pas le profil de plateforme « $1 » (choix du noyau : $(propre "$choix"))"
  # Valeur « custom » : des contrôleurs ont des profils différents ; écrire un profil commun ici les remet tous au même
  ecrire "$1" "$f" || echec "écriture du profil de plateforme refusée par le noyau ou le firmware"
  # Un service (TLP, power-profiles-daemon, tuned) peut le réécrire un instant après : relire toutes les 0,2 s pendant 5 s au
  # plus, jusqu'à la valeur demandée sur 2 lectures de suite (global ET contrôleurs, ceux-ci en lecture seule)
  local i=0 stable=0
  while [ "$i" -lt 25 ]; do
    sleep 0.2
    apres="$(lire "$f")"; bad=""
    for d in $(controleurs); do
      [ -r "$d/profile" ] || continue
      p="$(lire "$d/profile")"
      [ "$p" = "$1" ] || bad="$bad $(propre "$(lire "$d/name")")=$(propre "$p")"
    done
    if [ "$apres" = "$1" ] && [ -z "$bad" ]; then stable=$((stable + 1)); [ "$stable" -ge 2 ] && return 0; else stable=0; fi
    i=$((i + 1))
  done
  if [ "$apres" != "$1" ]; then
    echo "nc-energie-root: profil de la plateforme demandé « $1 », relu « $(propre "$apres") » : un autre service l'a réécrit ou le firmware l'a refusé" >&2
    exit 4
  fi
  if [ -n "$bad" ]; then
    echo "nc-energie-root: profil de plateforme « $1 » écrit, mais des contrôleurs ont un autre profil :$bad" >&2
    exit 5
  fi
  echo "nc-energie-root: profil de plateforme « $1 » non stable : relu différent à un moment" >&2
  exit 4
}
do_nvidia_pm() {
  local d n=0
  for d in $(nvidia); do
    [ -f "$d/power/control" ] || continue
    ecrire "$1" "$d/power/control" || echec "écriture impossible (nvidia-pm)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de carte NVIDIA réglable"
}
do_nvidia_pl() {
  local d actif=0 mn mx w
  for d in $(nvidia); do
    [ "$(lire "$d/power/runtime_status")" = active ] && actif=1
  done
  [ "$actif" = 1 ] || absent "la carte NVIDIA n'est pas active (elle n'est pas réveillée pour ça)"
  command -v nvidia-smi >/dev/null 2>&1 || absent "nvidia-smi absent"
  read -r mn mx <<EOF
$(nvidia-smi --query-gpu=power.min_limit,power.max_limit --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ',')
EOF
  mn="${mn%%.*}"; mx="${mx%%.*}"
  case "$mn$mx" in ''|*[!0-9]*) absent "limites de puissance illisibles" ;; esac
  [ "$mx" -gt "$mn" ] || absent "limites de puissance illisibles"
  w=$((mn + (mx - mn) * $1 / 3))
  # beaucoup de cartes de portable refusent -pl : « rien de tel » (code 3), le profil continue sans ce réglage
  nvidia-smi -pl "$w" >/dev/null 2>&1 || absent "la carte refuse de changer sa limite de puissance"
}
# Deux entiers en µW (1 à 500 W), sinon refus : lus d'une sauvegarde, jamais crus sur parole
rapl_valide() {   # rapl_valide A B
  local x
  for x in "$1" "$2"; do
    case "$x" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#x}" -le 9 ] || return 1
    [ "$x" -ge 1000000 ] && [ "$x" -le 500000000 ] || return 1
  done
}
do_rapl() {
  local r="$S/class/powercap/intel-rapl:0" a b x o1 o2 sauve="$LIB/rapl-origine"
  [ -f "$r/constraint_0_power_limit_uw" ] && [ -f "$r/constraint_1_power_limit_uw" ] || absent "pas de limites RAPL sur ce PC"
  case "$1" in
    jeu-30-45) a=30000000; b=45000000 ;;
    jeu-45-65) a=45000000; b=65000000 ;;
    normal)
      [ -f "$sauve" ] || absent "pas d'origine gardée : rien à remettre"
      [ "$(grep -c '' "$sauve")" = 1 ] || refus "sauvegarde RAPL illisible"
      read -r a b x < "$sauve"
      [ -z "$x" ] && rapl_valide "$a" "$b" || refus "sauvegarde RAPL refusée"
      ;;
  esac
  # Origine gardée au passage en jeu, si aucune sauvegarde VALIDE n'existe (une sauvegarde vide ou abîmée, par une
  # coupure pendant l'écriture, est remplacée) ; jamais les valeurs d'un préréglage de jeu (sauvegarde perdue en jeu :
  # elles ne sont pas l'origine), et toujours d'un bloc (fichier temporaire puis mv)
  if [ "$1" != normal ] && ! { [ -f "$sauve" ] && [ "$(grep -c '' "$sauve")" = 1 ] && read -r o1 o2 x < "$sauve" &&
                               [ -z "$x" ] && rapl_valide "$o1" "$o2"; }; then
    o1="$(lire "$r/constraint_0_power_limit_uw")"; o2="$(lire "$r/constraint_1_power_limit_uw")"
    rapl_valide "$o1" "$o2" || echec "limites actuelles illisibles : origine non gardée"
    case "$o1 $o2" in
      "30000000 45000000"|"45000000 65000000") ;;
      *) ( umask 077; mkdir -p "$LIB" && printf '%s %s\n' "$o1" "$o2" > "$sauve.tmp" && mv -f "$sauve.tmp" "$sauve" ) ||
           echec "origine non gardée" ;;
    esac
  fi
  ecrire "$a" "$r/constraint_0_power_limit_uw" && ecrire "$b" "$r/constraint_1_power_limit_uw" || echec "écriture impossible (rapl)"
  [ "$(lire "$r/constraint_0_power_limit_uw")" = "$a" ] && [ "$(lire "$r/constraint_1_power_limit_uw")" = "$b" ] \
    || { echo "nc-energie-root: la limite relue est différente" >&2; exit 4; }
  # Origine remise : la sauvegarde s'efface (la prochaine partie relira l'origine du moment, jamais une vieille valeur)
  if [ "$1" = normal ]; then rm -f "$sauve"; fi
  return 0
}
fichier_vent() {
  local f="$S/devices/platform/acer-wmi/nitro_sense/fan_speed"
  local c n
  if [ ! -f "$f" ]; then
    f=""
    for c in "$S"/devices/platform/*/nitro_sense/fan_speed; do
      n="${c%/nitro_sense/fan_speed}"; n="${n##*/}"
      case "$n" in ''|*[!A-Za-z0-9_.:-]*) continue ;; esac   # un nom de périphérique, rien d'autre
      [ -f "$c" ] && { f="$c"; break; }
    done
  fi
  [ -n "$f" ] && [ -f "$f" ] && printf '%s' "$f"
}
do_vent() {
  local f; f="$(fichier_vent)" || true
  [ -n "$f" ] || absent "pas de ventilateurs réglables"
  if [ "$1" = max ]; then ecrire 100,100 "$f"; else ecrire 0,0 "$f"; fi || echec "écriture impossible (ventilateurs)"
}
do_gpufreq() {
  # Toutes les cartes NVIDIA doivent être « active » : nvidia-smi (sans -i) les réveillerait toutes, et une carte en
  # suspending, resuming ou error n'est pas éveillée
  local d n=0
  for d in $(nvidia); do
    [ "$(lire "$d/power/runtime_status")" = active ] || absent "carte NVIDIA pas éveillée (elle n'est pas réveillée pour ça)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de carte NVIDIA"
  command -v nvidia-smi >/dev/null 2>&1 || absent "nvidia-smi absent"
  if [ "$1" = jeu ]; then nvidia-smi -lgc 210,1500 >/dev/null 2>&1; else nvidia-smi -rgc >/dev/null 2>&1; fi \
    || absent "la carte refuse de changer sa fréquence"
}
# Énergie cumulée : un entier en µJ, rendu en mJ (÷1000), sinon rien
energie() { local e; e="$(lire "$1")"; case "$e" in ''|*[!0-9]*) return 1 ;; esac; [ "${#e}" -le 18 ] && printf '%s' "$((10#$e / 1000))"; }
# Pourquoi la cadence et le mJ : energy_uj n'est lisible qu'en root (attaque Platypus : deviner ce que calcule le
# processeur d'après sa consommation, il faut beaucoup de lectures fines). « puissance » est permis sans mot de passe à
# tout programme de l'utilisateur : au plus une lecture réelle par seconde, notée dans un dossier root 0700, et le
# millijoule au mieux. shortcut: deux appels exactement simultanés peuvent passer tous les deux (pas de verrou).
do_puissance() {
  local p e t0 t1 f="$RUN/puissance-derniere"
  t1="$(date +%s%N)"
  case "$t1" in ''|*[!0-9]*) echec "horloge illisible" ;; esac
  if [ -f "$f" ]; then
    read -r t0 < "$f" 2>/dev/null || t0=""
    case "$t0" in ''|*[!0-9]*) t0=0 ;; esac
    [ "${#t0}" -le 19 ] || t0=0
    if [ "$t1" -ge "$t0" ] && [ $((t1 - t0)) -lt 1000000000 ]; then
      echo "nc-energie-root: une lecture par seconde au plus" >&2; exit 5
    fi
  fi
  ( umask 077; mkdir -p "$RUN" && printf '%s\n' "$t1" > "$f.tmp" && mv -f "$f.tmp" "$f" ) || echec "cadence non notée"
  e="$(energie "$S/class/powercap/intel-rapl:0/energy_uj")" || absent "pas de compteur d'énergie RAPL"
  echo "paquet_mj=$e"
  p="$S/class/powercap/intel-rapl:1"
  if [ "$(lire "$p/name")" = psys ] && e="$(energie "$p/energy_uj")"; then echo "psys_mj=$e"; fi
  return 0
}
do_wifi() {
  command -v iw >/dev/null 2>&1 || absent "iw absent"
  local i n=0
  for i in $(wifis); do
    iw dev "$i" set power_save "$1" >/dev/null 2>&1 || echec "économie d'énergie du Wi-Fi refusée"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de Wi-Fi"
}
do_usb() {
  local d n=0 v=on
  [ "$1" = on ] && v=auto
  for d in $(usbs); do
    ecrire "$v" "$d/power/control" || continue
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "aucun périphérique USB réglable"
}
do_eth() {
  local d n=0 v=on
  [ "$1" = on ] && v=auto
  for d in $(eths); do
    ecrire "$v" "$d/power/control" || echec "écriture impossible (Ethernet)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "aucune carte Ethernet PCI"
}
do_audio() {
  local f="$S/module/snd_hda_intel/parameters/power_save"
  [ -f "$f" ] || absent "pas de puce audio réglable"
  if [ "$1" = on ]; then ecrire 1 "$f"; else ecrire 0 "$f"; fi || echec "écriture impossible (audio)"
}
do_kbd() {
  local d n=0 max v
  for d in "$S"/class/leds/*kbd_backlight*; do
    [ -f "$d/brightness" ] && [ -r "$d/max_brightness" ] || continue
    max="$(lire "$d/max_brightness")"
    case "$max" in ''|*[!0-9]*) continue ;; esac
    v="$1"; [ "$v" -gt "$max" ] && v="$max"
    ecrire "$v" "$d/brightness" || echec "écriture impossible (clavier)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || absent "pas de clavier lumineux"
}

etat() {
  local p d x
  p="$(politiques | head -n1)"
  if [ -n "$p" ]; then
    [ -f "$p/energy_performance_preference" ] && echo "epp=$(lire "$p/energy_performance_preference")"
    [ -f "$p/scaling_max_freq" ] && echo "freqmax_khz=$(lire "$p/scaling_max_freq")/$(lire "$p/cpuinfo_max_freq")"
  fi
  [ -f "$S/devices/system/cpu/cpufreq/boost" ] && echo "boost=$(lire "$S/devices/system/cpu/cpufreq/boost")"
  [ -f "$S/devices/system/cpu/intel_pstate/no_turbo" ] && echo "no_turbo=$(lire "$S/devices/system/cpu/intel_pstate/no_turbo")"
  [ -f "$S/firmware/acpi/platform_profile" ] && echo "platform=$(lire "$S/firmware/acpi/platform_profile")"
  [ -f "$S/firmware/acpi/platform_profile_choices" ] && echo "platform_choices=$(propre "$(lire "$S/firmware/acpi/platform_profile_choices")")"
  for d in $(controleurs); do
    echo "platform_ctl=$(propre "$(lire "$d/name")")|$(propre "$(lire "$d/profile")")|$(propre "$(lire "$d/choices")")"
  done
  [ -f "$S/class/powercap/intel-rapl:0/constraint_1_power_limit_uw" ] && echo "rapl=$(lire "$S/class/powercap/intel-rapl:0/constraint_0_power_limit_uw")/$(lire "$S/class/powercap/intel-rapl:0/constraint_1_power_limit_uw")"
  x="$(fichier_vent)" && echo "ventilateurs=$(lire "$x")"
  for d in $(nvidia); do
    [ -f "$d/power/control" ] && echo "nvidia_pm=$(lire "$d/power/control") $(lire "$d/power/runtime_status")"
  done
  [ -f "$S/module/snd_hda_intel/parameters/power_save" ] && echo "audio=$(lire "$S/module/snd_hda_intel/parameters/power_save")"
  for x in $(wifis); do echo "wifi=$x"; done
  for x in $(usbs); do echo "usb=$(lire "$x/power/control")"; done
  for x in $(eths); do echo "eth=$(lire "$x/power/control")"; done
  for d in "$S"/class/leds/*kbd_backlight*; do
    [ -f "$d/brightness" ] && echo "kbd=$(lire "$d/brightness")/$(lire "$d/max_brightness")"
  done
  return 0
}

sudoers() {   # la ligne exacte pour ce compte : une commande par sous-commande et valeur
  local u="$1" v
  local bin=/usr/local/bin/nc-energie-root
  local liste="$bin etat"
  # un vrai nom de compte : minuscules, chiffres, « _ » et « - », pas en tête (ni ALL, ni %groupe, ni majuscules)
  case "$u" in ''|*[!a-z0-9_-]*|[!a-z_]*) refus "nom de compte refusé" ;; esac
  for v in $EPP; do liste="$liste, $bin epp $v"; done
  for v in $ONOFF; do liste="$liste, $bin boost $v"; done
  for v in $FREQ; do liste="$liste, $bin freqmax $v"; done
  for v in $PLATEFORME; do liste="$liste, $bin platform $v"; done
  for v in $NVPM; do liste="$liste, $bin nvidia-pm $v"; done
  for v in $NVPL; do liste="$liste, $bin nvidia-pl $v"; done
  for v in $ONOFF; do liste="$liste, $bin wifi-ps $v"; done
  for v in $ONOFF; do liste="$liste, $bin usb-autosuspend $v"; done
  for v in $ONOFF; do liste="$liste, $bin eth-pm $v"; done
  for v in $ONOFF; do liste="$liste, $bin audio-ps $v"; done
  for v in $KBD; do liste="$liste, $bin kbd $v"; done
  for v in $RAPL; do liste="$liste, $bin rapl $v"; done
  for v in $VENT; do liste="$liste, $bin ventilateurs $v"; done
  for v in $GPUF; do liste="$liste, $bin gpu-frequence $v"; done
  liste="$liste, $bin puissance"
  printf '%s ALL=(root) NOPASSWD: %s\n' "$u" "$liste"
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || refus "usage : etat | epp V | boost V | freqmax V | platform V | nvidia-pm V | nvidia-pl V | wifi-ps V | usb-autosuspend V | eth-pm V | audio-ps V | kbd V | rapl V | ventilateurs V | gpu-frequence V | puissance"
cmd="$1"; val="${2:-}"
case "$cmd" in
  etat)             [ "$#" = 1 ] || refus "etat n'a pas d'argument"; etat ;;
  puissance)        [ "$#" = 1 ] || refus "puissance n'a pas d'argument"; do_puissance ;;
  sudoers)          [ "$#" = 2 ] || refus "sudoers demande un compte"; sudoers "$val" ;;
  epp)              valeur "$val" $EPP; racine; do_epp "$val" ;;
  boost)            valeur "$val" $ONOFF; racine; do_boost "$val" ;;
  freqmax)          valeur "$val" $FREQ; racine; do_freqmax "$val" ;;
  platform)         valeur "$val" $PLATEFORME; racine; do_platform "$val" ;;
  nvidia-pm)        valeur "$val" $NVPM; racine; do_nvidia_pm "$val" ;;
  nvidia-pl)        valeur "$val" $NVPL; racine; do_nvidia_pl "$val" ;;
  wifi-ps)          valeur "$val" $ONOFF; racine; do_wifi "$val" ;;
  usb-autosuspend)  valeur "$val" $ONOFF; racine; do_usb "$val" ;;
  eth-pm)           valeur "$val" $ONOFF; racine; do_eth "$val" ;;
  audio-ps)         valeur "$val" $ONOFF; racine; do_audio "$val" ;;
  kbd)              valeur "$val" $KBD; racine; do_kbd "$val" ;;
  rapl)             valeur "$val" $RAPL; racine; do_rapl "$val" ;;
  ventilateurs)     valeur "$val" $VENT; racine; do_vent "$val" ;;
  gpu-frequence)    valeur "$val" $GPUF; racine; do_gpufreq "$val" ;;
  *)                refus "sous-commande refusée" ;;
esac
