        "oui": "Oui", "non": "Non", "ok": "Valider", "sensible": "Cette question change le système.",
        "reussi": "Installation terminée", "annulee": "Installation annulée",
        "echec": "L'installation a échoué (code {code})",
        "inattendu": "L'installation s'est arrêtée sans prévenir (code {code}).",
        "script_absent": "install.sh est introuvable.",
    },
    "en": {
