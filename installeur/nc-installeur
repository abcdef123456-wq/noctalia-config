#!/usr/bin/env python3
"""nc-installeur : l'installeur graphique (GTK 4 + libadwaita). Il pilote install.sh, qui reste le seul moteur.

Protocole (NC_UI=1) : install.sh écrit une ligne JSON par événement sur la FIFO NC_UI_SORTIE et lit les
réponses « <id> <réponse> » sur la FIFO NC_UI_ENTREE. Le mot de passe sudo ne passe jamais ici : c'est nc-askpass.
Tout ce qui ne dépend pas de GTK est en haut du fichier (testable sans écran) ; gi n'est importé qu'au lancement.
"""
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
TYPES = ("etape", "info", "ok", "avert", "erreur", "progres", "question", "choix", "saisie", "fin")
LIGNE_MAX = 65536

# ---------- textes ----------
T = {
    "fr": {
