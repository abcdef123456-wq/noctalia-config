[Unit]
Description=Adapte Hyprland au profil énergétique (legion-profile)
PartOf=graphical-session.target
After=graphical-session.target noctalia.service

[Service]
ExecStart=%h/.local/bin/legion-profile-sync
Restart=on-failure
RestartSec=5
Slice=background.slice

[Install]
WantedBy=graphical-session.target
