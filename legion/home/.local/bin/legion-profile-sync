#!/usr/bin/env bash
# legion-profile-sync : adapte Hyprland au profil énergétique actif et à la source d'alimentation.
# Écrit ~/.config/hypr/conf.d/90-profile.conf (fréquence de l'écran interne, flou, ombres) puis recharge Hyprland.
# Réglages facultatifs dans ~/.config/legion-profile.conf (format CLE=valeur, entiers uniquement) :
#   HZ_PERFORMANCE=max  HZ_BALANCED_AC=max  HZ_BALANCED_BAT=low  HZ_ECO=low  ECO_BRIGHTNESS_MAX=40 (0 = ne pas toucher)
# Fréquences : « max » = la plus haute de l'écran interne, « low » = 60 Hz (sinon la plus basse), ou un nombre (ex. 120).
# Écran, rétroéclairage de l'écran et du clavier : détectés automatiquement.
set -uo pipefail

OUT="$HOME/.config/hypr/conf.d/90-profile.conf"
# Noctalia v5 lit tous les *.toml de son dossier, par ordre alphabétique (le dernier l'emporte)
NOCTALIA_ECO="${NOCTALIA_CONFIG_HOME:-$HOME/.config}/noctalia/zz-economie.toml"
CFG="$HOME/.config/legion-profile.conf"
# Rétroéclairage de l'écran : le premier qui n'est pas celui de la carte NVIDIA
BACKLIGHT=$(for d in /sys/class/backlight/*; do n=${d##*/}; case $n in nvidia*|\*) ;; *) echo "$n"; break ;; esac; done)

HZ_PERFORMANCE=max
HZ_BALANCED_AC=max
HZ_BALANCED_BAT=max
HZ_ECO=low
ECO_BRIGHTNESS_MAX=40

if [ -r "$CFG" ]; then
  while IFS='=' read -r k v; do
    case "$k" in
      HZ_PERFORMANCE|HZ_BALANCED_AC|HZ_BALANCED_BAT|HZ_ECO|ECO_BRIGHTNESS_MAX)
        [[ "$v" =~ ^([0-9]{1,3}|max|low)$ ]] && printf -v "$k" '%s' "$v" || echo "valeur ignorée : $k=$v" >&2 ;;
      ''|\#*) ;;
      *) echo "clé inconnue ignorée : $k" >&2 ;;
    esac
  done < "$CFG"
fi

log() { echo "legion-profile-sync: $*"; }

get_profile() {
  gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
    --method org.freedesktop.DBus.Properties.Get net.hadess.PowerProfiles ActiveProfile 2>/dev/null \
    | sed -nE "s/^\(<'([a-z-]+)'>,\)$/\1/p"
}

on_battery() {
  local s
  for s in /sys/class/power_supply/*; do
    [ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && return 1
  done
  return 0
}

last_profile=""
GPU_STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/legion-gpu-default"

# GPU par défaut des applis lancées : RTX en Performance, AMD sinon.
# Seulement si la session tourne sur l'iGPU seul (sinon on ne touche à rien).
#   - Noctalia lance via legion-launch, qui lit $GPU_STATE ;
#   - les raccourcis Hyprland héritent de l'environnement de Hyprland, mis à jour par « hyprctl keyword env ».
set_gpu_default() {
  local want=amd
  case "${AQ_DRM_DEVICES:-}" in ""|*:*) return 0 ;; esac
  [ "$1" = performance ] && want=nvidia
  [ "$(cat "$GPU_STATE" 2>/dev/null)" = "$want" ] && return 0
  local egl vk off layer glx
  if [ "$want" = nvidia ]; then
    egl=/usr/share/glvnd/egl_vendor.d/10_nvidia.json:/usr/share/glvnd/egl_vendor.d/50_mesa.json
    vk=/usr/share/vulkan/icd.d/nvidia_icd.json:/usr/share/vulkan/icd.d/radeon_icd.json
    off=1; layer=NVIDIA_only; glx=nvidia
  else
    egl=/usr/share/glvnd/egl_vendor.d/50_mesa.json
    vk=/usr/share/vulkan/icd.d/radeon_icd.json
    off=0; layer=non_NVIDIA_only; glx=mesa
  fi
  hyprctl --batch "keyword env __EGL_VENDOR_LIBRARY_FILENAMES,$egl ; keyword env VK_DRIVER_FILES,$vk ; keyword env __NV_PRIME_RENDER_OFFLOAD,$off ; keyword env __VK_LAYER_NV_optimus,$layer ; keyword env __GLX_VENDOR_LIBRARY_NAME,$glx" >/dev/null
  echo "$want" > "$GPU_STATE"
  log "GPU par défaut des nouvelles applis : $want"
}

# Noctalia v5 en Économie : animations coupées, panneaux opaques (le flou de Hyprland est coupé),
# rotation des fonds en pause, verrouillage sans transition. Fichier retiré en sortant d'Économie.
noctalia_eco() {
  local dir want
  dir=$(dirname "$NOCTALIA_ECO")
  [ -d "$dir" ] || return 0
  if [ "$1" = power-saver ]; then
    want='# Généré par legion-profile-sync en mode Économie, supprimé en sortant. Ne pas éditer.
[shell.animation]
enabled = false

[shell.panel]
transparency_mode = "solid"

[wallpaper.automation]
enabled = false

[lockscreen]
transition = []'
    [ "$want" = "$(cat "$NOCTALIA_ECO" 2>/dev/null)" ] && return 0
    printf '%s\n' "$want" > "$NOCTALIA_ECO.tmp" && mv "$NOCTALIA_ECO.tmp" "$NOCTALIA_ECO"
    log "Noctalia : mode Économie (animations et rotation des fonds coupées)"
  else
    [ -e "$NOCTALIA_ECO" ] || return 0
    rm -f "$NOCTALIA_ECO"
    log "Noctalia : mode normal"
  fi
  command -v noctalia >/dev/null && noctalia msg config-reload >/dev/null 2>&1
  return 0
}

apply() {
  hyprctl monitors -j >/dev/null 2>&1 || return 0
  local profile bat hz blur shadow mon
  profile=$(get_profile)
  on_battery && bat=1 || bat=0

  local dim=true
  case "$profile" in
    performance) hz=$HZ_PERFORMANCE; blur=true;  shadow=true ;;
    power-saver) hz=$HZ_ECO;         blur=false; shadow=false; dim=false ;;
    *)           blur=true; shadow=true
                 if [ "$bat" = 1 ]; then hz=$HZ_BALANCED_BAT; else hz=$HZ_BALANCED_AC; fi ;;
  esac

  # Écran interne : eDP-*. Le mode est appliqué seulement s'il existe exactement dans la liste du moniteur.
  mon=$(hyprctl monitors all -j | jq -r --arg want "$hz" '
    map(select(.name | startswith("eDP"))) | first // empty | . as $m |
    ($m.availableModes | map(select(startswith("\($m.width)x\($m.height)@")) | {s: ., h: (capture("@(?<h>[0-9.]+)Hz").h | tonumber)})) as $l |
    (if $want == "max" then ($l | max_by(.h))
     elif $want == "low" then (($l | map(select((.h | round) == 60)) | first) // ($l | min_by(.h)))
     else ($l | map(select((.h | round) == ($want | tonumber))) | first) end) as $pick |
    if $pick then "\($m.name), \($pick.s | sub("Hz$"; "")), auto, \($m.scale)" else empty end')

  # Bordure animée en rotation continue : seulement en Performance sur secteur
  # (elle force un rendu permanent de l'écran).
  local border_anim="animation = borderangle, 1, 8, standard"
  [ "$profile" = performance ] && [ "$bat" = 0 ] && border_anim="animation = borderangle, 1, 100, linear, loop"
  # Économie : plus aucune animation de fenêtre
  local anims=true
  [ "$profile" = power-saver ] && anims=false

  local content="# Généré par legion-profile-sync : profil=${profile:-inconnu} batterie=$bat. Ne pas éditer.
animations {
    enabled = $anims
    $border_anim
}
decoration {
    dim_inactive = $dim
    blur {
        enabled = $blur
    }
    shadow {
        enabled = $shadow
    }
}"
  [ -n "$mon" ] && content="$content
monitor = $mon"

  if [ "$content" != "$(cat "$OUT" 2>/dev/null)" ]; then
    printf '%s\n' "$content" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    hyprctl reload >/dev/null
    log "appliqué : profil=${profile:-inconnu} batterie=$bat écran=${mon:-inchangé} flou=$blur"
  fi

  set_gpu_default "$profile"
  noctalia_eco "$profile"

  # Applications lancées ensuite : AMD seule en Économie (la RTX peut s'endormir), sinon choix normal.
  local egl=/usr/share/glvnd/egl_vendor.d
  if [ "$profile" = power-saver ]; then
    hyprctl keyword env "__EGL_VENDOR_LIBRARY_FILENAMES,$egl/50_mesa.json" >/dev/null
  else
    hyprctl keyword env "__EGL_VENDOR_LIBRARY_FILENAMES,$egl/10_nvidia.json:$egl/50_mesa.json" >/dev/null
  fi

  # Bluetooth (si aucun appareil connecté) : coupé en Économie, rallumé en sortant
  # seulement si c'est ce script qui l'avait coupé.
  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ]; then
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && [ -z "$(bluetoothctl devices Connected 2>/dev/null)" ]; then
      bluetoothctl power off >/dev/null 2>&1 && touch "$rt/legion-bt-off" && log "Bluetooth coupé (aucun appareil connecté)"
    fi
  elif [ "$profile" != power-saver ] && [ "$last_profile" = power-saver ]; then
    [ -e "$rt/legion-bt-off" ] && bluetoothctl power on >/dev/null 2>&1 && log "Bluetooth rallumé"
    rm -f "$rt/legion-bt-off"
  fi

  # Rétroéclairage du clavier : éteint en Économie, niveau précédent restauré en sortant.
  local kbd kbd_saved="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/legion-kbd-saved"
  kbd=$(ls /sys/class/leds 2>/dev/null | grep -m1 'kbd_backlight')
  if [ -n "$kbd" ] && [ -e "/sys/class/leds/$kbd" ]; then
    if [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ]; then
      # Ne pas écraser le niveau d'origine si le service redémarre alors qu'on est déjà en Économie.
      [ -e "$kbd_saved" ] || cat "/sys/class/leds/$kbd/brightness" > "$kbd_saved"
      brightnessctl -q -d "$kbd" set 0 && log "rétroéclairage clavier éteint"
    elif [ "$profile" != power-saver ] && [ "$last_profile" = power-saver ] && [ -r "$kbd_saved" ]; then
      brightnessctl -q -d "$kbd" set "$(cat "$kbd_saved")" && log "rétroéclairage clavier restauré"
      rm -f "$kbd_saved"
    fi
  fi

  if [ -n "$BACKLIGHT" ] && [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ] && [ "$ECO_BRIGHTNESS_MAX" -gt 0 ]; then
    local cur max
    cur=$(brightnessctl -d "$BACKLIGHT" get 2>/dev/null) && max=$(brightnessctl -d "$BACKLIGHT" max 2>/dev/null) &&
      if [ $(( cur * 100 / max )) -gt "$ECO_BRIGHTNESS_MAX" ]; then
        brightnessctl -q -d "$BACKLIGHT" set "${ECO_BRIGHTNESS_MAX}%" && log "luminosité ramenée à ${ECO_BRIGHTNESS_MAX} %"
      fi
  fi
  last_profile=$profile
}

# Nouvelle session : l'environnement de Hyprland repart de la valeur uwsm (AMD), on force la resynchronisation.
rm -f "$GPU_STATE"
apply

# Événements : changement de profil (tlp-pd) et de source d'alimentation (UPower). Vérification de secours toutes les 60 s.
{
  gdbus monitor --system --dest net.hadess.PowerProfiles &
  gdbus monitor --system --dest org.freedesktop.UPower --object-path /org/freedesktop/UPower &
  wait
} 2>/dev/null | while true; do
  read -r -t 60 _line
  rc=$?
  [ $rc -ne 0 ] && [ $rc -le 128 ] && { log "flux D-Bus interrompu"; exit 1; }
  sleep 0.3
  while read -r -t 0.2 _line; do :; done
  apply
done
