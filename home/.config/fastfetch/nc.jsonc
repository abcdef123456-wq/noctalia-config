// Accueil du terminal (fastfetch 2.69), lancé par nc-greeting.
// Logo : ~/.cache/nc/term-logo.png, régénéré aux couleurs du fond d'écran (nc-term-logo).
// Couleurs : nc-greeting passe la couleur principale du fond d'écran (--color-keys…) ; valeurs ci-dessous = secours.
// Le module GPU de fastfetch n'est pas utilisé : il réveillerait la carte NVIDIA ; nc-sysinfo lit /sys à la place.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$HOME/.cache/nc/term-logo.png",
    "width": 20,
    "height": 10,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    },
    "size": {
      "binaryPrefix": "jedec",
      "ndigits": 1
    },
    "percent": {
      "type": ["bar", "hide-others"]
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "border": null,
      "color": {
        "elapsed": "magenta",
        "total": "90"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "90"
    },
    {
      "type": "os",
      "key": "\uf17c",
      "format": "{name} · noyau {kernel-release}"
    },
    {
      "type": "wm",
      "key": "\uf359",
      "format": "{pretty-name} {version} · Noctalia"
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "format": "{name} · {cores-logical} cœurs"
    },
    {
      "type": "command",
      "key": "󰢮",
      "text": "nc-sysinfo gpu"
    },
    {
      "type": "memory",
      "key": "󰑭",
      "format": "{used} / {total}  {percentage-bar}"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{size-used} / {size-total}  {size-percentage-bar}"
    },
    {
      "type": "command",
      "key": "󰁹",
      "text": "nc-sysinfo power"
    },
    {
      "type": "command",
      "key": "󰅐",
      "text": "nc-sysinfo uptime"
    }
  ]
}
