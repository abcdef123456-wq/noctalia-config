[Unit]
Description=Surveille le dossier des fonds d'écran (miniatures du carrousel)

[Path]
# Le dossier par défaut ; un autre dossier (réglage FONDS_DOSSIER) est mis par nc-carousel-thumbs --surveillance
# dans le drop-in nc-carousel-thumbs.path.d/dossier.conf
PathChanged=%h/Pictures/Wallpapers
Unit=nc-carousel-thumbs.service

[Install]
WantedBy=graphical-session.target
