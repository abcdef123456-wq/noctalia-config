[Unit]
Description=Surveille le dossier des fonds d'écran (miniatures du carrousel)

[Path]
# Le dossier par défaut et son mes-fonds ; un autre dossier (réglage FONDS_DOSSIER) est mis par nc-carousel-thumbs --surveillance
# dans le drop-in nc-carousel-thumbs.path.d/dossier.conf
PathChanged=%h/Pictures/Wallpapers
# « Mes fonds » de la base (absent : systemd guette sa création)
PathChanged=%h/Pictures/Wallpapers/mes-fonds
Unit=nc-carousel-thumbs.service

[Install]
WantedBy=graphical-session.target
