[Unit]
Description=Prévient quand un écran est branché sur une prise de la carte NVIDIA (noctalia-config)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nc-ecran-externe
Restart=on-failure
RestartSec=5
Slice=background.slice

[Install]
WantedBy=graphical-session.target
