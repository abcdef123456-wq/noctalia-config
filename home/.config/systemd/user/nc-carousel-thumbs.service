[Unit]
Description=Miniatures haute qualité du carrousel de fonds d'écran

[Service]
Type=oneshot
ExecStart=%h/.local/bin/nc-carousel-thumbs
# Priorité minimale : ne gêne jamais le reste du système
Nice=19
Environment=MAGICK_THREAD_LIMIT=2
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

[Install]
WantedBy=graphical-session.target
