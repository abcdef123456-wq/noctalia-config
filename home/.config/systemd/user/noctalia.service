[Unit]
Description=Noctalia v5 (barre, menus, fond d'écran)
Documentation=https://docs.noctalia.dev/noctalia/
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
# Disposition de l'écran de verrouillage enregistrée par Noctalia retirée : il part toujours de config.toml
ExecStartPre=-%h/.local/bin/nc-noctalia-avant
ExecStart=/usr/bin/noctalia
# Toujours relancée, même après un arrêt « propre » (SIGTERM d'un kill) : sans elle plus de barre ni de raccourcis
# Noctalia ; systemctl --user stop l'arrête quand même pour de bon
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
