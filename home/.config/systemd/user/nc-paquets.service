[Unit]
Description=Compte les mises à jour du système (île : page Système et page Notifications ; notification)
# Pas de ConditionACPower : nc-paquets décide lui-même (cadence() : 3 h sur batterie, 6 h en Économie, 12 h sur connexion
# limitée). Pas de After=network-online.target non plus : il n'existe pas dans le gestionnaire utilisateur ; sans réseau,
# le compte garde le dernier état et réessaie plus tard (paquets-erreur)

[Service]
Type=oneshot
# Sécurité : comptage (dépôts, AUR, Flatpak) ; la notification à clic part dans son propre scope
TimeoutStartSec=30min
ExecStart=%h/.local/bin/nc-paquets compter auto
Slice=background.slice
Nice=19
IOSchedulingClass=idle
