[Unit]
Description=Alertes de la machine vers Telegram (batterie faible, service en échec), si le réglage le demande

[Service]
Type=oneshot
# Sécurité : envoi Telegram et JARVIS : jamais « activating » des heures
TimeoutStartSec=10min
ExecStart=%h/.local/bin/nc-alertes verifier
Slice=background.slice
Nice=10
