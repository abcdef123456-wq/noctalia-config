# Sourcé par uwsm (sh POSIX) avant le démarrage de Hyprland.
# Choix du GPU de rendu, Legion Pro 5 16ADR10 :
#   iGPU AMD  0000:05:00.0 -> écran interne eDP
#   RTX 5060  0000:01:00.0 -> toutes les sorties externes (HDMI, DP, USB-C)
#
# Mode lu dans ~/.config/uwsm/gpu-mode (première ligne) : auto (défaut) | igpu | both
#   auto : AMD seul sans écran externe à l'ouverture de session (la RTX peut s'endormir),
#          AMD + RTX si un écran est branché sur la RTX.
#   igpu : AMD seul (écrans externes inutilisables).
#   both : AMD en principal + RTX (comportement d'origine, écrans externes à chaud).
# Changer de mode demande de fermer puis rouvrir la session.
# Retour arrière : supprimer ce fichier (Hyprland choisit alors lui-même).

_lg_igpu=$(readlink -f /dev/dri/by-path/pci-0000:05:00.0-card 2>/dev/null)
_lg_dgpu=$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card 2>/dev/null)
_lg_mode=auto
[ -r "$HOME/.config/uwsm/gpu-mode" ] && read -r _lg_mode < "$HOME/.config/uwsm/gpu-mode"

if [ -c "$_lg_igpu" ]; then
  case "$_lg_mode" in
    igpu)
      export AQ_DRM_DEVICES="$_lg_igpu" ;;
    both)
      [ -c "$_lg_dgpu" ] && export AQ_DRM_DEVICES="$_lg_igpu:$_lg_dgpu" ;;
    *)
      _lg_ext=0
      for _lg_c in /sys/bus/pci/devices/0000:01:00.0/drm/card*/card*-*/status; do
        [ -r "$_lg_c" ] && [ "$(cat "$_lg_c")" = connected ] && _lg_ext=1
      done
      if [ "$_lg_ext" = 1 ] && [ -c "$_lg_dgpu" ]; then
        export AQ_DRM_DEVICES="$_lg_igpu:$_lg_dgpu"
      else
        export AQ_DRM_DEVICES="$_lg_igpu"
      fi
      ;;
  esac
fi

# Session sur l'iGPU seul : Hyprland et toutes les applis n'utilisent que les pilotes Mesa (AMD).
# Sinon, le simple chargement des bibliothèques EGL/Vulkan NVIDIA (Hyprland, Discord…) garde la RTX allumée.
# Pour utiliser la RTX : nvidia-run <commande>  (Steam : nvidia-run %command%).
if [ -n "${AQ_DRM_DEVICES:-}" ] && [ "${AQ_DRM_DEVICES#*:}" = "$AQ_DRM_DEVICES" ] \
   && [ -r /usr/share/glvnd/egl_vendor.d/50_mesa.json ] && [ -r /usr/share/vulkan/icd.d/radeon_icd.json ]; then
  export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
  export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json
fi
unset _lg_igpu _lg_dgpu _lg_mode _lg_ext _lg_c
