# Sourcé par uwsm (sh POSIX) avant le démarrage de Hyprland (noctalia-config).
# PC hybride (carte intégrée Intel/AMD + NVIDIA) : la session tourne sur la carte intégrée, qui porte l'écran interne,
# et la NVIDIA peut s'endormir (batterie, chaleur, bruit). Pour une appli sur la NVIDIA : nvidia-run <commande>
# (Steam : nvidia-run %command%). La carte des applis suit la règle de ~/.local/bin/nc-gpu-regle (réglage GPU_REGLE,
# nc-reglages → Énergie) : la NVIDIA sur secteur en Performance et en Équilibré, sur batterie seulement en Performance.
# Ne fait rien sur un PC sans NVIDIA.
# Écran interne branché sur la NVIDIA (interrupteur « MUX » du BIOS en mode carte dédiée) : la session tourne sur la
# NVIDIA seule (plus la carte intégrée seulement si un écran est branché sur une de ses prises), avec les variables
# NVIDIA du wiki Hyprland dont le pilote est installé. Sans cela, aquamarine pourrait dessiner sur la carte intégrée,
# qui n'a pas d'écran, et recopier chaque image vers la NVIDIA. Rien à faire non plus sur un PC fixe (pas d'eDP).
#
# Mode lu dans ~/.config/uwsm/gpu-mode (première ligne) : auto (défaut) | igpu | both | off
#   auto : carte intégrée seule, plus la NVIDIA si la règle de nc-gpu-regle la veut à l'ouverture de session (profil
#          d'énergie et alimentation) ou si un écran est branché sur une de ses prises à ce moment-là ;
#   igpu : carte intégrée seule (les prises reliées à la NVIDIA ne marchent pas) ;
#   both : les deux cartes (écrans externes branchables à tout moment, la NVIDIA reste éveillée) ;
#   off  : Hyprland choisit seul.
# Changer de mode demande de fermer puis rouvrir la session.
# Pour les tests : NC_SYSFS (à la place de /sys) et NC_DEV_DRI (à la place de /dev/dri), comme dans nc-gpu-regle,
# et NC_USR (à la place de /usr, pour les pilotes EGL, Vulkan et VA-API).

_nc_mode=auto
[ -r "$HOME/.config/uwsm/gpu-mode" ] && read -r _nc_mode < "$HOME/.config/uwsm/gpu-mode"
_nc_igpu=""; _nc_dgpu=""; _nc_dsys=""; _nc_dedp=""; _nc_iecran=""; _nc_dediee=""
_nc_usr="${NC_USR:-/usr}"

if [ "$_nc_mode" != off ]; then
  for _nc_d in "${NC_SYSFS:-/sys}"/class/drm/card*; do
    case "${_nc_d##*/}" in *-*) continue ;; esac   # connecteurs (card1-eDP-1…) : ignorés ici
    if [ "$(cat "$_nc_d/device/vendor" 2>/dev/null)" = 0x10de ]; then
      _nc_dgpu="${NC_DEV_DRI:-/dev/dri}/${_nc_d##*/}"; _nc_dsys="$_nc_d"
      # Écran interne sur la NVIDIA : mode carte dédiée du MUX
      for _nc_c in "$_nc_d"/card*-eDP-*/status; do
        [ -r "$_nc_c" ] && [ "$(cat "$_nc_c")" = connected ] && _nc_dedp="$_nc_dgpu"
      done
    else
      for _nc_c in "$_nc_d"/card*-eDP-*/status; do
        [ -r "$_nc_c" ] && [ "$(cat "$_nc_c")" = connected ] && _nc_igpu="${NC_DEV_DRI:-/dev/dri}/${_nc_d##*/}"
      done
      # Un écran (externe) sur une prise de cette carte : utile seulement en mode carte dédiée, plus bas
      for _nc_c in "$_nc_d"/card*-*/status; do
        [ -r "$_nc_c" ] && [ "$(cat "$_nc_c")" = connected ] && _nc_iecran="${NC_DEV_DRI:-/dev/dri}/${_nc_d##*/}"
      done
    fi
  done
fi

if [ -n "$_nc_igpu" ] && [ -n "$_nc_dgpu" ] && [ -c "$_nc_igpu" ]; then
  case "$_nc_mode" in
    igpu) export AQ_DRM_DEVICES="$_nc_igpu" ;;
    both) export AQ_DRM_DEVICES="$_nc_igpu:$_nc_dgpu" ;;
    *)
      _nc_ext=0
      # La règle de nc-gpu-regle veut la NVIDIA (profil et alimentation à l'ouverture) : elle démarre avec la session
      # (jeux, prises HDMI / USB-C actives d'emblée). Fichier absent : carte intégrée seule. Le « . » d'un fichier
      # manquant arrêterait le shell (POSIX) : vérifié avant.
      if [ -r "$HOME/.local/bin/nc-gpu-regle" ] && . "$HOME/.local/bin/nc-gpu-regle"; then
        _nc_bat=0
        nc_sur_batterie && _nc_bat=1
        rtx_voulue "$(nc_profil_courant)" "$_nc_bat" && _nc_ext=1
        unset -f nc_gpu_reglage rtx_voulue nc_profil_courant nc_sur_batterie nc_pc_hybride
      fi
      # Écran branché sur une prise de la NVIDIA à l'ouverture de session : les deux cartes, quelle que soit la règle
      for _nc_c in "$_nc_dsys"/card*-*/status; do
        [ -r "$_nc_c" ] && [ "$(cat "$_nc_c")" = connected ] && _nc_ext=1
      done
      if [ "$_nc_ext" = 1 ]; then export AQ_DRM_DEVICES="$_nc_igpu:$_nc_dgpu"; else export AQ_DRM_DEVICES="$_nc_igpu"; fi
      ;;
  esac
elif [ -z "$_nc_igpu" ] && [ -n "$_nc_dedp" ] && [ -c "$_nc_dedp" ]; then
  # Mode carte dédiée : la NVIDIA seule, la carte intégrée en second si un écran est branché sur une de ses prises.
  _nc_dediee=1
  if [ -n "$_nc_iecran" ] && [ -c "$_nc_iecran" ]; then
    export AQ_DRM_DEVICES="$_nc_dedp:$_nc_iecran"
  else
    export AQ_DRM_DEVICES="$_nc_dedp"
  fi
  # Variables NVIDIA du wiki Hyprland, seulement si le pilote correspondant est installé (GBM_BACKEND non forcé)
  [ -r "$_nc_usr/share/glvnd/egl_vendor.d/10_nvidia.json" ] && export __GLX_VENDOR_LIBRARY_NAME=nvidia
  for _nc_f in "$_nc_usr/lib/dri" "$_nc_usr/lib64/dri" "$_nc_usr/lib/x86_64-linux-gnu/dri"; do
    if [ -r "$_nc_f/nvidia_drv_video.so" ]; then
      export LIBVA_DRIVER_NAME=nvidia NVD_BACKEND=direct   # nvidia-vaapi-driver
      break
    fi
  done
fi

# Session sur la carte intégrée seule : Hyprland et les applis n'utilisent que les pilotes Mesa.
# Sinon, le simple chargement des bibliothèques EGL/Vulkan NVIDIA (Hyprland, Discord…) garde la NVIDIA éveillée.
# Le pilote Vulkan « nouveau » est écarté aussi : il vise la carte NVIDIA et la réveillerait.
# Jamais en mode carte dédiée : la session y tourne sur la NVIDIA.
if [ -z "$_nc_dediee" ] && [ -n "${AQ_DRM_DEVICES:-}" ] && [ "${AQ_DRM_DEVICES#*:}" = "$AQ_DRM_DEVICES" ] \
   && [ -r "$_nc_usr/share/glvnd/egl_vendor.d/50_mesa.json" ]; then
  _nc_vk=""
  for _nc_f in "$_nc_usr"/share/vulkan/icd.d/*.json; do
    case "$_nc_f" in *nvidia*|*nouveau*|"$_nc_usr/share/vulkan/icd.d/*.json") ;; *) _nc_vk="${_nc_vk:+$_nc_vk:}$_nc_f" ;; esac
  done
  export __EGL_VENDOR_LIBRARY_FILENAMES="$_nc_usr/share/glvnd/egl_vendor.d/50_mesa.json"
  [ -n "$_nc_vk" ] && export VK_DRIVER_FILES="$_nc_vk"
fi
unset _nc_mode _nc_igpu _nc_dgpu _nc_dsys _nc_d _nc_c _nc_ext _nc_vk _nc_f _nc_bat _nc_dedp _nc_iecran _nc_dediee _nc_usr
