#!/usr/bin/env python3
"""nc-claude : Claude Code dans l'île dynamique (comme l'appli coucou) : ce qu'il fait, étape par étape, quand il a
fini, et ses demandes (autoriser une commande, répondre à une question) depuis l'île.
  nc-claude installer   ajoute les hooks à ~/.claude/settings.json (copie de l'ancien fichier gardée à côté)
  nc-claude retirer     les enlève
  nc-claude etat        les sessions suivies, en clair
  nc-claude hook        appelé par Claude Code à chaque événement (lit le JSON de l'événement sur l'entrée standard)
  nc-claude installer IA | retirer IA
                        la même chose pour les autres IA : antigravity, opencode, codex, gemini, cursor, copilot, qwen,
                        kiro, amp (ou « tout » : celles qui sont installées) ; ce qu'elles font, quand elles ont fini,
                        quand elles t'attendent ; leurs demandes restent dans leur terminal
  nc-claude ia IA EVENEMENT   appelé par leurs hooks ou leur extension ; nc-claude agy EVENEMENT : par Antigravity
  nc-claude detecter | actualiser   IA présentes pas encore branchées / remettre celles branchées au format du jour
  nc-claude ecrire SESSION TEXTE   écrit à l'agent de cette session (tapé dans son terminal kitty, puis Entrée)
  nc-claude aller PID [SHELL]      va sur ce terminal (et, dans kitty, sur l'onglet de ce shell)
Notifications de Claude (terminé, t'attend) : envoyées par nc-claude à la place des siennes ; un clic ramène sur
son terminal, et elles s'en vont seules quand tu y retournes ou qu'il repart.
  nc-claude diag        vérifie que tout est en place (Claude Code et Antigravity), avec les derniers événements reçus
Les demandes s'affichent dans l'île seulement quand tu n'es pas sur le terminal de Claude ; si tu y retournes, la
question repasse dans le terminal. Sans l'île (ou nc-reglages → Agents IA), rien ne change : Claude n'attend jamais.
État : $XDG_RUNTIME_DIR/nc-claude/etat.json (lu par l'île) ; réponses de l'île : …/nc-claude/reponses/ID.
"""
import fcntl
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.parse
import uuid

HOME = os.path.expanduser("~")
# Antigravity lance ses hooks avec un environnement réduit : dossier d'exécution et Hyprland retrouvés à la main
if not os.environ.get("XDG_RUNTIME_DIR") and os.path.isdir(f"/run/user/{os.getuid()}"):
    os.environ["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and os.environ.get("XDG_RUNTIME_DIR"):
    _hypr = sorted(glob.glob(os.environ["XDG_RUNTIME_DIR"] + "/hypr/*/.socket.sock"), key=os.path.getmtime)
    if _hypr:
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(os.path.dirname(_hypr[-1]))
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/nc-{os.getuid()}", "nc-claude")
ETAT = os.path.join(RUN, "etat.json")
VERROU = os.path.join(RUN, "etat.lock")
REPONSES = os.path.join(RUN, "reponses")
SETTINGS = os.path.join(HOME, ".claude/settings.json")
COMMANDE = "$HOME/.local/bin/nc-claude hook"
GARDER = 6 * 3600                  # une session sans nouvelles depuis 6 h disparaît de l'île


def reglage(cle, defaut):
    try:
        with open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8") as f:
            for l in f:
                if l.startswith(cle + "="):
                    defaut = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


# ── État partagé (verrou : plusieurs hooks peuvent tourner en même temps) ─────────────────────────────────────────
class Etat:
    def __enter__(self):
        os.makedirs(RUN, mode=0o700, exist_ok=True)
        self.v = open(VERROU, "w")
        fcntl.flock(self.v, fcntl.LOCK_EX)
        try:
            with open(ETAT, encoding="utf-8") as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            self.d = {}
        self.d.setdefault("sessions", {})
        self.d.setdefault("demandes", {})
        return self.d

    def __exit__(self, *_):
        maintenant = time.time()
        for sid in [s for s, v in self.d["sessions"].items() if maintenant - v.get("maj", 0) > GARDER]:
            del self.d["sessions"][sid]
        tmp = ETAT + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.d, f, ensure_ascii=False)
        os.replace(tmp, ETAT)
        fcntl.flock(self.v, fcntl.LOCK_UN)
        self.v.close()


# ── Ce que fait Claude, en français ────────────────────────────────────────────────────────────────────────────────
def court(t, n=70):
    t = re.sub(r"\s+", " ", str(t or "")).strip()
    return t if len(t) <= n else t[:n - 1] + "…"


def nom_fichier(p):
    return os.path.basename(str(p or "")) or "un fichier"


def etape(outil, e):
    """(icône Material Symbols, texte) pour un outil."""
    e = e or {}
    if outil == "Bash":
        # Sans description : la commande, sans le « cd dossier && » du début (peu parlant)
        cmd = re.sub(r"^\s*cd\s+\S+\s*(&&|;)\s*", "", str(e.get("command") or ""))
        return "terminal", "Lance : " + court(e.get("description") or cmd, 60)
    if outil in ("Edit", "MultiEdit"):
        return "edit", "Modifie " + nom_fichier(e.get("file_path"))
    if outil == "Write":
        return "edit_document", "Écrit " + nom_fichier(e.get("file_path"))
    if outil == "Read":
        return "description", "Lit " + nom_fichier(e.get("file_path"))
    if outil == "NotebookEdit":
        return "edit", "Modifie " + nom_fichier(e.get("notebook_path"))
    if outil == "Grep":
        return "search", "Cherche « " + court(e.get("pattern"), 30) + " »"
    if outil == "Glob":
        return "search", "Cherche des fichiers"
    if outil == "WebFetch":
        return "public", "Lit une page web"
    if outil == "WebSearch":
        return "travel_explore", "Cherche sur le web : " + court(e.get("query"), 40)
    if outil in ("Task", "Agent"):
        return "smart_toy", "Lance un agent : " + court(e.get("description"), 40)
    if outil == "TodoWrite":
        return "checklist", "Met à jour sa liste"
    if outil == "AskUserQuestion":
        return "help", "Te pose une question"
    if outil.startswith("mcp__"):
        return "extension", "Utilise " + outil.split("__")[1].replace("_", " ")
    return "build", court(outil, 40)


def lignes(t):
    return len(str(t or "").splitlines()) if t else 0


def diff(outil, e):
    """(+ajouts, −retraits) d'une modification."""
    e = e or {}
    if outil == "Edit":
        return lignes(e.get("new_string")), lignes(e.get("old_string"))
    if outil == "MultiEdit":
        m = e.get("edits") or []
        return sum(lignes(x.get("new_string")) for x in m), sum(lignes(x.get("old_string")) for x in m)
    if outil == "Write":
        return lignes(e.get("content")), 0
    return 0, 0


def demande_texte(outil, e):
    e = e or {}
    if outil == "Bash":
        return "Veut lancer une commande", court(e.get("command"), 160)
    if outil in ("Edit", "MultiEdit", "NotebookEdit"):
        return "Veut modifier un fichier", str(e.get("file_path") or e.get("notebook_path") or "").replace(HOME, "~")
    if outil == "Write":
        return "Veut écrire un fichier", str(e.get("file_path") or "").replace(HOME, "~")
    if outil == "WebFetch":
        return "Veut lire une page web", court(e.get("url"), 160)
    if outil.startswith("mcp__"):
        return "Veut utiliser " + outil.split("__")[1].replace("_", " "), court(json.dumps(e, ensure_ascii=False), 160)
    return "Veut utiliser " + outil, court(json.dumps(e, ensure_ascii=False), 160)


# ── Le terminal de la session ────────────────────────────────────────────────────────────────────────────────────
def fenetres():
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
        return json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def terminal_et_shell():
    """Le programme à fenêtre (kitty…) dont descend cet agent, et le processus juste en dessous (le shell de l'onglet,
    pour écrire à l'agent depuis l'île) : on remonte les parents jusqu'à une fenêtre."""
    pids = {w.get("pid") for w in fenetres()}
    p, avant = os.getppid(), 0
    for _ in range(30):
        if p in pids:
            return p, avant
        try:
            with open(f"/proc/{p}/stat") as f:
                p, avant = int(f.read().rsplit(")", 1)[1].split()[1]), p
        except (OSError, ValueError, IndexError):
            return 0, 0
        if p <= 1:
            return 0, 0
    return 0, 0


def terminal_pid():
    return terminal_et_shell()[0]


def socket_kitty(pid):
    """Socket de contrôle du kitty de cette fenêtre (listen_on dans kitty.conf), s'il existe."""
    f = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), f"kitty-{pid}")
    return f if pid and os.path.exists(f) else ""


def reperer_terminal(s):
    """Fenêtre, shell et « peut-on lui écrire depuis l'île » d'une session (une fois pour toutes)."""
    if not s.get("terminal") or not s.get("shell") or "classe" not in s:
        s["terminal"], s["shell"] = terminal_et_shell()
        s["classe"] = next((w.get("class", "") for w in fenetres() if w.get("pid") == s["terminal"]), "")
    s["ecrire"] = bool(s.get("shell") and socket_kitty(s.get("terminal"))) or (s.get("agent") == "opencode" and bool(shutil.which("opencode")))


def terminal_actif(pid):
    if not pid:
        return False
    try:
        r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2)
        return json.loads(r.stdout or "{}").get("pid") == pid
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def ile_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "nc-ile.service"]).returncode == 0


# ── Les événements ───────────────────────────────────────────────────────────────────────────────────────────────
def cle_session(ev, ia="claude"):
    sid = ev.get("session_id") or "?"
    return sid if ia == "claude" else f"{ia}-{sid}"


def session(d, ev, ia="claude"):
    sid = cle_session(ev, ia)
    s = d["sessions"].setdefault(sid, {"id": sid, "etat": "pret", "etapes": [], "ajouts": 0, "retraits": 0,
                                       "debut": time.time()})
    if ia != "claude":
        s["agent"] = ia
    cwd = ev.get("cwd") or s.get("cwd") or ""
    s["cwd"] = cwd.replace(HOME, "~")
    s["projet"] = ev.get("session_title") or os.path.basename(cwd.rstrip("/")) or NOMS.get(ia, "Claude")
    s["maj"] = time.time()
    reperer_terminal(s)
    return s


def ajouter_etape(s, icone, texte):
    s["icone"], s["etape"] = icone, texte
    l = s.setdefault("etapes", [])
    l.append({"icone": icone, "texte": texte, "t": time.time()})
    del l[:-6]


def repondre(sortie):
    print(json.dumps(sortie, ensure_ascii=False))


def attendre(ident, pid, delai=590):
    """Réponse de l'île (oui, toujours, non, terminal, ou le choix d'une question), ou None si tu retournes sur le
    terminal de Claude (la question y repasse) ou si personne ne répond."""
    os.makedirs(REPONSES, mode=0o700, exist_ok=True)
    f = os.path.join(REPONSES, ident)
    fin = time.time() + delai
    n = 0
    while time.time() < fin:
        if os.path.exists(f):
            try:
                with open(f, encoding="utf-8") as x:
                    return x.read().strip()
            finally:
                os.remove(f)
        n += 1
        if n % 3 == 0 and terminal_actif(pid):
            return None
        time.sleep(0.25)
    return None


def demande(ev, genre, ia="claude"):
    """Demande d'autorisation (PermissionRequest) ou question (AskUserQuestion) : dans l'île si tu n'es pas sur le
    terminal de l'IA. Rien sur la sortie standard = la question s'affiche dans le terminal, comme d'habitude.
    Claude, et les IA qui répondent de la même façon (Codex, Qwen Code)."""
    if reglage("CLAUDE_DEMANDES", "ile") != "ile" or not ile_active():
        if ia != "claude":
            suivre(ia, ev.get("session_id"), ev.get("cwd"), "attente")
        return
    outil, e = ev.get("tool_name") or "", ev.get("tool_input") or {}
    if genre == "question":
        qs = e.get("questions") or []
        # L'île sait répondre à une seule question à choix unique ; sinon, le terminal
        if len(qs) != 1 or qs[0].get("multiSelect") or not qs[0].get("options"):
            return
    ident = uuid.uuid4().hex[:12]
    with Etat() as d:
        s = session(d, ev, ia)
        pid = s.get("terminal") or 0
        if terminal_actif(pid):
            if ia != "claude":
                s["etat"] = "terminal"
            return
        s["etat"] = "demande"
        if genre == "question":
            q = e["questions"][0]
            d["demandes"][ident] = {"id": ident, "session": s["id"], "projet": s["projet"], "terminal": pid,
                                    "genre": "question", "titre": court(q.get("question"), 140),
                                    "options": [court(o.get("label"), 40) for o in q.get("options", [])][:4],
                                    "t": time.time()}
        else:
            titre, detail = demande_texte(outil, e)
            d["demandes"][ident] = {"id": ident, "session": s["id"], "projet": s["projet"], "terminal": pid,
                                    "genre": "permission", "titre": titre, "detail": detail, "agent": ia,
                                    "toujours": ia == "claude" and bool(ev.get("permission_suggestions")), "t": time.time()}
    try:
        r = attendre(ident, pid)
    finally:
        with Etat() as d:
            d["demandes"].pop(ident, None)
            s = d["sessions"].get(cle_session(ev, ia))
            if s and s.get("etat") == "demande" and not any(x["session"] == s["id"] for x in d["demandes"].values()):
                # Pas de réponse dans l'île : la question passe dans le terminal (les autres IA ne le signalent pas)
                s["etat"] = "terminal" if ia != "claude" and (not r or r == "terminal") else "travail"
    if not r or r == "terminal":
        return
    if genre == "question":
        q = e["questions"][0]
        if r.startswith("choix:"):
            repondre({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow",
                                             "updatedInput": {"questions": e["questions"],
                                                              "answers": {q.get("question"): r[6:]}}}})
        return
    if r in ("oui", "toujours"):
        decision = {"behavior": "allow"}
        if r == "toujours" and ia == "claude" and ev.get("permission_suggestions"):
            decision["updatedPermissions"] = ev["permission_suggestions"]
        repondre({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}})
    elif r == "non":
        repondre({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                         "decision": {"behavior": "deny", "message": "Refusé depuis l'île dynamique"}}})


def hook():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    if ev.get("cursor_version") or os.environ.get("CURSOR_VERSION"):
        return                                         # Cursor relit les hooks de Claude : il a les siens (nc-claude ia cursor)
    nom = ev.get("hook_event_name") or ""
    if ev.get("agent_id") and nom not in ("PermissionRequest", "PreToolUse"):
        return                                         # sous-agents : seule la session principale est suivie
    # Coupé dans nc-reglages : rien dans l'île (elle cache ces sessions), mais le suivi continue pour les notifications
    if reglage("CLAUDE_ILE", "oui") == "non" and (nom == "PermissionRequest" or os.environ.get("NC_CLAUDE_SYNC")):
        return
    if nom == "PermissionRequest":
        return demande(ev, "permission")
    if nom == "PreToolUse" and ev.get("tool_name") == "AskUserQuestion" and os.environ.get("NC_CLAUDE_SYNC"):
        return demande(ev, "question")
    with Etat() as d:
        if nom == "SessionEnd":
            d["sessions"].pop(ev.get("session_id") or "?", None)
            return
        s = session(d, ev)
        if nom == "SessionStart":
            s["etat"] = "pret"
        elif nom == "UserPromptSubmit":
            s.update(etat="travail", etapes=[], ajouts=0, retraits=0, depart=time.time(), message="")
            ajouter_etape(s, "neurology", "Réfléchit…")
        elif nom == "PreToolUse" and not ev.get("agent_id"):
            if s.get("etat") not in ("demande",):
                s["etat"] = "travail"
            ajouter_etape(s, *etape(ev.get("tool_name") or "", ev.get("tool_input")))
        elif nom == "PostToolUse":
            a, r = diff(ev.get("tool_name") or "", ev.get("tool_input"))
            if a or r:
                s["ajouts"] = s.get("ajouts", 0) + a
                s["retraits"] = s.get("retraits", 0) + r
                if s.get("etapes"):
                    s["etapes"][-1]["diff"] = f"+{a} −{r}"
            if s.get("etat") == "demande" and not d["demandes"]:
                s["etat"] = "travail"
        elif nom == "Notification":
            t = ev.get("notification_type") or ""
            if t == "idle_prompt":
                s["etat"] = "attente"
                if not notif_ouverte(d, s["id"]):
                    notifier(s, "Claude t'attend", s["projet"] + " : à toi de répondre")
            elif t == "permission_prompt" and not any(x["session"] == s["id"] for x in d["demandes"].values()):
                s["etat"] = "terminal"         # Claude attend une réponse dans le terminal
                notifier(s, "Claude demande ton accord", s["projet"] + " : " + court(ev.get("message"), 120))
            elif t in ("agent_needs_input", "elicitation_dialog"):
                notifier(s, "Claude t'attend", s["projet"] + " : " + court(ev.get("message"), 120))
        elif nom == "Stop":
            s["etat"] = "fini"
            s["fin"] = time.time()
            s["message"] = court(ev.get("last_assistant_message"), 160)
            notifier(s, "Claude a terminé", s["projet"] + (" : " + s["message"] if s["message"] else ""))


# ── Notifications : les nôtres à la place de celles de Claude ─────────────────────────────────────────────────────────
# Claude envoie les siennes par son terminal (kitty) : elles restaient dans la liste, et un clic ramenait sur une autre
# fenêtre que la sienne. « nc-claude installer » les coupe (preferredNotifChannel) ; celles-ci ramènent sur le bon
# terminal (et le bon onglet de kitty) et s'en vont seules dès que tu y retournes, que Claude repart ou se ferme.
def notif_ouverte(d, sid):
    try:
        os.kill(int(d.get("notifs", {}).get(sid) or 0) or -1, 0)
        return True
    except (OSError, ValueError):
        return False


def notifier(s, titre, texte):
    """Lance la notification de cette session en arrière-plan (le hook, lui, rend la main tout de suite) ; rien si tu
    es déjà sur son terminal."""
    if not shutil.which("notify-send") or terminal_actif(s.get("terminal")):
        return
    subprocess.Popen([os.path.abspath(sys.argv[0]), "notification", s["id"], titre, texte], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notification(sid, titre, texte):
    moi = str(os.getpid())
    with Etat() as d:
        s = d["sessions"].get(sid)
        if not s:
            return
        d.setdefault("notifs", {})[sid] = moi          # une seule par session : la précédente se ferme d'elle-même
        term, shell = s.get("terminal") or 0, s.get("shell") or 0
        icone = (s.get("classe") or "utilities-terminal").lower()
    p = subprocess.Popen(["notify-send", "-a", "Claude Code", "-i", icone, "-p", "-A", "default=Ouvrir", titre, texte],
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    nid = p.stdout.readline().strip()
    debut = time.time()
    while p.poll() is None:
        time.sleep(1)
        try:
            with open(ETAT, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        s = d.get("sessions", {}).get(sid)
        if (not s or d.get("notifs", {}).get(sid) != moi or terminal_actif(term) or time.time() - debut > 4 * 3600
                or (s.get("etat") in ("travail", "demande") and s.get("maj", 0) > debut)):
            if nid.isdigit():
                subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                                "--object-path", "/org/freedesktop/Notifications",
                                "--method", "org.freedesktop.Notifications.CloseNotification", nid],
                               capture_output=True, timeout=5)
            p.terminate()
            break
    else:
        if p.stdout.read().strip() == "default":     # clic sur la notification
            aller(term, shell)
    with Etat() as d:
        if d.get("notifs", {}).get(sid) == moi:
            del d["notifs"][sid]


def aller(term, shell=0):
    """Va sur le terminal d'une session : sa fenêtre (ramenée si elle est réduite) et, dans kitty, son onglet."""
    term, shell = int(term or 0), int(shell or 0)
    sock = socket_kitty(term)
    if sock and shell:
        subprocess.run(["kitty", "@", "--to", "unix:" + sock, "focus-window", "--match", f"pid:{shell}"],
                       capture_output=True, timeout=5)
    a = next((w.get("address") for w in fenetres() if w.get("pid") == term), "")
    fenetre = os.path.join(HOME, ".local/bin/nc-fenetre")
    if a and os.access(fenetre, os.X_OK):
        subprocess.run([fenetre, "aller", a], capture_output=True, timeout=5)
    elif term:
        subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ window = 'pid:{term}' }})"], capture_output=True, timeout=5)


# ── Les autres IA (Antigravity, opencode…) : même suivi, quelle que soit l'IA ────────────────────────────────────────
# Chaque IA appelle « nc-claude <ia> ÉVÉNEMENT » à sa façon (hooks, plugin) ; suivre() met sa session à jour comme
# celles de Claude, avec agent: "<ia>" pour son logo et sa couleur dans l'île. Leurs demandes d'autorisation restent
# dans leur terminal (l'île montre « t'attend » quand l'IA le signale).
JOURNAL = os.path.join(RUN, "agents.log")
NOMS = {"claude": "Claude", "antigravity": "Antigravity"}
CMD = ("bash", "run_command", "run_shell_command", "shell", "exec_command", "local_shell", "terminal", "run_terminal_cmd")
MODIF = ("edit", "multiedit", "replace", "replace_file_content", "multi_replace_file_content", "apply_patch", "patch",
         "str_replace", "str_replace_editor", "edit_file", "search_replace")
ECRIT = ("write", "write_file", "write_to_file", "create_file", "create")
LIT = ("read", "read_file", "read_many_files", "view", "view_file", "view_file_outline", "view_code_item", "cat")
GREP = ("grep", "grep_search", "search_file_content", "rg", "codebase_search")
TROUVE = ("glob", "find_by_name", "find", "file_search")
LISTE = ("list", "ls", "list_dir", "list_directory")
PAGE = ("webfetch", "web_fetch", "read_url_content", "fetch")
WEB = ("websearch", "web_search", "google_web_search", "search_web")
AGENT = ("task", "agent", "invoke_subagent", "subagent")
TODO = ("todowrite", "todo_write", "write_todos", "update_plan", "todoread")


def arg(e, *cles):
    e = e if isinstance(e, dict) else {}
    bas = {k.lower(): v for k, v in e.items()}
    for c in cles:
        if bas.get(c.lower()):
            return bas[c.lower()]
    return ""


def etape_generique(outil, e):
    """(icône, texte) pour un outil de n'importe quelle IA (noms de Claude, Antigravity, opencode, Codex, Gemini…)."""
    o = str(outil or "").lower()
    f = nom_fichier(arg(e, "file_path", "filePath", "TargetFile", "AbsolutePath", "absolute_path", "path", "file"))
    if o in CMD:
        c = arg(e, "command", "CommandLine", "cmd")
        c = " ".join(map(str, c)) if isinstance(c, list) else str(c)
        c = re.sub(r"^(bash|sh|zsh) -l?c ", "", c)
        return "terminal", "Lance : " + court(re.sub(r"^\s*cd\s+\S+\s*(&&|;)\s*", "", c), 60)
    if o in MODIF:
        m = re.search(r"\*\*\* (?:Update|Add) File: (\S+)", str(arg(e, "command", "patch", "input")))   # apply_patch (Codex)
        f = nom_fichier(m.group(1)) if m and f == "un fichier" else f
        return "edit", "Modifie " + f if f != "un fichier" else "Modifie des fichiers"
    if o == "delete":
        return "delete", "Supprime " + f
    if o in ECRIT:
        return "edit_document", "Écrit " + f
    if o in LIT:
        return "description", "Lit " + f
    if o in GREP:
        return "search", "Cherche « " + court(arg(e, "pattern", "query", "Query", "Pattern"), 30) + " »"
    if o in TROUVE:
        return "search", "Cherche des fichiers"
    if o in LISTE:
        return "folder_open", "Parcourt " + nom_fichier(arg(e, "DirectoryPath", "dir_path", "path"))
    if o in PAGE:
        return "public", "Lit une page web"
    if o in WEB:
        return "travel_explore", "Cherche sur le web : " + court(arg(e, "query", "Query"), 40)
    if o in AGENT:
        return "smart_toy", "Lance un agent" + (" : " + court(arg(e, "description"), 40) if arg(e, "description") else "")
    if o in TODO:
        return "checklist", "Met à jour sa liste"
    if o.startswith("browser_"):
        return "public", "Utilise le navigateur"
    if o.startswith("mcp__") or "__" in o:
        return "extension", "Utilise " + o.split("__")[1 if o.startswith("mcp__") else 0].replace("_", " ")
    return "build", court(str(outil).replace("_", " "), 40)


def diff_generique(e):
    """(+ajouts, −retraits) d'une modification, où que soit le texte dans les arguments (ou un patch unifié)."""
    t = {"plus": 0, "moins": 0}

    def visite(x):
        if isinstance(x, dict):
            for k, v in x.items():
                if isinstance(v, str):
                    k = k.lower()
                    if k in ("new_string", "newstring", "replacementcontent", "codecontent", "content", "new_str"):
                        t["plus"] += lignes(v)
                    elif k in ("old_string", "oldstring", "targetcontent", "old_str"):
                        t["moins"] += lignes(v)
                    elif k in ("patch", "input", "patchtext", "command") and ("\n+" in v or "\n-" in v):
                        for l in v.splitlines():
                            if l.startswith("+") and not l.startswith("+++"):
                                t["plus"] += 1
                            elif l.startswith("-") and not l.startswith("---"):
                                t["moins"] += 1
                else:
                    visite(v)
        elif isinstance(x, list):
            for v in x:
                visite(v)
    visite(e)
    return t["plus"], t["moins"]


def journal(agent, nom, detail=""):
    """Les 60 derniers événements reçus des IA (pour nc-claude diag)."""
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    try:
        with open(JOURNAL, encoding="utf-8") as f:
            l = f.read().splitlines()[-59:]
    except OSError:
        l = []
    l.append(f"{time.strftime('%H:%M:%S')} {agent} {nom} {detail}".strip())
    with open(JOURNAL, "w", encoding="utf-8") as f:
        f.write("\n".join(l) + "\n")


def suivre(agent, sid, cwd, quoi, outil="", args=None, erreur=False, message=""):
    """Met à jour la session d'une IA. quoi : debut (nouvelle demande), etape (un outil), attente (t'attend dans son
    terminal), fini (a fini sa réponse), fin (session fermée)."""
    sid = f"{agent}-{sid or '?'}"
    cwd = str(cwd or "")
    if cwd.startswith("file://"):
        cwd = urllib.parse.unquote(cwd[7:])
    with Etat() as d:
        if quoi == "fin":
            d["sessions"].pop(sid, None)
            return
        s = d["sessions"].setdefault(sid, {"id": sid, "etat": "pret", "etapes": [], "ajouts": 0, "retraits": 0,
                                           "debut": time.time()})
        s["agent"] = agent
        if cwd:
            s["cwd"] = cwd.replace(HOME, "~")
        s["projet"] = os.path.basename(cwd.rstrip("/")) or s.get("projet") or NOMS.get(agent, agent)
        s["maj"] = time.time()
        reperer_terminal(s)
        if quoi == "debut" or (quoi == "etape" and s.get("etat") in ("pret", "fini", "attente")):
            s.update(etat="travail", etapes=[], ajouts=0, retraits=0, depart=time.time(), message="")
            ajouter_etape(s, "neurology", "Réfléchit…")
        if quoi == "etape" and outil:
            s["etat"] = "travail"
            ajouter_etape(s, *etape_generique(outil, args))
            if not erreur and str(outil).lower() in MODIF + ECRIT:
                a, r = diff_generique(args)
                if a or r:
                    s["ajouts"] = s.get("ajouts", 0) + a
                    s["retraits"] = s.get("retraits", 0) + r
                    s["etapes"][-1]["diff"] = f"+{a} −{r}"
        elif quoi == "attente":
            s["etat"] = "terminal"
        elif quoi == "fini" and s.get("etat") in ("travail", "terminal"):
            s["etat"] = "fini"
            s["fin"] = time.time()
            if message:
                s["message"] = court(message, 160)


def lire_entree():
    try:
        ev = json.load(sys.stdin)
        return ev if isinstance(ev, dict) else {}
    except ValueError:
        return {}


# ── Antigravity (Google : appli, éditeur, agy) ─────────────────────────────────────────────────────────────────────
# Ses hooks (https://antigravity.google/docs/hooks) ne donnent ni le nom de l'événement (passé en argument), ni de
# demande d'autorisation. Seulement des événements qui ne décident de rien (PostToolUse plutôt que PreToolUse : un
# PreToolUse qui échoue bloquerait l'outil). Coupés par agy en mode sans autorisations (--dangerously-skip-permissions).
AGY_HOOKS = os.path.join(HOME, ".gemini/config/hooks.json")
AGY_GROUPE = "nc-ile"
AGY_EVENEMENTS = ("PreInvocation", "PostToolUse", "Stop")     # les 5 événements du CLI 1.1 : pas de SessionStart


def hook_agy(nom):
    print("{}")                                        # ne décide de rien
    sys.stdout.flush()
    ev = lire_entree()
    tc = ev.get("toolCall") or {}
    journal("antigravity", nom, (tc.get("name") or "") + " " + str(ev.get("conversationId", ""))[:8])
    if reglage("ANTIGRAVITY_ILE", "oui") == "non" or nom not in AGY_EVENEMENTS or not ev:
        return
    sid, ws = ev.get("conversationId"), (ev.get("workspacePaths") or [""])[0]
    if nom == "PreInvocation":
        with Etat() as d:
            en_cours = d["sessions"].get(f"antigravity-{sid}", {}).get("etat") == "travail"
        if not en_cours:
            suivre("antigravity", sid, ws, "debut")
    elif nom == "PostToolUse" and tc.get("name"):
        suivre("antigravity", sid, ws, "etape", tc["name"], tc.get("args"), bool(ev.get("error")))
    elif nom == "Stop" and ev.get("fullyIdle", True):
        suivre("antigravity", sid, ws, "fini")


def lire_json(chemin):
    try:
        with open(chemin, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError:
        sys.exit(f"nc-claude : {chemin} n'est pas un JSON valide : rien n'a été changé.")


def ecrire_json(chemin, cfg):
    os.makedirs(os.path.dirname(chemin), exist_ok=True)
    if os.path.exists(chemin):
        copie = chemin + ".avant-nc-claude"
        if not os.path.exists(copie):
            shutil.copy2(chemin, copie)
    tmp = chemin + ".nc-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, chemin)


# ── Toutes les IA : où chacune se branche, comment l'installer et la retirer ─────────────────────────────────────────
# Chaque IA appelle « nc-claude ia <ia> <événement> » (JSON de l'événement sur l'entrée standard) : par ses hooks
# (Codex, Gemini CLI, Cursor, Copilot CLI, Qwen Code, Kiro) ou par une petite extension (opencode, Amp). Antigravity a
# son propre format (hook_agy). Réglages : <IA>_ILE=oui/non (nc-reglages → Agents IA).
PY = shlex.quote(sys.executable)
NC = shlex.quote(os.path.realpath(__file__))
IAS = {
    # clé : nom affiché, programmes, dossiers qui trahissent sa présence
    "antigravity": ("Antigravity", ("agy", "antigravity"), ("~/.gemini/antigravity-cli", "~/.gemini/config")),
    "opencode": ("OpenCode", ("opencode",), ("~/.config/opencode",)),
    "codex": ("Codex", ("codex",), ("~/.codex",)),
    "gemini": ("Gemini CLI", ("gemini",), ()),
    "cursor": ("Cursor", ("cursor-agent", "cursor"), ("~/.cursor",)),
    "copilot": ("Copilot", ("copilot",), ("~/.copilot",)),
    "qwen": ("Qwen Code", ("qwen",), ("~/.qwen",)),
    "kiro": ("Kiro", ("kiro-cli", "kiro"), ("~/.kiro",)),
    "amp": ("Amp", ("amp",), ("~/.config/amp",)),
}
NOMS.update({k: v[0] for k, v in IAS.items()})
FICHIERS = {
    "antigravity": "~/.gemini/config/hooks.json", "opencode": "~/.config/opencode/plugins/nc-ile.js",
    "codex": "~/.codex/hooks.json", "gemini": "~/.gemini/settings.json", "cursor": "~/.cursor/hooks.json",
    "copilot": "~/.copilot/hooks/nc-ile.json", "qwen": "~/.qwen/settings.json", "kiro": "~/.kiro/hooks/nc-ile.json",
    "amp": "~/.config/amp/plugins/nc-ile.js",
}
# Événements écoutés, par IA (rien qui décide : seulement observer ; PostToolUse là où un hook avant l'outil pourrait
# le bloquer en cas d'erreur)
EVENEMENTS = {
    "codex": ("UserPromptSubmit", "PreToolUse", "PermissionRequest", "Stop", "SessionEnd"),
    "gemini": ("BeforeAgent", "AfterTool", "AfterAgent", "Notification", "SessionEnd"),
    "qwen": ("UserPromptSubmit", "PostToolUse", "PermissionRequest", "Notification", "Stop"),
    "cursor": ("beforeSubmitPrompt", "postToolUse", "stop", "sessionEnd"),
    "copilot": ("userPromptSubmitted", "postToolUse", "agentStop", "notification", "sessionEnd"),
    "kiro": ("UserPromptSubmit", "PostToolUse", "Stop"),
}
DEMANDES_ILE = ("codex", "qwen")     # IA qui acceptent « autoriser / refuser » par leur hook, comme Claude
DEBUT = ("userpromptsubmit", "beforeagent", "userpromptsubmitted", "beforesubmitprompt", "prompt")
ETAPE = ("pretooluse", "posttooluse", "aftertool", "tool")
ATTENTE = ("permissionrequest", "permission")
FINI = ("stop", "afteragent", "agentstop")


def chemin(ia):
    return os.path.expanduser(FICHIERS[ia])


def commande(ia, ev):
    return f"{PY} {NC} ia {ia} {ev}"


def present(ia):
    nom, progs, dossiers = IAS[ia]
    return any(shutil.which(p) for p in progs) or any(os.path.isdir(os.path.expanduser(d)) for d in dossiers)


def installe(ia):
    try:
        with open(chemin(ia), encoding="utf-8") as f:
            t = f.read()
    except OSError:
        return False
    return "nc-claude" in t and (ia == "antigravity" or f" ia {ia} " in t or "nc-ile" in t)


def nettoyer(cfg, marque):
    """Retire de cfg["hooks"] nos hooks (ceux dont la commande contient marque), et les groupes ou événements vidés."""
    hooks = cfg.get("hooks")
    if isinstance(hooks, dict):
        for ev in list(hooks):
            if not isinstance(hooks[ev], list):
                continue
            l = []
            for g in hooks[ev]:
                if isinstance(g, dict) and isinstance(g.get("hooks"), list):
                    g = dict(g, hooks=[h for h in g["hooks"] if marque not in json.dumps(h)])
                    if g["hooks"]:
                        l.append(g)
                elif marque not in json.dumps(g):
                    l.append(g)
            if l:
                hooks[ev] = l
            else:
                del hooks[ev]
    return cfg


PLUGIN_OPENCODE = r'''// nc-ile : OpenCode dans l'île dynamique de noctalia-config (écrit par « nc-claude installer opencode » ;
// « nc-claude retirer opencode » l'enlève). OpenCode 1 appelle server(), OpenCode 2 appelle setup().
import { spawn } from "node:child_process"
const envoyer = (ev, o) => {
  try {
    const p = spawn(@PY@, [@NC@, "ia", "opencode", ev], { stdio: ["pipe", "ignore", "ignore"], detached: true })
    p.on("error", () => {})
    p.stdin.on("error", () => {})
    p.stdin.end(JSON.stringify(o))
    p.unref()
  } catch {}
}
// Événements : OpenCode 1 (properties, session.idle…) et 2 (data, session.execution.succeeded…)
const FIN = ["session.idle", "session.execution.succeeded", "session.execution.interrupted", "session.execution.failed"]
const ATTENTE = ["permission.asked", "question.asked", "form.created"]
const REPRISE = ["permission.replied", "permission.rejected", "question.replied", "form.replied", "form.cancelled"]
const evenement = (e, dir) => {
  if (!e) return
  const p = e.properties || e.data || {}
  const sid = p.sessionID || (p.info && p.info.id) || (p.form && p.form.sessionID)
  if (!sid) return
  if (FIN.includes(e.type) || (e.type === "session.status" && p.status && p.status.type === "idle")) envoyer("stop", { session_id: sid, cwd: dir })
  else if (ATTENTE.includes(e.type)) envoyer("permission", { session_id: sid, cwd: dir })
  else if (REPRISE.includes(e.type)) envoyer("reprise", { session_id: sid, cwd: dir })
  else if (e.type === "session.deleted") envoyer("fin", { session_id: sid, cwd: dir })
}
export default {
  id: "nc-ile",
  async setup(ctx) {
    const dir = (ctx.location && ctx.location.directory) || process.cwd()
    const c = new AbortController()
    try { await ctx.session.hook("prompt", (e) => envoyer("prompt", { session_id: e && e.sessionID, cwd: dir })) } catch {}
    try { await ctx.tool.hook("execute.after", (e) => envoyer("tool", { session_id: e.sessionID, cwd: dir, tool: e.tool, args: e.input })) } catch {}
    ;(async () => {
      try { for await (const e of ctx.event.subscribe({ signal: c.signal })) evenement(e, dir) } catch {}
    })()
    return () => c.abort()
  },
  async server(input) {
    const dir = (input && input.directory) || process.cwd()
    return {
      "chat.message": async (i) => envoyer("prompt", { session_id: i.sessionID, cwd: dir }),
      "tool.execute.after": async (i) => envoyer("tool", { session_id: i.sessionID, cwd: dir, tool: i.tool, args: i.args }),
      event: async ({ event }) => evenement(event, dir),
    }
  },
}
'''
PLUGIN_AMP = r'''// nc-ile : Amp dans l'île dynamique de noctalia-config (écrit par « nc-claude installer amp » ;
// « nc-claude retirer amp » l'enlève). Ne décide de rien : il regarde seulement.
import { spawn } from "node:child_process"
const envoyer = (ev, o) => {
  try {
    const p = spawn(@PY@, [@NC@, "ia", "amp", ev], { stdio: ["pipe", "ignore", "ignore"], detached: true })
    p.on("error", () => {})
    p.stdin.on("error", () => {})
    p.stdin.end(JSON.stringify(o))
    p.unref()
  } catch {}
}
const sid = (e) => (e && e.thread && e.thread.id) || (e && e.threadID) || "amp"
export default function (amp) {
  amp.on("agent.start", async (e) => { envoyer("prompt", { session_id: sid(e), cwd: process.cwd() }) })
  amp.on("tool.result", async (e) => { envoyer("tool", { session_id: sid(e), cwd: process.cwd(), tool: e && e.tool, args: e && e.input, erreur: e && e.status === "error" }) })
  amp.on("agent.end", async (e) => { envoyer("stop", { session_id: sid(e), cwd: process.cwd() }) })
}
'''


def installer_ia(ia, bavard=True):
    f = chemin(ia)
    if ia == "antigravity":
        cfg = lire_json(f)
        base = f"{PY} {NC} agy "
        h = lambda ev: {"type": "command", "command": base + ev, "timeout": 10}
        cfg[AGY_GROUPE] = {"enabled": True, "PreInvocation": [h("PreInvocation")],
                           "PostToolUse": [{"matcher": "*", "hooks": [h("PostToolUse")]}], "Stop": [h("Stop")]}
        ecrire_json(f, cfg)
    elif ia in ("opencode", "amp"):
        os.makedirs(os.path.dirname(f), exist_ok=True)
        js = (PLUGIN_OPENCODE if ia == "opencode" else PLUGIN_AMP).replace("@PY@", json.dumps(sys.executable))
        with open(f, "w", encoding="utf-8") as x:
            x.write(js.replace("@NC@", json.dumps(os.path.realpath(__file__))))
    elif ia in ("copilot", "kiro"):
        if ia == "copilot":
            cfg = {"version": 1, "hooks": {ev: [{"type": "command", "bash": commande(ia, ev), "timeoutSec": 5}]
                                           for ev in EVENEMENTS[ia]}}
        else:
            cfg = {"version": "v1", "hooks": [dict({"name": f"nc-ile-{ev}", "trigger": ev, "timeout": 10,
                                                    "action": {"type": "command", "command": commande(ia, ev)}},
                                                   **({"matcher": "*"} if "Tool" in ev else {}))
                                              for ev in EVENEMENTS[ia]]}
        ecrire_json(f, cfg)
    else:
        cfg = nettoyer(lire_json(f), f" ia {ia} ")
        hooks = cfg.setdefault("hooks", {})
        if ia == "cursor":
            cfg.setdefault("version", 1)
        for ev in EVENEMENTS[ia]:
            c = commande(ia, ev)
            if ia == "cursor":
                hooks.setdefault(ev, []).append({"command": c, "timeout": 5})
                continue
            if ia == "gemini":
                h = {"name": f"nc-ile-{ev}", "type": "command", "command": c, "timeout": 5000}
            elif ev == "PermissionRequest":
                h = {"type": "command", "command": c, "timeout": 600}   # attend ta réponse dans l'île
            else:
                h = {"type": "command", "command": c, "timeout": 10}
                if ia == "codex":
                    h["async"] = True
            g = {"hooks": [h]}
            if "Tool" in ev or ev == "PermissionRequest":
                g = {"matcher": ".*" if ia in ("gemini", "qwen") else "*", "hooks": [h]}
            hooks.setdefault(ev, []).append(g)
        ecrire_json(f, cfg)
    if bavard:
        print(f"{NOMS[ia]} s'affiche maintenant dans l'île ({f.replace(HOME, '~')}).")
        if ia == "codex":
            print("Codex demande d'approuver ses nouveaux hooks : ouvre-le et tape /hooks une fois.")
        print(f"Relance {NOMS[ia]} s'il est ouvert. Pour vérifier : nc-claude diag ; pour l'enlever : nc-claude retirer {ia}")


def retirer_ia(ia):
    f = chemin(ia)
    if os.path.exists(f):
        if ia == "antigravity":
            cfg = lire_json(f)
            if cfg.pop(AGY_GROUPE, None) is not None:
                ecrire_json(f, cfg)
        elif ia in ("opencode", "amp", "copilot", "kiro"):
            os.remove(f)                       # fichier à nous
        else:
            ecrire_json(f, nettoyer(lire_json(f), f" ia {ia} "))
    print(f"{NOMS[ia]} retiré de l'île.")
    with Etat() as d:
        for sid in [x for x in d["sessions"] if x.startswith(ia + "-")]:
            del d["sessions"][sid]


def hook_ia(ia, nom):
    """Un événement d'une IA (JSON sur l'entrée standard), ramené à : début, étape, attente, fini, fin."""
    ev = lire_entree()
    n = (nom or ev.get("hook_event_name") or "").lower()
    # Réponses attendues : Gemini lit du JSON, Cursor veut « continue » avant d'envoyer la demande ; les autres rien
    if ia == "gemini":
        print("{}")
    elif ia == "cursor" and n == "beforesubmitprompt":
        print('{"continue": true}')
    sys.stdout.flush()
    outil = ev.get("tool_name") or ev.get("toolName") or ev.get("tool") or ""
    journal(ia, nom, outil)
    if reglage(ia.upper() + "_ILE", "oui") == "non" or not ev:
        return
    sid = ev.get("session_id") or ev.get("sessionId") or ev.get("conversation_id") or ev.get("conversationId")
    cwd = ev.get("cwd") or (ev.get("workspace_roots") or [""])[0] or ev.get("directory") or ""
    if n == "permissionrequest" and ia in DEMANDES_ILE:
        ev.setdefault("session_id", sid)
        demande(ev, "permission", ia)          # attend ta réponse dans l'île (ou ton retour sur son terminal)
    elif n in DEBUT:
        suivre(ia, sid, cwd, "debut")
    elif n in ETAPE and outil:
        args = ev.get("tool_input") or ev.get("toolArgs") or ev.get("args") or ev.get("input") or {}
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = {"command": args}
        suivre(ia, sid, cwd, "etape", outil, args, bool(ev.get("erreur") or ev.get("error")))
    elif n in ATTENTE or (n == "notification" and str(ev.get("notification_type") or "").lower()
                          in ("permission_prompt", "toolpermission", "elicitation_dialog")):
        suivre(ia, sid, cwd, "attente")
    elif n == "reprise":
        with Etat() as d:
            s = d["sessions"].get(f"{ia}-{sid}")
            if s and s.get("etat") == "terminal":
                s["etat"] = "travail"
    elif n in FINI:
        suivre(ia, sid, cwd, "fini", message=ev.get("last_assistant_message") or ev.get("prompt_response") or "")
    elif n in ("sessionend", "fin"):
        suivre(ia, sid, cwd, "fin")


# ── Installation des hooks ───────────────────────────────────────────────────────────────────────────────────────
def a_nous(h):
    return "nc-claude hook" in str(h.get("command", ""))


def retirer_de(cfg):
    hooks = cfg.get("hooks") or {}
    for ev in list(hooks):
        groupes = []
        for g in hooks[ev]:
            g = dict(g)
            g["hooks"] = [h for h in g.get("hooks", []) if not a_nous(h)]
            if g["hooks"]:
                groupes.append(g)
        if groupes:
            hooks[ev] = groupes
        else:
            del hooks[ev]
    if hooks:
        cfg["hooks"] = hooks
    else:
        cfg.pop("hooks", None)
    return cfg


def lire_settings():
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError:
        sys.exit(f"nc-claude : {SETTINGS} n'est pas un JSON valide : rien n'a été changé.")


def ecrire_settings(cfg):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    if os.path.exists(SETTINGS):
        copie = SETTINGS + ".avant-nc-claude"
        if not os.path.exists(copie):
            shutil.copy2(SETTINGS, copie)
    tmp = SETTINGS + ".nc-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SETTINGS)


def installer(bavard=True):
    avant = lire_settings()
    cfg = retirer_de(json.loads(json.dumps(avant)))
    hooks = cfg.setdefault("hooks", {})
    vite = {"type": "command", "command": COMMANDE, "async": True, "timeout": 10}
    for ev in ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop", "SessionEnd"):
        hooks.setdefault(ev, []).append({"hooks": [dict(vite)]})
    # Demandes : le hook attend ta réponse dans l'île (ou ton retour sur le terminal), 10 min au plus
    hooks.setdefault("PermissionRequest", []).append(
        {"hooks": [{"type": "command", "command": COMMANDE, "timeout": 600}]})
    hooks.setdefault("PreToolUse", []).append(
        {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "NC_CLAUDE_SYNC=1 " + COMMANDE, "timeout": 600}]})
    # Les notifications de Claude (par son terminal) : remplacées par celles de nc-claude (voir notifier)
    if cfg.get("preferredNotifChannel", "auto") == "auto":
        cfg["preferredNotifChannel"] = "notifications_disabled"
    if cfg != avant:
        ecrire_settings(cfg)
    if not bavard:
        return
    print(f"Claude Code s'affiche maintenant dans l'île (hooks ajoutés à {SETTINGS.replace(HOME, '~')}).")
    print("Les sessions de Claude déjà ouvertes le prennent en compte d'elles-mêmes (sinon : relance claude).")
    print("Pour l'enlever : nc-claude retirer")


def retirer():
    if not os.path.exists(SETTINGS):
        print("Rien à retirer.")
        return
    cfg = retirer_de(lire_settings())
    if cfg.get("preferredNotifChannel") == "notifications_disabled":
        del cfg["preferredNotifChannel"]           # ses propres notifications reviennent
    ecrire_settings(cfg)
    print("Hooks de l'île retirés de " + SETTINGS.replace(HOME, "~") + ".")


def montrer():
    try:
        d = json.load(open(ETAT, encoding="utf-8"))
    except (OSError, ValueError):
        print("Aucune session de Claude Code suivie.")
        return
    for s in d.get("sessions", {}).values():
        print(f"{s.get('projet')}  [{s.get('etat')}]  {s.get('etape', '')}  +{s.get('ajouts', 0)} −{s.get('retraits', 0)}")
    for x in d.get("demandes", {}).values():
        print(f"  demande : {x.get('titre')} {x.get('detail', '')}")


def ecrire(sid, texte):
    """Écrit un message à l'agent d'une session depuis l'île : tapé dans son terminal (kitty), puis Entrée."""
    texte = re.sub(r"\s+", " ", texte).strip()
    try:
        s = json.load(open(ETAT, encoding="utf-8"))["sessions"][sid]
    except (OSError, ValueError, KeyError):
        sys.exit("nc-claude : session inconnue.")
    sock = socket_kitty(s.get("terminal"))
    if texte and s.get("agent") == "opencode" and not (sock and s.get("shell")) and shutil.which("opencode"):
        # OpenCode 2 tourne en service de fond : le message part dans la session par sa propre commande
        subprocess.Popen(["opencode", "run", "--session", sid.split("-", 1)[1], texte], cwd=os.path.expanduser(s.get("cwd") or "~"),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif not texte or not sock or not s.get("shell"):
        sys.exit("nc-claude : on ne peut écrire qu'à un agent lancé dans kitty.")
    else:
        envoyer_kitty(sock, s["shell"], texte)
    with Etat() as d:
        x = d["sessions"].get(sid)
        if x:
            x.update(etat="travail", maj=time.time())
            ajouter_etape(x, "chat", "Toi : " + court(texte, 50))


def envoyer_kitty(sock, shell, texte):
    base = ["kitty", "@", "--to", "unix:" + sock, "send-text", "--match", f"pid:{shell}"]
    r = subprocess.run(base + ["--bracketed-paste", "auto", "--stdin"], input=texte, text=True, capture_output=True, timeout=5)
    if r.returncode:
        sys.exit("nc-claude : " + (r.stderr.strip() or "kitty n'a pas accepté le texte"))
    time.sleep(0.2)                            # Entrée à part : sinon prise pour un retour à la ligne du texte collé
    subprocess.run(base + ["--stdin"], input="\r", text=True, capture_output=True, timeout=5)


def diag():
    """Ce qui est en place, en clair : à envoyer si l'île ne montre rien."""
    def ligne(ok, texte):
        print(("  ✓ " if ok else "  ✗ ") + texte)
    ligne(ile_active(), "île (nc-ile.service) " + ("active" if ile_active() else "arrêtée : systemctl --user start nc-ile"))
    try:
        cc = "nc-claude hook" in open(SETTINGS, encoding="utf-8").read()
    except OSError:
        cc = False
    if cc or os.path.isdir(os.path.join(HOME, ".claude")):
        ligne(cc and reglage("CLAUDE_ILE", "oui") != "non",
              "Claude Code : " + ("branché" if cc else "pas branché (nc-claude installer)")
              + (" — coupé dans nc-reglages" if reglage("CLAUDE_ILE", "oui") == "non" else ""))
    for ia in IAS:
        if not present(ia) and not installe(ia):
            continue
        ok = installe(ia)
        ligne(ok and reglage(ia.upper() + "_ILE", "oui") != "non",
              f"{NOMS[ia]} : " + (f"branché ({FICHIERS[ia]})" if ok else f"pas branché (nc-claude installer {ia})")
              + (" — coupé dans nc-reglages" if reglage(ia.upper() + "_ILE", "oui") == "non" else ""))
        if ia == "antigravity" and ok:
            print("      agy lancé avec --dangerously-skip-permissions : selon sa version, ses hooks ne tournent pas")
        if ia == "codex" and ok:
            print("      Codex : ses hooks doivent être approuvés une fois (/hooks dans Codex)")
    try:
        l = open(JOURNAL, encoding="utf-8").read().splitlines()
        print(f"Derniers événements reçus des IA ({len(l)}) :")
        for x in l[-10:]:
            print("  " + x)
    except OSError:
        print("Aucun événement reçu d'une IA (hors Claude) : relance-la après l'installation, puis donne-lui une demande.")
    print("Sessions suivies :")
    montrer()


def main():
    a = sys.argv[1:]
    if os.environ.get("NC_ILE_SANS") and a and a[0] in ("hook", "agy", "ia"):
        return                                 # question rapide du Spotlight (nc-demander) : pas une session à suivre
    if not a:
        print(__doc__.strip())
    elif a[0] == "hook":
        try:
            hook()
        except Exception:                      # un hook ne doit jamais gêner Claude
            pass
    elif a[0] == "agy":
        try:
            hook_agy(a[1] if len(a) > 1 else "")
        except Exception:                      # un hook ne doit jamais gêner Antigravity
            pass
    elif a[0] == "ia" and len(a) >= 3:
        try:
            hook_ia(a[1], a[2])
        except Exception:                      # un hook ne doit jamais gêner l'IA
            pass
    elif a[0] in ("installer", "retirer"):
        quoi = a[1] if len(a) > 1 else "claude"
        if quoi == "tout":
            for ia in [x for x in IAS if present(x)]:
                (installer_ia if a[0] == "installer" else retirer_ia)(ia)
        elif quoi in IAS:
            (installer_ia if a[0] == "installer" else retirer_ia)(quoi)
        elif quoi == "claude":
            installer() if a[0] == "installer" else retirer()
        else:
            sys.exit("nc-claude : IA inconnue. Au choix : claude, " + ", ".join(IAS) + ", tout")
    elif a[0] == "detecter":
        # IA présentes, pas encore branchées, pas refusées (pour install.sh)
        print(" ".join(ia for ia in IAS if present(ia) and not installe(ia) and reglage(ia.upper() + "_ILE", "oui") != "non"))
    elif a[0] == "actualiser":
        # IA déjà branchées : remises au format du jour (nc-maj), sans rien demander
        try:
            if "nc-claude hook" in open(SETTINGS, encoding="utf-8").read():
                installer(bavard=False)
        except OSError:
            pass
        for ia in IAS:
            if installe(ia) and reglage(ia.upper() + "_ILE", "oui") != "non":
                installer_ia(ia, bavard=False)
    elif a[0] == "etat":
        montrer()
    elif a[0] == "diag":
        diag()
    elif a[0] == "ecrire" and len(a) >= 3:
        ecrire(a[1], " ".join(a[2:]))
    elif a[0] == "notification" and len(a) >= 4:
        notification(a[1], a[2], a[3])
    elif a[0] == "aller" and len(a) >= 2:
        aller(a[1], a[2] if len(a) > 2 else 0)
    else:
        print(__doc__.strip())


if __name__ == "__main__":
    main()
