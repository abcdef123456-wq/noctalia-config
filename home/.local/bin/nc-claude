#!/usr/bin/env python3
"""nc-claude : Claude Code dans l'île dynamique (comme l'appli coucou) : ce qu'il fait, étape par étape, quand il a
fini, et ses demandes (autoriser une commande, répondre à une question) depuis l'île.
  nc-claude installer   ajoute les hooks à ~/.claude/settings.json (copie de l'ancien fichier gardée à côté)
  nc-claude retirer     les enlève
  nc-claude statusline  la ligne d'état de Claude Code aux couleurs du bureau (modèle, dossier, branche, contexte, coût) :
                        « installer » l'ajoute à settings.json seulement si tu n'en as pas déjà une, « retirer » l'enlève
                        seulement si c'est la nôtre
  nc-claude etat        les sessions suivies, en clair
  nc-claude etat --json [--texte]   les mêmes, pour JARVIS (/agents de Telegram) : contrat 1, seulement id, agent, nom du dossier,
                        état, « ecrire » ; --texte ajoute le dernier message de l'agent (sinon aucun contenu)
  nc-claude hook        appelé par Claude Code à chaque événement (lit le JSON de l'événement sur l'entrée standard)
  nc-claude installer IA | retirer IA
                        la même chose pour les autres IA : antigravity, opencode, codex, gemini, cursor, copilot, qwen,
                        kiro, amp (ou « tout » : celles qui sont installées) ; ce qu'elles font, quand elles ont fini,
                        quand elles t'attendent ; leurs demandes restent dans leur terminal
  nc-claude ia IA EVENEMENT   appelé par leurs hooks ou leur extension ; nc-claude agy EVENEMENT : par Antigravity
  nc-claude detecter | actualiser   IA présentes pas encore branchées / remettre celles branchées au format du jour
  nc-claude ecrire SESSION TEXTE   écrit à l'agent de cette session (tapé dans son terminal kitty, puis Entrée)
  nc-claude ecrire --distant SESSION TEXTE   pour JARVIS (Telegram) : refuse (sortie 3 ou 4, rien n'est envoyé) si l'agent n'est plus
                        au premier plan de son terminal ou si une autorisation attend
  nc-claude aller PID [SHELL]      va sur ce terminal (et, dans kitty, sur l'onglet de ce shell)
Notifications de Claude (terminé, t'attend) : envoyées par nc-claude à la place des siennes ; un clic sur « t'attend »
(Voir) ouvre l'île sur sa question en entier, sur « terminé » ramène sur son terminal ; elles s'en vont seules quand
tu y retournes ou qu'il repart.
  nc-claude diag        vérifie que tout est en place (Claude Code et Antigravity), avec les derniers événements reçus
Les demandes s'affichent dans l'île seulement quand tu n'es pas sur le terminal de Claude ; si tu y retournes, la
question repasse dans le terminal. Sans l'île (ou nc-reglages → Agents IA), rien ne change : Claude n'attend jamais.
État : $XDG_RUNTIME_DIR/nc-claude/etat.json (lu par l'île) ; réponses de l'île : …/nc-claude/reponses/ID.
"""
import fcntl
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
import uuid


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


DOC_EN = """nc-agents: Claude Code in the dynamic island (like the coucou app): what it is doing, step by step, when it is
done, and its requests (allow a command, answer a question) from the island.
  nc-agents install     adds the hooks to ~/.claude/settings.json (a copy of the old file is kept next to it)
  nc-agents remove      removes them
  nc-agents statusline  Claude Code's status line in the desktop colors (model, folder, branch, context, cost): “install”
                        adds it to settings.json only if you have none, “remove” removes it only if it is ours
  nc-agents state       the tracked sessions, in plain text
  nc-agents state --json [--text]   the same, for JARVIS (Telegram /agents): contract 1, only id, agent, folder name, state,
                        “ecrire”; --text adds the agent's last message (otherwise no content)
  nc-agents hook        called by Claude Code on every event (reads the event JSON on standard input)
  nc-agents install AI | remove AI
                        the same for the other AIs: antigravity, opencode, codex, gemini, cursor, copilot, qwen,
                        kiro, amp (or “all”: the installed ones); what they are doing, when they are done,
                        when they are waiting for you; their requests stay in their terminal
  nc-agents ia AI EVENT        called by their hooks or extension; nc-agents agy EVENT: by Antigravity
  nc-agents detect | refresh   AIs present but not hooked up yet / bring the hooked-up ones to the current format
  nc-agents write SESSION TEXT   writes to the agent of that session (typed into its kitty terminal, then Enter)
  nc-agents goto PID [SHELL]     goes to that terminal (and, in kitty, to that shell's tab)
Claude's notifications (done, waiting for you): sent by nc-agents instead of its own; a click on “waiting” (View)
opens the island on its whole question, on “done” brings you back to its terminal; they go away on their own when
you go back there or it starts again.
  nc-agents diag        checks that everything is in place (Claude Code and Antigravity), with the last events received
Requests show in the island only when you are not on Claude's terminal; if you go back to it, the question goes
back to the terminal. Without the island (or nc-settings → AI agents), nothing changes: Claude never waits.
State: $XDG_RUNTIME_DIR/nc-claude/etat.json (read by the island); island answers: …/nc-claude/reponses/ID.
"""

HOME = os.path.expanduser("~")
# Antigravity lance ses hooks avec un environnement réduit : dossier d'exécution et Hyprland retrouvés à la main
if not os.environ.get("XDG_RUNTIME_DIR") and os.path.isdir(f"/run/user/{os.getuid()}"):
    os.environ["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and os.environ.get("XDG_RUNTIME_DIR"):
    _hypr = sorted(glob.glob(os.environ["XDG_RUNTIME_DIR"] + "/hypr/*/.socket.sock"), key=os.path.getmtime)
    if _hypr:
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(os.path.dirname(_hypr[-1]))
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/nc-{os.getuid()}", "nc-claude")
ETAT = os.path.join(RUN, "etat.json")
VERROU = os.path.join(RUN, "etat.lock")
REPONSES = os.path.join(RUN, "reponses")
SETTINGS = os.path.join(HOME, ".claude/settings.json")
COMMANDE = "$HOME/.local/bin/nc-claude hook"
GARDER = 6 * 3600                  # une session sans nouvelles depuis 6 h disparaît de l'île


def reglage(cle, defaut):
    try:
        with open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
            for l in f:
                if l.startswith(cle + "="):
                    defaut = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


# ── État partagé (verrou : plusieurs hooks peuvent tourner en même temps) ─────────────────────────────────────────
class Etat:
    def __enter__(self):
        os.makedirs(RUN, mode=0o700, exist_ok=True)
        self.v = open(VERROU, "w")
        fcntl.flock(self.v, fcntl.LOCK_EX)
        try:
            with open(ETAT, encoding="utf-8") as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            self.d = {}
        self.d.setdefault("sessions", {})
        self.d.setdefault("demandes", {})
        return self.d

    def __exit__(self, *_):
        maintenant = time.time()
        for sid in [s for s, v in self.d["sessions"].items() if maintenant - v.get("maj", 0) > GARDER]:
            del self.d["sessions"][sid]
        tmp = ETAT + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.d, f, ensure_ascii=False)
        os.replace(tmp, ETAT)
        fcntl.flock(self.v, fcntl.LOCK_UN)
        self.v.close()


# ── Ce que fait Claude, en français ────────────────────────────────────────────────────────────────────────────────
def court(t, n=70):
    t = re.sub(r"\s+", " ", str(t or "")).strip()
    return t if len(t) <= n else t[:n - 1] + "…"


UN_FICHIER = T("un fichier", "a file")


def nom_fichier(p):
    return os.path.basename(str(p or "")) or UN_FICHIER


def etape(outil, e):
    """(icône Material Symbols, texte) pour un outil."""
    e = e or {}
    if outil == "Bash":
        # Sans description : la commande, sans le « cd dossier && » du début (peu parlant)
        cmd = re.sub(r"^\s*cd\s+\S+\s*(&&|;)\s*", "", str(e.get("command") or ""))
        return "terminal", T("Lance : ", "Runs: ") + court(e.get("description") or cmd, 60)
    if outil in ("Edit", "MultiEdit"):
        return "edit", T("Modifie ", "Edits ") + nom_fichier(e.get("file_path"))
    if outil == "Write":
        return "edit_document", T("Écrit ", "Writes ") + nom_fichier(e.get("file_path"))
    if outil == "Read":
        return "description", T("Lit ", "Reads ") + nom_fichier(e.get("file_path"))
    if outil == "NotebookEdit":
        return "edit", T("Modifie ", "Edits ") + nom_fichier(e.get("notebook_path"))
    if outil == "Grep":
        return "search", T("Cherche « " + court(e.get("pattern"), 30) + " »", "Searches “" + court(e.get("pattern"), 30) + "”")
    if outil == "Glob":
        return "search", T("Cherche des fichiers", "Looks for files")
    if outil == "WebFetch":
        return "public", T("Lit une page web", "Reads a web page")
    if outil == "WebSearch":
        return "travel_explore", T("Cherche sur le web : ", "Searches the web: ") + court(e.get("query"), 40)
    if outil in ("Task", "Agent"):
        return "smart_toy", T("Lance un agent : ", "Starts an agent: ") + court(e.get("description"), 40)
    if outil == "TodoWrite":
        return "checklist", T("Met à jour sa liste", "Updates its to-do list")
    if outil == "AskUserQuestion":
        return "help", T("Te pose une question", "Asks you a question")
    if outil.startswith("mcp__"):
        return "extension", T("Utilise ", "Uses ") + outil.split("__")[1].replace("_", " ")
    return "build", court(outil, 40)


def lignes(t):
    return len(str(t or "").splitlines()) if t else 0


def diff(outil, e):
    """(+ajouts, −retraits) d'une modification."""
    e = e or {}
    if outil == "Edit":
        return lignes(e.get("new_string")), lignes(e.get("old_string"))
    if outil == "MultiEdit":
        m = e.get("edits") or []
        return sum(lignes(x.get("new_string")) for x in m), sum(lignes(x.get("old_string")) for x in m)
    if outil == "Write":
        return lignes(e.get("content")), 0
    return 0, 0


def demande_texte(outil, e):
    e = e or {}
    if outil == "Bash":
        return T("Veut lancer une commande", "Wants to run a command"), court(e.get("command"), 160)
    if outil in ("Edit", "MultiEdit", "NotebookEdit"):
        return (T("Veut modifier un fichier", "Wants to edit a file"),
                str(e.get("file_path") or e.get("notebook_path") or "").replace(HOME, "~"))
    if outil == "Write":
        return T("Veut écrire un fichier", "Wants to write a file"), str(e.get("file_path") or "").replace(HOME, "~")
    if outil == "WebFetch":
        return T("Veut lire une page web", "Wants to read a web page"), court(e.get("url"), 160)
    if outil.startswith("mcp__"):
        return (T("Veut utiliser ", "Wants to use ") + outil.split("__")[1].replace("_", " "),
                court(json.dumps(e, ensure_ascii=False), 160))
    return T("Veut utiliser ", "Wants to use ") + outil, court(json.dumps(e, ensure_ascii=False), 160)


# ── Le terminal de la session ────────────────────────────────────────────────────────────────────────────────────
def fenetres():
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
        return json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def terminal_et_shell(fenetres_connues=None):
    """Le programme à fenêtre (kitty…) dont descend cet agent, et le processus juste en dessous (le shell de l'onglet,
    pour écrire à l'agent depuis l'île) : on remonte les parents jusqu'à une fenêtre."""
    pids = {w.get("pid") for w in (fenetres() if fenetres_connues is None else fenetres_connues)}
    p, avant = os.getppid(), 0
    for _ in range(30):
        if p in pids:
            return p, avant
        try:
            with open(f"/proc/{p}/stat") as f:
                p, avant = int(f.read().rsplit(")", 1)[1].split()[1]), p
        except (OSError, ValueError, IndexError):
            return 0, 0
        if p <= 1:
            return 0, 0
    return 0, 0


def terminal_pid():
    return terminal_et_shell()[0]


def socket_kitty(pid):
    """Socket de contrôle du kitty de cette fenêtre (listen_on dans kitty.conf), s'il existe."""
    f = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), f"kitty-{pid}")
    return f if pid and os.path.exists(f) else ""


def reperer_terminal(s):
    """Fenêtre, shell et « peut-on lui écrire depuis l'île » d'une session (une fois pour toutes)."""
    if not s.get("terminal") or not s.get("shell") or "classe" not in s:
        connues = fenetres()
        s["terminal"], s["shell"] = terminal_et_shell(connues)
        s["classe"] = next((w.get("class", "") for w in connues if w.get("pid") == s["terminal"]), "")
    s["ecrire"] = bool(s.get("shell") and socket_kitty(s.get("terminal"))) or (s.get("agent") == "opencode" and bool(shutil.which("opencode")))


def terminal_actif(pid):
    if not pid:
        return False
    try:
        r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2)
        return json.loads(r.stdout or "{}").get("pid") == pid
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def ile_active():
    # sans systemctl (conteneur, système sans systemd) : pas d'île, et surtout pas d'erreur dans un hook ou dans diag
    try:
        return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "nc-ile.service"]).returncode == 0
    except OSError:
        return False


# ── Les événements ───────────────────────────────────────────────────────────────────────────────────────────────
def cle_session(ev, ia="claude"):
    sid = ev.get("session_id") or "?"
    return sid if ia == "claude" else f"{ia}-{sid}"


def session(d, ev, ia="claude"):
    sid = cle_session(ev, ia)
    s = d["sessions"].setdefault(sid, {"id": sid, "etat": "pret", "etapes": [], "ajouts": 0, "retraits": 0,
                                       "debut": time.time()})
    if ia != "claude":
        s["agent"] = ia
    cwd = ev.get("cwd") or s.get("cwd") or ""
    s["cwd"] = cwd.replace(HOME, "~")
    s["cwd_reel"] = os.path.realpath(cwd) if cwd else s.get("cwd_reel", "")
    s["projet"] = ev.get("session_title") or os.path.basename(cwd.rstrip("/")) or NOMS.get(ia, "Claude")
    s["maj"] = time.time()
    reperer_terminal(s)
    return s


# La question en attente d'une session (t'attend dans son terminal) : son texte entier, montré dans l'île (page de
# l'agent) quand on clique sur la notification ou sur la pilule. La notification, elle, n'en garde qu'un extrait.
QUESTION_MAX = 4000
ATTEND = ("demande", "terminal", "attente")


def poser_question(s, titre, texte):
    texte = str(texte or "").strip()
    if texte:
        s["question"] = {"titre": titre, "texte": texte[:QUESTION_MAX], "t": time.time()}


def oublier_question(s):
    """Plus de question une fois que l'agent est reparti (ou a fini)."""
    if s.get("etat") not in ATTEND:
        s.pop("question", None)


def alerte_telegram(s, avant):
    """L'agent vient de passer à « t'attend » : une alerte Telegram si tu l'as voulue (ALERTES_AGENTS et ALERTES_TELEGRAM, non par
    défaut). Poussée par ce hook, rien ne tourne en boucle : nc-alertes agent (en arrière-plan, le hook rend la main tout de
    suite) limite à une alerte par session toutes les 5 minutes. Seulement l'agent et le NOM du dossier : jamais de texte de
    la conversation. Déjà en attente avant (autorisation puis question…) : rien de plus."""
    try:
        if avant in ATTEND or reglage("ALERTES_AGENTS", "non") != "oui" or reglage("ALERTES_TELEGRAM", "non") != "oui":
            return
        alertes = os.path.join(os.path.dirname(os.path.realpath(__file__)), "nc-alertes")
        if not os.access(alertes, os.X_OK):
            return
        agent = s.get("agent") or "claude"
        subprocess.Popen([alertes, "agent", "Claude Code" if agent == "claude" else NOMS.get(agent, agent), dossier_court(s),
                          str(s.get("id") or "?")], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass                                   # une alerte manquée ne gêne jamais l'agent


def ajouter_etape(s, icone, texte):
    s["icone"], s["etape"] = icone, texte
    l = s.setdefault("etapes", [])
    l.append({"icone": icone, "texte": texte, "t": time.time()})
    del l[:-6]


def repondre(sortie):
    print(json.dumps(sortie, ensure_ascii=False))


def attendre(ident, pid, delai=590):
    """Réponse de l'île (oui, toujours, non, terminal, ou le choix d'une question), ou None si tu retournes sur le
    terminal de Claude (la question y repasse) ou si personne ne répond."""
    os.makedirs(REPONSES, mode=0o700, exist_ok=True)
    f = os.path.join(REPONSES, ident)
    fin = time.time() + delai
    n = 0
    while time.time() < fin:
        if os.path.exists(f):
            try:
                with open(f, encoding="utf-8") as x:
                    return x.read().strip()
            finally:
                os.remove(f)
        n += 1
        if n % 3 == 0 and terminal_actif(pid):
            return None
        time.sleep(0.25)
    return None


def demande(ev, genre, ia="claude"):
    """Demande d'autorisation (PermissionRequest) ou question (AskUserQuestion) : dans l'île si tu n'es pas sur le
    terminal de l'IA. Rien sur la sortie standard = la question s'affiche dans le terminal, comme d'habitude.
    Claude, et les IA qui répondent de la même façon (Codex, Qwen Code)."""
    if reglage(ia.upper() + "_ILE", "oui") == "non":
        return
    if reglage("CLAUDE_DEMANDES", "ile") != "ile" or not ile_active():
        if ia != "claude":
            titre, detail = demande_texte(ev.get("tool_name") or "", ev.get("tool_input") or {})
            suivre(ia, ev.get("session_id"), ev.get("cwd"), "attente", message=titre + ("\n" + detail if detail else ""))
        return
    outil, e = ev.get("tool_name") or "", ev.get("tool_input") or {}
    if genre == "question":
        qs = e.get("questions") or []
        # L'île sait répondre à une seule question à choix unique ; sinon, le terminal
        if len(qs) != 1 or qs[0].get("multiSelect") or not qs[0].get("options"):
            return
    ident = uuid.uuid4().hex[:12]
    with Etat() as d:
        s = session(d, ev, ia)
        pid = s.get("terminal") or 0
        if terminal_actif(pid):
            if ia != "claude":
                s["etat"] = "terminal"
            return
        alerte_telegram(s, s.get("etat"))
        s["etat"] = "demande"
        if genre == "question":
            q = e["questions"][0]
            d["demandes"][ident] = {"id": ident, "session": s["id"], "projet": s["projet"], "terminal": pid,
                                    "genre": "question", "titre": court(q.get("question"), 140),
                                    "options": [court(o.get("label"), 40) for o in q.get("options", [])][:4], "agent": ia,
                                    "t": time.time()}
        else:
            titre, detail = demande_texte(outil, e)
            d["demandes"][ident] = {"id": ident, "session": s["id"], "projet": s["projet"], "terminal": pid,
                                    "genre": "permission", "titre": titre, "detail": detail, "agent": ia,
                                    "toujours": ia == "claude" and bool(ev.get("permission_suggestions")), "t": time.time()}
    try:
        r = attendre(ident, pid)
    finally:
        with Etat() as d:
            d["demandes"].pop(ident, None)
            s = d["sessions"].get(cle_session(ev, ia))
            if s and s.get("etat") == "demande" and not any(x["session"] == s["id"] for x in d["demandes"].values()):
                # Pas de réponse dans l'île : la question passe dans le terminal, et reste visible dans l'île (pilule,
                # page de l'agent) jusqu'à ce que l'agent reparte
                if not r or r == "terminal":
                    s["etat"] = "terminal"
                    if genre == "question":
                        q = e["questions"][0]
                        poser_question(s, T("Te pose une question", "Asks you a question"),
                                       "\n".join([str(q.get("question") or "")]
                                                 + ["• " + str(o.get("label") or "") for o in q.get("options", [])]))
                    else:
                        titre, detail = demande_texte(outil, e)
                        poser_question(s, titre, titre + ("\n" + detail if detail else ""))
                else:
                    s["etat"] = "travail"
    if not r or r == "terminal":
        return
    if genre == "question":
        q = e["questions"][0]
        if r.startswith("choix:"):
            repondre({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow",
                                             "updatedInput": {"questions": e["questions"],
                                                              "answers": {q.get("question"): r[6:]}}}})
        return
    if r in ("oui", "toujours"):
        decision = {"behavior": "allow"}
        if r == "toujours" and ia == "claude" and ev.get("permission_suggestions"):
            decision["updatedPermissions"] = ev["permission_suggestions"]
        repondre({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}})
    elif r == "non":
        repondre({"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                         "decision": {"behavior": "deny",
                                                      "message": T("Refusé depuis l'île dynamique",
                                                                   "Denied from the dynamic island")}}})


def hook():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    if ev.get("cursor_version") or os.environ.get("CURSOR_VERSION"):
        return                                         # Cursor relit les hooks de Claude : il a les siens (nc-claude ia cursor)
    nom = ev.get("hook_event_name") or ""
    if ev.get("agent_id") and nom not in ("PermissionRequest", "PreToolUse"):
        return                                         # sous-agents : seule la session principale est suivie
    # Coupé dans nc-reglages : rien dans l'île (elle cache ces sessions), mais le suivi continue pour les notifications
    if reglage("CLAUDE_ILE", "oui") == "non" and (nom == "PermissionRequest" or os.environ.get("NC_CLAUDE_SYNC")):
        return
    if nom == "PermissionRequest":
        return demande(ev, "permission")
    if nom == "PreToolUse" and ev.get("tool_name") == "AskUserQuestion" and os.environ.get("NC_CLAUDE_SYNC"):
        return demande(ev, "question")
    with Etat() as d:
        if nom == "SessionEnd":
            d["sessions"].pop(ev.get("session_id") or "?", None)
            return
        s = session(d, ev)
        avant = s.get("etat")
        if nom == "SessionStart":
            s["etat"] = "pret"
        elif nom == "UserPromptSubmit":
            s.update(etat="travail", etapes=[], ajouts=0, retraits=0, depart=time.time(), message="")
            ajouter_etape(s, "neurology", T("Réfléchit…", "Thinking…"))
        elif nom == "PreToolUse" and not ev.get("agent_id"):
            if s.get("etat") not in ("demande",):
                s["etat"] = "travail"
            ajouter_etape(s, *etape(ev.get("tool_name") or "", ev.get("tool_input")))
        elif nom == "PostToolUse":
            a, r = diff(ev.get("tool_name") or "", ev.get("tool_input"))
            if a or r:
                s["ajouts"] = s.get("ajouts", 0) + a
                s["retraits"] = s.get("retraits", 0) + r
                if s.get("etapes"):
                    s["etapes"][-1]["diff"] = f"+{a} −{r}"
            # (pas « terminal » : avec des outils en parallèle, un autre peut finir pendant que la question attend)
            if s.get("etat") == "demande" and not d["demandes"]:
                s["etat"] = "travail"
        elif nom == "Notification":
            t = ev.get("notification_type") or ""
            message = ev.get("message") or ""
            # Toutes ces notifications portent « Voir » : l'île s'ouvre sur la question (texte entier), à défaut le terminal
            if t == "idle_prompt":
                s["etat"] = "attente"
                # Sa dernière réponse en entier (souvent une question posée en clair), sinon le message de Claude
                poser_question(s, T("À toi de répondre", "Your turn to answer"), s.get("reponse") or message)
                alerte_telegram(s, avant)
                if not notif_ouverte(d, s["id"]):
                    notifier(s, T("Claude t'attend", "Claude is waiting for you"),
                             s["projet"] + T(" : à toi de répondre", ": your turn to answer"), voir=True)
            elif t == "permission_prompt" and not any(x["session"] == s["id"] for x in d["demandes"].values()):
                s["etat"] = "terminal"         # Claude attend une réponse dans le terminal
                titre = T("Claude demande ton accord", "Claude needs your approval")
                poser_question(s, titre, message)
                alerte_telegram(s, avant)
                notifier(s, titre, s["projet"] + T(" : ", ": ") + court(message, 120), voir=True)
            elif t in ("agent_needs_input", "elicitation_dialog"):
                s["etat"] = "terminal"         # une question dans le terminal : la pilule la garde en vue
                titre = T("Claude t'attend", "Claude is waiting for you")
                poser_question(s, titre, message)
                alerte_telegram(s, avant)
                notifier(s, titre, s["projet"] + T(" : ", ": ") + court(message, 120), voir=True)
        elif nom == "Stop":
            s["etat"] = "fini"
            s["fin"] = time.time()
            s["message"] = court(ev.get("last_assistant_message"), 160)
            s["reponse"] = str(ev.get("last_assistant_message") or "").strip()[:QUESTION_MAX]
            notifier(s, T("Claude a terminé", "Claude is done"), s["projet"] + (T(" : ", ": ") + s["message"] if s["message"] else ""))
        oublier_question(s)


# ── pid_notre : même texte dans nc-dictee, nc-panne et nc-claude (tests/test_pid.py vérifie qu'il est identique) ──────────
def debut_pid(pid):
    """Heure de démarrage du processus (champ 22 de /proc/PID/stat), ou None sans /proc."""
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            return f.read().rpartition(")")[2].split()[19]
    except (OSError, IndexError, TypeError, ValueError):
        return None


def pid_notre(pid, debut=None, nom=None):
    """Ce pid est-il vivant, pas un zombie (fini mais non recueilli : kill -0 réussit quand même), et bien le nôtre ?
    debut : l'heure de démarrage notée avec le pid dans un fichier (un autre processus au même pid, après un
    redémarrage de session, en a une autre). nom (ou un tuple de noms) : pour un ancien fichier sans heure, doit
    se trouver dans /proc/PID/cmdline. Sans /proc : kill -0 seul."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except PermissionError:
        pass
    except (OSError, ValueError, OverflowError):
        return False
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            champs = f.read().rpartition(")")[2].split()
    except OSError:
        return not os.path.isdir("/proc/self") or os.path.exists("/proc/%d" % pid)
    if not champs or champs[0] == "Z":
        return False
    if debut:
        return len(champs) > 19 and champs[19] == str(debut)
    if nom:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                ligne = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
        except OSError:
            return False
        return any(n in ligne for n in ((nom,) if isinstance(nom, str) else nom))
    return True
# ── fin de pid_notre ──────────────────────────────────────────────────────────────────────────────────────────────────


# ── Notifications : les nôtres à la place de celles de Claude ─────────────────────────────────────────────────────────
# Claude envoie les siennes par son terminal (kitty) : elles restaient dans la liste, et un clic ramenait sur une autre
# fenêtre que la sienne. « nc-claude installer » les coupe (preferredNotifChannel) ; celles-ci ramènent sur le bon
# terminal (et le bon onglet de kitty) et s'en vont seules dès que tu y retournes, que Claude repart ou se ferme.
def notif_ouverte(d, sid):
    """Le processus de la notification tourne-t-il encore ? Noté « pid:démarrage » (un autre processus au même pid,
    après un redémarrage de session, n'est pas elle) ; ancienne note, pid seul : le nom nc-claude doit être dans
    sa ligne de commande. pid_notre refuse -1 (os.kill(-1, 0) viserait tous nos processus)."""
    try:
        pid, _, debut = str(d.get("notifs", {}).get(sid) or 0).partition(":")
        return pid_notre(int(pid), debut or None, "nc-claude")
    except ValueError:
        return False


def notifier(s, titre, texte, voir=False):
    """Lance la notification de cette session en arrière-plan (le hook, lui, rend la main tout de suite) ; rien si tu
    es déjà sur son terminal. voir : l'agent t'attend, le clic ouvre l'île sur sa question (sinon : son terminal)."""
    if not shutil.which("notify-send") or terminal_actif(s.get("terminal")):
        return
    subprocess.Popen([os.path.abspath(sys.argv[0]), "notification", s["id"], titre, texte] + (["voir"] if voir else []),
                     start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def montrer_dans_ile(sid):
    """L'île ouverte sur la question de cette session (sa demande avec ses choix, sinon sa page) ; faux si l'île
    ne répond pas."""
    if not shutil.which("qs") or not ile_active():
        return False
    try:
        r = subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "agent", sid], capture_output=True, text=True,
                           timeout=5)
        return r.returncode == 0 and r.stdout.strip() == "oui"     # « non » : page des agents coupée
    except (OSError, subprocess.TimeoutExpired):
        return False


def notification(sid, titre, texte, voir=False):
    moi = "%d:%s" % (os.getpid(), debut_pid(os.getpid()) or "")
    with Etat() as d:
        s = d["sessions"].get(sid)
        if not s:
            return
        d.setdefault("notifs", {})[sid] = moi          # une seule par session : la précédente se ferme d'elle-même
        term, shell = s.get("terminal") or 0, s.get("shell") or 0
        icone = (s.get("classe") or "utilities-terminal").lower()
        agent = s.get("agent") or "claude"
    appli = "Claude Code" if agent == "claude" else NOMS.get(agent, agent)
    action = "default=" + (T("Voir", "View") if voir else T("Ouvrir", "Open"))
    p = subprocess.Popen(["notify-send", "-a", appli, "-i", icone, "-p", "-A", action, titre, texte],
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    nid = p.stdout.readline().strip()
    debut = time.time()
    while p.poll() is None:
        time.sleep(1)
        try:
            with open(ETAT, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        s = d.get("sessions", {}).get(sid)
        if (not s or d.get("notifs", {}).get(sid) != moi or terminal_actif(term) or time.time() - debut > 4 * 3600
                or (s.get("etat") in ("travail", "demande") and s.get("maj", 0) > debut)):
            if nid.isdigit():
                subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                                "--object-path", "/org/freedesktop/Notifications",
                                "--method", "org.freedesktop.Notifications.CloseNotification", nid],
                               capture_output=True, timeout=5)
            p.terminate()
            break
    else:
        if p.stdout.read().strip() == "default":     # clic sur la notification (son corps ou « Voir »)
            if not (voir and montrer_dans_ile(sid)):
                aller(term, shell)
    with Etat() as d:
        if d.get("notifs", {}).get(sid) == moi:
            del d["notifs"][sid]


def aller(term, shell=0):
    """Va sur le terminal d'une session : sa fenêtre (ramenée si elle est réduite) et, dans kitty, son onglet."""
    term, shell = int(term or 0), int(shell or 0)
    sock = socket_kitty(term)
    if sock and shell:
        subprocess.run(["kitty", "@", "--to", "unix:" + sock, "focus-window", "--match", f"pid:{shell}"],
                       capture_output=True, timeout=5)
    a = next((w.get("address") for w in fenetres() if w.get("pid") == term), "")
    fenetre = os.path.join(HOME, ".local/bin/nc-fenetre")
    if a and os.access(fenetre, os.X_OK):
        subprocess.run([fenetre, "aller", a], capture_output=True, timeout=5)
    elif term:
        subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ window = 'pid:{term}' }})"], capture_output=True, timeout=5)


# ── Les autres IA (Antigravity, opencode…) : même suivi, quelle que soit l'IA ────────────────────────────────────────
# Chaque IA appelle « nc-claude <ia> ÉVÉNEMENT » à sa façon (hooks, plugin) ; suivre() met sa session à jour comme
# celles de Claude, avec agent: "<ia>" pour son logo et sa couleur dans l'île. Leurs demandes d'autorisation restent
# dans leur terminal (l'île montre « t'attend » quand l'IA le signale).
JOURNAL = os.path.join(RUN, "agents.log")
NOMS = {"claude": "Claude", "antigravity": "Antigravity"}
NOMS["assistant"] = "JARVIS"
CMD = ("bash", "run_command", "run_shell_command", "shell", "exec_command", "local_shell", "terminal", "run_terminal_cmd")
MODIF = ("edit", "multiedit", "replace", "replace_file_content", "multi_replace_file_content", "apply_patch", "patch",
         "str_replace", "str_replace_editor", "edit_file", "search_replace")
ECRIT = ("write", "write_file", "write_to_file", "create_file", "create")
LIT = ("read", "read_file", "read_many_files", "view", "view_file", "view_file_outline", "view_code_item", "cat")
GREP = ("grep", "grep_search", "search_file_content", "rg", "codebase_search")
TROUVE = ("glob", "find_by_name", "find", "file_search")
LISTE = ("list", "ls", "list_dir", "list_directory")
PAGE = ("webfetch", "web_fetch", "read_url_content", "fetch")
WEB = ("websearch", "web_search", "google_web_search", "search_web")
AGENT = ("task", "agent", "invoke_subagent", "subagent")
TODO = ("todowrite", "todo_write", "write_todos", "update_plan", "todoread")


def arg(e, *cles):
    e = e if isinstance(e, dict) else {}
    bas = {k.lower(): v for k, v in e.items()}
    for c in cles:
        if bas.get(c.lower()):
            return bas[c.lower()]
    return ""


def etape_generique(outil, e):
    """(icône, texte) pour un outil de n'importe quelle IA (noms de Claude, Antigravity, opencode, Codex, Gemini…)."""
    o = str(outil or "").lower()
    f = nom_fichier(arg(e, "file_path", "filePath", "TargetFile", "AbsolutePath", "absolute_path", "path", "file"))
    if o in CMD:
        c = arg(e, "command", "CommandLine", "cmd")
        c = " ".join(map(str, c)) if isinstance(c, list) else str(c)
        c = re.sub(r"^(bash|sh|zsh) -l?c ", "", c)
        return "terminal", T("Lance : ", "Runs: ") + court(re.sub(r"^\s*cd\s+\S+\s*(&&|;)\s*", "", c), 60)
    if o in MODIF:
        m = re.search(r"\*\*\* (?:Update|Add) File: (\S+)", str(arg(e, "command", "patch", "input")))   # apply_patch (Codex)
        f = nom_fichier(m.group(1)) if m and f == UN_FICHIER else f
        return "edit", T("Modifie ", "Edits ") + f if f != UN_FICHIER else T("Modifie des fichiers", "Edits files")
    if o == "delete":
        return "delete", T("Supprime ", "Deletes ") + f
    if o in ECRIT:
        return "edit_document", T("Écrit ", "Writes ") + f
    if o in LIT:
        return "description", T("Lit ", "Reads ") + f
    if o in GREP:
        motif = court(arg(e, "pattern", "query", "Query", "Pattern"), 30)
        return "search", T("Cherche « " + motif + " »", "Searches “" + motif + "”")
    if o in TROUVE:
        return "search", T("Cherche des fichiers", "Looks for files")
    if o in LISTE:
        return "folder_open", T("Parcourt ", "Browses ") + nom_fichier(arg(e, "DirectoryPath", "dir_path", "path"))
    if o in PAGE:
        return "public", T("Lit une page web", "Reads a web page")
    if o in WEB:
        return "travel_explore", T("Cherche sur le web : ", "Searches the web: ") + court(arg(e, "query", "Query"), 40)
    if o in AGENT:
        return "smart_toy", (T("Lance un agent", "Starts an agent")
                             + (T(" : ", ": ") + court(arg(e, "description"), 40) if arg(e, "description") else ""))
    if o in TODO:
        return "checklist", T("Met à jour sa liste", "Updates its to-do list")
    if o.startswith("browser_"):
        return "public", T("Utilise le navigateur", "Uses the browser")
    if o.startswith("mcp__") or "__" in o:
        return "extension", T("Utilise ", "Uses ") + o.split("__")[1 if o.startswith("mcp__") else 0].replace("_", " ")
    return "build", court(str(outil).replace("_", " "), 40)


def diff_generique(e):
    """(+ajouts, −retraits) d'une modification, où que soit le texte dans les arguments (ou un patch unifié)."""
    t = {"plus": 0, "moins": 0}

    def visite(x):
        if isinstance(x, dict):
            for k, v in x.items():
                if isinstance(v, str):
                    k = k.lower()
                    if k in ("new_string", "newstring", "replacementcontent", "codecontent", "content", "new_str"):
                        t["plus"] += lignes(v)
                    elif k in ("old_string", "oldstring", "targetcontent", "old_str"):
                        t["moins"] += lignes(v)
                    elif k in ("patch", "input", "patchtext", "command") and ("\n+" in v or "\n-" in v):
                        for l in v.splitlines():
                            if l.startswith("+") and not l.startswith("+++"):
                                t["plus"] += 1
                            elif l.startswith("-") and not l.startswith("---"):
                                t["moins"] += 1
                else:
                    visite(v)
        elif isinstance(x, list):
            for v in x:
                visite(v)
    visite(e)
    return t["plus"], t["moins"]


def journal(agent, nom, detail=""):
    """Les 60 derniers événements reçus des IA (pour nc-claude diag)."""
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    try:
        with open(JOURNAL, encoding="utf-8") as f:
            l = f.read().splitlines()[-59:]
    except OSError:
        l = []
    l.append(f"{time.strftime('%H:%M:%S')} {agent} {nom} {detail}".strip())
    with open(JOURNAL, "w", encoding="utf-8") as f:
        f.write("\n".join(l) + "\n")


def suivre(agent, sid, cwd, quoi, outil="", args=None, erreur=False, message="", terminal_cwd=None, terminal=True):
    """Met à jour la session d'une IA. quoi : debut (nouvelle demande), etape (un outil), attente (t'attend dans son
    terminal), fini (a fini sa réponse), fin (session fermée)."""
    sid = f"{agent}-{sid or '?'}"
    cwd = str(cwd or "")
    if cwd.startswith("file://"):
        cwd = urllib.parse.unquote(cwd[7:])
    # Avant le verrou : savoir si Codex notifie peut lancer « codex --version »
    notre_voir = quoi == "attente" and agent in IAS and not notif_propre(agent)
    with Etat() as d:
        if quoi == "fin":
            d["sessions"].pop(sid, None)
            return
        s = d["sessions"].setdefault(sid, {"id": sid, "etat": "pret", "etapes": [], "ajouts": 0, "retraits": 0,
                                           "debut": time.time()})
        avant = s.get("etat")
        s["agent"] = agent
        if cwd:
            s["cwd"] = cwd.replace(HOME, "~")
            s["cwd_reel"] = os.path.realpath(cwd)
        s["projet"] = os.path.basename(cwd.rstrip("/")) or s.get("projet") or NOMS.get(agent, agent)
        s["maj"] = time.time()
        if not terminal:
            s.update(terminal=0, shell=0, classe="", ecrire=False)
        elif terminal_cwd is not None and (not cwd or os.path.realpath(cwd) != os.path.realpath(terminal_cwd)):
            # Un serveur OpenCode peut suivre une session ouverte par un autre client : son terminal n'est pas celui-là.
            s.update(terminal=0, shell=0, classe="", ecrire=agent == "opencode" and bool(shutil.which("opencode")))
        else:
            reperer_terminal(s)
        if quoi == "debut" or (quoi == "etape" and s.get("etat") in ("pret", "fini", "attente")):
            s.update(etat="travail", etapes=[], ajouts=0, retraits=0, depart=time.time(), message="")
            ajouter_etape(s, "neurology", T("Réfléchit…", "Thinking…"))
        if quoi == "etape" and outil:
            s["etat"] = "travail"
            ajouter_etape(s, *etape_generique(outil, args))
            if not erreur and str(outil).lower() in MODIF + ECRIT:
                a, r = diff_generique(args)
                if a or r:
                    s["ajouts"] = s.get("ajouts", 0) + a
                    s["retraits"] = s.get("retraits", 0) + r
                    s["etapes"][-1]["diff"] = f"+{a} −{r}"
        elif quoi == "attente":
            s["etat"] = "terminal"
            poser_question(s, T("T'attend dans le terminal", "Waiting in the terminal"), message)
            alerte_telegram(s, avant)
            # Sans notification à elle (OpenCode…), notre « Voir » la remplace ; les autres ont déjà la leur (doublon)
            if notre_voir:
                notifier(s, T(f"{NOMS.get(agent, agent)} t'attend", f"{NOMS.get(agent, agent)} is waiting for you"),
                         s["projet"] + T(" : ", ": ") + (court(message, 120) if message
                                                          else T("à toi de répondre", "your turn to answer")), voir=True)
        elif quoi == "fini" and s.get("etat") in ("travail", "terminal"):
            s["etat"] = "fini"
            s["fin"] = time.time()
            if message:
                s["message"] = court(message, 160)
        oublier_question(s)


def hook_assistant(evenement):
    """Client distant : écrit via le même verrou que les hooks, jamais directement dans etat.json."""
    ev = lire_entree()
    sid = ev.get("session_id", "")
    if not re.fullmatch(r"[a-f0-9]{32}", str(sid)) or evenement not in ("debut", "fini", "fin"):
        raise ValueError("Événement assistant invalide")
    if reglage("ASSISTANT_ILE", "oui") == "non" and evenement != "fin":
        return
    # Une commande ponctuelle ne doit pas proposer d'envoyer du texte au shell après sa sortie.
    suivre("assistant", sid, "", evenement, message=ev.get("message") or "", terminal=ev.get("chat") is True)


def lire_entree():
    try:
        ev = json.load(sys.stdin)
        return ev if isinstance(ev, dict) else {}
    except ValueError:
        return {}


# ── Antigravity (Google : appli, éditeur, agy) ─────────────────────────────────────────────────────────────────────
# Ses hooks (https://antigravity.google/docs/hooks) ne donnent ni le nom de l'événement (passé en argument), ni de
# demande d'autorisation. Seulement des événements qui ne décident de rien (PostToolUse plutôt que PreToolUse : un
# PreToolUse qui échoue bloquerait l'outil). Coupés par agy en mode sans autorisations (--dangerously-skip-permissions).
AGY_HOOKS = os.path.join(HOME, ".gemini/config/hooks.json")
AGY_GROUPE = "nc-ile"
AGY_EVENEMENTS = ("PreInvocation", "PostToolUse", "Stop")     # les 5 événements du CLI 1.1 : pas de SessionStart


def hook_agy(nom):
    print("{}")                                        # ne décide de rien
    sys.stdout.flush()
    ev = lire_entree()
    tc = ev.get("toolCall") or {}
    journal("antigravity", nom, (tc.get("name") or "") + " " + str(ev.get("conversationId", ""))[:8])
    if reglage("ANTIGRAVITY_ILE", "oui") == "non" or nom not in AGY_EVENEMENTS or not ev:
        return
    sid, ws = ev.get("conversationId"), (ev.get("workspacePaths") or [""])[0]
    if nom == "PreInvocation":
        with Etat() as d:
            en_cours = d["sessions"].get(f"antigravity-{sid}", {}).get("etat") == "travail"
        if not en_cours:
            suivre("antigravity", sid, ws, "debut")
    elif nom == "PostToolUse" and tc.get("name"):
        suivre("antigravity", sid, ws, "etape", tc["name"], tc.get("args"), bool(ev.get("error")))
    elif nom == "Stop" and ev.get("fullyIdle", True):
        suivre("antigravity", sid, ws, "fini")


def lire_json(chemin):
    try:
        with open(chemin, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError:
        sys.exit(T(f"nc-claude : {chemin} n'est pas un JSON valide : rien n'a été changé.",
                   f"nc-agents: {chemin} is not valid JSON: nothing was changed."))


def ecrire_json(chemin, cfg):
    os.makedirs(os.path.dirname(chemin), exist_ok=True)
    if os.path.exists(chemin):
        copie = chemin + ".avant-nc-claude"
        if not os.path.exists(copie):
            shutil.copy2(chemin, copie)
    tmp = chemin + ".nc-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, chemin)


# ── Toutes les IA : où chacune se branche, comment l'installer et la retirer ─────────────────────────────────────────
# Chaque IA appelle « nc-claude ia <ia> <événement> » (JSON de l'événement sur l'entrée standard) : par ses hooks
# (Codex, Gemini CLI, Cursor, Copilot CLI, Qwen Code, Kiro) ou par une petite extension (opencode, Amp). Antigravity a
# son propre format (hook_agy). Réglages : <IA>_ILE=oui/non (nc-reglages → Agents IA).
PY = shlex.quote(sys.executable)
NC = shlex.quote(os.path.realpath(__file__))
IAS = {
    # clé : nom affiché, programmes, dossiers qui trahissent sa présence
    "antigravity": ("Antigravity", ("agy", "antigravity"), ("~/.gemini/antigravity-cli", "~/.gemini/config")),
    "opencode": ("OpenCode", ("opencode",), ("~/.config/opencode",)),
    "codex": ("Codex", ("codex",), ("~/.codex",)),
    "gemini": ("Gemini CLI", ("gemini",), ()),
    "cursor": ("Cursor", ("cursor-agent", "cursor"), ("~/.cursor",)),
    "copilot": ("Copilot", ("copilot",), ("~/.copilot",)),
    "qwen": ("Qwen Code", ("qwen",), ("~/.qwen",)),
    "kiro": ("Kiro", ("kiro-cli", "kiro"), ("~/.kiro",)),
    "amp": ("Amp", ("amp",), ("~/.config/amp",)),
}
NOMS.update({k: v[0] for k, v in IAS.items()})
FICHIERS = {
    "antigravity": "~/.gemini/config/hooks.json", "opencode": "~/.config/opencode/plugins/nc-ile.js",
    "codex": "~/.codex/hooks.json", "gemini": "~/.gemini/settings.json", "cursor": "~/.cursor/hooks.json",
    "copilot": "~/.copilot/hooks/nc-ile.json", "qwen": "~/.qwen/settings.json", "kiro": "~/.kiro/hooks/nc-ile.json",
    "amp": "~/.config/amp/plugins/nc-ile.js",
}
# Événements écoutés, par IA (rien qui décide : seulement observer ; PostToolUse là où un hook avant l'outil pourrait
# le bloquer en cas d'erreur)
EVENEMENTS = {
    "codex": ("SessionStart", "UserPromptSubmit", "PreToolUse", "PermissionRequest", "Stop", "Interrupt", "SessionEnd"),
    "gemini": ("BeforeAgent", "AfterTool", "AfterAgent", "Notification", "SessionEnd"),
    "qwen": ("UserPromptSubmit", "PostToolUse", "PermissionRequest", "Notification", "Stop"),
    "cursor": ("beforeSubmitPrompt", "postToolUse", "stop", "sessionEnd"),
    "copilot": ("userPromptSubmitted", "postToolUse", "agentStop", "notification", "sessionEnd"),
    "kiro": ("UserPromptSubmit", "PostToolUse", "Stop"),
}
DEMANDES_ILE = ("codex", "qwen")     # IA qui acceptent « autoriser / refuser » par leur hook, comme Claude
# IA qui préviennent déjà elles-mêmes quand elles t'attendent (notification de bureau ou du terminal) : pas de seconde
# notification « Voir » de notre part. Les autres IA suivies par l'île qui signalent une attente (OpenCode : son
# extension transmet permission.asked, question.asked, form.created) reçoivent la nôtre. Antigravity, Cursor, Kiro et
# Amp ne signalent aucune attente à leurs hooks : rien à notifier. Codex : seulement si tui.notifications est actif
# (codex_notifie), sinon il reçoit notre « Voir ».
NOTIF_PROPRE = ("gemini", "qwen", "copilot")
# tui.notifications de Codex : actif par défaut depuis Codex 0.59.0 (Notifications::Enabled(true) dans
# codex-rs/core/src/config/types.rs, aujourd'hui codex-rs/config/src/types.rs), coupé jusqu'à 0.58.0 (« Defaults to
# false » dans docs/config.md)
CODEX_NOTIF_DEPUIS = (0, 59, 0)


def version_codex():
    """(majeure, mineure, correctif) de « codex --version » (codex-cli 0.163.0), None si inconnue."""
    try:
        r = subprocess.run(["codex", "--version"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", r.stdout or "")
    return tuple(int(x) for x in m.groups()) if m else None


def codex_notifie():
    """Codex prévient-il lui-même quand il demande ton accord ? tui.notifications de sa config ($CODEX_HOME ou
    ~/.codex/config.toml, lue, jamais écrite) : vrai ou faux, ou une liste qui doit contenir « approval-requested » ;
    absent : le défaut de la version installée (inconnue : on suppose que oui, pas de doublon)."""
    v = None
    try:
        import tomllib
        with open(os.path.join(os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex"), "config.toml"), "rb") as f:
            tui = tomllib.load(f).get("tui")
        v = tui.get("notifications") if isinstance(tui, dict) else None
    except (OSError, ValueError, ImportError):                 # absente, illisible, Python < 3.11
        pass
    if isinstance(v, bool):
        return v
    if isinstance(v, list):
        return "approval-requested" in v
    version = version_codex()
    return version is None or version >= CODEX_NOTIF_DEPUIS


def notif_propre(agent):
    """L'IA t'avertit-elle déjà elle-même quand elle t'attend (pas de « Voir » de notre part) ?"""
    return agent in NOTIF_PROPRE or (agent == "codex" and codex_notifie())


DEBUT = ("userpromptsubmit", "beforeagent", "userpromptsubmitted", "beforesubmitprompt", "prompt")
ETAPE = ("pretooluse", "posttooluse", "aftertool", "tool")
ATTENTE = ("permissionrequest", "permission")
FINI = ("stop", "afteragent", "agentstop", "interrupt")


def chemin(ia):
    return os.path.expanduser(FICHIERS[ia])


def commande(ia, ev):
    return f"{PY} {NC} ia {ia} {ev}"


def present(ia):
    nom, progs, dossiers = IAS[ia]
    return any(shutil.which(p) for p in progs) or any(os.path.isdir(os.path.expanduser(d)) for d in dossiers)


def installe(ia):
    try:
        with open(chemin(ia), encoding="utf-8") as f:
            t = f.read()
    except OSError:
        return False
    return "nc-claude" in t and (ia == "antigravity" or f" ia {ia} " in t or "nc-ile" in t)


def nettoyer(cfg, marque):
    """Retire de cfg["hooks"] nos hooks (ceux dont la commande contient marque), et les groupes ou événements vidés."""
    hooks = cfg.get("hooks")
    if isinstance(hooks, dict):
        for ev in list(hooks):
            if not isinstance(hooks[ev], list):
                continue
            l = []
            for g in hooks[ev]:
                if isinstance(g, dict) and isinstance(g.get("hooks"), list):
                    g = dict(g, hooks=[h for h in g["hooks"] if marque not in json.dumps(h)])
                    if g["hooks"]:
                        l.append(g)
                elif marque not in json.dumps(g):
                    l.append(g)
            if l:
                hooks[ev] = l
            else:
                del hooks[ev]
    return cfg


PLUGIN_OPENCODE = r'''// nc-ile : OpenCode dans l'île dynamique de noctalia-config (écrit par « nc-claude installer opencode » ;
// « nc-claude retirer opencode » l'enlève). OpenCode 1 appelle server(), OpenCode 2 appelle setup().
import { spawn } from "node:child_process"
const envoyer = (ev, o) => {
  try {
    const p = spawn(@PY@, [@NC@, "ia", "opencode", ev], { stdio: ["pipe", "ignore", "ignore"], detached: true })
    const fini = new Promise(resolve => { p.once("close", resolve); p.once("error", () => resolve(1)) })
    p.stdin.on("error", () => {})
    p.stdin.end(JSON.stringify(o))
    p.unref()
    return fini
  } catch { return Promise.resolve(1) }
}
// Événements : OpenCode 1 (properties, session.idle…) et 2 (data, session.execution.succeeded…)
const FIN = ["session.idle", "session.execution.succeeded", "session.execution.interrupted", "session.execution.failed"]
const ATTENTE = ["permission.asked", "question.asked", "form.created"]
const REPRISE = ["permission.replied", "permission.rejected", "question.replied", "form.replied", "form.cancelled"]
const evenement = (e, transmettre) => {
  if (!e) return
  const p = e.properties || e.data || {}
  const sid = p.sessionID || (p.info && p.info.id) || (p.form && p.form.sessionID)
  if (!sid) return
  const o = { session_id: sid }
  if (e.type === "session.execution.started") transmettre("prompt", o)
  else if (FIN.includes(e.type) || (e.type === "session.status" && p.status && p.status.type === "idle")) transmettre("stop", o)
  else if (ATTENTE.includes(e.type)) transmettre("permission", o)
  else if (REPRISE.includes(e.type)) transmettre("reprise", o)
  else if (e.type === "session.deleted") transmettre("fin", o)
}
// Une seule instance par emplacement transmet les événements ; le flux peut couvrir plusieurs projets.
const instances = globalThis[Symbol.for("nc-ile.opencode.instances")] ||= new Map()
export default {
  id: "nc-ile",
  async setup(ctx) {
    const dir = (ctx.location && ctx.location.directory) || process.cwd()
    const ident = Symbol("nc-ile"), sessions = new Map()
    instances.set(ident, dir)
    const c = new AbortController()
    const inscriptions = []
    let file = Promise.resolve()
    const transmettre = (ev, o) => {
      if (!o.session_id) return
      // Sérialiser les lectures asynchrones : une réponse lente ne remet pas « travail » après « fini ».
      file = file.then(async () => {
        if (c.signal.aborted) return
        let info = sessions.get(o.session_id)
        if (!info || info.expire < Date.now() || ev === "prompt") {
          try {
            const r = await ctx.session.get({ sessionID: o.session_id })
            const s = r.data || r
            info = { cwd: s.location?.directory || s.directory || "", expire: Date.now() + 30000 }
            sessions.delete(o.session_id); sessions.set(o.session_id, info)
            if (sessions.size > 256) sessions.delete(sessions.keys().next().value)
          } catch {
            // Une session supprimée reste identifiable grâce au dernier emplacement connu.
            info ||= { cwd: "" }
          }
        }
        const proprietaire = [...instances].find(([, d]) => d === info.cwd) || instances.entries().next().value
        if (proprietaire?.[0] !== ident) return
        await envoyer(ev, { ...o, cwd: info.cwd, terminal_cwd: dir })
        if (ev === "fin") sessions.delete(o.session_id)
      }).catch(e => console.warn("nc-ile: OpenCode event:", e.message))
    }
    try { inscriptions.push(await ctx.session.hook("prompt", (e) => { transmettre("prompt", { session_id: e && e.sessionID }) })) } catch (e) { console.warn("nc-ile: prompt hook:", e.message) }
    try { inscriptions.push(await ctx.tool.hook("execute.after", (e) => { transmettre("tool", { session_id: e.sessionID, tool: e.tool, args: e.input, erreur: e.status === "error" }) })) } catch (e) { console.warn("nc-ile: tool hook:", e.message) }
    ;(async () => {
      try { for await (const e of ctx.event.subscribe({ signal: c.signal })) evenement(e, transmettre) }
      catch (e) { if (!c.signal.aborted) console.warn("nc-ile: event subscription:", e.message) }
    })()
    return async () => {
      c.abort()
      instances.delete(ident)
      for (const r of inscriptions) if (r && r.dispose) await r.dispose()
    }
  },
  async server(input) {
    const dir = (input && input.directory) || process.cwd()
    return {
      "chat.message": async (i) => envoyer("prompt", { session_id: i.sessionID, cwd: dir }),
      "tool.execute.after": async (i) => envoyer("tool", { session_id: i.sessionID, cwd: dir, tool: i.tool, args: i.args }),
      event: async ({ event }) => evenement(event, (ev, o) => envoyer(ev, { ...o, cwd: dir })),
    }
  },
}
'''
PLUGIN_AMP = r'''// nc-ile : Amp dans l'île dynamique de noctalia-config (écrit par « nc-claude installer amp » ;
// « nc-claude retirer amp » l'enlève). Ne décide de rien : il regarde seulement.
import { spawn } from "node:child_process"
const envoyer = (ev, o) => {
  try {
    const p = spawn(@PY@, [@NC@, "ia", "amp", ev], { stdio: ["pipe", "ignore", "ignore"], detached: true })
    p.on("error", () => {})
    p.stdin.on("error", () => {})
    p.stdin.end(JSON.stringify(o))
    p.unref()
  } catch {}
}
const sid = (e) => (e && e.thread && e.thread.id) || (e && e.threadID) || "amp"
export default function (amp) {
  amp.on("agent.start", async (e) => { envoyer("prompt", { session_id: sid(e), cwd: process.cwd() }) })
  amp.on("tool.result", async (e) => { envoyer("tool", { session_id: sid(e), cwd: process.cwd(), tool: e && e.tool, args: e && e.input, erreur: e && e.status === "error" }) })
  amp.on("agent.end", async (e) => { envoyer("stop", { session_id: sid(e), cwd: process.cwd() }) })
}
'''


def installer_ia(ia, bavard=True):
    f = chemin(ia)
    if ia == "antigravity":
        cfg = lire_json(f)
        base = f"{PY} {NC} agy "
        h = lambda ev: {"type": "command", "command": base + ev, "timeout": 10}
        cfg[AGY_GROUPE] = {"enabled": True, "PreInvocation": [h("PreInvocation")],
                           "PostToolUse": [{"matcher": "*", "hooks": [h("PostToolUse")]}], "Stop": [h("Stop")]}
        ecrire_json(f, cfg)
    elif ia in ("opencode", "amp"):
        os.makedirs(os.path.dirname(f), exist_ok=True)
        js = (PLUGIN_OPENCODE if ia == "opencode" else PLUGIN_AMP).replace("@PY@", json.dumps(sys.executable))
        contenu = js.replace("@NC@", json.dumps(os.path.realpath(__file__)))
        try:
            with open(f, encoding="utf-8") as x:
                ancien = x.read()
        except FileNotFoundError:
            ancien = None
        if ancien != contenu:
            if ancien is not None and not os.path.exists(f + ".avant-nc-claude"):
                shutil.copy2(f, f + ".avant-nc-claude")
            tmp = None
            try:
                with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=os.path.dirname(f),
                                                 prefix=".nc-ile-", delete=False) as x:
                    tmp = x.name
                    x.write(contenu)
                os.chmod(tmp, os.stat(f).st_mode & 0o777 if ancien is not None else 0o644)
                os.replace(tmp, f)
            finally:
                if tmp and os.path.exists(tmp):
                    os.remove(tmp)
    elif ia in ("copilot", "kiro"):
        if ia == "copilot":
            cfg = {"version": 1, "hooks": {ev: [{"type": "command", "bash": commande(ia, ev), "timeoutSec": 5}]
                                           for ev in EVENEMENTS[ia]}}
        else:
            cfg = {"version": "v1", "hooks": [dict({"name": f"nc-ile-{ev}", "trigger": ev, "timeout": 10,
                                                    "action": {"type": "command", "command": commande(ia, ev)}},
                                                   **({"matcher": "*"} if "Tool" in ev else {}))
                                              for ev in EVENEMENTS[ia]]}
        ecrire_json(f, cfg)
    else:
        cfg = nettoyer(lire_json(f), f" ia {ia} ")
        hooks = cfg.setdefault("hooks", {})
        if ia == "cursor":
            cfg.setdefault("version", 1)
        for ev in EVENEMENTS[ia]:
            c = commande(ia, ev)
            if ia == "cursor":
                hooks.setdefault(ev, []).append({"command": c, "timeout": 5})
                continue
            if ia == "gemini":
                h = {"name": f"nc-ile-{ev}", "type": "command", "command": c, "timeout": 5000}
            elif ev == "PermissionRequest":
                h = {"type": "command", "command": c, "timeout": 600}   # attend ta réponse dans l'île
            else:
                h = {"type": "command", "command": c, "timeout": 10}
                if ia == "codex":
                    h["async"] = True
            g = {"hooks": [h]}
            if "Tool" in ev or ev == "PermissionRequest":
                g = {"matcher": ".*" if ia in ("gemini", "qwen") else "*", "hooks": [h]}
            hooks.setdefault(ev, []).append(g)
        ecrire_json(f, cfg)
    if bavard:
        print(T(f"Intégration {NOMS[ia]} installée ({f.replace(HOME, '~')}) ; les événements restent à vérifier.",
                f"{NOMS[ia]} integration installed ({f.replace(HOME, '~')}); events still need to be checked."))
        if ia == "codex":
            print(T("Codex demande d'approuver ses nouveaux hooks : ouvre-le et tape /hooks une fois.",
                    "Codex asks you to approve its new hooks: open it and type /hooks once."))
        print(T(f"Relance {NOMS[ia]} s'il est ouvert. Pour vérifier : nc-claude diag ; pour l'enlever : nc-claude retirer {ia}",
                f"Restart {NOMS[ia]} if it is open. To check: nc-agents diag; to remove it: nc-agents remove {ia}"))


def retirer_ia(ia):
    f = chemin(ia)
    if os.path.exists(f):
        if ia == "antigravity":
            cfg = lire_json(f)
            if cfg.pop(AGY_GROUPE, None) is not None:
                ecrire_json(f, cfg)
        elif ia in ("opencode", "amp", "copilot", "kiro"):
            os.remove(f)                       # fichier à nous
        else:
            ecrire_json(f, nettoyer(lire_json(f), f" ia {ia} "))
    print(T(f"{NOMS[ia]} retiré de l'île.", f"{NOMS[ia]} removed from the island."))
    with Etat() as d:
        for sid in [x for x in d["sessions"] if x.startswith(ia + "-")]:
            del d["sessions"][sid]


def hook_ia(ia, nom):
    """Un événement d'une IA (JSON sur l'entrée standard), ramené à : début, étape, attente, fini, fin."""
    ev = lire_entree()
    n = (nom or ev.get("hook_event_name") or "").lower()
    # Réponses attendues : Gemini lit du JSON, Cursor veut « continue » avant d'envoyer la demande ; les autres rien
    if ia == "gemini":
        print("{}")
    elif ia == "cursor" and n == "beforesubmitprompt":
        print('{"continue": true}')
    sys.stdout.flush()
    outil = ev.get("tool_name") or ev.get("toolName") or ev.get("tool") or ""
    journal(ia, nom, outil)
    if reglage(ia.upper() + "_ILE", "oui") == "non" or not ev:
        return
    sid = ev.get("session_id") or ev.get("sessionId") or ev.get("conversation_id") or ev.get("conversationId")
    cwd = ev.get("cwd") or (ev.get("workspace_roots") or [""])[0] or ev.get("directory") or ""
    def suivre_evenement(quoi, outil="", args=None, erreur=False, message=""):
        suivre(ia, sid, cwd, quoi, outil, args, erreur, message, terminal_cwd=ev.get("terminal_cwd"))
    if n == "permissionrequest" and ia in DEMANDES_ILE:
        ev.setdefault("session_id", sid)
        demande(ev, "permission", ia)          # attend ta réponse dans l'île (ou ton retour sur son terminal)
    elif n == "sessionstart":
        suivre_evenement("pret")
    elif n in DEBUT:
        suivre_evenement("debut")
    elif n in ETAPE and outil:
        args = ev.get("tool_input") or ev.get("toolArgs") or ev.get("args") or ev.get("input") or {}
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = {"command": args}
        suivre_evenement("etape", outil, args, bool(ev.get("erreur") or ev.get("error")))
    elif n in ATTENTE or (n == "notification" and str(ev.get("notification_type") or "").lower()
                          in ("permission_prompt", "toolpermission", "elicitation_dialog")):
        # Le texte de la question quand l'IA le donne (Gemini, Copilot : message ; Qwen : message ou détails)
        suivre_evenement("attente", message=ev.get("message") or ev.get("details") or "")
    elif n == "reprise":
        with Etat() as d:
            s = d["sessions"].get(f"{ia}-{sid}")
            if s and s.get("etat") == "terminal":
                s["etat"] = "travail"
                s["maj"] = time.time()                 # notre notification « Voir » s'en va (notification())
    elif n in FINI:
        suivre_evenement("fini", message=ev.get("last_assistant_message") or ev.get("prompt_response") or "")
    elif n in ("sessionend", "fin"):
        suivre_evenement("fin")


# ── Ligne d'état de Claude Code (statusLine) aux couleurs du bureau ──────────────────────────────────────────────
# Claude Code lance « nc-claude-ligne » (avant : « nc-claude statusline », toujours compris) à chaque changement avec un JSON sur l'entrée standard et affiche ce qui
# sort. Rapide et sans sous-processus ; un JSON absent, vide ou invalide donne une ligne minimale, jamais une trace.
COMMANDE_LIGNE = "$HOME/.local/bin/nc-claude-ligne"
ANCIENNE_LIGNE = "$HOME/.local/bin/nc-claude statusline"
# La ligne d'état elle-même : nc-claude-ligne (petit script relancé à chaque changement), chargé ici pour
# « nc-claude statusline » (ancienne commande) et pour les tests
def _module_ligne():
    import importlib.machinery
    import importlib.util
    chemin = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0] or ".")), "nc-claude-ligne")
    if not os.path.exists(chemin):
        chemin = os.path.join(HOME, ".local/bin/nc-claude-ligne")
    ld = importlib.machinery.SourceFileLoader("nc_claude_ligne", chemin)
    m = importlib.util.module_from_spec(importlib.util.spec_from_loader("nc_claude_ligne", ld))
    ld.exec_module(m)
    return m


def ligne():
    try:
        _module_ligne().ligne()
    except Exception:
        sys.stdout.write("Claude\n")


# ── Installation des hooks ───────────────────────────────────────────────────────────────────────────────────────
def a_nous(h):
    return "nc-claude hook" in str(h.get("command", ""))


def retirer_de(cfg):
    hooks = cfg.get("hooks") or {}
    for ev in list(hooks):
        groupes = []
        for g in hooks[ev]:
            g = dict(g)
            g["hooks"] = [h for h in g.get("hooks", []) if not a_nous(h)]
            if g["hooks"]:
                groupes.append(g)
        if groupes:
            hooks[ev] = groupes
        else:
            del hooks[ev]
    if hooks:
        cfg["hooks"] = hooks
    else:
        cfg.pop("hooks", None)
    return cfg


def ligne_a_nous(sl):
    c = str(sl.get("command", "")) if isinstance(sl, dict) else ""
    return "nc-claude statusline" in c or "nc-claude-ligne" in c


def lire_settings():
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except ValueError:
        sys.exit(T(f"nc-claude : {SETTINGS} n'est pas un JSON valide : rien n'a été changé.",
                   f"nc-agents: {SETTINGS} is not valid JSON: nothing was changed."))


def ecrire_settings(cfg):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    if os.path.exists(SETTINGS):
        copie = SETTINGS + ".avant-nc-claude"
        if not os.path.exists(copie):
            shutil.copy2(SETTINGS, copie)
    tmp = SETTINGS + ".nc-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SETTINGS)


def installer(bavard=True):
    avant = lire_settings()
    cfg = retirer_de(json.loads(json.dumps(avant)))
    hooks = cfg.setdefault("hooks", {})
    vite = {"type": "command", "command": COMMANDE, "async": True, "timeout": 10}
    for ev in ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop", "SessionEnd"):
        hooks.setdefault(ev, []).append({"hooks": [dict(vite)]})
    # Demandes : le hook attend ta réponse dans l'île (ou ton retour sur le terminal), 10 min au plus
    hooks.setdefault("PermissionRequest", []).append(
        {"hooks": [{"type": "command", "command": COMMANDE, "timeout": 600}]})
    hooks.setdefault("PreToolUse", []).append(
        {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "NC_CLAUDE_SYNC=1 " + COMMANDE, "timeout": 600}]})
    # Les notifications de Claude (par son terminal) : remplacées par celles de nc-claude (voir notifier)
    if cfg.get("preferredNotifChannel", "auto") == "auto":
        cfg["preferredNotifChannel"] = "notifications_disabled"
    # Ligne d'état aux couleurs du bureau : seulement si tu n'en as pas déjà une (la tienne n'est jamais remplacée)
    ligne_ajoutee = False
    if bavard and "statusLine" not in cfg and reglage("CLAUDE_LIGNE", "oui") != "non":
        cfg["statusLine"] = {"type": "command", "command": COMMANDE_LIGNE, "padding": 0}
        ligne_ajoutee = True
    elif isinstance(cfg.get("statusLine"), dict) and cfg["statusLine"].get("command") == ANCIENNE_LIGNE:
        cfg["statusLine"]["command"] = COMMANDE_LIGNE      # la nôtre, à l'ancienne commande : le petit script, plus rapide
    if cfg != avant:
        ecrire_settings(cfg)
    if not bavard:
        return
    if ligne_ajoutee:
        print(T("Sa ligne d'état aux couleurs du bureau est ajoutée (nc-claude retirer l'enlève).",
                "Its status line in the desktop colors is added (nc-agents remove takes it away)."))
    print(T(f"Claude Code s'affiche maintenant dans l'île (hooks ajoutés à {SETTINGS.replace(HOME, '~')}).",
            f"Claude Code now shows in the island (hooks added to {SETTINGS.replace(HOME, '~')})."))
    print(T("Les sessions de Claude déjà ouvertes le prennent en compte d'elles-mêmes (sinon : relance claude).",
            "Claude sessions already open pick it up on their own (otherwise: restart claude)."))
    print(T("Pour l'enlever : nc-claude retirer", "To remove it: nc-agents remove"))


def retirer():
    if not os.path.exists(SETTINGS):
        print(T("Rien à retirer.", "Nothing to remove."))
        return
    cfg = retirer_de(lire_settings())
    if ligne_a_nous(cfg.get("statusLine")):
        del cfg["statusLine"]                      # seulement la nôtre
    if cfg.get("preferredNotifChannel") == "notifications_disabled":
        del cfg["preferredNotifChannel"]           # ses propres notifications reviennent
    ecrire_settings(cfg)
    print(T("Hooks de l'île retirés de ", "Island hooks removed from ") + SETTINGS.replace(HOME, "~") + ".")


def dossier_court(s):
    """Le NOM du dossier de la session (jamais le chemin) : « ~ » pour le dossier personnel, 40 signes imprimables au plus."""
    cwd = s.get("cwd_reel") or s.get("cwd") or ""
    if not isinstance(cwd, str):
        return "?"
    if cwd in ("~", HOME) or os.path.realpath(os.path.expanduser(cwd)) == os.path.realpath(HOME):
        return "~"
    nom = "".join(c for c in os.path.basename(cwd.rstrip("/")) if c.isprintable()).strip()
    return nom[:40] or "?"


def montrer_json(avec_texte=False):
    """L'état pour JARVIS (contrat 1) : une liste de champs choisis un à un, rien d'autre ne sort (ni chemin, ni étapes, ni
    question). Le dernier message de l'agent seulement avec --texte, et pas pendant qu'il travaille (il serait périmé)."""
    try:
        d = json.load(open(ETAT, encoding="utf-8"))
    except (OSError, ValueError):
        d = {}
    sessions = []
    for sid, s in (d.get("sessions") or {}).items() if isinstance(d.get("sessions"), dict) else ():
        if not isinstance(s, dict) or not isinstance(sid, str):
            continue
        x = {"id": sid, "agent": s.get("agent") or "claude", "dossier": dossier_court(s), "etat": str(s.get("etat") or "pret"),
             "ecrire": s.get("ecrire") is True, "signale_autorisation": (s.get("agent") or "claude") in SIGNALENT_AUTORISATION}
        if avec_texte and x["etat"] != "travail":
            m = s.get("reponse") or s.get("message")
            if isinstance(m, str) and m.strip():
                x["message"] = m.strip()[:QUESTION_MAX]
        sessions.append(x)
    print(json.dumps({"contrat": 1, "sessions": sessions}, ensure_ascii=False))


def montrer():
    try:
        d = json.load(open(ETAT, encoding="utf-8"))
    except (OSError, ValueError):
        print(T("Aucune session de Claude Code suivie.", "No Claude Code session tracked."))
        return
    # États (valeurs internes, lues par l'île) : affichés en anglais en mode anglais
    etats = {"travail": "working", "fini": "done", "attente": "waiting", "demande": "request", "terminal": "terminal",
             "pret": "ready"} if EN else {}
    for s in d.get("sessions", {}).values():
        etat = etats.get(s.get("etat"), s.get("etat"))
        print(f"{s.get('projet')}  [{etat}]  {s.get('etape', '')}  +{s.get('ajouts', 0)} −{s.get('retraits', 0)}")
    for x in d.get("demandes", {}).values():
        print(T("  demande : ", "  request: ") + f"{x.get('titre')} {x.get('detail', '')}")


# Ce que kitty montre au premier plan du terminal quand l'agent y tourne encore (noms de processus réels : un binaire, ou un
# interpréteur suivi du script). Comparaison EXACTE d'un nom ou d'un composant du chemin du script, jamais une sous-chaîne.
PROCESSUS_AGENT = {"claude": ("claude", "claude-code"), "codex": ("codex",), "gemini": ("gemini", "gemini-cli"),
                   "opencode": ("opencode",), "antigravity": ("agy", "antigravity"), "cursor": ("cursor-agent",),
                   "copilot": ("copilot",), "qwen": ("qwen", "qwen-code"), "kiro": ("kiro", "kiro-cli"), "amp": ("amp",)}
INTERPRETES = ("node", "nodejs", "bun", "deno", "python", "python3")
# Quels agents SIGNALENT une autorisation (ou une question à choix) par un événement de hook DÉDIÉ, vérifié dans leur doc officielle
# (jamais de lecture de l'écran ni d'heuristique sur le texte). Pendant ces moments, un texte + Entrée validerait le choix surligné :
# l'état passe à « demande » (Claude) ou « terminal » (les autres, via suivre) et JARVIS n'écrit pas. Pour les autres agents (repli),
# on ne sait pas quand ils attendent une autorisation (l'état reste « travail » pendant qu'elle attend) : JARVIS n'écrit que
# lorsqu'ils sont « fini » ou « prêt ».
#   claude   PermissionRequest ; Notification permission_prompt / elicitation_dialog (idle_prompt = simple saisie, « attente »)
#            https://code.claude.com/docs/en/hooks
#   codex    PermissionRequest : « runs when Codex is about to ask for approval » (aucun événement d'attente de saisie : au prompt,
#            Stop → « fini ») https://developers.openai.com/codex/hooks (redirige vers https://learn.chatgpt.com/docs/hooks)
#   gemini   Notification, notification_type « ToolPermission » (seule valeur) https://geminicli.com/docs/hooks/ et
#            docs/hooks/reference.md du dépôt google-gemini/gemini-cli
#   qwen     PermissionRequest « when permission dialog is shown » ; Notification permission_prompt / idle_prompt
#            https://qwenlm.github.io/qwen-code-docs/en/users/features/hooks/
#   copilot  notification, notification_type permission_prompt / elicitation_dialog ; hook permissionRequest
#            https://docs.github.com/en/copilot/reference/hooks-configuration
#   opencode événements de plugin permission.asked (https://opencode.ai/docs/plugins/) et question.asked / form.created (extension
#            ci-dessous) ; session.idle = « fini »
# REPLI (aucun événement d'autorisation dans leurs hooks) : antigravity (comment hook_agy : « ni de demande d'autorisation »), cursor,
# kiro, amp (hooks installés ici : prompt, outil, stop, fin seulement).
SIGNALENT_AUTORISATION = ("claude", "codex", "gemini", "qwen", "copilot", "opencode")
SORTIE_AGENT_ABSENT = 3                    # nc-claude ecrire --distant : l'agent ne tourne plus dans ce terminal
SORTIE_AUTORISATION = 4                    # … ou une autorisation attend (n'importe quel texte + Entrée la validerait)


def cmdline_est_agent(cmdline, agent):
    noms = PROCESSUS_AGENT.get(agent)
    if not noms or not isinstance(cmdline, list) or not cmdline or not all(isinstance(x, str) for x in cmdline):
        return False
    exe = os.path.basename(cmdline[0])
    if exe in noms:
        return True
    if exe in INTERPRETES and len(cmdline) > 1:
        script = [c for c in cmdline[1].split("/") if c]
        if script:
            script[-1] = re.sub(r"\.(?:c|m)?js$|\.py$", "", script[-1])
        return any(c in noms for c in script)
    return False


def agent_au_premier_plan(sock, shell, agent):
    """Vrai si le premier plan du terminal de ce shell (kitty @ ls, argv exact) est bien cet agent."""
    try:
        r = subprocess.run(["kitty", "@", "--to", "unix:" + sock, "ls", "--match", f"pid:{shell}"], capture_output=True, text=True, timeout=5)
        os_fenetres = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False
    for ow in os_fenetres if isinstance(os_fenetres, list) else ():
        for tab in ow.get("tabs") or () if isinstance(ow, dict) else ():
            for w in tab.get("windows") or () if isinstance(tab, dict) else ():
                if isinstance(w, dict) and w.get("pid") == shell and any(
                        cmdline_est_agent(p.get("cmdline"), agent) for p in w.get("foreground_processes") or () if isinstance(p, dict)):
                    return True
    return False


def ecrire(sid, texte, distant=False):
    """Écrit un message à l'agent d'une session depuis l'île : tapé dans son terminal (kitty), puis Entrée. distant (JARVIS,
    Telegram) : refuse, sans rien envoyer, si une autorisation attend (état demande ou terminal : un texte + Entrée la validerait)
    ou si l'agent n'est plus au premier plan de son terminal (la session est gardée 6 h : le texte partirait dans un shell, ssh, vim…)."""
    texte = re.sub(r"\s+", " ", texte).strip()
    try:
        s = json.load(open(ETAT, encoding="utf-8"))["sessions"][sid]
    except (OSError, ValueError, KeyError):
        sys.exit(T("nc-claude : session inconnue.", "nc-agents: unknown session."))
    if distant and s.get("etat") in ("demande", "terminal"):
        print(T("nc-claude : une autorisation attend, réponds sur le PC.", "nc-agents: a permission is waiting, answer on the PC."), file=sys.stderr)
        sys.exit(SORTIE_AUTORISATION)
    if distant and (s.get("agent") or "claude") not in SIGNALENT_AUTORISATION and s.get("etat") not in ("fini", "pret"):
        print(T("nc-claude : cet agent ne signale pas s'il attend une autorisation.", "nc-agents: this agent does not report whether it waits for a permission."),
              file=sys.stderr)
        sys.exit(SORTIE_AUTORISATION)
    sock = socket_kitty(s.get("terminal"))
    if texte and s.get("agent") == "opencode" and not (sock and s.get("shell")) and shutil.which("opencode"):
        # OpenCode 2 tourne en service de fond : le message part dans la session par sa propre commande, en ARGUMENT. Un
        # texte qui commence par un tiret (« --auto », « -f ») y serait lu comme une option : refusé, quel que soit le
        # parseur d'opencode (le passage par kitty, lui, envoie le texte comme des données, sur l'entrée standard)
        if texte.lstrip().startswith("-"):
            sys.exit(T("nc-claude : commence ton message par un mot (OpenCode lirait le tiret comme une option).",
                       "nc-agents: start your message with a word (OpenCode would read the dash as an option)."))
        subprocess.Popen(["opencode", "run", "--session", sid.split("-", 1)[1], texte], cwd=os.path.expanduser(s.get("cwd") or "~"),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif not texte or not sock or not s.get("shell"):
        sys.exit(T("nc-claude : on ne peut écrire qu'à un agent lancé dans kitty.",
                   "nc-agents: you can only write to an agent started in kitty."))
    else:
        if distant and not agent_au_premier_plan(sock, s["shell"], s.get("agent") or "claude"):
            print(T("nc-claude : l'agent ne tourne plus dans ce terminal.", "nc-agents: the agent is no longer running in this terminal."),
                  file=sys.stderr)
            sys.exit(SORTIE_AGENT_ABSENT)
        envoyer_kitty(sock, s["shell"], texte)
    with Etat() as d:
        x = d["sessions"].get(sid)
        if x:
            x.update(etat="travail", maj=time.time())
            ajouter_etape(x, "chat", T("Toi : ", "You: ") + court(texte, 50))


def envoyer_kitty(sock, shell, texte):
    base = ["kitty", "@", "--to", "unix:" + sock, "send-text", "--match", f"pid:{shell}"]
    r = subprocess.run(base + ["--bracketed-paste", "auto", "--stdin"], input=texte, text=True, capture_output=True, timeout=5)
    if r.returncode:
        sys.exit(T("nc-claude : ", "nc-agents: ") + (r.stderr.strip() or T("kitty n'a pas accepté le texte", "kitty did not accept the text")))
    time.sleep(0.2)                            # Entrée à part : sinon prise pour un retour à la ligne du texte collé
    subprocess.run(base + ["--stdin"], input="\r", text=True, capture_output=True, timeout=5)


def diag():
    """Ce qui est en place, en clair : à envoyer si l'île ne montre rien."""
    def ligne(ok, texte):
        print(("  ✓ " if ok else "  ✗ ") + texte)
    ligne(ile_active(), T("île (nc-ile.service) ", "island (nc-ile.service) ")
          + (T("active", "running") if ile_active() else T("arrêtée : systemctl --user start nc-ile",
                                                             "stopped: systemctl --user start nc-ile")))
    try:
        cc = "nc-claude hook" in open(SETTINGS, encoding="utf-8").read()
    except OSError:
        cc = False
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            sl = json.load(f).get("statusLine")
    except (OSError, ValueError, AttributeError):
        sl = None
    if cc or os.path.isdir(os.path.join(HOME, ".claude")):
        ligne(cc and reglage("CLAUDE_ILE", "oui") != "non",
              T("Claude Code : ", "Claude Code: ") + (T("branché", "hooked up") if cc else T("pas branché (nc-claude installer)",
                                                                                         "not hooked up (nc-agents install)"))
              + (T(" — coupé dans nc-reglages", " — turned off in nc-settings") if reglage("CLAUDE_ILE", "oui") == "non" else ""))
        ligne(True, T("Ligne d'état de Claude Code : ", "Claude Code status line: ")
              + (T("aux couleurs du bureau", "in the desktop colors") if ligne_a_nous(sl)
                 else T("la tienne (rien n'est changé)", "yours (nothing is changed)") if sl
                 else T("aucune (nc-claude installer l'ajoute)", "none (nc-agents install adds it)")))
    for ia in IAS:
        if not present(ia) and not installe(ia):
            continue
        ok = installe(ia)
        ligne(ok and reglage(ia.upper() + "_ILE", "oui") != "non",
              T(f"{NOMS[ia]} : ", f"{NOMS[ia]}: ") + (T(f"branché ({FICHIERS[ia]})", f"hooked up ({FICHIERS[ia]})") if ok
                                                       else T(f"pas branché (nc-claude installer {ia})", f"not hooked up (nc-agents install {ia})"))
              + (T(" — coupé dans nc-reglages", " — turned off in nc-settings") if reglage(ia.upper() + "_ILE", "oui") == "non" else ""))
        if ia == "antigravity" and ok:
            print(T("      agy lancé avec --dangerously-skip-permissions : selon sa version, ses hooks ne tournent pas",
                    "      agy started with --dangerously-skip-permissions: depending on its version, its hooks do not run"))
        if ia == "codex" and ok:
            print(T("      Codex : ses hooks doivent être approuvés une fois (/hooks dans Codex)",
                    "      Codex: its hooks must be approved once (/hooks in Codex)"))
        try:
            with open(ETAT, encoding="utf-8") as f:
                recues = [s for s in json.load(f).get("sessions", {}).values() if s.get("agent") == ia]
        except (OSError, ValueError):
            recues = []
        print(T("      Session de cette IA conservée dans l'état actuel : ",
                "      AI session retained in current state: ") + (T("oui", "yes") if recues else T("non", "no")))
    try:
        l = open(JOURNAL, encoding="utf-8").read().splitlines()
        print(T(f"Derniers événements reçus des IA ({len(l)}) :", f"Last events received from the AIs ({len(l)}):"))
        for x in l[-10:]:
            print("  " + x)
    except OSError:
        print(T("Aucun événement reçu d'une IA (hors Claude) : relance-la après l'installation, puis donne-lui une demande.",
                "No event received from an AI (other than Claude): restart it after installing, then give it a request."))
    print(T("Sessions suivies :", "Tracked sessions:"))
    montrer()


def main():
    a = sys.argv[1:]
    if os.environ.get("NC_ILE_SANS") and a and a[0] in ("hook", "agy", "ia"):
        return                                 # question rapide du Spotlight (nc-demander) : pas une session à suivre
    if a and a[0] in ("hook", "agy", "ia", "assistant") and reglage("IA_MODE", "auto") == "non":
        return                                 # IA du bureau coupée : plus rien dans l'île, l'agent travaille comme sans elle
    # Sous-commandes anglaises (nc-agents install…) : ramenées aux françaises
    if a:
        a[0] = {"install": "installer", "remove": "retirer", "detect": "detecter", "refresh": "actualiser",
                "write": "ecrire", "goto": "aller", "state": "etat", "status": "etat"}.get(a[0], a[0])
    if a[0:1] in (["installer"], ["retirer"]) and len(a) > 1 and a[1] == "all":
        a[1] = "tout"
    if not a:
        print(T(__doc__, DOC_EN).strip())
    elif a[0] == "hook":
        try:
            hook()
        except Exception:                      # un hook ne doit jamais gêner Claude
            pass
    elif a[0] == "agy":
        try:
            hook_agy(a[1] if len(a) > 1 else "")
        except Exception:                      # un hook ne doit jamais gêner Antigravity
            pass
    elif a[0] == "assistant" and len(a) == 2:
        hook_assistant(a[1])
    elif a[0] == "ia" and len(a) >= 3:
        try:
            hook_ia(a[1], a[2])
        except Exception:                      # un hook ne doit jamais gêner l'IA
            pass
    elif a[0] in ("installer", "retirer"):
        quoi = a[1] if len(a) > 1 else "claude"
        if quoi == "tout":
            for ia in [x for x in IAS if present(x)]:
                (installer_ia if a[0] == "installer" else retirer_ia)(ia)
        elif quoi in IAS:
            (installer_ia if a[0] == "installer" else retirer_ia)(quoi)
        elif quoi == "claude":
            installer() if a[0] == "installer" else retirer()
        else:
            sys.exit(T("nc-claude : IA inconnue. Au choix : claude, " + ", ".join(IAS) + ", tout",
                       "nc-agents: unknown AI. Choose from: claude, " + ", ".join(IAS) + ", all"))
    elif a[0] == "detecter":
        # IA présentes, pas encore branchées, pas refusées (pour install.sh)
        print(" ".join(ia for ia in IAS if present(ia) and not installe(ia) and reglage(ia.upper() + "_ILE", "oui") != "non"))
    elif a[0] == "actualiser":
        # IA déjà branchées : remises au format du jour (nc-maj), sans rien demander
        try:
            if "nc-claude hook" in open(SETTINGS, encoding="utf-8").read():
                installer(bavard=False)
        except OSError:
            pass
        for ia in IAS:
            if installe(ia) and reglage(ia.upper() + "_ILE", "oui") != "non":
                installer_ia(ia, bavard=False)
    elif a[0] == "statusline":
        ligne()
    elif a[0] == "etat" and a[1:2] == ["--json"] and set(a[2:]) <= {"--texte", "--text"}:
        if not os.environ.get("XDG_RUNTIME_DIR"):
            sys.exit(2)
        montrer_json(len(a) > 2)
    elif a[0] == "etat":
        montrer()
    elif a[0] == "diag":
        diag()
    elif a[0] == "ecrire" and a[1:2] == ["--distant"] and len(a) >= 4:
        if not os.environ.get("XDG_RUNTIME_DIR"):          # pas de repli sur /tmp : l'état d'un autre compte pourrait s'y trouver
            sys.exit(T("nc-claude : XDG_RUNTIME_DIR manque, rien n'est envoyé.", "nc-agents: XDG_RUNTIME_DIR is missing, nothing sent."))
        ecrire(a[2], " ".join(a[3:]), distant=True)
    elif a[0] == "ecrire" and len(a) >= 3:
        ecrire(a[1], " ".join(a[2:]))
    elif a[0] == "notification" and len(a) >= 4:
        notification(a[1], a[2], a[3], voir=a[4:5] == ["voir"])
    elif a[0] == "aller" and len(a) >= 2:
        aller(a[1], a[2] if len(a) > 2 else 0)
    else:
        print(T(__doc__, DOC_EN).strip())


if __name__ == "__main__":
    main()
