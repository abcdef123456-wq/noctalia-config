#!/usr/bin/env python3
"""nc-xwayland-primaire : l'écran primaire vu par XWayland devient l'écran NOM (celui où l'on est), pour que les jeux
X11/Proton démarrent aux dimensions de cet écran. Appelé par la config Hyprland (nc/ecrans.lua) quand l'écran actif
change, qu'un écran est branché ou débranché, ou qu'une fenêtre de Steam ou d'un jeu s'ouvre.

  nc-xwayland-primaire NOM

Ne fait rien (code 0, sans message) : sans XDG_RUNTIME_DIR ou sans DISPLAY, si aucun Xwayland de cet utilisateur ne
tourne (un appel à xrandr démarrerait Xwayland pour rien), sans xrandr, si le primaire est déjà NOM pour ce Xwayland,
ou si xrandr échoue (sortie inconnue de XWayland, vieux XWayland aux sorties XWAYLAND0…) : l'état n'est alors pas noté.
Code 2 : NOM refusé. xrandr est lancé avec une liste d'arguments fixe, sans shell."""
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

NOM = re.compile(r"[A-Za-z][A-Za-z0-9._-]{0,31}")      # eDP-1, DP-2, HDMI-A-1 : jamais « -… »
PROC = os.environ.get("NC_XWAYLAND_PROC", "/proc")      # les tests y mettent un faux /proc


def xwayland():
    """Les pid des Xwayland de cet utilisateur, triés (plusieurs : celui de DISPLAY est visé, l'état les retient tous)."""
    pids = []
    try:
        entrees = os.listdir(PROC)
    except OSError:
        return pids
    for p in entrees:
        if not p.isdigit():
            continue
        nom = uid = None
        try:
            with open(os.path.join(PROC, p, "status")) as f:     # Name: et Uid: (réel), lus d'un seul fichier
                for l in f:
                    if l.startswith("Name:"):
                        nom = l.split(None, 1)[1].strip() if len(l.split()) > 1 else ""
                    elif l.startswith("Uid:"):
                        uid = int(l.split()[1])
                        break
        except (OSError, ValueError, IndexError):
            continue
        if nom == "Xwayland" and uid == os.getuid():
            pids.append(int(p))
    return sorted(pids)


def main(argv):
    if len(argv) != 1 or not NOM.fullmatch(argv[0]):
        print("usage : nc-xwayland-primaire NOM (une lettre, puis lettres, chiffres, . _ -, 32 au plus)", file=sys.stderr)
        return 2
    nom = argv[0]
    run, display = os.environ.get("XDG_RUNTIME_DIR", ""), os.environ.get("DISPLAY", "")
    if not os.path.isabs(run) or not display:
        return 0
    pids = xwayland()
    if not pids or not shutil.which("xrandr"):
        return 0
    etat = Path(run) / "nc-xwayland-primaire"
    voulu = f"{','.join(map(str, pids))}|{display}|{nom}\n"
    try:
        if etat.read_text() == voulu:
            return 0
    except (OSError, UnicodeDecodeError):
        pass
    try:
        r = subprocess.run(["xrandr", "--output", nom, "--primary"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if r.returncode != 0:
        return 0
    try:
        fd, tmp = tempfile.mkstemp(dir=run, prefix=".nc-xwayland-primaire.")      # 0600
        with os.fdopen(fd, "w") as f:
            f.write(voulu)
        os.replace(tmp, etat)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
