#!/usr/bin/env bash
# cmatrix : unimatrix (rapide, gère le redimensionnement) avec la couleur la plus proche de l'accent du fond d'écran.
hex=$(jq -r '.mPrimary // .primary // empty' ~/.config/noctalia/colors.json 2>/dev/null)
col=green
if [[ $hex =~ ^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$ ]]; then
  col=$(python3 - "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" <<'PY'
import sys,colorsys
r,g,b=[int(x,16)/255 for x in sys.argv[1:4]]
h,l,s=colorsys.rgb_to_hls(r,g,b); h*=360
if s<0.2: print("white")
else:
    for lim,n in ((20,"red"),(45,"yellow"),(75,"yellow"),(165,"green"),(200,"cyan"),(255,"blue"),(330,"magenta"),(361,"red")):
        if h<lim: print(n); break
PY
)
fi
exec unimatrix -a -f -s 93 -l kn -c "$col" -o "$@"
