#!/usr/bin/env bash
# nc-sysinfo : lignes courtes, en français, pour l'accueil du terminal (nc-greeting).
#   nc-sysinfo modele   marque et modèle du PC (portable) ou de la carte mère (PC monté), rien s'ils sont inconnus
#   nc-sysinfo gpu      cartes graphiques ; la carte dédiée indique si elle est en veille
#   nc-sysinfo ecrans   écrans branchés : définition et fréquence (interne d'abord)
#   nc-sysinfo disques  disques physiques : SSD NVMe, SSD, disque dur, et leur taille
#   nc-sysinfo power    batterie (et sa santé), secteur, profil énergétique ; profil seul sur un PC fixe
#   nc-sysinfo sante    santé de la batterie en % (lissée) et nombre de cycles, séparés par une tabulation
#   nc-sysinfo uptime   durée depuis l'allumage
# Une ligne vide est masquée par fastfetch : chaque PC n'affiche que ses propres composants.
# Ne lit que des fichiers de /sys mis en cache par le noyau : n'allume jamais une carte graphique en veille
# (contrairement à lspci ou au module GPU de fastfetch).
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
ALIM="${NC_POWER_SUPPLY:-${NC_SYSFS:-/sys}/class/power_supply}"   # alimentations (NC_POWER_SUPPLY, NC_SYSFS : tests)

gpu_name() { # $1 = dossier PCI
  local d=$1 ven dev rev name=""
  ven=$(<"$d/vendor"); dev=$(<"$d/device"); rev=$(<"$d/revision")
  ven=${ven#0x}; dev=${dev#0x}; rev=${rev#0x}
  if [ "$ven" = 1002 ] && [ -r /usr/share/libdrm/amdgpu.ids ]; then
    name=$(awk -F',[ \t]*' -v d="${dev^^}" -v r="${rev^^}" '$1 == d && $2 == r { print $3; exit }' /usr/share/libdrm/amdgpu.ids)
  fi
  local ids="" f
  # pci.ids : hwdata (Arch, Fedora, openSUSE) ou pciutils (Debian) ; NC_PCI_IDS : un autre fichier, pour les tests
  for f in "${NC_PCI_IDS:-}" /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids /usr/share/pci.ids; do
    [ -n "$f" ] && [ -r "$f" ] && { ids=$f; break; }
  done
  if [ -z "$name" ] && [ -n "$ids" ]; then
    name=$(awk -v v="$ven" -v d="$dev" '
      /^[0-9a-f]{4} / { inv = ($1 == v); next }
      inv && /^\t[0-9a-f]{4} / { if ($1 == d) { sub(/^\t[0-9a-f]{4}  /, ""); print; exit } }' "$ids")
    [[ "$name" =~ \[(.*)\] ]] && name=${BASH_REMATCH[1]}
  fi
  name=${name#AMD }; name=${name#NVIDIA }; name=${name#GeForce }; name=${name#Intel }
  name=${name% / Mobile}; name=${name% Max-Q}; name=${name% Laptop GPU}
  echo "${name:-$(t carte card) $ven:$dev}"
}

# Taille lisible en français (Go, To ; puissances de 10, comme sur l'étiquette du disque)
# (en anglais : TB, GB, point décimal)
taille() {
  if [ "${NC_LANGUE:-fr}" = en ]; then
    awk -v b="$1" 'BEGIN { if (b >= 1e12) printf "%.1f TB", b / 1e12; else printf "%.0f GB", b / 1e9 }' | sed 's/\.0 TB/ TB/'
  else
    awk -v b="$1" 'BEGIN { if (b >= 1e12) printf "%.1f To", b / 1e12; else printf "%.0f Go", b / 1e9 }' | sed 's/\.0 To/ To/; s/\./,/'
  fi
}

# Nom de marque lisible
marque() {
  case "${1,,}" in
    lenovo*) echo Lenovo ;; asustek*|asus*) echo ASUS ;; acer*) echo Acer ;; hp|hewlett*) echo HP ;; dell*) echo Dell ;;
    micro-star*|msi*) echo MSI ;; gigabyte*) echo Gigabyte ;; samsung*) echo Samsung ;; huawei*) echo Huawei ;;
    framework*) echo Framework ;; apple*) echo Apple ;; razer*) echo Razer ;; tuxedo*) echo TUXEDO ;;
    *) echo "$1" ;;
  esac
}
inconnu() { [[ -z "$1" || "${1,,}" =~ (to be filled|system product|default string|not applicable|^none$|^o\.e\.m|type1|system version|^x\.x) ]]; }

# Santé de la batterie : capacité annoncée par la batterie / capacité d'origine. Cette estimation du contrôleur de la
# batterie bouge de ±1 à 2 % d'un jour à l'autre (température, charge partielle, limite à 80 % qui empêche de se
# recalibrer) : un relevé par jour est gardé (~/.local/state/nc/batterie-sante, 60 jours), et la santé affichée est la
# médiane des 30 derniers. Sortie : « santé<TAB>cycles » (cycles vide si inconnu), rien sans batterie.
sante() {
  local b pl or cy f jour
  for b in "$ALIM"/BAT*; do
    pl=$(cat "$b/energy_full" 2>/dev/null || cat "$b/charge_full" 2>/dev/null)
    or=$(cat "$b/energy_full_design" 2>/dev/null || cat "$b/charge_full_design" 2>/dev/null)
    cy=$(cat "$b/cycle_count" 2>/dev/null)
    [ -n "$pl" ] && [ "${or:-0}" -gt 0 ] && break
    pl=""
  done
  [ -n "$pl" ] || return 0
  f="${XDG_STATE_HOME:-$HOME/.local/state}/nc/batterie-sante"
  jour=$(date +%F)
  if ! grep -q "^$jour " "$f" 2>/dev/null; then
    mkdir -p "$(dirname "$f")"
    { tail -n 59 "$f" 2>/dev/null; echo "$jour $pl $or"; } > "$f.tmp" && mv "$f.tmp" "$f"
  fi
  # Médiane (sort puis awk : marche avec tous les awk, mawk de Debian compris)
  tail -n 30 "$f" | awk '{ printf "%.4f\n", $2 * 100 / $3 }' | sort -n | awk -v cy="${cy:-}" '{ v[NR] = $1 } END {
      m = (NR % 2) ? v[(NR + 1) / 2] : (v[NR / 2] + v[NR / 2 + 1]) / 2
      if (m > 100) m = 100
      printf "%d\t%s\n", m + 0.5, (cy > 0 ? cy : "") }'
}

action="${1:-}"
# Noms anglais (model, screens, disks, health)
case "$action" in model) action=modele ;; screens|displays) action=ecrans ;; disks) action=disques ;; health) action=sante ;; esac

case "$action" in
  sante) sante ;;
  modele)
    dmi=/sys/class/dmi/id
    v=$(cat $dmi/sys_vendor 2>/dev/null); n=$(cat $dmi/product_name 2>/dev/null); ver=$(cat $dmi/product_version 2>/dev/null)
    # Lenovo range le nom commercial dans product_version (« Legion Pro 5 16ADR10 »), product_name n'est qu'un code
    if [ "${v,,}" = lenovo ] && ! inconnu "$ver"; then n=$ver; fi
    if inconnu "$n"; then
      # PC monté : la carte mère
      v=$(cat $dmi/board_vendor 2>/dev/null); n=$(cat $dmi/board_name 2>/dev/null)
      inconnu "$n" && exit 0
    fi
    v=$(marque "$v")
    case "$n" in "$v"*) echo "$n" ;; *) echo "${v:+$v }$n" ;; esac
    ;;
  ecrans)
    command -v hyprctl >/dev/null || exit 0
    hyprctl monitors -j 2>/dev/null | jq -r '
      sort_by(.name | test("^eDP") | not) | map(
        "\(.width) × \(.height) · \(.refreshRate | round) Hz"
        + (if (.physicalWidth // 0) > 0 then
             " · \(((.physicalWidth * .physicalWidth + .physicalHeight * .physicalHeight) | sqrt / 25.4 + 0.5) | floor)\""
           else "" end)
      ) | join("  ·  ")' 2>/dev/null
    ;;
  disques)
    out=()
    while read -r nom octets rota tran; do
      case "$nom" in zram*|loop*|sr*|fd*) continue ;; esac
      [ "$octets" -gt 0 ] 2>/dev/null || continue
      if [ "$tran" = nvme ]; then t="$(t "SSD NVMe" "NVMe SSD")"; elif [ "$rota" = 0 ]; then t="SSD"; else t="$(t "disque dur" "HDD")"; fi
      [ "$tran" = usb ] && t="$t USB"
      out+=("$t $(taille "$octets")")
    done < <(lsblk -dbno NAME,SIZE,ROTA,TRAN 2>/dev/null)
    [ ${#out[@]} -gt 0 ] && (IFS='|'; echo "${out[*]}") | sed 's/|/ · /g'
    ;;
  gpu)
    out=()
    for d in "${NC_SYSFS:-/sys}"/bus/pci/devices/*; do
      [[ $(<"$d/class") == 0x03* ]] || continue
      n=$(gpu_name "$d")
      if [ "$(cat "$d/boot_vga" 2>/dev/null)" != 1 ] && [ "$(cat "$d/power/runtime_status" 2>/dev/null)" = suspended ]; then
        n="$n $(t "(en veille)" "(asleep)")"
      fi
      # Carte principale (celle de l'écran) en premier
      if [ "$(cat "$d/boot_vga" 2>/dev/null)" = 1 ]; then out=("$n" "${out[@]}"); else out+=("$n"); fi
    done
    (IFS='|'; echo "${out[*]}") | sed 's/|/ · /g'
    ;;
  power)
    parts=()
    # Pourcentage gardé en mémoire par UPower (3 ms) ; lire /sys/…/BAT*/capacity interroge le matériel (~70 ms)
    pct=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice \
          org.freedesktop.UPower.Device Percentage 2>/dev/null | awk '{printf "%d", $2 + 0.5}')
    if [ -z "$pct" ] || [ "$pct" = 0 ]; then
      for b in "$ALIM"/BAT*; do [ -r "$b/capacity" ] && { pct=$(<"$b/capacity"); break; }; done
    fi
    if [ -n "$pct" ] && ls -d "$ALIM"/BAT* >/dev/null 2>&1; then
      sante=$(sante | cut -f1)
      [ -n "$sante" ] && parts+=("$(t "$pct % (santé $sante %)" "$pct% (health $sante%)")") || parts+=("$(t "$pct %" "$pct%")")
    fi
    if [ ${#parts[@]} -gt 0 ]; then
      # Même test que le reste du bureau (nc-gpu-regle) : un chargeur USB-C compte comme le secteur
      . "$HOME/.local/bin/nc-gpu-regle" 2>/dev/null || nc_sur_batterie() { return 0; }
      nc_sur_batterie && parts+=("$(t "sur batterie" "on battery")") || parts+=("$(t "sur secteur" "plugged in")")
    fi
    # Profil de la plateforme (instantané, suit TLP / power-profiles-daemon), sinon D-Bus
    prof=$(cat "${NC_SYSFS:-/sys}/firmware/acpi/platform_profile" 2>/dev/null)
    perso=0
    case "$prof" in
      low-power|quiet|cool) prof=power-saver ;;
      max-power|balanced-performance) prof=performance ;;   # choix réels d'une Legion
      performance|balanced|power-saver) ;;
      *) [ "$prof" = custom ] && perso=1; prof="" ;;         # custom ou inconnu : on demande à power-profiles-daemon
    esac
    [ -n "$prof" ] || prof=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | awk -F'"' '{print $2}')
    case "$prof" in
      performance) parts+=("Performance") ;;
      balanced) parts+=("$(t "Équilibré" "Balanced")") ;;
      power-saver) parts+=("$(t "Économie" "Power Saver")") ;;
      *) [ "$perso" = 1 ] && parts+=("$(t "Perso" "Custom")") ;;
    esac
    [ ${#parts[@]} -gt 0 ] && (IFS='|'; echo "${parts[*]}") | sed 's/|/ · /g'
    ;;
  uptime)
    read -r up _ < /proc/uptime; up=${up%.*}
    d=$((up / 86400)); h=$((up % 86400 / 3600)); m=$((up % 3600 / 60))
    if [ $d -gt 0 ]; then t "allumé depuis $d j $h h" "up ${d}d ${h}h"; echo
    elif [ $h -gt 0 ]; then printf "$(t 'allumé depuis %d h %02d' 'up %dh %02dm')\n" $h $m
    else t "allumé depuis $m min" "up $m min"; echo; fi
    ;;
  *)
    if [ "${NC_LANGUE:-fr}" = en ]; then
      cat <<'FIN'
# nc-sysinfo: short lines for the terminal greeting (nc-greeting).
#   nc-sysinfo model    brand and model of the PC (laptop) or motherboard (desktop), nothing if unknown
#   nc-sysinfo gpu      graphics cards; the dedicated one shows whether it's asleep
#   nc-sysinfo screens  connected displays: resolution and refresh rate (built-in first)
#   nc-sysinfo disks    physical disks: NVMe SSD, SSD, HDD, and their size
#   nc-sysinfo power    battery (and its health), AC, power profile; profile only on a desktop
#   nc-sysinfo health   battery health in % (smoothed) and cycle count, tab-separated
#   nc-sysinfo uptime   time since boot
FIN
    else
      sed -n '2,9p' "$0"
    fi
    exit 1 ;;
esac
