#!/usr/bin/env bash
# nc-sysinfo : lignes courtes, en français, pour l'accueil du terminal (nc-greeting).
#   nc-sysinfo modele   marque et modèle du PC (portable) ou de la carte mère (PC monté), rien s'ils sont inconnus
#   nc-sysinfo gpu      cartes graphiques ; la carte dédiée indique si elle est en veille
#   nc-sysinfo ecrans   écrans branchés : définition et fréquence (interne d'abord)
#   nc-sysinfo disques  disques physiques : SSD NVMe, SSD, disque dur, et leur taille
#   nc-sysinfo power    batterie (et sa santé), secteur, profil énergétique ; profil seul sur un PC fixe
#   nc-sysinfo uptime   durée depuis l'allumage
# Une ligne vide est masquée par fastfetch : chaque PC n'affiche que ses propres composants.
# Ne lit que des fichiers de /sys mis en cache par le noyau : n'allume jamais une carte graphique en veille
# (contrairement à lspci ou au module GPU de fastfetch).
set -uo pipefail

gpu_name() { # $1 = dossier PCI
  local d=$1 ven dev rev name=""
  ven=$(<"$d/vendor"); dev=$(<"$d/device"); rev=$(<"$d/revision")
  ven=${ven#0x}; dev=${dev#0x}; rev=${rev#0x}
  if [ "$ven" = 1002 ] && [ -r /usr/share/libdrm/amdgpu.ids ]; then
    name=$(awk -F',[ \t]*' -v d="${dev^^}" -v r="${rev^^}" '$1 == d && $2 == r { print $3; exit }' /usr/share/libdrm/amdgpu.ids)
  fi
  if [ -z "$name" ] && [ -r /usr/share/hwdata/pci.ids ]; then
    name=$(awk -v v="$ven" -v d="$dev" '
      /^[0-9a-f]{4} / { inv = ($1 == v); next }
      inv && /^\t[0-9a-f]{4} / { if ($1 == d) { sub(/^\t[0-9a-f]{4}  /, ""); print; exit } }' /usr/share/hwdata/pci.ids)
    [[ "$name" =~ \[(.*)\] ]] && name=${BASH_REMATCH[1]}
  fi
  name=${name#AMD }; name=${name#NVIDIA }; name=${name#GeForce }; name=${name#Intel }
  name=${name% / Mobile}; name=${name% Max-Q}; name=${name% Laptop GPU}
  echo "${name:-carte $ven:$dev}"
}

# Taille lisible en français (Go, To ; puissances de 10, comme sur l'étiquette du disque)
taille() { awk -v b="$1" 'BEGIN { if (b >= 1e12) printf "%.1f To", b / 1e12; else printf "%.0f Go", b / 1e9 }' | sed 's/\.0 To/ To/; s/\./,/'; }

# Nom de marque lisible
marque() {
  case "${1,,}" in
    lenovo*) echo Lenovo ;; asustek*|asus*) echo ASUS ;; acer*) echo Acer ;; hp|hewlett*) echo HP ;; dell*) echo Dell ;;
    micro-star*|msi*) echo MSI ;; gigabyte*) echo Gigabyte ;; samsung*) echo Samsung ;; huawei*) echo Huawei ;;
    framework*) echo Framework ;; apple*) echo Apple ;; razer*) echo Razer ;; tuxedo*) echo TUXEDO ;;
    *) echo "$1" ;;
  esac
}
inconnu() { [[ -z "$1" || "${1,,}" =~ (to be filled|system product|default string|not applicable|^none$|^o\.e\.m|type1|system version|^x\.x) ]]; }

case "${1:-}" in
  modele)
    dmi=/sys/class/dmi/id
    v=$(cat $dmi/sys_vendor 2>/dev/null); n=$(cat $dmi/product_name 2>/dev/null); ver=$(cat $dmi/product_version 2>/dev/null)
    # Lenovo range le nom commercial dans product_version (« Legion Pro 5 16ADR10 »), product_name n'est qu'un code
    if [ "${v,,}" = lenovo ] && ! inconnu "$ver"; then n=$ver; fi
    if inconnu "$n"; then
      # PC monté : la carte mère
      v=$(cat $dmi/board_vendor 2>/dev/null); n=$(cat $dmi/board_name 2>/dev/null)
      inconnu "$n" && exit 0
    fi
    v=$(marque "$v")
    case "$n" in "$v"*) echo "$n" ;; *) echo "${v:+$v }$n" ;; esac
    ;;
  ecrans)
    command -v hyprctl >/dev/null || exit 0
    hyprctl monitors -j 2>/dev/null | jq -r '
      sort_by(.name | test("^eDP") | not) | map(
        "\(.width) × \(.height) · \(.refreshRate | round) Hz"
        + (if (.physicalWidth // 0) > 0 then
             " · \(((.physicalWidth * .physicalWidth + .physicalHeight * .physicalHeight) | sqrt / 25.4 + 0.5) | floor)\""
           else "" end)
      ) | join("  ·  ")' 2>/dev/null
    ;;
  disques)
    out=()
    while read -r nom octets rota tran; do
      case "$nom" in zram*|loop*|sr*|fd*) continue ;; esac
      [ "$octets" -gt 0 ] 2>/dev/null || continue
      if [ "$tran" = nvme ]; then t="SSD NVMe"; elif [ "$rota" = 0 ]; then t="SSD"; else t="disque dur"; fi
      [ "$tran" = usb ] && t="$t USB"
      out+=("$t $(taille "$octets")")
    done < <(lsblk -dbno NAME,SIZE,ROTA,TRAN 2>/dev/null)
    [ ${#out[@]} -gt 0 ] && (IFS='|'; echo "${out[*]}") | sed 's/|/ · /g'
    ;;
  gpu)
    out=()
    for d in /sys/bus/pci/devices/*; do
      [[ $(<"$d/class") == 0x03* ]] || continue
      n=$(gpu_name "$d")
      if [ "$(cat "$d/boot_vga" 2>/dev/null)" != 1 ] && [ "$(cat "$d/power/runtime_status" 2>/dev/null)" = suspended ]; then
        n="$n (en veille)"
      fi
      # Carte principale (celle de l'écran) en premier
      if [ "$(cat "$d/boot_vga" 2>/dev/null)" = 1 ]; then out=("$n" "${out[@]}"); else out+=("$n"); fi
    done
    (IFS='|'; echo "${out[*]}") | sed 's/|/ · /g'
    ;;
  power)
    parts=()
    # Pourcentage gardé en mémoire par UPower (3 ms) ; lire /sys/…/BAT*/capacity interroge le matériel (~70 ms)
    pct=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice \
          org.freedesktop.UPower.Device Percentage 2>/dev/null | awk '{printf "%d", $2 + 0.5}')
    if [ -z "$pct" ] || [ "$pct" = 0 ]; then
      for b in /sys/class/power_supply/BAT*; do [ -r "$b/capacity" ] && { pct=$(<"$b/capacity"); break; }; done
    fi
    if [ -n "$pct" ] && ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1; then
      # Santé : capacité actuelle / capacité d'origine
      sante=""
      for b in /sys/class/power_supply/BAT*; do
        pl=$(cat "$b/energy_full" 2>/dev/null || cat "$b/charge_full" 2>/dev/null)
        or=$(cat "$b/energy_full_design" 2>/dev/null || cat "$b/charge_full_design" 2>/dev/null)
        [ -n "$pl" ] && [ "${or:-0}" -gt 0 ] && sante=$(( (pl * 100 + or / 2) / or )) && break
      done
      [ -n "$sante" ] && [ "$sante" -le 100 ] && parts+=("$pct % (santé $sante %)") || parts+=("$pct %")
    fi
    ac=""
    for a in /sys/class/power_supply/*; do
      [ "$(cat "$a/type" 2>/dev/null)" = Mains ] && ac=$(cat "$a/online" 2>/dev/null) && break
    done
    if [ ${#parts[@]} -gt 0 ]; then
      [ "$ac" = 1 ] && parts+=("sur secteur") || parts+=("sur batterie")
    fi
    # Profil de la plateforme (instantané, suit TLP / power-profiles-daemon), sinon D-Bus
    prof=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null)
    case "$prof" in low-power|quiet|cool) prof=power-saver ;; esac
    [ -n "$prof" ] || prof=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | awk -F'"' '{print $2}')
    case "$prof" in
      performance) parts+=("Performance") ;;
      balanced) parts+=("Équilibré") ;;
      power-saver) parts+=("Économie") ;;
    esac
    [ ${#parts[@]} -gt 0 ] && (IFS='|'; echo "${parts[*]}") | sed 's/|/ · /g'
    ;;
  uptime)
    read -r up _ < /proc/uptime; up=${up%.*}
    d=$((up / 86400)); h=$((up % 86400 / 3600)); m=$((up % 3600 / 60))
    if [ $d -gt 0 ]; then echo "allumé depuis $d j $h h"
    elif [ $h -gt 0 ]; then printf 'allumé depuis %d h %02d\n' $h $m
    else echo "allumé depuis $m min"; fi
    ;;
  *) sed -n '2,6p' "$0"; exit 1 ;;
esac
