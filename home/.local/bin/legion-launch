#!/usr/bin/env bash
# legion-launch : lance une appli sur le GPU par défaut du profil énergétique courant.
# Utilisé comme préfixe de lancement par Noctalia (lanceur, dock, barre des tâches).
#   Profil Performance (session sur l'iGPU) -> RTX, via nvidia-run
#   Autres profils                          -> iGPU AMD (environnement de session)
# Le choix est écrit par legion-profile-sync dans $XDG_RUNTIME_DIR/legion-gpu-default.
[ $# -ge 1 ] || { echo "Usage : legion-launch <commande> [arguments]" >&2; exit 1; }
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/legion-gpu-default"
if [ "$(cat "$state" 2>/dev/null)" = nvidia ]; then
  exec "$HOME/.local/bin/nvidia-run" "$@"
fi
exec "$@"
