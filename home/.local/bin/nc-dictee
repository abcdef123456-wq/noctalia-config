#!/usr/bin/env python3
"""nc-dictee : dictée vocale du chat JARVIS (bouton micro de l'île).

  nc-dictee start    démarre l'enregistrement du micro
  nc-dictee stop     l'arrête, envoie l'audio au serveur (POST /api/transcribe) et affiche le texte
  nc-dictee cancel   l'arrête et supprime l'enregistrement
  nc-dictee status   dit si un enregistrement est en cours
  nc-dictee ptt-debut | ptt-fin   dictée partout (Super + D) : maintenu, la voix est écrite dans la fenêtre active au
                     relâchement ; un appui bref lance une dictée longue, le suivant l'écrit (réglage IA_DICTEE)

Une ligne de JSON sur la sortie : {"ok": true, "text": "…", "engine": "…"} après une transcription,
{"ok": true, "recording": true} après un démarrage, {"ok": false, "error": "…"} sinon.
Le serveur et la clé sont ceux de ~/.config/nc/assistant.conf (nc-assistant configurer) ; la clé n'est jamais
écrite ailleurs, l'audio (16 kHz mono, dans XDG_RUNTIME_DIR) est supprimé après la transcription.
Sans JARVIS (ou s'il ne répond pas, en mode automatique) : la transcription d'une API de nc-ia (Groq, OpenAI, Gemini).
IA du bureau coupée (IA_MODE=non) : pas de dictée.
Enregistreur : parec (PulseAudio ou PipeWire), sinon pw-record, sinon arecord. Pas de synthèse vocale.
"""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import types
import urllib.error
import urllib.parse
import urllib.request

BIN = Path(__file__).resolve().parent
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
ETAT = RUNTIME / "nc-dictee.json"       # { pid, demarre } de l'enregistreur en cours
AUDIO = RUNTIME / "nc-dictee.wav"
JOURNAL = RUNTIME / "nc-dictee.log"     # sortie de l'enregistreur (jamais la clé)
MAX_REPONSE = 1024 * 1024


def client():
    """nc-assistant comme module : sa configuration, sa langue, son refus des redirections."""
    m = types.ModuleType("nc_assistant_client")
    m.__file__ = str(BIN / "nc-assistant")
    exec(compile((BIN / "nc-assistant").read_text(encoding="utf-8"), m.__file__, "exec"), m.__dict__)
    return m


CAPTURE = None                          # dictée partout : les résultats gardés ici au lieu d'être écrits


def sortie(**champs):
    if CAPTURE is not None:
        CAPTURE.append(champs)
        return
    print(json.dumps(champs, ensure_ascii=False), flush=True)


def lire_etat():
    try:
        etat = json.loads(ETAT.read_text(encoding="utf-8"))
        return etat if isinstance(etat, dict) else None
    except (OSError, ValueError):
        return None


# ── pid_notre : même texte dans nc-dictee, nc-panne et nc-claude (tests/test_pid.py vérifie qu'il est identique) ──────────
def debut_pid(pid):
    """Heure de démarrage du processus (champ 22 de /proc/PID/stat), ou None sans /proc."""
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            return f.read().rpartition(")")[2].split()[19]
    except (OSError, IndexError, TypeError, ValueError):
        return None


def pid_notre(pid, debut=None, nom=None):
    """Ce pid est-il vivant, pas un zombie (fini mais non recueilli : kill -0 réussit quand même), et bien le nôtre ?
    debut : l'heure de démarrage notée avec le pid dans un fichier (un autre processus au même pid, après un
    redémarrage de session, en a une autre). nom (ou un tuple de noms) : pour un ancien fichier sans heure, doit
    se trouver dans /proc/PID/cmdline. Sans /proc : kill -0 seul."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except PermissionError:
        pass
    except (OSError, ValueError, OverflowError):
        return False
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            champs = f.read().rpartition(")")[2].split()
    except OSError:
        return not os.path.isdir("/proc/self") or os.path.exists("/proc/%d" % pid)
    if not champs or champs[0] == "Z":
        return False
    if debut:
        return len(champs) > 19 and champs[19] == str(debut)
    if nom:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                ligne = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
        except OSError:
            return False
        return any(n in ligne for n in ((nom,) if isinstance(nom, str) else nom))
    return True
# ── fin de pid_notre ──────────────────────────────────────────────────────────────────────────────────────────────────


REC = ("parec", "pw-record", "arecord")   # le nom de l'enregistreur, pour un ancien fichier d'état (pid seul)


def actif(pid, debut=None, nom=None):
    return pid_notre(pid, debut, nom)


def enregistre(etat):
    """L'enregistreur noté dans le fichier d'état tourne-t-il encore (et c'est bien lui, pas un autre au même pid) ?"""
    return bool(etat) and actif(etat.get("pid"), etat.get("demarre"), REC)


def enregistreur(T):
    if shutil.which("parec"):
        return ["parec", "--format=s16le", "--rate=16000", "--channels=1", "--file-format=wav", str(AUDIO)]
    if shutil.which("pw-record"):
        return ["pw-record", "--format", "s16", "--rate", "16000", "--channels", "1", str(AUDIO)]
    if shutil.which("arecord"):
        return ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", "-t", "wav", str(AUDIO)]
    raise RuntimeError(T("Aucun enregistreur audio trouvé (parec, pw-record ou arecord).",
                         "No audio recorder found (parec, pw-record or arecord)."))


def arreter():
    """Arrête l'enregistreur en cours ; renvoie son état, ou None s'il n'y en avait pas."""
    with Verrou(RUNTIME / "nc-dictee-micro.lock"):
        return _arreter()


def _arreter():
    etat = lire_etat()
    if not etat:
        return None
    pid, debut = etat.get("pid"), etat.get("demarre")
    if actif(pid, debut, REC):                 # jamais un signal à un autre processus qui aurait repris ce pid
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(30):
            if not actif(pid, debut, REC):
                break
            time.sleep(0.1)
        if actif(pid, debut, REC):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    try:
        ETAT.unlink()
    except OSError:
        pass
    return etat


def demarrer(T, intention=None):
    with Verrou(RUNTIME / "nc-dictee-micro.lock"):
        if intention is not None:
            etat = lire_ptt()
            if not etat or etat.get("t") != intention:
                sortie(ok=False, error=T("Dictée annulée.", "Dictation cancelled."))
                return 1
        return _demarrer(T)


def _demarrer(T):
    nettoyer_captures()
    etat = lire_etat()
    if enregistre(etat):
        sortie(ok=True, recording=True, message=T("Enregistrement déjà en cours.", "Already recording."))
        return 0
    try:
        AUDIO.unlink()
    except OSError:
        pass
    commande = enregistreur(T)
    proc = None
    try:
        # Le Popen dans le try : un SIGTERM juste après le lancement arrête aussi l'enregistreur (pas d'orphelin).
        with open(JOURNAL, "ab") as journal:
            proc = subprocess.Popen(commande, stdin=subprocess.DEVNULL, stdout=journal, stderr=journal, start_new_session=True)
        # Immédiatement : même un SIGKILL pendant les 250 ms ne rend pas le micro introuvable pour cancel.
        ETAT.write_text(json.dumps({"pid": proc.pid, "demarre": debut_pid(proc.pid)}), encoding="utf-8")
        time.sleep(0.25)
        if proc.poll() is not None:
            ETAT.unlink(missing_ok=True)
            AUDIO.unlink(missing_ok=True)
            sortie(ok=False, error=T("L'enregistrement n'a pas démarré : vérifie le micro.",
                                     "Recording did not start: check the microphone."))
            return 1
    except BaseException:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=1)
        ETAT.unlink(missing_ok=True)
        AUDIO.unlink(missing_ok=True)
        raise
    sortie(ok=True, recording=True)
    return 0


def nettoyer_captures():
    """Après un SIGKILL, retirer au prochain démarrage les captures privées abandonnées depuis plus de dix minutes.
    Un processus encore vivant garde sa capture, même si sa transcription prend plus longtemps."""
    maintenant = time.time()
    for f in RUNTIME.glob("nc-dictee-transcription-*.wav"):
        m = re.fullmatch(r"nc-dictee-transcription-(\d+)-[a-z0-9_]+\.wav", f.name)
        if not m or actif(int(m[1])):
            continue
        try:
            s = f.lstat()
            if stat.S_ISREG(s.st_mode) and s.st_uid == os.getuid() and maintenant - s.st_mtime > 600:
                f.unlink()
        except OSError:
            pass


def ia():
    """nc-ia comme module : ses clés, ses fournisseurs de transcription."""
    l = importlib.machinery.SourceFileLoader("nc_ia", str(BIN / "nc-ia"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("nc_ia", l))
    l.exec_module(mod)
    return mod


def par_jarvis(m):
    """JARVIS transcrit s'il est relié, sauf si une autre IA est choisie à la main (et qu'elle sait transcrire)."""
    if not m.CONF.exists():
        return False
    try:
        i = ia()
        return not (i.mode() == "manuel" and i.reglage("IA_CHOIX", "claude") in i.fournisseurs_transcription())
    except Exception:
        return True


def langue_dictee(m):
    """La langue parlée, envoyée au serveur (?language=) : depuis 64523e5, JARVIS-BIS transcrit en français par défaut
    (WHISPER_LANGUAGE="fr"), un anglophone serait donc écrit en français. Le choix explicite (NC_LANGUE ou le réglage
    LANGUE, fr ou en) d'abord, puis la langue du système (de, es…), sinon « auto » (détection par Whisper). 3d1c6b6 lit
    le même paramètre, avec « auto » par défaut."""
    choix = os.environ.get("NC_LANGUE", "")
    if choix not in ("fr", "en"):
        try:
            for ligne in (m.CONF.parent / "reglages.conf").read_text(encoding="utf-8").splitlines():
                if ligne.startswith("LANGUE="):
                    choix = ligne.split("=", 1)[1].strip().strip('"')
        except (OSError, AttributeError, UnicodeDecodeError):
            pass
    if choix in ("fr", "en"):
        return choix
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG", "")
    code = re.split(r"[_.@-]", loc, maxsplit=1)[0].lower()
    return code if re.fullmatch(r"[a-z]{2}", code) else "auto"     # C, POSIX ou rien : détection


def secours():
    """Mode automatique et une API de transcription disponible : elle prend le relais de JARVIS."""
    try:
        i = ia()
        return i.mode() == "auto" and bool(i.fournisseurs_transcription())
    except Exception:
        return False


def par_ia(T, fichier=AUDIO):
    try:
        i = ia()
        texte, ident = i.transcrire(str(fichier))
    except Exception as e:
        sortie(ok=False, error=str(e)[:300])
        return 1
    sortie(ok=True, text=texte[:16000], engine=i.nom(ident))
    return 0


def transcrire(m):
    T = m.T
    # La capture terminée appartient à cette requête. Le micro peut être rouvert pendant l'attente réseau, sans que
    # le nettoyage de cette transcription efface le nouvel audio ou que deux clients envoient la même capture.
    with Verrou(RUNTIME / "nc-dictee-micro.lock"):
        if not _arreter():
            sortie(ok=False, error=T("Aucun enregistrement en cours.", "No recording in progress."))
            return 1
        fd, nom = tempfile.mkstemp(prefix=f"nc-dictee-transcription-{os.getpid()}-", suffix=".wav", dir=RUNTIME)
        os.close(fd)
        fichier = Path(nom)
        try:
            AUDIO.replace(fichier)
            fichier.chmod(0o600)     # une capture commencée par une ancienne version peut avoir une autre permission
        except FileNotFoundError:
            pass                        # fichier vide : même message qu'un micro coupé ci-dessous
        except OSError:
            fichier.unlink(missing_ok=True)
            raise
    try:
        # IA coupée pendant l'enregistrement : rien ne part, l'audio est supprimé (revue Codex DICT-02)
        if m.ia_coupee():
            sortie(ok=False, error=m.message_ia_coupee() if hasattr(m, "message_ia_coupee") else T(*m.MESSAGE_COUPEE))
            return 1
        if fichier.stat().st_size < 1000:
            sortie(ok=False, error=T("Enregistrement vide ou micro coupé.", "Empty recording or muted microphone."))
            return 1
        # Sans JARVIS (ou une autre IA choisie à la main) : la transcription des API de nc-ia (Groq, OpenAI, Gemini)
        if not par_jarvis(m):
            return par_ia(T, fichier)
        try:
            c = m.configuration()
            adresse = c["URL"].rstrip("/") + "/api/transcribe?" + urllib.parse.urlencode({"language": langue_dictee(m)})
            req = urllib.request.Request(adresse, data=fichier.read_bytes(),
                                         headers={"Content-Type": "audio/wav", "X-Secret-Key": c["SECRET_KEY"]}, method="POST")
            with urllib.request.build_opener(m.SansRedirection()).open(req, timeout=min(max(float(c["TIMEOUT"]), 30), 300)) as r:
                resultat = json.loads(r.read(MAX_REPONSE + 1).decode("utf-8"))
            if not isinstance(resultat, dict):
                raise ValueError
        except m.Erreur as e:
            sortie(ok=False, error=str(e))
            return 1
        except urllib.error.HTTPError as e:
            if e.code >= 500 and secours():
                return par_ia(T, fichier)
            if e.code in (401, 403):
                sortie(ok=False, error=T(f"Clé refusée par le serveur (HTTP {e.code}) : vérifie SECRET_KEY.",
                                         f"Server rejected the key (HTTP {e.code}): check SECRET_KEY."))
            elif e.code == 404:
                sortie(ok=False, error=T("Le serveur n'a pas de transcription (HTTP 404) : mets à jour le gateway.",
                                         "The server has no transcription (HTTP 404): update the gateway."))
            else:
                sortie(ok=False, error=T(f"Erreur HTTP {e.code} du serveur.", f"HTTP error {e.code} from the server."))
            return 1
        except Exception as e:   # réseau, délai, JSON : le détail sans la clé
            if secours():                                     # serveur injoignable : une API de transcription
                return par_ia(T, fichier)
            sortie(ok=False, error=T("Transcription impossible : ", "Transcription failed: ") + str(e)[:200])
            return 1
    finally:
        try:
            fichier.unlink()
        except OSError:
            pass
    texte = resultat.get("text")
    if not resultat.get("success") or not isinstance(texte, str) or not texte.strip():
        erreur = resultat.get("error")
        sortie(ok=False, error=str(erreur)[:300] if erreur else T("Transcription vide.", "Empty transcription."))
        return 1
    sortie(ok=True, text=texte.strip()[:16000], engine=str(resultat.get("engine") or ""))
    return 0


# ── Dictée partout (Super + D) ──────────────────────────────────────────────────────────────────────────────────
PTT = RUNTIME / "nc-dictee-ptt.json"     # { t : appui, pret : micro lancé (son heure), relache : relâché avant, bascule : dictée longue }
RELACHE = RUNTIME / "nc-dictee-relache"  # touché par le raccourci à chaque relâchement (D ou Super), avant nc-dictee
APPUI = RUNTIME / "nc-dictee-appui"      # touché par le raccourci à l'appui, avant de lancer nc-dictee (Python est lent)
BREF = 0.45                              # appui plus court (relâchement − appui, deux heures du raccourci) : dictée longue
# (lancé à la main, sans le raccourci, il n'y a pas d'heures notées : la durée compte alors le démarrage de Python)


def instant_appui():
    try:
        t = APPUI.stat().st_mtime
        if 0 <= time.time() - t < 5:
            return t
    except OSError:
        pass
    return time.time()


DEBUT = instant_appui()


def instant_relache(appui):
    """Heure du relâchement notée par le raccourci (celui de cet appui), sinon maintenant : la durée de la pression ne
    dépend pas du temps que Python met à démarrer (revue DICT-03)."""
    try:
        t = RELACHE.stat().st_mtime
        if t >= appui and 0 <= time.time() - t < 5:
            return t
    except OSError:
        pass
    return time.time()
VERROU = RUNTIME / "nc-dictee-ptt.lock"  # appui et relâchements (D, Super) arrivent ensemble : un seul décide à la fois


class Verrou:
    def __init__(self, chemin=VERROU):
        self.chemin = chemin

    def __enter__(self):
        import fcntl
        self.f = open(self.chemin, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


def annuler():
    with Verrou():
        PTT.unlink(missing_ok=True)
        with Verrou(RUNTIME / "nc-dictee-micro.lock"):
            _arreter()
            AUDIO.unlink(missing_ok=True)


def lire_ptt():
    try:
        etat = json.loads(PTT.read_text())
        etat = etat if isinstance(etat, dict) else None
    except (OSError, ValueError):
        return None
    # Une intention restée d'un démarrage interrompu (plus de 15 s sans micro prêt) ne compte plus
    if etat and not etat.get("pret") and time.time() - etat.get("t", 0) > 15:
        PTT.unlink(missing_ok=True)
        return None
    return etat


def ecrire_ptt(etat):
    # Un démarrage vérifie encore son intention sous le verrou du micro : il doit lire un état entier, même si le
    # processus du relâchement vient d'y ajouter son heure sous le verrou PTT.
    fd, nom = tempfile.mkstemp(prefix="nc-dictee-ptt-", suffix=".tmp", dir=RUNTIME)
    f = Path(nom)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as sortie:
            json.dump(etat, sortie)
        f.replace(PTT)
    finally:
        f.unlink(missing_ok=True)


TERMINAUX = ("kitty", "foot", "alacritty", "org.wezfurlong.wezterm", "com.mitchellh.ghostty", "org.kde.konsole",
             "org.gnome.terminal", "org.gnome.ptyxis", "xterm", "dropterm")


def reglage(cle, defaut):
    try:
        for l in (Path.home() / ".config/nc/reglages.conf").read_text(encoding="utf-8").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


def notifier(T, titre, corps="", court=False):
    try:
        subprocess.Popen(["notify-send", "-a", T("Dictée", "Dictation"), "-i", "audio-input-microphone",
                          "-h", "string:x-canonical-private-synchronous:nc-dictee"] + (["-t", "1800"] if court else [])
                         + ["--", titre, corps], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def presse_papiers():
    """(type, octets) du presse-papiers d'avant (texte, image, fichiers…), None s'il est vide ; lève OSError ou
    TimeoutExpired si on ne peut pas le lire (propriétaire bloqué)."""
    r = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=2)
    liste = [t.strip() for t in r.stdout.splitlines() if t.strip()] if r.returncode == 0 else []
    if not liste:
        return None
    mime = next((t for t in liste if t.startswith("text/plain")), None) or next((t for t in liste if "/" in t), liste[0])
    r = subprocess.run(["wl-paste", "-n", "-t", mime], capture_output=True, timeout=2)
    if r.returncode != 0:
        raise OSError(r.stderr.decode(errors="replace").strip() or mime)
    return mime, r.stdout


# wl-copy lit le texte sur son entrée standard (jamais en argument : /proc/*/cmdline est lisible par tous). Le type est
# donné : sans lui, wl-copy le devinerait avec xdg-mime (une dictée « <b> » deviendrait du HTML).
COPIER_TEXTE = ["--type", "text/plain;charset=utf-8"]


def wl_copy(options, donnees=None, check=False):
    """wl-copy pose le contenu puis se dédouble pour le servir. Son enfant garde la sortie d'erreur héritée : avec un
    tube (capture_output), run attendrait la fin de cet enfant et finirait en TimeoutExpired, sans collage. Ni tube ni
    lecture : seul le code de retour compte."""
    r = subprocess.run(["wl-copy", *options], input=donnees, stdin=None if donnees is not None else subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    if check and r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, r.args)
    return r


# wtype lit son entrée selon la locale (setlocale) : en C ou POSIX, il s'arrête au premier accent et sort avec 0
# (texte tronqué annoncé « Écrit »). C.UTF-8 est fournie par glibc ≥ 2.35, sur les quatre distributions.
ENV_WTYPE = {**os.environ, "LC_ALL": "C.UTF-8"}


def ecrire_dans_la_fenetre(texte, avertissements=None):
    """Le texte tapé dans la fenêtre active : wtype s'il est là, sinon collé (Ctrl + V, Ctrl + Maj + V dans un
    terminal), le presse-papiers d'avant (texte, image ou fichiers) remis ensuite. Faux si rien n'a pu être écrit."""
    if shutil.which("wtype"):
        # Le texte par l'entrée standard (« wtype - », dès wtype 0.3, un seul « - » par appel) : jamais en argument,
        # lisible par tous dans /proc/*/cmdline.
        # Délai selon la longueur : wtype tape touche par touche, une longue dictée prend du temps
        if subprocess.run(["wtype", "-"], input=texte.encode(), capture_output=True, env=ENV_WTYPE,
                          timeout=10 + len(texte) / 200).returncode == 0:
            return True
    if not (shutil.which("wl-copy") and shutil.which("wl-paste")):
        return False
    ecrit = False
    try:
        avant = presse_papiers()
    except (OSError, subprocess.TimeoutExpired):
        return False                # pas de collage par-dessus ce qu'on ne saurait pas remettre (revue DICT-04/05)
    try:
        copie = wl_copy(COPIER_TEXTE, texte.encode())
        if copie.returncode != 0:
            return False
        classe = ""
        try:
            classe = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=2).stdout or "{}").get("class", "")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        mods = "CTRL SHIFT" if classe.lower() in TERMINAUX else "CTRL"
        time.sleep(0.08)
        collage = subprocess.run(["hyprctl", "dispatch", f"hl.dsp.send_shortcut({{ mods = '{mods}', key = 'V' }})"], capture_output=True, text=True, timeout=5)
        # Hyprland peut annoncer « window not found » avec un code 0 : aucune fenêtre n'a reçu le collage.
        ecrit = collage.returncode == 0 and not re.search(r"(?im)^\s*(?:warning|error):", collage.stdout + "\n" + collage.stderr)
    finally:
        # Aussi après une erreur ou un délai dépassé : un collage refusé ne doit pas laisser le texte à la place de
        # l'image précédente. Un presse-papiers initialement vide est remis à vide.
        time.sleep(0.4)
        try:
            if avant is None:
                wl_copy(["--clear"], check=True)
            else:
                wl_copy(["--type", avant[0], "--"], avant[1], check=True)
        except (OSError, subprocess.SubprocessError):
            if not ecrit:
                raise
            if avertissements is not None:
                avertissements.append("presse-papiers")
    return ecrit


SECOURS = RUNTIME / "nc-dictee-derniere.txt"   # la dernière dictée, jamais perdue (effacée à la fin de la session)


def garder(texte):
    try:
        fd = os.open(SECOURS, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)   # /tmp sans XDG_RUNTIME_DIR
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(texte)
    except OSError:
        pass


def raccourci_dictee():
    """Le raccourci de la dictée tel que tu l'as choisi (nc-raccourci : « change 64:code:40 SUPER + S »), pour les
    messages ; Super + D sinon (issue #2 : « Super + D pour écrire » alors que c'était Super + S)."""
    try:
        for ligne in (Path.home() / ".config/nc/raccourcis.conf").read_text(encoding="utf-8").splitlines():
            c = ligne.split("\t")
            if len(c) >= 3 and c[0] == "change" and c[1] == "64:code:40" and c[2].strip():
                return " + ".join(x.strip().capitalize() if len(x.strip()) > 1 else x.strip().upper()
                                  for x in c[2].replace("code:40", "D").split("+"))
    except OSError:
        pass
    return "Super + D"


def ptt_debut(m):
    global CAPTURE
    T = m.T
    if reglage("IA_DICTEE", "oui") == "non":
        notifier(T, T("Dictée désactivée", "Dictation turned off"), T("nc-reglages → Intelligence artificielle", "nc-settings → Artificial intelligence"), True)
        return 1
    with Verrou():
        etat = lire_ptt()
        if etat and etat.get("bascule"):                   # second appui d'une dictée longue : on écrit
            PTT.unlink(missing_ok=True)
            finir = True
        elif etat and not etat.get("pret"):
            return 0                                       # un démarrage déjà en cours (répétition de la touche)
        elif enregistre(lire_etat()):
            # Micro ouvert sans relâchement reçu (relâchement perdu) : ce nouvel appui écrit la dictée au lieu d'être
            # ignoré sans rien dire, ce qui bloquait tous les appuis suivants (issue #2)
            PTT.unlink(missing_ok=True)
            finir = True
        else:
            # (une dictée dont l'enregistreur est mort — nc-dictee tué — ne bloque pas les appuis suivants)
            PTT.unlink(missing_ok=True)
            finir = False
            if not m.ia_coupee():
                # L'intention d'abord, datée de l'appui : un relâchement pendant le démarrage du micro est gardé
                # (revue Codex DICT-01)
                ecrire_ptt({"t": DEBUT, "pret": False})
    if finir:
        return ptt_finir(m)
    if m.ia_coupee():
        notifier(T, T("Dictée impossible", "Dictation unavailable"), m.message_ia_coupee() if hasattr(m, "message_ia_coupee") else "", True)
        return 1
    CAPTURE = []
    code = demarrer(T, intention=DEBUT)
    CAPTURE, res = None, CAPTURE
    if code != 0 or not res or not res[-1].get("ok"):
        with Verrou():
            etat = lire_ptt()
            if etat and etat.get("t") == DEBUT:
                PTT.unlink(missing_ok=True)
        notifier(T, T("Dictée impossible", "Dictation unavailable"), (res[-1].get("error") if res else "") or "")
        return 1
    with Verrou():
        etat = lire_ptt()
        if not etat or etat.get("t") != DEBUT:
            return 1                    # annulée pendant le démarrage : ne pas recréer son état
        relache = etat.get("relache")
        try:                                               # relâché avant même que l'intention soit écrite
            if relache is None and RELACHE.stat().st_mtime >= DEBUT:
                relache = RELACHE.stat().st_mtime
        except OSError:
            pass
        # Relâché avant que le micro soit prêt : rien d'enregistré, c'est un appui bref → dictée longue
        ecrire_ptt(dict(etat, pret=time.time(), bascule=relache is not None))
    if relache is None:
        notifier(T, T("🎙 Je t'écoute…", "🎙 Listening…"), T("Relâche pour écrire", "Release to write"))
    else:
        notifier(T, T("🎙 Dictée longue…", "🎙 Long dictation…"), T(f"{raccourci_dictee()} pour écrire", f"{raccourci_dictee()} to write"))
    return 0


def ptt_fin(m):
    with Verrou():
        etat = lire_ptt()
        if not etat or etat.get("bascule") or etat.get("relache"):
            return 0                                      # rien en cours, dictée longue qui continue, ou déjà relâché
        if not etat.get("pret"):                          # micro pas encore lancé : ptt-debut décidera
            ecrire_ptt(dict(etat, relache=instant_relache(etat.get("t") or DEBUT)))
            return 0
        # Appui bref (moins de 0,45 s entre l'appui et le relâchement, quelle que soit la lenteur de Python) : dictée longue
        appui = float(etat.get("t") or DEBUT)
        if instant_relache(appui) - appui < BREF:
            ecrire_ptt(dict(etat, bascule=True))
            longue = True
        else:
            PTT.unlink(missing_ok=True)                   # un seul relâchement finit (D et Super arrivent ensemble)
            longue = False
    if longue:
        notifier(m.T, m.T("🎙 Dictée longue…", "🎙 Long dictation…"), m.T(f"{raccourci_dictee()} pour écrire", f"{raccourci_dictee()} to write"))
        return 0
    return ptt_finir(m)


def ptt_finir(m):
    global CAPTURE
    T = m.T
    PTT.unlink(missing_ok=True)
    notifier(T, T("✍ Transcription…", "✍ Transcribing…"), "", True)
    CAPTURE = []
    transcrire(m)
    CAPTURE, res = None, CAPTURE
    r = res[-1] if res else {"ok": False}
    if not r.get("ok"):
        notifier(T, T("Dictée : rien d'écrit", "Dictation: nothing written"), str(r.get("error") or ""))
        return 1
    garder(r["text"])                                   # une dictée longue ne se perd pas si le collage échoue
    avertissements = []
    try:
        ecrit = ecrire_dans_la_fenetre(r["text"], avertissements)
    except (OSError, subprocess.SubprocessError):
        ecrit = False
    if not ecrit:
        # La dictée prime : elle est copiée même si le presse-papiers d'avant n'a pas pu être sauvé (il est remplacé, et
        # c'est dit), pour être collée à la main (revue DICT-06)
        try:
            wl_copy(COPIER_TEXTE, r["text"].encode(), check=True)
            copie = T("Copié (ton presse-papiers a été remplacé) : colle-le avec Ctrl + V.",
                      "Copied (your clipboard was replaced): paste it with Ctrl + V.")
        except (OSError, subprocess.SubprocessError):
            copie = T(f"Gardé dans {SECOURS}", f"Kept in {SECOURS}")
        notifier(T, T("Dictée (pas écrite dans la fenêtre)", "Dictation (not typed)"), f"{copie}\n{r['text'][:300]}")
        return 1
    titre = T("✓ Écrit (presse-papiers d'avant non remis)", "✓ Written (previous clipboard not restored)") if avertissements else T("✓ Écrit", "✓ Written")
    notifier(T, titre, r["text"][:120], True)
    return 0


def main():
    os.umask(0o077)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: sys.exit(128 + s))
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "ptt-fin" and not PTT.exists():
        return 0                                          # le plus fréquent (Super relâché) : rien à charger
    m = client()
    if action == "ptt-fin":
        return ptt_fin(m)
    if action == "ptt-debut":
        return ptt_debut(m)
    if action in ("start", "stop") and m.ia_coupee():
        annuler()
        sortie(ok=False, error=m.message_ia_coupee() if hasattr(m, "message_ia_coupee") else m.T(*m.MESSAGE_COUPEE))
        return 1
    try:
        if action == "start":
            return demarrer(m.T)
        if action == "stop":
            return transcrire(m)
        if action == "cancel":
            annuler()
            sortie(ok=True, recording=False)
            return 0
        if action == "status":
            etat = lire_etat()
            sortie(ok=True, recording=enregistre(etat))
            return 0
        sortie(ok=False, error="nc-dictee start | stop | cancel | status")
        return 1
    except (RuntimeError, OSError) as e:
        sortie(ok=False, error=str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main())
