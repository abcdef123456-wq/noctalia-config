#!/usr/bin/env bash
# nc-langue : langue de noctalia-config, français ou anglais (nc-reglages → Apparence → Langue : auto, fr, en).
#   nc-langue            affiche « fr » ou « en »
#   . nc-langue          (dans un script bash) définit NC_LANGUE et t "texte français" "English text"
# Ordre : variable NC_LANGUE (fr / en, ex. NC_LANGUE=en ./install.sh), puis le réglage LANGUE, puis la langue du
# système (français si elle commence par « fr », anglais sinon).
# Commandes en anglais : chaque commande nc-* a aussi un nom anglais (nc-settings = nc-reglages…), voir NOMS_ANGLAIS.
case "${NC_LANGUE:-}" in
  fr|en) ;;
  *)
    NC_LANGUE="$({ sed -n 's/^LANGUE=//p' "$HOME/.config/nc/reglages.conf" 2>/dev/null || true; } | tail -1 | tr -d '" ')"
    case "$NC_LANGUE" in
      fr|en) ;;
      *)
        _l="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
        [ -n "$_l" ] || _l="$({ sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null || true; } | tr -d '"')"
        case "$_l" in fr*) NC_LANGUE=fr ;; *) NC_LANGUE=en ;; esac
        unset _l ;;
    esac ;;
esac
export NC_LANGUE
t() { if [ "$NC_LANGUE" = en ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

# Noms anglais des commandes (liens créés par install.sh dans ~/.local/bin) : anglais:français
NOMS_ANGLAIS="nc-settings:nc-reglages nc-update:nc-maj nc-help:nc-aide nc-window:nc-fenetre nc-screenshot:nc-capture
nc-ask:nc-demander nc-packages:nc-paquets nc-shortcut:nc-raccourci nc-backup:nc-sauvegarde nc-memory:nc-memoire
nc-weather:nc-meteo nc-icons:nc-icones nc-close:nc-fermer nc-lid:nc-couvercle nc-clean-session:nc-session-propre
nc-lang:nc-langue nc-agents:nc-claude nc-kbd-light:nc-touches nc-island-state:nc-ile-etat
nc-displays:nc-ecrans nc-ai:nc-ia"

# Lancé directement (pas sourcé) : la langue
if [ "${BASH_SOURCE[0]}" = "$0" ]; then echo "$NC_LANGUE"; fi
