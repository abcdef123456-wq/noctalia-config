#!/usr/bin/env python3
"""nc-code : un espace de code en un geste (Super + X). Un sélecteur de projets, puis une fenêtre kitty prête :
Neovim à gauche, l'agent de l'IA choisie à droite (Claude Code, Codex, Gemini, OpenCode… ; un shell si l'IA est coupée
ou si aucun agent n'est installé), un onglet « Git » (lazygit, s'il existe) et un onglet « Terminal ».
  nc-code                  dans un terminal : le sélecteur aux couleurs de l'île (on tape pour chercher) ; Entrée ouvre
                           l'espace complet, Alt + Entrée seulement Neovim, Tab choisit l'agent (entrée redirigée :
                           liste numérotée, « 3 a » et « 3 n »). Sans terminal (Super + X) : le panneau de l'île
                           (Code.qml, façon Raycast) si elle tourne, sinon le même sélecteur dans une fenêtre kitty
  nc-code DOSSIER | .      directement, sans sélecteur (--nvim : seulement Neovim ; --agent PROG : cet agent ;
                           --sans-agent : un shell à la place)
  nc-code --liste          les projets proposés, un par ligne (nom, tabulation, chemin)
  nc-code --liste-json     les mêmes en JSON, le plus récent en tête (nom, chemin, court, branche, quand, date, message,
                           langage, couleur, github), sans lancer git (fichiers de .git lus directement)
  nc-code --agents-json    les agents disponibles en JSON : {coupee, defaut, agents: [{prog, nom}], debutant}
  nc-code --apercu-json DOSSIER   l'aperçu d'un projet en JSON : branche, derniers commits (reflog), début du README
                           en texte brut, URL GitHub (https seulement) — pour le panneau de l'île ; jamais git
  nc-code --nouveau NOM [--modele vide|python|c|web]   crée ~/Projets/NOM (CODE_DOSSIER dans nc-reglages) : git init,
                           README.md, fichiers de départ du modèle ; refuse un nom déjà pris ; puis ouvre l'espace de code
  nc-code --cloner [SOURCE]   clone un dépôt GitHub dans ~/Projets/DEPOT puis l'ouvre. SOURCE : https://github.com/PROP/DEPOT(.git),
                           git@github.com:PROP/DEPOT.git ou PROP/DEPOT (rien d'autre). Sans SOURCE : tes dépôts (gh connecté) ou
                           l'adresse tapée. gh repo clone si gh est connecté, sinon git clone par https ; jamais sur un dossier existant
  nc-code --session-seule DOSSIER   écrit sur la sortie standard la session kitty qui serait ouverte, sans la lancer
Les projets : dépôts git récents, sans parcours lourd : celui de noctalia-config, l'historique de zoxide et de
project.nvim, les sessions récentes de Claude Code, puis ~/*/.git et ~/*/*/.git (1 s au plus). Rien ne tourne en fond.
"""
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
ICI = os.path.dirname(os.path.abspath(sys.argv[0])) if sys.argv and sys.argv[0] else os.path.join(HOME, ".local/bin")
MOI = os.path.join(ICI, "nc-code")


def _langue():
    if os.environ.get("NC_LANGUE") in ("fr", "en"):
        return os.environ["NC_LANGUE"]
    v = reglage("LANGUE")
    if v in ("fr", "en"):
        return v
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "fr" if loc.startswith("fr") else "en"


def reglage(cle, defaut=""):
    try:
        with open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
            for l in f:
                if l.startswith(cle + "="):
                    return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


# ── Les projets ─────────────────────────────────────────────────────────────────────────────────────────────────
def est_depot(d):
    return os.path.isdir(d) and os.path.exists(os.path.join(d, ".git"))


def court(d):
    return "~" + d[len(HOME):] if d == HOME or d.startswith(HOME + "/") else d


def decoder_claude(nom):
    """Le dossier d'un nom de ~/.claude/projects (« un dossier mon-projet » → « -...-mon-projet » : tout ce qui n'est
    pas lettre ou chiffre devient « - »). Prudent : le chemin n'est jamais construit à partir du texte, seulement à
    partir des vrais dossiers existants dont le nom encodé commence ce qui reste ; '' si rien ne correspond."""
    def encode(x):
        return re.sub(r"[^A-Za-z0-9]", "-", x)

    def descend(base, reste):
        if not reste:
            return base
        try:
            noms = sorted(os.listdir(base), key=len, reverse=True)       # le plus long d'abord (mon-projet avant mon)
        except OSError:
            return ""
        for n in noms:
            e = encode(n)
            if reste == e or reste.startswith(e + "-"):
                p = os.path.join(base, n)
                if os.path.isdir(p):
                    r = descend(p, reste[len(e) + 1:])
                    if r:
                        return r
        return ""
    if not nom.startswith("-"):
        return ""
    return descend("/", nom[1:])


def projets_claude(limite=30):
    base = os.path.join(HOME, ".claude/projects")
    try:
        entrees = [(e.stat().st_mtime, e.name) for e in os.scandir(base) if e.is_dir()]
    except OSError:
        return []
    res = []
    for _, n in sorted(entrees, reverse=True)[:limite * 2]:
        d = decoder_claude(n)
        if d and est_depot(d):
            res.append(d)
        if len(res) >= limite:
            break
    return res


def projets_zoxide(limite=40):
    if not shutil.which("zoxide"):
        return []
    try:
        r = subprocess.run(["zoxide", "query", "-l"], capture_output=True, text=True, timeout=1, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return []
    res = []
    for l in r.stdout.splitlines()[:400]:
        if l.startswith("/") and est_depot(l):
            res.append(l)
            if len(res) >= limite:
                break
    return res


def projets_nvim(limite=30):
    try:
        with open(os.path.join(HOME, ".local/share/nvim/project_nvim/project_history"), encoding="utf-8",
                  errors="replace") as f:
            lignes = f.read().splitlines()
    except OSError:
        return []
    res = [l.strip() for l in reversed(lignes) if l.strip().startswith("/") and est_depot(l.strip())]
    return res[:limite]


def fichier_voulus():
    """Le fichier d'état des projets voulus (créés ou clonés par nc-code) : un chemin absolu par ligne."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
    return os.path.join(base, "nc", "code-projets")


def projets_voulus(limite=50):
    """Les projets créés ou clonés à la demande : jamais marqués « trouvés sur le disque »."""
    try:
        with open(fichier_voulus(), encoding="utf-8", errors="replace") as f:
            lignes = f.read(65536).splitlines()
    except OSError:
        return []
    res = [l for l in reversed(lignes) if l.startswith("/") and dossier_sur(l) and est_depot(l)]
    return res[:limite]


def fichier_deja_ouvert():
    """Marqueur : un projet a déjà été ouvert par nc-code (sert à l'aide du panneau de l'île pour un débutant)."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
    return os.path.join(base, "nc", "code-deja-ouvert")


def noter_deja_ouvert():
    f = fichier_deja_ouvert()
    try:
        os.makedirs(os.path.dirname(f), mode=0o700, exist_ok=True)
        with open(f, "a", encoding="utf-8"):
            pass
    except OSError:
        pass


def retenir_projet(d):
    """Note un projet voulu (sans doublon, 200 au plus)."""
    f = fichier_voulus()
    try:
        os.makedirs(os.path.dirname(f), mode=0o700, exist_ok=True)
        try:
            with open(f, encoding="utf-8", errors="replace") as h:
                anciens = [l for l in h.read(65536).splitlines() if l and l != d]
        except OSError:
            anciens = []
        tmp = f + ".tmp"
        with open(tmp, "w", encoding="utf-8") as h:
            h.write("\n".join((anciens + [d])[-200:]) + "\n")
        os.replace(tmp, f)
    except OSError:
        pass


def projet_noctalia():
    try:
        with open(os.path.join(HOME, ".config/nc/depot"), encoding="utf-8") as f:
            d = f.read().strip()
    except OSError:
        return []
    return [d] if d.startswith("/") and est_depot(d) else []


IGNORES = {"node_modules", "snap", "venv", "target", "build", "dist", "__pycache__", "Library"}


def projets_balayage(delai=1.0):
    """~/*/.git et ~/*/*/.git (profondeur 2 au plus), sans les dossiers cachés ; arrêté après delai secondes."""
    fin = time.monotonic() + delai
    res = []

    def liste(d):
        try:
            return [e for e in os.scandir(d) if not e.name.startswith(".") and e.name not in IGNORES and e.is_dir(follow_symlinks=False)]
        except OSError:
            return []
    for e1 in liste(HOME):
        if time.monotonic() > fin:
            break
        if est_depot(e1.path):
            res.append(e1.path)
            continue
        for e2 in liste(e1.path):
            if est_depot(e2.path):
                res.append(e2.path)
            if time.monotonic() > fin:
                break
    return sorted(res, key=lambda p: -os.stat(p).st_mtime if os.path.exists(p) else 0)


# Les projets trouvés seulement par le balayage du disque (jamais ouverts : une archive extraite, un clone) : marqués
# « trouvé sur le disque » et jamais présélectionnés dans le panneau de l'île (un Entrée par réflexe y lancerait lazygit,
# donc git, avec la config du dépôt)
PAR_BALAYAGE = set()


def projets(delai=1.0):
    """[chemin] sans doublon, dans l'ordre : noctalia-config, project.nvim, zoxide, Claude Code, puis le balayage."""
    vus, res = set(), []
    PAR_BALAYAGE.clear()
    sources_connues = (projet_noctalia(), projets_voulus(), projets_claude(), projets_nvim(), projets_zoxide())
    for n, sources in enumerate(sources_connues + (projets_balayage(delai),)):
        for d in sources:
            r = os.path.realpath(d)
            # les copies de travail temporaires des agents (Claude Code : .claude/worktrees/…) ne sont pas des projets
            if "/.claude/worktrees/" in r + "/" or not dossier_sur(r):
                continue
            if r not in vus:
                vus.add(r)
                res.append(d.rstrip("/") or "/")
                if n == len(sources_connues):
                    PAR_BALAYAGE.add(res[-1])
    return res


def config_lazygit():
    """Comme lg (outils.zsh) : notre thème et la touche G (~/.config/nc/lazygit.yml), puis ta config de lazygit (la
    dernière gagne). '' si LG_CONFIG_FILE est déjà choisi, ou sans notre fichier."""
    if os.environ.get("LG_CONFIG_FILE"):
        return ""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    nc, perso = os.path.join(HOME, ".config/nc/lazygit.yml"), os.path.join(base, "lazygit/config.yml")
    if not os.access(nc, os.R_OK) or "," in nc:
        return ""
    return nc + ("," + perso if os.access(perso, os.R_OK) and "," not in perso else "")


def dossier_sur(d):
    """Un chemin qui reste une seule ligne, tel quel, dans une session kitty (voir session)."""
    return bool(d) and d.isprintable() and d.splitlines() == [d] and d == d.strip()


def ligne_projet(d):
    return f"{os.path.basename(d) or d}  {court(d)}\t{d}"


# ── L'agent ─────────────────────────────────────────────────────────────────────────────────────────────────────
def nc_ia():
    for p in (os.path.join(ICI, "nc-ia"), os.path.join(HOME, ".local/bin/nc-ia")):
        if os.access(p, os.X_OK):
            return p
    return shutil.which("nc-ia") or ""


def etat_ia():
    """Le JSON de « nc-ia etat --json » ({} s'il ne répond pas)."""
    p = nc_ia()
    if not p:
        return {}
    try:
        r = subprocess.run([p, "etat", "--json"], capture_output=True, text=True, timeout=8, stdin=subprocess.DEVNULL)
        d = json.loads(r.stdout)
        return d if isinstance(d, dict) else {}
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}


def ia_coupee(e):
    return reglage("IA_MODE", "auto") == "non" or e.get("mode") == "non" or bool(e.get("coupee"))


# Agents de terminal qui ne sont pas (encore) des IA de nc-ia : (programme, nom affiché)
AGENTS_EN_PLUS = (("agy", "Antigravity"),)
# Ordre quand l'IA choisie n'a pas d'agent : Claude Code, puis Antigravity, puis les autres installés
ORDRE_AGENTS = ("claude", "agy")


def agents_disponibles(e):
    """[(programme, nom)] des IA permises dont l'agent en terminal est installé (sans doublon) : Claude Code, Antigravity,
    puis les autres. Vide si l'IA est coupée."""
    if ia_coupee(e):
        return []
    res, vus = [], set()
    for ia in e.get("ias") or []:
        prog = ia.get("cli") or ""
        if prog and ia.get("cli_disponible") and ia.get("disponible") is not False and prog not in vus and shutil.which(prog):
            vus.add(prog)
            res.append((prog, ia.get("nom") or prog))
    for prog, nom in AGENTS_EN_PLUS:
        if prog not in vus and shutil.which(prog):
            vus.add(prog)
            res.append((prog, nom))
    rang = {p: n for n, p in enumerate(ORDRE_AGENTS)}
    return sorted(res, key=lambda x: rang.get(x[0], len(rang)))        # tri stable : les autres gardent leur ordre


def agent_par_defaut(e):
    """Le programme de l'agent à droite : celui de l'usage « question » s'il est installé, sinon celui de l'IA choisie,
    sinon le premier agent installé. '' seulement si l'IA est coupée ou si aucun agent n'est installé (alors un shell)."""
    if ia_coupee(e):
        return ""
    u = (e.get("usages") or {}).get("question") or {}
    c = e.get("choisie") or {}
    for x in (u, c):
        prog = x.get("cli") or ""
        if prog and x.get("cli_disponible") and shutil.which(prog):
            return prog
    dispo = agents_disponibles(e)
    return dispo[0][0] if dispo else ""


# ── La session kitty ────────────────────────────────────────────────────────────────────────────────────────────
def session(dossier, agent="", seul_nvim=False, nvim=True, lazygit=True):
    """Le texte de la session kitty : Neovim à gauche (62 %), l'agent à droite ; sans agent, un shell. Dispositions
    « splits ». Onglets « Code », « Git » (lazygit, s'il existe) et « Terminal ». seul_nvim : Neovim seul."""
    # kitty coupe la session avec str.splitlines() (\r, \x0b, \x1c, U+2028… aussi), retire les espaces au bord de chaque
    # ligne et développe $VAR dans cd : un dossier trouvé par le balayage ne doit ni ajouter une ligne (une commande), ni
    # changer de sens. Refusé s'il n'est pas imprimable ou change au découpage ; « $ » doublé (« $$ » : un « $ » pour kitty)
    if not dossier_sur(dossier):
        raise ValueError("dossier")
    cd = "cd " + dossier.replace("$", "$$")
    l = ["new_tab Code", "layout splits", cd]
    if nvim:
        l.append("launch --title nvim --env NC_CODE=1 nvim")
    else:
        l.append(f"launch --title shell {SANS_ACCUEIL}")
    if not seul_nvim:
        droite = "launch --location=vsplit --bias=38 --keep-focus --title "
        if agent:
            droite += shlex.quote(agent) + " " + shlex.quote(MOI) + " --lancer-agent " + shlex.quote(agent)
        else:
            droite += "shell " + SANS_ACCUEIL
        l.append(droite)
        if lazygit:
            cfg = config_lazygit()
            l += ["new_tab Git", cd, "launch --title lazygit " + (f"--env LG_CONFIG_FILE={shlex.quote(cfg)} " if cfg else "") + "lazygit"]
        l += ["new_tab Terminal", cd, "launch --title shell"]
    return "\n".join(l) + "\n"


# L'accueil (fastfetch) est trop large pour le panneau étroit de droite : les shells de l'espace de code démarrent sans
SANS_ACCUEIL = "--env FASTFETCH_SHOWN=1"


def lancer_agent(prog, args):
    """Le programme de l'agent, puis un shell quand il s'arrête (la fenêtre reste ouverte pour la suite). IA coupée
    (IA_MODE=non) : seulement le shell."""
    if shutil.which(prog) and not ia_coupee({}):
        try:
            subprocess.call([prog, *args])
        except OSError:
            pass
    os.environ["FASTFETCH_SHOWN"] = "1"                    # le shell d'après démarre sans l'accueil (panneau étroit)
    sh = os.environ.get("SHELL") or shutil.which("zsh") or shutil.which("bash") or "/bin/sh"
    os.execvp(sh, [sh])


def ouvrir(dossier, agent="", seul_nvim=False):
    kitty = shutil.which("kitty")
    if not kitty:
        print(T("nc-code : kitty est introuvable.", "nc-code: kitty not found."), file=sys.stderr)
        return 1
    texte = session(dossier, agent, seul_nvim, nvim=bool(shutil.which("nvim")), lazygit=bool(shutil.which("lazygit")))
    nom = os.path.basename(dossier.rstrip("/")) or dossier
    p = subprocess.Popen([kitty, "--title", nom, *options_kitty(palette()), "--directory", dossier, "--session", "-"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        p.stdin.write(texte.encode())
        p.stdin.close()
    except OSError:
        pass
    noter_deja_ouvert()
    return 0


# ── Un nouveau projet ───────────────────────────────────────────────────────────────────────────────────────────
MODELES = {
    "vide": {},
    "python": {"main.py": 'def main():\n    print("Bonjour !")\n\n\nif __name__ == "__main__":\n    main()\n',
               ".gitignore": "__pycache__/\n*.pyc\n.venv/\n"},
    "c": {"main.c": '#include <stdio.h>\n\nint main(void)\n{\n    printf("Bonjour !\\n");\n    return 0;\n}\n',
          "Makefile": "CFLAGS ?= -Wall -Wextra -g\n\nmain: main.c\n\t$(CC) $(CFLAGS) -o main main.c\n\nclean:\n\trm -f main\n",
          ".gitignore": "main\n*.o\n"},
    "web": {"index.html": '<!doctype html>\n<html lang="fr">\n<head>\n  <meta charset="utf-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1">\n'
                          '  <title>Ma page</title>\n  <link rel="stylesheet" href="style.css">\n</head>\n<body>\n  <h1>Bonjour !</h1>\n  <script src="script.js"></script>\n</body>\n</html>\n',
            "style.css": "body {\n  font-family: sans-serif;\n  margin: 2rem;\n}\n",
            "script.js": 'console.log("Bonjour !");\n'},
}


def nom_projet(nom):
    """Le nom filtré : lettres, chiffres, « - » et « _ » (accents retirés, espaces en « - »), sans « - » au début, 64 au plus."""
    import unicodedata
    t = unicodedata.normalize("NFKD", str(nom or "")).encode("ascii", "ignore").decode()
    t = re.sub(r"\s+", "-", t.strip())
    t = re.sub(r"[^A-Za-z0-9_-]", "", t).lstrip("-")
    return t[:64]


def dossier_projets():
    """Où vont les nouveaux projets : CODE_DOSSIER (nc-reglages), ~/Projets par défaut."""
    v = os.path.expanduser(reglage("CODE_DOSSIER", "") or "")
    if not v.startswith("/") or not dossier_sur(v):
        v = os.path.join(HOME, "Projets")
    return v.rstrip("/") or "/"


def initialiser_depot(dest):
    """git init en argv, sans modèle de git (aucun hook copié) et sans hooks. Vrai si le dépôt existe ensuite."""
    if shutil.which("git"):
        try:
            subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "init", "-q", "--template=", dest],
                           capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass
    return est_depot(dest)


def creer_projet(nom, modele="vide"):
    """(dossier, '') ou (dossier ou '', message). Refuse un nom vide, un modèle inconnu, un nom déjà pris : rien n'est
    jamais écrasé (mkdir et open « x » échouent si ça existe)."""
    n = nom_projet(nom)
    if not n:
        return "", T("Donne un nom (lettres, chiffres, - et _).", "Give a name (letters, digits, - and _).")
    if modele not in MODELES:
        return "", T(f"Modèle inconnu « {modele} » (vide, python, c, web).", f"Unknown template “{modele}” (vide, python, c, web).")
    base = dossier_projets()
    dest = os.path.join(base, n)
    if os.path.lexists(dest):
        return "", T(f"Le nom « {n} » est déjà pris dans {court(base)}.", f"The name “{n}” is already taken in {court(base)}.")
    try:
        os.makedirs(base, exist_ok=True)
        os.mkdir(dest)
        fichiers = dict(MODELES[modele])
        fichiers["README.md"] = f"# {n}\n\nNouveau projet.\n"
        for f, texte in fichiers.items():
            with open(os.path.join(dest, f), "x", encoding="utf-8") as h:
                h.write(texte)
    except OSError as err:
        return "", T(f"Création impossible : {err.strerror or err}", f"Cannot create: {err.strerror or err}")
    if not initialiser_depot(dest):
        return dest, T("git init n'a pas marché (le projet est créé sans dépôt).", "git init failed (project created without a repository).")
    retenir_projet(dest)
    return dest, ""


def cmd_nouveau(a):
    """nc-code --nouveau NOM [--modele vide|python|c|web] [--sans-agent] [--session-seule] : crée le projet, puis l'ouvre."""
    modele = a[a.index("--modele") + 1] if "--modele" in a and a.index("--modele") + 1 < len(a) else "vide"
    reste = [x for i, x in enumerate(a) if not x.startswith("--") and not (i and a[i - 1] == "--modele")]
    d, msg = creer_projet(reste[0] if reste else "", modele)
    if msg:
        print("nc-code : " + msg, file=sys.stderr)
        if not d:
            return 1
    print(d)
    agent = "" if ("--sans-agent" in a or ia_coupee({})) else agent_par_defaut(etat_ia())
    if "--session-seule" in a:
        sys.stdout.write(session(d, agent, "--nvim" in a, nvim=bool(shutil.which("nvim")), lazygit=bool(shutil.which("lazygit"))))
        return 0
    return ouvrir(d, agent, "--nvim" in a)


# ── Cloner depuis GitHub ────────────────────────────────────────────────────────────────────────────────────────
# Règle de sécurité : on ne clone QUE github.com, par une source validée de façon stricte, vers un dossier qui n'existe
# pas encore ; aucune commande n'est lancée sur un dépôt déjà là ; tout en argv (jamais une ligne de shell).
_NOM_GH = r"[A-Za-z0-9._-]+"


def source_github(src):
    """(propriétaire, dépôt) ou None. Formes acceptées, et seulement elles :
         https://github.com/OWNER/REPO[.git][/]      (schéma https exact, hôte exactement github.com, sans identifiant)
         git@github.com:OWNER/REPO[.git]
         OWNER/REPO
       OWNER et REPO en [A-Za-z0-9._-], jamais « . » ou « .. » (ni que des points), jamais un « - » au début (ce serait une
       option pour git ou gh), 39 et 100 caractères au plus. Refusés : http, ssh://, un autre hôte, github.com@ailleurs,
       un port, une requête ou un fragment (?, #), un chemin en plus (/tree/main), des espaces ou retours à la ligne."""
    if not isinstance(src, str) or src != src.strip() or not src.isascii() or not src.isprintable():
        return None
    m = (re.fullmatch(rf"https://github\.com/({_NOM_GH})/({_NOM_GH})/?", src)
         or re.fullmatch(rf"git@github\.com:({_NOM_GH})/({_NOM_GH})", src)
         or re.fullmatch(rf"({_NOM_GH})/({_NOM_GH})", src))
    if not m:
        return None
    owner, repo = m.group(1), m.group(2)
    if repo.endswith(".git"):
        repo = repo[:-4]
    for x in (owner, repo):
        if not x or x.strip(".") == "" or x.startswith("-"):
            return None
    if len(owner) > 39 or len(repo) > 100:
        return None
    return owner, repo


def gh_connecte():
    """Vrai si gh est installé et connecté (gh auth status : code 0)."""
    if not shutil.which("gh"):
        return False
    try:
        r = subprocess.run(["gh", "auth", "status"], capture_output=True, timeout=15, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def depots_gh():
    """[(propriétaire, dépôt)] de tes dépôts (gh repo list), chaque URL revalidée comme n'importe quelle source."""
    try:
        r = subprocess.run(["gh", "repo", "list", "--json", "name,url", "--limit", "50"], capture_output=True, text=True,
                           timeout=30, stdin=subprocess.DEVNULL, env=dict(os.environ, GH_PROMPT_DISABLED="1"))
        d = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    res = []
    for x in d if isinstance(d, list) else []:
        s = source_github(x.get("url") if isinstance(x, dict) else None)
        if s and x.get("name") == s[1]:
            res.append(s)
    return res


def erreur_clone(sortie):
    t = (sortie or "").lower()
    if "not found" in t or "could not read from remote" in t or "repository does not exist" in t or "does not exist" in t:
        return T("dépôt introuvable (ou privé : connecte-toi avec « gh auth login »).", "repository not found (or private: sign in with “gh auth login”).")
    if "resolve host" in t or "unable to access" in t or "failed to connect" in t or "network is unreachable" in t or "timed out" in t:
        return T("impossible de joindre GitHub (hors ligne ?).", "cannot reach GitHub (offline?).")
    if "already exists" in t:
        return T("le dossier existe déjà.", "the folder already exists.")
    derniere = next((l.strip() for l in reversed((sortie or "").splitlines()) if l.strip()), "")
    derniere = "".join(c for c in derniere if c.isprintable())[:200]
    return derniere or T("le clonage a échoué.", "the clone failed.")


def lancer_clone(cmd, env, delai=1800):
    """Lance le clonage en laissant voir la progression (stderr recopié tel quel) ; (code, fin du texte d'erreur). Arrêté
    au bout de delai secondes, qu'il parle ou non."""
    fin = time.monotonic() + delai
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=env)
    except OSError as err:
        return 127, str(err)
    queue = b""
    import select
    try:
        while True:
            # le délai compte aussi quand rien n'arrive (réseau suspendu : un clone muet n'attend pas sans fin)
            reste = fin - time.monotonic()
            if reste <= 0:
                p.terminate()
                break
            if not select.select([p.stderr], [], [], min(reste, 5))[0]:
                continue
            b = os.read(p.stderr.fileno(), 4096)
            if not b:
                break
            queue = (queue + b)[-4096:]
            try:
                sys.stderr.buffer.write(b)
                sys.stderr.buffer.flush()
            except (OSError, ValueError):
                pass
    except OSError:
        pass
    try:
        code = p.wait(10)
    except subprocess.TimeoutExpired:
        p.kill()
        code = p.wait()
    return code, queue.decode("utf-8", "replace").replace("\r", "\n")


def cloner(src, via_gh=None):
    """(dossier, '') ou ('', message). src : une source acceptée par source_github. Le dossier est base/REPO, qui ne doit
    pas exister (rien n'est lancé sinon, jamais git sur un dépôt déjà là). Sans gh connecté : git clone par https."""
    s = source_github(src)
    if not s:
        return "", T("Source refusée : seulement https://github.com/PROPRIETAIRE/DEPOT, git@github.com:PROPRIETAIRE/DEPOT.git ou PROPRIETAIRE/DEPOT.",
                     "Source refused: only https://github.com/OWNER/REPO, git@github.com:OWNER/REPO.git or OWNER/REPO.")
    owner, repo = s
    base = dossier_projets()
    dest = os.path.join(base, repo)
    if os.path.lexists(dest):
        return "", T(f"{court(dest)} existe déjà : rien n'a été fait.", f"{court(dest)} already exists: nothing was done.")
    try:
        os.makedirs(base, exist_ok=True)
    except OSError as err:
        return "", T(f"Dossier impossible : {err.strerror or err}", f"Cannot create the folder: {err.strerror or err}")
    if via_gh is None:
        via_gh = gh_connecte()
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GH_PROMPT_DISABLED="1")
    # --template= : aucun hook du modèle de git n'est copié ; un clone ne récupère jamais les hooks du dépôt distant.
    # git : -c core.hooksPath=/dev/null vaut pour cette commande seulement. gh : rien après « -- » qui s'écrirait dans
    # .git/config du dépôt cloné (tes futurs hooks, pre-commit ou husky, y seraient ignorés sans prévenir)
    if via_gh:
        cmd = ["gh", "repo", "clone", f"{owner}/{repo}", dest, "--", "--template=", "--progress"]
    else:
        cmd = ["git", "-c", "core.hooksPath=/dev/null", "-c", "protocol.allow=never", "-c", "protocol.https.allow=always",
               "clone", "--progress", "--template=", "--", f"https://github.com/{owner}/{repo}.git", dest]
    if not shutil.which(cmd[0]):
        return "", T(f"{cmd[0]} n'est pas installé.", f"{cmd[0]} is not installed.")
    code, sortie = lancer_clone(cmd, env)
    if code != 0 or not est_depot(dest):
        return "", T("Clonage impossible : ", "Clone failed: ") + erreur_clone(sortie)
    retenir_projet(dest)
    return dest, ""


def choisir_source_clone():
    """Sans source donnée : tes dépôts GitHub (si gh est connecté), ou l'adresse tapée. '' si on renonce."""
    lignes = []
    if gh_connecte():
        lignes = [f"{o}/{r}\t{o}/{r}" for o, r in depots_gh()]
    lignes.append(T("Un autre dépôt (j'écris l'adresse)", "Another repository (I type the address)") + "\t")
    _, ligne = choisir_liste(lignes, T("Numéro : ", "Number: "))
    if not ligne:
        return ""
    if "\t" in ligne and ligne.split("\t", 1)[1]:
        return ligne.split("\t", 1)[1]
    try:
        return input(T("Adresse (https://github.com/…, git@github.com:… ou proprietaire/depot) : ", "Address (https://github.com/…, git@github.com:… or owner/repo): ")).strip()
    except (EOFError, KeyboardInterrupt):
        return ""


def cmd_cloner(a):
    """nc-code --cloner [SOURCE] [--sans-agent] [--nvim] [--session-seule] : clone puis ouvre l'espace de code. Sans terminal
    (lancé par le panneau de l'île) : relancé dans une fenêtre kitty, pour voir la progression."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()) and "--session-seule" not in a and "--ici" not in a:
        kitty = shutil.which("kitty")
        if not kitty:
            print(T("nc-code : kitty est introuvable.", "nc-code: kitty not found."), file=sys.stderr)
            return 1
        subprocess.Popen([kitty, "--class", "nc-code", "--title", T("Cloner depuis GitHub", "Clone from GitHub"), *options_kitty(palette(), True),
                          sys.executable, MOI, "--cloner", "--ici", *[x for x in a if x != "--ici"]],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    reste = [x for x in a if not x.startswith("--")]
    src = reste[0] if reste else choisir_source_clone()
    if not src:
        return 0
    d, msg = cloner(src)
    if msg:
        print("nc-code : " + msg, file=sys.stderr)
        if sys.stdin.isatty():
            try:
                input(T("Entrée pour fermer…", "Press Enter to close…"))
            except (EOFError, KeyboardInterrupt):
                pass
        return 1
    print(d)
    agent = "" if ("--sans-agent" in a or ia_coupee({})) else agent_par_defaut(etat_ia())
    if "--session-seule" in a:
        sys.stdout.write(session(d, agent, "--nvim" in a, nvim=bool(shutil.which("nvim")), lazygit=bool(shutil.which("lazygit"))))
        return 0
    return ouvrir(d, agent, "--nvim" in a)


# ── Les couleurs (celles de l'île) ──────────────────────────────────────────────────────────────────────────────
# Noir Apple si la palette de l'île n'est pas encore écrite (nc-theme-sync la crée au premier thème).
PALETTE_DEFAUT = dict(fond="#1c1c1e", texte="#f5f5f7", texteSec="#98989d", carte="#2c2c2e", carteSurvol="#3a3a3c",
                      gris3="#48484a", gris4="#545458", accent="#0a84ff", surAccent="#ffffff", vert="#30d158",
                      jaune="#ffd60a", orange="#ff9f0a", bleu="#5e5ce6", rose="#ff375f", cyan="#64d2ff", rouge="#ff453a",
                      violet="#bf5af2")


def palette():
    p = dict(PALETTE_DEFAUT)
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    try:
        with open(os.path.join(base, "nc/palette-ile.json"), encoding="utf-8") as f:
            lue = json.load(f)
        p.update({k: v for k, v in lue.items() if k in p and isinstance(v, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", v)})
    except (OSError, ValueError, AttributeError):
        pass
    return p


def options_kitty(p, selecteur=False):
    """Les -o de kitty : onglets arrondis et bordures aux couleurs de l'île ; le sélecteur prend le fond de l'île, en verre."""
    o = dict(tab_bar_edge="top", tab_bar_style="powerline", tab_powerline_style="round", tab_bar_min_tabs="2",
             tab_bar_margin_height="6 2", active_tab_background=p["accent"], active_tab_foreground=p["surAccent"],
             active_tab_font_style="bold", inactive_tab_background=p["carte"], inactive_tab_foreground=p["texteSec"],
             inactive_tab_font_style="normal", active_border_color=p["accent"], inactive_border_color=p["gris3"],
             bell_border_color=p["orange"], window_border_width="1px", draw_minimal_borders="yes", window_padding_width="6",
             inactive_text_alpha="0.8")
    if selecteur:
        o = dict(background=p["fond"], foreground=p["texte"], background_opacity="0.9", window_padding_width="0",
                 cursor_shape="beam", confirm_os_window_close="0", remember_window_size="no")
    r = []
    for k, v in o.items():
        r += ["-o", f"{k}={v}"]
    return r


# ── Ce que montre chaque projet, sans lancer git (fichiers de .git lus directement) ───────────────────────────
def lire_borne(chemin, n, fin=False):
    """Au plus n octets d'un fichier ORDINAIRE (les n derniers si fin) ; b'' sinon. La liste contient des dépôts trouvés
    sur le disque (une archive extraite) : un .git/logs/HEAD en lien vers /dev/zero se lirait sans fin, un FIFO
    bloquerait l'ouverture, un README en lien montrerait un autre fichier. Ouvert sans suivre de lien et sans bloquer."""
    try:
        fd = os.open(chemin, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return b""
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return b""
        debut = max(0, st.st_size - n) if fin else 0
        morceaux, total = [], 0
        while total < n:
            m = os.pread(fd, min(65536, n - total), debut + total)
            if not m:
                break
            morceaux.append(m)
            total += len(m)
        return b"".join(morceaux)
    except OSError:
        return b""
    finally:
        os.close(fd)


def imprimable(t):
    """Seulement l'imprimable : pas d'inversion du sens (U+202E) ni de caractère de contrôle dans un texte venu d'un dépôt."""
    return "".join(c for c in t if c.isprintable())


def dossier_git(d):
    g = os.path.join(d, ".git")
    if os.path.isfile(g):                                        # copie de travail : « gitdir: … »
        l = lire_borne(g, 4096).decode("utf-8", "replace").strip()
        if l.startswith("gitdir:"):
            return os.path.normpath(os.path.join(d, l[7:].strip()))
        return ""
    return g


def infos_projet(d):
    """{branche, quand (horodatage), message (du dernier commit, d'après le reflog)}."""
    g = dossier_git(d)
    r = dict(branche="", quand=0.0, message="")
    if not g:
        return r
    h = lire_borne(os.path.join(g, "HEAD"), 512).decode("utf-8", "replace").strip()
    r["branche"] = imprimable(h[16:] if h.startswith("ref: refs/heads/") else h[:7])[:120]
    # Une date dans le futur (archive préparée pour passer en tête de liste) ne compte pas
    limite = time.time() + 60
    for f in ("index", "logs/HEAD", "HEAD"):
        try:
            t = os.stat(os.path.join(g, f), follow_symlinks=False).st_mtime
        except OSError:
            continue
        if t <= limite:
            r["quand"] = max(r["quand"], t)
    derniere = lire_borne(os.path.join(g, "logs/HEAD"), 4096, fin=True).decode("utf-8", "replace").rstrip("\n").rsplit("\n", 1)[-1]
    msg = derniere.split("\t", 1)[1] if "\t" in derniere else ""
    if msg.startswith("commit") and ": " in msg:
        r["message"] = imprimable(msg.split(": ", 1)[1])[:300]
    return r


# Le langage d'un projet, d'après un fichier à sa racine (quelques stat, rien n'est lu) : son nom et sa couleur
LANGAGES = (("Cargo.toml", "Rust", "orange"), ("go.mod", "Go", "cyan"), ("package.json", "JavaScript", "jaune"),
            ("pyproject.toml", "Python", "bleu"), ("setup.py", "Python", "bleu"), ("requirements.txt", "Python", "bleu"),
            ("CMakeLists.txt", "C/C++", "vert"), ("meson.build", "C/C++", "vert"), ("pom.xml", "Java", "rouge"),
            ("build.gradle", "Java", "rouge"), ("build.gradle.kts", "Kotlin", "violet"), ("Gemfile", "Ruby", "rouge"),
            ("composer.json", "PHP", "violet"), ("mix.exs", "Elixir", "violet"), ("pubspec.yaml", "Dart", "cyan"),
            ("init.lua", "Lua", "bleu"), ("stylua.toml", "Lua", "bleu"), ("install.sh", "Shell", "vert"))


def langage(d):
    for f, nom, couleur in LANGAGES:
        if os.path.exists(os.path.join(d, f)):
            if nom == "JavaScript" and os.path.exists(os.path.join(d, "tsconfig.json")):
                return "TypeScript", "bleu"
            return nom, couleur
    return "", "gris4"


def url_github(url):
    """L'URL https du dépôt sur GitHub, ou '' : l'origine doit être sur github.com (https, http, git@, ssh://), avec un
    propriétaire et un nom de dépôt simples (lettres, chiffres, « -_. »). Jamais un autre hôte, jamais un chemin bizarre."""
    m = re.fullmatch(r"(?:https?://(?:[\w.-]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)"
                     r"([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?", url or "")
    if not m or m.group(1).strip(".") == "" or m.group(2).strip(".") == "":
        return ""
    return f"https://github.com/{m.group(1)}/{m.group(2)}"


def origine_github(d):
    """L'URL https du dépôt sur GitHub d'après l'origine (.git/config, lu sans git) ; '' sans origine, ou ailleurs."""
    g = dossier_git(d)
    if not g:
        return ""
    texte = lire_borne(os.path.join(g, "config"), 65536).decode("utf-8", "replace")
    section = ""
    for l in texte.splitlines():
        s = l.strip()
        if s.startswith("["):
            section = s
        elif section == '[remote "origin"]' and s.startswith("url") and "=" in s:
            return url_github(s.split("=", 1)[1].strip())
    return ""


def commits_reflog(g, n=5):
    """Les n derniers commits d'après .git/logs/HEAD (sans git), du plus récent au plus ancien : [{message, quand}] ;
    None sans reflog, [] s'il n'y a pas de commit dedans (dépôt tout juste cloné : seul « clone » y est)."""
    if not os.path.lexists(os.path.join(g, "logs/HEAD")):
        return None
    lignes = lire_borne(os.path.join(g, "logs/HEAD"), 65536, fin=True).decode("utf-8", "replace").splitlines()
    res = []
    for l in reversed(lignes):
        if "\t" not in l:
            continue
        entete, msg = l.split("\t", 1)
        if not re.match(r"commit( \((initial|amend|merge)\))?: ", msg):
            continue
        champs = entete.split()
        quand = int(champs[-2]) if len(champs) >= 2 and champs[-2].isdigit() else 0
        res.append(dict(message=imprimable(msg.split(": ", 1)[1])[:300], quand=quand))
        if len(res) >= n:
            break
    return res


def texte_brut(t):
    """Un début de README lisible en texte brut : sans balises, images, liens, dièses de titres ni étoiles ; lignes vides,
    tableaux et séparateurs retirés ; seulement de l'imprimable."""
    t = re.sub(r"<[^>\n]{0,200}>", "", t)
    t = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", t)
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", t)
    t = re.sub(r"^\s{0,3}#{1,6}\s*", "", t, flags=re.M)
    t = t.replace("`", "").replace("*", "")
    lignes = [l.rstrip() for l in t.splitlines()]
    lignes = [l for l in lignes if l.strip() and not l.strip().startswith(("|", "---", "===", "<!--", "[!["))]
    return "\n".join("".join(c for c in l if c.isprintable()) for l in lignes)


def lire_readme(d, n=1200):
    try:
        noms = sorted(os.listdir(d))
    except OSError:
        return ""
    for nom in noms:
        p = os.path.join(d, nom)
        # un README en lien (vers ~/.ssh…) n'est jamais lu : lire_borne ne suit pas les liens
        if nom.lower().split(".")[0] == "readme" and not os.path.islink(p) and os.path.isfile(p):
            return texte_brut(lire_borne(p, 8192).decode("utf-8", "replace"))[:n]
    return ""


def projet_json(d, maintenant=None):
    i = infos_projet(d)
    lang, couleur = langage(d)
    return dict(nom=os.path.basename(d.rstrip("/")) or d, chemin=d, court=court(d), branche=i["branche"], quand=i["quand"],
                date=il_y_a(i["quand"], maintenant), message=i["message"], langage=lang, couleur=couleur, github=origine_github(d),
                disque=d in PAR_BALAYAGE)


def liste_json():
    """Tous les projets en JSON, le plus récent en tête (comme le sélecteur), sans lancer git."""
    maintenant = time.time()
    res = [projet_json(d, maintenant) for d in projets()]
    res.sort(key=lambda p: -p["quand"])
    return res


def agents_json():
    e = etat_ia()
    return dict(coupee=ia_coupee(e), defaut=agent_par_defaut(e), agents=[dict(prog=p, nom=n) for p, n in agents_disponibles(e)],
                debutant=not os.path.exists(fichier_deja_ouvert()))


def apercu_json(d):
    """L'aperçu d'un projet pour le panneau de l'île : {chemin, nom, branche, commits, etat, readme, github}, lu dans les
    fichiers de .git, SANS JAMAIS LANCER GIT : la liste contient aussi des dépôts trouvés par le balayage (clonés
    d'ailleurs), et git y exécuterait ce que leur config impose (core.fsmonitor et filtres clean pour status,
    log.showSignature et gpg.program pour log). Les commits viennent du reflog ; etat reste vide (il demanderait git)."""
    d = os.path.realpath(os.path.expanduser(d))
    if not est_depot(d) or not dossier_sur(d):
        return {}
    g = dossier_git(d)
    i = infos_projet(d)
    maintenant = time.time()
    commits = (commits_reflog(g) if g else None) or []
    for c in commits:
        c["date"] = il_y_a(c["quand"], maintenant)
    return dict(chemin=d, nom=os.path.basename(d) or d, branche=i["branche"], commits=commits, etat="",
                readme=lire_readme(d), github=origine_github(d))


def ile_ouvre_panneau():
    """Le panneau de l'île (Super + X, Code.qml) : vrai si « qs -c nc-ile ipc call ile code » a répondu. Faux sans
    Quickshell, île arrêtée (ou trop ancienne), ou NC_CODE_ILE=non : le sélecteur kitty prend le relais."""
    qs = shutil.which("qs")
    if not qs or os.environ.get("NC_CODE_ILE") == "non":
        return False
    try:
        r = subprocess.run([qs, "-c", "nc-ile", "ipc", "call", "ile", "code"], capture_output=True, timeout=4, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def melange(a, b, part):
    """La couleur a mêlée à b (part de a, entre 0 et 1), en #rrggbb."""
    ca, cb = (tuple(int(x.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)) for x in (a, b))
    return "#" + "".join(f"{round(x * part + y * (1 - part)):02x}" for x, y in zip(ca, cb))


def il_y_a(t, maintenant=None):
    if not t:
        return ""
    s = max(0, (maintenant or time.time()) - t)
    if s < 60:
        return T("à l'instant", "just now")
    for duree, fr, en in ((3600, "min", "min"), (86400, "h", "h")):
        if s < duree:
            n = int(s // (duree // (60 if duree == 3600 else 24)))
            return T(f"il y a {n} {fr}", f"{n} {en} ago")
    j = int(s // 86400)
    if j == 1:
        return T("hier", "yesterday")
    if j < 14:
        return T(f"il y a {j} j", f"{j} d ago")
    if j < 60:
        return T(f"il y a {j // 7} sem", f"{j // 7} wk ago")
    if j < 365:
        return T(f"il y a {j // 30} mois", f"{j // 30} mo ago")
    return T(f"il y a {j // 365} an" + ("s" if j >= 730 else ""), f"{j // 365} y ago")


def correspond(filtre, texte):
    """Score de la recherche (plus petit = mieux), None si les lettres n'y sont pas dans l'ordre."""
    if not filtre:
        return 0
    f, t = filtre.lower(), texte.lower()
    if t.startswith(f):
        return 0
    i = t.find(f)
    if i >= 0:
        return 1 + i
    pos = -1
    for c in f:
        pos = t.find(c, pos + 1)
        if pos < 0:
            return None
    return 100 + pos


# ── Le sélecteur ────────────────────────────────────────────────────────────────────────────────────────────────
def choisir_liste(lignes, invite):
    """Sans terminal (entrée redirigée) : une liste numérotée. « 3 », « 3 a » (choisir l'agent) ou « 3 n » (Neovim seul)."""
    for i, l in enumerate(lignes, 1):
        print(f"{i:>3}  {l.split(chr(9))[0]}")
    try:
        rep = input(invite).strip().split()
    except (EOFError, KeyboardInterrupt):
        return "", ""
    if not rep or not rep[0].isdigit() or not 1 <= int(rep[0]) <= len(lignes):
        return "", ""
    touche = {"a": "agent", "n": "nvim"}.get(rep[1].lower() if len(rep) > 1 else "", "")
    return touche, lignes[int(rep[0]) - 1]


def tronque(s, n):
    s = s.replace("\t", " ").replace("\n", " ")
    s = "".join(c for c in s if c.isprintable())
    return s if len(s) <= n else (s[:max(0, n - 1)] + "…" if n > 0 else "")


class Ecran:
    """Une interface plein terminal, façon Spotlight : titre, champ de recherche arrondi, cartes à deux lignes, aide en bas.
    Aucune dépendance (termios) ; rien ne tourne entre deux touches."""

    def __init__(self, p):
        self.p = p
        self.titre = ""
        self.sous_titre = ""
        self.elements = []          # [(clé, ligne 1, à droite, ligne 2, couleur de la pastille)]
        self.filtre = ""
        self.choix = 0
        self.haut = 0
        self.indice = ""
        self.aide = []
        self.vide = ""

    def c(self, nom, fond=False):
        h = self.p.get(nom, nom).lstrip("#")
        return f"\033[{48 if fond else 38};2;{int(h[0:2], 16)};{int(h[2:4], 16)};{int(h[4:6], 16)}m"

    def visibles(self):
        res = []
        for e in self.elements:
            s = correspond(self.filtre, e[1] + " " + e[3])
            if s is not None:
                res.append((s, len(res), e))
        return [e for _, _, e in sorted(res, key=lambda x: (x[0], x[1]))]

    def dessiner(self, out):
        try:
            w, h = os.get_terminal_size(out.fileno())
        except OSError:
            w, h = 100, 30
        m = 3 if w >= 50 else 1
        larg = max(10, w - 2 * m)
        R = "\033[0m"
        fond = self.c("fond", True)
        txt, sec, acc = self.c("texte"), self.c("texteSec"), self.c("accent")
        lignes = []

        def ligne(contenu="", fd=fond):                         # fd : le fond du contenu ; les marges gardent celui de l'île
            lignes.append(fond + " " * m + fd + contenu + fond + "\033[K" + R)

        ligne()
        droite = tronque(self.sous_titre, max(0, larg - len(self.titre) - 2))
        ligne("\033[1m" + txt + self.titre + "\033[22m" + " " * max(1, larg - len(self.titre) - len(droite)) + sec + droite)
        ligne()
        bord = self.c("accent" if self.filtre else "gris4")
        champ = self.filtre if self.filtre else self.indice
        champ = tronque(champ, larg - 7)
        ligne(bord + "╭" + "─" * (larg - 2) + "╮")
        ligne(bord + "│" + " " + acc + "› " + (txt if self.filtre else sec) + champ + txt + ("▏" if self.filtre else "")
              + " " * max(0, larg - 6 - len(champ) - (1 if self.filtre else 0)) + " " + bord + "│")
        ligne(bord + "╰" + "─" * (larg - 2) + "╯")
        ligne()
        vis = self.visibles()
        self.choix = min(self.choix, max(0, len(vis) - 1))
        place = max(1, (h - len(lignes) - 3) // 2)
        if self.choix < self.haut:
            self.haut = self.choix
        if self.choix >= self.haut + place:
            self.haut = self.choix - place + 1
        if not vis:
            ligne(sec + tronque(self.vide, larg))
        for i, (_, l1, dr, l2, pastille) in enumerate(vis[self.haut:self.haut + place], self.haut):
            sel = i == self.choix
            fd = self.c(melange(self.p["accent"], self.p["fond"], 0.16), True) if sel else fond
            dr = tronque(dr, max(0, larg // 2 - 4))
            t1 = tronque(l1, larg - 6 - len(dr))
            t2 = tronque(l2, larg - 6)
            barre = (acc + "▎") if sel else " "
            ligne(fd + barre + " " + self.c(pastille) + "● " + "\033[1m" + txt + t1 + "\033[22m"
                  + " " * max(1, larg - 5 - len(t1) - len(dr)) + sec + dr + " ", fd)
            ligne(fd + barre + "   " + sec + t2 + " " * max(0, larg - 4 - len(t2)), fd)
        while len(lignes) < h - 1:
            ligne()
        aide = self.aide
        while aide and sum(len(k) + len(v) + 6 for k, v in aide) > larg:
            aide = aide[:-1]
        touche = self.c("carteSurvol", True)
        bas = "   ".join(touche + txt + " " + k + " " + fond + " " + sec + v for k, v in aide)
        lignes = lignes[:h - 1]
        lignes.append(fond + " " * m + bas + fond + "\033[K" + R)
        out.write("\033[H" + "\r\n".join(lignes) + R)
        out.flush()
        return vis


def lire_touche(fd):
    """Une touche : 'haut', 'bas', 'entree', 'alt-entree', 'agent', 'echap', 'efface', 'debut', 'fin', ou le texte tapé."""
    import select
    b = os.read(fd, 64)
    if not b:
        return "echap"
    if b == b"\x1b":
        r, _, _ = select.select([fd], [], [], 0.04)
        if r:
            b += os.read(fd, 64)
    seq = {b"\x1b[A": "haut", b"\x1bOA": "haut", b"\x10": "haut", b"\x1b[B": "bas", b"\x1bOB": "bas", b"\x0e": "bas",
           b"\r": "entree", b"\n": "entree", b"\x1b\r": "alt-entree", b"\x1b\n": "alt-entree", b"\x01": "agent",
           b"\t": "agent", b"\x1b": "echap", b"\x03": "echap", b"\x04": "echap", b"\x7f": "efface", b"\x08": "efface",
           b"\x15": "vide", b"\x1b[5~": "page-haut", b"\x1b[6~": "page-bas", b"\x1b[H": "debut", b"\x1b[F": "fin"}
    if b in seq:
        return seq[b]
    if b.startswith(b"\x1b"):
        return ""
    t = b.decode("utf-8", "ignore")
    return "".join(c for c in t if c.isprintable())


def interface(fn):
    """fn(entree, sortie) dans l'écran alterné, touches brutes ; le terminal est toujours rendu tel quel."""
    import signal
    import termios
    import tty
    fd = sys.stdin.fileno()
    avant = termios.tcgetattr(fd)
    out = sys.stdout
    out.write("\033[?1049h\033[?25l\033[?7l")
    try:
        tty.setraw(fd)
        signal.signal(signal.SIGWINCH, lambda *_: None)          # réveille os.read : on redessine
        return fn(fd, out)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, avant)
        out.write("\033[?7h\033[?25h\033[?1049l")
        out.flush()


def boucle(fd, out, e):
    """Fait tourner l'écran e ; (touche, clé), ou None si on le ferme (Échap)."""
    while True:
        vis = e.dessiner(out)
        try:
            k = lire_touche(fd)
        except InterruptedError:
            continue
        if k == "echap":
            if e.filtre:
                e.filtre, e.choix = "", 0
                continue
            return None
        if k in ("entree", "alt-entree", "agent"):
            if vis:
                return {"entree": "", "alt-entree": "nvim", "agent": "agent"}[k], vis[e.choix][0]
        elif k == "haut":
            e.choix = max(0, e.choix - 1)
        elif k == "bas":
            e.choix = min(len(vis) - 1, e.choix + 1)
        elif k == "page-haut":
            e.choix = max(0, e.choix - 5)
        elif k == "page-bas":
            e.choix = min(len(vis) - 1, e.choix + 5)
        elif k == "debut":
            e.choix = 0
        elif k == "fin":
            e.choix = len(vis) - 1
        elif k == "efface":
            e.filtre, e.choix = e.filtre[:-1], 0
        elif k == "vide":
            e.filtre, e.choix = "", 0
        elif k:
            e.filtre, e.choix = e.filtre + k, 0


def ecran_projets(p, dossiers):
    e = Ecran(p)
    e.titre = T("Espace de code", "Code workspace")
    e.sous_titre = T(f"{len(dossiers)} projet" + ("s" if len(dossiers) > 1 else ""), f"{len(dossiers)} project" + ("s" if len(dossiers) > 1 else ""))
    e.indice = T("Rechercher un projet…", "Search a project…")
    e.vide = T("Aucun projet ne correspond.", "No matching project.")
    e.aide = [(T("Entrée", "Enter"), T("ouvrir", "open")), ("Tab", T("choisir l'agent", "pick the agent")),
              (T("Alt+Entrée", "Alt+Enter"), T("Neovim seul", "Neovim only")), (T("Échap", "Esc"), T("fermer", "close"))]
    maintenant = time.time()
    infos = {d: infos_projet(d) for d in dossiers}
    for d in sorted(dossiers, key=lambda d: -infos[d]["quand"]):         # le plus récent en haut
        i = infos[d]
        nom = os.path.basename(d.rstrip("/")) or d
        lang, couleur = langage(d)
        droite = "  ·  ".join(x for x in (lang, i["branche"], il_y_a(i["quand"], maintenant)) if x)
        bas = court(d) + ("  ·  " + i["message"] if i["message"] else "")
        e.elements.append((d, nom, droite, bas, couleur))
    return e


def ecran_agents(p, dossier, agents):
    e = Ecran(p)
    e.titre = T("Quel agent ?", "Which agent?")
    e.sous_titre = os.path.basename(dossier.rstrip("/"))
    e.indice = T("Rechercher…", "Search…")
    e.vide = T("Rien ne correspond.", "Nothing matches.")
    e.aide = [(T("Entrée", "Enter"), T("ouvrir", "open")), (T("Échap", "Esc"), T("retour", "back"))]
    for prog, nom in agents:
        e.elements.append((prog, nom, "", prog, "accent"))
    e.elements.append(("", T("Un terminal, sans agent", "A terminal, no agent"), "", T("Neovim et un shell", "Neovim and a shell"), "gris4"))
    return e


def selecteur():
    dossiers = projets()
    if not dossiers:
        print(T("Aucun dépôt git trouvé (cd dans un projet, puis nc-code .).", "No git repository found (cd into a project, then nc-code .)."))
        return 1
    e = etat_ia()
    agent = agent_par_defaut(e)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        liste = [ligne_projet(d) for d in dossiers]
        touche, ligne = choisir_liste(liste, T("Numéro (3, 3 a = choisir l'agent, 3 n = Neovim seul) : ",
                                                "Number (3, 3 a = pick the agent, 3 n = Neovim only): "))
        if not ligne or "\t" not in ligne:
            return 0
        dossier = ligne.split("\t", 1)[1]
        if touche == "agent":
            options = [f"{n} ({p})\t{p}" for p, n in agents_disponibles(e)] + [T("Un shell, sans agent", "A shell, no agent") + "\t"]
            _, rep = choisir_liste(options, T("Numéro de l'agent : ", "Agent number: "))
            if not rep:
                return 0
            agent = rep.split("\t", 1)[1]
        return ouvrir(dossier, agent, seul_nvim=(touche == "nvim"))
    p = palette()
    projets_e = ecran_projets(p, dossiers)

    def deroule(fd, out):
        while True:
            r = boucle(fd, out, projets_e)
            if r is None:
                return None
            touche, dossier = r
            if touche != "agent":
                return touche, dossier, agent
            choisi = boucle(fd, out, ecran_agents(p, dossier, agents_disponibles(e)))
            if choisi is not None:                               # Échap : retour aux projets
                return "", dossier, choisi[1]

    r = interface(deroule)
    if not r:
        return 0
    touche, dossier, ag = r
    return ouvrir(dossier, ag, seul_nvim=(touche == "nvim"))


def dans_fenetre():
    """Lancé sans terminal (Super + X) : le panneau de l'île s'il tourne ; sinon le sélecteur dans une fenêtre kitty
    flottante (classe nc-code), au fond de l'île."""
    if ile_ouvre_panneau():
        return 0
    kitty = shutil.which("kitty")
    if not kitty:
        return 1
    subprocess.Popen([kitty, "--class", "nc-code", "--title", T("Espace de code", "Code workspace"), *options_kitty(palette(), True),
                      sys.executable, MOI, "--selecteur"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0

def main(a):
    if a and a[0] in ("-h", "--help", "aide"):
        print(__doc__.strip())
        return 0
    if a and a[0] == "--lancer-agent" and len(a) > 1:
        lancer_agent(a[1], a[2:])
        return 0
    if a and a[0] == "--liste":
        for d in projets():
            print(ligne_projet(d))
        return 0
    if a and a[0] == "--liste-json":
        print(json.dumps(liste_json(), ensure_ascii=False))
        return 0
    if a and a[0] == "--agents-json":
        print(json.dumps(agents_json(), ensure_ascii=False))
        return 0
    if a and a[0] == "--apercu-json":
        r = apercu_json(a[1]) if len(a) > 1 else {}
        print(json.dumps(r, ensure_ascii=False))
        return 0 if r else 1
    if a and a[0] == "--nouveau":
        return cmd_nouveau(a[1:])
    if a and a[0] == "--cloner":
        return cmd_cloner(a[1:])
    seule = "--session-seule" in a
    seul_nvim = "--nvim" in a
    sans_agent = "--sans-agent" in a
    agent_force = a[a.index("--agent") + 1] if "--agent" in a and a.index("--agent") + 1 < len(a) else ""
    reste = [x for i, x in enumerate(a) if not x.startswith("--") and not (i and a[i - 1] == "--agent")]
    if "--selecteur" in a or (not reste and not seule):
        if "--selecteur" not in a and not (sys.stdin.isatty() and sys.stdout.isatty()):
            return dans_fenetre()
        return selecteur()
    dossier = os.path.realpath(os.path.expanduser(reste[0]))
    if os.path.isdir(dossier) and not dossier_sur(dossier):
        print(T("nc-code : ce nom de dossier contient des caractères qu'une session kitty ne peut pas garder tels quels.",
                "nc-code: this folder name has characters a kitty session cannot keep as they are."), file=sys.stderr)
        return 1
    if not os.path.isdir(dossier):
        print(T(f"nc-code : « {reste[0]} » n'est pas un dossier.", f"nc-code: “{reste[0]}” is not a folder."), file=sys.stderr)
        return 1
    if sans_agent or seul_nvim or ia_coupee({}):           # IA coupée : pas d'agent, même demandé par --agent
        agent = ""
    else:
        agent = agent_force or agent_par_defaut(etat_ia())
    if seule:
        sys.stdout.write(session(dossier, agent, seul_nvim, nvim=bool(shutil.which("nvim")), lazygit=bool(shutil.which("lazygit"))))
        return 0
    return ouvrir(dossier, agent, seul_nvim)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
