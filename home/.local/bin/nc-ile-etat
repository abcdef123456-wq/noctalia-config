#!/usr/bin/env bash
# nc-ile-etat : état du système en lignes « clé=valeur », lu par l'île dynamique (plugin Noctalia nc/ile).
#   nc-ile-etat          tout (centre de contrôle)
#   nc-ile-etat media    seulement la musique (pilule)
#   nc-ile-etat sans-media  tout sauf la musique (l'île Quickshell ne lit aucune clé media_* : pas de playerctl ni de
#                        téléchargement de pochette toutes les 2 s)
#   nc-ile-etat wifi     réseaux Wi-Fi :      net=actif<TAB>nom<TAB>signal<TAB>sécurité<TAB>connu
#   nc-ile-etat bt       appareils Bluetooth : bt=adresse<TAB>nom<TAB>connecté<TAB>icône<TAB>associé
#   nc-ile-etat son      sorties / entrées :  sortie=id<TAB>nom<TAB>défaut   entree=id<TAB>nom<TAB>défaut
#   nc-ile-etat systeme  processeur, mémoire, température, disque, allumage, santé de la batterie, écrans
#   nc-ile-etat jeu      page Mode jeu : processeur (charge, température), carte graphique (nom, charge, température,
#                        watts) ; une carte NVIDIA en veille n'est pas réveillée pour ça (gpu=veille)
#   nc-ile-etat sante    page Santé : charge et programme le plus gourmand, températures (processeur, carte graphique,
#                        SSD, mémoire, Wi-Fi), ventilateurs, profil du firmware (voir sante() plus bas)
#   nc-ile-etat capteurs une fois au démarrage de l'île : fichier de la température du processeur, constructeur, et
#                        s'il y a des capteurs à montrer (sinon, ni page Santé ni veille de surchauffe)
# Pochettes distantes (http) mises en cache dans ~/.cache/nc/pochettes.
media() {
  local m art cache n f
  # Le lecteur : le dernier actif selon playerctld (comme nc-verrou-media et les touches de musique) ; sans lui, playerctl choisit
  n="$(busctl --user get-property org.mpris.MediaPlayer2.playerctld /org/mpris/MediaPlayer2 \
        com.github.altdesktop.playerctld PlayerNames 2>/dev/null |
       sed -n 's/^[^"]*"\(org\.mpris\.MediaPlayer2\.\)\{0,1\}\([^"]*\)".*/\2/p;T;q')"
  local pc=(playerctl); [ -z "$n" ] || pc+=(-p "$n")
  # La position (µs) vient avec le reste, en dernier champ : un seul playerctl
  m="$(timeout 3 "${pc[@]}" metadata --format $'{{status}}\x1f{{title}}\x1f{{artist}}\x1f{{mpris:artUrl}}\x1f{{mpris:length}}\x1f{{playerName}}\x1f{{position}}' 2>/dev/null | head -1)"
  [ -n "$m" ] || { echo "media=0"; return; }
  # \x1f et non une tabulation : read fusionne les tabulations vides (titre sans artiste = tout décalé)
  IFS=$'\x1f' read -r st titre artiste art duree joueur position <<<"$m"
  case "$art" in
    file://*) art="$(printf '%b' "${art#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g' | xargs -0 printf '%b' 2>/dev/null)" ;;
    http*://*)
      cache="$HOME/.cache/nc/pochettes/$(printf '%s' "$art" | md5sum | cut -c1-16).img"
      if [ ! -s "$cache" ]; then
        mkdir -p "${cache%/*}"
        # Un échec est retenu 5 minutes (hors ligne, 404, lien expiré) : pas de curl bloquant à chaque appel. L'adresse
        # vient d'un lecteur (une page web) : seulement http(s), et pas plus de 5 Mo
        if [ -z "$(find "$cache.echec" -mmin -5 2>/dev/null)" ]; then
          if curl -fsSL -m 3 --proto =http,https --max-filesize 5M -o "$cache.tmp" "$art" 2>/dev/null && [ -s "$cache.tmp" ]; then
            mv -f "$cache.tmp" "$cache"; rm -f "$cache.echec"
          else
            rm -f "$cache.tmp"; : > "$cache.echec"
          fi
          # Garde les 50 dernières pochettes (même ménage que nc-verrou-media)
          f="${cache%/*}"
          find "$f" -name '*.echec' -mmin +5 -delete 2>/dev/null
          ls -1t "$f" 2>/dev/null | grep -v '\.lock$' | tail -n +51 | sed "s|^|$f/|" | xargs -r rm -f
        fi
      fi
      art="$cache" ;;
    *) art="" ;;
  esac
  [ -n "$art" ] && [ -r "$art" ] || art=""
  echo "media=1"
  echo "media_etat=$st"
  echo "media_titre=$titre"
  echo "media_artiste=$artiste"
  echo "media_pochette=$art"
  echo "media_duree=${duree:-0}"
  case "${position:-0}" in *[!0-9]*) position=0 ;; esac
  echo "media_position=$(( ${position:-0} / 1000000 ))"
  echo "media_joueur=$joueur"
}

wifi() {
  local connus
  connus="$(timeout 3 nmcli -t -f NAME,TYPE con show 2>/dev/null | sed -n 's/:802-11-wireless$//p' | sed 's/\\:/:/g')"
  # Un même nom peut venir de plusieurs bornes (2,4 et 5 GHz) : une seule ligne par nom, active si l'une l'est,
  # avec le meilleur signal.
  timeout 3 nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | sed 's/\\:/\x1f/g' |
    awk -F: -v connus="$connus" 'BEGIN { n = split(connus, c, "\n"); for (i = 1; i <= n; i++) k[c[i]] = 1 }
      { gsub("\x1f", ":", $2); if ($2 == "") next
        if (!($2 in sig)) ordre[++m] = $2
        if ($1 == "*") act[$2] = 1
        if ($3 + 0 > sig[$2] + 0) sig[$2] = $3
        if ($4 != "") sec[$2] = 1 }
      END { for (i = 1; i <= m; i++) { s = ordre[i]
        printf "net=%s\t%s\t%s\t%s\t%s\n", (s in act ? 1 : 0), s, sig[s], (s in sec ? "1" : ""), ((s in k) ? 1 : 0) } }'
}

bt() {
  # Tous les appareils connus (associés ou vus pendant une recherche) : bt=adresse, nom, connecté, icône, associé
  local mac nom info
  timeout 3 bluetoothctl devices 2>/dev/null | while read -r _ mac nom; do
    info="$(timeout 3 bluetoothctl info "$mac" 2>/dev/null)"
    printf 'bt=%s\t%s\t%s\t%s\t%s\n' "$mac" "$nom" \
      "$(grep -q 'Connected: yes' <<<"$info" && echo 1 || echo 0)" "$(sed -n 's/^\s*Icon: //p' <<<"$info" | head -1)" \
      "$(grep -q 'Paired: yes' <<<"$info" && echo 1 || echo 0)"
  done
}

son() {
  timeout 3 wpctl status 2>/dev/null | awk '
    /^Audio/ { audio = 1 } /^Video/ { audio = 0 }
    audio && /Sinks:/ { s = "sortie"; next } audio && /Sources:/ { s = "entree"; next }
    audio && /(Filters|Streams|Devices):/ { s = ""; next }
    s != "" && match($0, /[0-9]+\. /) {
      def = ($0 ~ /\*[ \t]+[0-9]+\./) ? 1 : 0
      id = substr($0, RSTART, RLENGTH - 2); nom = substr($0, RSTART + RLENGTH)
      sub(/[ \t]*\[vol:.*$/, "", nom); sub(/[ \t]+$/, "", nom)
      printf "%s=%s\t%s\t%s\n", s, id, nom, def }'
}

# Température du processeur (millièmes de degré) : un capteur du processeur d'abord (coretemp, k10temp, zenpower,
# cpu_thermal), où qu'il soit dans la liste ; acpitz seulement s'il n'y en a aucun. Sur bien des cartes mères de PC
# fixe, acpitz arrive en premier (hwmon0) avec une valeur ambiante ou fictive (16 °C) : issue #33.
# NC_HWMON_DIR : autre dossier que /sys/class/hwmon (tests).
temperature_cpu() {
  local f
  f="$(fichier_temperature_cpu)"
  [ -n "$f" ] && cat "$f" 2>/dev/null
}
# Le fichier de cette température (la veille de surchauffe de l'île le relit elle-même, sans processus : Chaleur.qml)
fichier_temperature_cpu() {
  local h repli=""
  for h in "${NC_HWMON_DIR:-/sys/class/hwmon}"/hwmon*; do
    case "$(cat "$h/name" 2>/dev/null)" in
      k10temp|coretemp|zenpower|cpu_thermal) [ -r "$h/temp1_input" ] && { echo "$h/temp1_input"; return; } ;;
      acpitz) [ -z "$repli" ] && [ -r "$h/temp1_input" ] && repli="$h/temp1_input" ;;
    esac
  done
  [ -n "$repli" ] && echo "$repli"
}

# Page Santé de l'île (Sante.qml) et veille de surchauffe (Chaleur.qml). NC_HWMON_DIR, NC_SYSFS : faux dossiers (tests).
#   nc-ile-etat capteurs  une fois au démarrage de l'île : cpu=<fichier de la température du processeur>,
#                         fabricant=<constructeur, DMI>, capteurs=1 s'il y a au moins une température ou un ventilateur
#                         à montrer (sans cette ligne, la page Santé n'existe pas et rien ne tourne)
capteurs() {
  local h f n
  f="$(fichier_temperature_cpu)"
  [ -n "$f" ] && echo "cpu=$f"
  for h in "${NC_HWMON_DIR:-/sys/class/hwmon}"/hwmon*; do
    for f in "$h"/temp[0-9]*_input "$h"/fan[0-9]*_input; do [ -r "$f" ] && { echo "capteurs=1"; break 2; }; done
  done
  n="$(cat "${NC_SYSFS:-/sys}/class/dmi/id/sys_vendor" 2>/dev/null)"
  [ -n "$n" ] && echo "fabricant=$n"
}

#   nc-ile-etat sante     toutes les 2 s tant que la page Santé est affichée :
#     cpu=<charge %>              top=<programme>\t<% du processeur>   (le plus gourmand sur 0,4 s, s'il pèse)
#     temp=<id>\t<°C>\t<°C max>   id : cpu, gpu (carte NVIDIA réveillée seulement : jamais sortie de veille pour ça,
#                                 gpu=veille sinon ; AMD : amdgpu), ssd (nvme), ram (spd5118, jc42), wifi, carte (acpitz)
#     fan=<n°>\t<tr/min>\t<max>   chaque ventilateur de hwmon (yogafan, lenovo_wmi_other, asus, dell, thinkpad, nct…)
#     profil_firmware=<platform_profile du noyau : balanced, performance, max-power, custom…>
# Un PC sans capteur n'écrit que cpu= : la page n'a alors rien à montrer (elle n'existe pas, voir capteurs).
sante() {
  local u n s i w x y z t1 i1 t2 i2 avant h nom f t max id d v num=0 wmi=0 fichier_cpu="" ram="" ram_max=""
  read -r _ u n s i w x y z _ < /proc/stat; t1=$((u + n + s + i + w + x + y + z)); i1=$((i + w))
  # Ticks de chaque programme (utime + stime), pour trouver le plus gourmand ; un programme disparu entre les deux
  # lectures est ignoré (awk se plaint sur stderr, rien d'autre)
  avant="$(awk '{ p = FILENAME; sub(/^.*\/proc\//, "", p); sub(/\/stat$/, "", p); r = $0; sub(/^.*\) /, "", r); split(r, a, " "); print p, a[12] + a[13] }' /proc/[0-9]*/stat 2>/dev/null)"
  sleep 0.4
  read -r _ u n s i w x y z _ < /proc/stat; t2=$((u + n + s + i + w + x + y + z)); i2=$((i + w))
  [ "$t2" -gt "$t1" ] && echo "cpu=$(( (100 * ((t2 - t1) - (i2 - i1))) / (t2 - t1) ))"
  awk -v total="$((t2 - t1))" 'NR == FNR { a[$1] = $2; next }
    { p = FILENAME; sub(/^.*\/proc\//, "", p); sub(/\/stat$/, "", p); if (!(p in a)) next
      c = $0; sub(/^[^(]*\(/, "", c); sub(/\)[^)]*$/, "", c)
      r = $0; sub(/^.*\) /, "", r); split(r, b, " "); d = b[12] + b[13] - a[p]
      if (d > m) { m = d; nom = c } }
    END { if (total > 0 && m * 100 / total >= 3) printf "top=%s\t%d\n", nom, m * 100 / total }' <(printf '%s\n' "$avant") /proc/[0-9]*/stat 2>/dev/null
  # Températures : le processeur par la même règle que partout (capteur du processeur avant acpitz)
  f="$(fichier_temperature_cpu)"
  if [ -n "$f" ]; then
    t="$(cat "$f" 2>/dev/null)"; max="$(cat "${f%_input}_crit" 2>/dev/null || cat "${f%_input}_max" 2>/dev/null)"
    [ -n "$t" ] && { printf 'temp=cpu\t%s\t%s\n' "$((t / 1000))" "${max:+$((max / 1000))}"; fichier_cpu=$f; }
  fi
  for h in "${NC_HWMON_DIR:-/sys/class/hwmon}"/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = lenovo_wmi_other ] && wmi=1
  done
  for h in "${NC_HWMON_DIR:-/sys/class/hwmon}"/hwmon*; do
    nom="$(cat "$h/name" 2>/dev/null)"
    case "$nom" in
      nvme) id=ssd ;;
      spd5118|jc42) id=ram ;;
      amdgpu) id=gpu ;;
      acpitz) [ "$h/temp1_input" != "$fichier_cpu" ] && id=carte || id="" ;;   # déjà pris comme processeur (repli) : pas deux fois
      mt7[0-9]*_phy*|iwlwifi*|ath1[0-9]k*|rtw*|brcmfmac*|phy[0-9]*) id=wifi ;;
      *) id="" ;;
    esac
    if [ -n "$id" ] && [ -r "$h/temp1_input" ]; then
      t="$(cat "$h/temp1_input" 2>/dev/null)"; max="$(cat "$h/temp1_crit" 2>/dev/null || cat "$h/temp1_max" 2>/dev/null)"
      if [ -n "$t" ]; then
        if [ "$id" = ram ]; then
          # Plusieurs barrettes : la plus chaude, une seule ligne
          if [ -z "$ram" ] || [ "$t" -gt "$ram" ]; then ram=$t; fi
          [ -n "$max" ] && ram_max=$max
        elif ! [[ " $d " == *" $id "* ]]; then
          d="$d $id"; printf 'temp=%s\t%s\t%s\n' "$id" "$((t / 1000))" "${max:+$((max / 1000))}"
        fi
      fi
    fi
    # Ventilateurs ; sur un Lenovo Legion, yogafan et lenovo_wmi_other donnent les mêmes (seul le second a le maximum)
    [ "$nom" = yogafan ] && [ "$wmi" = 1 ] && continue
    for f in "$h"/fan[0-9]*_input; do
      [ -r "$f" ] || continue
      v="$(cat "$f" 2>/dev/null)"; case "$v" in ''|*[!0-9]*) continue ;; esac
      max="$(cat "${f%_input}_max" 2>/dev/null)"; case "$max" in *[!0-9]*) max="" ;; esac
      num=$((num + 1)); printf 'fan=%s\t%s\t%s\n' "$num" "$v" "$max"
    done
  done
  [ -n "$ram" ] && printf 'temp=ram\t%s\t%s\n' "$((ram / 1000))" "${ram_max:+$((ram_max / 1000))}"
  # Carte NVIDIA : seulement si elle est déjà réveillée (nvidia-smi la sortirait de veille), 3 s au plus
  if [[ " $d " != *" gpu "* ]]; then
    for v in "${NC_SYSFS:-/sys}"/bus/pci/drivers/nvidia/0000:*; do
      [ -e "$v" ] || continue
      if [ "$(cat "$v/power/runtime_status" 2>/dev/null)" = suspended ]; then echo "gpu=veille"; break; fi
      t="$(timeout 3 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1)"
      case "$t" in ''|*[!0-9]*) ;; *) printf 'temp=gpu\t%s\t\n' "$t" ;; esac
      break
    done
  fi
  t="$(cat "${NC_SYSFS:-/sys}/firmware/acpi/platform_profile" 2>/dev/null)"
  [ -n "$t" ] && echo "profil_firmware=$t"
}

systeme() {
  local u n s i w x y z t1 i1 t2 i2 temp=""
  read -r _ u n s i w x y z _ < /proc/stat; t1=$((u + n + s + i + w + x + y + z)); i1=$((i + w))
  sleep 0.4
  read -r _ u n s i w x y z _ < /proc/stat; t2=$((u + n + s + i + w + x + y + z)); i2=$((i + w))
  [ "$t2" -gt "$t1" ] && echo "cpu=$(( (100 * ((t2 - t1) - (i2 - i1))) / (t2 - t1) ))"
  echo "cpu_nom=$(sed -n 's/^model name\s*:\s*//p' /proc/cpuinfo | head -1 | sed -E 's/ with .*//; s/\(R\)|\(TM\)//g; s/ +/ /g')"
  awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{ if (t) printf "ram=%d\nram_utilisee=%.1f\nram_totale=%.1f\n", (t-a)*100/t, (t-a)/1048576, t/1048576 }' /proc/meminfo
  temp="$(temperature_cpu)"
  [ -n "$temp" ] && echo "temperature=$((temp / 1000))"
  df -P / 2>/dev/null | awk 'NR==2 { gsub("%","",$5); printf "disque=%s\ndisque_libre=%.0f\n", $5, $4/1048576 }'
  # Durée affichée telle quelle par l'île (« Allumé depuis … ») : dans la langue choisie
  . "$HOME/.local/bin/nc-langue" 2>/dev/null || NC_LANGUE=fr
  if [ "$NC_LANGUE" = en ]; then
    awk '{ s=int($1); h=int(s/3600); m=int((s%3600)/60); if (h>0) printf "allume=%dh %02dm\n", h, m; else printf "allume=%d min\n", m }' /proc/uptime
  else
    awk '{ s=int($1); h=int(s/3600); m=int((s%3600)/60); if (h>0) printf "allume=%d h %02d\n", h, m; else printf "allume=%d min\n", m }' /proc/uptime
  fi
  # Santé de la batterie lissée et cycles (même calcul que l'accueil du terminal : nc-sysinfo sante)
  "$HOME/.local/bin/nc-sysinfo" sante | awk -F'\t' 'NF { print "sante=" $1; if ($2 != "") print "cycles=" $2 }'
  # Protection de la batterie (interrupteur de l'île) : 1, 0 ou absent ; rien si l'utilitaire n'est pas installé
  [ -x /usr/local/bin/nc-limite-charge ] && echo "protection=$(/usr/local/bin/nc-limite-charge etat 2>/dev/null)"
  # Disposition active du clavier principal (nom lisible) et nombre de dispositions : nc-touches disposition-active
  "$HOME/.local/bin/nc-touches" disposition-active 2>/dev/null | awk -F'\t' 'NF { print "clavier_disposition=" $1; print "clavier_nb=" $2 }'
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | "ecran=\(.name)\t\(.width)x\(.height)\t\(.refreshRate | round) Hz\t\(.scale)"' 2>/dev/null
}

jeu() {
  local u n s i w x y z t1 i1 t2 i2 temp="" d v
  read -r _ u n s i w x y z _ < /proc/stat; t1=$((u + n + s + i + w + x + y + z)); i1=$((i + w))
  sleep 0.4
  read -r _ u n s i w x y z _ < /proc/stat; t2=$((u + n + s + i + w + x + y + z)); i2=$((i + w))
  [ "$t2" -gt "$t1" ] && echo "cpu=$(( (100 * ((t2 - t1) - (i2 - i1))) / (t2 - t1) ))"
  temp="$(temperature_cpu)"
  [ -n "$temp" ] && echo "cpu_temp=$((temp / 1000))"
  # NVIDIA : seulement si la carte est déjà réveillée (nvidia-smi la sortirait de veille) ; 3 s au plus pour chaque appel
  for d in /sys/bus/pci/drivers/nvidia/0000:*; do
    [ -e "$d" ] || continue
    if [ "$(cat "$d/power/runtime_status" 2>/dev/null)" = suspended ]; then echo "gpu=veille"; return; fi
    v="$(timeout 3 nvidia-smi --query-gpu=name,utilization.gpu,temperature.gpu,power.draw --format=csv,noheader,nounits 2>/dev/null | head -1)"
    [ -n "$v" ] && echo "$v" | awk -F', ' '{ sub(/^NVIDIA (GeForce )?/, "", $1); printf "gpu_nom=%s\ngpu=%d\ngpu_temp=%d\ngpu_watts=%d\n", $1, $2, $3, $4 }'
    return
  done
  # AMD (carte dédiée ou intégrée) : charge et température lues directement
  for d in /sys/class/drm/card*/device; do
    [ -r "$d/gpu_busy_percent" ] || continue
    echo "gpu=$(cat "$d/gpu_busy_percent")"
    for h in "$d"/hwmon/hwmon*; do [ -r "$h/temp1_input" ] && echo "gpu_temp=$(( $(cat "$h/temp1_input") / 1000 ))" && break; done
    echo "gpu_nom=Radeon"
    return
  done
}

# Noms anglais (nc-island-state media | game | system | wifi | bt | sound) ; les clés écrites restent les mêmes
case "${1:-}" in
  media) media; exit 0 ;;
  sans-media) sans_media=1 ;;
  jeu|game) jeu; exit 0 ;;
  systeme|system) systeme; exit 0 ;;
  sante|health) sante; exit 0 ;;
  capteurs|sensors) capteurs; exit 0 ;;
  wifi) wifi; exit 0 ;;
  bt|bluetooth) bt; exit 0 ;;
  son|sound|audio) son; exit 0 ;;
esac

v="$(timeout 3 wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
echo "volume=$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$v")"
case "$v" in *MUTED*) echo "muet=1" ;; *) echo "muet=0" ;; esac
case "$(timeout 3 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)" in *MUTED*) echo "micro_muet=1" ;; *) echo "micro_muet=0" ;; esac
echo "luminosite=$("$HOME/.local/bin/nc-brightness" get 2>/dev/null)"
echo "wifi=$(noctalia msg wifi-status 2>/dev/null)"
echo "reseau=$(timeout 3 nmcli -t -f NAME,TYPE con show --active 2>/dev/null | grep -v -e ':loopback' -e ':bridge' | head -1 | cut -d: -f1)"
echo "bluetooth=$(noctalia msg bluetooth-status 2>/dev/null)"
echo "dnd=$(noctalia msg notification-dnd-status 2>/dev/null)"
echo "profil=$(gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
  --method org.freedesktop.DBus.Properties.Get net.hadess.PowerProfiles ActiveProfile 2>/dev/null | sed -nE "s/^\(<'([a-z-]+)'>,\)$/\1/p")"
[ -e "${XDG_RUNTIME_DIR:-/tmp}/nc-mode-jeu" ] && echo "jeu=1" || echo "jeu=0"
systemctl --user is-active --quiet nc-pouls && echo "halo=1" || echo "halo=0"
# Éclairage du clavier : niveau/maximum (absent s'il n'y en a pas)
for d in /sys/class/leds/*kbd_backlight*; do
  [ -r "$d/brightness" ] && { echo "clavier=$(cat "$d/brightness")/$(cat "$d/max_brightness")"; break; }
done
for b in /sys/class/power_supply/BAT*; do
  [ -r "$b/capacity" ] || continue
  echo "batterie=$(cat "$b/capacity")"; echo "batterie_etat=$(cat "$b/status")"; break
done
[ -n "${sans_media:-}" ] || media
