#!/usr/bin/env bash
# nc-ile-etat : état du système en lignes « clé=valeur », lu par l'île dynamique (plugin Noctalia nc/ile).
#   nc-ile-etat          tout (centre de contrôle)
#   nc-ile-etat media    seulement la musique (pilule)
#   nc-ile-etat wifi     réseaux Wi-Fi :      net=actif<TAB>nom<TAB>signal<TAB>sécurité<TAB>connu
#   nc-ile-etat bt       appareils Bluetooth : bt=adresse<TAB>nom<TAB>connecté<TAB>icône<TAB>associé
#   nc-ile-etat son      sorties / entrées :  sortie=id<TAB>nom<TAB>défaut   entree=id<TAB>nom<TAB>défaut
#   nc-ile-etat systeme  processeur, mémoire, température, disque, allumage, santé de la batterie, écrans
# Pochettes distantes (http) mises en cache dans ~/.cache/nc/pochettes.
media() {
  local m art cache
  m="$(playerctl metadata --format $'{{status}}\t{{title}}\t{{artist}}\t{{mpris:artUrl}}\t{{mpris:length}}\t{{playerName}}' 2>/dev/null | head -1)"
  [ -n "$m" ] || { echo "media=0"; return; }
  IFS=$'\t' read -r st titre artiste art duree joueur <<<"$m"
  case "$art" in
    file://*) art="$(printf '%b' "${art#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g' | xargs -0 printf '%b' 2>/dev/null)" ;;
    http*://*)
      cache="$HOME/.cache/nc/pochettes/$(printf '%s' "$art" | md5sum | cut -c1-16).img"
      if [ ! -s "$cache" ]; then mkdir -p "${cache%/*}"; curl -fsSL -m 3 -o "$cache" "$art" 2>/dev/null || rm -f "$cache"; fi
      art="$cache" ;;
    *) art="" ;;
  esac
  [ -n "$art" ] && [ -r "$art" ] || art=""
  echo "media=1"
  echo "media_etat=$st"
  echo "media_titre=$titre"
  echo "media_artiste=$artiste"
  echo "media_pochette=$art"
  echo "media_duree=${duree:-0}"
  echo "media_position=$(playerctl position 2>/dev/null | cut -d. -f1)"
  echo "media_joueur=$joueur"
}

wifi() {
  local connus
  connus="$(nmcli -t -f NAME,TYPE con show 2>/dev/null | sed -n 's/:802-11-wireless$//p' | sed 's/\\:/:/g')"
  # Un même nom peut venir de plusieurs bornes (2,4 et 5 GHz) : une seule ligne par nom, active si l'une l'est,
  # avec le meilleur signal.
  nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | sed 's/\\:/\x1f/g' |
    awk -F: -v connus="$connus" 'BEGIN { n = split(connus, c, "\n"); for (i = 1; i <= n; i++) k[c[i]] = 1 }
      { gsub("\x1f", ":", $2); if ($2 == "") next
        if (!($2 in sig)) ordre[++m] = $2
        if ($1 == "*") act[$2] = 1
        if ($3 + 0 > sig[$2] + 0) sig[$2] = $3
        if ($4 != "") sec[$2] = 1 }
      END { for (i = 1; i <= m; i++) { s = ordre[i]
        printf "net=%s\t%s\t%s\t%s\t%s\n", (s in act ? 1 : 0), s, sig[s], (s in sec ? "1" : ""), ((s in k) ? 1 : 0) } }'
}

bt() {
  # Tous les appareils connus (associés ou vus pendant une recherche) : bt=adresse, nom, connecté, icône, associé
  local mac nom info
  bluetoothctl devices 2>/dev/null | while read -r _ mac nom; do
    info="$(bluetoothctl info "$mac" 2>/dev/null)"
    printf 'bt=%s\t%s\t%s\t%s\t%s\n' "$mac" "$nom" \
      "$(grep -q 'Connected: yes' <<<"$info" && echo 1 || echo 0)" "$(sed -n 's/^\s*Icon: //p' <<<"$info" | head -1)" \
      "$(grep -q 'Paired: yes' <<<"$info" && echo 1 || echo 0)"
  done
}

son() {
  wpctl status 2>/dev/null | awk '
    /^Audio/ { audio = 1 } /^Video/ { audio = 0 }
    audio && /Sinks:/ { s = "sortie"; next } audio && /Sources:/ { s = "entree"; next }
    audio && /(Filters|Streams|Devices):/ { s = ""; next }
    s != "" && match($0, /[0-9]+\. /) {
      def = ($0 ~ /\*[ \t]+[0-9]+\./) ? 1 : 0
      id = substr($0, RSTART, RLENGTH - 2); nom = substr($0, RSTART + RLENGTH)
      sub(/[ \t]*\[vol:.*$/, "", nom); sub(/[ \t]+$/, "", nom)
      printf "%s=%s\t%s\t%s\n", s, id, nom, def }'
}

systeme() {
  local u n s i w x y z t1 i1 t2 i2 temp=""
  read -r _ u n s i w x y z _ < /proc/stat; t1=$((u + n + s + i + w + x + y + z)); i1=$((i + w))
  sleep 0.4
  read -r _ u n s i w x y z _ < /proc/stat; t2=$((u + n + s + i + w + x + y + z)); i2=$((i + w))
  [ "$t2" -gt "$t1" ] && echo "cpu=$(( (100 * ((t2 - t1) - (i2 - i1))) / (t2 - t1) ))"
  echo "cpu_nom=$(sed -n 's/^model name\s*:\s*//p' /proc/cpuinfo | head -1 | sed -E 's/ with .*//; s/\(R\)|\(TM\)//g; s/ +/ /g')"
  awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{ if (t) printf "ram=%d\nram_utilisee=%.1f\nram_totale=%.1f\n", (t-a)*100/t, (t-a)/1048576, t/1048576 }' /proc/meminfo
  for h in /sys/class/hwmon/hwmon*; do
    case "$(cat "$h/name" 2>/dev/null)" in k10temp|coretemp|zenpower|cpu_thermal|acpitz) temp="$(cat "$h/temp1_input" 2>/dev/null)"; break ;; esac
  done
  [ -n "$temp" ] && echo "temperature=$((temp / 1000))"
  df -P / 2>/dev/null | awk 'NR==2 { gsub("%","",$5); printf "disque=%s\ndisque_libre=%.0f\n", $5, $4/1048576 }'
  awk '{ s=int($1); h=int(s/3600); m=int((s%3600)/60); if (h>0) printf "allume=%d h %02d\n", h, m; else printf "allume=%d min\n", m }' /proc/uptime
  for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/energy_full_design" ] && echo "sante=$(( $(cat "$b/energy_full") * 100 / $(cat "$b/energy_full_design") ))" && break
    [ -r "$b/charge_full_design" ] && echo "sante=$(( $(cat "$b/charge_full") * 100 / $(cat "$b/charge_full_design") ))" && break
  done
  # Protection de la batterie (interrupteur de l'île) : 1, 0 ou absent ; rien si l'utilitaire n'est pas installé
  [ -x /usr/local/bin/nc-limite-charge ] && echo "protection=$(/usr/local/bin/nc-limite-charge etat 2>/dev/null)"
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | "ecran=\(.name)\t\(.width)x\(.height)\t\(.refreshRate | floor) Hz\t\(.scale)"' 2>/dev/null
}

case "${1:-}" in
  media) media; exit 0 ;;
  systeme) systeme; exit 0 ;;
  wifi) wifi; exit 0 ;;
  bt) bt; exit 0 ;;
  son) son; exit 0 ;;
esac

v="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
echo "volume=$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$v")"
case "$v" in *MUTED*) echo "muet=1" ;; *) echo "muet=0" ;; esac
case "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)" in *MUTED*) echo "micro_muet=1" ;; *) echo "micro_muet=0" ;; esac
echo "luminosite=$("$HOME/.local/bin/nc-brightness" get 2>/dev/null)"
echo "wifi=$(noctalia msg wifi-status 2>/dev/null)"
echo "reseau=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | grep -v -e ':loopback' -e ':bridge' | head -1 | cut -d: -f1)"
echo "bluetooth=$(noctalia msg bluetooth-status 2>/dev/null)"
echo "dnd=$(noctalia msg notification-dnd-status 2>/dev/null)"
echo "profil=$(gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
  --method org.freedesktop.DBus.Properties.Get net.hadess.PowerProfiles ActiveProfile 2>/dev/null | sed -nE "s/^\(<'([a-z-]+)'>,\)$/\1/p")"
[ -e "${XDG_RUNTIME_DIR:-/tmp}/nc-mode-jeu" ] && echo "jeu=1" || echo "jeu=0"
systemctl --user is-active --quiet nc-pouls && echo "halo=1" || echo "halo=0"
for b in /sys/class/power_supply/BAT*; do
  [ -r "$b/capacity" ] || continue
  echo "batterie=$(cat "$b/capacity")"; echo "batterie_etat=$(cat "$b/status")"; break
done
media
