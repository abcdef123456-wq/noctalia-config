#!/usr/bin/env python3
"""nc-keys : tes raccourcis Hyprland, lus en direct (hyprctl binds), avec leur description.

  nc-keys          liste lisible dans le terminal
  nc-keys json     JSON pour la fiche Super + / (plugin Noctalia v5 nc/keys)
Seuls les raccourcis qui ont une description apparaissent. Dans ~/.config/hypr/, une description s'écrit
« Section|Texte » ; sans section, le raccourci va dans « Mes raccourcis » (voir aussi nc-raccourci). Exemple : hl.bind("SUPER + code:28", hl.dsp.exec_cmd("firefox"), { description = "Applis et barre|Navigateur" })
Les raccourcis par code de touche (code:38…) suivent la POSITION des touches : les lettres sont nommées comme sur ta
disposition (fr, be, ch, de ; celle du clavier principal, hyprctl devices), sinon comme sur la disposition US.
"""
import json
import os
import re
import subprocess
import sys

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-keys: your Hyprland shortcuts, read live (hyprctl binds), with their description.

  nc-keys          readable list in the terminal
  nc-keys json     JSON for the Super + / cheat sheet (Noctalia v5 plugin nc/keys)
Only shortcuts that have a description are shown. In ~/.config/hypr/, a description is written
"Section|Text"; without a section, the shortcut goes to "My Shortcuts" (see also nc-shortcut). Example: hl.bind("SUPER + code:28", hl.dsp.exec_cmd("firefox"), { description = "Apps & Bar|Browser" })
Shortcuts by key code (code:38…) follow the POSITION of the keys: letters are named as on your layout (fr, be, ch, de;
the main keyboard's, from hyprctl devices), otherwise as on the US layout."""

KEYCODES = {
    9: T("Échap", "Esc"), 22: T("Retour arrière", "Backspace"), 23: "Tab", 36: T("Entrée", "Enter"), 49: "`",
    65: T("Espace", "Space"), 61: "/",
    59: ",", 60: ".", 20: "-", 21: "=", 34: "[", 35: "]", 47: ";", 48: "'", 51: "\\",
    111: "↑", 113: "←", 114: "→", 116: "↓",
    110: T("Début", "Home"), 115: T("Fin", "End"), 112: T("Page préc.", "Page Up"), 117: T("Page suiv.", "Page Down"),
    118: T("Inser.", "Insert"), 119: T("Suppr", "Delete"),
}
for i, k in enumerate("1234567890"):
    KEYCODES[10 + i] = k
for row, start in (("QWERTYUIOP", 24), ("ASDFGHJKL", 38), ("ZXCVBNM", 52)):
    for i, k in enumerate(row):
        KEYCODES[start + i] = k
for i in range(10):
    KEYCODES[67 + i] = f"F{i + 1}"
KEYCODES[95], KEYCODES[96] = "F11", "F12"

# Lettres (et ponctuation de lettres) qui changent de place par rapport au US : touche US -> ce qu'elle porte
_AZERTY = {"A": "Q", "Q": "A", "W": "Z", "Z": "W", "M": ",", ";": "M", ",": ";", ".": ":"}
_QWERTZ = {"Y": "Z", "Z": "Y"}
DISPOSITIONS = {"fr": {**_AZERTY, "/": "!"}, "be": {**_AZERTY, "/": "="}, "ch": _QWERTZ, "de": _QWERTZ}
# Variantes qui changent tout (pas de table : noms US, comme avant)
_VARIANTES_AUTRES = ("bepo", "dvorak", "colemak", "workman", "neo", "optimot", "ergol")


def _clavier_principal():
    """(disposition, variante) actives du clavier principal (hyprctl devices : main, active_layout_index), réglage par
    appareil compris ; (None, None) si Hyprland ne le dit pas."""
    try:
        sortie = subprocess.run(["hyprctl", "devices", "-j"], capture_output=True, text=True, timeout=3).stdout
        claviers = json.loads(sortie).get("keyboards") or []
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return None, None
    k = next((c for c in claviers if isinstance(c, dict) and c.get("main")), None)
    if not k or not isinstance(k.get("layout"), str) or not k["layout"].strip():
        return None, None
    i = k.get("active_layout_index") if isinstance(k.get("active_layout_index"), int) else 0
    dispositions, variantes = k["layout"].split(","), str(k.get("variant") or "").split(",")
    i = i if 0 <= i < len(dispositions) else 0
    return dispositions[i].strip().lower(), (variantes[i] if i < len(variantes) else "").strip().lower()


def disposition_active():
    """Table de traduction (touche US -> touche portée) de la disposition active : celle du clavier principal, sinon la
    première de input:kb_layout. Vide pour US et pour toute disposition sans table (les noms US restent)."""
    def opt(nom):
        try:
            sortie = subprocess.run(["hyprctl", "getoption", nom], capture_output=True, text=True, timeout=3).stdout
        except (OSError, subprocess.SubprocessError):
            return ""
        m = re.search(r"^\s*(?:str|string):\s*(.*)$", sortie, re.M)
        return m[1].strip() if m else ""
    layout, variante = _clavier_principal()
    if layout is None:
        layout = opt("input:kb_layout").split(",")[0].strip().lower()
        variante = opt("input:kb_variant").split(",")[0].strip().lower()
    if any(v in variante for v in _VARIANTES_AUTRES):
        return {}
    return DISPOSITIONS.get(layout, {})


_TABLE = None


def traduire(lettre):
    """Nom d'une touche (position US) sur la disposition active."""
    global _TABLE
    if _TABLE is None:
        _TABLE = disposition_active()
    return _TABLE.get(lettre, lettre)


MODS = ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, T("Maj", "Shift")))
MOUSE = {"mouse:272": T("glisser", "drag"), "mouse:273": T("clic droit", "right-click"), "mouse_down": T("molette", "scroll"),
         "mouse_up": T("molette", "scroll")}
# Sections de la fiche : les noms français servent d'identifiants (nc-reglages, plugin nc/keys) ; une description
# peut aussi commencer par le nom anglais (« Apps & Bar|… »), rangée dans la même section
SECTIONS = ["Applis et barre", "Fenêtres", "Bureaux", "Souris", "Système", "IA", "Mes raccourcis"]
SECTIONS_EN = {"Applis et barre": "Apps & Bar", "Fenêtres": "Windows", "Bureaux": "Desktops", "Souris": "Mouse",
               "Système": "System", "IA": "AI", "Mes raccourcis": "My Shortcuts"}
_ALIAS = {"apps and bar": "Applis et barre", "apps": "Applis et barre", "workspaces": "Bureaux", "spaces": "Bureaux"}


def reglage(cle):
    try:
        for l in open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace"):
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def section_id(nom):
    """Nom de section d'une description (français ou anglais) -> identifiant (nom français), ou None."""
    nom = nom.strip()
    if nom in SECTIONS:
        return nom
    bas = nom.lower()
    for fr, en in SECTIONS_EN.items():
        if bas in (fr.lower(), en.lower()):
            return fr
    return _ALIAS.get(bas)


def section_label(sec):
    """Titre affiché d'une section (en anglais en mode anglais)."""
    return SECTIONS_EN.get(sec, sec) if EN else sec


def parse_binds(text):
    """Blocs de « hyprctl binds » -> liste de dictionnaires (la sortie JSON ne donne pas les touches par position)."""
    binds, cur = [], None
    for line in text.splitlines():
        if line and not line[0].isspace():
            cur = {"flags": line.strip()}
            binds.append(cur)
        elif cur is not None and ":" in line:
            k, _, v = line.strip().partition(":")
            cur[k.strip()] = v[1:] if v.startswith(" ") else v
    return binds


def key_label(raw):
    raw = raw.strip()
    last = raw.split("+")[-1].strip()
    m = re.fullmatch(r"code:(\d+)", last)
    if m:
        nom = KEYCODES.get(int(m.group(1)))
        return traduire(nom) if nom else T(f"touche {m.group(1)}", f"key {m.group(1)}")
    if last.startswith("XF86"):
        return T("Touches média", "Media keys")
    if last in MOUSE:
        return MOUSE[last]
    if last == "Print":
        return T("Impr. écran", "Print Screen")
    return KEYCODES.get(last, last.capitalize() if len(last) > 1 else last.upper())


def collect():
    try:
        out = subprocess.run(["hyprctl", "binds"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        print(T("nc-keys : Hyprland ne répond pas (hyprctl absent ou en échec) : lance-le depuis une session Hyprland",
                "nc-keys: Hyprland is not answering (hyprctl missing or failing): run it from a Hyprland session"), file=sys.stderr)
        sys.exit(1)
    rows = {}   # (section, texte, mods) -> {keys, order}
    for n, b in enumerate(parse_binds(out)):
        desc = b.get("description", "").strip()
        if not desc or b.get("submap", "").strip():
            continue
        sec, sep, text = desc.partition("|")
        if not sep:
            sec, text = "Mes raccourcis", desc
        sec, text = section_id(sec) or "Mes raccourcis", text.strip()
        try:
            mask = int(b.get("modmask", "0"))
        except ValueError:
            mask = 0
        mods = tuple(name for bit, name in MODS if mask & bit)
        k = (sec, text, mods)
        rows.setdefault(k, {"keys": [], "order": n})
        lab = key_label(b.get("key", ""))
        if lab not in rows[k]["keys"]:
            rows[k]["keys"].append(lab)
    by_sec = {s: [] for s in SECTIONS}
    for (sec, text, mods), v in sorted(rows.items(), key=lambda kv: kv[1]["order"]):
        keys = v["keys"]
        if set(keys) >= {"←", "→", "↑", "↓"}:
            key = T("flèches", "arrows")
        elif len(keys) >= 3 and all(re.fullmatch(r"F\d+", x) for x in keys):
            key = f"{keys[0]}…{keys[-1]}"
        elif len(keys) >= 3 and all(x.isdigit() for x in keys):
            key = f"{keys[0]}…{keys[-1]}"
        else:
            key = " / ".join(keys)
        by_sec[sec].append({"keys": list(mods) + [key], "text": text})
    # Bascule de disposition du clavier (option XKB, pas un raccourci « bind »)
    opts = subprocess.run(["hyprctl", "getoption", "input:kb_options"], capture_output=True, text=True).stdout
    if "grp:win_space_toggle" in opts:
        by_sec["Système"].append({"keys": ["Super", T("Espace", "Space")],
                                  "text": T("Changer la disposition du clavier", "Switch keyboard layout")})
    # L'IA ailleurs que dans Hyprland : préfixes du Spotlight, terminal, Neovim (pas si elle est coupée dans les réglages)
    if reglage("IA_MODE") != "non":
        by_sec["IA"] += [
            {"keys": ["Super", "R", "?"], "text": T("Poser une question à l'IA", "Ask the AI a question")},
            {"keys": ["Super", "R", "!"], "text": T("L'IA sur le texte sélectionné", "AI on the selected text")},
            {"keys": ["Super", "R", "@"], "text": T("L'IA agit (tu confirmes)", "The AI acts (you confirm)")},
            {"keys": ["Alt", "I"], "text": T("Terminal : écrire la commande décrite", "Terminal: write the described command")},
            {"keys": [T("Espace", "Space"), "i"], "text": T("Neovim : demander, expliquer, corriger", "Neovim: ask, explain, fix")},
        ]
    # title : identifiant de la section (nom français, que le plugin nc/keys range en colonnes) ; label : titre affiché
    return [{"title": s, "label": section_label(s), "rows": by_sec[s]} for s in SECTIONS if by_sec[s]]


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "aide", "help"):
        print(T(__doc__.strip(), USAGE_EN))
        sys.exit(0)             # l'aide ne demande pas Hyprland
    data = collect()
    if len(sys.argv) > 1 and sys.argv[1] == "json":
        json.dump(data, sys.stdout, ensure_ascii=False)
    else:
        for sec in data:
            print(f"\n{sec['label']}")
            for r in sec["rows"]:
                print(f"  {' + '.join(r['keys']):<28} {r['text']}")
