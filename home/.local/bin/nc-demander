#!/usr/bin/env python3
"""nc-demander : pose une question rapide à l'IA et affiche sa réponse (courte, en français).
  nc-demander "comment décompresser un .tar.xz"     la réponse ; une commande utile sur une ligne « $ … » à la fin
  nc-demander --ia [--json]                         l'IA qui répondrait (pour le Spotlight)
  nc-demander --flux "question"                     la réponse morceau par morceau, une ligne JSON {"t": …} chacun
                                                    (le Spotlight l'affiche pendant qu'elle s'écrit)
Dans le Spotlight de l'île : « ? ta question » puis Entrée. L'IA : celle de nc-ia (nc-reglages → Intelligence
artificielle : automatique, choisie ou aucune), sauf si « IA du Spotlight » (SPOTLIGHT_IA) en impose une.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys

DOC_EN = """nc-ask: asks the AI a quick question and shows its answer (short, in English).
  nc-ask "how do I extract a .tar.xz"     the answer; a useful command on a last line “$ …”
  nc-ask --ia [--json]                    the AI that would answer (for Spotlight)
  nc-ask --flux "question"                the answer piece by piece, one JSON line {"t": …} each
                                          (Spotlight shows it while it is being written)
In the island's Spotlight: “? your question” then Enter. The AI: nc-ai's (nc-settings → Artificial intelligence:
automatic, chosen or none), unless “Spotlight AI” (SPOTLIGHT_IA) forces one.
"""


def charger_ia():
    chemin = os.path.join(os.path.dirname(os.path.realpath(__file__)), "nc-ia")
    l = importlib.machinery.SourceFileLoader("nc_ia", chemin)
    s = importlib.util.spec_from_loader("nc_ia", l)
    m = importlib.util.module_from_spec(s)
    l.exec_module(m)
    return m


def main():
    ia = charger_ia()
    a = sys.argv[1:]
    # « IA du Spotlight » : auto (celle de nc-ia), une IA précise, ou aucune pour le Spotlight seulement
    choix = ia.reglage("SPOTLIGHT_IA", "auto")
    force = "" if choix in ("auto", "non") else ia.ANCIENS.get(choix, choix)
    if force not in ia.FOURNISSEURS:
        force = ""
    if a[:1] == ["--ia"]:
        try:
            qui = "" if choix == "non" else (ia.candidats("question", force) or [""])[0]
        except ia.ErreurIA:
            qui = ""
        if "--json" in a:
            print(json.dumps({"nom": ia.nom(qui) if qui else "", "agent": ia.FOURNISSEURS[qui]["agent"] if qui else "",
                              "coupee": ia.coupee() or choix == "non", "en_ligne": ia.en_ligne()}, ensure_ascii=False))
        else:
            print(ia.nom(qui) if qui else "")
        return 0
    flux = a[:1] == ["--flux"]
    if flux:
        a = a[1:]
    question = " ".join(a).strip()
    if not question:
        sys.exit(ia.T(__doc__, DOC_EN).strip())
    if choix == "non" and not ia.coupee():
        m = ia.T("Pas d'IA dans le Spotlight (nc-reglages → Île → IA du Spotlight).",
                 "No AI in Spotlight (nc-settings → Island → Spotlight AI).")
        print(json.dumps({"t": m, "erreur": True}, ensure_ascii=False) if flux else m)
        return 1
    return ia.main(["demander"] + (["--flux"] if flux else []) + (["--ia", force] if force else []) + ["--", question])


if __name__ == "__main__":
    sys.exit(main())
