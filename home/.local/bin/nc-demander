#!/usr/bin/env python3
"""nc-demander : pose une question rapide à une IA installée et affiche sa réponse (courte, en français).
  nc-demander "comment décompresser un .tar.xz"     la réponse ; une commande utile sur une ligne « $ … » à la fin
  nc-demander --ia                                  l'IA utilisée (pour le Spotlight)
Dans le Spotlight de l'île : « ? ta question » puis Entrée. IA : nc-reglages → Île → « IA du Spotlight »
(SPOTLIGHT_IA : auto, claude, opencode, gemini, qwen, non) ; auto = la première installée dans cet ordre.
"""
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
# L'île tourne avec le PATH du système : les IA installées pour l'utilisateur sont souvent ailleurs
os.environ["PATH"] = os.pathsep.join([os.path.join(HOME, d) for d in (".local/bin", "bin", ".npm-global/bin", ".bun/bin",
                                      ".opencode/bin", ".cargo/bin")] + [os.environ.get("PATH", "/usr/bin")])
CONSIGNE = ("Réponds en français, en 2 à 6 lignes au plus, en texte simple (pas de titres ni de tableaux). "
            "Si une commande Linux répond à la question, termine par une seule ligne qui commence par « $ » suivie "
            "de la commande, sans rien d'autre. L'ordinateur est sous {distrib} avec Hyprland. Question : ")
NOMS = {"claude": "Claude", "opencode": "OpenCode", "gemini": "Gemini", "qwen": "Qwen"}


def reglage(cle, defaut):
    try:
        with open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8") as f:
            for l in f:
                if l.startswith(cle + "="):
                    defaut = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


def ia():
    choix = reglage("SPOTLIGHT_IA", "auto")
    if choix == "non":
        return ""
    if choix != "auto":
        return choix if shutil.which(choix) else ""
    return next((x for x in NOMS if shutil.which(x)), "")


def distrib():
    try:
        for l in open("/etc/os-release", encoding="utf-8"):
            if l.startswith("PRETTY_NAME="):
                return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Linux"


def main():
    a = sys.argv[1:]
    qui = ia()
    if a and a[0] == "--ia":
        print(NOMS.get(qui, ""))
        return
    question = " ".join(a).strip()
    if not question:
        sys.exit(__doc__.strip())
    if not qui:
        print("Aucune IA installée pour répondre (Claude Code, opencode, Gemini CLI ou Qwen Code).")
        return
    texte = CONSIGNE.format(distrib=distrib()) + question
    cmd = {"claude": ["claude", "-p", "--model", "haiku", texte], "opencode": ["opencode", "run", texte],
           "gemini": ["gemini", "-p", texte], "qwen": ["qwen", "-p", texte]}[qui]
    # NC_ILE_SANS : ses hooks ne l'affichent pas dans l'île comme une session de travail ; dossier neutre
    env = dict(os.environ, NC_ILE_SANS="1", NO_COLOR="1")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120, env=env, cwd=HOME, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        print(f"{NOMS[qui]} n'a pas répondu à temps.")
        return
    sortie = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", r.stdout).strip()
    if qui == "opencode":                      # lignes d'état d'opencode (« > build · modèle », outils…)
        sortie = "\n".join(l for l in sortie.splitlines() if not re.match(r"^\s*(>|→|\$ ?cat|⚙)", l) or l.startswith("$ ")).strip()
    print(sortie or (r.stderr.strip().splitlines() or [f"{NOMS[qui]} n'a rien répondu."])[-1])


if __name__ == "__main__":
    main()
