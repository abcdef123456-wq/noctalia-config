#!/usr/bin/env bash
# nc-couvercle : ce que fait le portable quand on ferme le couvercle (nc-reglages, Veille → « Couvercle fermé »).
#   COUVERCLE=veille (par défaut)  le système met le PC en veille, comme d'habitude
#   COUVERCLE=ecran                l'écran s'éteint (et se verrouille, sauf COUVERCLE_VERROU=non) ; le PC continue de
#                                  tourner : téléchargements, musique, partage… Il ne se met pas non plus en veille
#                                  pour inactivité tant que le couvercle reste fermé.
#   nc-couvercle garde          (service nc-couvercle) en mode « ecran », empêche le système de mettre en veille au
#                               couvercle (verrou de logind, sans sudo)
#   nc-couvercle ferme | ouvre  appelé par Hyprland (interrupteur du couvercle)
# Écran externe branché : le système ne met déjà pas en veille ; seul l'écran du portable s'éteint.
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
RUN="${XDG_RUNTIME_DIR:-/tmp}"
PID="$RUN/nc-couvercle-inactivite.pid"
# nc_pid_notre : un pid lu dans un fichier peut être mort, zombie, ou repris par un autre processus (session redémarrée) :
# on ne tue que notre systemd-inhibit
. "${BASH_SOURCE[0]%/*}/nc-pid" 2>/dev/null || . "$HOME/.local/bin/nc-pid" 2>/dev/null || nc_pid_notre() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }
mode="$(reglage COUVERCLE)"; [ "$mode" = ecran ] || mode=veille

tous="$(hyprctl monitors all -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)"
internes="$(grep -E '^(eDP|LVDS|DSI)' <<< "$tous")"
# Écran externe : ni interne, ni virtuel (HEADLESS : partage de bureau, FALLBACK : écran de secours de Hyprland)
autres="$(grep -vE '^(eDP|LVDS|DSI|HEADLESS|FALLBACK)' <<< "$tous")"
externe=0; [ -n "$internes" ] && [ -n "$autres" ] && externe=1
couvercle_ferme() { grep -qs closed /proc/acpi/button/lid/*/state; }

# Verrou de nc-ecran (le même fichier) : un retrait d'écran ou un rechargement de la config ne se fait pas en même
# temps qu'un allumage ou une extinction DPMS (hypridle, coin de l'île). Dépassé au bout de 10 s : on agit quand même.
# Jamais autour de nc-ecran lui-même (il prend ce verrou : blocage).
sous_verrou() {
  if command -v flock >/dev/null 2>&1; then
    ( flock -w 10 9 2>/dev/null; "$@" ) 9>"$RUN/nc-ecran.verrou"
  else
    "$@"
  fi
}
retirer_interne() { hyprctl eval "hl.monitor({ output = '$1', disabled = true })" >/dev/null; }

arreter() {   # retire le verrou d'inactivité (systemd-inhibit et son « sleep »)
  # Fichier : « pid heure-de-démarrage » ; ancien fichier (pid seul) : le nom systemd-inhibit doit être dans sa ligne de commande
  local p d
  read -r p d < "$PID" 2>/dev/null || true
  if nc_pid_notre "$p" "$d" systemd-inhibit; then pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; fi
  rm -f "$PID"
}

action="${1:-}"
# Noms anglais (nc-lid hold | close | open)
case "$action" in hold) action=garde ;; close|closed) action=ferme ;; open|opened) action=ouvre ;; esac

case "$action" in
  garde)
    [ "$mode" = ecran ] || exit 0
    exec systemd-inhibit --what=handle-lid-switch --who=noctalia-config --mode=block \
      --why="$(t "Couvercle fermé : l'écran s'éteint, le PC continue de tourner (nc-reglages)" "Lid closed: the screen turns off, the PC keeps running (nc-settings)")" sleep infinity ;;
  ferme)
    if [ "$externe" = 1 ]; then
      # Écran externe (quel que soit le mode : en veille aussi, le système ne dort pas quand un écran est branché) :
      # on continue de travailler dessus ; l'écran du portable est retiré (ni pointeur ni fenêtres dessous, ne se
      # rallume pas à la première touche), sans verrouiller
      while IFS= read -r m; do sous_verrou retirer_interne "$m"; done <<< "$internes"
      exit 0
    fi
    [ "$mode" = ecran ] || exit 0              # veille : le système s'en charge
    [ "$(reglage COUVERCLE_VERROU)" = non ] || loginctl lock-session
    # Pas de veille pour inactivité tant que le couvercle est fermé (hypridle respecte ce verrou)
    arreter
    setsid systemd-inhibit --what=idle --who=noctalia-config --why="$(t "Couvercle fermé, le PC continue de tourner" "Lid closed, the PC keeps running")" \
      sleep infinity >/dev/null 2>&1 &
    echo "$! $(nc_pid_debut "$!" 2>/dev/null)" > "$PID"
    sleep 1                                   # le verrouillage s'affiche avant que l'écran s'éteigne
    couvercle_ferme || { arreter; exit 0; }   # rouvert entre-temps
    "$HOME/.local/bin/nc-ecran" off ;;        # par nc-ecran : jamais en même temps qu'un autre allumage
  ouvre)
    arreter
    # Écran du portable retiré (écran externe) : la config des écrans (nc/ecrans.lua) le remet ; sinon il est rallumé
    if hyprctl monitors all -j 2>/dev/null | jq -e '.[] | select((.name | test("^(eDP|LVDS|DSI)")) and .disabled)' >/dev/null 2>&1; then
      sous_verrou hyprctl reload >/dev/null
    else
      "$HOME/.local/bin/nc-ecran" on
    fi ;;
  *)
    if [ "${NC_LANGUE:-fr}" = en ]; then
      cat <<'FIN'
# nc-lid: what the laptop does when you close the lid (nc-settings, Sleep → "Lid closed").
#   COUVERCLE=veille (default)  the system puts the PC to sleep, as usual
#   COUVERCLE=ecran             the screen turns off (and locks, unless COUVERCLE_VERROU=non); the PC keeps
#                               running: downloads, music, sharing… It doesn't go to sleep on inactivity either
#                               while the lid stays closed.
#   nc-lid hold          (nc-couvercle service) in "ecran" mode, stops the system from sleeping when the lid
#                        closes (logind inhibitor, no sudo)
#   nc-lid close | open  called by Hyprland (lid switch)
# External screen plugged in: the system already doesn't sleep; only the laptop screen turns off.
FIN
    else
      sed -n '2,11p' "$0"
    fi
    exit 1 ;;
esac
