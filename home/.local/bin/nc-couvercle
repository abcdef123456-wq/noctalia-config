#!/usr/bin/env bash
# nc-couvercle : ce que fait le portable quand on ferme le couvercle (nc-reglages, Veille → « Couvercle fermé »).
#   COUVERCLE=veille (par défaut)  le système met le PC en veille, comme d'habitude
#   COUVERCLE=ecran                l'écran s'éteint (et se verrouille, sauf COUVERCLE_VERROU=non) ; le PC continue de
#                                  tourner : téléchargements, musique, partage… Il ne se met pas non plus en veille
#                                  pour inactivité tant que le couvercle reste fermé.
#   nc-couvercle garde          (service nc-couvercle) en mode « ecran », empêche le système de mettre en veille au
#                               couvercle (verrou de logind, sans sudo)
#   nc-couvercle ferme | ouvre  appelé par Hyprland (interrupteur du couvercle)
# Écran externe branché : le système ne met déjà pas en veille ; seul l'écran du portable s'éteint.
set -uo pipefail
RUN="${XDG_RUNTIME_DIR:-/tmp}"
PID="$RUN/nc-couvercle-inactivite.pid"
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }
mode="$(reglage COUVERCLE)"; [ "$mode" = ecran ] || mode=veille

tous="$(hyprctl monitors all -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)"
internes="$(grep -E '^(eDP|LVDS|DSI)' <<< "$tous")"
externe=0; [ -n "$internes" ] && [ "$internes" != "$tous" ] && externe=1
couvercle_ferme() { grep -qs closed /proc/acpi/button/lid/*/state; }

arreter() {   # retire le verrou d'inactivité (systemd-inhibit et son « sleep »)
  local p
  p="$(cat "$PID" 2>/dev/null)"
  [ -n "$p" ] && { pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
  rm -f "$PID"
}

case "${1:-}" in
  garde)
    [ "$mode" = ecran ] || exit 0
    exec systemd-inhibit --what=handle-lid-switch --who=noctalia-config --mode=block \
      --why="Couvercle fermé : l'écran s'éteint, le PC continue de tourner (nc-reglages)" sleep infinity ;;
  ferme)
    [ "$mode" = ecran ] || exit 0
    if [ "$externe" = 1 ]; then
      # Écran externe : on continue de travailler dessus ; l'écran du portable est retiré (ni pointeur ni fenêtres
      # dessous, ne se rallume pas à la première touche), sans verrouiller
      while IFS= read -r m; do hyprctl eval "hl.monitor({ output = '$m', disabled = true })" >/dev/null; done <<< "$internes"
      exit 0
    fi
    [ "$(reglage COUVERCLE_VERROU)" = non ] || loginctl lock-session
    # Pas de veille pour inactivité tant que le couvercle est fermé (hypridle respecte ce verrou)
    arreter
    setsid systemd-inhibit --what=idle --who=noctalia-config --why="Couvercle fermé, le PC continue de tourner" \
      sleep infinity >/dev/null 2>&1 &
    echo $! > "$PID"
    sleep 1                                   # le verrouillage s'affiche avant que l'écran s'éteigne
    couvercle_ferme || { arreter; exit 0; }   # rouvert entre-temps
    hyprctl dispatch 'hl.dsp.dpms({ action = "off" })' >/dev/null ;;
  ouvre)
    arreter
    # Écran du portable retiré (écran externe) : la config des écrans (nc/ecrans.lua) le remet ; sinon il est rallumé
    if hyprctl monitors all -j 2>/dev/null | jq -e '.[] | select((.name | test("^(eDP|LVDS|DSI)")) and .disabled)' >/dev/null 2>&1; then
      hyprctl reload >/dev/null
    else
      hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' >/dev/null
    fi ;;
  *) sed -n '2,11p' "$0"; exit 1 ;;
esac
