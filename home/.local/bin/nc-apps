#!/usr/bin/env python3
"""nc-apps : applications installées, pour la recherche Super+R (plugin Noctalia v5 nc/launcher).

  nc-apps list        JSON : [{id, name, generic, comment, keywords, exe, icon, wmclass}, ...]
  nc-apps launch ID   lance l'application ID (nom du fichier .desktop sans l'extension),
                          dans sa propre unité systemd (uwsm-app) et sur le GPU du profil (nc-launch).
  nc-apps files TEXTE fichiers et dossiers du dossier personnel dont le nom contient TEXTE
                          (JSON, 4 au plus, dossiers cachés exclus)
  nc-apps open CHEMIN ouvre un fichier ou un dossier avec l'appli par défaut
  nc-apps icon NOM    chemin du fichier d'icône d'une appli (nom du lecteur, de la fenêtre ou du .desktop),
                          cherché dans le thème d'icônes actif puis Papirus et hicolor (vide si rien)
"""
import json
import os
import re
import subprocess
import shlex
import shutil
import sys

# Réglage mémoire propre à l'île (MALLOC_CONF, nc-ile.service) : pas pour les applis qu'elle lance
os.environ.pop("MALLOC_CONF", None)

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-apps: installed applications, for the Super+R search (Noctalia v5 plugin nc/launcher).

  nc-apps list        JSON: [{id, name, generic, comment, keywords, exe, icon, wmclass}, ...]
  nc-apps launch ID   launches application ID (name of the .desktop file without the extension),
                          in its own systemd unit (uwsm-app) and on the GPU of the profile (nc-launch).
  nc-apps files TEXT  files and folders of the home folder whose name contains TEXT
                          (JSON, 4 at most, hidden folders excluded)
  nc-apps open PATH   opens a file or a folder with the default app
  nc-apps icon NAME   path of an app's icon file (name of the player, of the window or of the .desktop),
                          looked up in the active icon theme then Papirus and hicolor (empty if nothing)"""

LAUNCH = os.path.expanduser("~/.local/bin/nc-launch")
TERMINAL = ["kitty", "-e"]
# Outils système installés comme dépendances : masqués de la recherche (pas désinstallés)
HIDDEN = {
    "avahi-discover", "bssh", "bvnc", "jconsole-java-openjdk", "jshell-java-openjdk", "lstopo",
    "qv4l2", "qvidcap", "uuctl", "uxterm", "xterm", "qt6ct", "nvidia-settings", "auto-cpufreq-gtk",
    "nm-connection-editor", "org.torproject.torbrowser-launcher.settings",
}


def app_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = [home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    seen = []
    for d in dirs:
        p = os.path.join(d, "applications")
        if d and p not in seen and os.path.isdir(p):
            seen.append(p)
    return seen


def locales():
    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split(".")[0]
    out = []
    if lang and lang not in ("C", "POSIX"):
        out.append(lang)
        if "_" in lang:
            out.append(lang.split("_")[0])
    # Langue de la config forcée (nc-reglages → Langue) : noms des applis dans cette langue
    if EN and lang.startswith("fr"):
        return []
    if not EN and not lang.startswith("fr"):
        return ["fr_FR", "fr"]
    return out


LOCS = locales()


def parse(path):
    entry, section = {}, None
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    section = line
                    continue
                if section != "[Desktop Entry]" or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                entry.setdefault(k.strip(), v.strip())
    except OSError:
        return None
    return entry


def loc(e, key):
    for l in LOCS:
        v = e.get(f"{key}[{l}]")
        if v:
            return v
    return e.get(key, "")


def entries():
    """id -> (chemin, entrée), le premier dossier trouvé l'emporte (règle XDG)."""
    found = {}
    for d in app_dirs():
        for root, _, files in os.walk(d):
            for fn in files:
                if not fn.endswith(".desktop"):
                    continue
                path = os.path.join(root, fn)
                app_id = os.path.relpath(path, d)[: -len(".desktop")].replace("/", "-")
                if app_id not in found:
                    found[app_id] = path
    return found


def visible(e):
    if e.get("Type") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
        return False
    desk = set((os.environ.get("XDG_CURRENT_DESKTOP") or "").split(":"))
    only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
    if only and not desk.intersection(only):
        return False
    if desk.intersection(x for x in e.get("NotShowIn", "").split(";") if x):
        return False
    tryexec = e.get("TryExec")
    if tryexec and not (shutil.which(tryexec) or os.access(tryexec, os.X_OK)):
        return False
    return bool(e.get("Exec"))


def exec_argv(e):
    try:
        args = shlex.split(e.get("Exec", ""))
    except ValueError:
        return []
    out = []
    for a in args:
        if a in ("%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%k", "%v", "%m"):
            continue
        if a == "%i":
            if e.get("Icon"):
                out += ["--icon", e["Icon"]]
            continue
        if a == "%c":
            out.append(loc(e, "Name"))
            continue
        out.append(a.replace("%%", "%"))
    return out


def cmd_list():
    apps, dedupe = [], set()
    for app_id, path in sorted(entries().items()):
        if app_id in HIDDEN:
            continue
        e = parse(path)
        if not e or not visible(e):
            continue
        argv = exec_argv(e)
        exe = os.path.basename(argv[0]) if argv else ""
        name = loc(e, "Name")
        if not name or (name, exe) in dedupe:
            continue
        dedupe.add((name, exe))
        apps.append({
            "id": app_id,
            "name": name,
            "generic": loc(e, "GenericName"),
            "comment": loc(e, "Comment"),
            "keywords": loc(e, "Keywords").replace(";", " ").strip(),
            "exe": exe,
            "icon": e.get("Icon", ""),
            "wmclass": e.get("StartupWMClass", ""),     # classe de ses fenêtres (Spotlight : aller sur la fenêtre ouverte)
        })
    json.dump(apps, sys.stdout, ensure_ascii=False)


def cmd_launch(app_id):
    path = entries().get(app_id)
    e = parse(path) if path else None
    if not e:
        sys.exit(T(f"Application inconnue : {app_id}", f"Unknown application: {app_id}"))
    argv = exec_argv(e)
    if not argv:
        sys.exit(T(f"Commande vide : {app_id}", f"Empty command: {app_id}"))
    if e.get("Terminal") == "true":
        argv = TERMINAL + argv
    if e.get("Path"):
        try:
            os.chdir(os.path.expanduser(e["Path"]))
        except OSError:
            pass
    else:
        os.chdir(os.path.expanduser("~"))
    pre = [LAUNCH] if os.access(LAUNCH, os.X_OK) else []
    if shutil.which("uwsm-app"):
        os.execvp("uwsm-app", ["uwsm-app", "--"] + pre + argv)
    os.execvp((pre + argv)[0], pre + argv)


def cmd_files(text):
    q = text.strip().lower()
    home = os.path.expanduser("~")
    if len(q) < 3:
        print("[]")
        return
    found = []
    for root, dirs, files in os.walk(home):
        depth = root[len(home):].count(os.sep)
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "__pycache__")]
        if depth >= 5:
            dirs[:] = []
        for name, is_dir in [(d, True) for d in dirs] + [(f, False) for f in files if not f.startswith(".")]:
            low = name.lower()
            pos = low.find(q)
            if pos < 0:
                continue
            path = os.path.join(root, name)
            # nom qui commence par le texte > mot qui commence par le texte > ailleurs ; puis moins profond, plus court
            word = pos == 0 or not low[pos - 1].isalnum()
            found.append(((0 if pos == 0 else 1 if word else 2), depth, len(name), path, name, is_dir))
    found.sort()
    def where(p):
        parts = os.path.relpath(os.path.dirname(p), home).split(os.sep)
        if parts == ["."]:
            return "~"
        return "/".join(parts) if len(parts) <= 2 else parts[0] + "/…/" + parts[-1]
    out = [{"path": p, "name": n, "dir": d, "parent": where(p)} for _, _, _, p, n, d in found[:4]]
    json.dump(out, sys.stdout, ensure_ascii=False)


def cmd_open(path):
    path = os.path.expanduser(path)
    if not os.path.exists(path):
        sys.exit(T(f"Introuvable : {path}", f"Not found: {path}"))
    argv = ["xdg-open", path]
    if shutil.which("uwsm-app"):
        argv = ["uwsm-app", "--"] + argv
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def themes_icones():
    """Thème actif (GTK), ses parents, puis Papirus-Dark, Adwaita et hicolor."""
    noms = []
    try:
        g = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
                           capture_output=True, text=True, timeout=2).stdout.strip().strip("'")
        if g:
            noms.append(g)
    except (OSError, subprocess.SubprocessError):
        pass
    bases = [os.path.expanduser("~/.local/share/icons"), "/usr/share/icons", "/usr/local/share/icons"]
    i = 0
    while i < len(noms):            # parents déclarés par chaque thème (Inherits=)
        for b in bases:
            idx = os.path.join(b, noms[i], "index.theme")
            if os.path.exists(idx):
                for ligne in open(idx, errors="ignore"):
                    if ligne.startswith("Inherits="):
                        noms += [t.strip() for t in ligne.split("=", 1)[1].split(",") if t.strip() and t.strip() not in noms]
                break
        i += 1
    for t in ("Papirus-Dark", "Papirus", "Adwaita", "hicolor"):
        if t not in noms:
            noms.append(t)
    return bases, noms


def chercher_icone(icone):
    if not icone:
        return ""
    if os.path.isabs(icone):
        return icone if os.path.exists(icone) else ""
    bases, themes = themes_icones()
    tailles = ["scalable", "128x128", "96x96", "64x64", "48x48", "256x256", "512x512", "32x32"]
    for t in themes:
        for b in bases:
            racine = os.path.join(b, t)
            if not os.path.isdir(racine):
                continue
            for taille in tailles:
                for ordre in ((taille, "apps"), ("apps", taille)):          # 64x64/apps (Papirus) ou apps/64 (WhiteSur)
                    for ext in (".svg", ".png"):
                        f = os.path.join(racine, *ordre, icone + ext)
                        if os.path.exists(f):
                            return f
    for ext in (".svg", ".png", ".xpm"):
        f = os.path.join("/usr/share/pixmaps", icone + ext)
        if os.path.exists(f):
            return f
    return ""


def cmd_icon(nom):
    """Icône d'une appli à partir du nom de son lecteur ou de sa fenêtre (firefox, spotify, discord…)."""
    n = nom.lower().split(".")[0]
    candidats = []
    for app_id, path in entries().items():
        e = parse(path)
        if not e:
            continue
        argv = exec_argv(e)
        exe = os.path.basename(argv[0]).lower() if argv else ""
        ids = {app_id.lower(), app_id.lower().split(".")[-1], e.get("StartupWMClass", "").lower(), exe}
        if n in ids:
            candidats.insert(0, e)
        elif app_id.lower().startswith(n):
            candidats.append(e)
    for e in candidats:
        f = chercher_icone(e.get("Icon", ""))
        if f:
            print(f)
            return
    print(chercher_icone(n))


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "list":
        cmd_list()
    elif len(sys.argv) == 3 and sys.argv[1] == "launch":
        cmd_launch(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "files":
        cmd_files(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "open":
        cmd_open(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "icon":
        cmd_icon(sys.argv[2])
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(1)
