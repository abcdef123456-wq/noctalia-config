#!/usr/bin/env bash
# nc-greeting : accueil du terminal (fastfetch), adapté à la taille de la fenêtre.
#   large   (≥ 66 colonnes, ≥ 16 lignes) : logo + infos (logo image dans kitty, logo texte ailleurs)
#   moyenne (≥ 34 colonnes, ≥ 12 lignes) : infos seules, lignes coupées à la largeur de la fenêtre, jamais au milieu d'un mot
#   petite                               : rien
# Usage : nc-greeting [colonnes] [lignes]   (zsh passe $COLUMNS et $LINES ; sinon tput)
# Le .zshrc le relance quand la fenêtre change de taille, tant qu'aucune commande n'a été tapée.
set -uo pipefail
command -v fastfetch >/dev/null || exit 0
# ImageMagick 7 (magick) ou 6 (convert, Debian et Ubuntu) : même syntaxe ici
IM=$(command -v magick >/dev/null && echo magick || echo convert)
# Accueil coupé dans nc-reglages (TERMINAL_ACCUEIL=non)
grep -qx 'TERMINAL_ACCUEIL=non' "$HOME/.config/nc/reglages.conf" 2>/dev/null && exit 0

CFG="$HOME/.config/fastfetch/nc.jsonc"
LOGO="$HOME/.cache/nc/term-logo.png"
cols=${1:-$(tput cols 2>/dev/null || echo 80)}
lines=${2:-$(tput lines 2>/dev/null || echo 24)}

# Couleurs du fond d'écran (Noctalia) : accent pour les icônes, le titre et les barres ; contour pour le fond des barres
P=$(jq -r '.mPrimary // empty' "$HOME/.config/noctalia/colors.json" 2>/dev/null)
O=$(jq -r '.mOutline // empty' "$HOME/.config/noctalia/colors.json" 2>/dev/null)
# Couleurs passées en code de terminal « 38;2;R;G;B » : les fastfetch anciens (Debian 13 : 2.40) refusent « #rrggbb »
# (« invalid color code »). Options des barres : seulement si cette version de fastfetch les connaît (vérifié une
# fois par version, gardé dans ~/.cache/nc)
ansi() { [[ "$1" =~ ^#?([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2}) ]] && printf '38;2;%d;%d;%d' "0x${BASH_REMATCH[1]}" "0x${BASH_REMATCH[2]}" "0x${BASH_REMATCH[3]}"; }
barres_ok() {
  local v f
  v="$(fastfetch --version-raw 2>/dev/null || fastfetch --version 2>/dev/null | head -1)"
  f="$HOME/.cache/nc/fastfetch-barres"
  if [ "$(head -1 "$f" 2>/dev/null)" != "$v" ]; then
    mkdir -p "$(dirname "$f")"
    { echo "$v"; fastfetch --help 2>/dev/null | grep -q -- 'bar-color-elapsed' && echo oui || echo non; } > "$f"
  fi
  [ "$(sed -n 2p "$f")" = oui ]
}
COL=()
PA="$(ansi "$P")"; OA="$(ansi "$O")"
if [ -n "$PA" ]; then
  COL+=(--color-keys "$PA" --color-title "$PA")
  barres_ok && COL+=(--bar-color-elapsed "$PA")
fi
[ -n "$OA" ] && barres_ok && COL+=(--bar-color-total "$OA")

# Coupe chaque ligne à la largeur donnée sans compter les codes couleur (aucun retour à la ligne disgracieux).
# En Python : mawk (awk de Debian) compte en octets et couperait au milieu d'un caractère (icônes, barres ▰).
# Les caractères larges (CJK, emoji) comptent pour 2 colonnes, les accents combinés pour 0.
cut_to() {
  if command -v python3 >/dev/null; then
    python3 -c '
import re, sys, unicodedata
w = int(sys.argv[1])
seq = re.compile(r"\033\[[0-9;?]*[A-Za-z]")
def larg(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1
lignes = sys.stdin.buffer.read().decode("utf-8", "replace").split("\n")
if lignes and lignes[-1] == "":
    lignes.pop()
for ligne in lignes:
    out, n, i, coupe, blanc, prec = "", 0, 0, False, None, " "
    while i < len(ligne):
        m = seq.match(ligne, i)
        if m:
            if not coupe:
                out += m.group()
            i = m.end(); continue
        c = ligne[i]; i += 1
        if coupe:
            continue
        if n + larg(c) > w:
            # jamais de mot coupé en deux : on revient au dernier espace (« Performance » entier ou rien)
            coupe = True
            if not c.isspace() and not prec.isspace() and blanc is not None:
                out = out[:blanc]
            out = out.rstrip()
            continue
        if c.isspace():
            blanc = len(out)
        out += c; n += larg(c); prec = c
    sys.stdout.write(out + "\033[0m\n")
' "$1"
    return
  fi
  awk -v w="$1" '{
    out = ""; n = 0; s = $0
    while (length(s) > 0) {
      if (match(s, /^\033\[[0-9;?]*[A-Za-z]/)) { out = out substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1); continue }
      if (n >= w) { s = substr(s, 2); continue }
      out = out substr(s, 1, 1); s = substr(s, 2); n++
    }
    print out "\033[0m"
  }'
}

# Logo choisi dans nc-reglages (Terminal → Logo de l'accueil) : celui de ta distribution (image aux couleurs du thème),
# un logo de fastfetch (Apple, Windows, Tux…, en couleurs du thème), ta photo de profil, ou aucun
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/style.conf" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }
choix="$(reglage TERMINAL_LOGO)"; choix="${choix:-distribution}"
# Style « dessin » (par défaut) : le logo dessiné comme une icône, sur fond sombre (nc-term-logo dessin), dans kitty
style="$(reglage TERMINAL_LOGO_STYLE)"; style="${style:-dessin}"
DESSIN="$HOME/.cache/nc/term-dessin.png"
S2=$(jq -r '.mSecondary // .mTertiary // empty' "$HOME/.config/noctalia/colors.json" 2>/dev/null)
SA="$(ansi "$S2")"; SA="${SA:-$PA}"
LOGO_OPT=()
if [ "$style" = dessin ] && [ "$choix" != aucun ] && [ "$choix" != photo ] && [ -n "${KITTY_WINDOW_ID:-}" ] &&
   "$HOME/.local/bin/nc-term-logo" dessin "$choix" 2>/dev/null && [ -r "$DESSIN" ]; then
  choix=dessin
fi
case "$choix" in
  distribution) ;;
  # Logo dessiné : sur 12 lignes, la hauteur des infos (la marge est dans l'image, centrée), décollé du bord
  dessin) LOGO_OPT=(--logo "$DESSIN" --logo-type kitty-direct --logo-width 20 --logo-height 12 --logo-padding-left 2 --logo-padding-right 3) ;;
  aucun) LOGO_OPT=(--logo none) ;;
  # Photo de profil : comme le logo dessiné, sur 12 lignes et centrée sur les infos ; découpée en rond comme
  # l'avatar de Noctalia, sinon le fond carré de la photo fait un cadre (copie avec la marge, refaite quand la photo change)
  photo) if [ -n "${KITTY_WINDOW_ID:-}" ] && [ -r "$HOME/.face" ]; then
           PHOTO="$HOME/.cache/nc/term-photo-rond.png"
           if [ ! -s "$PHOTO" ] || [ "$HOME/.face" -nt "$PHOTO" ]; then
             # Copie de ta photo : lisible par toi seul (umask 077 dans un sous-shell, le reste du script ne change pas)
             ( umask 077
               mkdir -p "$(dirname "$PHOTO")"
               "$IM" "$HOME/.face[0]" -resize 440x440^ -gravity center -extent 440x440 \
                 \( -size 440x440 xc:black -fill white -draw "circle 220,220 220,2" \) -alpha off -compose CopyOpacity -composite \
                 -compose Over -background none -extent 520x624 "PNG32:$PHOTO.tmp" 2>/dev/null ) &&
               mv "$PHOTO.tmp" "$PHOTO" || PHOTO="$HOME/.face"
           fi
           if [ "$PHOTO" = "$HOME/.face" ]; then
             LOGO_OPT=(--logo "$PHOTO" --logo-type kitty-direct --logo-width 20 --logo-height 10 --logo-padding-left 2 --logo-padding-right 3)
           else
             LOGO_OPT=(--logo "$PHOTO" --logo-type kitty-direct --logo-width 20 --logo-height 12 --logo-padding-left 2 --logo-padding-right 3)
           fi
         fi ;;
  *) LOGO_OPT=(--logo "$choix" --logo-type builtin ${PA:+--logo-color-1 "$PA" --logo-color-2 "$SA"} --logo-padding-top 1 --logo-padding-left 2 --logo-padding-right 3) ;;
esac

if [ "$cols" -ge 66 ] && [ "$lines" -ge 16 ] && [ ${#LOGO_OPT[@]} -gt 0 ]; then
  exec fastfetch -c "$CFG" "${COL[@]}" "${LOGO_OPT[@]}"
elif [ "$cols" -ge 66 ] && [ "$lines" -ge 16 ]; then
  if [ -n "${KITTY_WINDOW_ID:-}" ] && [ -r "$LOGO" ]; then
    exec fastfetch -c "$CFG" "${COL[@]}"
  else
    exec fastfetch -c "$CFG" "${COL[@]}" --logo-type small --logo-color-1 2 --logo-color-2 3 --logo-padding-top 1 --logo-padding-left 2 --logo-padding-right 3
  fi
elif [ "$cols" -ge 34 ] && [ "$lines" -ge 12 ]; then
  fastfetch -c "$CFG" "${COL[@]}" --logo none --pipe false | cut_to "$((cols - 1))"
fi
exit 0
