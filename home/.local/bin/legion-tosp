#!/usr/bin/env bash
# legion-tosp NOM : envoie la fenêtre active vers le bureau caché NOM (magic ou term) ; si elle y est déjà, la ramène sur le bureau visible.
# Le terminal caché (term) n'accepte qu'une seule fenêtre : la fenêtre envoyée y est flottante et centrée.
n=${1:-magic}
cur=$(hyprctl activewindow -j | jq -r '.workspace.name // empty')
if [ "$cur" = "special:$n" ]; then
  ws=$(hyprctl monitors -j | jq -r '.[]|select(.focused)|.activeWorkspace.id')
  hyprctl dispatch movetoworkspace "$ws" >/dev/null
  exit 0
fi
if [ "$n" = term ] && [ "$(hyprctl clients -j | jq '[.[]|select(.workspace.name=="special:term")]|length')" -gt 0 ]; then
  notify-send -t 2500 "Terminal caché" "Il contient déjà une fenêtre." 2>/dev/null
  exit 0
fi
addr=$(hyprctl activewindow -j | jq -r '.address')
hyprctl dispatch movetoworkspacesilent "special:$n" >/dev/null
if [ "$n" = term ]; then
  hyprctl --batch "dispatch setfloating address:$addr ; dispatch resizewindowpixel exact 72% 62%,address:$addr ; dispatch centerwindow" >/dev/null
fi
