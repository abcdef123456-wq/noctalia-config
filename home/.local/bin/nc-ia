# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        l = reglage("LANGUE", "")
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


HOME = Path.home()
CONFIG = HOME / ".config"           # comme nc-reglages et nc-assistant (pas XDG_CONFIG_HOME : un seul endroit)
REGLAGES = CONFIG / "nc/reglages.conf"
CLES = CONFIG / "nc/ia.conf"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "nc"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "nc-ia"
DERNIERE = RUN / "derniere.md"
MAX_REPONSE = 4 * 1024 * 1024
# L'île tourne avec le PATH du système : les IA installées pour l'utilisateur sont souvent ailleurs
os.environ["PATH"] = os.pathsep.join([str(HOME / d) for d in (".local/bin", "bin", ".npm-global/bin", ".bun/bin",
                                      ".opencode/bin", ".cargo/bin", ".deno/bin")] + [os.environ.get("PATH", "/usr/bin")])

_reglages = None


def reglage(cle, defaut):
    global _reglages
    if _reglages is None:
        _reglages = {}
        try:
            for l in REGLAGES.read_text(encoding="utf-8").splitlines():
                k, s, v = l.partition("=")
                if s and re.fullmatch(r"[A-Z0-9_]+", k.strip()):
                    _reglages[k.strip()] = v.strip().strip('"')
        except OSError:
            pass
    return _reglages.get(cle, defaut)


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


DOC_EN = """nc-ai: the desktop's AI, a single door for everything (Spotlight, copied text, terminal, screenshots, JARVIS).

  nc-ai status [--json]                the mode, the AI chosen for each use, the available ones
  nc-ai ask [options] QUESTION         the answer (QUESTION “-”: read from standard input)
        --flux                         piece by piece: one JSON line {"t": …} each ({"ia": …} first)
        --usage question|texte|commande|image   (question by default)
        --ia ID                        that AI (otherwise: the setting); --image FILE: an attached image
  nc-ai text ACTION [--presse|--selection] [--copier] [--flux]
