#!/usr/bin/env python3
"""nc-ia : l'IA du bureau, une seule porte pour tout (Spotlight, texte copié, terminal, captures, JARVIS).

  nc-ia etat [--json]                  le mode, l'IA choisie pour chaque usage, celles qui sont disponibles
  nc-ia demander [options] QUESTION    la réponse (QUESTION « - » : lue sur l'entrée standard)
        --flux                         morceau par morceau : une ligne JSON {"t": …} chacun ({"ia": …} avant)
        --usage question|texte|commande|image   (question par défaut)
        --ia ID                        cette IA-là (sinon : le réglage) ; --image FICHIER : une image jointe
  nc-ia texte ACTION [--presse|--selection|--stdin] [--copier] [--flux]
                                       sur le texte sélectionné (sinon copié) : resumer, traduire, corriger,
                                       reformuler, expliquer, repondre, ou une consigne libre entre guillemets
  nc-ia menu                           les actions sur le texte (Super + I) : le Spotlight sur « ! », sinon un menu
  nc-ia terminal QUESTION              la réponse dans un terminal (« ? » du lanceur de Noctalia, sans l'île)
  nc-ia fichier CHEMIN… [ACTION|consigne] [--notifier]
                                       un texte, du code, un PDF ou une image : résumé par défaut (clic droit dans
                                       Fichiers → Scripts → IA)
  nc-ia diagnostic                     ce que nc-diag a trouvé, expliqué, avec quoi faire (nc-diag ia)
  nc-ia diagnostic --json [--delai S] [-]
                                       « Que se passe-t-il ? » (Spotlight) : le bilan de nc-diag --json (« - » : lu
                                       sur l'entrée standard, sinon nc-diag --json --rapide) résumé, et ses réparations
                                       mises dans l'ordre ; un JSON {source, raison, ia, agent, resume, reparations,
                                       conseil, refus}, toujours le code 0 (sans IA : le résumé de nc-diag). Ne part
                                       vers l'IA que ce qui ne va pas, anonymisé (machine, compte, adresses, e-mails) ;
                                       nc-ia ne répare jamais rien (nc-diag reparer ID) ; S : 40 s par défaut
  nc-ia panne SERVICE.service [--livrer]  pourquoi ce service de ta session est tombé en panne (nc-panne)
  nc-ia agir DEMANDE [--json]          l'IA gère le bureau (services de la session, Wi-Fi, Bluetooth, énergie, son,
                                       réglages, mises à jour) : un plan d'actions permises, confirmé avant d'agir
                                       (« @ » dans le Spotlight) ; nc-ia executer PLAN [N…] le réalise
  nc-ia commande DESCRIPTION           une commande shell seule (Alt + I dans le terminal)
  nc-ia raccourci DESCRIPTION [--json]  un raccourci clavier décrit en français (« Super + F ouvre Firefox ») :
                                       proposé, vérifié (touches, appli, bureau, page de l'île), jamais ajouté
  nc-ia capture [QUESTION]             une zone de l'écran, expliquée (Super + Maj + I)
  nc-ia configurer                     les clés d'API : la fenêtre « Clés des IA » de l'île, sinon au clavier
                                       (masquées), chacune essayée tout de suite ; --terminal : au clavier
  nc-ia cle FOURNISSEUR                enregistre sa clé d'API, lue sur l'entrée standard (vide : l'efface)
  nc-ia cles [--json]                  les clés enregistrées, masquées, et d'où elles viennent
  nc-ia modele FOURNISSEUR [NOM]       le modèle utilisé (sans NOM : retour au choix automatique)
  nc-ia tester [ID] [--json]           un essai court de chaque IA disponible (ou de celle-ci)
  nc-ia quelle [--usage U] [--json]    l'IA qui répondrait maintenant
  nc-ia actif                          code 0 si l'IA est permise, 1 si elle est coupée (IA_MODE=non)
  nc-ia disponible                     code 0 si une IA peut répondre maintenant (permise, et connexion ou IA locale)
  nc-ia derniere                       la dernière réponse en entier (lue dans le terminal)
  nc-ia transcrire FICHIER.wav [--json]   le texte d'un enregistrement (dictée sans JARVIS : Groq, OpenAI, Gemini)

Réglages (nc-reglages → Intelligence artificielle) : IA_MODE auto (la meilleure disponible, la suivante si elle
échoue), manuel (IA_CHOIX) ou non (plus aucune IA nulle part : Spotlight, JARVIS, dictée, agents dans l'île) ;
IA_PREFERENCE pour l'ordre du mode auto (rapide, abonnements, local, jarvis).
Clés : ~/.config/nc/ia.conf (0600, jamais en argument ni dans un journal), sinon les variables d'environnement
habituelles (ANTHROPIC_API_KEY, OPENAI_API_KEY…). Aussi dans ia.conf : MODELE_<FOURNISSEUR> (nc-ia modele),
URL_<FOURNISSEUR> (une passerelle ou un serveur compatible, en HTTPS), OLLAMA_HOST.
Rien ne tourne en arrière-plan : une IA n'est appelée que sur demande.
"""
import base64
import contextlib
import http.client
import json
import os
from pathlib import Path
