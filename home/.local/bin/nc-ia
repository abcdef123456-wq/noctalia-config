NOMS_EN = {"ollama": "Ollama (on this PC)"}
APIS = [k for k, f in FOURNISSEURS.items() if f["genre"] == "api"]
CLIS = [k for k, f in FOURNISSEURS.items() if f["genre"] == "cli"]
# Ordre du mode automatique (IA_PREFERENCE)
ORDRES = {
    # Les API répondent le plus vite (premiers mots en moins d'une seconde), puis JARVIS, puis les programmes installés
    "rapide": APIS + ["jarvis"] + CLIS + ["ollama"],
    # Ce qui est déjà payé par un abonnement (Claude Code, Codex…) ou gratuit avant les API facturées à l'usage
    "abonnements": CLIS + ["ollama", "jarvis"] + APIS,
    # Rien ne sort du PC tant qu'Ollama répond
    "local": ["ollama"] + APIS + ["jarvis"] + CLIS,
    "jarvis": ["jarvis"] + APIS + CLIS + ["ollama"],
