# Anciennes valeurs de SPOTLIGHT_IA (« gemini » y était Gemini CLI) → fournisseur
ANCIENS = {"gemini": "gemini-cli", "assistant": "jarvis"}
# Pour les clés et les modèles (seules les API en ont) : « gemini » désigne l'API de Google
ALIAS_API = {"gemini": "google", "claude": "anthropic", "chatgpt": "openai"}


def nom(ident):
    if ident == "whisper":
        return T("Whisper (sur ce PC)", "Whisper (on this PC)")
    f = FOURNISSEURS.get(ident)
    return (NOMS_EN.get(ident) if EN else None) or (f["nom"] if f else ident)


# ── Clés (fichier 0600, jamais en argument) ─────────────────────────────────────────────────────────────────────
def lire_cles():
    res = {}
    try:
        for l in CLES.read_text(encoding="utf-8").splitlines():
            k, s, v = l.partition("=")
            if s and re.fullmatch(r"[A-Z0-9_]+", k.strip()):
                res[k.strip()] = v.strip()
    except OSError:
        pass
    return res


def ecrire_cles(d):
    CLES.parent.mkdir(parents=True, exist_ok=True)
    tmp = CLES.with_name(".ia.conf.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(T("# Clés d'API et modèles des IA (nc-ia cle, nc-ia modele). Privé : ne pas partager.\n",
                  "# AI API keys and models (nc-ai key, nc-ai model). Private: do not share.\n"))
        for k in sorted(d):
            if d[k]:
                f.write(f"{k}={d[k]}\n")
    os.chmod(tmp, 0o600)
    tmp.replace(CLES)


def cle(ident):
    """(clé, origine) ; origine : fichier, env ou ''."""
    f = FOURNISSEURS[ident]
    noms = (f["cle"],) + tuple(f.get("autres", ()))
    d = lire_cles()
    for n in noms:
        if d.get(n):
            return d[n], "fichier"
    for n in noms:
        if os.environ.get(n):
            return os.environ[n], "env"
    return "", ""


def masquer(c):
    return "…" + c[-4:] if len(c) > 8 else "…"


BASES = {"anthropic": "https://api.anthropic.com/v1", "google": "https://generativelanguage.googleapis.com/v1beta"}


def base(ident):
    """L'adresse de l'API : la sienne, ou URL_<FOURNISSEUR> de ia.conf (passerelle, serveur compatible) ; HTTPS
    obligatoire (HTTP seulement vers ce PC) : la clé ne circule jamais en clair sur le réseau."""
    u = lire_cles().get("URL_" + ident.upper().replace("-", "_"), "").rstrip("/")
    if u:
        h = urllib.parse.urlparse(u)
        if h.scheme == "https" or (h.scheme == "http" and h.hostname in ("127.0.0.1", "localhost", "::1")):
            return u
        raise ErreurIA(T(f"URL_{ident.upper()} doit commencer par https:// (http seulement vers ce PC).",
                         f"URL_{ident.upper()} must start with https:// (http only towards this PC)."))
    return BASES.get(ident) or FOURNISSEURS[ident]["url"]


def modele_choisi(ident):
    return lire_cles().get("MODELE_" + ident.upper().replace("-", "_"), "")


# ── Disponibilité (instantanée : aucune requête réseau sauf Ollama, en local et gardé 30 s) ───────────────────────
def ollama_url():
    h = lire_cles().get("OLLAMA_HOST") or os.environ.get("OLLAMA_HOST") or "http://127.0.0.1:11434"
    if not h.startswith("http"):
        h = "http://" + h
    return h.rstrip("/")


def ollama_present():
    memo = RUN / "ollama.json"
    try:
        d = json.loads(memo.read_text())
        if time.time() - d["t"] < 30 and d.get("url") == ollama_url():
            return d["ok"]
    except (OSError, ValueError, KeyError):
        pass
    u = urllib.parse.urlparse(ollama_url())
    try:
        with socket.create_connection((u.hostname or "127.0.0.1", u.port or 11434), timeout=0.25):
            ok = True
    except OSError:
        ok = False
    try:
        RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
        memo.write_text(json.dumps({"t": time.time(), "ok": ok, "url": ollama_url()}))
    except OSError:
        pass
    return ok


def en_ligne():
    """Vrai si une connexion internet est là (NetworkManager : ni « none » ni portail captif ; sans lui, une route par
    défaut). Gardé 5 s. Sans connexion, seules les IA de ce PC (Ollama local) restent proposées ; les autres reviennent
    d'elles-mêmes avec la connexion."""
    if os.environ.get("NC_IA_EN_LIGNE") in ("0", "1"):           # forcé (tests)
        return os.environ["NC_IA_EN_LIGNE"] == "1"
    memo = RUN / "en-ligne.json"
    try:
        d = json.loads(memo.read_text())
        if time.time() - d["t"] < 5:
            return d["ok"]
    except (OSError, ValueError, KeyError):
        pass
    ok = True
    if shutil.which("nmcli"):
        try:
            r = subprocess.run(["nmcli", "networking", "connectivity"], capture_output=True, text=True, timeout=3)
            ok = r.stdout.strip() not in ("none", "portal")
        except (OSError, subprocess.TimeoutExpired):
            ok = True
    else:
        try:
            ok = any(l.split()[1] == "00000000" for l in open("/proc/net/route").read().splitlines()[1:] if len(l.split()) > 1)
        except OSError:
            ok = True
    try:
        RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
        memo.write_text(json.dumps({"t": time.time(), "ok": ok}))
    except OSError:
        pass
    return ok


def locale(ident):
    """Une IA qui marche sans internet : Ollama sur ce PC."""
    return FOURNISSEURS[ident]["genre"] == "local" and urllib.parse.urlparse(ollama_url()).hostname in ("127.0.0.1", "localhost", "::1")


def disponible(ident):
    f = FOURNISSEURS[ident]
    if not locale(ident) and not en_ligne():
        return False
    if f["genre"] == "api":
        return bool(cle(ident)[0])
    if f["genre"] == "cli":
        return bool(shutil.which(f["prog"]))
    if f["genre"] == "jarvis":
        return (HOME / ".local/bin/nc-assistant").exists() and (CONFIG / "nc/assistant.conf").is_file()
    return ollama_present()


def mode():
    m = reglage("IA_MODE", "auto")
    return m if m in ("auto", "manuel", "non") else "auto"


def sur_batterie():
    """Vrai si le PC tourne sur batterie : aucune alimentation secteur (Mains, USB) branchée, et une batterie présente."""
    if os.environ.get("NC_POWER_SUPPLY") in ("batterie", "secteur"):     # forcé (tests), comme nc-paquets
        return os.environ["NC_POWER_SUPPLY"] == "batterie"
    batterie, secteur = False, False
    for d in Path("/sys/class/power_supply").glob("*"):
        try:
            t = (d / "type").read_text().strip()
            if t == "Battery":
                batterie = True
            elif t in ("Mains", "USB", "USB_C") and (d / "online").read_text().strip() == "1":
                secteur = True
        except OSError:
            continue
    return batterie and not secteur


def profil_energie():
    if os.environ.get("NC_PROFIL"):                                     # forcé (tests)
        return os.environ["NC_PROFIL"]
    code, t = sortie_cmd(["busctl", "get-property", "org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles",
                          "org.freedesktop.UPower.PowerProfiles", "ActiveProfile"], 3)
    return t.split('"')[1] if code == 0 and '"' in t else ""


def pause_economie():
    """En profil Économie sur batterie (IA_ECONOMIE, oui par défaut), l'IA qui tourne en arrière-plan (alertes, tout
    ce qui se lance tout seul : nc-ia --fond) se met en pause ; ce que tu lances toi-même marche toujours."""
    return reglage("IA_ECONOMIE", "oui") != "non" and sur_batterie() and profil_energie() == "power-saver"


FOND = False                              # appel d'arrière-plan (--fond, NC_IA_FOND=1) : en pause en Économie sur batterie


def coupee():
    return mode() == "non" or ((FOND or os.environ.get("NC_IA_FOND") == "1") and pause_economie())


def candidats(usage="question", force=""):
    """Les IA à essayer, dans l'ordre : une seule en manuel (ou --ia), toutes celles disponibles en auto."""
    if coupee():
        return []
    vision = usage == "image"
    if force:
        force = ANCIENS.get(force, force)
        if force not in FOURNISSEURS:
            raise ErreurIA(T(f"IA inconnue : {force}", f"Unknown AI: {force}"))
        return [force] if disponible(force) and (not vision or FOURNISSEURS[force]["vision"]) else []
    if mode() == "manuel":
        c = reglage("IA_CHOIX", "claude")
        c = ANCIENS.get(c, c)
        if c in FOURNISSEURS and disponible(c) and (not vision or FOURNISSEURS[c]["vision"]):
            return [c]
        if not (vision and c in FOURNISSEURS):     # le choix ne voit pas les images : on cherche quand même
            return []
    ordre = ORDRES.get(reglage("IA_PREFERENCE", "rapide"), ORDRES["rapide"])
    liste = [i for i in ordre if (not vision or FOURNISSEURS[i]["vision"]) and disponible(i)]
    # Une IA qui vient d'échouer (pas connectée, crédit épuisé…) passe en dernier pendant 10 min : elle ne retarde
    # plus chaque question, et revient d'elle-même en tête ensuite
    e = echecs()
    return sorted(liste, key=lambda i: i in e)


ECHECS = RUN / "echecs.json"


def echecs():
    try:
        d = json.loads(ECHECS.read_text())
        return {k for k, t in d.items() if time.time() - t < 600}
    except (OSError, ValueError, AttributeError):
        return set()


def noter_echec(ident, ok=False):
    try:
        d = json.loads(ECHECS.read_text())
    except (OSError, ValueError):
        d = {}
    if ok:
        if ident not in d:
            return
        d.pop(ident)
    else:
        d[ident] = time.time()
    try:
        RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
        ECHECS.write_text(json.dumps(d))
    except OSError:
        pass


# ── HTTP (bibliothèque standard ; jamais de redirection : la clé ne part que vers l'hôte prévu) ─────────────────
class _SansRedirection(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None


CONTEXTE = ssl.create_default_context()
OUVREUR = urllib.request.build_opener(_SansRedirection(), urllib.request.HTTPSHandler(context=CONTEXTE))


class _Tenue(http.client.HTTPConnection):
    """Une connexion qui confie sa socket à une GardeFlux dès qu'elle est ouverte : avant le TLS et les en-têtes, que
    l'échéance de tout l'appel borne donc aussi. Placée sous HTTPSConnection (son super().connect() est celui-ci)."""
    garde = None

    def connect(self):
        super().connect()
        self.garde.tenir(self.sock)


class _Ouverture:
    def __init__(self, garde, **k):
        super().__init__(**k)
        self.garde = garde

    def do_open(self, classe, req, **k):
        bases = (_Tenue,) if classe is http.client.HTTPConnection else (classe, _Tenue)
        return super().do_open(type("Connexion", bases, {"garde": self.garde}), req, **k)


class _HTTPTenu(_Ouverture, urllib.request.HTTPHandler):
    pass


class _HTTPSTenu(_Ouverture, urllib.request.HTTPSHandler):
    pass


def message_http(e, ident):
    try:
        corps = e.read(20000).decode("utf-8", "replace")
        d = json.loads(corps)
        m = d.get("error", d)
        m = m.get("message") if isinstance(m, dict) else m
        detail = str(m or "")[:200]
    except Exception:
        detail = ""
    if e.code in (401, 403):
        return T(f"clé refusée par {nom(ident)} (nc-ia cle {ident})", f"key refused by {nom(ident)} (nc-ai key {ident})")
    if e.code == 429:
        return T("limite atteinte ou crédit épuisé", "rate limit reached or credit exhausted") + (f" : {detail}" if detail else "")
    if e.code == 404:
        return T(f"modèle introuvable (nc-ia modele {ident} NOM)", f"model not found (nc-ai model {ident} NAME)") + (f" : {detail}" if detail else "")
    return f"HTTP {e.code}" + (f" : {detail}" if detail else "")


def requete(ident, url, corps=None, entetes=None, delai=120, garde=None):
    """garde : une GardeFlux, qui tient la connexion dès son ouverture (échéance de tout l'appel)."""
    ouvreur = OUVREUR if garde is None else \
        urllib.request.build_opener(_SansRedirection(), _HTTPTenu(garde), _HTTPSTenu(garde, context=CONTEXTE))
    data = json.dumps(corps).encode() if corps is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if data is not None else "GET",
                                 headers={"Content-Type": "application/json", "User-Agent": "noctalia-config nc-ia",
                                          **(entetes or {})})
    try:
        return ouvreur.open(req, timeout=delai)
    except urllib.error.HTTPError as e:
        raise ErreurIA(message_http(e, ident))
    except (urllib.error.URLError, OSError, http.client.HTTPException) as e:     # BadStatusLine : pas de HTTP
        raison = " ".join(str(getattr(e, "reason", e)).split()) or type(e).__name__
        raise ErreurIA(T("connexion impossible", "cannot connect") + f" ({raison[:120]})")


# ── Échéances ──────────────────────────────────────────────────────────────────────────────────────────────────
# Pour tout un appel, en plus de chaque lecture (120 s, 300 s pour Ollama) : un serveur qui envoie un octet toutes les
# 25 s tenait l'appel sans fin (revue B2-06). Une API : 10 min ; sa réponse la plus longue (16 000 jetons chez
# Anthropic, 8 000 ailleurs) arrive bien avant, même à 30 jetons/s (9 min) : une longue réponse qui avance n'est pas
# coupée. Ollama : 15 min ; il peut charger son modèle (jusqu'à 5 min) puis écrire lentement sur le processeur, sans
# limite de longueur. NC_IA_DELAI_TOTAL : la même valeur pour les deux, en secondes.
def delai_total(ident):
    if os.environ.get("NC_IA_DELAI_TOTAL"):
        return float(os.environ["NC_IA_DELAI_TOTAL"])
    return 900.0 if FOURNISSEURS[ident]["genre"] == "local" else 600.0


# En arrière-plan (--fond, NC_IA_FOND=1 : rapports, automatismes), le relais du mode auto a 10 min en tout : le temps
# d'une IA lente, pas d'une cascade (5 programmes muets : 5 × 3 min ; avec les API, JARVIS et Ollama, plus d'une heure).
# Ce que tu lances toi-même garde le relais complet, chaque IA avec son délai : personne n'attend un automatisme, toi
# si, et tu peux l'arrêter (Échap). NC_IA_DELAI_FOND, en secondes.
DELAI_FOND = float(os.environ.get("NC_IA_DELAI_FOND", 600))
ECHEANCE = None              # fin du relais en arrière-plan (horloge monotone), posée par demander()


def en_fond():
    return FOND or os.environ.get("NC_IA_FOND") == "1"


def borne(delai):
    """Le délai d'un appel, raccourci à ce qui reste du relais en arrière-plan ; vrai si c'est ce reste qui borne."""
    if ECHEANCE is None:
        return delai, False
    reste = max(0.0, ECHEANCE - time.monotonic())
    return (reste, True) if reste < delai else (delai, False)


def duree(s):
    return f"{s / 60:g} min" if s >= 60 and s % 60 == 0 else f"{s:g} s"


def avant_lancement(propre):
    """borne(), avant de lancer quoi que ce soit (programme, requête) : plus de temps, rien n'est lancé."""
    delai, globale = borne(propre)
    if delai <= 0:
        raise erreur_delai(propre, globale)
    return delai, globale


def erreur_delai(propre, globale):
    if globale:
        return ErreurDelai(T("délai dépassé : le temps de l'IA d'arrière-plan est écoulé", "timed out: background AI time is up"),
                           True)
    return ErreurDelai(T(f"délai dépassé : pas de réponse complète en {duree(propre)}",
                         f"timed out: no complete answer within {duree(propre)}"))


class GardeFlux:
    """Ferme la connexion à l'échéance de tout l'appel, armée avant la requête : une lecture en cours (TLS, en-têtes,
    une ligne qui arrive octet par octet) s'arrête aussitôt. La connexion est tenue par une copie de son descripteur,
    fermée à la fin : jamais celle d'un autre. threading.Timer attend sur une horloge monotone (une heure changée ne
    l'avance ni ne la recule). Seule l'ouverture TCP n'est bornée que par la limite de la socket (min(lecture, total))."""
    def __init__(self, delai):
        self.depasse = False
        self.verrou = threading.Lock()
        self.s = None
        self.t = threading.Timer(max(0.0, delai), self._couper)
        self.t.daemon = True
        self.t.start()

    def tenir(self, sock):
        with self.verrou:
            try:
                s = socket.socket(fileno=os.dup(sock.fileno()))
            except (OSError, ValueError, AttributeError):
                return                           # sans elle, l'échéance est vue entre deux lignes
            if self.s:
                self.s.close()
            self.s = s
            if self.depasse:                     # ouverte après l'échéance
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    def _couper(self):
        with self.verrou:
            self.depasse = True
            if self.s:
                try:
                    self.s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    def fin(self):
        self.t.cancel()
        with self.verrou:
            if self.s:
                self.s.close()
                self.s = None


def flux_borne(ident, url, corps, entetes=None, delai=120):
    """Les lignes brutes d'une réponse en flux (API, Ollama) : MAX_REPONSE octets au plus, et une échéance pour tout
    l'appel (delai_total, raccourcie au reste du relais en arrière-plan) ; ErreurDelai quand elle coupe."""
    propre = delai_total(ident)
    total, globale = avant_lancement(propre)
    garde = GardeFlux(total)
    try:
        r = requete(ident, url, corps, entetes, min(delai, total), garde)
    except BaseException as e:
        garde.fin()
        if garde.depasse and isinstance(e, ErreurIA):    # coupée à l'échéance avant la fin des en-têtes
            raise erreur_delai(propre, globale) from None
        raise
    lu = 0
    try:
        for brut in r:
            lu += len(brut)
            if garde.depasse or lu > MAX_REPONSE:
                break
            yield brut
    except (OSError, ValueError, http.client.HTTPException) as e:
        if not garde.depasse:                    # connexion fermée à l'échéance : dit plus bas
            if isinstance(e, http.client.HTTPException):
                raise ErreurIA(T("connexion coupée", "connection lost") + f" ({type(e).__name__})") from None
            raise
    finally:
        garde.fin()
        r.close()
    if garde.depasse:                            # fermée à l'échéance, la fin ressemble à une réponse finie
        raise erreur_delai(propre, globale)


def lignes_sse(lignes):
    """Les données d'un flux d'événements (data: …), décodées en JSON."""
    for brut in lignes:
        l = brut.decode("utf-8", "replace").strip()
        if not l.startswith("data:"):
            continue
        l = l[5:].strip()
        if l == "[DONE]":
            break
        try:
            yield json.loads(l)
        except ValueError:
            continue


def image_b64(chemin):
    data = Path(chemin).read_bytes()
    if len(data) > 15 * 1024 * 1024:
        raise ErreurIA(T("image trop grande", "image too large"))
    ext = Path(chemin).suffix.lower().lstrip(".")
    mime = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp", "gif": "image/gif"}.get(ext, "image/png")
    return mime, base64.b64encode(data).decode()


# ── Modèle : celui choisi, sinon le meilleur rapide de la liste du fournisseur (gardée une semaine) ─────────────
def version(m):
    return tuple(int(x) for x in re.findall(r"\d+", m)[:3])


def liste_modeles(ident):
    memo = CACHE / "ia-modeles.json"
    try:
        d = json.loads(memo.read_text())
    except (OSError, ValueError):
        d = {}
    e = d.get(ident)
    if e and time.time() - e.get("t", 0) < 7 * 86400:
        return e["ids"]
    c = cle(ident)[0]
    try:
        if ident == "google":
            r = requete(ident, base("google") + "/models?pageSize=200", entetes={"x-goog-api-key": c}, delai=8)
            ids = [m["name"].split("/", 1)[-1] for m in json.loads(r.read(MAX_REPONSE)).get("models", [])
                   if "generateContent" in m.get("supportedGenerationMethods", [])]
        else:
            r = requete(ident, base(ident) + "/models", entetes={"Authorization": "Bearer " + c}, delai=8)
            ids = [m["id"] for m in json.loads(r.read(MAX_REPONSE)).get("data", []) if isinstance(m, dict) and m.get("id")]
    except (ErreurIA, ValueError, KeyError):
        return []
    d[ident] = {"t": time.time(), "ids": ids}
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        memo.write_text(json.dumps(d))
    except OSError:
        pass
    return ids


def modele(ident):
    m = modele_choisi(ident) or FOURNISSEURS[ident].get("modele")
    if m:
        return m
    ids = liste_modeles(ident)
    if ident == "openai":
        mini = [i for i in ids if re.fullmatch(r"gpt-\d+(\.\d+)?-mini", i)]
        return max(mini, key=version) if mini else "gpt-4o-mini"
    if ident == "google":
        flash = [i for i in ids if re.fullmatch(r"gemini-\d+(\.\d+)?-flash", i)]
        return max(flash, key=version) if flash else "gemini-flash-latest"
    if ident == "groq":
        for p in ("llama-3.3-70b-versatile", "llama-3.1-8b-instant"):
            if p in ids:
                return p
        return ids[0] if ids else "llama-3.3-70b-versatile"
    return ids[0] if ids else ""


def modele_ollama():
    m = modele_choisi("ollama")
    if m:
        return m
    r = requete("ollama", ollama_url() + "/api/tags", delai=3)
    mods = json.loads(r.read(MAX_REPONSE)).get("models", [])
    if not mods:
        raise ErreurIA(T("aucun modèle dans Ollama (ollama pull llama3.2)", "no model in Ollama (ollama pull llama3.2)"))
    mods.sort(key=lambda m: m.get("modified_at", ""), reverse=True)
    return mods[0]["name"]


# ── Les appels (chacun : générateur de morceaux de texte) ────────────────────────────────────────────────────────
def appel_anthropic(consigne, texte, image, usage):
    c = cle("anthropic")[0]
    contenu = [{"type": "text", "text": texte}]
    if image:
        mime, b64 = image_b64(image)
        contenu.insert(0, {"type": "image", "source": {"type": "base64", "media_type": mime, "data": b64}})
    m = modele("anthropic")
    corps = {"model": m, "max_tokens": 16000, "stream": True, "system": consigne,
             "messages": [{"role": "user", "content": contenu}]}
    entetes = {"x-api-key": c, "anthropic-version": "2023-06-01"}
    # Effort bas : une réponse courte de bureau, sans longue réflexion (modèles qui le comprennent)
    if re.match(r"claude-(opus|sonnet|haiku|fable)-[5-9]", m):
        corps["output_config"] = {"effort": "low"}
    # Un refus d'une catégorie sensible est relancé par Anthropic sur le modèle prévu pour elle
    if m in ("claude-opus-5-5", "claude-opus-5", "claude-fable-5-1", "claude-fable-5", "claude-sonnet-5-5"):
        corps["fallbacks"] = "default"
        entetes["anthropic-beta"] = "server-side-fallback-2026-07-01"
    for e in lignes_sse(flux_borne("anthropic", base("anthropic") + "/messages", corps, entetes)):
        if e.get("type") == "content_block_delta" and (e.get("delta") or {}).get("type") == "text_delta":
            yield e["delta"].get("text", "")
        elif e.get("type") == "message_delta" and (e.get("delta") or {}).get("stop_reason") == "refusal":
            yield "\n" + T("(Claude a refusé de répondre à cette demande.)", "(Claude declined to answer this request.)")
        elif e.get("type") == "error":
            raise ErreurIA(str((e.get("error") or {}).get("message", "erreur"))[:200])


def appel_compatible(ident, consigne, texte, image, usage):
    """OpenAI et les API au même format (Mistral, Groq, DeepSeek, OpenRouter)."""
    f = FOURNISSEURS[ident]
    c = cle(ident)[0]
    contenu = texte
    if image:
        mime, b64 = image_b64(image)
        contenu = [{"type": "text", "text": texte}, {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{b64}"}}]
    corps = {"model": modele(ident), "stream": True,
             "messages": [{"role": "system", "content": consigne}, {"role": "user", "content": contenu}]}
    # Les modèles récents d'OpenAI refusent max_tokens (raisonnement) : max_completion_tokens
    corps["max_completion_tokens" if ident == "openai" else "max_tokens"] = 8000
    entetes = {"Authorization": "Bearer " + c}
    if ident == "openrouter":
        entetes.update({"HTTP-Referer": "https://github.com/noctalia-config", "X-Title": "noctalia-config"})
    for e in lignes_sse(flux_borne(ident, base(ident) + "/chat/completions", corps, entetes)):
        for ch in e.get("choices") or []:
            t = (ch.get("delta") or {}).get("content")
            if t:
                yield t
        if e.get("error"):
            raise ErreurIA(str(e["error"].get("message", e["error"]))[:200])


def appel_gemini(consigne, texte, image, usage, audio=None):
    c = cle("google")[0]
    parts = [{"text": texte}]
    if audio:
        parts.insert(0, {"inline_data": {"mime_type": "audio/wav", "data": audio}})
    if image:
        mime, b64 = image_b64(image)
        parts.insert(0, {"inline_data": {"mime_type": mime, "data": b64}})
    corps = {"system_instruction": {"parts": [{"text": consigne}]}, "contents": [{"role": "user", "parts": parts}]}
    url = f"{base('google')}/models/{urllib.parse.quote(modele('google'))}:streamGenerateContent?alt=sse"
    for e in lignes_sse(flux_borne("google", url, corps, {"x-goog-api-key": c})):
        for cand in e.get("candidates") or []:
            for p in (cand.get("content") or {}).get("parts") or []:
                if p.get("text") and not p.get("thought"):
                    yield p["text"]


def appel_ollama(consigne, texte, image, usage):
    msg = {"role": "user", "content": texte}
    if image:
        msg["images"] = [image_b64(image)[1]]
    corps = {"model": modele_ollama(), "stream": True, "messages": [{"role": "system", "content": consigne}, msg]}
    for brut in flux_borne("ollama", ollama_url() + "/api/chat", corps, delai=300):
        try:
            e = json.loads(brut)
        except ValueError:
            continue
        if e.get("error"):
            raise ErreurIA(str(e["error"])[:200])
        t = (e.get("message") or {}).get("content")
        if t:
            yield t
        if e.get("done"):
            break


# Ce qu'un moteur en ligne de commande reçoit de l'environnement de nc-ia : une liste blanche, et SA clé seulement. Tout le
# reste (GITHUB_TOKEN, clés des autres fournisseurs, AWS_*, SSH_AUTH_SOCK…) n'y entre pas.
ENV_COMMUN = {"PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "TZ", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "http_proxy",
              "https_proxy", "all_proxy", "no_proxy", "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS"}
ENV_MOTEUR = {
    "claude": {"ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN"},
    "codex": {"OPENAI_API_KEY", "CODEX_API_KEY", "OPENAI_BASE_URL"},
    "gemini-cli": {"GEMINI_API_KEY", "GOOGLE_API_KEY", "GOOGLE_GENAI_USE_VERTEXAI", "GOOGLE_GENAI_USE_GCA",
                   "GOOGLE_CLOUD_PROJECT", "GOOGLE_CLOUD_LOCATION"},
    # Qwen Code parle le protocole d'OpenAI : il lit OPENAI_API_KEY / OPENAI_BASE_URL (vérifié dans son code)
    "qwen": {"DASHSCOPE_API_KEY", "QWEN_API_KEY", "OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL"},
    # OpenCode sait parler à plusieurs fournisseurs : les clés des principaux, la sienne éventuelle
    "opencode": {"OPENCODE_API_KEY", "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GEMINI_API_KEY", "GOOGLE_GENERATIVE_AI_API_KEY",
                 "OPENROUTER_API_KEY", "GROQ_API_KEY", "MISTRAL_API_KEY", "DEEPSEEK_API_KEY", "XAI_API_KEY"},
}


def env_cli(ident=None):
    # NC_ILE_SANS : ses hooks ne l'affichent pas dans l'île comme une session de travail
    gardes = ENV_COMMUN | ENV_MOTEUR.get(ident, set())
    env = {k: v for k, v in os.environ.items() if k in gardes or k.startswith("LC_")}
    env.update(NC_ILE_SANS="1", NO_COLOR="1", MAX_THINKING_TOKENS="0", TERM="dumb")
    if ident == "claude":
        env["DISABLE_AUTOUPDATER"] = "1"                # pas de mise à jour automatique lancée par une simple question
    return env


# ── Le bac des IA en ligne de commande ────────────────────────────────────────────────────────────────────────────
# Claude Code, Codex, OpenCode, Gemini CLI et Qwen Code tournent tous dans le MÊME bac à sable que la session de
# confiance de nc-noeud (module nc-bac : unité systemd --user, ~ en lecture seule, secrets illisibles, /tmp privé,
# aucun autre processus visible, ni ptrace ni trousseau, tout $XDG_RUNTIME_DIR inaccessible). Différences voulues :
#  - le réseau reste ouvert (AF_INET et AF_INET6 : ils joignent leur API) ; pas d'AF_UNIX : la résolution des noms
#    passe par /etc/resolv.conf (UDP) quand nss-resolve, qui parle par un socket unix, est refusé ;
#  - 127.0.0.1 reste joignable (services locaux de ta machine), et /dev/shm est partagé avec le reste du système ;
#  - chaque moteur travaille dans un FAUX dossier personnel (voir plus bas) : ses vrais dossiers, ceux des autres
#    moteurs, ~/.ssh, ~/.config/nc (clés d'API de nc-ia)… sont illisibles ; le reste de ~ se lit mais ne s'écrit pas ;
#  - seuls inscriptibles : un dossier de travail vide, créé pour la demande, et ce faux dossier personnel. Tous deux sont
#    jetés après la demande ; seul un jeton rafraîchi revient dans le vrai fichier.
# Sans bac (systemd-run absent, systemd < 257, namespaces refusés) : les moteurs ne sont pas lancés, sauf si tu as
# autorisé le repli (IA_BAC_REPLI=oui) : alors seules leurs limites propres s'appliquent (« nc-ia etat » le dit).
# Chaque moteur tourne dans un FAUX dossier personnel, jeté après la demande (HOME y pointe) : on y COPIE ce dont il a
# besoin (copie : sa config ; jeton : ses identifiants). Ses vrais dossiers (~/.claude, ~/.codex, ~/.gemini, ~/.qwen,
# ~/.config/opencode, ~/.local/share/opencode) restent illisibles ET en lecture seule dans le bac : rien de ce qu'il
# crée (hooks, commandes, agents, règles, AGENTS.md, scripts de shell, mémoire, serveurs MCP de ~/.claude.json…) ne peut
# survivre à la demande ni être exécuté plus tard hors du bac. Seul un jeton rafraîchi revient dans le vrai fichier,
# après la demande, s'il est resté un JSON valide et si le vrai fichier n'a pas changé entre-temps (retour_etat).
ETAT_MOTEURS = {
    "claude": dict(copie=[".claude.json", ".claude/settings.json", ".claude/CLAUDE.md"], jeton=[".claude/.credentials.json"]),
    "codex": dict(copie=[], jeton=[".codex/auth.json"]),
    "gemini-cli": dict(copie=[".gemini/settings.json", ".gemini/google_accounts.json"], jeton=[".gemini/oauth_creds.json"]),
    "qwen": dict(copie=[".qwen/settings.json"], jeton=[".qwen/oauth_creds.json"]),
    "opencode": dict(copie=[".config/opencode/opencode.json", ".config/opencode/opencode.jsonc"],
                     jeton=[".local/share/opencode/auth.json"]),
}
COPIE_MAX = 16 * 1024 * 1024
JETON_MAX = 256 * 1024
# Variables d'environnement qui ne sont pas transmises à l'unité (propres à la session de nc-ia ou à systemd)
ENV_BAC_SANS = {"_", "PWD", "OLDPWD", "SHLVL", "INVOCATION_ID", "JOURNAL_STREAM", "MAINPID", "MANAGERPID", "NOTIFY_SOCKET",
                "SYSTEMD_EXEC_PID", "LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES", "WATCHDOG_PID", "WATCHDOG_USEC"}
_BAC = {"module": None, "tient": None}
UNITE_PREFIXE = "nc-ia-"                     # (les tests du vrai bac prennent « nc-ia-test- » pour nettoyer sans toucher aux autres)


def module_bac():
    import importlib.machinery
    import importlib.util
    if _BAC["module"] is None:
        chemin = Path(__file__).resolve().parent / "nc-bac"
        l = importlib.machinery.SourceFileLoader("nc_bac", str(chemin))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader("nc_bac", l))
        l.exec_module(m)
        _BAC["module"] = m
    return _BAC["module"]


def dossier_etat_ia():
    return Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "nc-ia"


def env_bac(env):
    return [k for k, v in env.items() if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k) and k not in ENV_BAC_SANS
            and "\n" not in v and "\0" not in v]


def argv_bac(ident, cmd, cwd, delai, env=(), unite=None, sonde=False, ecrire=()):
    """La commande systemd-run qui lance cmd (liste) dans le bac pour ce moteur, ou None si c'est impossible. Seuls
    inscriptibles : le dossier de travail et ecrire (le faux dossier personnel du moteur). Aucun de ses vrais dossiers
    n'est laissé lisible."""
    try:
        bac = module_bac()
    except (OSError, SyntaxError, ImportError):
        return None
    ecriture = [] if sonde else [str(cwd)] + [str(x) for x in ecrire]
    return bac.argv(cmd, cwd, delai + 10, home=HOME, reglage=reglage, programme=shutil.which, ecriture=ecriture,
                    lecture_seule=(), libres=(), env=env, unite=unite, description="nc-ia")


def bac_disponible():
    """Le bac se met-il en place ici ? Une sonde avec les mêmes propriétés et une commande inoffensive, faite une fois
    par lancement. Seul le SUCCÈS est gardé 5 minutes dans XDG_RUNTIME_DIR : un échec passager (bus pas encore là, unité
    qui traîne) ne doit pas retirer le bac à tous les moteurs pendant 5 minutes. NC_IA_BAC=non : pas de bac (essais)."""
    if _BAC["tient"] is not None:
        return _BAC["tient"]
    ok = False
    argv = argv_bac("", ["true"], str(HOME), 10, sonde=True) if os.environ.get("NC_IA_BAC") != "non" else None
    if argv:
        run = os.environ.get("XDG_RUNTIME_DIR")
        memo = Path(run) / "nc-ia-bac" if run else None
        try:
            if memo and time.time() - memo.stat().st_mtime < 300 and memo.read_text() == "1":
                _BAC["tient"] = True
                return True
        except OSError:
            pass
        try:
            ok = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=12).returncode == 0
        except (subprocess.TimeoutExpired, OSError):
            ok = False
        try:
            if memo and ok:
                memo.write_text("1")
            elif memo:
                memo.unlink(missing_ok=True)
        except OSError:
            pass
    _BAC["tient"] = ok
    return ok


def bac_repli_permis():
    """IA_BAC_REPLI=oui : tu acceptes que les moteurs en ligne de commande tournent SANS bac quand il ne tient pas ici
    (alors seules leurs limites propres s'appliquent : Codex peut lire tes fichiers). Non par défaut."""
    return reglage("IA_BAC_REPLI", "non") == "oui"


def refus_bac(invalide=False):
    if invalide:
        return ErreurIA(T("NOEUD_BAC_INTERDITS ne convient pas (chemin absolu, « .. », guillemet…) : le bac des IA n'est pas mis en place, rien n'est lancé. Corrige-le dans nc-reglages.",
                          "NOEUD_BAC_INTERDITS is not valid (absolute path, \"..\", quote…): the AI sandbox is not set up, nothing was run. Fix it in nc-settings."))
    return ErreurIA(T("le bac des IA n'est pas disponible ici ; choisis une IA par API ou autorise le repli dans nc-reglages (IA_BAC_REPLI)",
                      "the AI sandbox is not available here; pick an API AI or allow the fallback in nc-settings (IA_BAC_REPLI)"))


def dossier_temporaire(prefixe="nc-ia-", sous="travail"):
    """Un dossier vide pour cette demande, TOUJOURS dans l'état de nc-ia (~/.local/state) : avec le bac, /tmp est privé ;
    sans lui, /tmp est commun à tous les comptes, où un autre pourrait déposer un CLAUDE.md ou un AGENTS.md que le moteur
    lirait. Le dossier parent est à toi seul (0700)."""
    base = dossier_etat_ia() / sous
    base.mkdir(parents=True, exist_ok=True)
    with contextlib.suppress(OSError):
        os.chmod(dossier_etat_ia(), 0o700)
    return tempfile.mkdtemp(prefix=prefixe, dir=str(base))


def preparer_etat(ident):
    """Le faux dossier personnel du moteur (voir ETAT_MOTEURS) et la fonction qui rapporte son jeton rafraîchi. Retourne
    (dossier, retour) ; retour() se lance quand le moteur est fini, avant la suppression du dossier."""
    c = ETAT_MOTEURS.get(ident, dict(copie=[], jeton=[]))
    h = Path(dossier_temporaire("nc-ia-home-", "etat"))
    os.chmod(h, 0o700)
    avant = {}
    for rel in c["copie"] + c["jeton"]:
        src, dst = HOME / rel, h / rel
        try:
            if not src.is_file() or src.stat().st_size > (JETON_MAX if rel in c["jeton"] else COPIE_MAX):
                continue
            octets = src.read_bytes()
            dst.parent.mkdir(parents=True, exist_ok=True)
            fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(octets)
        except OSError:
            continue
        if rel in c["jeton"]:
            avant[rel] = octets

    def retour():
        for rel, octets in avant.items():
            try:
                neuf = (h / rel).read_bytes() if (h / rel).is_file() and (h / rel).stat().st_size <= JETON_MAX else None
                if neuf is None or neuf == octets or not isinstance(json.loads(neuf), dict):
                    continue
                reel = Path(os.path.realpath(HOME / rel))
                if reel.read_bytes() != octets:                 # changé entre-temps (une session de ton côté) : on n'écrase pas
                    continue
                tmp = reel.with_name(reel.name + ".nc-ia-tmp")
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, stat_mode(reel))
                with os.fdopen(fd, "wb") as f:
                    f.write(neuf)
                os.replace(tmp, reel)
            except (OSError, ValueError):
                continue
    return str(h), retour


def stat_mode(p):
    try:
        return os.stat(p).st_mode & 0o777 or 0o600
    except OSError:
        return 0o600


IMAGE_MAX = 20 * 1024 * 1024


def copier_image(image, travail):
    """L'image jointe copiée dans le dossier de travail : un fichier ordinaire seulement, de taille raisonnable."""
    import stat as st
    try:
        s = os.stat(image)
    except OSError as e:
        raise ErreurIA(T(f"Image illisible : {e.strerror}", f"Unreadable image: {e.strerror}")) from None
    if not st.S_ISREG(s.st_mode) or s.st_size > IMAGE_MAX:
        raise ErreurIA(T("L'image doit être un fichier ordinaire de 20 Mo au plus.", "The image must be a regular file of 20 MB or less."))
    dest = str(Path(travail) / ("image" + Path(image).suffix))
    shutil.copyfile(image, dest)
    return dest


def lancer_programme(ident, cmd, env, travail, err, delai, entree=None):
    """Popen du moteur d'IA, dans le bac. Si le bac ne tient pas, le moteur n'est PAS lancé (message clair), sauf si tu
    as autorisé le repli (IA_BAC_REPLI=oui) : alors seules ses limites propres s'appliquent. Un bac qui devait tenir mais
    dont la commande ne se construit pas (module illisible, chemin avec guillemet) refuse aussi : jamais hors du bac
    sans ton accord. entree : l'invite, passée par l'entrée standard (pas dans la ligne de commande, donc ni dans la
    liste des processus ni dans le journal du gestionnaire). La sortie arrive ligne par ligne dans tous les cas."""
    try:
        invalide = module_bac().perso(reglage) is None
    except (OSError, SyntaxError, ImportError):
        invalide = False
    if invalide:
        raise refus_bac(True)
    p = None
    stdin = subprocess.PIPE if entree is not None else subprocess.DEVNULL
    if bac_disponible():
        unite = UNITE_PREFIXE + os.urandom(6).hex()
        argv = argv_bac(ident, cmd, travail, delai, env=env_bac(env), unite=unite, ecrire=[env["HOME"]])
        if argv is None:
            raise refus_bac()
        # systemd-run doit joindre le bus de l'utilisateur ; ces deux variables n'entrent PAS dans l'unité (env_bac)
        penv = dict(env)
        for k in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
            if k in os.environ:
                penv[k] = os.environ[k]
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=err, stdin=stdin, text=True, env=penv,
                             cwd=travail, start_new_session=True)
        p.nc_unite = unite + ".service"
    elif bac_repli_permis():
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err, stdin=stdin, text=True, env=env,
                             cwd=travail, start_new_session=True)
    else:
        raise refus_bac()
    if entree is not None:
        def ecrire():
            try:
                p.stdin.write(entree)
            except OSError:
                pass
            finally:
                with contextlib.suppress(OSError):
                    p.stdin.close()
        threading.Thread(target=ecrire, daemon=True).start()
    return p


def arreter_unite(p):
    """systemd-run tué, l'unité continuerait jusqu'à RuntimeMaxSec : on l'arrête aussi."""
    u = getattr(p, "nc_unite", None)
    if u:
        try:
            subprocess.run(["systemctl", "--user", "stop", u], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5)
        except (subprocess.TimeoutExpired, OSError):
            pass


def derniere_ligne(f):
    f.seek(0)
    l = [re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", x).strip() for x in f.read()[-20000:].splitlines()]
    l = [x for x in l if x]
    return l[-1][:200] if l else ""


DELAI_CLI = float(os.environ.get("NC_IA_DELAI_CLI", 180))   # au plus, pour toute la réponse d'un programme


class GardeTemps:
    """Arrête le programme à l'échéance, même s'il garde sa sortie ouverte sans rien écrire (revue Codex IA-04) : son
    propre groupe de processus seulement (lancé avec start_new_session), jamais une autre session."""
    def __init__(self, p, delai, globale=False):
        self.depasse = False
        self.p = p
        # Son délai, ou ce qui reste du relais en arrière-plan (globale : ce reste a coupé, pas le sien), lu par
        # avant_lancement() avant de lancer le programme
        self.propre, self.globale = DELAI_CLI, globale
        self.t = threading.Timer(delai, self._arreter)
        self.t.daemon = True
        self.t.start()
        # Le programme fini, un sous-processus peut garder sa sortie ouverte : la lecture attendrait l'échéance, dite
        # « délai dépassé » et notée en échec alors qu'il a répondu (revue B2-05). Sa fin attendue à part ; 2 s après
        # (le temps de lire ce qu'il a écrit), son groupe est arrêté, ce qui ferme la sortie
        self.fini = threading.Event()
        threading.Thread(target=self._apres_sa_fin, daemon=True).start()

    def _apres_sa_fin(self):
        self.p.wait()
        self.t.cancel()                          # fini à temps : plus d'échéance
        if not self.fini.wait(2):
            arreter_groupe(self.p)

    def _arreter(self):
        self.depasse = True
        try:
            os.killpg(self.p.pid, 9)
        except OSError:
            pass
        arreter_unite(self.p)

    def fin(self):
        self.t.cancel()
        self.fini.set()


def arreter_groupe(p):
    """Le programme d'IA fini ou abandonné : ce qu'il a lancé dans son groupe (serveurs MCP, scripts) s'arrête aussi."""
    try:
        os.killpg(p.pid, 9)
    except OSError:
        pass
    arreter_unite(p)


def appel_claude(consigne, texte, image, usage):
    # Démarré à vide (ni extensions MCP, ni outils, ni historique) : presque deux fois plus rapide ; effort bas
    vide = ["--effort", "low", "--strict-mcp-config", "--disable-slash-commands", "--no-session-persistence"]
    travail = dossier_temporaire()
    home_moteur, retour = preparer_etat("claude")
    try:
        # Read limité au dossier de travail (où l'image est copiée) : « //chemin » = chemin absolu dans les règles de
        # permission de Claude Code ; un « Read » seul autorisait la lecture de tout le disque
        outils = ["--tools", "Read", "--allowedTools", f"Read(/{os.path.realpath(travail)}/**)"] if image else ["--tools", ""]
        img = copier_image(image, travail) if image else None
        invite = consigne + "\n\n" + texte + (f"\n\n{T('Image à analyser', 'Image to analyze')} : {img}" if img else "")
        cmd = ["claude", "-p", "--model", modele_choisi("claude") or FOURNISSEURS["claude"]["modele"]] + vide + outils + \
              ["--output-format", "stream-json", "--include-partial-messages", "--verbose"]
        yield from _appel_claude(cmd, travail, invite, home_moteur)
    finally:
        retour()
        shutil.rmtree(travail, ignore_errors=True)
        shutil.rmtree(home_moteur, ignore_errors=True)


def _appel_claude(cmd, travail, invite, home_moteur):
    delai, globale = avant_lancement(DELAI_CLI)
    err = tempfile.TemporaryFile(mode="w+")             # pas de tube : un programme bavard ne bloque jamais
    env = dict(env_cli("claude"), HOME=home_moteur)
    p = lancer_programme("claude", cmd, env, travail, err, delai, entree=invite)   # l'invite par stdin (claude -p le lit)
    garde = GardeTemps(p, delai, globale)
    rien = True
    try:
        for l in p.stdout:
            try:
                e = json.loads(l)
            except ValueError:
                continue
            d = (e.get("event") or {}).get("delta") or {}
            if e.get("type") == "stream_event" and d.get("type") == "text_delta":
                rien = False
                yield d.get("text", "")
            elif e.get("type") == "result":
                if e.get("is_error"):                   # même après un début de réponse : un échec (revue IA-03)
                    raise ErreurIA(str(e.get("result") or "Claude Code")[:200])
                if rien and e.get("result"):
                    rien = False
                    yield e["result"]
        p.wait(timeout=10)
        if garde.depasse:
            raise erreur_delai(garde.propre, garde.globale)
        if p.returncode != 0:
            raise ErreurIA(derniere_ligne(err) or T(f"Claude Code a échoué (code {p.returncode})", f"Claude Code failed (code {p.returncode})"))
        if rien:
            raise ErreurIA(derniere_ligne(err) or T("Claude Code n'a rien répondu", "Claude Code gave no answer"))
    finally:
        garde.fin()
        garde._arreter() if p.poll() is None else arreter_groupe(p)   # et ses sous-processus (revue IA-07)
        err.close()


# Outils qu'une simple question n'a jamais à utiliser, par programme (noms vérifiés dans le code de Gemini CLI 0.65 et
# de Qwen Code 0.26). Gemini : tools.exclude seulement ; invoke_agent (sous-agent) aussi, par prudence. Qwen : tools.exclude
# ET permissions.deny (fusionnés en union) ; monitor exécute des commandes, agent/task/create_sub_session/cron_create
# lancent d'autres agents ou des tâches. En -p, un outil à confirmer est refusé : le mode « default » suffit.
OUTILS_EXCLUS_GEMINI = ["run_shell_command", "write_file", "replace", "web_fetch", "google_web_search",
                        "tracker_create_task", "tracker_update_task", "tracker_add_dependency", "invoke_agent"]
OUTILS_EXCLUS_QWEN = ["run_shell_command", "monitor", "write_file", "edit", "notebook_edit", "save_memory", "manage_memory",
                      "web_fetch", "web_search", "agent", "task", "create_sub_session", "cron_create"]


def version_opencode(env):
    """Le numéro majeur d'OpenCode (opencode --version), ou None s'il n'est pas lisible. Jamais déduit de la sortie d'une
    demande : un texte venu d'ailleurs ne doit pas pouvoir changer la façon de lancer le programme."""
    try:
        r = subprocess.run(["opencode", "--version"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10,
                           env=env, cwd=str(HOME))
    except (subprocess.TimeoutExpired, OSError):
        return None
    m = re.search(r"(\d+)\.\d+", r.stdout) if r.returncode == 0 else None
    return int(m[1]) if m else None


def appel_programme(ident, consigne, texte, image, usage):
    """Codex, Gemini CLI, OpenCode, Qwen Code : la sortie du programme, ligne par ligne. Une question ne donne aucun
    droit d'agir : chacun est bridé (lecture seule, sans commande ni écriture ni web quand l'outil le permet) et lancé
    dans un dossier temporaire vide (l'image jointe y est copiée), jamais dans le dossier personnel, puis dans le bac
    commun quand il tient (voir ETAT_MOTEURS)."""
    invite = consigne + "\n\n" + texte
    avant_lancement(DELAI_CLI)                  # plus de temps : rien n'est lancé, pas même « opencode --version »
    travail = dossier_temporaire()
    home_moteur, retour = preparer_etat(ident)
    conf = None
    env = dict(env_cli(ident), HOME=home_moteur)
    entree = None
    try:
        img = copier_image(image, travail) if image else None
        if ident == "codex":
            # Bac à sable en lecture seule et jamais de demande d'accord (une commande qui voudrait sortir du bac échoue) ;
            # ni config de l'utilisateur (--ignore-user-config garde l'authentification : ses MCP, hooks, modèle et
            # règles ne comptent pas), ni règles, ni historique ; pas de recherche web, d'applis, de plugins, de
            # navigateur, d'ordinateur, de sous-agents ni de hooks (noms vérifiés avec « codex features list »)
            modele = modele_choisi("codex")
            cmd = ["codex", "exec", "-s", "read-only", "-c", 'approval_policy="never"', "-c", 'web_search="disabled"',
                   "--ignore-user-config", "--ignore-rules", "--ephemeral"]
            for f in ("apps", "plugins", "browser_use", "computer_use", "multi_agent", "hooks", "image_generation",
                      "skill_mcp_dependency_install", "tool_suggest", "remote_plugin", "shell_snapshot"):
                cmd += ["--disable", f]
            # « - » avant -i : -i prend plusieurs valeurs et avalerait l'invite
            cmd += ["--skip-git-repo-check", "--color", "never"] + (["-m", modele] if modele else []) + ["-"] + \
                   (["-i", img] if img else [])
            entree = invite                     # « - » : codex lit l'invite sur son entrée standard
        elif ident in ("gemini-cli", "qwen"):
            # Mode « default » imposé par le réglage système ET par l'option (jamais --yolo : sans cela un auto_edit ou un
            # yolo de ~/.gemini ou ~/.qwen, ou le mode « auto » de Qwen, s'appliquerait) ; outils d'écriture, de commande
            # et de web retirés par un fichier de réglages système, qui l'emporte. Ce fichier est dans un dossier voisin
            # du dossier de travail (que le programme peut écrire), jamais dedans
            conf = dossier_temporaire("nc-ia-conf-", "conf")
            reglages = Path(conf) / "reglages.json"
            if ident == "gemini-cli":
                conf_json = {"tools": {"exclude": OUTILS_EXCLUS_GEMINI}, "general": {"defaultApprovalMode": "default"}}
            else:
                # mcp.excluded "*" (glob documenté de Qwen) : aucun serveur MCP de l'utilisateur
                conf_json = {"tools": {"exclude": OUTILS_EXCLUS_QWEN, "approvalMode": "default"},
                             "permissions": {"deny": OUTILS_EXCLUS_QWEN}, "mcp": {"excluded": ["*"]}}
            reglages.write_text(json.dumps(conf_json))
            env["GEMINI_CLI_SYSTEM_SETTINGS_PATH" if ident == "gemini-cli" else "QWEN_CODE_SYSTEM_SETTINGS_PATH"] = str(reglages)
            if ident == "gemini-cli":
                # -e none : aucune extension ; --allowed-mcp-server-names avec un nom qui n'existe pas : aucun serveur MCP
                cmd = ["gemini", "--approval-mode", "default", "-e", "none", "--allowed-mcp-server-names", "nc-aucun",
                       "-p", invite + (f"\n\n@{Path(img).name}" if img else "")]
            else:
                cmd = ["qwen", "--approval-mode", "default", "-p", invite]
        else:
            # Un agent à nous dans la configuration en ligne (elle passe en dernier : une règle « allow » de
            # ~/.config/opencode ne peut pas la contredire), toute permission refusée : ni commande, ni écriture, ni web,
            # ni MCP. OpenCode 2 passe par un service en arrière-plan qui ne lit pas l'environnement de nc-ia : sans
            # --standalone (serveur privé dans ce processus) la configuration ne s'y appliquerait pas. La version est
            # lue UNE fois (opencode --version), jamais devinée depuis la sortie ; illisible : on ne lance pas
            v = version_opencode(env)
            if v is None:
                raise ErreurIA(T("OpenCode : version illisible (opencode --version), rien n'est lancé.",
                                 "OpenCode: unreadable version (opencode --version), nothing was run."))
            env["OPENCODE_CONFIG_CONTENT"] = json.dumps({"permission": {"*": "deny"},
                                                         "agent": {"nc-question": {"mode": "primary", "permission": {"*": "deny"}}}})
            env["OPENCODE_CONFIG_PROJECT_DISABLE"] = "1"                # nom de la version 2
            env["OPENCODE_DISABLE_PROJECT_CONFIG"] = "1"                # nom de la version 1 (la 2 accepte les deux)
            env["OPENCODE_DISABLE_CLAUDE_CODE"] = "1"                   # sinon il charge ~/.claude dans l'invite
            cmd = ["opencode", "run", "--agent", "nc-question"] + (["--standalone"] if v >= 2 else []) + [invite]
        yield from _lance_programme(ident, cmd, env, travail, entree)
    finally:
        retour()
        shutil.rmtree(travail, ignore_errors=True)
        shutil.rmtree(home_moteur, ignore_errors=True)
        if conf:
            shutil.rmtree(conf, ignore_errors=True)


def _lance_programme(ident, cmd, env, travail, entree=None):
    delai, globale = avant_lancement(DELAI_CLI)
    err = tempfile.TemporaryFile(mode="w+")
    p = lancer_programme(ident, cmd, env, travail, err, delai, entree=entree)
    garde = GardeTemps(p, delai, globale)
    rien = True
    try:
        for l in p.stdout:
            l = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", l)
            # lignes d'état d'opencode (« > build · modèle », outils…)
            if ident == "opencode" and re.match(r"^\s*(>|→|\$ ?cat|⚙)", l) and not l.startswith("$ "):
                continue
            if rien and not l.strip():
                continue
            rien = False
            yield l
        p.wait(timeout=10)
        if garde.depasse:
            raise erreur_delai(garde.propre, garde.globale)
        # Code d'erreur : un échec, même après un début de réponse (revue Codex IA-03)
        if p.returncode != 0:
            raise ErreurIA(derniere_ligne(err) or T(f"{nom(ident)} a échoué (code {p.returncode})", f"{nom(ident)} failed (code {p.returncode})"))
        if rien:
            raise ErreurIA(derniere_ligne(err) or T(f"{nom(ident)} n'a rien répondu", f"{nom(ident)} gave no answer"))
    finally:
        garde.fin()
        garde._arreter() if p.poll() is None else arreter_groupe(p)   # et ses sous-processus (revue IA-07)
        err.close()


CHOIX = []      # choix proposés par JARVIS pour la dernière réponse (issue #7) : une ligne {"choices": …} en flux


DELAI_JARVIS = float(os.environ.get("NC_IA_DELAI_JARVIS", 630))   # TIMEOUT de nc-assistant : jusqu'à 600 s, + la marge


def appel_jarvis(consigne, texte, image, usage):
    # Arrêté (échéance, ou nc-ia arrêté par Échap) : SIGTERM d'abord, nc-assistant dit « fin » à l'île ; un SIGKILL
    # direct la laissait sur « JARVIS réfléchit », et l'échéance de 300 s coupait un TIMEOUT réglé plus long (revue B2-13)
    delai, globale = avant_lancement(DELAI_JARVIS)
    with subprocess.Popen([sys.executable, str(HOME / ".local/bin/nc-assistant"), "demander", "--flux", "--",
                           consigne + "\n\n" + texte], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                          stdin=subprocess.DEVNULL) as p:
        try:
            sortie, erreur = p.communicate(timeout=delai)
        except subprocess.TimeoutExpired:
            if globale:
                raise erreur_delai(DELAI_JARVIS, True) from None
            raise ErreurDelai(T("JARVIS n'a pas répondu à temps", "JARVIS did not answer in time")) from None
        finally:
            if p.poll() is None:
                p.terminate()
                try:
                    p.wait(5)
                except subprocess.TimeoutExpired:
                    p.kill()
    if p.returncode != 0:
        raise ErreurIA((erreur.strip().splitlines() or ["JARVIS"])[-1][:200])
    try:
        d = json.loads(sortie.strip().splitlines()[-1])
    except (ValueError, IndexError):
        yield sortie.strip()                                    # ancien nc-assistant : du texte
        return
    CHOIX[:] = [c for c in d.get("choices") or [] if isinstance(c, str)][:5]
    yield str(d.get("t", "")).strip()


def appeler(ident, consigne, texte, image=None, usage="question"):
    g = FOURNISSEURS[ident]["genre"]
    if ident == "anthropic":
        return appel_anthropic(consigne, texte, image, usage)
    if ident == "google":
        return appel_gemini(consigne, texte, image, usage)
    if g == "api":
        return appel_compatible(ident, consigne, texte, image, usage)
    if g == "local":
        return appel_ollama(consigne, texte, image, usage)
    if g == "jarvis":
        return appel_jarvis(consigne, texte, image, usage)
    if ident == "claude":
        return appel_claude(consigne, texte, image, usage)
    return appel_programme(ident, consigne, texte, image, usage)


# ── Transcription d'un enregistrement (dictée sans JARVIS) ──────────────────────────────────────────────────────
TRANSCRIPTION = ["groq", "openai", "google"]          # Groq d'abord : Whisper, le plus rapide et le moins cher


def multipart(champs, fichier):
    """Corps multipart/form-data (bibliothèque standard) : champs texte et un fichier."""
    limite = "nc-ia-" + os.urandom(12).hex()
    morceaux = []
    for k, v in champs.items():
        morceaux.append(f'--{limite}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode())
    nom_f, data, mime = fichier
    morceaux.append(f'--{limite}\r\nContent-Disposition: form-data; name="file"; filename="{nom_f}"\r\n'
                    f'Content-Type: {mime}\r\n\r\n'.encode() + data + b"\r\n")
    morceaux.append(f"--{limite}--\r\n".encode())
    return b"".join(morceaux), "multipart/form-data; boundary=" + limite


def modele_whisper():
    """Un modèle whisper.cpp sur ce PC (dictée sans internet ni compte) : MODELE_WHISPER de ia.conf, sinon le premier
    trouvé dans ~/.local/share/nc/whisper ou les dossiers des paquets ; seulement si whisper-cli est installé."""
    if not shutil.which("whisper-cli"):
        return ""
    m = modele_choisi("whisper")
    if m and Path(m).expanduser().is_file():
        return str(Path(m).expanduser())
    for motif in (str(HOME / ".local/share/nc/whisper/ggml-*.bin"), "/usr/share/whisper.cpp-model-*/*.bin",
                  "/usr/share/whisper.cpp/models/ggml-*.bin", "/usr/share/whisper/ggml-*.bin"):
        import glob
        trouves = sorted(glob.glob(motif))
        if trouves:
            return trouves[0]
    return ""


def fournisseurs_transcription():
    if coupee():
        return []
    liste = [i for i in TRANSCRIPTION if cle(i)[0] and en_ligne()]
    if modele_whisper():
        # Sur ce PC : d'abord sans connexion, ou si « Sur ce PC d'abord » est choisi ; sinon après les API
        liste = ["whisper"] + liste if (not en_ligne() or reglage("IA_PREFERENCE", "rapide") == "local") else liste + ["whisper"]
    c = ANCIENS.get(reglage("IA_CHOIX", "claude"), reglage("IA_CHOIX", "claude"))
    if mode() == "manuel" and c in liste:                  # celle choisie d'abord (si elle sait transcrire)
        liste = [c] + [i for i in liste if i != c]
    e = echecs()
    return sorted(liste, key=lambda i: i in e)


def transcrire(chemin):
    """(texte, ia) d'un enregistrement WAV ; ErreurIA si aucune IA ne sait le faire ou si toutes échouent."""
    if coupee():
        raise ErreurIA(message_coupee())
    data = Path(chemin).read_bytes()
    if len(data) > 24 * 1024 * 1024:
        raise ErreurIA(T("enregistrement trop long", "recording too long"))
    liste = fournisseurs_transcription()
    if not liste:
        raise ErreurIA(T("Aucune IA pour transcrire : relie JARVIS, ajoute une clé Groq, OpenAI ou Gemini (nc-ia configurer), "
                         "ou installe whisper.cpp et un modèle pour dicter sans internet.",
                         "No AI to transcribe: connect JARVIS, add a Groq, OpenAI or Gemini key (nc-ai configure), or install "
                         "whisper.cpp and a model to dictate offline."))
    rates = []
    for ident in liste:
        try:
            if ident == "whisper":
                r = subprocess.run(["whisper-cli", "-m", modele_whisper(), "-f", str(chemin), "-nt", "-np", "-l", "auto"],
                                   capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL)
                texte = " ".join(l.strip() for l in r.stdout.splitlines() if l.strip())
                if r.returncode != 0:
                    raise ErreurIA((r.stderr.strip().splitlines() or ["whisper-cli"])[-1][:200])
                if texte.strip():
                    return texte.strip(), ident
                raise ErreurIA(T("transcription vide", "empty transcription"))
            if ident == "google":
                texte = "".join(appel_gemini(T("Tu transcris des enregistrements.", "You transcribe recordings."),
                                             T("Transcris exactement ce qui est dit, sans rien ajouter.",
                                               "Transcribe exactly what is said, adding nothing."), None, "texte",
                                             audio=base64.b64encode(data).decode()))
            else:
                m = modele_choisi("transcription_" + ident) or {"groq": "whisper-large-v3-turbo", "openai": "whisper-1"}[ident]
                corps, type_ = multipart({"model": m, "response_format": "json"}, ("dictee.wav", data, "audio/wav"))
                req = urllib.request.Request(base(ident) + "/audio/transcriptions", data=corps, method="POST",
                                             headers={"Content-Type": type_, "Authorization": "Bearer " + cle(ident)[0],
                                                      "User-Agent": "noctalia-config nc-ia"})
                try:
                    with OUVREUR.open(req, timeout=120) as r:
                        texte = json.loads(r.read(MAX_REPONSE)).get("text", "")
                except urllib.error.HTTPError as e:
                    raise ErreurIA(message_http(e, ident))
                except (urllib.error.URLError, OSError) as e:
                    raise ErreurIA(T("connexion impossible", "cannot connect") + f" ({str(getattr(e, 'reason', e))[:120]})")
            if texte.strip():
                noter_echec(ident, ok=True)
                return texte.strip(), ident
            raise ErreurIA(T("transcription vide", "empty transcription"))
        except (ErreurIA, ValueError) as e:
            noter_echec(ident)
            rates.append(f"{nom(ident)} : {e}")
    raise ErreurIA(T("Transcription impossible", "Transcription failed") + " — " + " ; ".join(rates))


# ── Consignes ───────────────────────────────────────────────────────────────────────────────────────────────────
def distrib():
    try:
        for l in open("/etc/os-release", encoding="utf-8"):
            if l.startswith("PRETTY_NAME="):
                return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Linux"


def gestionnaire():
    for p in ("pacman", "dnf", "apt", "zypper", "xbps-install", "apk", "emerge", "nix-env"):
        if shutil.which(p):
            return p
    return ""


# Les usages texte et question : sans quoi le modèle « fait la tâche » en écrivant des appels d'outils en texte
SANS_OUTILS = ("Tu n'as accès à aucun outil, aucun fichier et aucune commande : réponds directement à partir du texte "
               "fourni.", "You have no access to any tool, file or command: answer directly from the given text.")


