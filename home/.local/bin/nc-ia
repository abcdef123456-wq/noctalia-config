#!/usr/bin/env python3
"""nc-ia : l'IA du bureau, une seule porte pour tout (Spotlight, texte copié, terminal, captures, JARVIS).

  nc-ia etat [--json]                  le mode, l'IA choisie pour chaque usage, celles qui sont disponibles
  nc-ia demander [options] QUESTION    la réponse (QUESTION « - » : lue sur l'entrée standard)
        --flux                         morceau par morceau : une ligne JSON {"t": …} chacun ({"ia": …} avant)
        --usage question|texte|commande|image   (question par défaut)
        --ia ID                        cette IA-là (sinon : le réglage) ; --image FICHIER : une image jointe
  nc-ia texte ACTION [--presse|--selection|--stdin] [--copier] [--flux]
                                       sur le texte sélectionné (sinon copié) : resumer, traduire, corriger,
                                       reformuler, expliquer, repondre, ou une consigne libre entre guillemets
  nc-ia menu                           les actions sur le texte (Super + I) : le Spotlight sur « ! », sinon un menu
  nc-ia terminal QUESTION              la réponse dans un terminal (« ? » du lanceur de Noctalia, sans l'île)
  nc-ia fichier CHEMIN… [ACTION|consigne] [--notifier]
                                       un texte, du code, un PDF ou une image : résumé par défaut (clic droit dans
                                       Fichiers → Scripts → IA)
  nc-ia diagnostic                     ce que nc-diag a trouvé, expliqué, avec quoi faire (nc-diag ia)
  nc-ia agir DEMANDE [--json]          l'IA gère le bureau (services de la session, Wi-Fi, Bluetooth, énergie, son,
                                       réglages, mises à jour) : un plan d'actions permises, confirmé avant d'agir
                                       (« @ » dans le Spotlight) ; nc-ia executer PLAN [N…] le réalise
  nc-ia commande DESCRIPTION           une commande shell seule (Alt + I dans le terminal)
  nc-ia capture [QUESTION]             une zone de l'écran, expliquée (Super + Maj + I)
  nc-ia configurer                     les clés d'API : la fenêtre « Clés des IA » de l'île, sinon au clavier
                                       (masquées), chacune essayée tout de suite ; --terminal : au clavier
  nc-ia cle FOURNISSEUR                enregistre sa clé d'API, lue sur l'entrée standard (vide : l'efface)
  nc-ia cles [--json]                  les clés enregistrées, masquées, et d'où elles viennent
  nc-ia modele FOURNISSEUR [NOM]       le modèle utilisé (sans NOM : retour au choix automatique)
  nc-ia tester [ID] [--json]           un essai court de chaque IA disponible (ou de celle-ci)
  nc-ia quelle [--usage U] [--json]    l'IA qui répondrait maintenant
  nc-ia actif                          code 0 si l'IA est permise, 1 si elle est coupée (IA_MODE=non)
  nc-ia disponible                     code 0 si une IA peut répondre maintenant (permise, et connexion ou IA locale)
  nc-ia derniere                       la dernière réponse en entier (lue dans le terminal)
  nc-ia transcrire FICHIER.wav [--json]   le texte d'un enregistrement (dictée sans JARVIS : Groq, OpenAI, Gemini)

Réglages (nc-reglages → Intelligence artificielle) : IA_MODE auto (la meilleure disponible, la suivante si elle
échoue), manuel (IA_CHOIX) ou non (plus aucune IA nulle part : Spotlight, JARVIS, dictée, agents dans l'île) ;
IA_PREFERENCE pour l'ordre du mode auto (rapide, abonnements, local, jarvis).
Clés : ~/.config/nc/ia.conf (0600, jamais en argument ni dans un journal), sinon les variables d'environnement
habituelles (ANTHROPIC_API_KEY, OPENAI_API_KEY…). Aussi dans ia.conf : MODELE_<FOURNISSEUR> (nc-ia modele),
URL_<FOURNISSEUR> (une passerelle ou un serveur compatible, en HTTPS), OLLAMA_HOST.
Rien ne tourne en arrière-plan : une IA n'est appelée que sur demande.
"""
import base64
import json
import os
from pathlib import Path
import re
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        l = reglage("LANGUE", "")
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


HOME = Path.home()
CONFIG = HOME / ".config"           # comme nc-reglages et nc-assistant (pas XDG_CONFIG_HOME : un seul endroit)
REGLAGES = CONFIG / "nc/reglages.conf"
CLES = CONFIG / "nc/ia.conf"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "nc"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "nc-ia"
DERNIERE = RUN / "derniere.md"
MAX_REPONSE = 4 * 1024 * 1024
# L'île tourne avec le PATH du système : les IA installées pour l'utilisateur sont souvent ailleurs
os.environ["PATH"] = os.pathsep.join([str(HOME / d) for d in (".local/bin", "bin", ".npm-global/bin", ".bun/bin",
                                      ".opencode/bin", ".cargo/bin", ".deno/bin")] + [os.environ.get("PATH", "/usr/bin")])

_reglages = None


def reglage(cle, defaut):
    global _reglages
    if _reglages is None:
        _reglages = {}
        try:
            for l in REGLAGES.read_text(encoding="utf-8").splitlines():
                k, s, v = l.partition("=")
                if s and re.fullmatch(r"[A-Z0-9_]+", k.strip()):
                    _reglages[k.strip()] = v.strip().strip('"')
        except OSError:
            pass
    return _reglages.get(cle, defaut)


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


DOC_EN = """nc-ai: the desktop's AI, a single door for everything (Spotlight, copied text, terminal, screenshots, JARVIS).

  nc-ai status [--json]                the mode, the AI chosen for each use, the available ones
  nc-ai ask [options] QUESTION         the answer (QUESTION “-”: read from standard input)
        --flux                         piece by piece: one JSON line {"t": …} each ({"ia": …} first)
        --usage question|texte|commande|image   (question by default)
        --ia ID                        that AI (otherwise: the setting); --image FILE: an attached image
  nc-ai text ACTION [--presse|--selection] [--copier] [--flux]
                                       on the selected (else copied) text: resumer (summarize), traduire (translate),
                                       corriger (fix), reformuler (rephrase), expliquer (explain), repondre (reply),
                                       or a free instruction in quotes
  nc-ai menu                           the text actions (Super + I): Spotlight on “!”, otherwise a menu
  nc-ai terminal QUESTION              the answer in a terminal (“?” in the Noctalia launcher, without the island)
  nc-ai file PATH… [ACTION|instruction] [--notifier]
                                       a text, code, a PDF or an image: summarized by default (right click in Files →
                                       Scripts → AI)
  nc-ai diagnostic                     what nc-diag found, explained, with what to do (nc-diag ia)
  nc-ai act REQUEST [--json]           the AI manages the desktop (session services, Wi-Fi, Bluetooth, power, sound,
                                       settings, updates): a plan of allowed actions, confirmed before acting (“@” in
                                       Spotlight); nc-ai execute PLAN [N…] carries it out
  nc-ai command DESCRIPTION            a single shell command (Alt + I in the terminal)
  nc-ai screenshot [QUESTION]          an area of the screen, explained (Super + Shift + I)
  nc-ai configure                      the API keys from the keyboard (hidden), each one tested right away
  nc-ai key PROVIDER                   saves its API key, read from standard input (empty: removes it)
  nc-ai keys [--json]                  the saved keys, masked, and where they come from
  nc-ai model PROVIDER [NAME]          the model used (no NAME: back to automatic choice)
  nc-ai test [ID] [--json]             a short test of each available AI (or of this one)
  nc-ai which [--usage U] [--json]     the AI that would answer now
  nc-ai enabled                        exit code 0 if AI is allowed, 1 if it is turned off (IA_MODE=non)
  nc-ai last                           the last answer in full (read in the terminal)
  nc-ai transcribe FILE.wav [--json]   the text of a recording (dictation without JARVIS: Groq, OpenAI, Gemini)

Settings (nc-settings → Artificial intelligence): IA_MODE auto (the best available one, the next if it fails), manuel
(IA_CHOIX) or non (no AI anywhere any more: Spotlight, JARVIS, dictation, agents in the island);
IA_PREFERENCE for the auto order (rapide, abonnements, local, jarvis).
Keys: ~/.config/nc/ia.conf (0600, never in arguments or logs), otherwise the usual environment variables
(ANTHROPIC_API_KEY, OPENAI_API_KEY…). Nothing runs in the background: an AI is only called on request.
"""


class ErreurIA(Exception):
    pass


# ── Fournisseurs ────────────────────────────────────────────────────────────────────────────────────────────────
# genre : api (HTTP, clé), local (Ollama), cli (programme installé), jarvis (nc-assistant)
# vision : accepte une image ; agent : le logo dessiné dans l'île (Etincelle)
FOURNISSEURS = {
    "anthropic": dict(nom="Claude (API Anthropic)", genre="api", cle="ANTHROPIC_API_KEY", vision=True, agent="claude",
                      modele="claude-opus-5-5"),
    "openai": dict(nom="ChatGPT (API OpenAI)", genre="api", cle="OPENAI_API_KEY", vision=True, agent="codex",
