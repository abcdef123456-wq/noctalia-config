    systeme = f"{distrib()}, Hyprland" + (f", {gestionnaire()}" if gestionnaire() else "")
    if usage == "commande":
        return T(f"Tu écris des commandes shell pour {systeme}, shell zsh. Réponds uniquement par une seule commande sur "
