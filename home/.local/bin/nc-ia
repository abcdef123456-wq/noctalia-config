    "bluetooth": dict(domaine="reseau", args=("etat",), fr="Bluetooth : {etat}", en="Bluetooth: {etat}"),
    "profil_energie": dict(domaine="energie", args=("profil",), fr="Profil d'énergie : {profil}", en="Power profile: {profil}"),
    "luminosite": dict(domaine="energie", args=("pourcent",), fr="Luminosité : {pourcent} %", en="Brightness: {pourcent}%"),
    "volume": dict(domaine="son", args=("pourcent",), fr="Volume : {pourcent} %", en="Volume: {pourcent}%"),
