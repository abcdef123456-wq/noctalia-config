    if usage == "texte":
        return T("Tu transformes le texte que l'on te donne selon la consigne. Réponds seulement par le résultat, sans "
                 "introduction ni commentaire, en texte simple. " + SANS_OUTILS[0],
                 "You transform the given text according to the instruction. Answer only with the result, no "
                 "introduction or comment, in plain text. " + SANS_OUTILS[1])
    if usage == "chat":
        return T(f"Tu es l'assistant personnel de l'utilisateur, sur son ordinateur ({systeme}). Réponds en français, "
                 "clairement et sans détour ; le Markdown est permis (listes, code). Tiens compte de la conversation.",
                 f"You are the user's personal assistant, on their computer ({systeme}). Answer in English, clearly and "
                 "directly; Markdown is allowed (lists, code). Take the conversation into account.")
    if usage == "image":
        return T(f"L'ordinateur est sous {systeme}. Explique en français, en quelques lignes, ce que montre cette capture "
                 "d'écran ; s'il s'agit d'une erreur, dis comment la corriger, avec la commande sur une dernière ligne "
                 "« $ … » si une commande aide.",
                 f"The computer runs {systeme}. Explain in English, in a few lines, what this screenshot shows; if it "
                 "is an error, say how to fix it, with the command on a last line “$ …” if a command helps.")
    return T(f"Réponds en français, en 2 à 6 lignes au plus, en texte simple (pas de titres ni de tableaux). Si une "
             f"commande Linux répond à la question, termine par une seule ligne qui commence par « $ » suivie de la "
             f"commande, sans rien d'autre. L'ordinateur est sous {systeme}. " + SANS_OUTILS[0],
             f"Answer in English, in 2 to 6 lines at most, in plain text (no headings or tables). If a Linux command "
             f"answers the question, end with a single line that starts with “$ ” followed by the command, and nothing "
             f"else. The computer runs {systeme}. " + SANS_OUTILS[1])


