    "google": dict(nom="Gemini (API Google)", genre="api", cle="GEMINI_API_KEY", autres=("GOOGLE_API_KEY",), vision=True,
                   agent="gemini", modele=None),
    "mistral": dict(nom="Mistral (API)", genre="api", cle="MISTRAL_API_KEY", vision=False, agent="kiro",
                    url="https://api.mistral.ai/v1", modele="mistral-small-latest"),
    "groq": dict(nom="Groq (API)", genre="api", cle="GROQ_API_KEY", vision=False, agent="amp",
                 url="https://api.groq.com/openai/v1", modele=None),
    "deepseek": dict(nom="DeepSeek (API)", genre="api", cle="DEEPSEEK_API_KEY", vision=False, agent="cursor",
