# ── Demander (avec repli sur l'IA suivante en mode auto) ────────────────────────────────────────────────────────
def message_coupee():
    if mode() != "non" and pause_economie():
        return T("L'IA d'arrière-plan est en pause : profil Économie sur batterie (elle revient sur secteur ou hors Économie).",
                 "Background AI is paused: Power Saver on battery (it comes back on AC power or outside Power Saver).")
    return T("L'IA est désactivée (nc-reglages → Intelligence artificielle → IA du bureau).",
             "AI is turned off (nc-settings → Artificial intelligence → Desktop AI).")


def message_aucune(usage):
    if not en_ligne():
        return T("Pas de connexion internet : l'IA revient dès que la connexion revient (ou Ollama, une IA sur ce PC).",
                 "No internet connection: AI comes back as soon as the connection does (or Ollama, an AI on this PC).")
    if mode() == "manuel" and reglage("IA_CHOIX", "claude"):
        c = ANCIENS.get(reglage("IA_CHOIX", "claude"), reglage("IA_CHOIX", "claude"))
        return T(f"{nom(c)} n'est pas disponible (choisie dans nc-reglages → Intelligence artificielle).",
                 f"{nom(c)} is not available (chosen in nc-settings → Artificial intelligence).")
    if usage == "image":
        return T("Aucune IA disponible ne sait lire une image (une clé d'API Anthropic, OpenAI ou Gemini, Claude Code, "
                 "Codex ou Ollama).", "No available AI can read images (an Anthropic, OpenAI or Gemini API key, Claude "
                 "Code, Codex or Ollama).")
    return T("Aucune IA disponible : ajoute une clé d'API (nc-ia cle anthropic), installe Claude Code, Codex, Gemini "
             "CLI, OpenCode ou Ollama, ou relie JARVIS (nc-assistant configurer).",
             "No AI available: add an API key (nc-ai key anthropic), install Claude Code, Codex, Gemini CLI, OpenCode "
             "or Ollama, or connect JARVIS (nc-assistant configurer).")


RELAIS = []      # l'avis de relais de la dernière réponse (« JARVIS n'a pas répondu : Gemini prend le relais »)


def avis_relais(rates, ident):
    """Une IA a échoué et la suivante répond (mode auto) : dit lesquelles et pourquoi, au lieu de passer en silence
    (issue #4 : on recevait la réponse de Gemini sans savoir que JARVIS avait échoué)."""
    qui = [q for q, _ in rates]
    raison = re.sub(r"\s+", " ", str(rates[0][1])).strip()[:90]
    if len(qui) == 1:
        return T(f"⚠ {qui[0]} n'a pas répondu — {raison} : {nom(ident)} prend le relais.",
                 f"⚠ {qui[0]} did not answer — {raison}: {nom(ident)} takes over.")
    liste = ", ".join(qui[:-1]) + T(" et ", " and ") + qui[-1]
    return T(f"⚠ {liste} n'ont pas répondu ({qui[0]} : {raison}) : {nom(ident)} prend le relais.",
             f"⚠ {liste} did not answer ({qui[0]}: {raison}): {nom(ident)} takes over.")


# Balisage d'un appel d'outil écrit en texte (Claude, Codex, Gemini… sans outils, qui « font la tâche » quand même) :
# <invoke name=…>, <parameter name=…>, <function_calls>, préfixe antml:, ou un JSON {"tool_use"…} en tête de réponse.
# Le mot « invoke » dans une phrase passe : seul le balisage compte.
MOTIF_OUTILS = re.compile(r"<\s{0,3}/?\s{0,3}(invoke|function_calls)\b|<\s{0,3}parameter\s{1,3}name\s{0,3}=|antml:",
                          re.IGNORECASE)
MOTIF_OUTILS_TETE = re.compile(r'^\s*(```[a-z]*\s*)?\[?\s*\{\s*"(tool_use|type"\s*:\s*"tool_use)')


class FiltreOutils:
    """Laisse passer le texte d'une réponse en flux, sauf du balisage d'outil (ErreurOutils dès qu'il paraît, avant
    d'en avoir rien écrit). Ne retient que ce qui pourrait commencer un motif : les 64 premiers caractères d'une réponse
    qui commence par « { », « [ » ou « ``` » (le JSON de tête), puis, dans les 32 derniers caractères, la fin à partir
    du dernier « < » (ou un début de « antml: ») : un motif coupé entre deux morceaux est vu en entier au suivant, et
    le texte ordinaire passe sans attendre."""
    TETE, FENETRE = 64, 32

    def __init__(self):
        self.debut = ""          # le début de la réponse, jusqu'à TETE caractères (sans les blancs de tête)
        self.reste = ""          # pas encore écrit

    def _verifier(self):
        if MOTIF_OUTILS.search(self.reste) or MOTIF_OUTILS_TETE.match(self.debut):
            raise ErreurOutils()

    def passer(self, m):
        """Le texte sûr à écrire maintenant (parfois un peu en retard sur m)."""
        self.reste += m
        if len(self.debut) < self.TETE:
            self.debut = (self.debut + m).lstrip()[:self.TETE]
        self._verifier()
        if not self.debut or (self.debut[0] in "{[`" and len(self.debut) < self.TETE):
            return ""
        r = self.reste
        coupe = len(r)
        i = r.rfind("<", max(0, len(r) - self.FENETRE))
        if i >= 0:
            coupe = i
        for k in range(min(5, len(r)), 0, -1):                 # « a », « an »… « antml » en fin de morceau
            if "antml:".startswith(r[-k:].lower()):
                coupe = min(coupe, len(r) - k)
                break
        sur, self.reste = r[:coupe], r[coupe:]
        return sur

    def finir(self):
        self._verifier()
        sur, self.reste = self.reste, ""
        return sur

    def filtrer(self, morceaux):
        """Les morceaux d'une réponse, filtrés, au fil de l'eau (puis ce que la fenêtre retenait)."""
        try:
            for m in morceaux:
                if m:
                    yield self.passer(m)
        finally:
            if hasattr(morceaux, "close"):
                morceaux.close()                # balisage vu : le programme d'IA s'arrête tout de suite (ses finally)
        yield self.finir()


def demander(texte, usage="question", force="", image=None, consigne_=None, flux=False, sortie=None, exclure=(),
             echeance=None):
    """Écrit la réponse (texte brut, ou lignes JSON en flux) ; renvoie (réponse, ia) ; ErreurIA si aucune n'a pu.
    exclure : des IA à ne pas essayer (le chat de JARVIS qui se rabat sur une autre). echeance : la fin de tout le
    relais (horloge monotone), comme en arrière-plan (nc-ia diagnostic --json --delai)."""
    ecrire = sortie or (lambda m: (sys.stdout.write(m), sys.stdout.flush()))
    if coupee():
        raise ErreurIA(message_coupee())
    liste = [i for i in candidats(usage, force) if i not in exclure]
    if not liste:
        raise ErreurIA(message_aucune(usage))
    RELAIS.clear()
    global ECHEANCE
    # En arrière-plan, le relais a DELAI_FOND en tout (une seule IA : son propre délai suffit)
    ECHEANCE = time.monotonic() + DELAI_FOND if en_fond() and len(liste) > 1 else None
    if echeance is not None:
        ECHEANCE = echeance if ECHEANCE is None else min(ECHEANCE, echeance)
    try:
        return _demander(liste, texte, usage, image, consigne_, flux, ecrire)
    finally:
        ECHEANCE = None


def _demander(liste, texte, usage, image, consigne_, flux, ecrire):
    global _reglages
    rates = []
    for ident in liste:
        if rates:                                # coupée pendant que la précédente échouait : pas de relais
            _reglages = None
            if coupee():
                raise ErreurIA(message_coupee())
        if ECHEANCE is not None and time.monotonic() >= ECHEANCE:
            break                                # arrière-plan : plus de temps pour la suivante
        morceaux = []
        CHOIX.clear()
        filtre = FiltreOutils()
        try:
            if flux:
                ecrire(json.dumps({"ia": nom(ident), "id": ident, "agent": FOURNISSEURS[ident]["agent"]}, ensure_ascii=False) + "\n")
            for m in filtre.filtrer(appeler(ident, consigne_ or consigne(usage), texte, image, usage)):
                if not m:
                    continue
                if rates and not morceaux:
                    # Au premier morceau de celle qui répond vraiment (une suivante peut échouer à son tour) ; affiché
                    # avant la réponse, mais pas gardé avec elle (historique, rapports, plans : la réponse seule)
                    RELAIS[:] = [avis_relais(rates, ident)]
                    ecrire(json.dumps({"t": RELAIS[0] + "\n\n", "relais": RELAIS[0]}, ensure_ascii=False) + "\n" if flux
                           else RELAIS[0] + "\n\n")
                morceaux.append(m)
                ecrire(json.dumps({"t": m}, ensure_ascii=False) + "\n" if flux else m)
            if not morceaux:
                raise ErreurIA(T("réponse vide", "empty answer"))
            rep = "".join(morceaux).strip()
            if flux and CHOIX:
                ecrire(json.dumps({"choices": CHOIX}, ensure_ascii=False) + "\n")
            garder(rep, ident)
            noter_echec(ident, ok=True)
            if not flux and not rep.endswith("\n"):
                ecrire("\n")
            return rep, ident
        except ErreurOutils:
            # La demande ne convient pas (une tâche sur le projet) : échec direct, ni relais ni échec noté pour l'IA
            if morceaux:
                ecrire((json.dumps({"t": "\n…"}) + "\n") if flux else "\n…\n")
            raise
        except (ErreurIA, OSError, subprocess.SubprocessError, ValueError) as e:
            # Coupée par le temps du relais en arrière-plan, pas par le sien : pas sa faute, rien de noté contre elle
            globale = getattr(e, "globale", False)
            if morceaux:                                        # déjà en partie affichée : pas de mélange de deux IA
                if not globale:
                    noter_echec(ident)                          # incomplète : un échec, l'IA passe en dernier
                ecrire((json.dumps({"t": "\n…"}) + "\n") if flux else "\n…\n")
                raise ErreurIA(T(f"{nom(ident)} : réponse incomplète ({e})", f"{nom(ident)}: incomplete answer ({e})"))
            if not globale:
                noter_echec(ident)
            rates.append((nom(ident), str(e)))
    debut = T("Aucune IA n'a pu répondre", "No AI could answer")
    if ECHEANCE is not None and time.monotonic() >= ECHEANCE:
        debut = T(f"L'IA d'arrière-plan s'arrête : pas de réponse en {duree(DELAI_FOND)}",
                  f"Background AI stops: no answer within {duree(DELAI_FOND)}")
    raise ErreurIA(debut + (" — " + " ; ".join(f"{q} : {r}" for q, r in rates) if rates else ""))


def garder(rep, ident):
    try:
        RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
        DERNIERE.write_text(f"{rep}\n\n— {nom(ident)}\n", encoding="utf-8")
        os.chmod(DERNIERE, 0o600)
    except OSError:
        pass


def qui_chat():
    """L'IA de la fenêtre de chat : JARVIS s'il est relié (sauf une autre IA choisie à la main), sinon celle du bureau
    (comme nc-assistant requete-ile)."""
    if coupee():
        return ""
    c = ANCIENS.get(reglage("IA_CHOIX", "claude"), reglage("IA_CHOIX", "claude"))
    if disponible("jarvis") and not (mode() == "manuel" and c in FOURNISSEURS and c != "jarvis"):
        return "jarvis"
    return next((i for i in candidats("question") if i != "jarvis"), "")


def conversation(historique, question):
    """Le texte envoyé pour une réponse de chat : les derniers échanges, puis la question."""
    lignes = []
    for m in (historique or [])[-12:]:
        if isinstance(m, dict) and isinstance(m.get("texte"), str) and m["texte"].strip():
            qui = T("Utilisateur", "User") if m.get("role") in ("user", "vous") else T("Assistant", "Assistant")
            lignes.append(f"{qui} : {m['texte'][:4000]}")
    if not lignes:
        return question
    return T("Conversation jusqu'ici :\n", "Conversation so far:\n") + "\n\n".join(lignes)[-20000:] + \
        T("\n\nNouveau message de l'utilisateur :\n", "\n\nNew message from the user:\n") + question


def chat(historique, question):
    """(réponse, ia) pour la fenêtre de chat quand ce n'est pas JARVIS qui répond."""
    return demander(conversation(historique, question), "chat", sortie=lambda m: None, exclure={"jarvis"})


# ── Texte copié ou sélectionné ──────────────────────────────────────────────────────────────────────────────────
def presse(selection=False):
    if not shutil.which("wl-paste"):
        return ""
    try:
        r = subprocess.run(["wl-paste", "-n"] + (["-p"] if selection else []) + ["-t", "text"], capture_output=True,
                           timeout=3)
        return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def copier(t):
    if shutil.which("wl-copy"):
        try:
            subprocess.run(["wl-copy", "--", t], timeout=3, stdin=subprocess.DEVNULL)     # la réponse, pas un secret
        except (OSError, subprocess.TimeoutExpired):
            pass


_BALISAGE = []


def corps_sur(texte):
    """Le corps d'une notification, échappé seulement pour un serveur qui lit le balisage (mako, dunst…) : l'île ne le
    lit pas et affichait « l&#x27;appli » pour « l'appli »."""
    if not _BALISAGE:
        _BALISAGE.append(bool(shutil.which("gdbus")) and "body-markup" in sortie_cmd(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
             "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.GetCapabilities"], 3)[1])
    if not _BALISAGE[0]:
        return texte
    import html
    return html.escape(texte, quote=False)


def notifier(titre, corps, action=None):
    """Une notification ; action = (texte, commande) : un clic dessus lance la commande (attendue dans un processus
    détaché : celui qui a lancé nc-ia n'attend pas)."""
    if not shutil.which("notify-send"):
        return
    cmd = ["notify-send", "-a", "IA", "-i", "dialog-information"]
    if action:
        cmd += ["-A", "default=" + action[0]]
    try:
        p = subprocess.Popen(cmd + ["--", titre, corps_sur(corps[:1500])], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, start_new_session=True)
        if action and os.fork() == 0:
            # Plus rien d'hérité : celui qui lit la sortie de nc-ia n'attend pas la fermeture de la notification
            nul = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(nul, fd)
            try:
                if (p.communicate(timeout=3600)[0] or "").strip() == "default":
                    subprocess.Popen(action[1], start_new_session=True)
            except Exception:
                pass
            os._exit(0)
    except OSError:
        pass


def apercu(t, n=280):
    t = re.sub(r"[*_`#>]+", "", t).strip()
    return t if len(t) <= n else t[:n].rsplit(" ", 1)[0] + "…"


def vers_chat(question, rep, ident):
    """L'échange dans la conversation de l'île (fenêtre de chat, celle de JARVIS) : vrai si l'île l'a reçu."""
    if not shutil.which("qs"):
        return False
    d = RUN / "chat"
    try:
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        f = d / f"{int(time.time() * 1000)}-{os.getpid()}.json"
        f.write_text(json.dumps({"question": question, "reponse": rep, "ia": nom(ident),
                                 "agent": FOURNISSEURS.get(ident, {}).get("agent", "claude")}, ensure_ascii=False))
        os.chmod(f, 0o600)
        r = subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "iaReponse", str(f)], capture_output=True, timeout=5)
        if r.returncode != 0:
            f.unlink(missing_ok=True)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def livrer(titre, question, rep, ident):
    """La réponse d'une action lancée par un raccourci, un menu ou un clic droit (pas d'un terminal) : dans la
    conversation (IA_REPONSES=chat, par défaut), annoncée par une notification qui l'ouvre ; sinon (ou sans l'île) dans
    une notification seule. Copiée aussi (IA_COPIER). Jamais de terminal ouvert."""
    if reglage("IA_COPIER", "oui") != "non":
        copier(rep)
    titre = f"{titre} · {nom(ident)}"
    vu = (RELAIS[0] + "\n\n" + rep) if RELAIS else rep      # l'avis de relais se lit, mais ne se copie pas
    if reglage("IA_REPONSES", "chat") != "notification" and vers_chat(question, vu, ident):
        notifier(titre, apercu(vu), (T("Ouvrir la conversation", "Open the conversation"),
                                     ["qs", "-c", "nc-ile", "ipc", "call", "ile", "chatReponse"]))
    else:
        notifier(titre, vu)


def texte_action(action, source="", copie=False, flux=False, texte=None):
    action = ACTIONS_EN.get(action, action)
    if texte is not None:
        t = texte
    elif source == "presse":
        t = presse()
    elif source == "selection":
        t = presse(True)
    else:
        t = presse(True).strip() or presse()
    if not t.strip():
        raise ErreurIA(T("Aucun texte sélectionné ni copié.", "No selected or copied text."))
    if len(t) > 60000:
        raise ErreurIA(T("Texte trop long (plus de 60 000 caractères).", "Text too long (over 60,000 characters)."))
    titre, ordre = ACTIONS.get(action, ((action, action), (action, action)))
    instruction = T(*ordre)
    rep, ident = demander(f"{instruction}\n\n---\n{t}\n---", "texte", flux=flux)
    if copie:
        extrait = apercu(t.strip(), 300)
        livrer(T(*titre), f"{T(*titre)} : « {extrait} »", rep, ident)
    return rep


# ── Fichiers (Fichiers / Nautilus, Dolphin, nc-capture) : texte, code, PDF, image ───────────────────────────────
TEXTE_MAX = 60000


def contenu_fichier(chemin):
    """(texte, image) d'un fichier : le texte (≤ 60 000 caractères), ou le chemin d'une image ; ErreurIA sinon."""
    f = Path(chemin)
    if not f.is_file():
        raise ErreurIA(T(f"{f.name} n'est pas un fichier.", f"{f.name} is not a file."))
    ext = f.suffix.lower()
    if ext in (".png", ".jpg", ".jpeg", ".webp", ".gif"):
        return "", str(f)
    if ext == ".pdf":
        if not shutil.which("pdftotext"):
            raise ErreurIA(T("pdftotext (poppler) est nécessaire pour lire un PDF.", "pdftotext (poppler) is needed to read a PDF."))
        r = subprocess.run(["pdftotext", "-layout", "-l", "40", str(f), "-"], capture_output=True, text=True, timeout=60)
        t = r.stdout
    else:
        data = f.read_bytes()[:TEXTE_MAX * 4]
        if b"\0" in data[:8000]:
            raise ErreurIA(T(f"{f.name} n'est ni un texte, ni un PDF, ni une image.", f"{f.name} is not text, a PDF or an image."))
        t = data.decode("utf-8", "replace")
    if not t.strip():
        raise ErreurIA(T(f"{f.name} est vide.", f"{f.name} is empty."))
    return t[:TEXTE_MAX] + ("\n[…]" if len(t) > TEXTE_MAX else ""), None


def fichier_ia(chemins, consigne_f="", notif=False, flux=False):
    if coupee():
        raise ErreurIA(message_coupee())
    if not chemins:
        raise ErreurIA(T("Aucun fichier.", "No file."))
    action = ACTIONS_EN.get(consigne_f, consigne_f) or "resumer"
    titre, ordre = ACTIONS.get(action, ((consigne_f, consigne_f), (consigne_f, consigne_f)))
    instruction = T(*ordre)
    images = []
    morceaux = []
    for c in chemins[:6]:
        t, img = contenu_fichier(c)
        if img:
            images.append(img)
        else:
            morceaux.append(f"=== {Path(c).name} ===\n{t}")
    if images and morceaux:
        raise ErreurIA(T("Une image ou des textes, pas les deux à la fois.", "An image or texts, not both at once."))
    if len(images) > 1:
        raise ErreurIA(T("Une seule image à la fois.", "One image at a time."))
    sortie = (lambda m: None) if notif else None
    if images:
        question = instruction if consigne_f else T("Que montre cette image ? Si c'est une erreur, comment la corriger ?",
                                                     "What does this image show? If it is an error, how to fix it?")
        rep, ident = demander(question, "image", image=images[0], flux=flux, sortie=sortie)
    else:
        rep, ident = demander(f"{instruction}\n\n" + "\n\n".join(morceaux), "texte", flux=flux, sortie=sortie)
    if notif:
        noms = ", ".join(Path(c).name for c in chemins[:3])
        quoi = T(*titre) if consigne_f in ACTIONS or not consigne_f else consigne_f[:60]
        livrer(f"{quoi} · {noms}", ("🖼 " if images else "📄 ") + f"{noms} : {quoi}", rep, ident)
    return rep


# ── Diagnostic : ce que nc-diag a trouvé, expliqué ──────────────────────────────────────────────────────────────
def diagnostic(flux=False):
    if coupee():
        raise ErreurIA(message_coupee())
    r = subprocess.run([str(HOME / ".local/bin/nc-diag")], capture_output=True, text=True, timeout=120,
                       env=dict(os.environ, NO_COLOR="1"))
    bilan = re.sub(r"\x1b\[[0-9;]*m", "", r.stdout).strip()
    if not re.search(r"^\s*[✗!⚠]", bilan, re.M):
        m = T("✓ nc-diag ne trouve rien à corriger.", "✓ nc-diag finds nothing to fix.")
        print(json.dumps({"t": m}, ensure_ascii=False) if flux else m)
        return
    # Ce qui va bien (✓) ne part pas : rien à expliquer, et autant de détails de la machine en moins
    bilan = re.sub(r"\n{3,}", "\n\n", "\n".join(l for l in bilan.splitlines() if not l.lstrip().startswith("✓")))
    question = T("Voici le bilan de vérification de mon bureau (noctalia-config, Hyprland). Explique simplement chaque "
                 "problème (✗) et chaque point d'attention (!), dans l'ordre d'importance, et dis exactement quoi faire "
                 "pour chacun (commandes sur des lignes « $ … »).\n\n",
                 "Here is my desktop's check report (noctalia-config, Hyprland). Simply explain each problem (✗) and each "
                 "warning (!), most important first, and say exactly what to do for each (commands on “$ …” lines).\n\n")
    demander(question + anonymiser(bilan), "texte", flux=flux,
             consigne_=T("Tu aides à réparer un bureau Linux. Réponds en français, concret et bref.",
                         "You help fix a Linux desktop. Answer in English, concrete and brief."))


# ── « Que se passe-t-il ? » (Spotlight) : le bilan de nc-diag --json résumé, les réparations mises dans l'ordre ───
# nc-ia ne répare jamais rien : il résume, et ordonne des identifiants pris dans la liste de nc-diag (c'est nc-diag
# reparer ID qui agit, sans IA). L'IA reçoit la famille de la distribution et les constats qui ne vont pas,
# anonymisés ; jamais les ✓. Toujours un JSON et le code 0 : sans IA (coupée, aucune, en retard, réponse
# illisible), le résumé de nc-diag lui-même.
DIAG_MAX_ENTREE = 200 * 1024
DIAG_MAX_CONSTATS = 20
DIAG_MAX_CHARGE = 6000
DIAG_MAX_REPARATIONS = 4
DIAG_DELAI = 40.0
ID_REPARATION = re.compile(r"[a-z0-9_][a-z0-9_:.@-]{0,79}")
CLE_CONSTAT = re.compile(r"[\w:.@/-]{1,80}")


def famille_distrib():
    """arch, debian, fedora, opensuse (la famille, pas le nom exact ni la version) ; « linux » sinon."""
    ids = ""
    try:
        for l in open(os.environ.get("NC_OS_RELEASE") or "/etc/os-release", encoding="utf-8"):
            k, _, v = l.strip().partition("=")
            if k in ("ID", "ID_LIKE"):
                ids += " " + v.strip('"\'').lower()
    except OSError:
        pass
    for famille, mots in (("arch", ("arch", "archlinux", "manjaro", "endeavouros", "cachyos")),
                          ("opensuse", ("suse", "opensuse", "opensuse-tumbleweed", "sles")),
                          ("fedora", ("fedora", "rhel", "centos")), ("debian", ("debian", "ubuntu"))):
        if any(m in ids.split() for m in mots):
            return famille
    return "linux"


def lire_bilan(texte):
    """Le JSON de nc-diag --json, ou None s'il est illisible."""
    try:
        d = json.loads(texte)
    except (ValueError, TypeError):
        return None
    return d if isinstance(d, dict) and isinstance(d.get("constats", []), list) else None


def bilan_nc_diag(delai):
    """nc-diag --json --rapide, lancé par nc-ia (rien sur l'entrée standard) ; None s'il échoue."""
    diag = HOME / ".local/bin/nc-diag"
    prog = str(diag) if diag.exists() else shutil.which("nc-diag")
    if not prog or delai <= 0:
        return None
    try:
        r = subprocess.run([prog, "--json", "--rapide"], capture_output=True, text=True, timeout=delai,
                           env=dict(os.environ, NO_COLOR="1"), stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    return lire_bilan(r.stdout[:DIAG_MAX_ENTREE])


def niveau_constat(c):
    n = str(c.get("niveau") or c.get("genre") or "")
    return n if n in ("faux", "avert") else ""


def libelle_reparation(table, ident):
    """Le libellé d'une réparation de la table de nc-diag (un objet {id: {libelle…}}, ou une liste de {id, libelle…})."""
    if isinstance(table, dict):
        r = table.get(ident)
    elif isinstance(table, list):
        r = next((x for x in table if isinstance(x, dict) and x.get("id") == ident), None)
    else:
        r = None
    return str(r.get("libelle") or "") if isinstance(r, dict) else ""


def charge_diagnostic(d):
    """Ce qui part vers l'IA : la famille de la distribution et les constats non OK (les ✗ d'abord), anonymisés,
    chacun avec ses réparations possibles ; DIAG_MAX_CONSTATS et DIAG_MAX_CHARGE caractères au plus. Renvoie
    (charge, ids permis), dans l'ordre des constats."""
    constats = [c for c in d.get("constats") or [] if isinstance(c, dict) and niveau_constat(c)]
    constats.sort(key=lambda c: niveau_constat(c) != "faux")             # tri stable : l'ordre de nc-diag sinon
    table = d.get("reparations") or {}
    charge = {"distribution": famille_distrib(), "constats": []}
    permis = []
    for c in constats[:DIAG_MAX_CONSTATS]:
        # texte_ia : sans la ligne du journal (nom de réseau, titre de fenêtre, texte de notification…) ; repli sur texte
        brut = c.get("texte_ia") if isinstance(c.get("texte_ia"), str) else c.get("texte")
        x = {"niveau": niveau_constat(c), "texte": anonymiser(str(brut or ""))[:400]}
        cle_ = str(c.get("cle") or "")
        if CLE_CONSTAT.fullmatch(cle_):
            x = {"cle": cle_, **x}
        quoi = anonymiser(str(c.get("quoi") or ""))[:400]
        if quoi:
            x["quoi"] = quoi
        reps = [str(r) for r in (c.get("reparations") or []) if isinstance(r, str) and ID_REPARATION.fullmatch(r)]
        if reps:
            x["reparations"] = [{"id": r, "libelle": anonymiser(libelle_reparation(table, r))[:120]} for r in reps[:6]]
        essai = dict(charge, constats=charge["constats"] + [x])
        if len(json.dumps(essai, ensure_ascii=False)) > DIAG_MAX_CHARGE:
            break
        charge = essai
        permis += [r["id"] for r in x.get("reparations", []) if r["id"] not in permis]
    return charge, permis


def consigne_diagnostic():
    return T("Tu aides à comprendre ce qui ne va pas sur un bureau Linux (noctalia-config, Hyprland). On te donne en "
             "JSON les constats d'une vérification et, pour certains, des réparations prêtes, chacune avec son "
             "identifiant. Réponds UNIQUEMENT par un objet JSON, sans balises de code ni texte autour : {\"resume\": "
             "\"…\", \"reparations\": [\"identifiant\", …], \"conseil\": \"…\"}. resume : 2 à 4 phrases simples en "
             "français, ce qui ne va pas et pourquoi, le plus important d'abord, sans aucune commande. reparations : "
             f"au plus {DIAG_MAX_REPARATIONS} identifiants, pris SEULEMENT parmi les réparations fournies, dans l'ordre "
             "où les faire ; [] si aucune ne convient. conseil : une phrase de 200 caractères au plus, ce que "
             "l'utilisateur peut faire lui-même, sans commande, ou \"\". " + SANS_OUTILS[0],
             "You help understand what is wrong on a Linux desktop (noctalia-config, Hyprland). You are given, in JSON, "
             "the findings of a check and, for some of them, ready repairs, each with its id. Answer ONLY with a JSON "
             "object, no code fences or text around it: {\"resume\": \"…\", \"reparations\": [\"id\", …], \"conseil\": "
             "\"…\"}. resume: 2 to 4 simple sentences in English, what is wrong and why, most important first, without "
             f"any command. reparations: at most {DIAG_MAX_REPARATIONS} ids, taken ONLY from the given repairs, in the "
             "order to do them; [] if none fits. conseil: one sentence of 200 characters at most, what the user can do "
             "themselves, without a command, or \"\". " + SANS_OUTILS[1])


def sans_commande(t, n):
    """Un texte de l'IA pour l'île : sans blocs de code ni lignes « $ … » (les réparations passent par nc-diag,
    jamais par une commande à copier), accents graves et « $ … » en milieu de ligne aussi, espaces resserrés, n caractères au plus."""
    t = re.sub(r"```.*?(?:```|\Z)", " ", str(t), flags=re.S)
    t = re.sub(r"`+[^`]*(?:`+|\Z)", " ", t).replace("`", " ")   # segments entre accents graves (1, 2 ou 3), puis les restes
    t = "\n".join(l for l in t.splitlines() if not l.lstrip().startswith("$"))
    t = re.sub(r"(?:(?<=\s)|^)\$ .*", " ", t, flags=re.M)     # « $ commande » au milieu d'une ligne : jusqu'à la fin
    t = re.sub(r"\s+", " ", t).strip()
    return t if len(t) <= n else t[:n - 1].rstrip() + "…"


def lire_reponse_diagnostic(rep, permis):
    """{resume, reparations, conseil, refus} d'après la réponse de l'IA ; ErreurIA si elle est illisible. Un
    identifiant hors de la liste fournie est refusé (dans refus), jamais gardé."""
    d = lire_json(rep)
    resume = sans_commande(d.get("resume") if isinstance(d.get("resume"), str) else "", 700)
    if not resume:
        raise ErreurIA(T("L'IA n'a pas donné de résumé.", "The AI gave no summary."))
    ordre, refus = [], []
    brut = d.get("reparations")
    for r in (brut if isinstance(brut, list) else [] if brut is None else [brut]):
        if isinstance(r, str) and r in permis:
            if r not in ordre and len(ordre) < DIAG_MAX_REPARATIONS:
                ordre.append(r)
        else:
            refus.append(re.sub(r"\s+", " ", str(r))[:80])
    conseil = sans_commande(d.get("conseil") if isinstance(d.get("conseil"), str) else "", 200)
    return {"resume": resume, "reparations": ordre, "conseil": conseil, "refus": refus[:10]}


def diagnostic_json(entree=None, delai=DIAG_DELAI):
    """nc-ia diagnostic --json [--delai S] [-] : le JSON {source, raison, ia, agent, resume, reparations, conseil,
    refus} lu par l'île. source « ia » ou « sans_ia » ; raison (sans IA) : rien, coupee, aucune, delai, illisible,
    erreur, bilan. Le délai borne tout (nc-diag compris) : c'est l'ÉCHÉANCE du relais."""
    global _reglages
    fin = time.monotonic() + delai
    sortie = {"source": "sans_ia", "raison": "", "ia": "", "agent": "", "resume": "", "reparations": [], "conseil": "",
              "refus": []}
    d = lire_bilan(entree) if entree and len(entree) <= DIAG_MAX_ENTREE else None
    if d is None:
        d = bilan_nc_diag(fin - time.monotonic())
    if d is None:
        return dict(sortie, raison="bilan", resume=T("La vérification du bureau n'a pas pu se faire (nc-diag).",
                                                     "The desktop check could not run (nc-diag)."))
    constats = [c for c in d.get("constats") or [] if isinstance(c, dict) and niveau_constat(c)]
    constats.sort(key=lambda c: niveau_constat(c) != "faux")
    repli = []                                   # sans IA : les réparations dans l'ordre des constats, ✗ d'abord
    for c in constats:
        repli += [r for r in c.get("reparations") or [] if isinstance(r, str) and ID_REPARATION.fullmatch(r)
                  and r not in repli]
    resume = d.get("resume") if isinstance(d.get("resume"), str) and d.get("resume").strip() else ""
    sortie.update(resume=resume.strip() or (T("Tout est en ordre.", "Everything is fine.") if not constats else
                  T(f"{len(constats)} point(s) à voir.", f"{len(constats)} item(s) to check.")), reparations=repli)
    if not constats:
        return dict(sortie, raison="rien")
    if coupee():
        return dict(sortie, raison="coupee")
    charge, permis = charge_diagnostic(d)
    question = T("Voici les constats de la vérification de mon bureau (JSON) :\n\n",
                 "Here are the findings of my desktop check (JSON):\n\n") + json.dumps(charge, ensure_ascii=False)
    if not candidats("texte"):
        return dict(sortie, raison="aucune")
    try:
        rep, ident = demander(question, "texte", consigne_=consigne_diagnostic(), sortie=lambda m: None, echeance=fin)
    except ErreurIA as e:
        _reglages = None                         # coupée pendant l'attente ?
        return dict(sortie, raison="delai" if time.monotonic() >= fin or isinstance(e, ErreurDelai) else
                    "coupee" if coupee() else "erreur")
    try:
        lu = lire_reponse_diagnostic(rep, permis)
    except ErreurIA:
        return dict(sortie, raison="illisible")
    return dict(sortie, source="ia", ia=nom(ident), agent=FOURNISSEURS[ident]["agent"], **lu)


# ── Un service en panne (nc-panne : notification « Expliquer ») ─────────────────────────────────────────────────
UNITE_RE = re.compile(r"[A-Za-z0-9:_.\\@-]{1,200}\.service")


# Début du nom ancré et préfixe paresseux : sinon, quadratique sur un long mot sans espace (base64, JSON minifié : ~10 s
# pour 12 000 caractères, revue PRIV-02)
_NOM_SECRET = r"(?<![\w.-])[\w.-]*?(?:password|passwd|secret|token|api[_-]?key|apikey|credential|private[_-]?key|auth)[\w.-]*"


def caviarder(t):
    """Ce qui ressemble à un secret est masqué avant de partir vers une IA (toujours, même locale) : clés et jetons
    reconnaissables, toute valeur d'un nom de clé (DB_PASSWORD=, TELEGRAM_TOKEN=, X-Secret-Key:, "access_token":…),
    identifiants dans une URL, jetons de bot Telegram, en-têtes Basic et Bearer, clés privées PEM, clés AWS ; et le
    dossier personnel devient ~ (le nom du compte ne part pas). Revue PRIV-01."""
    t = re.sub(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|\Z)", "[clé privée …]", t, flags=re.S)
    t = re.sub(r"\b(sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,}|"
               r"gsk_[A-Za-z0-9]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+)", "[…]", t)
    t = re.sub(r"(://)[^/\s:@]+:[^/\s@]+@", r"\1[…]@", t)
    t = re.sub(r"/bot\d{5,}:[\w-]{20,}", "/bot[…]", t)
    t = re.sub(r"(?i)\b(basic|bearer)\s+[A-Za-z0-9._~+/=-]{6,}", r"\1 […]", t)
    t = re.sub(r"(?i)(" + _NOM_SECRET + r")([\"']?\s*[=:]\s*[\"']?)(?!\[…\])[^\s,;\"'&]+", r"\1\2[…]", t)
    t = re.sub(r"(?i)\b(password|passwd|mot de passe|token|secret)(\s+)(?![=:\[])[^\s,;]+", r"\1\2[…]", t)
    return t.replace(str(HOME), "~")


# Les noms qu'une installation donne d'elle-même ne disent rien de toi : gardés, le texte reste lisible
NOMS_BANALS = {"localhost", "localhost-live", "root", "arch", "archlinux", "debian", "fedora", "opensuse", "linux",
               "user", "utilisateur"}
_PERSO = re.compile(r"(?<![\w.-])/(?:var/)?home/[^/\s\"'`:;,()\[\]]+")
_MEDIA = re.compile(r"(?<![\w.-])(/run/media/)[^/\s\"'`:;,()\[\]]+")
# MAC sans séparateurs : 12 hexa isolés, dont au moins une lettre (12 chiffres = un nombre, un identifiant)
_MAC_NU = re.compile(r"(?<![\w.-])(?=[0-9]*[A-Fa-f])[0-9A-Fa-f]{12}(?![\w-])")
_EMAIL = re.compile(r"(?<![\w.+-])[\w.+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.(?!(?:service|socket|target|timer|path|"
                    r"mount|automount|scope|slice|device|swap)\b)[A-Za-z]{2,24}\b")
_UUID = re.compile(r"(?<![0-9A-Fa-f-])(?:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|"
                   r"[0-9a-f]{32})(?![0-9A-Fa-f-])")
_MAC = re.compile(r"(?<![0-9A-Fa-f:-])[0-9A-Fa-f]{2}([:-])[0-9A-Fa-f]{2}(?:\1[0-9A-Fa-f]{2}){4}(?![0-9A-Fa-f:-])")
_OCTET = r"(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)"
_IPV4 = re.compile(r"(?<![\w.])" + _OCTET + r"(?:\." + _OCTET + r"){3}(?!\w|\.\d)")
_IPV6 = re.compile(r"(?<![\w:.])[0-9A-Fa-f]{0,4}(?::[0-9A-Fa-f]{0,4}){2,7}(?:%[\w.-]+)?(?![\w:])")
_PID = re.compile(r"\(\d{3,7}\)|(?<=[\w)])\[\d{2,7}\]|(?i:\bpid)([ =:]+)\d+\b")


def _ipv4(m):
    t = m[0]
    return t if t.startswith("127.") or t == "0.0.0.0" else "[IP]"


def _ipv6(m):
    """Une adresse IPv6 : « :: » ou au moins 3 « : » entre des groupes hexadécimaux. Pas une heure (12:30:45, des
    nombres de 1 ou 2 chiffres sans « :: »), ni la boucle locale (::1)."""
    t = m[0].split("%")[0]
    groupes = t.split(":")
    if t in ("::", "::1") or t.count("::") > 1 or not any(groupes):
        return m[0]
    if "::" not in t and (t.count(":") < 3 or all(re.fullmatch(r"\d{1,2}", g) for g in groupes)):
        return m[0]
    return "[IP]"


_IDENTITE = None


def _identite():
    """Le motif des noms de la machine et du compte (None s'il n'y en a pas à masquer), calculé une fois."""
    global _IDENTITE
    if _IDENTITE is None:
        machines, comptes = set(), {os.environ.get("USER") or "", os.environ.get("LOGNAME") or ""}
        try:
            h = socket.gethostname()
            machines |= {h, h.split(".")[0]}
        except OSError:
            pass
        try:
            import pwd
            comptes.add(pwd.getpwuid(os.getuid()).pw_name)
        except (ImportError, KeyError, OSError):
            pass
        garder = lambda n: len(n) >= 2 and n.lower() not in NOMS_BANALS and re.fullmatch(r"[\w.-]+", n)
        motif = lambda noms: re.compile(r"(?<![A-Za-z0-9\[])(?:" + "|".join(re.escape(n) for n in sorted(
            noms, key=len, reverse=True)) + r")(?![A-Za-z0-9\]])", re.I) if noms else None
        _IDENTITE = (motif({n for n in machines if garder(n)}), motif({n for n in comptes if garder(n)}))
    return _IDENTITE


def anonymiser(t):
    """caviarder(), puis ce qui dit qui tu es ou où est ta machine, avant de partir vers une IA (le bilan de nc-diag) :
    le nom de la machine → [machine], celui du compte → [compte], /home/<nom> et /var/home/<nom> → ~, les adresses
    IPv4 (sauf 127.x et 0.0.0.0) et IPv6 → [IP], les adresses MAC → [MAC], les e-mails → [e-mail], les UUID → [id],
    les numéros de processus « (1234) » → (…). Les versions (0.56.2) et les heures (12:30:45) restent ; linéaire
    (chaque motif ne commence qu'en début de mot)."""
    t = _PERSO.sub("~", caviarder(t))
    t = _MEDIA.sub(r"\1[compte]", t)
    t = _EMAIL.sub("[e-mail]", t)
    t = _UUID.sub("[id]", t)
    t = _MAC.sub("[MAC]", t)
    t = _MAC_NU.sub("[MAC]", t)
    t = _IPV4.sub(_ipv4, t)
    t = _IPV6.sub(_ipv6, t)
    t = _PID.sub(lambda m: "(…)" if m[0].startswith("(") else "[…]" if m[0].startswith("[") else
                 m[0][:3] + m[1] + "…", t)
    machine, compte = _identite()
    if machine:
        t = machine.sub("[machine]", t)
    if compte:
        t = compte.sub("[compte]", t)
    return t


def panne(unites, flux=False, livraison=False):
    """Pourquoi ce service de ta session s'est arrêté (ou ces services, tombés ensemble), et quoi faire : leur état et
    la fin de leur journal (secrets masqués) envoyés à l'IA seulement quand tu le demandes (bouton « Expliquer » de la
    notification de nc-panne)."""
    if coupee():
        raise ErreurIA(message_coupee())
    unites = list(dict.fromkeys(unites))[:6]
    if not unites or not all(UNITE_RE.fullmatch(u or "") for u in unites):
        raise ErreurIA(T("service inconnu", "unknown service"))
    lignes = 60 if len(unites) == 1 else 25
    faits, descs = [], []
    for unite in unites:
        _, etat = sortie_cmd(["systemctl", "--user", "show", unite, "-p",
                              "Description,LoadState,ActiveState,SubState,Result,ExecMainStatus,NRestarts,FragmentPath"])
        if "LoadState=loaded" not in etat:
            raise ErreurIA(T("service inconnu", "unknown service"))
        descs.append((re.search(r"^Description=(.*)$", etat, re.M) or [None, unite])[1])
        _, journal = sortie_cmd(["journalctl", "--user", "-u", unite, "-n", str(lignes), "--no-pager", "-o", "short-iso"])
        if not journal.strip() or "No entries" in journal:   # journal non persistant : ce que systemd en a gardé
            _, journal = sortie_cmd(["systemctl", "--user", "status", unite, "-n", "40", "--no-pager"])
        faits.append(f"{etat}\n\n{journal[-12000 // len(unites):]}")
    if len(unites) == 1:
        unite, desc = unites[0], descs[0]
        question = T(f"Le service « {unite} » de ma session ({desc}) s'est arrêté en panne. Explique simplement pourquoi, "
                     "d'après son état et la fin de son journal, puis dis quoi faire, dans l'ordre (commandes sur des lignes "
                     "« $ … »). Si c'est passager, dis-le.\n\n",
                     f"The service “{unite}” of my session ({desc}) stopped with a failure. Simply explain why, from its state "
                     "and the end of its log, then say what to do, in order (commands on “$ …” lines). If it is transient, "
                     "say so.\n\n")
        titre, q = T(f"Panne de {desc}", f"{desc} failure"), T(f"Pourquoi {unite} s'est arrêté ?", f"Why did {unite} stop?")
    else:
        liste = ", ".join(unites)
        question = T(f"Ces services de ma session se sont arrêtés en panne en même temps : {liste}. Dis s'ils ont une cause "
                     "commune (lequel est tombé d'abord, lequel entraîne les autres), simplement, d'après leur état et la fin "
                     "de leur journal, puis quoi faire, dans l'ordre (commandes sur des lignes « $ … »).\n\n",
                     f"These services of my session failed at the same time: {liste}. Say whether they share a cause (which "
                     "one fell first, which one drags the others), simply, from their state and the end of their logs, then "
                     "what to do, in order (commands on “$ …” lines).\n\n")
        titre = T(f"{len(unites)} services en panne", f"{len(unites)} services failed")
        q = T(f"Pourquoi {liste} se sont arrêtés ?", f"Why did {liste} stop?")
    question += caviarder("\n\n────\n\n".join(faits))
    consigne = T("Tu aides à réparer un bureau Linux (noctalia-config, Hyprland). Réponds en français, concret et bref.",
                 "You help fix a Linux desktop (noctalia-config, Hyprland). Answer in English, concrete and brief.")
    if not livraison:
        demander(question, "texte", flux=flux, consigne_=consigne)
        return
    rep, ident = demander(question, "texte", consigne_=consigne, sortie=lambda m: None)
    livrer(titre, q, rep, ident)


# ── Gestion du bureau par l'IA (nc-reglages → Intelligence artificielle → L'IA peut agir) ────────────────────────
# L'IA ne lance jamais de commande à elle : elle propose un plan fait seulement des outils ci-dessous, dans les
# domaines permis (IA_GERER_*) ; chaque action est revérifiée (nom de service existant, valeurs bornées) avant de
# s'exécuter, et n'est faite qu'après ta confirmation (jamais toute seule). Coupé par défaut (IA_ACTIONS=non).
# Ses propres réglages (IA_*, SPOTLIGHT_IA) lui sont interdits.
PROFILS = ("performance", "balanced", "power-saver")
OUTILS = {
    "service_journal": dict(domaine="services", lecture=True, args=("nom",), fr="Lire le journal de {nom}", en="Read the log of {nom}"),
