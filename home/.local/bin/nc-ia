    "reglage": dict(domaine="reglages", args=("cle", "valeur"), fr="Réglage {cle} = {valeur}", en="Setting {cle} = {valeur}"),
    "fenetre_bureau": dict(domaine="fenetres", args=("adresse", "bureau"), fr="{nom_fenetre} → bureau {bureau}", en="{nom_fenetre} → desktop {bureau}"),
    "fenetre_direction": dict(domaine="fenetres", args=("adresse", "direction"), fr="{nom_fenetre} vers {direction_fr}", en="{nom_fenetre} to the {direction}"),
    "fenetre_echanger": dict(domaine="fenetres", args=("adresse", "autre"), fr="Échanger {nom_fenetre} et {nom_autre}", en="Swap {nom_fenetre} and {nom_autre}"),
    "fenetre_libre": dict(domaine="fenetres", args=("adresse", "etat"), fr="{nom_fenetre} libre : {etat}", en="{nom_fenetre} floating: {etat}"),
    "fenetre_plein_ecran": dict(domaine="fenetres", args=("adresse", "etat"), fr="{nom_fenetre} plein écran : {etat}", en="{nom_fenetre} fullscreen: {etat}"),
    # Une zone de l'écran en pourcentages de la place utile (sous la barre, marges comprises) : la fenêtre devient libre
    # et y est posée, quelle que soit la disposition automatique en tuiles
    "fenetre_zone": dict(domaine="fenetres", args=("adresse", "x", "y", "largeur", "hauteur"),
                         fr="{nom_fenetre} : {largeur} × {hauteur} % de l'écran, à {x} % / {y} %",
                         en="{nom_fenetre}: {largeur} × {hauteur} % of the screen, at {x} % / {y} %"),
    "bureau_nommer": dict(domaine="fenetres", args=("bureau", "nom"), fr="Bureau {bureau} nommé « {nom} »", en="Desktop {bureau} named “{nom}”"),
    "maj_verifier": dict(domaine="maj", args=(), fr="Chercher les mises à jour", en="Check for updates"),
    "maj_installer": dict(domaine="maj", args=(), danger=True, fr="Installer les mises à jour (terminal, mot de passe)",
                          en="Install the updates (terminal, password)"),
}
DOMAINES = {"fenetres": "IA_GERER_FENETRES", "services": "IA_GERER_SERVICES", "reseau": "IA_GERER_RESEAU", "energie": "IA_GERER_ENERGIE",
            "son": "IA_GERER_SON", "reglages": "IA_GERER_REGLAGES", "maj": "IA_GERER_MAJ"}
PLANS = RUN / "plans"


def actions_mode():
    return "confirmer" if reglage("IA_ACTIONS", "non") == "confirmer" else "non"


def domaines_permis():
    return [d for d, cle_ in DOMAINES.items() if reglage(cle_, "oui") != "non"]


def sortie_cmd(cmd, delai=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=delai, stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def services_session():
    """{nom: (actif, sous-état)} des services de ta session (systemctl --user), jamais ceux du système."""
    code, t = sortie_cmd(["systemctl", "--user", "list-units", "--type=service", "--all", "--no-legend", "--plain"])
    res = {}
    for l in t.splitlines():
        c = l.split(None, 4)
        if len(c) >= 4 and c[0].endswith(".service") and c[1] == "loaded":
            res[c[0]] = (c[2], c[3])
    code, t = sortie_cmd(["systemctl", "--user", "list-unit-files", "--type=service", "--no-legend"])
    for l in t.splitlines():
        c = l.split()
        if c and c[0].endswith(".service") and "@." not in c[0] and c[0] not in res:
            res[c[0]] = ("inactive", "dead")
    return res


DIRECTIONS = {"gauche": "left", "droite": "right", "haut": "up", "bas": "down", "left": "left", "right": "right", "up": "up", "down": "down"}
DIRECTIONS_FR = {"left": "la gauche", "right": "la droite", "up": "le haut", "down": "le bas"}


def fenetres_bureau(bureau=None):
    """{adresse: fenêtre} des fenêtres rangées sur un bureau (ni les bureaux cachés, ni celles du bureau lui-même) ;
    bureau : seulement celles de ce bureau-là (« Organiser ce bureau »)."""
    try:
        c = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    return {x["address"]: x for x in c if x.get("mapped") and (x.get("workspace") or {}).get("id", 0) > 0
            and x.get("class") not in ("org.quickshell", "dropterm")
            and (bureau is None or x["workspace"]["id"] == bureau)}


def bureau_affiche():
    try:
        return int(json.loads(subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True,
                                             timeout=5).stdout or "{}").get("id"))
    except (OSError, ValueError, TypeError, subprocess.TimeoutExpired):
        return None


def message_bureau_inconnu():
    return T("Rien de rangé : Hyprland ne dit pas quel bureau est affiché.",
             "Nothing tidied: Hyprland doesn't say which desktop is shown.")


def etat_fenetres(bureau=None):
    f = fenetres_bureau(bureau)
    try:
        bureaux = json.loads(subprocess.run(["hyprctl", "workspaces", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
        actif = json.loads(subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True, timeout=5).stdout or "{}")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        bureaux, actif = [], {}
    if bureau is not None:                       # portée limitée : l'IA ne voit que ce bureau
        bureaux = [b for b in bureaux if b.get("id") == bureau]
    try:
        m = next(e for e in json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True,
                                                     timeout=5).stdout or "[]") if e.get("focused"))
        k = float(m.get("scale") or 1)
        ecran = T(f"Écran : {round(m['width'] / k)} x {round(m['height'] / k)} points", f"Screen: {round(m['width'] / k)} x {round(m['height'] / k)} points")
    except (OSError, ValueError, StopIteration, KeyError, subprocess.TimeoutExpired):
        ecran = ""
    l = ([ecran] if ecran else []) + [T("Bureau affiché : ", "Shown desktop: ") + str(actif.get("id", "?")) +
         (T(f" (seulement lui : les fenêtres restent sur le bureau {bureau})", f" (only this one: windows stay on desktop {bureau})")
          if bureau is not None else ""),
         T("Bureaux : ", "Desktops: ") + ", ".join(f"{b['id']} « {b.get('name')} » ({b.get('windows', 0)} fenêtre(s), écran {b.get('monitor')})"
                                                   for b in sorted(bureaux, key=lambda b: b.get("id", 0)) if b.get("id", 0) > 0)]
    l.append(T("Fenêtres (adresse · appli · titre · bureau · rangée ou libre · taille) :", "Windows (address · app · title · desktop · tiled or floating · size):"))
    for a, x in sorted(f.items(), key=lambda kv: (kv[1]["workspace"]["id"], kv[1].get("at", [0, 0]))):
        l.append(f"  {a} · {x.get('class')} · {(x.get('title') or '')[:50]} · {x['workspace']['id']} · "
                 f"{T('libre', 'floating') if x.get('floating') else T('rangée', 'tiled')} · {x.get('size', ['?'])[0]}x{x.get('size', ['?', '?'])[1]}")
    return "\n".join(l[:80])


def etat_bureau(domaines, bureau=None):
    """Ce que l'IA voit avant de proposer : seulement les domaines permis."""
    l = []
    if "fenetres" in domaines:
        l.append(etat_fenetres(bureau))
    if "services" in domaines:
        sv = services_session()
        echec = [n for n, (a, _) in sv.items() if a == "failed"]
        nc = sorted(n for n in sv if n.startswith(("nc-", "noctalia", "hypridle", "pipewire", "wireplumber", "xdg-desktop-portal")))
        l.append(T("Services de la session en échec : ", "Failed session services: ") + (", ".join(echec) or T("aucun", "none")))
        l.append(T("Services du bureau : ", "Desktop services: ") + ", ".join(f"{n} ({sv[n][0]})" for n in nc[:40]))
    if "reseau" in domaines:
        l.append("Wi-Fi : " + (sortie_cmd(["nmcli", "radio", "wifi"])[1] if shutil.which("nmcli") else "?"))
        bt = sortie_cmd(["bluetoothctl", "show"])[1] if shutil.which("bluetoothctl") else ""
        l.append("Bluetooth : " + ("on" if "Powered: yes" in bt else "off" if bt else "?"))
    if "energie" in domaines:
        pp = sortie_cmd(["busctl", "get-property", "org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles",
                         "org.freedesktop.UPower.PowerProfiles", "ActiveProfile"])[1]
        l.append(T("Profil d'énergie : ", "Power profile: ") + (pp.split('"')[1] if '"' in pp else "?"))
        l.append(T("Luminosité : ", "Brightness: ") + sortie_cmd([str(HOME / ".local/bin/nc-brightness"), "get"])[1] + " %")
    if "son" in domaines and shutil.which("wpctl"):
        l.append(T("Volume : ", "Volume: ") + sortie_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])[1])
    return "\n".join(l)


def consigne_agent(domaines):
    outils = []
    for n, o in OUTILS.items():
        if o["domaine"] in domaines:
            outils.append(f"- {n}(" + ", ".join(o["args"]) + ")" + (T(" : lecture seule", ": read only") if o.get("lecture") else ""))
    return T(
        "Tu pilotes le bureau Linux de l'utilisateur, seulement avec ces outils :\n" + "\n".join(outils) +
        "\nValeurs : etat = on ou off ; profil = performance, balanced ou power-saver ; pourcent = un entier ; nom = un "
        "service listé dans l'état. Réponds UNIQUEMENT par un objet JSON, sans texte autour : "
        '{"reponse": "une ou deux phrases en français pour l\'utilisateur", "actions": [{"outil": "...", "args": {...}}]}. '
        "N'utilise que les outils de la liste ; si la demande ne demande aucune action, ou si aucun outil ne le permet, "
        "actions vide et explique-le. Pour comprendre un service en échec, demande d'abord service_journal."
        + (" Pour organiser les fenêtres : regroupe-les par activité (code, navigateur, discussion, musique, documents…) "
           "sur des bureaux numérotés de 1 à 10 et nomme ces bureaux ; sur un bureau, l'appli principale à gauche, les "
           "outils à droite ; adresse = l'adresse 0x… d'une fenêtre listée ; ne déplace que ce qui y gagne. Pour la "
           "meilleure disposition d'un bureau, tu peux poser chaque fenêtre dans une zone avec fenetre_zone (x, y, "
           "largeur, hauteur en pourcentages entiers de l'écran utile), sans suivre la disposition automatique en tuiles : "
           "les zones d'un même bureau couvrent l'écran sans se chevaucher, la plus grande pour l'activité principale ; "
           "donne une zone à chaque fenêtre du bureau."
           if "fenetres" in domaines else ""),
        "You control the user's Linux desktop, only with these tools:\n" + "\n".join(outils) +
        "\nValues: etat = on or off; profil = performance, balanced or power-saver; pourcent = an integer; nom = a service "
        "listed in the state. Answer ONLY with a JSON object, no text around it: "
        '{"reponse": "one or two sentences in English for the user", "actions": [{"outil": "...", "args": {...}}]}. '
        "Only use tools from the list; if the request needs no action, or no tool allows it, leave actions empty and say "
        "so. To understand a failed service, first ask for service_journal."
        + (" To organize windows: group them by activity (code, browser, chat, music, documents…) on desktops numbered 1 "
           "to 10 and name those desktops; on a desktop, the main app on the left, tools on the right; adresse = the 0x… "
           "address of a listed window; only move what benefits from it. For the best layout of a desktop, you can put "
           "each window in a zone with fenetre_zone (x, y, largeur = width, hauteur = height as integer percentages of the "
           "usable screen), regardless of the automatic tiling layout: the zones of one desktop cover the screen without "
           "overlapping, the biggest for the main activity; give a zone to every window of the desktop."
           if "fenetres" in domaines else ""))


def lire_json(texte):
    t = re.sub(r"^```(?:json)?|```$", "", texte.strip(), flags=re.M).strip()
    debut, fin = t.find("{"), t.rfind("}")
    if debut < 0 or fin <= debut:
        raise ErreurIA(T("L'IA n'a pas répondu par un plan lisible.", "The AI did not answer with a readable plan."))
    try:
        d = json.loads(t[debut:fin + 1])
    except ValueError:
        raise ErreurIA(T("L'IA n'a pas répondu par un plan lisible.", "The AI did not answer with a readable plan.")) from None
    if not isinstance(d, dict):
        raise ErreurIA(T("Plan illisible.", "Unreadable plan."))
    return d


def valider_action(a, domaines, services=None, fenetres=None, bureau=None):
    """L'action normalisée {outil, args, libelle, danger, lecture}, ou ErreurIA (outil inconnu ou interdit, valeur hors
    bornes). bureau : la portée du plan (« Organiser ce bureau ») — aucune fenêtre d'ailleurs (fenetres ne contient que
    les siennes), aucun déplacement vers un autre bureau, aucun autre bureau renommé (revue IA-06)."""
    if not isinstance(a, dict) or a.get("outil") not in OUTILS:
        raise ErreurIA(T("outil inconnu", "unknown tool") + f" : {str(a.get('outil') if isinstance(a, dict) else a)[:40]}")
    nom_o, o = a["outil"], OUTILS[a["outil"]]
    if o["domaine"] not in domaines:
        raise ErreurIA(T(f"{nom_o} n'est pas permis (nc-reglages → Intelligence artificielle)",
                         f"{nom_o} is not allowed (nc-settings → Artificial intelligence)"))
    brut = a.get("args") if isinstance(a.get("args"), dict) else {}
    args = {}
    for k in o["args"]:
        v = str(brut.get(k, "")).strip()
        if k == "nom" and nom_o == "bureau_nommer":
            if not re.fullmatch(r"[\w][\w .\-]{0,19}", v):
                raise ErreurIA(T("nom de bureau invalide", "invalid desktop name"))
        elif k == "nom":
            services = services if services is not None else services_session()
            if v not in services:
                raise ErreurIA(T(f"service inconnu de ta session : {v[:60]}", f"service not in your session: {v[:60]}"))
        elif k in ("adresse", "autre"):
            fenetres = fenetres if fenetres is not None else fenetres_bureau()
            if not re.fullmatch(r"0x[0-9a-f]{1,16}", v) or v not in fenetres:
                raise ErreurIA(T(f"fenêtre introuvable : {v[:20]}", f"window not found: {v[:20]}"))
        elif k == "bureau":
            try:
                v = str(int(v))
            except ValueError:
                raise ErreurIA(T("numéro de bureau attendu", "desktop number expected")) from None
            if not 1 <= int(v) <= 10:
                raise ErreurIA(T("bureau de 1 à 10", "desktop from 1 to 10"))
            if bureau is not None and int(v) != bureau:
                raise ErreurIA(T(f"hors de ce bureau (seulement le bureau {bureau})", f"outside this desktop (only desktop {bureau})"))
        elif k == "direction":
            v = DIRECTIONS.get(v.lower(), "")
            if not v:
                raise ErreurIA(T("direction : gauche, droite, haut ou bas", "direction: left, right, up or down"))
        elif k == "etat":
            v = {"on": "on", "off": "off", "oui": "on", "non": "off", "true": "on", "false": "off"}.get(v.lower(), "")
            if not v:
                raise ErreurIA(T("état attendu : on ou off", "expected state: on or off"))
        elif k == "profil":
            v = {"economie": "power-saver", "économie": "power-saver", "equilibre": "balanced", "équilibré": "balanced"}.get(v.lower(), v.lower())
            if v not in PROFILS:
                raise ErreurIA(T("profil inconnu", "unknown profile") + f" : {v[:30]}")
        elif k == "pourcent":
            try:
                n = int(float(v.rstrip("%")))
            except ValueError:
                raise ErreurIA(T("pourcentage attendu", "percentage expected")) from None
            v = str(max(0, min(150 if nom_o == "volume" else 100, n)))
        elif k == "cle":
            if not re.fullmatch(r"[A-Z0-9_]{2,60}", v) or v.startswith("IA_") or v in ("SPOTLIGHT_IA", "ALERTES_TELEGRAM"):
                raise ErreurIA(T(f"réglage interdit à l'IA : {v[:40]}", f"setting forbidden to the AI: {v[:40]}"))
        elif k == "valeur":
            if not re.fullmatch(r"[^\n\x00]{0,200}", v):
                raise ErreurIA(T("valeur invalide", "invalid value"))
        elif k in ("x", "y", "largeur", "hauteur"):
            try:
                v = str(max(0, min(100, int(round(float(v.rstrip("%")))))))
            except ValueError:
                raise ErreurIA(T("zone : pourcentages entiers attendus", "zone: integer percentages expected")) from None
        args[k] = v
    if nom_o == "fenetre_zone":
        x, y, l_, h_ = (int(args[k]) for k in ("x", "y", "largeur", "hauteur"))
        if l_ < 10 or h_ < 10 or x + l_ > 100 or y + h_ > 100:
            raise ErreurIA(T("zone hors de l'écran ou trop petite (10 % au moins)", "zone off screen or too small (10 % at least)"))
    if "adresse" in args or "autre" in args:
        fenetres = fenetres if fenetres is not None else fenetres_bureau()
        court = lambda ad: (fenetres.get(ad, {}).get("class") or ad)
        args_l = dict(args, nom_fenetre=court(args.get("adresse", "")), nom_autre=court(args.get("autre", "")),
                      direction_fr=DIRECTIONS_FR.get(args.get("direction", ""), ""))
    else:
        args_l = args
    libelle = (o["en"] if EN else o["fr"]).format(**args_l)
    return dict(outil=nom_o, args=args, libelle=libelle, danger=bool(o.get("danger")), lecture=bool(o.get("lecture")))


def actuel(v, fenetres):
    """Aperçu sans IA : la valeur d'aujourd'hui de ce que l'action changerait (« 40 % », « bureau 2 », « off »), ou
    "" si elle ne se lit pas ; à côté de l'action, avant ta confirmation."""
    o, g = v["outil"], v["args"]
    try:
        if o in ("fenetre_bureau", "fenetre_libre", "fenetre_plein_ecran"):
            x = fenetres.get(g.get("adresse"), {})
            if o == "fenetre_bureau":
                return T("bureau ", "desktop ") + str((x.get("workspace") or {}).get("id", "?"))
            if o == "fenetre_libre":
                return "on" if x.get("floating") else "off"
            return "on" if x.get("fullscreen") else "off"
        if o == "luminosite":
            n = re.search(r"\d+", sortie_cmd([str(HOME / ".local/bin/nc-brightness"), "get"])[1])
            return f"{n[0]} %" if n else ""
        if o in ("volume", "muet") and shutil.which("wpctl"):
            t = sortie_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])[1]
            if o == "muet":
                return "on" if "MUTED" in t else "off" if t else ""
            n = re.search(r"(\d+\.\d+)", t)
            return f"{round(float(n[1]) * 100)} %" if n else ""
        if o == "wifi" and shutil.which("nmcli"):
            t = sortie_cmd(["nmcli", "radio", "wifi"])[1]
            return "on" if t == "enabled" else "off" if t == "disabled" else ""
        if o == "bluetooth" and shutil.which("bluetoothctl"):
            t = sortie_cmd(["bluetoothctl", "show"])[1]
            return "on" if "Powered: yes" in t else "off" if "Powered: no" in t else ""
        if o == "profil_energie":
            t = sortie_cmd(["busctl", "get-property", "org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles",
                            "org.freedesktop.UPower.PowerProfiles", "ActiveProfile"])[1]
            return t.split('"')[1] if t.count('"') >= 2 else ""
        if o == "reglage":
            return reglage(g["cle"], "") or T("par défaut", "default")
    except (OSError, ValueError, IndexError, KeyError):
        pass
    return ""


def apercu_action(v, fenetres):
    """Le libellé avec l'état d'aujourd'hui : « Luminosité : 70 % (maintenant : 40 %) », ou « (déjà le cas) »."""
    avant = actuel(v, fenetres)
    if not avant:
        return v
    cible = {"fenetre_bureau": T("bureau ", "desktop ") + str(v["args"].get("bureau")), "luminosite": f"{v['args'].get('pourcent')} %",
             "volume": f"{v['args'].get('pourcent')} %", "reglage": v["args"].get("valeur")}.get(v["outil"])
    if cible is None:
        cible = v["args"].get("etat") or v["args"].get("profil")
    v["avant"] = avant
    v["libelle"] += T(" (déjà le cas)", " (already so)") if avant == cible else T(f" (maintenant : {avant})", f" (now: {avant})")
    return v


def zone_lua(g):
    """Les commandes qui posent la fenêtre dans sa zone, ou None : la place utile de son écran (sous la barre et ses réservations, marges de Hyprland
    déduites), découpée en pourcentages, avec l'écart entre fenêtres de Hyprland ; la fenêtre devient libre."""
    def lire(cmd):
        try:
            return json.loads(subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout or "null")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return None

    def ecart(option, defaut):                   # « 10 10 10 10 » (css) ou un entier selon la version de Hyprland
        v = lire(["hyprctl", "getoption", option, "-j"])
        v = v if isinstance(v, dict) else {}
        m = re.match(r"\s*(\d+)", str(v.get("css", v.get("int", ""))))
        return int(m[1]) if m else defaut
    adr = g["adresse"]
    fenetre = next((c for c in (lire(["hyprctl", "clients", "-j"]) or []) if c.get("address") == adr), None)
    ecran = next((m for m in (lire(["hyprctl", "monitors", "-j"]) or []) if fenetre and m.get("id") == fenetre.get("monitor")), None)
    if not fenetre or not ecran:
        return None
    k = float(ecran.get("scale") or 1)
    lw, lh = ecran["width"] / k, ecran["height"] / k
    if int(ecran.get("transform") or 0) % 2:
        lw, lh = lh, lw
    gauche, haut, droite, bas = (list(ecran.get("reserved") or []) + [0, 0, 0, 0])[:4]
    dehors, dedans = ecart("general:gaps_out", 10), ecart("general:gaps_in", 4) * 2
    ax, ay = ecran.get("x", 0) + gauche + dehors, ecran.get("y", 0) + haut + dehors
    aw, ah = lw - gauche - droite - 2 * dehors, lh - haut - bas - 2 * dehors
    x, y, l_, h_ = (int(g[c]) for c in ("x", "y", "largeur", "hauteur"))
    px_ = ax + aw * x / 100 + (dedans / 2 if x > 0 else 0)
    py_ = ay + ah * y / 100 + (dedans / 2 if y > 0 else 0)
    pw = aw * l_ / 100 - (dedans / 2 if x > 0 else 0) - (dedans / 2 if x + l_ < 100 else 0)
    ph = ah * h_ / 100 - (dedans / 2 if y > 0 else 0) - (dedans / 2 if y + h_ < 100 else 0)
    sel = f"address:{adr}"
    lua = []
    if fenetre.get("fullscreen"):
        lua.append(f"hl.dsp.window.fullscreen({{ action = 'unset', window = '{sel}' }})")
    if not fenetre.get("floating"):
        lua.append(f"hl.dsp.window.float({{ action = 'set', window = '{sel}' }})")
    lua += [f"hl.dsp.window.resize({{ x = {round(pw)}, y = {round(ph)}, window = '{sel}' }})",
            f"hl.dsp.window.move({{ x = {round(px_)}, y = {round(py_)}, window = '{sel}' }})"]
    return lua


def lua_fenetre(v):
    """Les commandes Hyprland (Lua) d'une action sur les fenêtres ou les bureaux, ou None si elle ne se fait pas."""
    o, g = v["outil"], v["args"]
    if o == "fenetre_zone":
        return zone_lua(g)
    sel = f"address:{g.get('adresse', '')}"
    return [{"fenetre_bureau": f"hl.dsp.window.move({{ workspace = {g.get('bureau')}, follow = false, window = '{sel}' }})",
             "fenetre_direction": f"hl.dsp.window.move({{ direction = '{g.get('direction')}', window = '{sel}' }})",
             "fenetre_echanger": f"hl.dsp.window.swap({{ window = '{sel}', target = 'address:{g.get('autre', '')}' }})",
             "fenetre_libre": f"hl.dsp.window.float({{ action = '{'set' if g.get('etat') == 'on' else 'unset'}', window = '{sel}' }})",
             "fenetre_plein_ecran": f"hl.dsp.window.fullscreen({{ action = '{'set' if g.get('etat') == 'on' else 'unset'}', window = '{sel}' }})",
             "bureau_nommer": f"hl.dsp.workspace.rename({{ workspace = {g.get('bureau')}, name = [[{g.get('nom', '')}]] }})"}[o]]


def ensemble(lua, apres=()):
    """Toutes les commandes dans le même appel : Hyprland les applique dans la même image, et chaque fenêtre glisse
    d'un seul mouvement vers sa place (une par une, elle sautait : libre au centre, puis taille, puis place).
    apres : du Lua tel quel, à la fin (poser les zones d'un bureau)."""
    if not lua and not apres:
        return True
    code, t = sortie_cmd(["hyprctl", "eval", " " + " ".join([f"hl.dispatch({l})" for l in lua] + list(apres))])
    return code == 0 and "error" not in t.lower()


def executer_action(a):
    """(réussi, message) ; a est une action déjà validée."""
    o, g = a["outil"], a["args"]
    nb = str(HOME / ".local/bin") + os.sep          # le séparateur final : Path le retirerait (revue Codex IA-01)
    if o.startswith("service_"):
        if o == "service_journal":
            code, t = sortie_cmd(["journalctl", "--user", "-u", g["nom"], "-n", "40", "--no-pager", "-o", "cat"])
            return code == 0, caviarder(t[-6000:])           # lu pour l'IA, sans confirmation : secrets masqués
        verbe = {"service_redemarrer": "restart", "service_demarrer": "start", "service_arreter": "stop"}[o]
        code, t = sortie_cmd(["systemctl", "--user", verbe, g["nom"]], 30)
        etat = sortie_cmd(["systemctl", "--user", "is-active", g["nom"]])[1]
        return code == 0, (t or etat)
    if o == "wifi":
        cmd = ["nmcli", "radio", "wifi", g["etat"]] if shutil.which("nmcli") else ["rfkill", "unblock" if g["etat"] == "on" else "block", "wifi"]
        code, t = sortie_cmd(cmd)
        return code == 0, t
    if o == "bluetooth":
        cmd = ["bluetoothctl", "power", g["etat"]] if shutil.which("bluetoothctl") else ["rfkill", "unblock" if g["etat"] == "on" else "block", "bluetooth"]
        code, t = sortie_cmd(cmd)
        return code == 0, t
    if o == "profil_energie":
        code, t = sortie_cmd(["busctl", "set-property", "org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles",
                              "org.freedesktop.UPower.PowerProfiles", "ActiveProfile", "s", g["profil"]])
        return code == 0, t
    if o == "luminosite":
        code, t = sortie_cmd([nb + "nc-brightness", "set", g["pourcent"]])
        return code == 0, t
    if o == "volume":
        code, t = sortie_cmd(["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", g["pourcent"] + "%"])
        return code == 0, t
    if o == "muet":
        code, t = sortie_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if g["etat"] == "on" else "0"])
        return code == 0, t
    if o == "reglage":
        code, t = sortie_cmd([nb + "nc-reglages", "set", g["cle"], g["valeur"]], 60)
        return code == 0, t
    if o.startswith("fenetre_") or o == "bureau_nommer":
        lua = lua_fenetre(a)
        if lua is None:
            return False, T("fenêtre ou écran introuvable", "window or screen not found")
        for l in lua:
            code, t = sortie_cmd(["hyprctl", "dispatch", l])
            if code != 0 or "error" in t.lower():
                return False, t
        return True, ""
    if o == "maj_verifier":
        code, t = sortie_cmd([nb + "nc-paquets", "verifier"], 300)
        return code == 0, t
    if o == "maj_installer":
        code, t = sortie_cmd([nb + "nc-paquets", "mettre-a-jour"], 30)
        return code == 0, t
    return False, T("outil inconnu", "unknown tool")


def droit_d_agir():
    """Les réglages relus (pas le cache) : l'IA ou ses actions coupées pendant qu'elle répondait ou qu'une action se
    faisait, ErreurIA (code 3 si l'IA est coupée, 1 sinon) ; sinon, les domaines permis maintenant."""
    global _reglages
    _reglages = None
    if coupee():
        raise ErreurIA(message_coupee())
    if actions_mode() == "non":
        raise ErreurIA(T("L'IA n'a pas le droit d'agir.", "The AI is not allowed to act."))
    return domaines_permis()


def agir(demande, bureau=None):
    """Le plan de l'IA pour cette demande : {id, reponse, ia, actions: [{n, libelle, danger, fait, ok, resultat}], refus}.
    bureau : portée « ce bureau seulement », gardée dans le plan et revérifiée à l'exécution."""
    if coupee():
        raise ErreurIA(message_coupee())
    if actions_mode() == "non":
        raise ErreurIA(T("L'IA n'a pas le droit d'agir (nc-reglages → Intelligence artificielle → L'IA peut agir).",
                         "The AI is not allowed to act (nc-settings → Artificial intelligence → The AI can act)."))
    domaines = domaines_permis()
    if not domaines:
        raise ErreurIA(T("Aucun domaine permis à l'IA (nc-reglages → Intelligence artificielle).",
                         "No domain allowed to the AI (nc-settings → Artificial intelligence)."))
    services = services_session() if "services" in domaines else {}
    fenetres = fenetres_bureau(bureau) if "fenetres" in domaines else {}
    texte = T("État du bureau :\n", "Desktop state:\n") + etat_bureau(domaines, bureau) + T("\n\nDemande : ", "\n\nRequest: ") + demande
    consigne_a = consigne_agent(domaines)
    d, ident = None, ""
    for tour in range(2):                       # un second tour seulement pour lire des journaux
        rep, ident = demander(texte, "texte", consigne_=consigne_a, sortie=lambda m: None)
        d = lire_json(rep)
        lectures = [a for a in (d.get("actions") or []) if isinstance(a, dict) and OUTILS.get(a.get("outil"), {}).get("lecture")]
        if not lectures or tour == 1:
            break
        # Coupé pendant que l'IA répondait (IA, ses actions, ou le domaine d'un journal à lire) : rien n'est lu, et
        # aucune deuxième requête ne part (contre-relecture de B2, comme B2-03)
        domaines = droit_d_agir()
        coupes = {OUTILS[a["outil"]]["domaine"] for a in lectures[:4]} - set(domaines)
        if coupes:
            raise ErreurIA(T("Coupé pendant la réponse de l'IA : rien n'a été lu (", "Turned off during the AI's answer: "
                             "nothing was read (") + ", ".join(sorted(coupes)) + ").")
        resultats = []
        for a in lectures[:4]:
            try:
                v = valider_action(a, domaines, services, fenetres, bureau)
                resultats.append(f"=== {v['libelle']} ===\n" + caviarder(executer_action(v)[1]))
            except ErreurIA as e:
                resultats.append(f"=== {a.get('outil')} === {e}")
        texte += T("\n\nRésultats de tes lectures :\n", "\n\nResults of your reads:\n") + "\n".join(resultats) + \
            T("\n\nPropose maintenant le plan final (sans nouvelle lecture).", "\n\nNow propose the final plan (no more reads).")
    domaines = droit_d_agir()                   # pareil pour le plan : coupé entre-temps, aucun plan gardé
    plan = dict(id=os.urandom(8).hex(), t=time.time(), reponse=str(d.get("reponse") or "")[:2000], ia=nom(ident),
                agent=FOURNISSEURS.get(ident, {}).get("agent", "claude"), actions=[], refus=[],
                portee={"bureau": bureau} if bureau is not None else {})
    for a in (d.get("actions") or [])[:8]:
        try:
            v = apercu_action(valider_action(a, domaines, services, fenetres, bureau), fenetres)
        except ErreurIA as e:
            plan["refus"].append(str(e))
            continue
        if v["lecture"]:
            continue
        v.update(n=len(plan["actions"]), fait=False, ok=None, resultat="")
        plan["actions"].append(v)
    garder_plan(plan)                           # rien n'est fait : chaque action attend ta confirmation
    return plan


def garder_plan(plan):
    PLANS.mkdir(mode=0o700, parents=True, exist_ok=True)
    f = PLANS / f"{plan['id']}.json"
    tmp = f.with_name(f".{f.name}.{os.getpid()}.tmp")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as o:
            o.write(json.dumps(plan, ensure_ascii=False))
        tmp.replace(f)                                   # atomique : jamais un plan à moitié écrit
    except BaseException:                                # interrompu (SIGTERM, erreur) : pas de fichier temporaire laissé
        tmp.unlink(missing_ok=True)
        raise


def executer_plan(ident, numeros=None):
    """Exécute les actions encore à faire d'un plan proposé il y a moins de 10 min (toutes, ou ces numéros). Un verrou
    par plan couvre lecture, vérification, exécution et écriture : deux confirmations en même temps n'exécutent jamais
    une action deux fois (revue Codex IA-02) ; le fichier de verrou n'est jamais supprimé."""
    if coupee() or actions_mode() == "non":
        raise ErreurIA(message_coupee() if coupee() else T("L'IA n'a pas le droit d'agir.", "The AI is not allowed to act."))
    if not re.fullmatch(r"[0-9a-f]{16}", ident or ""):
        raise ErreurIA(T("plan inconnu", "unknown plan"))
    import fcntl
    PLANS.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(PLANS / f"{ident}.lock", "a") as verrou:
        fcntl.flock(verrou, fcntl.LOCK_EX)
        try:
            # Les réglages ont pu changer pendant l'attente du verrou (IA coupée) : relus (revue IA-05)
            global _reglages
            _reglages = None
            if coupee() or actions_mode() == "non":
                raise ErreurIA(message_coupee() if coupee() else T("L'IA n'a pas le droit d'agir.", "The AI is not allowed to act."))
            return _executer_plan(ident, numeros)
        finally:
            fcntl.flock(verrou, fcntl.LOCK_UN)


def _executer_plan(ident, numeros):
    f = PLANS / f"{ident}.json"
    try:
        plan = json.loads(f.read_text())
    except (OSError, ValueError):
        raise ErreurIA(T("Plan introuvable ou expiré : redemande.", "Plan not found or expired: ask again.")) from None
    if time.time() - plan.get("t", 0) > 600:
        f.unlink(missing_ok=True)
        raise ErreurIA(T("Plan expiré (plus de 10 min) : redemande.", "Plan expired (over 10 min): ask again."))
    # Une action commencée puis interrompue (nc-ia arrêté pendant qu'elle se faisait : Spotlight fermé, déconnexion) a
    # peut-être eu lieu : montrée comme interrompue, jamais refaite toute seule (revue B2-01 : deux fois le volume)
    for a in plan["actions"]:
        if a.get("en_cours"):
            a.update(en_cours=False, fait=True, ok=False,
                     resultat=T("interrompue : peut-être faite, vérifie avant de redemander",
                                "interrupted: maybe done, check before asking again"))
    domaines = domaines_permis()
    bureau = (plan.get("portee") or {}).get("bureau")
    services = services_session() if "services" in domaines else {}
    fenetres = fenetres_bureau(bureau) if "fenetres" in domaines else {}
    for a in plan["actions"]:
        if a.get("fait") or (numeros is not None and a["n"] not in numeros):
            continue
        # Réglages relus avant chaque action : l'IA (ou ses actions, ou ce domaine) coupée pendant la précédente, la
        # suivante ne se fait pas (revue B2-02) ; ce qui est déjà fait reste noté, et joint à l'erreur : le Spotlight
        # montre la première comme faite, pas encore « à faire »
        try:
            domaines = droit_d_agir()
        except ErreurIA as e:
            garder_plan(plan)
            e.plan = plan
            raise
        try:                                     # revérifiée : les permissions ont pu changer depuis la proposition
            v = valider_action({"outil": a["outil"], "args": a["args"]}, domaines, services, fenetres, bureau)
        except ErreurIA as e:
            a.update(fait=True, ok=False, resultat=str(e))
            continue
        # Notée « en cours » avant d'être lancée, et le plan gardé : arrêtée au milieu, elle n'est jamais rejouée
        a.update(fait=True, en_cours=True, ok=None, resultat=T("en cours", "in progress"))
        garder_plan(plan)
        try:
            a["ok"], a["resultat"] = executer_action(v)
            if bureau is not None and a["outil"] == "fenetre_direction":
                a["note"] = garder_sur_bureau(v["args"]["adresse"], bureau)
        except ErreurIA as e:
            a["ok"], a["resultat"] = False, str(e)
        a["en_cours"] = False
        garder_plan(plan)
    garder_plan(plan)
    return plan


def garder_sur_bureau(adresse, bureau):
    """« Organiser ce bureau » : poussée au bord de l'écran, une fenêtre passe sur l'écran voisin (donc un autre bureau) ;
    elle est remise sur ce bureau. La note, affichée avec « Fait » (sinon on croirait qu'elle a bougé), ou ""."""
    try:
        c = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
        ici = next((x.get("workspace") or {}).get("id") for x in c if x.get("address") == adresse)
    except (OSError, ValueError, StopIteration, subprocess.TimeoutExpired):
        return ""
    if ici == bureau:
        return ""
    sortie_cmd(["hyprctl", "dispatch", f"hl.dsp.window.move({{ workspace = {int(bureau)}, follow = false, window = 'address:{adresse}' }})"])
    return T(f"bord de l'écran : remise sur le bureau {bureau}", f"edge of the screen: put back on desktop {bureau}")


# ── Ranger les fenêtres tout de suite (Super + Maj + O, Super + Ctrl + O) ────────────────────────────────────────
# Le raccourci est ta demande : l'IA range sans rien demander (fenêtres et bureaux seulement, chaque action revérifiée),
# puis une notification de l'île dit ce qui a bougé, avec « Annuler » qui remet tout comme avant.
# Réglage IA_ORGANISER : auto (défaut), confirmer (plan à confirmer dans le Spotlight, comme avant), non.
ANNULER_RANGEMENT = CACHE / "rangement-avant.json"


def photo_fenetres():
    """Bureau, état libre ou plein écran, place et taille de chaque fenêtre, et le nom des bureaux : de quoi annuler."""
    try:
        c = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
        b = json.loads(subprocess.run(["hyprctl", "workspaces", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return dict(t=time.time(),
                fenetres={x["address"]: dict(bureau=(x.get("workspace") or {}).get("id"), libre=bool(x.get("floating")),
                                             classe=x.get("class") or "",
                                             plein=int(x.get("fullscreen") or 0), at=x.get("at"), taille=x.get("size"))
                          for x in c if x.get("mapped") and (x.get("workspace") or {}).get("id", 0) > 0},
                bureaux={str(x["id"]): x.get("name") for x in b if x.get("id", 0) > 0})


def arbre_zones(zones, marge=3):
    """{adresse: (x, y, largeur, hauteur)} en pourcentages → l'arbre de découpes de la disposition nc-zones
    (hypr/nc/zones.lua) : une coupe verticale ou horizontale qu'aucune zone ne traverse (à `marge` % près : l'IA
    arrondit, 61 % à côté de 60 % reste une coupe, posée entre les deux bords), sa position relative r, puis pareil de
    chaque côté. Des zones qui ne se découpent pas ainsi (moulinet, gros chevauchement) : une découpe simple, les
    zones triées dans le sens de l'écran et coupées en deux par le plus grand côté — jamais rien (revue ZON-02)."""
    def couper(adrs, bx, by, bw, bh):
        if len(adrs) == 1:
            return {"f": adrs[0]}
        for sens, debut, fin, b0, bt in (("v", 0, 2, bx, bw), ("h", 1, 3, by, bh)):
            for c in sorted({zones[a][debut] + zones[a][fin] for a in adrs}):
                gauche = [a for a in adrs if zones[a][debut] + zones[a][fin] <= c + marge]
                droite = [a for a in adrs if zones[a][debut] >= c - marge and a not in gauche]
                if not gauche or not droite or len(gauche) + len(droite) != len(adrs):
                    continue
                coupe = (max(zones[a][debut] + zones[a][fin] for a in gauche) + min(zones[a][debut] for a in droite)) / 2
                if not b0 < coupe < b0 + bt:
                    continue
                boite_a = (bx, by, coupe - bx, bh) if sens == "v" else (bx, by, bw, coupe - by)
                boite_b = (coupe, by, bx + bw - coupe, bh) if sens == "v" else (bx, coupe, bw, by + bh - coupe)
                ga, gb = couper(gauche, *boite_a), couper(droite, *boite_b)
                if ga and gb:
                    return {"sens": sens, "r": round((coupe - b0) / bt, 4), "a": ga, "b": gb}
        return None

    def simple(adrs, bw, bh):
        if len(adrs) == 1:
            return {"f": adrs[0]}
        sens = "v" if bw >= bh else "h"
        adrs = sorted(adrs, key=lambda a: (zones[a][0] + zones[a][2] / 2, zones[a][1]) if sens == "v"
                      else (zones[a][1] + zones[a][3] / 2, zones[a][0]))
        n = len(adrs) // 2
        r = round(n / len(adrs), 4)
        return {"sens": sens, "r": r, "a": simple(adrs[:n], bw * r if sens == "v" else bw, bh * r if sens == "h" else bh),
                "b": simple(adrs[n:], bw * (1 - r) if sens == "v" else bw, bh * (1 - r) if sens == "h" else bh)}
    adrs = sorted(zones, key=lambda a: (zones[a][0], zones[a][1]))
    if not adrs:
        return None
    return couper(adrs, 0, 0, 100, 100) or simple(adrs, 100, 100)


def lua_arbre(n):
    if "f" in n:
        return '{ f = "%s" }' % n["f"]
    return '{ sens = "%s", r = %s, a = %s, b = %s }' % (n["sens"], n["r"], lua_arbre(n["a"]), lua_arbre(n["b"]))


def zones_dispo():
    """La disposition nc-zones est-elle chargée dans Hyprland (hl.layout.register, Hyprland récent) ?"""
    return sortie_cmd(["hyprctl", "eval", "if not (nc and nc.zones_dispo) then error('absent') end"], 5)[0] == 0


def ranger(bureau_seul):
    sync = ["-h", "string:x-canonical-private-synchronous:nc-rangement"]

    def dire(titre, corps, annuler=False):
        if not shutil.which("notify-send"):
            return ""
        cmd = ["notify-send", "-a", "IA", "-i", "view-grid"] + sync + (["-A", "annuler=" + T("Annuler", "Undo")] if annuler else [])
        try:
            return subprocess.run(cmd + ["--", titre, corps_sur(corps)], capture_output=True, text=True,
                                  timeout=600 if annuler else 10, stdin=subprocess.DEVNULL).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return ""
    titre = T("Ranger ce bureau", "Tidy this desktop") if bureau_seul else T("Ranger les fenêtres", "Tidy windows")
    if coupee():
        dire(titre, message_coupee())
        return 3
    if reglage("IA_GERER_FENETRES", "oui") == "non":
        dire(titre, T("Coupé dans nc-reglages → Intelligence artificielle (fenêtres et bureaux).",
                      "Turned off in nc-settings → Artificial intelligence (windows and desktops)."))
        return 1
    bureau = bureau_affiche() if bureau_seul else None
    if bureau_seul and bureau is None:           # inconnu : « ce bureau seulement » deviendrait « tous » (revue B2-12)
        dire(titre, message_bureau_inconnu())
        return 1
    # Rien n'a bougé depuis le dernier rangement (même raccourci, même bureau) : ce second appui remet comme avant
    try:
        dernier = json.loads(ANNULER_RANGEMENT.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        dernier = None
    if isinstance(dernier, dict) and dernier.get("portee") == bureau and inchange(dernier.get("apres"), photo_fenetres(), bureau):
        annuler_rangement()
        dire(titre, T("Disposition d'avant remise.", "Previous layout restored."))
        return 0
    fenetres = fenetres_bureau(bureau)
    if not fenetres:
        dire(titre, T("Aucune fenêtre à ranger.", "No window to tidy."))
        return 0
    dire(titre, T("L'IA range tes fenêtres…", "The AI is tidying your windows…"))
    demande = T("Range les fenêtres du bureau affiché de la façon la plus utile, sans les changer de bureau : pose "
                "chacune dans sa zone (fenetre_zone), toutes ensemble couvrant l'écran sans se chevaucher, sans suivre "
                "la disposition automatique ; la plus grande zone pour l'appli principale.",
                "Tidy the windows of the shown desktop in the most useful way, without changing their desktop: put each "
                "one in its zone (fenetre_zone), all together covering the screen without overlapping, regardless of the "
                "automatic layout; the biggest zone for the main app.") if bureau_seul else \
        T("Organise toutes mes fenêtres : regroupe-les par activité sur des bureaux, nomme les bureaux, puis dispose-les "
          "bien sur chacun.", "Organize all my windows: group them by activity on desktops, name the desktops, then lay "
          "them out well on each one.")
    texte = T("État du bureau :\n", "Desktop state:\n") + etat_bureau(["fenetres"], bureau) + T("\n\nDemande : ", "\n\nRequest: ") + demande
    try:
        rep, _ = demander(texte, "texte", consigne_=consigne_agent(["fenetres"]), sortie=lambda m: None)
    except ErreurIA as e:
        dire(titre, T("Rangement impossible : ", "Could not tidy: ") + str(e)[:200])
        return 1
    # Coupé pendant que l'IA réfléchissait (IA, rangement, ou fenêtres et bureaux) : rien ne bouge (revue B2-03)
    global _reglages
    _reglages = None
    if coupee() or reglage("IA_ORGANISER", "auto") == "non" or reglage("IA_GERER_FENETRES", "oui") == "non":
        dire(titre, message_coupee() if coupee() else T("Coupé pendant la réponse de l'IA : rien n'a bougé.",
                                                         "Turned off during the AI's answer: nothing moved."))
        return 3
    d = lire_json(rep)
    valides = []
    for a in (d.get("actions") or [])[:12]:
        try:
            valides.append(valider_action(a, ["fenetres"], {}, fenetres, bureau))
        except ErreurIA:
            continue                                     # hors des fenêtres, ou d'un autre bureau : ignoré
    if not valides:
        dire(titre, (str(d.get("reponse") or "") or T("Rien à changer : c'est déjà bien rangé.", "Nothing to change: already tidy."))[:300])
        return 0
    avant = photo_fenetres()
    lua, faits, apres_lua, arbres = [], [], [], {}
    # Zones : les fenêtres restent en tuiles, dans la disposition nc-zones du bureau (raccourcis, ouverture, fermeture
    # marchent comme ailleurs) ; sans elle (Hyprland plus ancien), elles deviennent libres et sont posées à leur place
    zonees = [v for v in valides if v["outil"] == "fenetre_zone"]
    if zonees and zones_dispo():
        cible = {v["args"]["adresse"]: int(v["args"]["bureau"]) for v in valides if v["outil"] == "fenetre_bureau"}
        par_bureau = {}
        for v in zonees:
            adr = v["args"]["adresse"]
            b = cible.get(adr, (fenetres.get(adr, {}).get("workspace") or {}).get("id"))
            par_bureau.setdefault(b, {})[adr] = tuple(int(v["args"][k]) for k in ("x", "y", "largeur", "hauteur"))
        for b, zones in par_bureau.items():
            arbre = arbre_zones(zones)
            if not arbre or not isinstance(b, int):
                continue                                 # zones qui ne se découpent pas : ce bureau reste comme il est
            for adr in zones:
                f = fenetres.get(adr, {})
                if f.get("fullscreen"):
                    lua.append(f"hl.dsp.window.fullscreen({{ action = 'unset', window = 'address:{adr}' }})")
                if f.get("floating"):
                    lua.append(f"hl.dsp.window.float({{ action = 'unset', window = 'address:{adr}' }})")
            apres_lua.append(f"nc.zones_poser({b}, {lua_arbre(arbre)})")
            arbres[str(b)] = arbre
            faits.append(T(f"Bureau {b} : {len(zones)} fenêtre(s) en zones", f"Desktop {b}: {len(zones)} window(s) in zones"))
        valides = [v for v in valides if v["outil"] != "fenetre_zone"]
    for v in valides:
        l = lua_fenetre(v)
        if l:
            lua += l
            faits.append(v["libelle"])
    if not faits or not ensemble(lua, apres_lua):
        dire(titre, T("Rien n'a pu être déplacé.", "Nothing could be moved."))
        return 1
    if bureau is not None:
        for v in valides:
            if v["outil"] == "fenetre_direction":
                garder_sur_bureau(v["args"]["adresse"], bureau)
    if avant:
        time.sleep(0.8)                                  # la fin du glissement des fenêtres (windowsMove)
        try:
            ANNULER_RANGEMENT.parent.mkdir(parents=True, exist_ok=True)
            fd = os.open(ANNULER_RANGEMENT, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(dict(avant, portee=bureau, apres=photo_fenetres(), arbres=arbres,
                               zones=[int(l.split("(")[1].split(",")[0]) for l in apres_lua]), f)
        except OSError:
            pass
        # Gardé deux minutes sans rien changer : mémorisé pour ces applis (« Tes dispositions »)
        if arbres and reglage("DISPOSITIONS_PROPOSER", "oui") != "non":
            subprocess.Popen(["sh", "-c", 'sleep "${NC_DISPOSITIONS_DELAI:-120}"; exec "$0" disposition-garder', sys.argv[0]],
                             start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    corps = " · ".join(faits[:4]) + (T(f" (+ {len(faits) - 4} autres)", f" (+ {len(faits) - 4} more)") if len(faits) > 4 else "")
    if dire(T("Fenêtres rangées", "Windows tidied"), corps, annuler=bool(avant)) == "annuler":
        annuler_rangement()
    return 0


# ── Tes dispositions : un rangement en zones gardé est mémorisé pour l'ensemble des applis de son bureau ; quand ces
# mêmes applis sont de nouveau réunies sur un bureau, l'île propose de la reprendre — sans IA (marche avec IA_MODE=non).
# Réglage DISPOSITIONS_PROPOSER ; « Non » trois fois de suite pour un même ensemble : plus proposé.
DISPOSITIONS = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "noctalia-config/dispositions.json"


def lire_dispositions():
    try:
        d = json.loads(DISPOSITIONS.read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def ecrire_dispositions(d):
    DISPOSITIONS.parent.mkdir(parents=True, exist_ok=True)
    tmp = DISPOSITIONS.with_name(f".{DISPOSITIONS.name}.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False)
    tmp.replace(DISPOSITIONS)


def cle_disposition(classes):
    return "+".join(sorted(c.lower() for c in classes if c))


def zones_actives(bureau):
    return sortie_cmd(["hyprctl", "eval", f"if not (nc and nc.zones and nc.zones[{int(bureau)}]) then error('non') end"], 5)[0] == 0


def disposition_garder():
    """Deux minutes après un rangement : si rien n'a bougé et que les zones sont toujours là, chaque bureau rangé est
    mémorisé, ses feuilles portant la classe de l'appli au lieu de l'adresse de la fenêtre."""
    try:
        dernier = json.loads(ANNULER_RANGEMENT.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 0
    maintenant = photo_fenetres()
    if not maintenant or not inchange(dernier.get("apres"), maintenant, dernier.get("portee")):
        return 0
    d = lire_dispositions()
    for b, arbre in (dernier.get("arbres") or {}).items():
        if not zones_actives(b):
            continue
        classes = {a: (maintenant["fenetres"].get(a) or {}).get("classe", "") for a in feuilles(arbre)}
        if not all(classes.values()):
            continue

        def en_classes(n):
            return {"f": classes[n["f"]]} if "f" in n else dict(n, a=en_classes(n["a"]), b=en_classes(n["b"]))
        d[cle_disposition(classes.values())] = {"arbre": en_classes(arbre), "refus": 0, "date": int(time.time())}
    ecrire_dispositions(d)
    return 0


def feuilles(n):
    return [n["f"]] if "f" in n else feuilles(n["a"]) + feuilles(n["b"])


def disposition_proposer(bureau):
    """Appelé par nc/automatismes.lua quand des fenêtres s'ouvrent ou qu'on change de bureau : si les applis de ce bureau
    sont un ensemble mémorisé, l'île propose de reprendre sa disposition."""
    if reglage("DISPOSITIONS_PROPOSER", "oui") == "non":
        return 0
    d = lire_dispositions()
    try:
        c = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0
    ici = [x for x in c if x.get("mapped") and (x.get("workspace") or {}).get("id") == int(bureau) and not x.get("floating")]
    cle = cle_disposition(x.get("class", "") for x in ici)
    m = d.get(cle)
    if not m or m.get("refus", 0) >= 3 or len(ici) < 2 or zones_actives(bureau):
        return 0
    deja = CACHE / "disposition-proposee"
    if deja.exists() and deja.read_text() == f"{bureau}:{cle}" and time.time() - deja.stat().st_mtime < 600:
        return 0                                     # déjà proposée ici il y a moins de 10 min
    deja.parent.mkdir(parents=True, exist_ok=True)
    deja.write_text(f"{bureau}:{cle}")
    noms = ", ".join(sorted({x.get("class", "") for x in ici}))
    try:
        choix = subprocess.run(["notify-send", "-a", "IA", "-i", "view-grid", "-A", "oui=" + T("Oui", "Yes"), "-A", "non=" + T("Non", "No"),
                                "--", T("Reprendre ta disposition ?", "Restore your layout?"), corps_sur(noms)],
                               capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 0
    d = lire_dispositions()
    if cle not in d:
        return 0
    if choix != "oui":
        if choix == "non":
            d[cle]["refus"] = d[cle].get("refus", 0) + 1
            ecrire_dispositions(d)
        return 0
    # Chaque feuille prend la première fenêtre de sa classe (ordre de Hyprland), une seule fois
    libres = {}
    for x in ici:
        libres.setdefault((x.get("class") or "").lower(), []).append(x["address"])

    def en_adresses(n):
        if "f" in n:
            l = libres.get(n["f"].lower()) or []
            return {"f": l.pop(0)} if l else None
        a, b = en_adresses(n["a"]), en_adresses(n["b"])
        return dict(n, a=a, b=b) if a and b else (a or b)
    arbre = en_adresses(m["arbre"])
    if not arbre:
        return 0
    d[cle]["refus"] = 0
    ecrire_dispositions(d)
    ensemble([], [f"nc.zones_poser({int(bureau)}, {lua_arbre(arbre)})"])
    return 0


def inchange(apres, maintenant, bureau):
    """Vrai si les fenêtres sont restées comme le rangement les a laissées : mêmes fenêtres (sur ce bureau en mode
    « ce bureau »), même bureau, libres ou non, plein écran ou non, et même place à quelques points près."""
    if not apres or not maintenant:
        return False
    garde = lambda f: {a: x for a, x in f.get("fenetres", {}).items() if bureau is None or x.get("bureau") == bureau}
    a, m = garde(apres), garde(maintenant)
    if set(a) != set(m) or not a:
        return False
    for adr, x in a.items():
        y = m[adr]
        if (x["bureau"], x["libre"], bool(x["plein"])) != (y["bureau"], y["libre"], bool(y["plein"])):
            return False
        if any(abs(int(u) - int(w)) > 6 for u, w in zip((x.get("at") or []) + (x.get("taille") or []),
                                                        (y.get("at") or []) + (y.get("taille") or []))):
            return False                                 # déplacée ou redimensionnée depuis (en tuiles aussi)
    return True


def annuler_rangement():
    """Remet chaque fenêtre encore ouverte sur son bureau, libre ou rangée, en plein écran ou non, et les noms des bureaux."""
    try:
        avant = json.loads(ANNULER_RANGEMENT.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 1
    maintenant = photo_fenetres() or {"fenetres": {}, "bureaux": {}}
    lua = []
    for adr, a in avant.get("fenetres", {}).items():
        m = maintenant["fenetres"].get(adr)
        if not m or not re.fullmatch(r"0x[0-9a-f]+", adr):
            continue
        sel = f"address:{adr}"
        if m["bureau"] != a["bureau"] and isinstance(a["bureau"], int):
            lua.append(f"hl.dsp.window.move({{ workspace = {a['bureau']}, follow = false, window = '{sel}' }})")
        if m["libre"] != a["libre"]:
            lua.append(f"hl.dsp.window.float({{ action = '{'set' if a['libre'] else 'unset'}', window = '{sel}' }})")
        if bool(m["plein"]) != bool(a["plein"]):
            lua.append(f"hl.dsp.window.fullscreen({{ action = '{'set' if a['plein'] else 'unset'}', window = '{sel}' }})")
        if a["libre"] and isinstance(a.get("at"), list) and isinstance(a.get("taille"), list):
            lua.append(f"hl.dsp.window.resize({{ x = {int(a['taille'][0])}, y = {int(a['taille'][1])}, window = '{sel}' }})")
            lua.append(f"hl.dsp.window.move({{ x = {int(a['at'][0])}, y = {int(a['at'][1])}, window = '{sel}' }})")
    for n, nom_ in avant.get("bureaux", {}).items():
        if n.isdigit() and maintenant["bureaux"].get(n) not in (None, nom_) and isinstance(nom_, str) and "]]" not in nom_:
            lua.append(f"hl.dsp.workspace.rename({{ workspace = {int(n)}, name = [[{nom_}]] }})")
    # Les bureaux mis en zones reprennent leur disposition habituelle (et leur ancien arbre)
    zones = [f"nc.zones_retirer({int(b)})" for b in avant.get("zones", []) if str(b).lstrip("-").isdigit()]
    ensemble(lua, zones)                                 # d'un seul mouvement, comme le rangement
    ANNULER_RANGEMENT.unlink(missing_ok=True)
    return 0


def afficher_plan(plan):
    if plan["reponse"]:
        print(plan["reponse"])
    for a in plan["actions"]:
        etat = ("✓" if a["ok"] else "✗") if a["fait"] else ("⚠" if a["danger"] else "•")
        print(f"  {etat} {a['libelle']}" + (f" — {a['resultat'][:200]}" if a["fait"] and a["resultat"] and not a["ok"] else "")
              + (f" — {a['note']}" if a.get("note") else ""))
    for r in plan["refus"]:
        print("  ⨯ " + r)


# ── Rapports de mise à jour (config : nc-maj ; système : nc-paquets) ─────────────────────────────────────────────
# Après une mise à jour, l'IA (si elle est permise et joignable ; automatique, donc en pause en Économie sur batterie)
# écrit un résumé facile à comprendre ; il apparaît en tête de « Mises à jour » dans la fenêtre des réglages, avec le
# détail, et une notification y mène. Sans IA ni connexion : rien de plus que d'habitude.
RAPPORTS = CACHE / "rapports"
TITRES_RAPPORT = {"config": ("Ce qui a changé dans le bureau", "What changed in the desktop"),
                  "systeme": ("Ce qui a changé dans le système", "What changed in the system")}


def depot():
    """Le dépôt noctalia-config de ce PC (noté par nc-maj dans ~/.config/nc/depot), ou None."""
    try:
        d = Path((CONFIG / "nc/depot").read_text(encoding="utf-8").strip())
        return d if (d / ".git").exists() else None
    except OSError:
        return None


def details_config(avant, apres):
    d = depot()
    if not d or not re.fullmatch(r"[0-9a-f]{7,40}", avant or "") or not re.fullmatch(r"[0-9a-fA-F]{7,40}|HEAD", apres or ""):
        return []
    r = subprocess.run(["git", "-C", str(d), "log", "--format=%s", f"{avant}..{apres}"], capture_output=True, text=True, timeout=10)
    return [l.strip() for l in r.stdout.splitlines() if l.strip()][:60]


def lire_maj_systeme(fichier):
    """~/.cache/nc/paquets-maj.json de nc-paquets : ce que la mise à jour a vraiment changé (versions installées avant
    et après), et ce qui reste en attente d'après le recompte. {} s'il est illisible."""
    try:
        d = json.loads(Path(fichier).read_text())
    except (OSError, ValueError):
        return {}
    return d if isinstance(d, dict) else {}


MONTRES = 200          # paquets montrés dans le rapport et donnés à l'IA ; le nombre, lui, est toujours le vrai


def details_systeme(fichier):
    """Tous les paquets changés (aucune coupe ici : le nombre du rapport est le vrai, la coupe se fait à l'affichage)."""
    res = []
    for x in lire_maj_systeme(fichier).get("paquets", []):
        if not isinstance(x, dict):
            continue
        v = f"{x.get('avant', '')} → {x.get('apres', '')}".strip(" →")
        res.append(("★ " if x.get("important") else "") + f"{x.get('nom')} {v}".strip() + (f" ({x.get('source')})" if x.get("source") not in (None, "depot") else ""))
    return res


def faits_systeme(fichier):
    """Ce que nc-paquets a constaté en plus, dit tel quel dans le rapport (avec ou sans IA) : la mise à jour en échec
    (en partie : pacman fait, Flatpak en échec), les paquets restés en attente (retenus par apt, ignorés…)."""
    d, faits = lire_maj_systeme(fichier), []
    echec, attente = d.get("echec", 0), d.get("en_attente", 0)
    if isinstance(echec, int) and echec:
        faits.append(T(f"La mise à jour a échoué (code {echec}) : une partie seulement est installée.",
                       f"The update failed (code {echec}): only part of it is installed."))
    if isinstance(attente, int) and attente > 0:
        noms = [str(n) for n in d.get("en_attente_noms", []) if n][:5]
        faits.append(T(f"{attente} resté(s) en attente", f"{attente} still pending") + (" : " + ", ".join(noms) if noms else "")
                     + (T(" et d'autres", " and more") if attente > len(noms) and noms else "") + ".")
    return faits


NOYAU = re.compile(r"^(linux(-lts|-zen|-hardened|-cachyos)?|linux-image-.*|kernel(-core)?)$")    # comme nc-paquets


def noyau_mis_a_jour(details):
    """Un vrai noyau dans la liste (pas linux-firmware ni linux-api-headers : revue RPT-01)."""
    return any(NOYAU.match(d.removeprefix("★ ").split(" ", 1)[0]) for d in details)


def resume_sans_ia(genre, details, faits=()):
    """Le rapport sans IA (coupée, en pause, injoignable) : les faits seulement, en quelques lignes."""
    if genre == "config":
        idees = [re.split(r" : | ; ", d, 1)[0].strip()[:90] for d in details[:4]]
        reste = len(details) - len(idees)
        return "\n".join(f"- {x}" for x in idees) + (T(f"\n- et {reste} autre(s)", f"\n- and {reste} more") if reste > 0 else "")
    importants = [d[2:] for d in details if d.startswith("★ ")]
    l = [T(f"{len(details)} paquet(s) mis à jour.", f"{len(details)} package(s) updated.")]
    l += [f"- **{x}**" for x in importants[:5]]
    if noyau_mis_a_jour(details):
        l.append(T("Redémarre pour utiliser le nouveau noyau.", "Restart to use the new kernel."))
    l += list(faits)
    return "\n".join(l)


def ecrire_rapport(genre, details, resume, ia="", **plus):
    """nombre : tous les éléments ; details : les MONTRES premiers seulement (la fenêtre des réglages les affiche).
    plus (système) : en_attente, echec, de paquets-maj.json."""
    RAPPORTS.mkdir(parents=True, exist_ok=True)
    f = RAPPORTS / f"{genre}.json"
    tmp = f.with_suffix(".tmp")
    tmp.write_text(json.dumps(dict(genre=genre, date=int(time.time()), titre=T(*TITRES_RAPPORT[genre]), resume=resume, ia=ia,
                                   details=details[:MONTRES], nombre=len(details), **plus), ensure_ascii=False))
    tmp.replace(f)


def rapport_maj(genre, args):
    global FOND
    FOND = True                                   # automatique : en pause en Économie sur batterie
    details = details_config(*(args + ["", ""])[:2]) if genre == "config" else details_systeme(args[0] if args else "")
    if not details:
        return 0
    faits, plus = [], {}
    if genre != "config":
        faits = faits_systeme(args[0] if args else "")
        d = lire_maj_systeme(args[0] if args else "")
        plus = {k: d[k] for k in ("en_attente", "echec") if isinstance(d.get(k), int)}
    if coupee() or not candidats("texte"):
        # Sans IA (coupée, en pause, injoignable) : le rapport des faits, sans notification (rien de plus que d'habitude)
        ecrire_rapport(genre, details, resume_sans_ia(genre, details, faits), **plus)
        return 0
    if genre == "config":
        consigne_r = T("Voici les messages des mises à jour qui viennent d'être installées sur le bureau de l'utilisateur "
                       "(noctalia-config : Hyprland, île dynamique, réglages, IA…). Explique en 3 à 6 points très courts (une phrase "
                       "chacun, raccourci en gras au besoin), en tutoyant, en français simple et sans jargon, ce qui change "
                       "pour lui, ce qui se voit d'abord ; un point par nouveauté importante, les petites corrections "
                       "regroupées en un seul point. Pas d'introduction.",
                       "Here are the messages of the updates just installed on the user's desktop (noctalia-config: "
                       "Hyprland, dynamic island, settings, AI…). Explain in 3 to 6 very short points, in plain English "
                       "without jargon, what changes for them, what shows first; one point per important feature, small "
                       "fixes grouped into one point.")
    else:
        consigne_r = T("Voici les paquets du système qui viennent d'être mis à jour (★ : important). Explique en 3 à 6 "
                       "points très courts (une phrase chacun), en tutoyant, en français simple, sans introduction, ce qui compte : noyau, pilotes graphiques, Hyprland et le "
                       "bureau, navigateur, gros logiciels ; dis s'il faut redémarrer ; ignore les bibliothèques sans "
                       "intérêt pour l'utilisateur.",
                       "Here are the system packages just updated (★: important). Explain in 3 to 6 very short points, in "
                       "plain English, what matters: kernel, graphics drivers, Hyprland and the desktop, browser, big "
                       "apps; say whether a restart is needed; ignore libraries of no interest to the user.")
    try:
        texte = "\n".join(details[:MONTRES])
        if len(details) > MONTRES:
            texte += "\n" + T(f"… et {len(details) - MONTRES} autres ({len(details)} en tout).",
                              f"… and {len(details) - MONTRES} more ({len(details)} in all).")
        if genre != "config":             # le fait, plutôt que de laisser l'IA deviner d'après « linux-firmware »
            texte += "\n\n" + (T("Nouveau noyau : oui (redémarrer pour l'utiliser).", "New kernel: yes (restart to use it).")
                               if noyau_mis_a_jour(details) else T("Nouveau noyau : non.", "New kernel: no."))
            texte += "".join("\n" + f for f in faits)
        rep, ident = demander(texte, "texte", consigne_=consigne_r, sortie=lambda m: None)
    except ErreurIA:
        ecrire_rapport(genre, details, resume_sans_ia(genre, details, faits), **plus)
        return 0
    titre = T(*TITRES_RAPPORT[genre])
    # Les faits (échec, restés en attente) toujours dits, que l'IA en parle ou non
    ecrire_rapport(genre, details, rep.strip() + "".join("\n" + f for f in faits), nom(ident), **plus)
    premier = next((l.strip(" -•*") for l in rep.splitlines() if l.strip(" -•*")), "")
    notifier(titre, apercu(premier, 200), (T("Voir le rapport", "See the report"),
                                           ["qs", "-c", "nc-ile", "ipc", "call", "ile", "reglagesChercher", titre]))
    return 0


# ── Capture d'une zone ──────────────────────────────────────────────────────────────────────────────────────────
def capture(question=""):
    if not (shutil.which("grim") and shutil.which("slurp")):
        raise ErreurIA(T("grim et slurp sont nécessaires (capture d'une zone).", "grim and slurp are needed (area capture)."))
    zone = subprocess.run(["slurp"], capture_output=True, text=True)
    if zone.returncode != 0 or not zone.stdout.strip():
        return ""
    RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    img = RUN / "capture.png"
    subprocess.run(["grim", "-g", zone.stdout.strip(), str(img)], check=False)
    if not img.exists():
        raise ErreurIA(T("capture impossible", "capture failed"))
    notifier(T("L'IA regarde la capture…", "The AI is looking at the screenshot…"), "")
    try:
        rep, ident = demander(question or T("Que montre cette capture ?", "What does this screenshot show?"), "image",
                              image=str(img), sortie=lambda m: None)
    finally:
        img.unlink(missing_ok=True)
    livrer(T("Capture expliquée", "Screenshot explained"),
           "📷 " + T("Zone de l'écran : ", "Screen area: ") + (question or T("que montre-t-elle ?", "what does it show?")), rep, ident)
    return rep


# ── Configuration des clés, au clavier (masquées), avec un essai tout de suite ──────────────────────────────────
INSCRIPTION = {
    "anthropic": "https://console.anthropic.com/settings/keys", "openai": "https://platform.openai.com/api-keys",
    "google": "https://aistudio.google.com/apikey", "mistral": "https://console.mistral.ai/api-keys",
    "groq": "https://console.groq.com/keys", "deepseek": "https://platform.deepseek.com/api_keys",
    "openrouter": "https://openrouter.ai/keys",
}


def dans_terminal(args, titre, attendre=False):
    """Depuis la fenêtre des réglages ou un raccourci (pas de terminal) : la commande dans un terminal."""
    moi = str(Path(__file__).resolve())
    cmd = ["sh", "-c", '"$0" "$@"; printf "\\n%s" "$NC_FIN"; read -r _', moi] + args if attendre else [moi] + args
    env = dict(os.environ, NC_FIN=T("Entrée pour fermer", "Enter to close"))
    for t in ("kitty", "foot", "alacritty", "wezterm", "gnome-terminal", "konsole", "xterm"):
        if shutil.which(t):
            arg = {"gnome-terminal": ["--"], "wezterm": ["start", "--"]}.get(t, ["-e"])
            extra = ["--class", "nc-ia", "--title", titre] if t == "kitty" else []
            subprocess.Popen([t] + extra + arg + cmd, start_new_session=True, env=env)
            return 0
    raise ErreurIA(T("Aucun terminal trouvé : lance « nc-ia " + args[0] + " » dans un terminal.",
                     "No terminal found: run “nc-ai " + args[0] + "” in a terminal."))


def configurer():
    if not sys.stdin.isatty():
        # Session graphique avec l'île : la fenêtre « Clés des IA » ; sinon les questions dans un terminal
        if shutil.which("qs") and os.environ.get("WAYLAND_DISPLAY"):
            try:
                if subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "clesIA"], capture_output=True,
                                  timeout=5).returncode == 0:
                    return 0
            except (OSError, subprocess.TimeoutExpired):
                pass
        return dans_terminal(["configurer"], T("Clés des IA", "AI keys"))
    import getpass
    while True:
        print("\n" + T("Clés d'API des IA (Entrée seule : terminer)", "AI API keys (Enter alone: finish)"))
        for n, i in enumerate(APIS, 1):
            c, o = cle(i)
            print(f"  {n}. {nom(i):<26} {masquer(c) + ' (' + o + ')' if c else '—'}")
        print(f"  o. Ollama : {ollama_url()} " + (T("(répond)", "(responding)") if ollama_present() else T("(absent)", "(not found)")))
        r = input(T("Numéro : ", "Number: ")).strip().lower()
        if not r:
            return 0
        if r == "o":
            u = input(T("Adresse d'Ollama (Entrée : http://127.0.0.1:11434) : ", "Ollama address (Enter: http://127.0.0.1:11434): ")).strip()
            if u and not re.fullmatch(r"https?://[\w.\-\[\]:]+/?", u):
                print(T("Adresse invalide.", "Invalid address."))
                continue
            d = lire_cles(); d["OLLAMA_HOST"] = u; ecrire_cles(d)
            (RUN / "ollama.json").unlink(missing_ok=True)
            continue
        if not r.isdigit() or not 1 <= int(r) <= len(APIS):
            continue
        i = APIS[int(r) - 1]
        print(T(f"Clé {nom(i)} : à créer sur {INSCRIPTION[i]}", f"{nom(i)} key: create it at {INSCRIPTION[i]}"))
        v = getpass.getpass(T("Colle la clé (masquée ; vide : l'effacer) : ", "Paste the key (hidden; empty: remove it): ")).strip()
        if v and not re.fullmatch(r"[A-Za-z0-9_\-.:]{8,400}", v):
            print(T("Cette clé ne ressemble pas à une clé d'API.", "This doesn't look like an API key."))
            continue
        d = lire_cles(); d[FOURNISSEURS[i]["cle"]] = v; ecrire_cles(d)
        (CACHE / "ia-modeles.json").unlink(missing_ok=True)
        if not v:
            print(T("Clé effacée.", "Key removed."))
            continue
        print(T("Essai…", "Testing…"), end=" ", flush=True)
        try:
            t = "".join(appeler(i, T("Réponds en un seul mot.", "Answer with a single word."), "OK ?")).strip()
            print("✓ " + T("elle marche", "it works") + (f" ({modele(i)})" if modele(i) else ""))
            noter_echec(i, ok=True)
        except ErreurIA as e:
            print("✗ " + str(e))


# ── Menu des actions sur le texte (Super + I) ─────────────────────────────────────────────────────────────
def menu():
    """Le Spotlight de l'île sur « ! » ; sans l'île, un menu (fuzzel, wofi, rofi, bemenu) puis le résultat copié."""
    if coupee():
        raise ErreurIA(message_coupee())
    if reglage("IA_TEXTE", "oui") == "non":
        raise ErreurIA(T("L'IA sur le texte est désactivée (nc-reglages → Intelligence artificielle).",
                         "AI on text is turned off (nc-settings → Artificial intelligence)."))
    if shutil.which("qs"):
        try:
            if subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "rechercher", "! "], capture_output=True,
                              timeout=5).returncode == 0:
                return 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    noms = {T(*v[0]): k for k, v in ACTIONS.items()}
    for prog, args in (("fuzzel", ["--dmenu"]), ("wofi", ["--dmenu"]), ("rofi", ["-dmenu"]), ("bemenu", []),
                       ("tofi", [])):
        if shutil.which(prog):
            r = subprocess.run([prog] + args + (["-p", "IA "] if prog in ("fuzzel", "rofi", "bemenu") else []),
                               input="\n".join(noms), capture_output=True, text=True)
            choix = r.stdout.strip()
            if not choix:
                return 0
            texte_action(noms.get(choix, choix), copie=True)
            return 0
    texte_action("expliquer", copie=True)                       # aucun menu installé : l'action la plus utile
    return 0


# ── Raccourci décrit en mots (« + Ajouter » de la fiche Super + /) ──────────────────────────────────────────────
# L'IA propose seulement : sa réponse est vérifiée ici avec les règles de nc-raccourci (touches, appli installée,
# bureau 1 à 10, page de l'île), puis montrée dans la fiche, où rien n'est ajouté sans un clic sur « Ajouter »
TOUCHES_LISIBLES = {"Return": "Entrée", "space": "Espace", "Tab": "Tab", "Escape": "Échap", "Print": "Impr", "Delete": "Suppr",
                    "Home": "Début", "End": "Fin", "left": "gauche", "right": "droite", "up": "haut", "down": "bas"}


def module_raccourci():
    import importlib.machinery
    import importlib.util
    chemin = HOME / ".local/bin/nc-raccourci"
    if not chemin.exists():
        raise ErreurIA(T("nc-raccourci est introuvable (~/.local/bin).", "nc-raccourci was not found (~/.local/bin)."))
    chargeur = importlib.machinery.SourceFileLoader("ncraccourci", str(chemin))
    rc = importlib.util.module_from_spec(importlib.util.spec_from_loader("ncraccourci", chargeur))
    chargeur.exec_module(rc)
    # Vérifier sans rien demander à Hyprland : la position des lettres ne compte que pour l'ajout lui-même
    rc.letter_codes = lambda lettre: {rc.QWERTY.get(lettre)}
    return rc


def valider_raccourci(rep, rc, applis):
    """La réponse de l'IA -> {touches, cible, genre, nom, detail} ; ErreurIA si quoi que ce soit ne va pas."""
    t = re.sub(r"^```(?:json)?\s*|\s*```$", "", str(rep).strip())
    m = re.search(r"\{.*\}", t, re.S)
    try:
        d = json.loads(m.group(0)) if m else None
    except ValueError:
        d = None
    if not isinstance(d, dict):
        raise ErreurIA(T("L'IA n'a pas donné de raccourci lisible : reformule, ou crée-le à la main.",
                         "The AI did not give a readable shortcut: rephrase, or create it by hand."))
    if not d:
        raise ErreurIA(T("Ce n'est pas un raccourci que je sais créer : reformule (« Super + F ouvre Firefox »).",
                         "This is not a shortcut I can create: rephrase (“Super + F opens Firefox”)."))
    touches, cible, nom = d.get("touches"), d.get("cible"), d.get("nom", "")
    if not isinstance(touches, str) or not isinstance(cible, str) or not isinstance(nom, str) \
            or not cible.strip() or len(cible) > 300 or "\n" in cible or len(touches) > 60:
        raise ErreurIA(T("La proposition de l'IA est incomplète (touches ou cible).", "The AI's proposal is incomplete (keys or target)."))
    try:
        bind, _, cle_, _ = rc.parse_keys(touches)
    except rc.Refus as e:
        raise ErreurIA(T(f"Touches refusées : {e}", f"Keys refused: {e}")) from None
    # Les touches lisibles, comme les tape la capture (« Super+Maj+F ») : relues telles quelles par nc-reglages
    mods = {"SUPER": "Super", "CTRL": "Ctrl", "ALT": "Alt", "SHIFT": "Maj"}
    derniere = touches.replace(" ", "").split("+")[-1]
    if re.fullmatch(r"[A-Za-z]|[Ff]\d+", derniere):
        derniere = derniere.upper()
    elif derniere.lower() in rc.NAMES:
        derniere = TOUCHES_LISIBLES.get(rc.NAMES[derniere.lower()], derniere)
    touches = "+".join([mods[x] for x in bind.split(" + ")[:-1]] + [derniere])
    cible = cible.strip()
    nom = re.sub(r"[\t\r\n]+", " ", nom).strip()[:80]
    b = re.fullmatch(r"(?i)(?:bureau|desktop|workspace)\s+(\d+)", cible)
    if b and not 1 <= int(b.group(1)) <= 10:
        raise ErreurIA(T(f"Bureau inconnu : {b.group(1)} (de 1 à 10).", f"Unknown desktop: {b.group(1)} (1 to 10)."))
    rc.apps = lambda: applis                         # les applis déjà lues (nc-apps list), pas une seconde fois
    try:
        genre, valeur, nom = rc.target_of(cible, nom)
    except rc.Refus as e:
        raise ErreurIA(str(e)[:1].upper() + str(e)[1:] + ".") from None
    if genre == "commande":
        # Une commande seulement si son programme existe : sinon c'est une appli inventée par l'IA
        try:
            prog = shlex.split(valeur)[0]
        except (ValueError, IndexError):
            prog = ""
        if not prog or not shutil.which(prog, path=os.environ.get("PATH", "") + os.pathsep + str(HOME / ".local/bin")):
            raise ErreurIA(T(f"Cible inconnue : « {cible} » n'est ni une appli installée, ni un bureau, ni une page de l'île.",
                             f"Unknown target: “{cible}” is neither an installed app, a desktop nor an island page."))
    cible = {"bureau": f"bureau {valeur}", "ile": f"ile {valeur}"}.get(genre, valeur)
    quoi = {"appli": T("appli", "app"), "bureau": T("bureau", "desktop"), "ile": T("île", "island"),
            "commande": T("commande", "command")}[genre]
    return {"touches": touches, "cible": cible, "genre": genre, "nom": nom, "detail": f"{valeur} ({quoi})"}


def raccourci_ia(description):
    if coupee():
        raise ErreurIA(message_coupee())
    rc = module_raccourci()
    applis = rc.apps()
    liste = "\n".join(f"{a.get('id', '')} : {a.get('name', '')}" for a in applis[:400] if isinstance(a, dict))
    texte = description.strip()[:500] + "\n\n" + T("Applis installées (identifiant : nom) :", "Installed apps (id: name):") + "\n" + liste
    rep, _ = demander(texte, "raccourci", sortie=lambda m: None)
    return valider_raccourci(rep, rc, applis)


# ── Commandes ───────────────────────────────────────────────────────────────────────────────────────────────────
# Le programme agentique (qui sait lire et modifier un projet) de chaque IA, pour Neovim (Espace i a) : le sien pour
# un programme installé, celui du même éditeur pour une API ; aucun pour les autres (JARVIS, Mistral, Ollama…)
CLI_AGENT = {"anthropic": "claude", "openai": "codex", "google": "gemini", "claude": "claude", "codex": "codex",
             "gemini-cli": "gemini", "opencode": "opencode", "qwen": "qwen"}


def cli_agent(ident):
    """(programme, prêt) : prêt s'il est installé et que la connexion est là (la connexion à son compte n'est pas
    vérifiée ici : ce serait un appel réseau)."""
    p = CLI_AGENT.get(ident, "")
    return p, bool(p and shutil.which(p) and en_ligne())


def etat():
    usages = ("question", "texte", "commande", "image")
    choix = {u: (candidats(u) or [""])[0] for u in usages}
    c = ANCIENS.get(reglage("IA_CHOIX", "claude"), reglage("IA_CHOIX", "claude"))
    return {
        "mode": mode(), "bac": bac_disponible(), "repli": bac_repli_permis(), "coupee": coupee(), "en_ligne": en_ligne(), "choix": reglage("IA_CHOIX", "claude"), "preference": reglage("IA_PREFERENCE", "rapide"),
        # l'IA choisie (IA_CHOIX) et son programme agentique
        "choisie": dict(id=c, nom=nom(c), disponible=disponible(c), cli=cli_agent(c)[0], cli_disponible=cli_agent(c)[1])
                   if c in FOURNISSEURS else {},
        "usages": {u: {"id": i, "nom": nom(i) if i else "", "cli": cli_agent(i)[0] if i else "",
                       "cli_disponible": cli_agent(i)[1] if i else False} for u, i in choix.items()},
        "ias": [dict(id=i, nom=nom(i), genre=f["genre"], disponible=disponible(i), vision=f["vision"], agent=f["agent"],
                     cle=cle(i)[1] if f["genre"] == "api" else "", modele=modele_choisi(i), inscription=INSCRIPTION.get(i, ""),
                     cli=cli_agent(i)[0], cli_disponible=cli_agent(i)[1])
                for i, f in FOURNISSEURS.items()],
    }


def afficher_etat(e):
    m = {"auto": T("automatique", "automatic"), "manuel": T("manuel", "manual"), "non": T("coupée partout", "off everywhere")}[e["mode"]]
    print(T("Mode : ", "Mode: ") + m + (f" ({nom(e['choix'])})" if e["mode"] == "manuel" and e["choix"] else ""))
    if not e["coupee"]:
        for u, x in e["usages"].items():
            print(f"  {u:<9} → {x['nom'] or T('aucune', 'none')}")
    print(T("bac des IA : actif (mêmes droits pour Claude Code, Codex, OpenCode, Gemini CLI et Qwen Code : ~ en lecture seule, un faux dossier personnel jeté après la demande, rien de secret lisible ; réseau ouvert, 127.0.0.1 joignable, /dev/shm partagé)",
            "AI sandbox: active (same rights for Claude Code, Codex, OpenCode, Gemini CLI and Qwen Code: ~ read-only, a throwaway fake home folder, no secret readable; network open, 127.0.0.1 reachable, /dev/shm shared)")
          if e.get("bac") else
          T("bac des IA : indisponible ici : Claude Code, Codex, OpenCode, Gemini CLI et Qwen Code sont refusés"
            + (" (repli autorisé par IA_BAC_REPLI : sans bac, Codex peut lire tes fichiers)" if e.get("repli") else ""),
            "AI sandbox: unavailable here: Claude Code, Codex, OpenCode, Gemini CLI and Qwen Code are refused"
            + (" (fallback allowed by IA_BAC_REPLI: without a sandbox, Codex can read your files)" if e.get("repli") else "")))
    print(T("IA :", "AIs:"))
    for i in e["ias"]:
        etiquette = T("disponible", "available") if i["disponible"] else "—"
        extra = (f" · {T('clé', 'key')} ({i['cle']})" if i["cle"] else "") + (f" · {i['modele']}" if i["modele"] else "")
        print(f"  {'●' if i['disponible'] else '○'} {i['id']:<11} {i['nom']:<26} {etiquette}{extra}")


def main(a):
    if not a or a[0] in ("-h", "--help", "aide", "help"):
        print(T(__doc__, DOC_EN).strip())
        return 0 if a else 2
    global FOND
    c, a = a[0], a[1:]
    if "--fond" in a:                          # lancé par un automatisme, pas par toi
        FOND = True
        a = [x for x in a if x != "--fond"]
    c = {"status": "etat", "ask": "demander", "text": "texte", "command": "commande", "screenshot": "capture",
         "key": "cle", "keys": "cles", "model": "modele", "test": "tester", "which": "quelle", "enabled": "actif",
         "last": "derniere", "shortcut": "raccourci"}.get(c, c)
    json_out = "--json" in a
    a = [x for x in a if x != "--json"]
    try:
        if c == "actif":
            return 1 if coupee() else 0
        if c in ("disponible", "available"):        # permise et une IA joignable maintenant (connexion comprise)
            return 0 if not coupee() and candidats("question") else 1
        if c == "etat":
            e = etat()
            print(json.dumps(e, ensure_ascii=False)) if json_out else afficher_etat(e)
            return 0
        if c == "quelle":
            usage = a[a.index("--usage") + 1] if "--usage" in a and a.index("--usage") + 1 < len(a) else "question"
            i = qui_chat() if "--chat" in a else (candidats(usage) or [""])[0]
            if json_out:
                print(json.dumps({"id": i, "nom": nom(i) if i else "", "agent": FOURNISSEURS[i]["agent"] if i else "",
                              "coupee": coupee(), "en_ligne": en_ligne(), "agir": actions_mode() == "confirmer"}, ensure_ascii=False))
            else:
                print(nom(i) if i else "")
            return 0
        if c == "derniere":
            try:
                print(DERNIERE.read_text(encoding="utf-8"))
            except OSError:
                print(T("Aucune réponse pour l'instant.", "No answer yet."))
            return 0
        if c in ("demander", "commande"):
            flux = "--flux" in a
            usage, force, image, reste = ("commande" if c == "commande" else "question"), "", None, []
            i = 0
            while i < len(a):
                if a[i] == "--flux":
                    pass
                elif a[i] in ("--usage", "--ia", "--image") and i + 1 < len(a):
                    usage, force, image = (a[i + 1], force, image) if a[i] == "--usage" else \
                                          (usage, a[i + 1], image) if a[i] == "--ia" else (usage, force, a[i + 1])
                    i += 1
                elif a[i] == "--":
                    reste += a[i + 1:]
                    break
                else:
                    reste.append(a[i])
                i += 1
            q = " ".join(reste).strip()
            if q == "-":
                q = sys.stdin.read(200000).strip()
            if not q:
                print(T(__doc__, DOC_EN).strip(), file=sys.stderr)
                return 2
            if image:
                usage = "image"
            if c == "commande" and not flux:
                tampon = []
                rep, _ = demander(q, usage, force, image, sortie=tampon.append)
                rep = rep.strip().strip("`").strip()
                rep = re.sub(r"^(bash|zsh|sh|shell)\n", "", rep).strip()
                l = [x for x in rep.splitlines() if x.strip()]
                print(re.sub(r"^\$\s*", "", l[0]) if l else "")
                return 0
            demander(q, usage, force, image, flux=flux)
            return 0
        if c == "raccourci":
            q = " ".join(x for x in a if not x.startswith("--")).strip()
            if not q:
                raise ErreurIA("nc-ia raccourci \"Super + F ouvre Firefox\" [--json]")
            r = raccourci_ia(q)
            if json_out:
                print(json.dumps(dict(r, ok=True), ensure_ascii=False))
            else:
                print(f"{r['touches']} → {r['nom']}  ({r['detail']})")
                print(T(f"Pour l'ajouter : nc-raccourci ajoute \"{r['touches']}\" \"{r['cible']}\"",
                        f"To add it: nc-shortcut add \"{r['touches']}\" \"{r['cible']}\""))
            return 0
        if c == "texte":
            if not a:
                print(T(__doc__, DOC_EN).strip(), file=sys.stderr)
                return 2
            source = "presse" if "--presse" in a else "selection" if "--selection" in a else ""
            mots = [x for x in a if not x.startswith("--")]
            entree = sys.stdin.read(200000) if "--stdin" in a else None      # l'île, Neovim : le texte sans passer par le presse-papiers
            texte_action(" ".join(mots), source, copie="--copier" in a, flux="--flux" in a, texte=entree)
            return 0
        if c in ("fichier", "file"):
            if not a:
                raise ErreurIA("nc-ia fichier CHEMIN [ACTION|consigne] [--notifier]")
            chemins = [x for x in a if not x.startswith("--") and os.path.exists(x)]
            consigne_f = " ".join(x for x in a if not x.startswith("--") and x not in chemins)
            fichier_ia(chemins, consigne_f, notif="--notifier" in a, flux="--flux" in a)
            return 0
        if c in ("agir", "act"):
            q = " ".join(x for x in a if not x.startswith("--")).strip()
            if not q:
                raise ErreurIA("nc-ia agir \"coupe le Bluetooth et passe en économie\"")
            bureau = None
            if "--bureau" in a:                  # « Organiser ce bureau » : nc-ia agir --bureau N "…"
                i = a.index("--bureau")
                try:
                    bureau = int(a[i + 1])
                except (IndexError, ValueError):
                    raise ErreurIA("nc-ia agir --bureau N \"…\"") from None
                a = a[:i] + a[i + 2:]
                q = " ".join(x for x in a if not x.startswith("--")).strip()
            plan = agir(q, bureau)
            if json_out:
                print(json.dumps(plan, ensure_ascii=False))
                return 0
            afficher_plan(plan)
            reste = [x for x in plan["actions"] if not x["fait"]]
            if reste and sys.stdin.isatty():
                if input(T("Faire ces actions ? [o/N] ", "Do these actions? [y/N] ")).strip().lower() in ("o", "oui", "y", "yes"):
                    afficher_plan(dict(executer_plan(plan["id"]), reponse=""))
            elif reste:
                print(T(f"À confirmer : nc-ia executer {plan['id']}", f"To confirm: nc-ai execute {plan['id']}"))
            return 0
        if c in ("executer", "execute"):
            if not a:
                raise ErreurIA("nc-ia executer PLAN [N…]")
            nums = [int(x) for x in a[1:] if x.isdigit()] or None
            try:
                plan = executer_plan(a[0], nums)
            except ErreurIA as e:                # coupé en route : ce qui est fait est dit, puis l'erreur
                if getattr(e, "plan", None):
                    print(json.dumps(e.plan, ensure_ascii=False)) if json_out else afficher_plan(dict(e.plan, reponse=""))
                raise
            print(json.dumps(plan, ensure_ascii=False)) if json_out else afficher_plan(dict(plan, reponse=""))
            return 0 if all(x["ok"] for x in plan["actions"] if x["fait"]) else 1
        if c in ("diagnostic", "diag") and json_out:
            # Toujours un JSON et le code 0 (l'île le lit) ; « - » : le bilan de nc-diag --json sur l'entrée standard
            delai = DIAG_DELAI
            if "--delai" in a:
                try:
                    delai = min(600.0, max(1.0, float(a[a.index("--delai") + 1])))
                except (IndexError, ValueError):
                    pass
            entree = sys.stdin.read(DIAG_MAX_ENTREE + 1) if "-" in a else None
            try:
                r = diagnostic_json(entree, delai)
            except Exception:                    # jamais sans réponse : le repli le plus simple
                r = {"source": "sans_ia", "raison": "erreur", "ia": "", "agent": "", "reparations": [], "conseil": "",
                     "refus": [], "resume": T("La vérification du bureau n'a pas pu se faire.",
                                              "The desktop check could not run.")}
            print(json.dumps(r, ensure_ascii=False), flush=True)
            return 0
        if c in ("diagnostic", "diag"):
            diagnostic(flux="--flux" in a)
            return 0
        if c == "capture":
            if coupee():
                raise ErreurIA(message_coupee())
            if reglage("IA_CAPTURE", "oui") == "non":
                raise ErreurIA(T("L'explication des captures est désactivée (nc-reglages → Intelligence artificielle).",
                                 "Screenshot explanation is turned off (nc-settings → Artificial intelligence)."))
            capture(" ".join(a))
            return 0
        if c == "menu":
            return menu()
        if c in ("panne", "failure"):
            if not a:
                raise ErreurIA("nc-ia panne SERVICE.service… [--livrer]")
            panne([x for x in a if not x.startswith("--")], flux="--flux" in a, livraison="--livrer" in a)
            return 0
        if c in ("rapport-maj", "update-report"):
            if not a or a[0] not in TITRES_RAPPORT:
                raise ErreurIA("nc-ia rapport-maj config AVANT APRES | systeme FICHIER.json")
            return rapport_maj(a[0], a[1:])
        if c in ("organiser", "organize") and reglage("IA_ORGANISER", "auto") == "non":
            raise ErreurIA(T("Le rangement par l'IA est coupé (nc-reglages → Intelligence artificielle).",
                             "AI tidying is turned off (nc-settings → Artificial intelligence)."))
        if c in ("organiser", "organize") and reglage("IA_ORGANISER", "auto") != "confirmer":
            return ranger("--bureau" in a)
        if c in ("annuler-rangement", "undo-tidy"):
            return annuler_rangement()
        if c == "disposition-garder":
            return disposition_garder()
        if c == "disposition-proposer" and a and a[0].lstrip("-").isdigit():
            return disposition_proposer(int(a[0]))
        if c in ("organiser", "organize"):
            # Mode « confirmer » : le plan dans le Spotlight. Super + Maj + O : tous les bureaux ; Super + Ctrl + O (--bureau) : celui qui est affiché
            demande = T("Organise les fenêtres du bureau affiché : une meilleure disposition, sans les changer de bureau.",
                        "Organize the windows of the shown desktop: a better layout, without changing their desktop.") \
                if "--bureau" in a else \
                T("Organise toutes mes fenêtres : regroupe-les par activité sur des bureaux, nomme les bureaux, puis "
                  "dispose-les bien sur chacun.", "Organize all my windows: group them by activity on desktops, name the "
                  "desktops, then lay them out well on each one.")
            portee = ""
            if "--bureau" in a:
                b = bureau_affiche()
                if b is None:                    # inconnu : le plan toucherait tous les bureaux (revue B2-12)
                    raise ErreurIA(message_bureau_inconnu())
                portee = str(b)
            if shutil.which("qs") and subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "agirIA", demande, portee],
                                                     capture_output=True, timeout=5).returncode == 0:
                return 0
            raise ErreurIA(T("Organiser les fenêtres demande l'île (Quickshell) : nc-ia agir \"…\" dans un terminal sinon.",
                             "Organizing windows needs the island (Quickshell): otherwise nc-ai act \"…\" in a terminal."))
        if c in ("transcrire", "transcribe"):
            if not a:
                raise ErreurIA("nc-ia transcrire FICHIER.wav")
            texte, ident = transcrire(a[0])
            print(json.dumps({"ok": True, "text": texte, "engine": nom(ident)}, ensure_ascii=False) if json_out else texte)
            return 0
        if c in ("configurer", "configure", "setup"):
            if "--terminal" in a and not sys.stdin.isatty():
                return dans_terminal(["configurer"], T("Clés des IA", "AI keys"))
            return configurer()
        if c == "terminal":                     # une question, la réponse dans un terminal (lanceur sans l'île)
            q = " ".join(x for x in a if x != "--").strip()
            if not q:
                return 2
            if sys.stdout.isatty():
                demander(q)
                return 0
            return dans_terminal(["demander", "--", q], "IA", attendre=True)
        if c == "fenetre-test":
            return dans_terminal(["tester"], T("Essai des IA", "AI test"), attendre=True)
        if c in ("cle", "modele") and a:
            a[0] = ALIAS_API.get(a[0], a[0]) if c == "cle" or a[0] not in FOURNISSEURS else a[0]
        if c == "cle":
            if not a or a[0] not in APIS:
                raise ErreurIA(T("Fournisseur : ", "Provider: ") + ", ".join(APIS))
            v = sys.stdin.readline().strip()
            if v and not re.fullmatch(r"[A-Za-z0-9_\-.:]{8,400}", v):
                raise ErreurIA(T("Cette clé ne ressemble pas à une clé d'API.", "This doesn't look like an API key."))
            d = lire_cles()
            d[FOURNISSEURS[a[0]]["cle"]] = v
            ecrire_cles(d)
            (CACHE / "ia-modeles.json").unlink(missing_ok=True)
            print(T("Clé enregistrée.", "Key saved.") if v else T("Clé effacée.", "Key removed."))
            return 0
        if c == "cles":
            res = {i: {"origine": cle(i)[1], "fin": masquer(cle(i)[0]) if cle(i)[0] else ""} for i in APIS}
            if json_out:
                print(json.dumps(res, ensure_ascii=False))
            else:
                for i, x in res.items():
                    print(f"  {i:<11} {x['fin'] + ' (' + x['origine'] + ')' if x['origine'] else '—'}")
            return 0
        if c == "modele":
            if not a or a[0] not in FOURNISSEURS:
                raise ErreurIA(T("Fournisseur : ", "Provider: ") + ", ".join(FOURNISSEURS))
            if len(a) > 1 and not re.fullmatch(r"[\w.:/@+\-]{1,120}", a[1]):
                raise ErreurIA(T("Nom de modèle invalide.", "Invalid model name."))
            d = lire_cles()
            d["MODELE_" + a[0].upper().replace("-", "_")] = a[1] if len(a) > 1 else ""
            ecrire_cles(d)
            print(a[1] if len(a) > 1 else T("Modèle automatique.", "Automatic model."))
            return 0
        if c == "tester":
            if coupee():
                raise ErreurIA(message_coupee())
            ids = [a[0]] if a else [i for i in FOURNISSEURS if disponible(i)]
            res = []
            for i in ids:
                debut = time.time()
                try:
                    t = "".join(appeler(i, T("Réponds en un seul mot.", "Answer with a single word."), "OK ?"))
                    res.append({"id": i, "nom": nom(i), "ok": bool(t.strip()), "ms": int((time.time() - debut) * 1000)})
                except Exception as e:
                    res.append({"id": i, "nom": nom(i), "ok": False, "erreur": str(e)[:200]})
            if json_out:
                print(json.dumps(res, ensure_ascii=False))
            else:
                for x in res:
                    print(f"  {'✓' if x['ok'] else '✗'} {x['nom']:<26} " + (f"{x['ms']} ms" if x["ok"] else x.get("erreur", "")))
            return 0 if res and all(x["ok"] for x in res) else 1
    except ErreurIA as e:
        if c in ("capture", "menu", "organiser", "organize") or (c == "texte" and "--copier" in a) or "--notifier" in a:   # raccourci, menu : pas de terminal
            notifier("IA", str(e))
        if c == "raccourci" and json_out:          # la fiche Super + / lit toujours un JSON
            print(json.dumps({"ok": False, "erreur": str(e)}, ensure_ascii=False), flush=True)
        elif "--flux" in a:
            print(json.dumps({"t": str(e), "erreur": True}, ensure_ascii=False), flush=True)
        else:
            print(str(e), file=sys.stderr)
        return 3 if coupee() else 1
    except BrokenPipeError:                      # le Spotlight a été fermé pendant la réponse (ou « | head »)
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())   # pas d'erreur à la sortie de Python
        except OSError:
            pass
        return 1
    except KeyboardInterrupt:
        return 130
    print(T(__doc__, DOC_EN).strip(), file=sys.stderr)
    return 2


def installer_signaux():
    """Échap dans le Spotlight, île fermée : arrêté par SIGTERM ; sortir proprement pour que le programme d'IA lancé
    s'arrête avec (les finally), au lieu d'aller au bout sans personne pour lire (revue IA-07). Appelé aussi par
    nc-demander, qui charge nc-ia comme un module (revue B2-04)."""
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: sys.exit(128 + s))


if __name__ == "__main__":
    installer_signaux()
    sys.exit(main(sys.argv[1:]))
