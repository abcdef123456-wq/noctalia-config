#!/usr/bin/env python3
"""legion-keys : tes raccourcis Hyprland, lus en direct (hyprctl binds) et expliqués en français.

  legion-keys          liste lisible dans le terminal
  legion-keys json     JSON pour la fiche Super + / (plugin Noctalia v5 legion/keys)
Les touches sont nommées comme sur la disposition US (Super + Espace bascule US / FR).
"""
import json
import subprocess
import sys

KEYCODES = {
    9: "Échap", 22: "Retour arrière", 23: "Tab", 36: "Entrée", 49: "`", 65: "Espace", 61: "/",
    59: ",", 60: ".", 20: "-", 21: "=", 34: "[", 35: "]", 47: ";", 48: "'", 51: "\\",
    111: "↑", 113: "←", 114: "→", 116: "↓",
}
for i, k in enumerate("1234567890"):
    KEYCODES[10 + i] = k
for row, start in (("QWERTYUIOP", 24), ("ASDFGHJKL", 38), ("ZXCVBNM", 52)):
    for i, k in enumerate(row):
        KEYCODES[start + i] = k
for i in range(10):
    KEYCODES[67 + i] = f"F{i + 1}"
KEYCODES[95], KEYCODES[96] = "F11", "F12"

MODS = ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Maj"))
MOUSE = {"mouse:272": "glisser", "mouse:273": "clic droit", "mouse_down": "molette", "mouse_up": "molette"}

SHELL = {
    "menu": ("Rechercher (applis, fichiers, calculs)", 0),
    "wallpapers": ("Choisir le fond d'écran", 0),
    "control-center": ("Centre de contrôle", 0),
    "settings": ("Réglages de la barre", 0),
    "power-cycle": ("Changer de profil d'énergie", 4),
    "window-switcher": ("Passer d'une fenêtre à l'autre", 1),
    "lock": ("Verrouiller l'écran", 4),
    "session": ("Verrouiller et mettre en veille", 4),
    "keys": ("Afficher cette fiche", 0),
}
SECTIONS = ["Applis et barre", "Fenêtres", "Bureaux", "Souris", "Système"]


def describe(d, arg, mouse, mods=()):
    """(texte, section) ou None pour ignorer."""
    a = arg.strip()
    if d == "mouse":
        free = "Alt" in mods or "Maj" in mods
        if a == "movewindow":
            return ("Détacher et placer librement" if free else "Déplacer la fenêtre", 3)
        if a == "resizewindow":
            if "Maj" in mods:
                return ("Redimensionner (pavé tactile)", 3)
            return ("Détacher et redimensionner librement" if free else "Redimensionner la fenêtre", 3)
    if d == "exec":
        if "legion-shell-msg" in a:
            act = a.split("legion-shell-msg", 1)[1].split()[0] if a.split("legion-shell-msg", 1)[1].split() else ""
            return SHELL.get(act, (f"Barre : {act}", 0))
        if a.startswith("kitty"):
            return ("Terminal", 0)
        if a.startswith("dolphin"):
            return ("Fichiers (Dolphin)", 0)
        if "hyprshutdown" in a or "dispatch exit" in a:
            return ("Quitter la session", 4)
        if "poweroff" in a:
            return ("Éteindre", 4)
        if "reboot" in a:
            return ("Redémarrer", 4)
        if "slurp" in a:
            return ("Capture d'une zone de l'écran", 0)
        if any(x in a for x in ("wpctl", "brightnessctl", "playerctl")):
            return None   # touches multimédia, résumées à part
        return (a, 4)
    table = {
        "killactive": ("Fermer la fenêtre", 1),
        "togglefloating": ("Fenêtre libre ↔ rangée", 1),
        "pseudo": ("Garder sa taille (pseudo)", 1),
        "fullscreenstate": ("Plein écran", 1),
        "togglegroup": ("Grouper les fenêtres en onglets", 1),
        "moveoutofgroup": ("Sortir la fenêtre du groupe", 1),
        "setfloating": None,
    }
    if d in table:
        return table[d]
    if d == "layoutmsg" and "togglesplit" in a:
        return ("Changer le sens de la division", 1)
    if d == "movefocus":
        return ("Aller à la fenêtre voisine", 1)
    if d == "movewindow":
        return ("Déplacer la fenêtre", 3) if mouse else ("Déplacer la fenêtre", 1)
    if d == "resizewindow":
        return ("Redimensionner la fenêtre", 3)
    if d == "resizeactive":
        return ("Agrandir / rétrécir la fenêtre", 1)
    if d == "changegroupactive":
        return ("Onglet suivant" if a.startswith("f") else "Onglet précédent", 1)
    if d == "workspace":
        if a.startswith("e"):
            return ("Bureau suivant / précédent", 2)
        return ("Aller au bureau 1 à 10", 2) if a.isdigit() else (f"Aller au bureau {a}", 2)
    if d == "movetoworkspace":
        return ("Envoyer la fenêtre au bureau 1 à 10", 2)
    if d == "togglespecialworkspace":
        return ("Terminal déroulant (sous Échap)", 0) if a == "term" else ("Bureau caché (bloc-notes)", 2)
    return (f"{d} {a}".strip(), 4)


def key_label(b):
    if b.get("keycode"):
        return KEYCODES.get(b["keycode"], f"touche {b['keycode']}")
    return MOUSE.get(b.get("key", ""), b.get("key", ""))


def collect():
    binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, check=True).stdout)
    rows = {}   # (section, texte, mods) -> {keys:set, order}
    for n, b in enumerate(binds):
        if b.get("submap"):
            continue
        mods = [name for bit, name in MODS if b.get("modmask", 0) & bit]
        if not mods:
            continue   # touches multimédia et autres touches seules
        res = describe(b.get("dispatcher", ""), b.get("arg", ""), b.get("mouse", False), mods)
        if not res:
            continue
        text, sec = res
        k = (sec, text, tuple(mods))
        rows.setdefault(k, {"keys": [], "order": n})
        lab = key_label(b)
        if lab not in rows[k]["keys"]:
            rows[k]["keys"].append(lab)
    out = {s: [] for s in range(len(SECTIONS))}
    for (sec, text, mods), v in sorted(rows.items(), key=lambda kv: kv[1]["order"]):
        keys = v["keys"]
        if set(keys) >= {"←", "→", "↑", "↓"}:
            key = "flèches"
        elif len(keys) >= 9 and all(x.isdigit() for x in keys):
            key = "1…0"
        else:
            key = " / ".join(keys)
        out[sec].append({"keys": list(mods) + [key], "text": text})
    # Ajouts qui ne sont pas des raccourcis « bind » de Hyprland
    out[4].append({"keys": ["Super", "Espace"], "text": "Clavier US ↔ FR"})
    out[4].append({"keys": ["Touches média"], "text": "Son, luminosité, musique"})
    return [{"title": SECTIONS[s], "rows": out[s]} for s in range(len(SECTIONS)) if out[s]]


if __name__ == "__main__":
    data = collect()
    if len(sys.argv) > 1 and sys.argv[1] == "json":
        json.dump(data, sys.stdout, ensure_ascii=False)
    else:
        for sec in data:
            print(f"\n{sec['title']}")
            for r in sec["rows"]:
                print(f"  {' + '.join(r['keys']):<28} {r['text']}")
