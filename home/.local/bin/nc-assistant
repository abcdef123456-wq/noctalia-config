#!/usr/bin/env python3
"""Client de l'assistant distant, sans dépendance Python externe.

  nc-assistant configurer          URL et clé secrète : la fenêtre « Connexion JARVIS » de l'île (session
                                   graphique), sinon les questions dans le terminal (--terminal pour les forcer)
  nc-assistant ouvrir [question]    ouvre le chat dans kitty
  nc-assistant chat [question]      chat dans le terminal courant
  nc-assistant demander "question"  une réponse ; --flux : lignes JSON pour Spotlight
  nc-assistant briefing            briefing et notification
  nc-assistant verifier            test réseau + diagnostic ; --json
  nc-assistant etat                état JSON ; --local : configuration seule, sans réseau

Configuration personnelle : ~/.config/nc/assistant.conf (0600), jamais exportée.
Le serveur est installé séparément. Aucune connexion ni scrutation en arrière-plan.
Une URL 192.168.x.x / 10.x / *.local ne fonctionne que sur le réseau local ;
pour un autre réseau, configure l'URL HTTPS d'un tunnel côté serveur.
"""
import argparse
import contextlib
from datetime import datetime, timedelta, timezone
import fcntl
import getpass
import hashlib
import html
import http.client
import ipaddress
import json
import math
import os
from pathlib import Path
import re
import signal
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

CONF = Path.home() / ".config/nc/assistant.conf"
MAX_RESPONSE = 2 * 1024 * 1024
DOC_EN = """Remote assistant client (Python standard library only).
  nc-assistant configurer          server URL and secret key (hidden input)
  nc-assistant ouvrir [question]    open a kitty chat window
  nc-assistant chat [question]      chat in the current terminal
  nc-assistant demander "question"  print an answer; --flux: JSON lines for Spotlight
  nc-assistant briefing            daily briefing and notification
  nc-assistant verifier            network test + diagnostic; --json
  nc-assistant etat                JSON status; --local: configuration only, no network
Personal configuration: ~/.config/nc/assistant.conf (0600), never exported.
The server is installed separately. No background polling or local model.
A 192.168.x.x / 10.x / *.local URL only works on the server's local network;
for any other network, configure the HTTPS URL of a tunnel on the server side.
"""


def langue():
    choix = os.environ.get("NC_LANGUE", "")
    if choix not in ("fr", "en"):
        try:
            for ligne in (CONF.parent / "reglages.conf").read_text().splitlines():
                if ligne.startswith("LANGUE="):
                    choix = ligne.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if choix in ("fr", "en"):
        return choix
    loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG", "")
    return "fr" if loc.startswith("fr") else "en"


def T(fr, en):
    return en if langue() == "en" else fr


class Erreur(Exception):
    pass


def ia_coupee():
    """IA du bureau coupée (nc-reglages → Intelligence artificielle → Aucune), ou en pause (Économie sur batterie, vu
    par nc-ia) : JARVIS ne répond plus nulle part."""
    ia = ia_du_bureau()
    if ia:
        try:
            return ia.coupee()
        except Exception:
            pass
    try:
        for l in (Path.home() / ".config/nc/reglages.conf").read_text(encoding="utf-8").splitlines():
            if l.startswith("IA_MODE="):
                return l.split("=", 1)[1].strip().strip('"') == "non"
    except OSError:
        pass
    return False


def message_ia_coupee():
    """Pourquoi l'IA ne répond pas : coupée, ou en pause en Économie sur batterie (le message de nc-ia)."""
    ia = ia_du_bureau()
    try:
        if ia and ia.coupee():
            return ia.message_coupee()
    except Exception:
        pass
    return T(*MESSAGE_COUPEE)


MESSAGE_COUPEE = ("L'IA est désactivée (nc-reglages → Intelligence artificielle → IA du bureau).",
                  "AI is turned off (nc-settings → Artificial intelligence → Desktop AI).")


def valider(c):
    url = c.get("URL", "").strip().rstrip("/")
    try:
        u = urllib.parse.urlsplit(url)
        port = u.port
        valide = (u.scheme in ("http", "https") and u.hostname and not u.username and not u.password
                  and not u.query and not u.fragment and not any(ord(x) <= 32 or ord(x) == 127 for x in url)
                  and (port is None or 0 < port < 65536))
    except ValueError:
        valide = False
    if not valide:
        raise Erreur(T("URL du serveur invalide (http:// ou https://).", "Invalid server URL (http:// or https://)."))
    if not c.get("SECRET_KEY") or any(ord(x) < 32 or ord(x) > 126 for x in c["SECRET_KEY"]):
        raise Erreur(T("Clé secrète absente ou invalide.", "Missing or invalid secret key."))
    try:
        timeout = float(c.get("TIMEOUT", "180"))
        if not math.isfinite(timeout) or not 1 <= timeout <= 600:
            raise ValueError
    except (ValueError, TypeError):
        raise Erreur(T("TIMEOUT doit être compris entre 1 et 600 secondes.", "TIMEOUT must be between 1 and 600 seconds.")) from None
    ident = c.get("USER_ID", "").strip()
    if not ident or len(ident) > 200 or any(ord(x) < 32 for x in ident):
        raise Erreur(T("USER_ID absent ou invalide.", "Missing or invalid USER_ID."))
    v = dict(URL=url, SECRET_KEY=c["SECRET_KEY"], USER_ID=ident, TIMEOUT=timeout)
    # CLIENT_ID (facultatif, issue #12) : le nom de ce PC pour JARVIS ; absent, c'est le nom d'hôte (nom_du_pc)
    client = (c.get("CLIENT_ID") or "").strip()
    if client:
        if not NOM_PC.fullmatch(client):
            raise Erreur(T("Nom de ce PC pour JARVIS invalide : lettres, chiffres et tirets, 32 caractères au plus.",
                           "Invalid PC name for JARVIS: letters, digits and dashes, 32 characters at most."))
        v["CLIENT_ID"] = client
    return v


NOM_PC = re.compile(r"[A-Za-z0-9-]{1,32}")


def nom_du_pc():
    """Le nom d'hôte ramené à la règle de CLIENT_ID (sans domaine, autres caractères en tirets, 32 au plus) ; "" s'il
    n'en reste rien (le serveur se rabat alors sur USER_ID)."""
    try:
        h = socket.gethostname().split(".")[0]
    except OSError:
        return ""
    return re.sub(r"[^A-Za-z0-9-]+", "-", h).strip("-")[:32].strip("-")


def client_id(c):
    """L'identifiant de ce PC envoyé à /api/ask : une session par machine pour un même USER_ID (issue #12).
    JARVIS-BIS le lit depuis 8ff25c3 (la révision validée, 64523e5, en fait la clé de session AGY) ; 3d1c6b6 ignore ce
    champ inconnu sans erreur (modèle Pydantic sans extra="forbid") : il part donc toujours."""
    return c.get("CLIENT_ID") or nom_du_pc()


def hote_tailscale(url):
    """Vrai pour une adresse Tailscale (100.64.0.0/10 ou un nom MagicDNS *.ts.net) : joignable de partout sur ton
    réseau Tailscale et chiffrée de bout en bout (WireGuard), même en http:// (issue #5)."""
    h = (urllib.parse.urlsplit(url).hostname or "").lower().rstrip(".")
    if h.endswith(".ts.net"):
        return True
    try:
        return ipaddress.ip_address(h) in ipaddress.ip_network("100.64.0.0/10")
    except ValueError:
        return False


def hote_prive(url):
    """Vrai si l'hôte n'est joignable que depuis le réseau local du serveur (pas une adresse Tailscale)."""
    h = (urllib.parse.urlsplit(url).hostname or "").lower().rstrip(".")
    if not h or hote_tailscale(url):
        return False
    if h == "localhost" or h.endswith(".local") or h.endswith(".lan") or h.endswith(".home.arpa"):
        return True
    try:
        ip = ipaddress.ip_address(h)
    except ValueError:
        return False
    return bool(ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved)


def configuration():
    try:
        if CONF.stat().st_mode & 0o077:
            raise Erreur(T("Protège la configuration : chmod 600 ~/.config/nc/assistant.conf",
                           "Protect the configuration: chmod 600 ~/.config/nc/assistant.conf"))
        lignes = CONF.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        raise Erreur(T("Assistant non configuré : lance nc-assistant configurer.",
                       "Assistant is not configured: run nc-assistant configurer.")) from None
    except (OSError, UnicodeError):
        raise Erreur(T("Configuration de l'assistant illisible.", "Cannot read the assistant configuration.")) from None
    c = {"USER_ID": os.environ.get("USER") or getpass.getuser(), "TIMEOUT": "180"}
    for ligne in lignes:
        if "=" not in ligne or ligne.lstrip().startswith("#"):
            continue
        k, v = ligne.split("=", 1)
        v = v.strip()
        if v.startswith('"'):
            try:
                v = json.loads(v)
            except ValueError:
                raise Erreur(T("Configuration invalide : guillemets incorrects.", "Invalid configuration: malformed quotes.")) from None
        if not isinstance(v, str):
            raise Erreur(T("Configuration invalide.", "Invalid configuration."))
        c[k.strip()] = v
    return valider(c)


def sauvegarder(c):
    c = valider(c)
    if CONF.is_symlink():
        raise Erreur(T("La configuration est un lien symbolique ; modifie sa cible manuellement.",
                       "The configuration is a symlink; edit its target manually."))
    CONF.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    nom = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=CONF.parent,
                                         prefix=".assistant-", delete=False) as f:
            nom = f.name
            for k, v in c.items():
                f.write(k + "=" + json.dumps(str(v), ensure_ascii=False) + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(nom, CONF)
    finally:
        if nom and os.path.exists(nom):
            os.unlink(nom)


def fenetre_configuration():
    """La fenêtre « Connexion JARVIS » de l'île (Quickshell) ; vrai si elle s'est ouverte."""
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) or not shutil.which("qs"):
        return False
    try:
        return subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", "connexionJarvis"], capture_output=True,
                              timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def configuration_brute():
    """Ce qui est enregistré, sans validation (pré-remplir la fenêtre, garder la clé) ; {} sans fichier."""
    try:
        lignes = CONF.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return {}
    c = {}
    for ligne in lignes:
        if "=" in ligne and not ligne.lstrip().startswith("#"):
            k, v = ligne.split("=", 1)
            v = v.strip()
            try:
                v = json.loads(v) if v.startswith('"') else v
            except ValueError:
                continue
            if isinstance(v, str):
                c[k.strip()] = v
    return c


def configuration_depuis(d):
    """Les valeurs de la fenêtre (JSON sur l'entrée standard, jamais en argument : la clé n'apparaît pas dans la liste
    des processus) ; une clé vide garde celle qui est enregistrée."""
    if not isinstance(d, dict):
        raise Erreur(T("Données invalides.", "Invalid data."))
    avant = configuration_brute()
    champ = lambda k: d.get(k) if isinstance(d.get(k), str) else ""
    return valider(dict(URL=champ("url").strip(), SECRET_KEY=champ("secret_key") or avant.get("SECRET_KEY", ""),
                        USER_ID=champ("user_id").strip() or avant.get("USER_ID") or os.environ.get("USER") or getpass.getuser(),
                        TIMEOUT=champ("timeout").strip() or avant.get("TIMEOUT", "180"),
                        # Champ vide : le nom d'hôte ; champ absent (ancien appelant) : le nom enregistré
                        CLIENT_ID=champ("client_id").strip() if "client_id" in d else avant.get("CLIENT_ID", "")))


def avertissement(url):
    if hote_prive(url):
        return T("Adresse locale ou privée : elle ne marche que sur le réseau du serveur. Depuis ailleurs, utilise l'adresse "
                 "HTTPS d'un tunnel (Cloudflare, Tailscale).",
                 "Local or private address: it only works on the server's network. From elsewhere, use a tunnel's HTTPS "
                 "address (Cloudflare, Tailscale).")
    if url.startswith("http://") and not hote_tailscale(url):
        return T("HTTP en clair : hors du réseau local, utilise HTTPS.", "Plain HTTP: outside the local network, use HTTPS.")
    return ""


def configuration_ile(action):
    """Commandes de la fenêtre « Connexion JARVIS » : lire (sans la clé), tester ou enregistrer (JSON sur l'entrée)."""
    if action == "lire":
        c = configuration_brute()
        print(json.dumps(dict(existe=CONF.exists(), url=c.get("URL", ""), user_id=c.get("USER_ID") or os.environ.get("USER") or "",
                              timeout=c.get("TIMEOUT", "180"), cle=bool(c.get("SECRET_KEY")),
                              client_id=c.get("CLIENT_ID", ""), hote=nom_du_pc()), ensure_ascii=False))
        return 0
    try:
        c = configuration_depuis(json.loads(sys.stdin.readline(65537) or "null"))
    except (Erreur, ValueError) as e:
        print(json.dumps(dict(ok=False, error=str(e) if isinstance(e, Erreur) else T("Données invalides.", "Invalid data.")), ensure_ascii=False))
        return 1
    if action == "tester":
        return verifier(c, json_out=True)
    try:
        sauvegarder(c)
    except (Erreur, OSError) as e:
        print(json.dumps(dict(ok=False, error=str(e) if isinstance(e, Erreur) else T("Écriture impossible : vérifie les droits.",
                                                                                     "Cannot write: check permissions.")), ensure_ascii=False))
        return 1
    print(json.dumps(dict(ok=True, warning=avertissement(c["URL"])), ensure_ascii=False))
    return 0


def configurer(terminal=False):
    if not terminal and fenetre_configuration():
        print(T("Fenêtre « Connexion JARVIS » ouverte.", "“JARVIS Connection” window opened."))
        return
    if not sys.stdin.isatty():
        raise Erreur(T("Ni fenêtre ni terminal : lance nc-assistant configurer dans ta session graphique ou un terminal.",
                       "Neither window nor terminal: run nc-assistant configurer in your graphical session or a terminal."))
    c = configuration() if CONF.exists() else {}
    url = input(T("URL du serveur", "Server URL") + (f" [{c['URL']}]" if c else "") + " : ").strip()
    cle = getpass.getpass(T("Clé secrète (vide : garder l'existante) : ",
                           "Secret key (empty: keep existing key): "))
    ident = c.get("USER_ID") or os.environ.get("USER") or getpass.getuser()
    utilisateur = input(f"USER_ID [{ident}] : ").strip() or ident
    # Vide : garder le nom enregistré, sinon le nom d'hôte (qui suit alors un renommage du PC)
    pc = input(T("Nom de ce PC pour JARVIS", "Name of this PC for JARVIS")
               + f" [{c.get('CLIENT_ID') or nom_du_pc()}] : ").strip()
    sauvegarder(dict(URL=url or c.get("URL", ""), SECRET_KEY=cle or c.get("SECRET_KEY", ""),
                     USER_ID=utilisateur, TIMEOUT=c.get("TIMEOUT", "180"), CLIENT_ID=pc or c.get("CLIENT_ID", "")))
    print(T("Configuration enregistrée (0600).", "Configuration saved (0600)."))
    finale = url or c.get("URL", "")
    if hote_prive(finale):
        print(T("Attention : cette URL est locale/privée. Elle ne fonctionnera que sur le même réseau "
                "que le serveur. Depuis un autre réseau, utilise l'URL HTTPS d'un tunnel "
                "(Cloudflare, Tailscale) exposée par le serveur.",
                "Warning: this is a local/private URL. It only works on the same network as the server. "
                "From another network, use the HTTPS URL of a tunnel (Cloudflare, Tailscale) exposed by the server."))
    elif finale.startswith("http://") and not hote_tailscale(finale):
        print(T("Attention : HTTP en clair. Hors du réseau local, utilise impérativement HTTPS.",
                "Warning: plain HTTP. Outside the local network, HTTPS is required."))
    print(T("Teste la connexion avec : nc-assistant verifier",
            "Test the connection with: nc-assistant verifier"))


class SansRedirection(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # Ne jamais transmettre X-Secret-Key à une cible de redirection.
        return None


def cle_session(c):
    """La clé de session de ce PC, celle que le gateway (JARVIS-BIS 64523e5) donne à nos /api/ask :
    « platform:client_id », sinon « platform:USER_ID ». Envoyée avec la gestion (modèle, nouvelle conversation, reprise)
    pour que, avec AGY, ces réglages touchent la session de ce PC et pas une session « default » que personne n'utilise.
    3d1c6b6 et un ancien adaptateur l'ignorent."""
    return "desktop:" + (client_id(c) or str(c.get("USER_ID") or ""))


def api(c, endpoint, payload=None):
    if endpoint == "/api/nc/manage" and isinstance(payload, dict) and "session_key" not in payload:
        payload = dict(payload, session_key=cle_session(c))
    corps = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(c["URL"] + endpoint, data=corps,
                                 headers={"Content-Type": "application/json", "X-Secret-Key": c["SECRET_KEY"]},
                                 method="GET" if payload is None else "POST")
    try:
        with urllib.request.build_opener(SansRedirection()).open(req, timeout=c["TIMEOUT"] if corps else 10) as r:
            contenu = r.read(MAX_RESPONSE + 1)
    except urllib.error.HTTPError as e:
        if 300 <= e.code < 400:
            raise Erreur(T("Redirection refusée : configure directement l'URL finale, en HTTPS.",
                           "Redirect refused: configure the final HTTPS URL directly.")) from None
        if e.code in (401, 403):
            raise Erreur(T(f"Clé refusée par le serveur (HTTP {e.code}) : vérifie SECRET_KEY.",
                           f"Server rejected the key (HTTP {e.code}): check SECRET_KEY.")) from None
        if e.code == 404:
            raise Erreur(T("Route introuvable (HTTP 404) : vérifie l'URL et son préfixe de chemin.",
                           "Route not found (HTTP 404): check the URL and its path prefix.")) from None
        if e.code == 429:
            raise Erreur(T("Trop de requêtes (HTTP 429) : réessaie dans une minute.",
                           "Too many requests (HTTP 429): try again in a minute.")) from None
        if 500 <= e.code < 600:
            raise Erreur(T(f"Erreur interne du serveur (HTTP {e.code}) : consulte ses journaux.",
                           f"Server internal error (HTTP {e.code}): check its logs.")) from None
        raise Erreur(T(f"Erreur HTTP {e.code} du serveur.", f"Server HTTP error {e.code}.")) from None
    except (TimeoutError, socket.timeout):
        raise Erreur(T("Le serveur n'a pas répondu à temps (réseau lent, tunnel arrêté ou requête trop longue).",
                       "The server did not respond in time (slow network, stopped tunnel or long request).")) from None
    except urllib.error.URLError as e:
        raison = getattr(e, "reason", None)
        if isinstance(raison, (TimeoutError, socket.timeout)):
            raise Erreur(T("Le serveur n'a pas répondu à temps.", "The server did not respond in time.")) from None
        if isinstance(raison, ssl.SSLCertVerificationError) or isinstance(raison, ssl.SSLError):
            raise Erreur(T("Certificat TLS invalide : l'URL HTTPS ne correspond pas au certificat du serveur.",
                           "Invalid TLS certificate: the HTTPS URL does not match the server certificate.")) from None
        if isinstance(raison, socket.gaierror):
            raise Erreur(T("Nom du serveur introuvable (DNS) : vérifie l'URL publique.",
                           "Server name not found (DNS): check the public URL.")) from None
        if isinstance(raison, ConnectionRefusedError):
            raise Erreur(T("Connexion refusée : le service ou le tunnel n'écoute pas à cette adresse.",
                           "Connection refused: the service or tunnel is not listening at this address.")) from None
        if isinstance(raison, (ConnectionResetError, http.client.RemoteDisconnected)):
            raise Erreur(T("Connexion interrompue par le serveur ou le tunnel.",
                           "Connection closed by the server or tunnel.")) from None
        raise Erreur(T("Serveur inaccessible (réseau, adresse ou certificat).",
                       "Server unreachable (network, address or certificate).")) from None
    except ssl.SSLError:
        raise Erreur(T("Erreur TLS : vérifie le certificat et utilise l'URL HTTPS finale.",
                       "TLS error: check the certificate and use the final HTTPS URL.")) from None
    except ConnectionRefusedError:
        raise Erreur(T("Connexion refusée : le service ou le tunnel n'écoute pas à cette adresse.",
                       "Connection refused: the service or tunnel is not listening at this address.")) from None
    except (http.client.HTTPException, UnicodeError, ValueError):
        raise Erreur(T("Réponse ou adresse HTTP invalide.", "Invalid HTTP response or address.")) from None
    except OSError:
        raise Erreur(T("Serveur inaccessible (réseau, adresse ou certificat).",
                       "Server unreachable (network, address or certificate).")) from None
    if len(contenu) > MAX_RESPONSE:
        raise Erreur(T("Réponse du serveur trop volumineuse.", "Server response is too large."))
    try:
        resultat = json.loads(contenu)
    except (ValueError, UnicodeError):
        raise Erreur(T("Le serveur n'a pas renvoyé un JSON valide.", "The server did not return valid JSON.")) from None
    if not isinstance(resultat, dict):
        raise Erreur(T("Format de réponse inattendu.", "Unexpected response format."))
    if resultat.get("success") is False or resultat.get("error"):
        # Ne pas afficher le corps d'une erreur : il peut contenir des données privées du serveur.
        raise Erreur(T("Le serveur a signalé un échec. Consulte ses journaux.",
                       "The server reported a failure. Check its logs."))
    return resultat


def texte_sortie(resultat):
    t = resultat.get("output")
    if not isinstance(t, str) or not t.strip():
        raise Erreur(T("Le serveur n'a renvoyé aucune réponse.", "The server returned no answer."))
    # Réponses distantes affichées en texte : aucun contrôle du terminal (OSC, CSI, BEL…).
    t = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", t)
    t = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", t)
    return "".join(x for x in t if x in "\n\t" or (ord(x) >= 32 and not 127 <= ord(x) <= 159))


_CHOIX = []


def module_choix():
    """nc_choix, la même extraction que le gateway (issue #7), installé à côté : ~/.local/share/nc-jarvis/server ;
    None s'il manque."""
    if not _CHOIX:
        try:
            import importlib.util
            chemin = Path(__file__).resolve().parent.parent / "share/nc-jarvis/server/nc_choix.py"
            spec = importlib.util.spec_from_file_location("nc_choix", chemin)
            m = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(m)
            _CHOIX.append(m)
        except (OSError, SyntaxError, ImportError, AttributeError):
            _CHOIX.append(None)
    return _CHOIX[0]


def choix_reponse(resultat, texte):
    """(texte, choix) : les choix envoyés par le gateway, revérifiés ; sans eux (gateway pas encore à jour), extraits
    ici de la réponse, marqueur [[choix: …]] retiré. Au plus 5 choix de 80 caractères, sinon aucun."""
    m = module_choix()
    if m is None:
        return texte, []
    if "choices" in resultat:
        return texte, m.verifier_choix(resultat.get("choices")) if resultat.get("choices") else []
    return m.extraire_choix(texte)


def verifier(c, json_out=False):
    """Teste la connexion et explique précisément ce qui bloque."""
    prive = hote_prive(c["URL"])
    debut = time.monotonic()
    try:
        r = api(c, "/api/status")
        if not any(isinstance(r.get(k), bool) for k in ("online", "runner_alive")):
            raise Erreur(T("État du serveur invalide : online ou runner_alive attendu.",
                           "Invalid server status: expected online or runner_alive."))
    except Erreur as e:
        resultat = {"configured": True, "online": False, "url": c["URL"],
                    "private": prive, "error": str(e)}
        if json_out:
            print(json.dumps(resultat, ensure_ascii=False))
        else:
            print(T("Connexion impossible : ", "Connection failed: ") + str(e), file=sys.stderr)
            if prive:
                print(T("Indice : cette URL est locale/privée ; elle ne fonctionne que sur le réseau du serveur. "
                        "Depuis un autre réseau, utilise l'URL HTTPS d'un tunnel (Cloudflare, Tailscale).",
                        "Hint: this is a local/private URL; it only works on the server's network. "
                        "From another network, use the HTTPS URL of a tunnel (Cloudflare, Tailscale)."),
                      file=sys.stderr)
            elif hote_tailscale(c["URL"]):
                print(T("Indice : adresse Tailscale ; vérifie que ce PC est connecté à ton réseau Tailscale (tailscale status).",
                        "Hint: Tailscale address; check this PC is connected to your Tailscale network (tailscale status)."),
                      file=sys.stderr)
            elif c["URL"].startswith("http://"):
                print(T("Indice : utilise HTTPS hors du réseau local.",
                        "Hint: use HTTPS outside the local network."), file=sys.stderr)
        return 1

    latence = int((time.monotonic() - debut) * 1000)
    runner = r.get("online") is not False and r.get("runner_alive") is not False
    public_url = (r.get("gateway") or {}).get("public_url") if isinstance(r.get("gateway"), dict) else None
    # Les métadonnées distantes ne doivent ni contrôler le terminal ni répéter la clé.
    def metadata(v):
        return texte_sortie({"output": v}).replace(c["SECRET_KEY"], "[redacted]")[:300] if isinstance(v, str) and v.strip() else None
    public_url = metadata(public_url)
    version = metadata(r.get("version"))
    resultat = {
        "configured": True,
        "online": bool(runner),
        "runner_alive": bool(runner),
        "url": c["URL"],
        "private": prive,
        "latency_ms": latence,
        "version": version,
        "public_url": public_url,
        "error": None if runner else T("Le runner est hors ligne.", "The runner is offline."),
    }
    if json_out:
        print(json.dumps(resultat, ensure_ascii=False))
    else:
        if runner:
            version = f" v{version}" if version else ""
            print(T(f"Connexion OK — gateway{version}, runner en ligne, {latence} ms.",
                    f"Connection OK — gateway{version}, runner online, {latence} ms."))
        else:
            print(T("Gateway joignable, mais le runner est hors ligne.",
                    "Gateway reachable, but the runner is offline."), file=sys.stderr)
        if prive:
            print(T("Attention : URL locale/privée, valable seulement sur le réseau du serveur.",
                    "Warning: local/private URL, only valid on the server's network."))
        if public_url and public_url != c["URL"].rstrip("/"):
            print(T(f"URL publique annoncée par le serveur : {public_url}",
                    f"Public URL announced by the server: {public_url}"))
    return 0 if runner else 1


def runtime():
    p = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/nc-{os.getuid()}") / "nc-assistant"
    p.mkdir(parents=True, mode=0o700, exist_ok=True)
    st = p.lstat()
    if p.is_symlink() or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise Erreur(T("Dossier temporaire de l'assistant non privé.", "Assistant runtime directory is not private."))
    return p


@contextlib.contextmanager
def requete_unique(c):
    # L'API donnée n'a qu'une conversation par platform/USER_ID. Pas de requêtes simultanées vers cette identité.
    ident = hashlib.sha256((c["URL"] + "\0" + c["USER_ID"]).encode()).hexdigest()
    fd = os.open(runtime() / (ident + ".lock"), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Erreur(T("Une requête est déjà en cours pour cet utilisateur. Réessaie après sa réponse.",
                           "A request is already running for this user. Try again after its response.")) from None
        yield


def maj_ile(sid, evenement, chat=False, message=""):
    commande = Path(__file__).resolve().with_name("nc-claude")
    if not commande.is_file():
        return
    try:
        r = subprocess.run([sys.executable, str(commande), "assistant", evenement],
                           input=json.dumps(dict(session_id=sid, chat=chat, message=message)),
                           text=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=5)
        if r.returncode:
            print(T("Suivi dans l'île indisponible ; la requête reste utilisable.",
                    "Island tracking unavailable; the request remains usable."), file=sys.stderr)
    except (OSError, subprocess.TimeoutExpired):
        print(T("Suivi dans l'île indisponible.", "Island tracking unavailable."), file=sys.stderr)


JOURS = {"lundi":0,"mardi":1,"mercredi":2,"jeudi":3,"vendredi":4,"samedi":5,"dimanche":6,
         "monday":0,"tuesday":1,"wednesday":2,"thursday":3,"friday":4,"saturday":5,"sunday":6}
# Récurrences de /rappel (français et anglais), dans les mots du gateway JARVIS : daily, weekdays, weekly, weekly:N,
# monthly, every:days:N, every:weeks:N, every:months:N ; every:hours:N est ajouté par l'overlay nc_telegram du gateway
RECURRENCES = [
    (r"(?:en\s+semaine|jours\s+ouvr[ée]s|du\s+lundi\s+au\s+vendredi|(?:on\s+)?weekdays|every\s+weekday)", lambda m: "weekdays"),
    (r"(?:tous\s+les\s+jours|chaque\s+jour|quotidien(?:nement)?|tous\s+les\s+(?:matins|soirs)|chaque\s+(?:matin|soir)|daily|every\s+day)", lambda m: "daily"),
    (r"(?:chaque|tous\s+les|every|on)\s+(lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche|monday|tuesday|wednesday|thursday|friday|saturday|sunday)s?", lambda m: "weekly:%d" % JOURS[m[1].lower()]),
    (r"(?:chaque|toutes\s+les)\s+semaines?|weekly|every\s+week", lambda m: "weekly"),
    (r"(?:chaque|tous\s+les)\s+mois|monthly|every\s+month", lambda m: "monthly"),
    (r"(?:toutes\s+les|chaque|every)\s+heures?|hourly|every\s+hour", lambda m: "every:hours:1"),
    (r"(?:toutes\s+les|tous\s+les|chaque|every)\s+(\d{1,3})\s+(?:heures?|hours?|h)", lambda m: "every:hours:%d" % int(m[1])),
    (r"(?:tous\s+les|toutes\s+les|chaque|every)\s+(\d{1,3})\s+(?:jours?|days?)", lambda m: "every:days:%d" % int(m[1])),
    (r"(?:toutes\s+les|tous\s+les|chaque|every)\s+(\d{1,3})\s+(?:semaines?|weeks?)", lambda m: "every:weeks:%d" % int(m[1])),
    (r"(?:tous\s+les|toutes\s+les|chaque|every)\s+(\d{1,3})\s+(?:mois|months?)", lambda m: "every:months:%d" % int(m[1])),
]
DELAI = re.compile(r"([0-9]{1,8})([smhd])")
HEURE = re.compile(r"([01]?[0-9]|2[0-3])(?::|h)([0-5][0-9])?")


def etiquette_recurrence(r):
    jours = [T("lundi", "Monday"), T("mardi", "Tuesday"), T("mercredi", "Wednesday"), T("jeudi", "Thursday"),
             T("vendredi", "Friday"), T("samedi", "Saturday"), T("dimanche", "Sunday")]
    fixes = {"daily": T("tous les jours", "every day"), "weekdays": T("du lundi au vendredi", "Monday to Friday"),
             "weekly": T("toutes les semaines", "every week"), "monthly": T("tous les mois", "every month")}
    if not r:
        return ""
    if r in fixes:
        return fixes[r]
    m = re.fullmatch(r"weekly:([0-6])", r)
    if m:
        return T("chaque ", "every ") + jours[int(m[1])]
    m = re.fullmatch(r"every:(hours|days|weeks|months):(\d+)", r)
    if m:
        n = int(m[2])
        unites = {"hours": T("heure", "hour"), "days": T("jour", "day"), "weeks": T("semaine", "week"), "months": T("mois", "month")}
        u = unites[m[1]]
        if n > 1 and not u.endswith("s") and u != "mois":
            u += "s"
        return T(f"toutes les {n} {u}" if m[1] in ("hours", "weeks") else f"tous les {n} {u}", f"every {n} {u}")
    return r


def premiere_occurrence(recurrence, heure, minute, maintenant):
    """La première échéance d'un rappel à heure fixe : aujourd'hui, sinon demain ; alignée sur le jour de la récurrence."""
    cible = maintenant.replace(hour=heure, minute=minute, second=0, microsecond=0)
    if cible <= maintenant:
        cible += timedelta(days=1)
    m = re.fullmatch(r"weekly:([0-6])", recurrence or "")
    if m:
        cible += timedelta(days=(int(m[1]) - cible.weekday()) % 7)
    elif recurrence == "weekdays":
        while cible.weekday() >= 5:
            cible += timedelta(days=1)
    elif recurrence == "monthly" and cible.date() != maintenant.date():
        # L'heure est passée aujourd'hui : le même jour du mois prochain, pas demain
        mois, annee = (maintenant.month % 12) + 1, maintenant.year + (maintenant.month == 12)
        import calendar
        cible = maintenant.replace(year=annee, month=mois, day=min(maintenant.day, calendar.monthrange(annee, mois)[1]),
                                   hour=heure, minute=minute, second=0, microsecond=0)
    return cible


def fuseau_local():
    """Le fuseau de ce PC avec ses changements d'heure (Europe/Paris…), ou None. datetime.now().astimezone() donne un
    décalage figé : une échéance après le changement d'heure tombait une heure à côté (revue REM-01)."""
    from zoneinfo import ZoneInfo
    nom = os.environ.get("TZ", "").lstrip(":")
    if not nom:
        chemin = os.path.realpath("/etc/localtime")
        nom = chemin.split("zoneinfo/", 1)[1] if "zoneinfo/" in chemin else ""
    try:
        return ZoneInfo(nom) if nom else None
    except (ValueError, OSError, KeyError):
        return None


def lire_rappel(arg, maintenant=None):
    """/rappel [bureau|telegram|discord] [récurrence] <délai|heure> <message>
    → (plateformes, récurrence ou None, délai « 15m » ou None, échéance (datetime) ou None, message)."""
    fuseau = fuseau_local()
    maintenant = maintenant or (datetime.now(fuseau) if fuseau else datetime.now().astimezone())
    syntaxe = T("Syntaxe : /rappel [bureau|telegram|discord] [tous les jours|chaque samedi|toutes les 3 heures…] <délai ou heure> <message> "
                "(ex. 15m sortir le pain ; telegram tous les jours 08:30 vitamines).",
                "Syntax: /remind [desktop|telegram|discord] [every day|every saturday|every 3 hours…] <delay or time> <message> "
                "(e.g. 15m take out bread; telegram every day 08:30 vitamins).")
    reste = arg.strip()
    plateformes = ["desktop"]
    premier = reste.split(maxsplit=1)[0].lower() if reste else ""
    if premier and re.fullmatch(r"[a-z,]+", premier) and not DELAI.fullmatch(premier) and not HEURE.fullmatch(premier) \
            and not any(re.match(motif + r"\b", reste, re.IGNORECASE) for motif, _ in RECURRENCES):
        plateformes = list(dict.fromkeys("desktop" if p in ("bureau", "desktop") else p for p in premier.split(",")))
        if not plateformes or any(p not in ("desktop", "telegram", "discord") for p in plateformes):
            raise Erreur(T("Plateforme : bureau, telegram, discord ou une liste séparée par des virgules.",
                           "Platform: desktop, telegram, discord, or a comma-separated list."))
        reste = reste.split(maxsplit=1)[1] if " " in reste else ""
    recurrence = None
    for motif, valeur in RECURRENCES:
        m = re.match(motif + r"\b[,\s]*", reste, re.IGNORECASE)
        if m:
            recurrence = valeur(m)
            reste = reste[m.end():]
            break
    morceaux = reste.split(maxsplit=1)
    if not morceaux:
        raise Erreur(syntaxe)
    delai = echeance = None
    quand = morceaux[0].lower()
    # Avec une récurrence, « 10h » est une heure du jour ; sans, c'est un délai de dix heures (comme avant)
    if HEURE.fullmatch(quand) and (recurrence or not DELAI.fullmatch(quand)):
        h, mn = HEURE.fullmatch(quand).groups()
        echeance = premiere_occurrence(recurrence, int(h), int(mn or 0), maintenant)
    elif DELAI.fullmatch(quand):
        if recurrence and not recurrence.startswith("every:hours:"):
            raise Erreur(T("Rappel récurrent : donne une heure (ex. 08:30), pas un délai.", "Recurring reminder: give a time (e.g. 08:30), not a delay."))
        n, u = DELAI.fullmatch(quand).groups()
        if not 1 <= int(n) * {"s":1,"m":60,"h":3600,"d":86400}[u] <= 366 * 86400:
            raise Erreur(T("Délai : de 1 seconde à 366 jours, avec s, m, h ou d.", "Delay: 1 second to 366 days, using s, m, h or d."))
        delai = quand
    elif recurrence and recurrence.startswith("every:hours:"):
        # « toutes les 3 heures boire » : la première fois dans 3 heures
        delai = recurrence.rsplit(":", 1)[1] + "h"
        morceaux = [quand, reste.strip()]
    elif recurrence:
        raise Erreur(T("Rappel récurrent : donne une heure, par exemple 08:30 ou 8h.", "Recurring reminder: give a time, for example 08:30 or 8am."))
    else:
        raise Erreur(syntaxe)
    message = morceaux[1].strip() if len(morceaux) > 1 else ""
    if not message:
        raise Erreur(syntaxe)
    if len(message) > 4000 or any(ord(c) < 32 and c not in "\n\t" for c in message):
        raise Erreur(T("Message de rappel invalide (4 000 caractères maximum).", "Invalid reminder message (4,000 characters maximum)."))
    if recurrence and "desktop" in plateformes:
        raise Erreur(T("Rappel récurrent : telegram ou discord (il est gardé sur le serveur JARVIS) ; le bureau ne prend qu'un rappel ponctuel.",
                       "Recurring reminder: telegram or discord (it is kept on the JARVIS server); desktop takes a one-off reminder only."))
    return plateformes, recurrence, delai, echeance, message


def corps_rappel(plateforme, recurrence, delai, echeance, message):
    """Le corps envoyé à POST /api/reminders (un délai relatif, sinon l'échéance en ISO 8601 locale)."""
    corps = {"platform": plateforme, "message": message}
    if delai:
        corps["delay"] = delai
    else:
        corps["remind_at"] = echeance.isoformat(timespec="seconds")
    if recurrence:
        corps["recurrence"] = recurrence
    return corps


def lister_rappels(c):
    res = api(c, "/api/reminders")
    rappels = res.get("reminders") if isinstance(res, dict) else None
    if not rappels:
        return T("⏰ Aucun rappel en attente sur le serveur.", "⏰ No pending reminder on the server.")
    lignes = []
    for r in rappels[:50]:
        try:
            quand = datetime.fromisoformat(str(r.get("remind_at"))).astimezone().strftime("%d/%m %H:%M")
        except ValueError:
            quand = str(r.get("remind_at", ""))[:16]
        ligne = f"• #{r.get('id')} — {str(r.get('message', ''))[:200]} — {quand} — {r.get('platform', '')}"
        if r.get("recurrence"):
            ligne += " — 🔁 " + etiquette_recurrence(str(r["recurrence"]))
        lignes.append(ligne)
    return f"⏰ **{T('Rappels en attente', 'Pending reminders')} :**\n\n" + "\n".join(lignes) + \
        T("\n\nSupprimer : /supprimer <numéro>", "\n\nDelete: /supprimer <number>")


def configuration_question(question):
    # Les rappels de ce bureau ne nécessitent ni clé, ni serveur JARVIS disponible.
    morceaux = question.strip().split(maxsplit=1)
    if morceaux and morceaux[0].lower() in ("/rappel", "/remind"):
        plateformes = lire_rappel(morceaux[1] if len(morceaux) > 1 else "")[0]
        if plateformes == ["desktop"]:
            return {"URL":"local:desktop", "USER_ID":str(os.getuid())}
    return configuration()


def programmer_rappel_bureau(delai, message):
    if not shutil.which("systemd-run") or not shutil.which("notify-send"):
        raise Erreur(T("Rappel bureau : systemd-run et notify-send sont nécessaires.", "Desktop reminder requires systemd-run and notify-send."))
    dossier = runtime()
    ident = uuid.uuid4().hex
    fichier = dossier / ("rappel-" + ident + ".json")
    fd = os.open(fichier, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"message":message}, f); f.flush(); os.fsync(f.fileno())
        secondes = int(delai[:-1]) * {"s":1,"m":60,"h":3600,"d":86400}[delai[-1]]
        echeance = datetime.fromtimestamp(math.ceil(time.time() + secondes), timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        # Échéance civile : un rappel échu pendant la veille arrive au réveil.
        # Le message reste dans le fichier privé, jamais dans l'unité ou une commande shell.
        r = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", "--unit=nc-jarvis-rappel-" + ident,
                            "--on-calendar=" + echeance, "--timer-property=AccuracySec=1s", "--property=UMask=0077",
                            "--setenv=XDG_RUNTIME_DIR=" + str(dossier.parent), "--", sys.executable,
                            str(Path(__file__).resolve()), "rappel-notifier", ident],
                           capture_output=True, text=True, timeout=10)
        if r.returncode:
            raise Erreur(T("Le gestionnaire systemd utilisateur a refusé le rappel. Aucun rappel bureau créé.",
                           "The user systemd manager rejected the reminder. No desktop reminder created."))
    except BaseException:
        fichier.unlink(missing_ok=True)
        raise
    return ident


def notifier_rappel(ident):
    if not re.fullmatch(r"[a-f0-9]{32}", ident):
        raise Erreur(T("Identifiant de rappel invalide.", "Invalid reminder identifier."))
    fichier = runtime() / ("rappel-" + ident + ".json")
    fd = os.open(fichier, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if st.st_uid != os.getuid() or st.st_mode & 0o077 or st.st_size > 32000:
            raise Erreur(T("Fichier de rappel non privé ou invalide.", "Reminder file is not private or invalid."))
        message = json.load(f).get("message")
    if not isinstance(message, str) or not message or len(message) > 4000:
        raise Erreur(T("Message de rappel invalide.", "Invalid reminder message."))
    r = subprocess.run(["notify-send", "--app-name=JARVIS", "--icon=alarm", "--",
                        T("Rappel JARVIS", "JARVIS reminder"), html.escape(message)],
                       capture_output=True, text=True, timeout=10)
    if r.returncode:
        raise Erreur(T("Notification bureau refusée ; le rappel privé est conservé.", "Desktop notification failed; the private reminder was kept."))
    fichier.unlink()


def executer_commande(c, sid, cmd_brute):
    morceaux = cmd_brute.strip().split(maxsplit=1)
    nom_cmd = morceaux[0].lower()
    arg = morceaux[1].strip() if len(morceaux) > 1 else ""

    if nom_cmd in ("/reset", "/clear", "/nouveau"):
        try:
            api(c, "/api/nc/manage", {"op": "session.reset", "params": {}, "confirmed": True})
        except Exception:
            pass
        return T("✨ **Session réinitialisée**\n\nL'historique et la mémoire de session sur le serveur ont été remis à zéro. Vous pouvez démarrer une nouvelle conversation.",
                 "✨ **Session reset**\n\nActive session history and server memory have been reset. Ready for a new conversation!")

    if nom_cmd in ("/help", "/aide", "/commandes", "/commands"):
        return T(
            "🤖 **Commandes JARVIS (identiques au bot Telegram) :**\n\n"
            "• `/reset` ou `/clear` — Réinitialiser la session active\n"
            "• `/status` ou `/etat` — État du serveur, moteur et modèle\n"
            "• `/briefing` — Générer et afficher le briefing du jour\n"
            "• `/models` ou `/modeles` — Lister les modèles IA disponibles\n"
            "• `/model <nom>` — Sélectionner un modèle\n"
            "• `/engine <moteur>` — Changer de moteur (`agy`, `codex`, `claude`, `opencode`)\n"
            "• `/effort <niveau>` — Niveau de réflexion (`low`, `medium`, `high`, `xhigh`, `max`)\n"
            "• `/courses` [ajouter <articles>] — Consulter ou ajouter des courses\n"
            "• `/depenses` [montant desc] — Bilan mensuel ou ajout d'une dépense\n"
            "• `/devoirs` — Consulter les devoirs (Moodle)\n"
            "• `/rappel [bureau|telegram|discord] [tous les jours|chaque samedi|toutes les 3 heures] <délai ou heure> <message>` — Rappel (bureau par défaut ; récurrent : telegram ou discord)\n"
            "• `/rappels` — Rappels en attente sur le serveur ; `/supprimer <numéro>` en retire un\n"
            "• `/memoire` [texte] — Consulter ou enregistrer un fait en mémoire",
            "🤖 **JARVIS Commands (same as Telegram bot):**\n\n"
            "• `/reset` or `/clear` — Reset active session\n"
            "• `/status` — Server state, active engine and model\n"
            "• `/briefing` — Generate and display daily briefing\n"
            "• `/models` — List available AI models\n"
            "• `/model <name>` — Select model\n"
            "• `/engine <engine>` — Switch engine (`agy`, `codex`, `claude`, `opencode`)\n"
            "• `/effort <level>` — Reasoning effort (`low`, `medium`, `high`, `xhigh`, `max`)\n"
            "• `/shopping` [add <text>] — View or add grocery items\n"
            "• `/expenses` [amount desc] — Monthly summary or add an expense\n"
            "• `/moodle` — View homework\n"
            "• `/remind [desktop|telegram|discord] [every day|every saturday|every 3 hours] <delay or time> <message>` — Reminder (desktop by default; recurring: telegram or discord)\n"
            "• `/rappels` — Pending reminders on the server; `/supprimer <number>` removes one\n"
            "• `/memory` [text] — View or record a fact in memory"
        )

    if nom_cmd in ("/status", "/etat", "/diag"):
        try:
            st = api(c, "/api/status")
        except Exception as e:
            st = {"online": False, "error": str(e)}
        try:
            qs = api(c, "/api/nc/manage", {"op": "quick-settings", "params": {}})
        except Exception:
            qs = {}
        sess = qs.get("session") or {}
        gw = st.get("gateway") or {}
        moteur = sess.get("engine") or st.get("engine") or "agy"
        modele = sess.get("model") or "défaut"
        effort = sess.get("effort") or "défaut"
        online = st.get("online") is not False and st.get("runner_alive") is not False
        tg = ("✅ " + T("Configuré", "Configured")) if gw.get("telegram_configured") else ("❌ " + T("Non configuré", "Not configured"))
        dc = ("✅ " + T("Configuré", "Configured")) if gw.get("discord_configured") else ("❌ " + T("Non configuré", "Not configured"))
        return (
            f"⚡ **{T('État du système JARVIS', 'JARVIS System Status')} :**\n\n"
            f"• **{T('Serveur', 'Server')}** : {'🟢 ' + T('En ligne', 'Online') if online else '🔴 ' + T('Hors ligne', 'Offline')}\n"
            f"• **{T('Moteur actif', 'Active Engine')}** : `{moteur}`\n"
            f"• **{T('Modèle', 'Model')}** : `{modele}`\n"
            f"• **{T('Réflexion', 'Effort')}** : `{effort}`\n"
            f"• **Telegram** : {tg}\n"
            f"• **Discord** : {dc}"
        )

    if nom_cmd in ("/briefing",):
        r = api(c, "/api/briefing", {"force_refresh": False})
        return texte_sortie(r)

    if nom_cmd in ("/models", "/modeles"):
        try:
            qs = api(c, "/api/nc/manage", {"op": "quick-settings", "params": {}})
            engines = qs.get("engines") or []
            sess = qs.get("session") or {}
            curr_eng = sess.get("engine", "agy")
            target = next((e for e in engines if e.get("id") == curr_eng), None)
            models = target.get("models") if target else []
            if not models:
                return T("Aucun modèle spécifique listé pour le moteur actif.", "No specific models listed for active engine.")
            lignes = [f"• `{m.get('id')}` : **{m.get('name', m.get('id'))}**" for m in models[:20]]
            return f"🧠 **{T('Modèles disponibles pour', 'Available models for')} `{curr_eng}` :**\n\n" + "\n".join(lignes)
        except Exception as e:
            return T(f"Impossible de lister les modèles : {e}", f"Unable to list models: {e}")

    if nom_cmd in ("/model", "/modele"):
        if not arg:
            return T("Précise le nom du modèle (ex: `/model flash`).", "Specify model name (e.g. `/model flash`).")
        try:
            api(c, "/api/nc/manage", {"op": "session.update", "params": {"model": arg}, "confirmed": True})
            return T(f"✅ Modèle mis à jour : **{arg}**", f"✅ Model updated: **{arg}**")
        except Exception as e:
            return T(f"Erreur changement modèle : {e}", f"Error updating model: {e}")

    if nom_cmd in ("/engine", "/moteur"):
        if not arg or arg.lower() not in ("agy", "codex", "claude", "opencode"):
            return T("Moteurs acceptés : `agy`, `codex`, `claude`, `opencode`.", "Supported engines: `agy`, `codex`, `claude`, `opencode`.")
        try:
            api(c, "/api/nc/manage", {"op": "session.update", "params": {"engine": arg.lower()}, "confirmed": True})
            return T(f"✅ Moteur basculé sur : **{arg.lower()}**", f"✅ Engine switched to: **{arg.lower()}**")
        except Exception as e:
            return T(f"Erreur changement moteur : {e}", f"Error updating engine: {e}")

    if nom_cmd in ("/effort",):
        if not arg:
            return T("Niveaux d'effort acceptés : `low`, `medium`, `high`, `xhigh`, `max`.", "Supported effort levels: `low`, `medium`, `high`, `xhigh`, `max`.")
        try:
            api(c, "/api/nc/manage", {"op": "session.update", "params": {"effort": arg.lower()}, "confirmed": True})
            return T(f"✅ Niveau de réflexion réglé sur : **{arg.lower()}**", f"✅ Reasoning effort set to: **{arg.lower()}**")
        except Exception as e:
            return T(f"Erreur réglage effort : {e}", f"Error setting effort: {e}")

    if nom_cmd in ("/courses", "/shopping"):
        sub = arg.split(maxsplit=1)
        if sub and sub[0].lower() in ("add", "ajouter", "+"):
            items = sub[1] if len(sub) > 1 else ""
            if not items:
                return T("Précise les articles à ajouter.", "Specify items to add.")
            try:
                api(c, "/api/action", {"tool": "shopping", "action": "add", "params": {"text": items}, "platform": "desktop"})
                return T(f"🛒 **Articles ajoutés aux courses :** {items}", f"🛒 **Items added to shopping list:** {items}")
            except Exception as e:
                return T(f"Erreur ajout courses : {e}", f"Error adding shopping items: {e}")
        else:
            try:
                res = api(c, "/api/action", {"tool": "shopping", "action": "list", "params": {}, "platform": "desktop"})
                txt = texte_sortie(res)
                return f"🛒 **{T('Liste de courses', 'Shopping List')} :**\n\n{txt}"
            except Exception as e:
                return T(f"Erreur consultation courses : {e}", f"Error viewing shopping list: {e}")

    if nom_cmd in ("/depenses", "/expenses"):
        if arg:
            try:
                res = api(c, "/api/action", {"tool": "expenses", "action": "add", "params": {"description": arg}, "platform": "desktop"})
                return texte_sortie(res)
            except Exception as e:
                return T(f"Erreur ajout dépense : {e}", f"Error adding expense: {e}")
        else:
            try:
                res = api(c, "/api/action", {"tool": "expenses", "action": "summary", "params": {}, "platform": "desktop"})
                return f"💳 **{T('Bilan des dépenses', 'Expenses Summary')} :**\n\n{texte_sortie(res)}"
            except Exception as e:
                return T(f"Erreur bilan dépenses : {e}", f"Error viewing expenses: {e}")

    if nom_cmd in ("/devoirs", "/moodle"):
        try:
            res = api(c, "/api/action", {"tool": "moodle", "action": "devoirs", "params": {}, "platform": "desktop"})
            return f"📚 **{T('Devoirs à rendre', 'Homework')} :**\n\n{texte_sortie(res)}"
        except Exception as e:
            return T(f"Erreur consultation devoirs : {e}", f"Error viewing homework: {e}")

    if nom_cmd in ("/rappel", "/remind"):
        plateformes, recurrence, delai, echeance, msg = lire_rappel(arg)
        quand = T(f"dans {delai}", f"in {delai}") if delai else T("le ", "on ") + echeance.strftime("%d/%m %H:%M")
        if recurrence:
            quand += ", 🔁 " + etiquette_recurrence(recurrence)
        resultats = []
        for plateforme in plateformes:
            try:
                if plateforme == "desktop":
                    programmer_rappel_bureau(delai or str(max(1, int((echeance - datetime.now().astimezone()).total_seconds()))) + "s", msg)
                else:
                    api(c, "/api/reminders", corps_rappel(plateforme, recurrence, delai, echeance, msg))
                resultats.append(T(f"⏰ **Rappel {plateforme} programmé {quand} :** {msg}",
                                   f"⏰ **{plateforme} reminder scheduled {quand}:** {msg}"))
            except (Erreur, OSError, subprocess.SubprocessError) as e:
                resultats.append(T(f"Rappel {plateforme} non créé : {e}", f"{plateforme} reminder not created: {e}"))
        return "\n\n".join(resultats)

    if nom_cmd in ("/rappels", "/reminders"):
        try:
            return lister_rappels(c)
        except Exception as e:
            return T(f"Erreur lecture des rappels : {e}", f"Error reading reminders: {e}")

    if nom_cmd in ("/supprimer", "/delrappel", "/cancelreminder", "/annuler_rappel"):
        if not re.fullmatch(r"[0-9]{1,12}", arg.strip()):
            return T("Syntaxe : /supprimer <numéro du rappel> (voir /rappels).", "Syntax: /supprimer <reminder number> (see /rappels).")
        try:
            api(c, "/api/reminders/" + arg.strip() + "/cancel", {})
            return T(f"🗑 Rappel #{arg.strip()} supprimé.", f"🗑 Reminder #{arg.strip()} deleted.")
        except Exception as e:
            return T(f"Rappel non supprimé : {e}", f"Reminder not deleted: {e}")

    if nom_cmd in ("/memoire", "/memory"):
        if arg:
            try:
                api(c, "/api/nc/manage", {"op": "memory.add", "params": {"text": arg}, "confirmed": True})
                return T(f"🧠 **Fait enregistré en mémoire :** {arg}", f"🧠 **Fact saved in memory:** {arg}")
            except Exception as e:
                return T(f"Erreur enregistrement mémoire : {e}", f"Error saving memory fact: {e}")
        else:
            try:
                res = api(c, "/api/nc/manage", {"op": "memory", "params": {}})
                facts = res.get("facts") or []
                if not facts:
                    return T("🧠 Mémoire vide.", "🧠 Empty memory.")
                lignes = [f"• {f.get('text', f)}" for f in facts[:15]]
                return f"🧠 **{T('Mémoire persistante JARVIS', 'JARVIS Persistent Memory')} :**\n\n" + "\n".join(lignes)
            except Exception as e:
                return T(f"Erreur lecture mémoire : {e}", f"Error reading memory: {e}")

    return T(
        f"Commande inconnue `{nom_cmd}`. Tape `/help` pour voir la liste des commandes du bot JARVIS.",
        f"Unknown command `{nom_cmd}`. Type `/help` to see the list of JARVIS bot commands."
    )


@contextlib.contextmanager
def chronometrer(mesures, cle):
    if mesures is None:
        yield
        return
    debut = time.perf_counter()
    try:
        yield
    finally:
        mesures[cle] = round(mesures.get(cle, 0) + (time.perf_counter() - debut) * 1000, 3)


def demander(c, sid, question, chat=False, briefing=False, suivi=True, mesures=None, choix=None):
    """choix : une liste, remplie avec les choix que propose la réponse (issue #7)."""
    if not briefing and not question.strip():
        raise Erreur(T("La question est vide.", "The question is empty."))
    q_propre = question.strip()
    commande = not briefing and q_propre.startswith("/")

    def signaler(evenement, message=""):
        if suivi:
            with chronometrer(mesures, "activity_ms"):
                maj_ile(sid, evenement, chat, message)

    with chronometrer(mesures, "total_ms"), requete_unique(c):
        signaler("debut")
        try:
            with chronometrer(mesures, "request_ms"):
                if commande:
                    texte = executer_commande(c, sid, q_propre)
                elif briefing:
                    texte = texte_sortie(api(c, "/api/briefing", {"force_refresh": False}))
                else:
                    # Le serveur garde son délai à lui (180 s par défaut) si on ne lui donne pas le nôtre : une tâche longue
                    # y était coupée alors qu'on attendait jusqu'à TIMEOUT (issue #6). Il accepte de 5 à 600 s
                    delai = max(5, min(600, round(c["TIMEOUT"])))
                    corps = dict(prompt=question, platform="desktop", user_id=c["USER_ID"], continue_session=True, timeout=delai)
                    # Une conversation par PC pour un même USER_ID (issue #12) ; sans nom d'hôte utilisable, le serveur
                    # se rabat sur USER_ID
                    pc = client_id(c)
                    if pc:
                        corps["client_id"] = pc
                    r = api(c, "/api/ask", corps)
                    texte, proposes = choix_reponse(r, texte_sortie(r))
                    if choix is not None:
                        choix[:] = proposes
        except BaseException:
            signaler("fin")
            raise
        message = T("Commande exécutée", "Command executed") if commande else (T("Briefing prêt", "Briefing ready") if briefing else T("Réponse prête", "Answer ready"))
        signaler("fini", message)
        return texte


def notifier(texte):
    try:
        # Ni shell, ni interprétation du balisage renvoyé par le serveur.
        subprocess.run(["notify-send", "-a", "Assistant", "-i", "dialog-information", "--",
                        T("Briefing du jour", "Daily briefing"), html.escape(texte[:240])],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass  # La réponse reste disponible dans le terminal même sans démon de notifications.


_SYMBOLES_LATEX = {
    "alpha": "α", "beta": "β", "gamma": "γ", "delta": "δ", "epsilon": "ε", "varepsilon": "ε",
    "zeta": "ζ", "eta": "η", "theta": "θ", "vartheta": "ϑ", "iota": "ι", "kappa": "κ",
    "lambda": "λ", "mu": "μ", "nu": "ν", "xi": "ξ", "pi": "π", "rho": "ρ", "sigma": "σ",
    "tau": "τ", "upsilon": "υ", "phi": "φ", "varphi": "ϕ", "chi": "χ", "psi": "ψ", "omega": "ω",
    "Gamma": "Γ", "Delta": "Δ", "Theta": "Θ", "Lambda": "Λ", "Xi": "Ξ", "Pi": "Π", "Sigma": "Σ",
    "Upsilon": "Υ", "Phi": "Φ", "Psi": "Ψ", "Omega": "Ω", "infty": "∞", "partial": "∂",
    "nabla": "∇", "pm": "±", "mp": "∓", "times": "×", "cdot": "·", "div": "÷", "neq": "≠",
    "ne": "≠", "leq": "≤", "le": "≤", "geq": "≥", "ge": "≥", "approx": "≈", "equiv": "≡",
    "sim": "∼", "propto": "∝", "to": "→", "rightarrow": "→", "leftarrow": "←",
    "leftrightarrow": "↔", "Rightarrow": "⇒", "Leftarrow": "⇐", "Leftrightarrow": "⇔",
    "iff": "⟺", "mapsto": "↦", "forall": "∀", "exists": "∃", "nexists": "∄", "in": "∈",
    "notin": "∉", "subset": "⊂", "subseteq": "⊆", "supset": "⊃", "supseteq": "⊇",
    "cup": "∪", "cap": "∩", "emptyset": "∅", "varnothing": "∅", "sum": "∑", "prod": "∏",
    "int": "∫", "iint": "∬", "iiint": "∭", "oint": "∮", "therefore": "∴", "because": "∵",
    "dots": "…", "ldots": "…", "cdots": "⋯", "deg": "°", "circ": "∘", "perp": "⊥",
    "parallel": "∥", "angle": "∠", "triangle": "△", "star": "⋆", "ell": "ℓ", "hbar": "ℏ",
    "Re": "ℜ", "Im": "ℑ", "aleph": "ℵ", "wp": "℘", "land": "∧", "lor": "∨", "neg": "¬",
    "lnot": "¬", "top": "⊤", "bot": "⊥", "models": "⊨", "vdash": "⊢", "oplus": "⊕", "otimes": "⊗",
    "quad": "  ", "qquad": "    ",
}
_EXP_LATEX = str.maketrans({
    "0": "⁰", "1": "¹", "2": "²", "3": "³", "4": "⁴", "5": "⁵", "6": "⁶", "7": "⁷", "8": "⁸", "9": "⁹",
    "+": "⁺", "-": "⁻", "=": "⁼", "(": "⁽", ")": "⁾", "n": "ⁿ", "i": "ⁱ", "a": "ᵃ", "b": "ᵇ", "c": "ᶜ",
    "d": "ᵈ", "e": "ᵉ", "f": "ᶠ", "g": "ᵍ", "h": "ʰ", "j": "ʲ", "k": "ᵏ", "l": "ˡ", "m": "ᵐ", "o": "ᵒ",
    "p": "ᵖ", "r": "ʳ", "s": "ˢ", "t": "ᵗ", "u": "ᵘ", "v": "ᵛ", "w": "ʷ", "x": "ˣ", "y": "ʸ", "z": "ᶻ",
})
_IND_LATEX = str.maketrans({
    "0": "₀", "1": "₁", "2": "₂", "3": "₃", "4": "₄", "5": "₅", "6": "₆", "7": "₇", "8": "₈", "9": "₉",
    "+": "₊", "-": "₋", "=": "₌", "(": "₍", ")": "₎", "a": "ₐ", "e": "ₑ", "h": "ₕ", "i": "ᵢ", "j": "ⱼ",
    "k": "ₖ", "l": "ₗ", "m": "ₘ", "n": "ₙ", "o": "ₒ", "p": "ₚ", "r": "ᵣ", "s": "ₛ", "t": "ₜ", "u": "ᵤ",
    "v": "ᵥ", "x": "ₓ",
})


def formater_commandes_latex(expr):
    s = str(expr or "")
    s = re.sub(r"\\left\s*([(\[{|.])", lambda m: "" if m.group(1) == "." else m.group(1), s)
    s = re.sub(r"\\right\s*([)\]}|.])", lambda m: "" if m.group(1) == "." else m.group(1), s)
    s = re.sub(r"\\(?:text|mathrm|mathbf|mathit|mathsf|mathtt|operatorname)\s*\{([^{}]*)\}", r"\1", s)
    s = re.sub(r"\\mathbb\s*\{([A-Z])\}", lambda m: {"C": "ℂ", "H": "ℍ", "N": "ℕ", "P": "ℙ", "Q": "ℚ", "R": "ℝ", "Z": "ℤ"}.get(m.group(1), m.group(1)), s)
    for _ in range(6):
        n = re.sub(r"\\(?:d|t)?frac\s*\{([^{}]*)\}\s*\{([^{}]*)\}",
                   lambda m: f"{f'({m.group(1)})' if len(m.group(1)) > 1 else m.group(1)}/{f'({m.group(2)})' if len(m.group(2)) > 1 else m.group(2)}", s)
        n = re.sub(r"\\sqrt\s*\[([^\[\]]+)\]\s*\{([^{}]*)\}",
                   lambda m: f"{m.group(1).translate(_EXP_LATEX)}√({m.group(2)})", n)
        n = re.sub(r"\\sqrt\s*\{([^{}]*)\}",
                   lambda m: f"√{m.group(1)}" if len(m.group(1)) <= 1 else f"√({m.group(1)})", n)
        if n == s:
            break
        s = n
    s = re.sub(r"\\begin\{(?:[pbvBV]?matrix|cases|aligned|align\*?|array)\}([\s\S]*?)\\end\{(?:[pbvBV]?matrix|cases|aligned|align\*?|array)\}",
               lambda m: " ; ".join(" ".join(x.strip() for x in l.split("&")) for l in re.split(r"\\\\", m.group(1).strip())), s)
    s = re.sub(r"\\([A-Za-z]+)", lambda m: _SYMBOLES_LATEX.get(m.group(1), m.group(1)), s)
    s = re.sub(r"\^\{([^{}]+)\}", lambda m: m.group(1).translate(_EXP_LATEX) if all(c in "0123456789+-=()niabcdefghjklmoprstuvwxyz" for c in m.group(1)) else f"^({m.group(1)})", s)
    s = re.sub(r"\^([0-9+\-=niabcdefghjklmoprstuvwxyz])", lambda m: m.group(1).translate(_EXP_LATEX), s)
    s = re.sub(r"_\{([^{}]+)\}", lambda m: m.group(1).translate(_IND_LATEX) if all(c in "0123456789+-=()aehijklmnoprstuvx" for c in m.group(1)) else f"_({m.group(1)})", s)
    s = re.sub(r"_([0-9+\-=aehijklmnoprstuvx])", lambda m: m.group(1).translate(_IND_LATEX), s)
    return s.replace(r"\{", "{").replace(r"\}", "}").replace(r"\,", " ").replace(r"\;", " ").replace(r"\!", "").replace("{", "").replace("}", "").strip()


def formater_terminal(texte):
    blocs = []
    s = re.sub(r"```[\s\S]*?```|`[^`\n]+`", lambda m: (blocs.append(m.group(0)), f"\x00CODE{len(blocs) - 1}\x00")[1], str(texte or ""))
    s = re.sub(r"\$\$([\s\S]+?)\$\$", lambda m: "\n  " + formater_commandes_latex(m.group(1)) + "\n", s)
    s = re.sub(r"\\\[([\s\S]+?)\\\]", lambda m: "\n  " + formater_commandes_latex(m.group(1)) + "\n", s)
    s = re.sub(r"\\\(([\s\S]+?)\\\)", lambda m: formater_commandes_latex(m.group(1)), s)
    s = re.sub(r"(?<![\\$\w])\$(?!\s)([^$\n]+?)(?<!\s)\$(?!\d)", lambda m: formater_commandes_latex(m.group(1)), s)
    if re.search(r"\\(?:frac|dfrac|tfrac|sqrt|sum|prod|int|infty|alpha|beta|gamma|delta|pi|theta|lambda|sigma|omega|leq|geq|neq|approx|times|cdot|pm|to|rightarrow|Rightarrow)\b", s):
        s = formater_commandes_latex(s)
    s = re.sub(r"</?(?:b|strong)>", "**", s, flags=re.I)
    s = re.sub(r"</?(?:i|em)>", "*", s, flags=re.I)
    s = re.sub(r"</?code>", "`", s, flags=re.I)
    s = re.sub(r"<br\s*/?>", "\n", s, flags=re.I)
    s = re.sub(r"\x00CODE(\d+)\x00", lambda m: blocs[int(m.group(1))], s)
    return s


def chat(c, question=""):
    sid = uuid.uuid4().hex
    print(T("Assistant distant — exit ou Ctrl+C pour quitter.", "Remote assistant — exit or Ctrl+C to quit."))
    print(T("La connexion sera vérifiée à la première question.", "The connection will be checked on the first question."))
    choix = []
    try:
        while True:
            q = question or input(T("Vous > ", "You > ")).strip()
            question = ""
            if q.lower() in ("exit", "quit", "q"):
                break
            if not q:
                continue
            # Le numéro d'un choix proposé envoie son libellé (issue #7)
            if q.isdigit() and 1 <= int(q) <= len(choix):
                q = choix[int(q) - 1]
                print("→ " + q, flush=True)
            print(T("Réflexion en cours…", "Thinking…"), flush=True)
            choix = []
            try:
                print("\n" + formater_terminal(demander(c, sid, q, chat=True, choix=choix)) + "\n", flush=True)
                if choix:
                    print("\n".join(f"  {i}. {libelle}" for i, libelle in enumerate(choix, 1)))
                    print(T("Tape le numéro d'un choix, ou écris ta réponse.", "Type a choice's number, or write your answer.") + "\n",
                          flush=True)
            except Erreur as e:
                print(str(e), file=sys.stderr)
    finally:
        maj_ile(sid, "fin", chat=True)


def ouvrir(question):
    try:
        subprocess.Popen(["kitty", "--class", "nc-assistant-chat", "--title", T("Assistant personnel", "Personal assistant"),
                          "-e", sys.executable, str(Path(__file__).resolve()), "chat", "--", *question],
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        raise Erreur(T("Kitty est nécessaire pour ouvrir le chat.", "Kitty is required to open the chat.")) from None


def ia_du_bureau():
    """nc-ia (même dossier) comme module, ou None s'il manque."""
    try:
        import importlib.machinery
        import importlib.util
        l = importlib.machinery.SourceFileLoader("nc_ia", str(Path(__file__).resolve().parent / "nc-ia"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader("nc_ia", l))
        l.exec_module(m)
        return m
    except (OSError, SyntaxError, ImportError):
        return None


def repondre_par_ia(ia, historique, question, echec_jarvis=None):
    """echec_jarvis : JARVIS a échoué en mode automatique ; l'IA du bureau répond, et c'est dit en tête (issue #4)."""
    try:
        texte, qui = ia.chat(historique, question)
    except ia.ErreurIA as e:
        conseil = "" if CONF.exists() or "nc-assistant configurer" in str(e) else \
            T(" Pour JARVIS : nc-assistant configurer.", " For JARVIS: nc-assistant configurer.")
        raise Erreur(str(e) + conseil) from None
    avis = list(getattr(ia, "RELAIS", []))
    if echec_jarvis is not None:
        raison = re.sub(r"\s+", " ", str(echec_jarvis)).strip()[:90]
        avis = [T(f"⚠ JARVIS n'a pas répondu — {raison} : {ia.nom(qui)} prend le relais.",
                  f"⚠ JARVIS did not answer — {raison}: {ia.nom(qui)} takes over.")]
    texte = ("\n\n".join(avis) + "\n\n" if avis else "") + texte[:15900] + f"\n\n*— {ia.nom(qui)}*"
    print(json.dumps(dict(ok=True, text=texte, truncated=False, engine=ia.nom(qui)), ensure_ascii=False), flush=True)


def requete_ile():
    # Une ligne JSON sur stdin : la question ne figure ni dans argv ni dans un fichier.
    try:
        ligne = sys.stdin.buffer.readline(65537)
        if len(ligne) > 65536:
            raise ValueError
        r = json.loads(ligne)
        if not isinstance(r, dict):
            raise ValueError
        sid, question = r.get("session_id"), r.get("question")
        if (not isinstance(sid, str) or not re.fullmatch(r"[a-f0-9]{32}", sid)
                or not isinstance(question, str) or not question.strip() or len(question) > 8000):
            raise ValueError
    except (ValueError, UnicodeError):
        raise Erreur(T("Question invalide ou trop longue (8 000 caractères maximum).",
                       "Invalid question or too long (8,000 characters maximum).")) from None
    historique = r.get("historique") if isinstance(r.get("historique"), list) else []
    # JARVIS répond s'il est relié, sauf si une autre IA est choisie à la main (nc-reglages → Intelligence artificielle) ;
    # sinon, ou s'il est injoignable en mode automatique, l'IA du bureau (nc-ia) répond à sa place
    ia = ia_du_bureau()
    commande = question.lstrip().startswith("/")
    choix = ia.ANCIENS.get(ia.reglage("IA_CHOIX", "claude"), ia.reglage("IA_CHOIX", "claude")) if ia else ""
    par_jarvis = CONF.exists() and not (ia and ia.mode() == "manuel" and choix in ia.FOURNISSEURS and choix != "jarvis")
    # La suite d'une réponse donnée par l'IA du bureau (capture, fichier, texte… versés dans le chat) : la même IA, avec
    # le contexte, plutôt que JARVIS qui ne l'a pas vue
    if ia and not commande and (not par_jarvis or r.get("ia_du_bureau") is True):
        return repondre_par_ia(ia, historique, question)
    proposes = []
    try:
        # AssistantEtat suit déjà cette demande : aucun hook Coucou à attendre avant/après HTTP.
        texte = demander(configuration_question(question), sid, question, suivi=False, choix=proposes)
    except Erreur as e:
        if ia and par_jarvis and not commande and ia.mode() == "auto" and [i for i in ia.candidats("question") if i != "jarvis"]:
            return repondre_par_ia(ia, historique, question, echec_jarvis=e)
        raise
    # Bornes adaptées au rendu QML ; le client terminal conserve la réponse complète. choices : boutons de l'île (issue #7)
    ligne = dict(ok=True, text=texte[:16000], truncated=len(texte) > 16000)
    if proposes:
        ligne["choices"] = proposes
    print(json.dumps(ligne, ensure_ascii=False), flush=True)


def main():
    parser = argparse.ArgumentParser(description=T(__doc__, DOC_EN), formatter_class=argparse.RawDescriptionHelpFormatter)
    sous = parser.add_subparsers(dest="commande")
    p = sous.add_parser("configurer", aliases=["configure"])
    p.add_argument("--terminal", action="store_true", help=T("Questions dans le terminal plutôt que la fenêtre", "Terminal prompts instead of the window"))
    p = sous.add_parser("config-ile", help=argparse.SUPPRESS)
    p.add_argument("action", choices=["lire", "tester", "enregistrer"])
    for nom in ("ouvrir", "chat", "demander"):
        p = sous.add_parser(nom)
        p.add_argument("question", nargs="*")
        if nom == "demander":
            p.add_argument("--flux", action="store_true")
            p.add_argument("--mesurer", "--timings", action="store_true", help=T("Mesures de durée sur stderr (JSON, sans requête supplémentaire)", "Timings on stderr (JSON, no extra request)"))
    sous.add_parser("briefing")
    sous.add_parser("requete-ile", help=argparse.SUPPRESS)
    p = sous.add_parser("rappel-notifier", help=argparse.SUPPRESS)
    p.add_argument("ident")
    p = sous.add_parser("verifier", aliases=["check", "diagnostic"])
    p.add_argument("--json", action="store_true")
    p = sous.add_parser("etat", aliases=["status"])
    p.add_argument("--local", action="store_true")
    a = parser.parse_args()
    commande = a.commande or "chat"
    flux = getattr(a, "flux", False)
    try:
        if commande in ("configurer", "configure"):
            configurer(getattr(a, "terminal", False))
        elif commande == "config-ile":
            return configuration_ile(a.action)
        elif commande in ("ouvrir", "chat", "demander", "briefing", "requete-ile") and ia_coupee():
            raise Erreur(message_ia_coupee())
        elif commande == "ouvrir":
            ouvrir(a.question)
        elif commande == "requete-ile":
            requete_ile()
        elif commande == "rappel-notifier":
            notifier_rappel(a.ident)
        else:
            if commande == "chat" and not CONF.exists() and sys.stdin.isatty():
                configurer()
            c = configuration_question(" ".join(a.question)) if commande == "demander" else configuration()
            if commande in ("verifier", "check", "diagnostic"):
                return verifier(c, getattr(a, "json", False))
            if commande in ("etat", "status"):
                if a.local:
                    print(json.dumps({"configured": True, "checked": False}))
                else:
                    r = api(c, "/api/status")
                    if r.get("online") is False or r.get("runner_alive") is False:
                        raise Erreur(T("Le serveur ou son moteur est indisponible.", "The server or its runner is unavailable."))
                    print(json.dumps({"online": True, "checked": True, "runner_alive": r.get("runner_alive")}))
            elif commande == "chat":
                chat(c, " ".join(getattr(a, "question", [])))
            else:
                mesures = {} if getattr(a, "mesurer", False) else None
                proposes = []                          # choix proposés par JARVIS (issue #7) : en flux, pour le Spotlight
                try:
                    t = demander(c, uuid.uuid4().hex, " ".join(getattr(a, "question", [])), briefing=commande == "briefing",
                                 mesures=mesures, choix=proposes)
                finally:
                    if mesures:
                        print(json.dumps({"timings_ms": mesures}), file=sys.stderr, flush=True)
                ligne = {"t": t, "choices": proposes} if proposes else {"t": t}
                print(json.dumps(ligne, ensure_ascii=False) if flux else t, flush=True)
                if commande == "briefing":
                    notifier(t)
        return 0
    except (Erreur, OSError) as e:
        if isinstance(e, BrokenPipeError):
            return 1
        message = str(e) if isinstance(e, Erreur) else T("Erreur locale : vérifie les droits et l'espace disque.",
                                                                      "Local error: check permissions and disk space.")
        if commande == "requete-ile":
            print(json.dumps({"ok": False, "error": message}, ensure_ascii=False), flush=True)
        elif commande in ("etat", "status"):
            resultat = {"online": False, "error": message}
            try:
                if hote_prive(configuration()["URL"]):
                    resultat["private"] = True
                    resultat["hint"] = T(
                        "URL locale/privée : utilise l'URL HTTPS d'un tunnel depuis un autre réseau.",
                        "Local/private URL: use a tunnel's HTTPS URL from another network.")
            except (Erreur, OSError):
                pass
            print(json.dumps(resultat, ensure_ascii=False))
        elif commande in ("verifier", "check", "diagnostic") and getattr(a, "json", False):
            print(json.dumps({"configured": False, "online": False, "error": message}, ensure_ascii=False))
        elif flux:
            print(json.dumps({"t": message}, ensure_ascii=False), flush=True)
        else:
            print(message, file=sys.stderr)
        return 1
    except (KeyboardInterrupt, EOFError):
        return 130


def interrompre(*_):
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrompre)
    sys.exit(main())
