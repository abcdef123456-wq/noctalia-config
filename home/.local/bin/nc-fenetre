#!/usr/bin/env bash
# nc-fenetre : réduire une fenêtre (comme le « _ » de Windows) et la ramener. Hyprland n'a pas de fenêtres réduites :
# elles vont dans un bureau caché, « special:reduites », et reviennent sur le bureau affiché.
#   nc-fenetre reduire [ADRESSE]     réduit la fenêtre active (ou celle-là)                  Super + M
#   nc-fenetre restaurer [ADRESSE]   ramène la dernière fenêtre réduite (ou celle-là)        Super + Ctrl + M
#   nc-fenetre aller ADRESSE         va sur une fenêtre ; réduite, elle est d'abord ramenée (Spotlight, vue des fenêtres)
#   nc-fenetre basculer ADRESSE      la masque, ou la ramène si elle l'est (barre : nc/fenetres)
#   nc-fenetre fermer ADRESSE        la ferme
#   nc-fenetre tout-masquer          masque toutes les fenêtres du bureau affiché
#   nc-fenetre tout-afficher         ramène toutes les fenêtres masquées sur le bureau affiché
#   nc-fenetre etat                  le bureau affiché, ses fenêtres et les masquées, en JSON (barre : nc/fenetres)
#   nc-fenetre suivre                une ligne à chaque changement de fenêtres dans Hyprland (barre : nc/fenetres)
# Une fenêtre réduite qu'on active autrement (dock, Alt + Tab) revient aussi d'elle-même (nc/automatismes.lua).
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
pile="${XDG_RUNTIME_DIR:-/tmp}/nc-reduites"
CACHE="special:reduites"

clients() { hyprctl clients -j 2>/dev/null; }
bureau_de() { clients | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.name' | head -1; }
eval_lua() { hyprctl dispatch "$1" >/dev/null 2>&1; }

action="${1:-}"
# Noms anglais des actions (nc-window minimize | restore | goto)
case "$action" in minimize|hide) action=reduire ;; restore|show) action=restaurer ;; goto|go) action=aller ;; toggle) action=basculer ;;
  close) action=fermer ;; hide-all) action=tout-masquer ;; show-all) action=tout-afficher ;; state) action=etat ;; watch) action=suivre ;; esac
# Bureau affiché sur l'écran actif
bureau_actif() { hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .activeWorkspace.id' | head -1; }

case "$action" in
  reduire)
    a="${2:-$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')}"
    [ -n "$a" ] && [ "$a" != null ] || exit 0
    [ "$(bureau_de "$a")" = "$CACHE" ] && exit 0
    eval_lua "hl.dsp.window.move({ workspace = '$CACHE', follow = false, window = 'address:$a' })"
    { grep -vx "$a" "$pile" 2>/dev/null; echo "$a"; } > "$pile.tmp"; mv "$pile.tmp" "$pile" ;;
  basculer)
    a="${2:-}"; [ -n "$a" ] || exit 0
    if [ "$(bureau_de "$a")" = "$CACHE" ]; then exec "$0" aller "$a"; else exec "$0" reduire "$a"; fi ;;
  fermer)
    [ -n "${2:-}" ] && eval_lua "hl.dsp.window.close({ window = 'address:$2' })" ;;
  tout-masquer)
    ws="$(bureau_actif)"
    clients | jq -r --argjson w "${ws:-0}" '.[] | select(.workspace.id == $w) | .address' | while read -r a; do "$0" reduire "$a"; done ;;
  tout-afficher)
    clients | jq -r --arg c "$CACHE" '.[] | select(.workspace.name == $c) | .address' | while read -r a; do "$0" aller "$a"; done ;;
  etat)
    ws="$(bureau_actif)"
    actif="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""')"
    clients | jq -c --argjson w "${ws:-0}" --arg c "$CACHE" --arg actif "$actif" '
      def f: { adresse: .address, classe: (.class // ""), titre: (.title // ""), active: (.address == $actif) };
      { bureau: $w,
        fenetres: [.[] | select(.workspace.id == $w and .mapped != false)] | sort_by(.at[0], .at[1]) | map(f),
        masquees: [.[] | select(.workspace.name == $c)] | map(f) }' ;;
  suivre)
    # Les événements de Hyprland (socket2) qui changent la liste ; une ligne au plus toutes les 150 ms
    exec python3 -u - <<'PY'
import os, socket, sys, time, glob
run = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
socks = [f"{run}/hypr/{sig}/.socket2.sock"] if sig else []
socks += sorted(glob.glob(f"{run}/hypr/*/.socket2.sock"), key=os.path.getmtime, reverse=True)
EV = (b"openwindow", b"closewindow", b"movewindow", b"activewindow", b"workspace", b"focusedmon", b"windowtitle", b"changefloatingmode")
for chemin in socks:
    try:
        s = socket.socket(socket.AF_UNIX); s.connect(chemin); break
    except OSError:
        continue
else:
    sys.exit(1)
print("pret", flush=True)
reste, dernier = b"", 0.0
while True:
    d = s.recv(4096)
    if not d:
        sys.exit(0)
    lignes = (reste + d).split(b"\n"); reste = lignes.pop()
    if any(l.startswith(EV) for l in lignes) and time.time() - dernier > 0.15:
        dernier = time.time(); print("x", flush=True)
PY
    ;;
  restaurer|aller)
    a="${2:-}"
    if [ -z "$a" ]; then                                  # la dernière réduite encore là
      reduites="$(clients | jq -r --arg c "$CACHE" '.[] | select(.workspace.name == $c) | .address')"
      a="$(tac "$pile" 2>/dev/null | grep -xF -f <(printf '%s\n' "$reduites") | head -1)"
      [ -n "$a" ] || a="$(printf '%s\n' "$reduites" | head -1)"
      [ -n "$a" ] || exit 0
    fi
    if [ "$(bureau_de "$a")" = "$CACHE" ]; then
      # Bureau affiché sur l'écran actif (pas le bureau caché, s'il est ouvert)
      ws="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.id' | head -1)"
      ouvert="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .specialWorkspace.name' | head -1)"
      [ "$ouvert" = "$CACHE" ] && eval_lua "hl.dsp.workspace.toggle_special('reduites')"
      eval_lua "hl.dsp.window.move({ workspace = ${ws:-1}, follow = true, window = 'address:$a' })"
      grep -vx "$a" "$pile" > "$pile.tmp" 2>/dev/null; mv -f "$pile.tmp" "$pile" 2>/dev/null
    fi
    eval_lua "hl.dsp.focus({ window = 'address:$a' })" ;;
  *)
    if [ "${NC_LANGUE:-fr}" = en ]; then
      cat <<'FIN'
nc-window: minimize a window (like the "_" button on Windows) and bring it back. Hyprland has no minimized windows:
they go to a hidden workspace, "special:reduites", and come back to the visible workspace.
  nc-window minimize [ADDRESS]   minimizes the active window (or that one)               Super + M
  nc-window restore [ADDRESS]    brings back the last minimized window (or that one)     Super + Ctrl + M
  nc-window goto ADDRESS         goes to a window; if minimized, it is restored first (Spotlight, window overview)
  nc-window toggle ADDRESS       hides it, or brings it back if hidden (bar: nc/fenetres)
  nc-window close ADDRESS        closes it
  nc-window hide-all             hides every window of the visible workspace
  nc-window show-all             brings every hidden window back to the visible workspace
  nc-window state                the visible workspace, its windows and the hidden ones, as JSON (bar: nc/fenetres)
  nc-window watch                one line each time Hyprland's windows change (bar: nc/fenetres)
A minimized window activated another way (dock, Alt + Tab) also comes back on its own (nc/automatismes.lua).
FIN
    else
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    fi ;;
esac
