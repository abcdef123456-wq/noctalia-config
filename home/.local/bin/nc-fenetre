#!/usr/bin/env bash
# nc-fenetre : réduire une fenêtre (comme le « _ » de Windows) et la ramener. Hyprland n'a pas de fenêtres réduites :
# elles vont dans un bureau caché, « special:reduites », et reviennent sur le bureau affiché.
#   nc-fenetre reduire [ADRESSE]     réduit la fenêtre active (ou celle-là)                  Super + M
#   nc-fenetre restaurer [ADRESSE]   ramène la dernière fenêtre réduite (ou celle-là)        Super + Ctrl + M
#   nc-fenetre aller ADRESSE [BUREAU] va sur une fenêtre ; réduite, elle est d'abord ramenée (sur BUREAU, sinon le bureau
#                                    affiché ; Spotlight, vue des fenêtres)
#   nc-fenetre basculer ADRESSE      la masque, ou la ramène si elle l'est (barre : nc/fenetres)
#   nc-fenetre outil TITRE           fenêtre-outil de l'île (réglages, cockpit, chat JARVIS) : sur un autre bureau ou
#                                    masquée, ramenée sur le bureau affiché ; ici sans le focus, le prend ; ici et
#                                    active, masquée (forme gardée : rangée ou libre) ; absente, code 3
#   nc-fenetre fermer ADRESSE        la ferme
#   nc-fenetre tout-masquer          masque toutes les fenêtres du bureau affiché
#   nc-fenetre reduire-lot JSON      masque un lot avec ses géométries prises avant tout déplacement (vue)
#   nc-fenetre tout-afficher         ramène toutes les fenêtres masquées sur le bureau affiché
#   nc-fenetre plein-masquer ADRESSE masque les autres fenêtres du bureau de celle-là (pas les épinglées), pour un plein
#                                    écran qui masque ; la liste est notée dans $XDG_RUNTIME_DIR/nc-reduites-plein
#   nc-fenetre plein-rendre ADRESSE  ramène sur leur bureau d'origine les fenêtres masquées par celle-là
#   nc-fenetre etat                  chaque écran, son bureau et ses fenêtres, et les masquées, en JSON (barre : nc/fenetres)
#   nc-fenetre suivre                le même état, réécrit à chaque changement (une ligne de JSON ; barre : nc/fenetres)
# Une fenêtre réduite qu'on active autrement (dock, Alt + Tab) revient aussi d'elle-même (nc/automatismes.lua).
# Une fenêtre masquée par un plein écran qui masque, rappelée (aller), fait quitter le maximisé à son propriétaire :
# toutes ses masquées reviennent.
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
# Dans le dossier de la session (privé, 0700), jamais dans /tmp : un autre utilisateur y poserait un lien ou un fichier
# à ce nom. Sans XDG_RUNTIME_DIR, les actions qui en ont besoin s'arrêtent (voir plus bas) ; l'aide reste possible
pile="${XDG_RUNTIME_DIR:-}/nc-reduites"
# Une ligne par propriétaire d'un plein écran qui masque : « ADRESSE BUREAU a1 a2 … »
plein="${XDG_RUNTIME_DIR:-}/nc-reduites-plein"
CACHE="special:reduites"

clients() { hyprctl clients -j 2>/dev/null; }
bureau_de() { clients | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.name' | head -1; }
eval_lua() { hyprctl dispatch "$1" >/dev/null 2>&1; }

action="${1:-}"
# Noms anglais des actions (nc-window minimize | restore | goto)
case "$action" in minimize|hide) action=reduire ;; restore|show) action=restaurer ;; goto|go) action=aller ;; toggle) action=basculer ;;
  close) action=fermer ;; tool) action=outil ;; hide-all) action=tout-masquer ;; show-all) action=tout-afficher ;; state) action=etat ;; watch) action=suivre ;; esac
case "$action" in fullscreen-hide) action="plein-masquer" ;; fullscreen-restore) action="plein-rendre" ;; esac
# La fermeture de la vue lance plusieurs masquages en parallèle. Ils partageaient le même fichier .tmp : une
# écriture pouvait effacer la géométrie d'une autre fenêtre, qui réapparaissait mal placée à la prochaine ouverture.
# Même verrou à la restauration, qui retire une entrée des mêmes fichiers.
case "$action" in
  reduire|reduire-lot|tout-masquer|restaurer|aller|plein-masquer|plein-rendre)
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
      echo "nc-fenetre: $(t "XDG_RUNTIME_DIR n'est pas défini (pas de session ouverte ?)" "XDG_RUNTIME_DIR is not set (no login session?)")" >&2
      exit 1
    fi
    exec 9>"$pile.lock"
    # Attente bornée : un autre nc-fenetre bloqué ne fige pas celui-ci (et la vue, la barre) pour toujours
    flock -w 5 -x 9 || exit 1
    ;;
esac
# Fondu au lieu du glissement de Hyprland (une fenêtre floutée qui glisse hors de l'écran saccade sur un petit GPU) :
# elle s'efface, part sans animation, puis retrouve son opacité une fois cachée
prop() { eval_lua "hl.dsp.window.set_prop({ prop = '$2', value = '$3', window = 'address:$1' })"; }
# Bureau affiché sur l'écran actif
bureau_actif() { hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .activeWorkspace.id' | head -1; }

# Un seul instantané pour tout le lot : les fenêtres suivantes ne doivent pas être mesurées après le retiling.
geometries() {
  local fenetres moniteurs
  fenetres="$(clients)" || return 1
  moniteurs="$(hyprctl monitors -j 2>/dev/null)" || return 1
  jq --argjson ms "$moniteurs" '[.[] | . as $c |
    ($ms | map(select(.id == $c.monitor)) | .[0] // {}) as $m |
    {address, x: .at[0], y: .at[1], w: .size[0], h: .size[1], ws: .workspace.id, fl: .floating,
     mx: ($m.x // 0), my: ($m.y // 0),
     mw: (((if (($m.transform // 0) % 2) == 1 then $m.height else $m.width end) // 0) / ($m.scale // 1)),
     mh: (((if (($m.transform // 0) % 2) == 1 then $m.width else $m.height end) // 0) / ($m.scale // 1))}]' <<< "$fenetres"
}

reduire_lot() {
  local lignes a x y w h ws fl mx my mw mh courant statut=0
  # Aucune chaîne de l'appelant ne doit pouvoir être interprétée comme du Lua.
  lignes="$(jq -er 'if type != "array" then error("expected array") else . end |
    .[] | select(.address | type == "string" and test("^0x[0-9a-fA-F]+$")) |
    select([.x,.y,.w,.h,.ws] | all(.[]; type == "number")) |
    select(.w > 0 and .h > 0 and .ws > 0 and .ws == (.ws | floor)) |
    [.address,.x,.y,.w,.h,.ws,(.fl == true),(.mx // 0),(.my // 0),(.mw // 0),(.mh // 0)] | @tsv' <<< "$1")" || return 1
  while read -r a x y w h ws fl mx my mw mh; do
    [ -n "$a" ] || continue
    # Fermée ou déjà masquée entre le clic et la fermeture de la vue : ne pas créer d'entrée fantôme.
    courant="$(bureau_de "$a")"
    [ -n "$courant" ] && [ "$courant" != "$CACHE" ] || continue
    prop "$a" opacity 0; sleep 0.14
    prop "$a" no_anim 1
    if eval_lua "hl.dsp.window.move({ workspace = '$CACHE', follow = false, window = 'address:$a' })" && [ "$(bureau_de "$a")" = "$CACHE" ]; then
      { grep -v "^$a " "$pile-tailles" 2>/dev/null; echo "$a $x $y $w $h $ws $fl $mx $my $mw $mh"; } > "$pile-tailles.tmp" &&
        mv -f "$pile-tailles.tmp" "$pile-tailles" || statut=1
      { grep -vx "$a" "$pile" 2>/dev/null; echo "$a"; } > "$pile.tmp" && mv -f "$pile.tmp" "$pile" || statut=1
    else
      echo "nc-fenetre: $(t "masquage impossible" "cannot hide") : $a" >&2
      statut=1
    fi
    prop "$a" no_anim 0; prop "$a" opacity 1
  done <<< "$lignes"
  return "$statut"
}

# Sort une fenêtre du bureau caché et la remet sur le bureau $2 (fondu, sans glisser) ; efface ses entrées de pile.
# $3 = true : le bureau affiché suit la fenêtre (rappel à la main) ; false : elle revient sans qu'on la suive
sortir_du_cache() {
  local a="$1" ws="$2" suivre="${3:-true}"
  prop "$a" opacity 0; prop "$a" no_anim 1
  if ! eval_lua "hl.dsp.window.move({ workspace = ${ws:-1}, follow = $suivre, window = 'address:$a' })" ||
      [ "$(clients | jq -r --arg a "$a" '.[] | select(.address == $a) | .workspace.id')" != "$ws" ]; then
    prop "$a" no_anim 0; prop "$a" opacity 1
    return 1
  fi
  grep -v "^$a " "$pile-tailles" > "$pile-tailles.tmp" 2>/dev/null; mv -f "$pile-tailles.tmp" "$pile-tailles" 2>/dev/null
  prop "$a" no_anim 0; prop "$a" opacity 1
  grep -vx "$a" "$pile" > "$pile.tmp" 2>/dev/null; mv -f "$pile.tmp" "$pile" 2>/dev/null
  return 0
}

# Plein écran qui masque : masque les autres fenêtres du bureau de $1 (sauf les épinglées) et note la liste.
plein_masquer() {
  local p="$1" ws instantane lot cibles a notees=""
  plein_rendre "$p"                                     # reste d'un masquage précédent : d'abord tout remis
  ws="$(clients | jq -r --arg a "$p" '.[] | select(.address == $a and .workspace.id > 0) | .workspace.id' | head -1)"
  [[ "$ws" =~ ^[1-9][0-9]*$ ]] || return 0              # absente ou déjà masquée : rien à faire
  cibles="$(clients | jq -r --arg a "$p" --argjson w "$ws" \
    '.[] | select(.workspace.id == $w and .address != $a and (.pinned | not)) | .address')" || return 1
  [ -n "$cibles" ] || return 0
  instantane="$(geometries)" || return 1
  lot="$(jq --argjson w "$ws" --arg a "$p" --arg c "$cibles" \
    '($c | split("\n")) as $l | map(select(.ws == $w and (.address as $x | $l | index($x))))' <<< "$instantane")" || return 1
  [ "$lot" != '[]' ] || return 0
  reduire_lot "$lot"; local statut=$?
  # Seules celles qui sont vraiment dans le bureau caché sont notées (une fermée entre-temps ne l'est pas)
  while read -r a; do
    [[ "$a" =~ ^0x[0-9a-fA-F]+$ ]] || continue
    [ "$(bureau_de "$a")" = "$CACHE" ] && notees="$notees $a"
  done <<< "$cibles"
  if [ -n "$notees" ]; then
    { grep -v "^$p " "$plein" 2>/dev/null; echo "$p $ws$notees"; } > "$plein.tmp" && mv -f "$plein.tmp" "$plein" || return 1
  fi
  return "$statut"
}

# Plein écran qui masque : remet sur leur bureau d'origine les fenêtres de $1 encore masquées ; retire sa ligne.
plein_rendre() {
  local p="$1" ligne ws a statut=0 reste
  [ -s "$plein" ] || return 0
  ligne="$(grep -m1 "^$p " "$plein")" || return 0
  { grep -v "^$p " "$plein"; true; } > "$plein.tmp" 2>/dev/null && mv -f "$plein.tmp" "$plein"
  [ -s "$plein" ] || rm -f "$plein"
  read -r _ ws reste <<< "$ligne"
  [[ "$ws" =~ ^[1-9][0-9]*$ ]] || return 1
  for a in $reste; do
    [[ "$a" =~ ^0x[0-9a-fA-F]+$ ]] || continue          # une valeur lue n'est jamais collée sans contrôle
    # Fermée pendant le masquage, ou déjà rappelée à la main : rien à faire, sans erreur
    [ "$(bureau_de "$a")" = "$CACHE" ] || continue
    sortir_du_cache "$a" "$ws" false || statut=1
  done
  return "$statut"
}

# Le propriétaire (adresse) dont la ligne de plein écran qui masque contient $1, s'il y en a un
proprietaire_de() {
  [ -s "$plein" ] || return 1
  awk -v a="$1" '{ for (i = 3; i <= NF; i++) if ($i == a) { print $1; exit } }' "$plein" | grep -m1 -E '^0x[0-9a-fA-F]+$'
}

case "$action" in
  reduire)
    a="${2:-$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')}"
    [ -n "$a" ] && [ "$a" != null ] || exit 0
    instantane="$(geometries)" || exit 1
    lot="$(jq --arg a "$a" 'map(select(.address == $a and .ws > 0))' <<< "$instantane")" || exit 1
    [ "$lot" != '[]' ] || exit 0
    reduire_lot "$lot" ;;
  reduire-lot)
    reduire_lot "${2:-[]}" ;;
  basculer)
    a="${2:-}"; [ -n "$a" ] || exit 0
    if [ "$(bureau_de "$a")" = "$CACHE" ]; then exec "$0" aller "$a"; else exec "$0" reduire "$a"; fi ;;
  fermer)
    [ -n "${2:-}" ] || exit 1
    [[ "$2" =~ ^0x[0-9a-fA-F]+$ ]] || exit 2
    eval_lua "hl.dsp.window.close({ window = 'address:$2' })" ;;
  tout-masquer)
    ws="$(bureau_actif)"
    instantane="$(geometries)" || exit 1
    lot="$(jq --argjson w "${ws:-0}" 'map(select(.ws == $w))' <<< "$instantane")" || exit 1
    [ "$lot" != '[]' ] || exit 0
    reduire_lot "$lot" ;;
  plein-masquer|plein-rendre)
    a="${2:-}"
    [[ "$a" =~ ^0x[0-9a-fA-F]+$ ]] || exit 2
    if [ "$action" = plein-masquer ]; then plein_masquer "$a"; else plein_rendre "$a"; fi ;;
  tout-afficher)
    clients | jq -r --arg c "$CACHE" '.[] | select(.workspace.name == $c) | .address' | while read -r a; do "$0" aller "$a"; done ;;
  etat|suivre)
    # État lu directement sur les sockets de Hyprland (pas de hyprctl ni de jq) : pour chaque écran, son bureau affiché
    # et ses fenêtres (de gauche à droite), plus les masquées. « suivre » le réécrit à chaque changement, une ligne de
    # JSON seulement quand il a changé, une fois la rafale d'événements passée (ouvrir une fenêtre en envoie plusieurs).
    exec python3 -u - "$action" "$CACHE" <<'PY'
import glob, json, os, select, socket, sys, time
mode, cache = sys.argv[1], sys.argv[2]
run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
dossiers = ([f"{run}/hypr/{sig}"] if sig else []) + sorted(glob.glob(f"{run}/hypr/*"), key=os.path.getmtime, reverse=True)
dossier = next((d for d in dossiers if os.path.exists(f"{d}/.socket.sock")), None)
if not dossier:
    sys.exit(1)

def demander(cmd):
    with socket.socket(socket.AF_UNIX) as c:
        c.connect(f"{dossier}/.socket.sock"); c.sendall(cmd.encode())
        morceaux = []
        while d := c.recv(65536):
            morceaux.append(d)
    return json.loads(b"".join(morceaux) or b"null")

def etat():
    clients, ecrans = demander("j/clients") or [], demander("j/monitors") or []
    actif = (demander("j/activewindow") or {}).get("address", "")
    def f(c):
        return {"adresse": c["address"], "classe": c.get("class") or c.get("initialClass") or "",
                "titre": c.get("title") or "", "active": c["address"] == actif}
    visibles = [c for c in clients if c.get("mapped", True) and not c.get("hidden")]
    moniteurs = {}
    for m in ecrans:
        ws = (m.get("activeWorkspace") or {}).get("id")
        moniteurs[m["name"]] = {"bureau": ws, "fenetres": [f(c) for c in sorted(
            (c for c in visibles if c["workspace"]["id"] == ws), key=lambda c: (c["at"][0], c["at"][1]))]}
    focus = next((m["name"] for m in ecrans if m.get("focused")), ecrans[0]["name"] if ecrans else "")
    return {"focus": focus, "actif": actif, "moniteurs": moniteurs,
            "masquees": [f(c) for c in visibles if c["workspace"]["name"] == cache]}

def ecrire(e):
    # Compatibilité : bureau et fenêtres de l'écran actif à la racine aussi
    m = e["moniteurs"].get(e["focus"], {"bureau": 0, "fenetres": []})
    print(json.dumps({**e, "bureau": m["bureau"], "fenetres": m["fenetres"]}, ensure_ascii=False, separators=(",", ":")))

if mode == "etat":
    ecrire(etat()); sys.exit(0)

EV = (b"openwindow>>", b"closewindow>>", b"movewindow", b"activewindow>>", b"workspace", b"focusedmon",
      b"windowtitle", b"changefloatingmode", b"monitoradded", b"monitorremoved", b"urgent")
ev = socket.socket(socket.AF_UNIX); ev.connect(f"{dossier}/.socket2.sock")
precedent, reste = None, b""
while True:
    e = etat()
    if e != precedent:
        ecrire(e); precedent = e
    # Attendre un événement utile, puis la fin de la rafale (60 ms de calme, 300 ms au plus)
    utile, debut = False, None
    while True:
        attente = None if not utile else max(0, min(0.06, debut + 0.3 - time.time()))
        if not select.select([ev], [], [], attente)[0]:
            if utile:
                break
            continue
        d = ev.recv(65536)
        if not d:
            sys.exit(0)
        lignes = (reste + d).split(b"\n"); reste = lignes.pop()
        if any(l.startswith(EV) for l in lignes) and not utile:
            utile, debut = True, time.time()
PY
    ;;
  outil)
    # Les fenêtres de l'île n'ont qu'un titre pour se distinguer (classe org.quickshell commune)
    titre="${2:-}"; [ -n "$titre" ] || exit 2
    a="$(clients | jq -r --arg t "$titre" '[.[] | select(.class == "org.quickshell" and .title == $t)][0].address // empty')"
    [ -n "$a" ] || exit 3
    ici="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .activeWorkspace.id' | head -1)"
    [[ "$ici" =~ ^[1-9][0-9]*$ ]] || exit 1
    la="$(clients | jq -r --arg a "$a" '.[] | select(.address == $a) | .workspace.name')"
    # Venu du clavier : le pointeur suit la fenêtre (remis à sa place, il rendrait le focus à la fenêtre d'en dessous
    # quand « la fenêtre sous le pointeur devient active »)
    export NC_FENETRE_POINTEUR=suivre
    if [ "$la" = "$CACHE" ]; then exec "$0" aller "$a"; fi            # masquée : revient ici, en fondu
    if [ "$la" = "$ici" ]; then
      actif="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')"
      if [ "$actif" = "$a" ]; then exec "$0" reduire "$a"; fi       # ici et active : rangée
      exec "$0" aller "$a"                                         # ici, derrière : au premier plan
    fi
    # Sur un autre bureau : amenée sur le bureau affiché, en fondu, sans y emmener la vue
    prop "$a" opacity 0; prop "$a" no_anim 1
    eval_lua "hl.dsp.window.move({ workspace = $ici, follow = false, window = 'address:$a' })"
    prop "$a" no_anim 0; prop "$a" opacity 1
    exec "$0" aller "$a" ;;
  restaurer|aller)
    a="${2:-}"
    if [ -z "$a" ]; then                                  # la dernière réduite encore là
      reduites="$(clients | jq -r --arg c "$CACHE" '.[] | select(.workspace.name == $c) | .address')"
      a="$(tac "$pile" 2>/dev/null | grep -xF -f <(printf '%s\n' "$reduites") | head -1)"
      [ -n "$a" ] || a="$(printf '%s\n' "$reduites" | head -1)"
      [ -n "$a" ] || exit 0
    fi
    [[ "$a" =~ ^0x[0-9a-fA-F]+$ ]] || exit 1
    # Masquée par un plein écran qui masque : son propriétaire quitte le maximisé, toutes ses masquées reviennent
    # (leur bureau d'origine, qui est aussi celui du propriétaire, prend alors la main avec le focus plus bas)
    if prop_a="$(proprietaire_de "$a")"; then
      eval_lua "hl.dsp.window.fullscreen({ action = 'unset', mode = 'maximized', window = 'address:$prop_a' })"
      eval_lua "hl.dsp.window.fullscreen({ action = 'unset', mode = 'fullscreen', window = 'address:$prop_a' })"
      plein_rendre "$prop_a"
    fi
    if [ "$(bureau_de "$a")" = "$CACHE" ]; then
      # Bureau affiché sur l'écran actif (pas le bureau caché, s'il est ouvert)
      ws="${3:-$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.id' | head -1)}"
      [[ "$ws" =~ ^[1-9][0-9]*$ ]] || exit 1
      ouvert="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .specialWorkspace.name' | head -1)"
      [ "$ouvert" = "$CACHE" ] && eval_lua "hl.dsp.workspace.toggle_special('reduites')"
      # Elle revient en fondu, à sa place, sans glisser
      sortir_du_cache "$a" "$ws" true || exit 1
    fi
    # Le focus sans déplacer le pointeur : Hyprland le met au milieu de la fenêtre, on le remet où il était
    # (clic dans la barre ou dans la vue des fenêtres)
    # (NC_FENETRE_POINTEUR=suivre : le pointeur reste là où Hyprland le met, dans la fenêtre — raccourci clavier)
    cx=""; cy=""
    [ "${NC_FENETRE_POINTEUR:-}" = suivre ] || read -r cx cy <<< "$(hyprctl cursorpos 2>/dev/null | tr -d ',')"
    eval_lua "hl.dsp.focus({ window = 'address:$a' })"
    if [ -n "${cy:-}" ]; then eval_lua "hl.dsp.cursor.move({ x = $cx, y = $cy })"; fi ;;
  *)
    if [ "${NC_LANGUE:-fr}" = en ]; then
      cat <<'FIN'
nc-window: minimize a window (like the "_" button on Windows) and bring it back. Hyprland has no minimized windows:
they go to a hidden workspace, "special:reduites", and come back to the visible workspace.
  nc-window minimize [ADDRESS]   minimizes the active window (or that one)               Super + M
  nc-window restore [ADDRESS]    brings back the last minimized window (or that one)     Super + Ctrl + M
  nc-window goto ADDRESS         goes to a window; if minimized, it is restored first (Spotlight, window overview)
  nc-window toggle ADDRESS       hides it, or brings it back if hidden (bar: nc/fenetres)
  nc-window tool TITLE           island tool window (settings, JARVIS dashboard or chat): on another workspace or
                                 hidden, brought to the visible workspace; here but unfocused, focused; here and
                                 active, hidden (its shape is kept: tiled or floating); absent, exit code 3
  nc-window close ADDRESS        closes it
  nc-window hide-all             hides every window of the visible workspace
  nc-window show-all             brings every hidden window back to the visible workspace
  nc-window fullscreen-hide ADDRESS     hides the other windows of that window's workspace (not pinned ones), for a
                                        fullscreen that hides; the list is kept in $XDG_RUNTIME_DIR/nc-reduites-plein
  nc-window fullscreen-restore ADDRESS  brings back, on their original workspace, the windows hidden by that one
  nc-window state                each display, its workspace and windows, and the hidden ones, as JSON (bar: nc/fenetres)
  nc-window watch                the same state, written again on each change (one JSON line; bar: nc/fenetres)
A minimized window activated another way (dock, Alt + Tab) also comes back on its own (nc/automatismes.lua).
A window hidden by a fullscreen that hides, brought back (goto), makes its owner leave maximized: all its hidden
windows come back.
FIN
    else
      # L'en-tête : les lignes de commentaire après le « #! », jusqu'à la première ligne qui n'en est pas une
      sed -n '2,${/^#/!q;p}' "$0" | sed 's/^# \{0,1\}//'
    fi
    # Une action inconnue n'est pas un succès ; sans action (ou aide), code 0
    case "$action" in ""|-h|--help|aide|help) ;; *) exit 2 ;; esac ;;
esac
