A = None


def T(fr, en):
    return A.T(fr, en) if A else fr


class Refus(Exception):
    """Demande refusée : le message part au serveur et dans le journal."""
    def __init__(self, message, decision="refusé"):
        super().__init__(message)
        self.decision = decision


class Definitif(Exception):
    """Impossible de se connecter tant que la configuration ne change pas (pas de relance)."""


def horloge():
    """Horloge monotone des échéances (remplacée dans les tests)."""
    return time.monotonic()


def raccourci_tests(nom, defaut, plancher=0.0):
    """Une durée que les tests peuvent RACCOURCIR (jamais allonger) par la variable nom, mais seulement sous
    NC_NOEUD_TESTS=1 : en production, ces variables ne sont pas lues, et rien ne peut couper le calme ni les délais
    sans le dire."""
    if os.environ.get("NC_NOEUD_TESTS") != "1":
        return defaut
    try:
        return max(plancher, min(float(os.environ.get(nom, defaut)), defaut))
    except ValueError:
        return defaut


def distance_calme():
    """Durée de la période calme après la fin d'une demande (NC_NOEUD_CALME en tests seulement)."""
    return raccourci_tests("NC_NOEUD_CALME", DISTANCE_CALME)


def frappe_max():
    """Temps de frappe d'un code compté depuis la présentation d'une demande (NC_NOEUD_FRAPPE en tests seulement)."""
    return raccourci_tests("NC_NOEUD_FRAPPE", FRAPPE_MAX)


def delai_trame(v):
    """Le « timeout » de la trame d'action (aae5b9b), en secondes ; None s'il manque ou n'a pas de sens (non numérique,
    nul ou négatif, infini, plus d'une heure) : on revient alors aux délais connus."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    try:
        v = float(v)
    except OverflowError:
        raise Refus(T("Délai du serveur illisible : refusé.", "Unreadable server timeout: denied."),
                    "refusé (délai illisible)") from None
    if not math.isfinite(v) or v <= 0 or v > TRAME_ABSURDE:
        return None
    return v


def delai_confirmation(nom, p, trame=None):
    """Secondes laissées pour confirmer cette action, sous le délai du serveur ; Refus si c'est impossible.
    trame : le délai annoncé par le serveur dans la trame (delai_trame), qui l'emporte sur les délais connus."""
    if trame is not None:
        if trame < EXEC_MIN:
            raise Refus(T(f"Délai du serveur trop court ({trame:g} s) pour te demander confirmation "
                          f"({EXEC_MIN} s au moins) : refusé.",
                          f"Server timeout too short ({trame:g} s) to ask for your confirmation (at least {EXEC_MIN} s): denied."))
        utile = trame - MARGE_SERVEUR
        return math.floor(min(utile - min(RESERVE_EXEC, utile / PART_EXEC), DELAI_MAX_TRAME))
    if nom in DELAIS_FIXES:
        return DELAIS_FIXES[nom]
    if nom != "exec":
        return DELAI_RELAIS
    # exec_cmd envoie {command, timeout} et attend timeout + 5 s ; HardwareRelay (run_shell) attend 20 s, et sa forme
    # ne se distingue pas toujours d'exec_cmd (un timeout peut y figurer) : 17 s au plus dans tous les cas
    t = p.get("timeout")
    d = DELAI_CONFIRMATION
    if t is not None:
        try:
            t = float(t)
        except (TypeError, ValueError):
            t = float("nan")
        if not math.isfinite(t):
            raise Refus(T("Délai de la commande illisible : refusé.", "Unreadable command timeout: denied."))
        if t < EXEC_MIN:
            raise Refus(T(f"Délai de la commande trop court ({t:g} s) pour te demander confirmation "
                          f"({EXEC_MIN} s au moins) : refusé.",
                          f"Command timeout too short ({t:g} s) to ask for your confirmation (at least {EXEC_MIN} s): denied."))
        d = min(d, t - MARGE_SERVEUR)
    d = min(d, DELAI_RELAIS)
    return max(d, MARGE_SERVEUR)


def reglage(cle, defaut):
    """Valeur de nc-reglages (~/.config/nc/reglages.conf), relue à chaque demande ; absente : la valeur par défaut."""
    try:
        for l in (HOME / ".config/nc/reglages.conf").read_text(encoding="utf-8").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"').strip("'")
    except (OSError, UnicodeError):
        pass
    return defaut


def ia_coupee():
    return reglage("IA_MODE", "auto") == "non"


def session_minutes():
    """NOEUD_SESSION_MINUTES : durée d'une session de confiance, en minutes. 0 (défaut) la désactive ; 1 à 15 ;
    au-delà → 15 ; une valeur illisible → 0."""
    try:
        n = int(float(reglage("NOEUD_SESSION_MINUTES", "0")))
    except (TypeError, ValueError):
        return 0
    return max(0, min(n, SESSION_MINUTES_MAX))


def origine_cle(origin):
    """L'origine annoncée par la trame d'action (proposée : {"via","chat","conversation"}), ramenée à une clé stable
    pour lier une session « au même endroit ». None si l'origine est absente ou vide : pas de session alors."""
    # Le type en tête (une chaîne qui vaudrait le JSON d'un dict reste une autre origine) et une empreinte de l'origine
    # ENTIÈRE (une coupe à 1000 caractères confondait deux origines au même début)
    if isinstance(origin, (dict, list)) and origin:
        try:
            texte = "json:" + json.dumps(origin, sort_keys=True, ensure_ascii=False)
        except (TypeError, ValueError):
            return None
    elif isinstance(origin, str) and origin.strip():
        texte = "texte:" + origin.strip()
    else:
        return None
    return hashlib.sha256(texte.encode("utf-8", "surrogatepass")).hexdigest()


def mode_confirmation():
    """NOEUD_CONFIRMATION : « ecran » (par défaut), « distance » ou « les-deux » ; toute autre valeur : « ecran »."""
    m = reglage("NOEUD_CONFIRMATION", "ecran")
    return m if m in ("ecran", "distance", "les-deux") else "ecran"


# ── Code de confirmation à distance (TOTP, RFC 6238 : SHA1, 30 s, 6 chiffres) ───────────────────────────────────────
# Le secret est créé et gardé sur ce PC seulement (0600), jamais envoyé au serveur ni noté au journal ; tu l'enregistres
# dans ton appli d'authentification (Aegis, Google Authenticator…). Le serveur relaie le code que tu tapes : sans ton
# code, il ne peut rien autoriser. Le code prouve que tu es là, pas ce que tu as lu : chaque autorisation à distance
# est aussi annoncée par une notification sur ce PC.
TOTP_PAS = 30
TOTP_ECHECS_MAX = 5                # codes faux par heure, puis la confirmation à distance est bloquée
TOTP_ECHECS_TOTAL = 10             # codes faux depuis le dernier « nc-noeud totp verifier » sur ce PC, puis blocage


def fichier_totp():
    return HOME / ".config/nc/noeud-totp.json"


def fichier_totp_etat():
    return Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "noctalia-config/noeud-totp-etat.json"


def heure():
    """Heure murale des codes (remplacée dans les tests)."""
    return time.time()


def totp_code(secret, pas):
    cle = base64.b32decode(secret.upper() + "=" * (-len(secret) % 8))
    h = hmac.new(cle, struct.pack(">Q", pas), hashlib.sha1).digest()
    o = h[-1] & 0x0F
    return f"{(struct.unpack('>I', h[o:o + 4])[0] & 0x7FFFFFFF) % 1000000:06d}"


def lire_json_prive(chemin):
    """Le contenu d'un fichier JSON à toi seul (0600, pas un lien) ; None sinon."""
    try:
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
            return None
        with os.fdopen(fd, "r", encoding="utf-8") as f:
            fd = None
            v = json.load(f)
        return v if isinstance(v, dict) else None
    except (OSError, ValueError, UnicodeError):
        return None
    finally:
        if fd is not None:
            os.close(fd)


def ecrire_json_prive(chemin, v):
    chemin.parent.mkdir(parents=True, exist_ok=True)
    ecrire_atomique(chemin, json.dumps(v), 0o600)


def totp_secret(verifie=True):
    """Le secret enrôlé (vérifié si demandé), ou None."""
    v = lire_json_prive(fichier_totp())
    if not v or not isinstance(v.get("secret"), str) or len(v["secret"]) < 16:
        return None
    if verifie and v.get("verifie") is not True:
        return None
    try:
        totp_code(v["secret"], 0)
    except (ValueError, TypeError):
        return None
    return v["secret"]


def totp_etat():
    v = lire_json_prive(fichier_totp_etat()) or {}
    dernier = v.get("dernier")
    echecs = [t for t in v.get("echecs", []) if isinstance(t, (int, float)) and heure() - t < 3600]
    total = v.get("total")
    return {"dernier": dernier if isinstance(dernier, int) else -1, "echecs": echecs, "bloque": v.get("bloque") is True,
            "total": total if isinstance(total, int) and total >= 0 else len(echecs)}


def totp_actif():
    return totp_secret() is not None and not totp_etat()["bloque"]


def code_trouve(secret, code, etat):
    """Le pas (compteur) du code dans la fenêtre ±1 et jamais servi, sinon (None, raison). Comparaison à temps constant."""
    if not isinstance(code, str) or not re.fullmatch(r"[0-9]{6}", code):
        return None, "absent" if not code else "illisible"
    p = int(heure() // TOTP_PAS)
    trouve = None
    for d in (-1, 0, 1):
        if hmac.compare_digest(totp_code(secret, p + d), code):
            trouve = p + d
    if trouve is None:
        return None, "faux"
    if trouve <= etat["dernier"]:
        return None, "déjà servi"
    return trouve, ""


def verifier_code_distant(code):
    """(vrai, "") si le code autorise ; sinon (faux, raison). Un code faux ou absent est compté et annoncé sur ce PC :
    5 en une heure, ou 10 depuis le dernier « totp verifier », bloquent la distance. Un code déjà servi ne compte pas
    (raison « déjà servi » : le serveur demande le code suivant)."""
    secret = totp_secret()
    etat = totp_etat()
    if not secret:
        return False, "aucun code enrôlé"
    if etat["bloque"]:
        return False, "bloqué"
    pas, raison = code_trouve(secret, code, etat)
    if pas is not None:
        etat["dernier"] = pas
        ecrire_json_prive(fichier_totp_etat(), etat)
        return True, ""
    if raison == "déjà servi":
        return False, raison
    etat["echecs"].append(heure())
    etat["total"] += 1
    if len(etat["echecs"]) >= TOTP_ECHECS_MAX or etat["total"] >= TOTP_ECHECS_TOTAL:
        etat["bloque"] = True
        prevenir(T("Confirmation à distance bloquée", "Remote confirmation blocked"),
                 T("Trop de codes faux : JARVIS ne peut plus faire autoriser à distance. Sur ce PC, "
                   "« nc-noeud totp verifier CODE » la rétablit.",
                   "Too many wrong codes: JARVIS can no longer get remote approval. On this PC, "
                   "“nc-noeud totp verifier CODE” restores it."))
        print(T("nc-noeud : trop de codes faux, confirmation à distance bloquée.",
                "nc-noeud: too many wrong codes, remote confirmation blocked."), file=sys.stderr, flush=True)
    else:
        prevenir(T("Code faux reçu de JARVIS", "Wrong code received from JARVIS"),
                 T(f"Une confirmation à distance est arrivée avec un code {raison} ({etat['total']} depuis la dernière "
                   "vérification). Si ce n'est pas toi, coupe « Laisser JARVIS piloter ce PC ».",
                   f"A remote confirmation arrived with a {raison} code ({etat['total']} since the last check). If it "
                   "was not you, turn off “Let JARVIS control this PC”."))
    ecrire_json_prive(fichier_totp_etat(), etat)
    return False, raison


def prevenir(titre, corps):
    ns = programme("notify-send")
    if ns:
        with contextlib.suppress(OSError):
            subprocess.Popen([ns, "-a", "JARVIS", "-u", "critical", "--", titre, corps], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def mode_effectif(dire=False):
    """Le mode de confirmation vraiment appliqué : distance et les-deux exigent un code enrôlé et non bloqué."""
    m = mode_confirmation()
    if m != "ecran" and not totp_actif():
        if dire:
            print(T(f"nc-noeud : NOEUD_CONFIRMATION={m}, mais aucun code de confirmation n'est prêt (ou il est bloqué) : "
                    "confirmation sur l'écran. Lance « nc-noeud totp creer » puis « nc-noeud totp verifier CODE ».",
                    f"nc-noeud: NOEUD_CONFIRMATION={m}, but no confirmation code is ready (or it is blocked): confirming "
                    "on the screen. Run “nc-noeud totp creer” then “nc-noeud totp verifier CODE”."),
                  file=sys.stderr, flush=True)
        return "ecran"
    return m


def relancer_service():
    """Le register dit au serveur si ce PC sait confirmer à distance : on se reconnecte (si le service tourne)."""
    sc = programme("systemctl")
    if sc and reglage("NOEUD_JARVIS", "non") == "oui":
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            subprocess.run([sc, "--user", "try-restart", "nc-noeud.service"], capture_output=True, timeout=20)


def commande_totp(args):
    quoi = args[0] if args else "etat"
    f = fichier_totp()
    if quoi in ("creer", "créer", "create"):
        if os.path.lexists(f) and "--remplacer" not in args:
            # Même un code pas encore vérifié ou un fichier aux mauvais droits : on ne l'écrase pas sans le dire
            print(T("Un code existe déjà (vérifié ou non). « nc-noeud totp retirer » d'abord, ou --remplacer.",
                    "A code already exists (verified or not). “nc-noeud totp retirer” first, or --remplacer."), file=sys.stderr)
            return 1
        secret = base64.b32encode(os.urandom(20)).decode("ascii").rstrip("=")
        ecrire_json_prive(f, {"secret": secret, "verifie": False})
        with contextlib.suppress(FileNotFoundError):
            fichier_totp_etat().unlink()
        pc = A.nom_du_pc() if A else None
        pc = pc or socket.gethostname() or "linux"
        uri = (f"otpauth://totp/noctalia-config:{urllib.parse.quote(pc, safe='')}?secret={secret}"
               "&issuer=noctalia-config")
        print(T("Code de confirmation à distance : ajoute-le dans ton appli d'authentification (Aegis, Google "
                "Authenticator…). Ne le montre à personne, et jamais au serveur.",
                "Remote confirmation code: add it to your authenticator app (Aegis, Google Authenticator…). Show it to "
                "nobody, and never to the server."))
        qr = programme("qrencode")
        dessin = None
        if qr:
            with contextlib.suppress(OSError, subprocess.SubprocessError):
                r = subprocess.run([qr, "-t", "ANSIUTF8"], input=uri.encode("utf-8"), capture_output=True, timeout=10)
                dessin = r.stdout.decode("utf-8", "replace") if r.returncode == 0 and r.stdout else None
        if dessin:
            print(dessin)
        else:
            print(T("Clé à taper dans l'appli (type « basé sur l'heure », 6 chiffres, 30 s) :",
                    "Key to type in the app (time-based, 6 digits, 30 s):"))
            print("  " + " ".join(secret[i:i + 4] for i in range(0, len(secret), 4)))
        print(uri)
        print(T("Puis : nc-noeud totp verifier CODE (le code à 6 chiffres affiché par l'appli).",
                "Then: nc-noeud totp verifier CODE (the 6-digit code shown by the app)."))
        relancer_service()                       # un ancien code remplacé : le serveur doit le savoir tout de suite
        return 0
    if quoi in ("verifier", "vérifier", "verify"):
        secret = totp_secret(verifie=False)
        if not secret:
            print(T("Aucun code : « nc-noeud totp creer » d'abord.", "No code: “nc-noeud totp creer” first."), file=sys.stderr)
            return 1
        etat = totp_etat()
        etat["bloque"] = False
        pas, raison = code_trouve(secret, args[1].strip() if len(args) > 1 else "", etat)
        if pas is None:
            print(T(f"Code {raison} : rien n'est activé. Vérifie l'heure du PC et du téléphone.",
                    f"Code {raison}: nothing enabled. Check the time on the PC and the phone."), file=sys.stderr)
            return 1
        ecrire_json_prive(f, {"secret": secret, "verifie": True})
        ecrire_json_prive(fichier_totp_etat(), {"dernier": pas, "echecs": [], "bloque": False, "total": 0})
        print(T("Code bon : la confirmation à distance est prête. nc-reglages → Intelligence artificielle → « Où autoriser "
                "les actions de JARVIS » → À distance (ou Les deux).",
                "Code accepted: remote confirmation is ready. nc-settings → Artificial intelligence → “Where to allow "
                "JARVIS actions” → Remotely (or Both)."))
        relancer_service()
        return 0
    if quoi in ("retirer", "remove"):
        for x in (f, fichier_totp_etat()):
            with contextlib.suppress(FileNotFoundError):
                x.unlink()
        print(T("Code oublié : la confirmation se fait sur l'écran.", "Code removed: confirmation happens on the screen."))
        relancer_service()
        return 0
    if quoi in ("etat", "état", "status"):
        if totp_secret():
            print(T("Code prêt" + (" mais BLOQUÉ (trop de codes faux) : nc-noeud totp verifier CODE" if totp_etat()["bloque"] else "."),
                    "Code ready" + (" but BLOCKED (too many wrong codes): nc-noeud totp verifier CODE" if totp_etat()["bloque"] else ".")))
        elif totp_secret(verifie=False):
            print(T("Code créé, pas encore vérifié : nc-noeud totp verifier CODE.", "Code created, not verified yet: nc-noeud totp verifier CODE."))
        else:
            print(T("Aucun code : nc-noeud totp creer.", "No code: nc-noeud totp creer."))
        return 0
    print(T("nc-noeud totp creer | verifier CODE | retirer", "nc-noeud totp creer | verifier CODE | retirer"), file=sys.stderr)
    return 2


# ── Secrets : jamais dans le journal ni dans ce qui part pour la confirmation à distance ─────────────────────────────
SECRETS = set()                    # valeurs secrètes de la configuration (SECRET_KEY…), remplies au démarrage
MOTIFS_SECRETS = [re.compile(m) for m in (
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----",
    r"\b(?:gh[pousr]_|github_pat_|glpat-|sk-ant-|sk-proj-|sk-|xox[abprs]-|AIza|ya29\.)[A-Za-z0-9_\-]{16,}",
    r"(?i)\b(?:bearer|token|basic)\s+[A-Za-z0-9._~+/=\-]{16,}",
    r"(?i)\b((?:api[_-]?key|secret[_-]?key|x-secret-key|password|passwd|token)\s*[=:]\s*)[\"']?[A-Za-z0-9._~+/=\-]{6,}")]
MASQUE = "•••"


def retenir_secrets(c):
    """Les valeurs de la configuration dont le nom dit qu'elles sont secrètes."""
    for k, v in (c or {}).items():
        if isinstance(v, str) and len(v) >= 6 and any(x in k.upper() for x in ("SECRET", "TOKEN", "KEY", "PASS")):
            SECRETS.add(v)


def ressemble_a_un_code(texte):
    """Un code à 6 chiffres seul, une adresse otpauth:// ou une clé base32 de la taille d'un secret TOTP (d'un bloc, ou
    en groupes de 4 comme nc-noeud totp creer l'affiche ; une phrase de 32 lettres n'en est pas une)."""
    s = str(texte)
    compact = re.sub(r"[\s-]", "", s)
    return bool(re.fullmatch(r"[0-9]{6}", compact) or "otpauth:" in s.lower()
                or re.fullmatch(r"(?:[A-Za-z2-7]{4}[ -]?){7}[A-Za-z2-7]{4}=*", s.strip()))


def secrets_exacts(texte):
    """Seulement les valeurs exactes de la configuration remplacées : ce qui reste montre la vraie commande."""
    s = str(texte)
    for v in sorted(SECRETS, key=len, reverse=True):
        s = s.replace(v, MASQUE)
    return s


def motifs_trouves(texte):
    """Vrai si un motif générique de secret (jeton, clé privée…) figure dans le texte."""
    return any(m.search(str(texte)) for m in MOTIFS_SECRETS)


def sans_secrets(texte):
    """Pour le journal : valeurs exactes et motifs génériques masqués (l'empreinte sha256 garde la commande entière)."""
    s = secrets_exacts(texte)
    for m in MOTIFS_SECRETS:
        s = m.sub(lambda x: ((x.group(1) or "") if x.re.groups else "") + MASQUE, s)
    return s


# Caractères qui se cachent ou trompent à l'affichage : contrôles C0 et C1 (sauf le saut de ligne), bidi, largeur nulle,
# séparateurs de ligne Unicode. Rendus visibles entre chevrons (⟨\x1b⟩, ⟨\u202e⟩…) dans la carte, le résumé à distance et
# le journal ; une barre oblique inverse de la commande reste telle quelle (« \n » se lit comme il s'exécute).
CACHES = {0x200B, 0x200C, 0x200D, 0x200E, 0x200F, 0x2060, 0xFEFF, 0x061C, 0x180E, 0x2028, 0x2029,
          *range(0x202A, 0x202F), *range(0x2066, 0x206A),
          0x3164, 0x115F, 0x1160, 0xFFA0, 0x2800, 0x034F, 0x17B4, 0x17B5, *range(0xFE00, 0xFE10), *range(0xE0100, 0xE01F0)}


def rendre_visible(texte):
    out = []
    for ch in str(texte):
        o = ord(ch)
        if ch == "\n":
            out.append(ch)
        elif o < 0x20 or 0x7F <= o <= 0x9F:
            out.append(f"⟨\\x{o:02x}⟩")
        elif o in CACHES or unicodedata.category(ch) in ("Cf", "Zl", "Zp"):
            out.append(f"⟨\\u{o:04x}⟩" if o <= 0xFFFF else f"⟨\\U{o:08x}⟩")
        else:
            out.append(ch)
    return re.sub(r"\n{3,}", "\n\n", "".join(out))             # au plus 2 sauts de ligne de suite


def longueur_utf16(texte):
    """Longueur comptée comme Telegram (unités UTF-16)."""
    return len(str(texte).encode("utf-16-le")) // 2


def empreinte(donnees):
    return hashlib.sha256(donnees if isinstance(donnees, bytes) else str(donnees).encode("utf-8")).hexdigest()


def dossier_runtime():
    """$XDG_RUNTIME_DIR/nc-noeud (0700, à toi seul) : la demande en cours et la réponse de l'île."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isdir(base):
        raise Refus(T("XDG_RUNTIME_DIR absent : confirmation impossible.", "XDG_RUNTIME_DIR missing: cannot confirm."))
    d = Path(base) / "nc-noeud"
    for x in (d, d / "reponses"):
        x.mkdir(mode=0o700, exist_ok=True)
        s = os.lstat(x)
        if not stat.S_ISDIR(s.st_mode) or s.st_uid != os.getuid():
            raise Refus(T("Dossier de confirmation douteux : " + str(x), "Suspicious confirmation folder: " + str(x)))
        os.chmod(x, 0o700)
    return d


def ecrire_atomique(chemin, texte, mode=0o600):
    fd, tmp = tempfile.mkstemp(dir=str(chemin.parent), prefix=".nc-noeud-")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(texte)
        os.replace(tmp, chemin)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


# ── Journal local ─────────────────────────────────────────────────────────────────────────────────────────────────
def journal(action, resume, decision, sha=None):
    """Une ligne par demande : date, action, résumé (secrets masqués, caractères cachés rendus visibles, puis
    « sha256=… » de la commande ou du contenu entier), décision. 0600 ; ramené à sa seconde moitié au-delà de 1 Mo."""
    d = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "noctalia-config"
    f = d / "noeud.log"
    propre = lambda s: " ".join(rendre_visible(sans_secrets(s)).split())[:300]
    ligne = "\t".join((datetime.now().astimezone().isoformat(timespec="seconds"), propre(action),
                       propre(resume) + (f" sha256={sha}" if sha else ""), propre(decision))) + "\n"
    try:
        d.mkdir(parents=True, exist_ok=True)
        if f.is_symlink():
            return
        with contextlib.suppress(FileNotFoundError):
            if f.stat().st_size > 1024 * 1024:
                garde = f.read_bytes()[-512 * 1024:]
                ecrire_atomique(f, garde[garde.find(b"\n") + 1:].decode("utf-8", "replace"))
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        try:
            os.fchmod(fd, 0o600)
            os.write(fd, ligne.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        pass


# ── Chemins ───────────────────────────────────────────────────────────────────────────────────────────────────────
def resoudre(brut):
    """Chemin absolu, liens symboliques suivis ; relatif : depuis le dossier personnel."""
    s = str(brut or "").strip()
    if not s or "\0" in s:
        raise Refus(T("Chemin manquant ou invalide.", "Missing or invalid path."))
    p = Path(s).expanduser()
    if not p.is_absolute():
        p = HOME / p
    try:
        return p.resolve()
    except (OSError, RuntimeError) as e:
        raise Refus(T(f"Chemin impossible à résoudre : {e}", f"Cannot resolve path: {e}")) from None


# Dossiers où un fichier à plusieurs liens physiques est normal (paquets du système) ; ailleurs, un lien physique
# pourrait mener à un fichier protégé sans passer par son chemin : lecture refusée
DOSSIERS_SURS = ("/usr", "/opt", "/nix/store")


def protege(cible, ecriture):
    """Le chemin protégé qui contient cible (déjà résolue), ou None. Les « * » valent pour un seul niveau."""
    liste = PROTEGES + (ECRITURE_SEULEMENT if ecriture else LECTURE_SEULEMENT)
    bases = {Path(os.path.abspath(HOME)), HOME.resolve()}
    if ecriture:
        # Le dossier d'état vraiment utilisé (XDG_STATE_HOME peut être ailleurs) : journal, échecs du code
        etat = fichier_totp_etat().parent
        for b in {Path(os.path.abspath(etat)), etat.resolve()}:
            if cible == b or b in cible.parents:
                return montrer_chemin(b)
    for rel in liste:
        if "*" in rel:
            n = len(Path(rel).parts)
            for h in bases:
                with contextlib.suppress(ValueError):
                    parts = cible.relative_to(h).parts
                    if len(parts) >= n and fnmatch.fnmatchcase("/".join(parts[:n]), rel):
                        return "~/" + rel
            continue
        base = HOME / rel
        for b in {Path(os.path.abspath(base)), base.resolve()}:
            if cible == b or b in cible.parents:
                return "~/" + rel
    return None


def lien_physique_douteux(st, cible):
    return stat.S_ISREG(st.st_mode) and st.st_nlink > 1 and not any(
        str(cible) == d or str(cible).startswith(d + "/") for d in DOSSIERS_SURS)


def verifier_fd(fd, cible, ecriture):
    """Après l'ouverture : le fichier vraiment ouvert (/proc/self/fd) est bien la cible, et n'est pas protégé."""
    try:
        vrai = Path(os.path.realpath(f"/proc/self/fd/{fd}"))
    except OSError:
        vrai = None
    if vrai is not None and str(vrai).startswith("/") and vrai != cible:
        raise Refus(T("Le fichier a changé pendant l'ouverture : refusé.", "The file changed while opening: denied."),
                    "refusé (chemin changé)")
    p = protege(cible if vrai is None else vrai, ecriture)
    if p:
        raise Refus(T(f"Chemin protégé ({p}) : refusé, même avec ta confirmation.",
                      f"Protected path ({p}): denied, even with your confirmation."), "refusé (chemin protégé)")
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise Refus(T("Ce n'est pas un fichier ordinaire : refusé.", "Not a regular file: denied."), "refusé (pas un fichier)")
    if lien_physique_douteux(st, cible):              # en lecture comme en écriture (avant de vider le fichier)
        raise Refus(T("Fichier à plusieurs liens physiques : refusé.", "File with several hard links: denied."),
                    "refusé (lien physique)")


def verifier_chemin(brut, ecriture):
    cible = resoudre(brut)
    p = protege(cible, ecriture)
    if p:
        raise Refus(T(f"Chemin protégé ({p}) : refusé, même avec ta confirmation.",
                      f"Protected path ({p}): denied, even with your confirmation."), "refusé (chemin protégé)")
    return cible


def montrer_chemin(p):
    s = str(p)
    h = str(HOME)
    return "~" + s[len(h):] if s == h or s.startswith(h + "/") else s


def taille_lisible(n):
    if n < 1024:
        return T(f"{n} octets", f"{n} bytes")
    if n < 1024 * 1024:
        return f"{n / 1024:.1f} Ko".replace(".", ",") if A is None or A.langue() == "fr" else f"{n / 1024:.1f} KB"
    return f"{n / 1048576:.1f} Mo".replace(".", ",") if A is None or A.langue() == "fr" else f"{n / 1048576:.1f} MB"


# ── WebSocket (RFC 6455), client minimal ──────────────────────────────────────────────────────────────────────────
GUID_WS = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def masquer(donnees, cle):
    n = len(donnees)
    if not n:
        return b""
    m = (cle * (n // 4 + 1))[:n]
    return (int.from_bytes(donnees, "big") ^ int.from_bytes(m, "big")).to_bytes(n, "big")


class ErreurWS(Exception):
    pass


class WebSocket:
    def __init__(self, lecteur, ecrivain):
        self.r, self.w = lecteur, ecrivain
        self.verrou = asyncio.Lock()
        self.ferme = False
        self.dernier = time.monotonic()        # dernière trame reçue (pings compris)

    async def trame(self, opcode, donnees=b""):
        cle = os.urandom(4)
        n = len(donnees)
        tete = bytearray([0x80 | opcode])
        if n <= 125:
            tete.append(0x80 | n)
        elif n <= 0xFFFF:
            tete += bytes([0x80 | 126]) + struct.pack("!H", n)
        else:
            tete += bytes([0x80 | 127]) + struct.pack("!Q", n)
        async with self.verrou:
            self.w.write(bytes(tete) + cle + masquer(donnees, cle))
            # Un serveur qui ne lit plus laisse drain() bloqué pour toujours, verrou d'écriture tenu : plus de pong, plus
            # rien ne part (y compris confirm_cancel). On borne l'écriture et on ferme la connexion si elle ne passe pas.
            try:
                await asyncio.wait_for(self.w.drain(), DELAI_ENVOI)
            except (asyncio.TimeoutError, OSError):
                self.ferme = True
                with contextlib.suppress(Exception):
                    self.w.close()
                raise ErreurWS(T("Écriture bloquée vers le serveur : connexion fermée.",
                                 "Write to the server stalled: connection closed.")) from None

    async def envoyer(self, objet):
        await self.trame(0x1, json.dumps(objet, ensure_ascii=False).encode("utf-8"))

    async def recevoir(self):
        """Le prochain message texte ; None à la fermeture."""
        morceaux, total = [], 0
        while True:
            tete = await self.r.readexactly(2)
            fin, opcode, masque, n = tete[0] & 0x80, tete[0] & 0x0F, tete[1] & 0x80, tete[1] & 0x7F
            if n == 126:
                n = struct.unpack("!H", await self.r.readexactly(2))[0]
            elif n == 127:
                n = struct.unpack("!Q", await self.r.readexactly(8))[0]
            if n > MAX_TRAME or total + n > MAX_TRAME:
                raise ErreurWS(T("Message trop gros du serveur.", "Message from the server too big."))
            cle = await self.r.readexactly(4) if masque else None
            donnees = await self.r.readexactly(n) if n else b""
            if cle:
                donnees = masquer(donnees, cle)
            self.dernier = time.monotonic()
            if opcode == 0x8:                                   # fermeture : on répond, c'est fini
                with contextlib.suppress(Exception):
                    await self.trame(0x8, donnees[:2])
                self.ferme = True
                return None
            if opcode == 0x9:                                   # ping → pong
                await self.trame(0xA, donnees[:125])
                continue
            if opcode == 0xA:
                continue
            if opcode in (0x0, 0x1, 0x2):
                morceaux.append(donnees)
                total += n
                if fin:
                    return b"".join(morceaux).decode("utf-8", "replace")
                continue
            raise ErreurWS(T("Trame WebSocket inconnue.", "Unknown WebSocket frame."))

    async def fermer(self):
        if not self.ferme:
            self.ferme = True
            with contextlib.suppress(Exception):
                await asyncio.wait_for(self.trame(0x8, struct.pack("!H", 1000)), 2)
        with contextlib.suppress(Exception):
            self.w.close()


def adresse_ws(c):
    """(hôte, port, tls, chemin) du point /api/node/ws. https → wss ; http → ws seulement vers un hôte privé ou
    Tailscale (réseau local ou chiffré par WireGuard) ; sinon refus : la clé et les commandes passeraient en clair."""
    url = c["URL"]
    u = urllib.parse.urlsplit(url)
    if u.scheme == "https":
        tls = True
    elif u.scheme == "http" and (A.hote_prive(url) or A.hote_tailscale(url)):
        tls = False
    else:
        raise Definitif(T("Connexion ws:// refusée vers un hôte public (" + (u.hostname or "?") + ") : la clé et les "
                          "demandes passeraient en clair. Configure une URL https:// (nc-assistant configurer).",
                          "ws:// connection refused to a public host (" + (u.hostname or "?") + "): the key and the "
                          "requests would travel in clear text. Configure an https:// URL (nc-assistant configurer)."))
    return u.hostname, u.port or (443 if tls else 80), tls, u.path.rstrip("/") + "/api/node/ws"


async def connecter(c):
    hote, port, tls, chemin = adresse_ws(c)
    ctx = ssl.create_default_context() if tls else None
    r, w = await asyncio.wait_for(asyncio.open_connection(hote, port, ssl=ctx, server_hostname=hote if tls else None,
                                                          limit=2 ** 20), 15)
    cle = base64.b64encode(os.urandom(16)).decode("ascii")
    nom_hote = f"[{hote}]" if ":" in hote else hote
    if port != (443 if tls else 80):
        nom_hote += f":{port}"
    # La clé secrète : dans l'en-tête seulement (le serveur le lit en premier), jamais dans l'URL ni les journaux
    requete = (f"GET {chemin} HTTP/1.1\r\nHost: {nom_hote}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               f"Sec-WebSocket-Key: {cle}\r\nSec-WebSocket-Version: 13\r\nUser-Agent: nc-noeud\r\n"
               f"X-Secret-Key: {c['SECRET_KEY']}\r\n\r\n")
    try:
        w.write(requete.encode("utf-8"))
        await w.drain()
        reponse = await asyncio.wait_for(r.readuntil(b"\r\n\r\n"), 15)
        lignes = reponse.decode("iso-8859-1").split("\r\n")
        statut = lignes[0].split(" ")
        if len(statut) < 2 or statut[1] != "101":
            code = statut[1] if len(statut) > 1 else "?"
            if code in ("401", "403"):
                raise ErreurWS(T(f"Clé refusée par le serveur (HTTP {code}) : vérifie SECRET_KEY.",
                                 f"Server rejected the key (HTTP {code}): check SECRET_KEY."))
            raise ErreurWS(T(f"Le serveur refuse le WebSocket (HTTP {code}).", f"Server refused the WebSocket (HTTP {code})."))
        entetes = {}
        for l in lignes[1:]:
            if ":" in l:
                k, v = l.split(":", 1)
                entetes[k.strip().lower()] = v.strip()
        attendu = base64.b64encode(hashlib.sha1((cle + GUID_WS).encode("ascii")).digest()).decode("ascii")
        if entetes.get("sec-websocket-accept") != attendu:
            raise ErreurWS(T("Réponse WebSocket invalide.", "Invalid WebSocket answer."))
    except BaseException:
        w.close()
        raise
    return WebSocket(r, w)


# ── Programmes du PC (détectés, jamais supposés) ──────────────────────────────────────────────────────────────────
async def lancer(args, entree=None, delai=20, **kw):
    """(code, sortie, erreurs) ; le programme est tué au-delà du délai."""
    p = await asyncio.create_subprocess_exec(*args, stdin=asyncio.subprocess.PIPE if entree is not None else asyncio.subprocess.DEVNULL,
                                             stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
                                             start_new_session=True, **kw)
    try:
        out, err = await asyncio.wait_for(p.communicate(entree), delai)
    except asyncio.TimeoutError:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(p.pid, signal.SIGKILL)
        await p.wait()
        raise
    except asyncio.CancelledError:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(p.pid, signal.SIGKILL)
        raise
    return p.returncode, out, err


def programme(*noms):
    for n in noms:
        c = shutil.which(n)
        if c:
            return c
    return None


# ── Les actions : (résumé, texte montré, exécution) ───────────────────────────────────────────────────────────────
class Action:
    def __init__(self, resume, texte="", executer=None, sha=None):
        self.resume, self.texte, self.executer = resume, texte, executer
        self.sha = sha                  # sha256 de la commande ou du contenu entier (journal, résumé à distance)


def preparer(action, p):
    """Valide la demande et décrit exactement ce qui sera fait ; Refus si elle est impossible ou interdite."""
    if action == "exec":
        cmd = str(p.get("command") or "")
        if not cmd.strip():
            raise Refus(T("Commande vide.", "Empty command."))
        if len(cmd) > MAX_TEXTE:
            raise Refus(T("Commande trop longue pour être relue : refusée.", "Command too long to be reviewed: denied."))
        if os.geteuid() == 0:
            raise Refus(T("nc-noeud ne tourne jamais en root.", "nc-noeud never runs as root."))
        try:
            delai = float(p.get("timeout", 30))
        except (TypeError, ValueError, OverflowError):
            delai = 30.0
        delai = min(max(delai, 1.0), 120.0) if math.isfinite(delai) else 30.0
        dossier = HOME
        if p.get("cwd"):
            dossier = verifier_chemin(p.get("cwd"), False)
            if not dossier.is_dir():
                raise Refus(T("Dossier de travail introuvable.", "Working directory not found."))
        resume = T("exécuter cette commande", "run this command")
        if dossier != HOME:
            resume += T(f" dans {montrer_chemin(dossier)}", f" in {montrer_chemin(dossier)}")
        if not cmd.isascii():                     # « gіthub.com » avec un і cyrillique : à regarder de près
            resume += T(" (contient des caractères non ASCII)", " (contains non-ASCII characters)")

        async def executer(budget=None, bac=False):
            # Durée : son délai demandé, mais jamais au-delà de l'échéance du serveur (moins 3 s) : B2-11
            d = delai if budget is None or not math.isfinite(budget) else min(budget, delai)
            debut = time.monotonic()
            if bac:                                   # exec de session : dans le bac à sable systemd, jamais hors de lui
                argv = bac_argv(cmd, str(dossier), d)
                if argv is None:                      # sonde faite avant ; par sûreté, on n'exécute jamais hors du bac
                    return {"success": False, "error": T("Bac à sable indisponible : commande non exécutée.",
                                                         "Sandbox unavailable: command not run.")}
                appel = lancer(argv, delai=d)
            else:
                appel = lancer(["/bin/sh", "-c", cmd], delai=d, cwd=str(dossier), env={**os.environ, "TERM": "dumb"})
            try:
                code, out, err = await appel
            except asyncio.TimeoutError:
                d = round(d, 1)
                return {"success": False, "error": T(f"Délai de {d:g} s dépassé.", f"{d:g} s timeout exceeded.")}
            duree = time.monotonic() - debut
            o = out[:MAX_SORTIE].decode("utf-8", "replace").strip()
            e = err[:MAX_SORTIE].decode("utf-8", "replace").strip()
            return {"success": code == 0, "returncode": code, "stdout": o, "stderr": e, "duration": round(duree, 2),
                    "message": f"Code {code} ({duree:.1f}s)\n{o}\n{e}".strip()}
        return Action(resume, cmd, executer, empreinte(cmd))

    if action in ("read_file", "list_files"):
        cible = verifier_chemin(p.get("path"), False)
        if not cible.exists():
            raise Refus(T(f"Introuvable : {montrer_chemin(cible)}", f"Not found: {montrer_chemin(cible)}"))
        if cible.is_dir():
            resume = T(f"lister le dossier {montrer_chemin(cible)}", f"list the folder {montrer_chemin(cible)}")

            async def executer(budget=None):
                elements = []
                for e in sorted(cible.iterdir(), key=lambda x: x.name)[:200]:
                    with contextlib.suppress(OSError):
                        dossier_ = e.is_dir()
                        elements.append({"name": e.name, "is_dir": dossier_, "size": 0 if dossier_ else e.stat().st_size})
                return {"success": True, "type": "directory", "items": elements}
            return Action(resume, "", executer)
        if action == "list_files":
            raise Refus(T("Ce n'est pas un dossier.", "Not a folder."))
        st = cible.stat()
        taille = st.st_size
        if taille > MAX_FICHIER:
            raise Refus(T("Fichier trop gros (plus de 5 Mo).", "File too big (over 5 MB)."))
        if not stat.S_ISREG(st.st_mode):                 # FIFO, périphérique… : open() bloquerait tout
            raise Refus(T("Ce n'est pas un fichier ordinaire : refusé.", "Not a regular file: denied."), "refusé (pas un fichier)")
        if lien_physique_douteux(st, cible):
            raise Refus(T("Fichier à plusieurs liens physiques : refusé.", "File with several hard links: denied."),
                        "refusé (lien physique)")

        async def executer(budget=None):
            # Relu au moment de lire : un lien posé pendant la confirmation ne mène pas ailleurs
            verifier_chemin(str(cible), False)
            fd = os.open(cible, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            try:
                verifier_fd(fd, cible, False)
            except BaseException:
                os.close(fd)
                raise
            with os.fdopen(fd, "rb") as f:
                contenu = f.read(MAX_FICHIER + 1)[:MAX_FICHIER].decode("utf-8", "replace")
            return {"success": True, "type": "file", "content": contenu, "size": len(contenu)}
        return Action(T(f"lire le fichier {montrer_chemin(cible)} ({taille_lisible(taille)})",
                        f"read the file {montrer_chemin(cible)} ({taille_lisible(taille)})"), montrer_chemin(cible), executer)

    if action == "write_file":
        cible = verifier_chemin(p.get("path"), True)
        contenu = str(p.get("content") if p.get("content") is not None else "")
        brut = contenu.encode("utf-8")
        if len(brut) > MAX_FICHIER:
            raise Refus(T("Contenu trop gros (plus de 5 Mo).", "Content too big (over 5 MB)."))
        if cible.is_dir():
            raise Refus(T("C'est un dossier.", "It is a folder."))
        with contextlib.suppress(FileNotFoundError):
            st = os.lstat(cible)
            if not stat.S_ISREG(st.st_mode):
                raise Refus(T("Ce n'est pas un fichier ordinaire : refusé.", "Not a regular file: denied."),
                            "refusé (pas un fichier)")
            if lien_physique_douteux(st, cible):
                raise Refus(T("Fichier à plusieurs liens physiques : refusé.", "File with several hard links: denied."),
                            "refusé (lien physique)")
        lignes = contenu.split("\n")                    # pas splitlines : \r, \x0c, \x85… restent visibles
        apercu = "\n".join(lignes[:20])
        if len(lignes) > 20:
            apercu += "\n…"
        existe = cible.exists()
        resume = (T(f"remplacer {montrer_chemin(cible)} par {taille_lisible(len(brut))}",
                    f"replace {montrer_chemin(cible)} with {taille_lisible(len(brut))}") if existe else
                  T(f"créer {montrer_chemin(cible)} ({taille_lisible(len(brut))})",
                    f"create {montrer_chemin(cible)} ({taille_lisible(len(brut))})"))

        async def executer(budget=None):
            cible.parent.mkdir(parents=True, exist_ok=True)
            verifier_chemin(str(cible), True)              # relu après la confirmation et la création des dossiers
            fd = os.open(cible, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o644)
            try:
                verifier_fd(fd, cible, True)                # vidé seulement après cette vérification
                os.ftruncate(fd, 0)
            except BaseException:
                os.close(fd)
                raise
            with os.fdopen(fd, "wb") as f:
                f.write(brut)
            return {"success": True, "path": str(cible), "bytes_written": len(brut)}
        return Action(resume, apercu[:MAX_TEXTE], executer, empreinte(brut))

    if action == "screenshot":
        grim = programme("grim")
        if not grim:
            raise Refus(T("Capture impossible : grim n'est pas installé.", "Cannot take a screenshot: grim is not installed."))

        async def executer(budget=None):
            base = os.environ.get("XDG_RUNTIME_DIR") or None
            fd, chemin = tempfile.mkstemp(prefix="nc-noeud-capture-", suffix=".png", dir=base)
            os.close(fd)
            try:
                code, _, err = await lancer([grim, chemin], delai=15)
                donnees = Path(chemin).read_bytes()
                if code != 0 or not donnees:
                    return {"success": False, "error": err.decode("utf-8", "replace").strip()[:300] or T("Capture ratée.", "Screenshot failed.")}
                return {"success": True, "image_base64": base64.b64encode(donnees).decode("ascii"), "format": "png"}
            finally:
                with contextlib.suppress(OSError):
                    os.unlink(chemin)                       # effacée après l'envoi (rien ne reste sur le disque)
        return Action(T("faire une capture de ton écran", "take a screenshot of your screen"), "", executer)

    if action == "clipboard_write":
        texte = str(p.get("text") if p.get("text") is not None else "")
        if len(texte) > MAX_TEXTE:
            raise Refus(T("Texte trop long pour être relu : refusé.", "Text too long to be reviewed: denied."))
        copier = programme("wl-copy")
        xclip = None if copier else programme("xclip")
        if not copier and not xclip:
            raise Refus(T("wl-copy (ou xclip) introuvable.", "wl-copy (or xclip) not found."))

        async def executer(budget=None):
            args = [copier] if copier else [xclip, "-selection", "clipboard"]
            code, _, _ = await lancer(args, entree=texte.encode("utf-8"), delai=10)
            return {"success": code == 0, "message": T("Presse-papiers mis à jour.", "Clipboard updated.")}
        return Action(T("remplacer ton presse-papiers par ce texte", "replace your clipboard with this text"), texte, executer)

    if action == "clipboard_read":
        coller = programme("wl-paste")
        xclip = None if coller else programme("xclip")
        if not coller and not xclip:
            raise Refus(T("wl-paste (ou xclip) introuvable.", "wl-paste (or xclip) not found."))

        async def executer(budget=None):
            args = [coller, "--no-newline"] if coller else [xclip, "-selection", "clipboard", "-o"]
            code, out, _ = await lancer(args, delai=10)
            texte = out[:MAX_SORTIE].decode("utf-8", "replace")
            if ressemble_a_un_code(texte):
                raise Refus(T("Le presse-papiers ressemble à un code de connexion ou une clé : pas envoyé.",
                              "The clipboard looks like a login code or a key: not sent."), "refusé (ressemble à un code)")
            return {"success": code == 0, "clipboard": texte}
        return Action(T("lire ton presse-papiers", "read your clipboard"), "", executer)

    if action == "media":
        sous = str(p.get("subaction") or "play-pause")
        if sous not in MEDIA:
            raise Refus(T(f"Commande de musique inconnue : {sous[:40]}", f"Unknown music command: {sous[:40]}"))
        pc = programme("playerctl")
        if not pc:
            raise Refus(T("playerctl introuvable.", "playerctl not found."))
        args = [pc, sous]
        if sous == "volume":
            try:
                v = float(p.get("value"))
            except (TypeError, ValueError):
                raise Refus(T("Volume invalide.", "Invalid volume.")) from None
            args.append(str(min(max(v if v <= 1 else v / 100, 0.0), 1.0)))

        async def executer(budget=None):
            code, out, err = await lancer(args, delai=10)
            return {"success": code == 0, "output": (out or err).decode("utf-8", "replace").strip()[:2000]}
        return Action(T(f"contrôler la musique : {sous}", f"control the music: {sous}"), "", executer)

    if action == "notify":
        titre = " ".join(str(p.get("title") or "JARVIS").split())[:100]
        corps = str(p.get("body") or "")[:1000]
        ns = programme("notify-send")
        if not ns:
            raise Refus(T("notify-send introuvable.", "notify-send not found."))

        async def executer(budget=None):
            code, _, _ = await lancer([ns, "-a", "JARVIS", "--", titre, html.escape(corps, quote=False)], delai=10)
            return {"success": code == 0}
        return Action(T(f"t'envoyer une notification : {titre}", f"send you a notification: {titre}"), corps, executer)

    if action == "lock":
        lc = programme("loginctl")
        hl = None if lc else programme("hyprlock")
        if not lc and not hl:
            raise Refus(T("Aucun verrouillage trouvé (loginctl, hyprlock).", "No locker found (loginctl, hyprlock)."))

        async def executer(budget=None):
            if lc:
                code, _, _ = await lancer([lc, "lock-session"], delai=10)
                return {"success": code == 0, "message": T("Session verrouillée.", "Session locked.")}
            subprocess.Popen([hl], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            return {"success": True, "message": T("Session verrouillée.", "Session locked.")}
        return Action(T("verrouiller ta session", "lock your session"), "", executer)

    raise Refus(T(f"Action non permise sur ce PC : {action[:40]}", f"Action not allowed on this PC: {action[:40]}"))


# ── Confirmation : l'île, sinon une notification à boutons, sinon refus ───────────────────────────────────────────
async def ile_prevenue():
    """L'île relit la demande ; vrai si elle a répondu (qs -c nc-ile ipc call ile noeud → « oui »)."""
    qs = programme("qs")
    if not qs:
        return False
    try:
        code, out, _ = await lancer([qs, "-c", "nc-ile", "ipc", "call", "ile", "noeud"], delai=4)
    except (OSError, asyncio.TimeoutError):
        return False
    return code == 0 and out.decode("utf-8", "replace").strip() == "oui"


async def notification_a_boutons():
    """notify-send qui sait attendre un bouton (--action, libnotify 0.7.9 ou plus) ; None sinon."""
    ns = programme("notify-send")
    if not ns:
        return None
    try:
        _, out, err = await lancer([ns, "--help"], delai=4)
    except (OSError, asyncio.TimeoutError):
        return None
    return ns if b"--action" in out + err else None


@contextlib.asynccontextmanager
async def tour(verrou, limite):
    """Attend son tour (verrou), mais jamais au-delà de limite (horloge monotone) : True si le verrou est pris, False si
    l'échéance passe avant (la demande expire alors à son échéance, sans rien montrer ni envoyer)."""
    reste = limite - horloge()
    pris = False
    if reste >= 1:
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(verrou.acquire(), reste)
            pris = True
    try:
        yield pris
    finally:
        if pris:
            verrou.release()


class Confirmation:
    def __init__(self, serveur):
        self.serveur = serveur
        self.verrou = asyncio.Lock()           # une carte à la fois ; les autres attendent (et expirent à leur échéance)

    async def demander(self, action, decrite, limite):
        """« autorise », « refuse », « expire » ou « indisponible »."""
        async with tour(self.verrou, limite) as pris:
            reste = limite - horloge()
            if not pris or reste < 1:
                return "expire"
            d = dossier_runtime()
            ident = uuid.uuid4().hex
            for vieux in (d / "reponses").iterdir():                   # réponses à d'anciennes cartes
                with contextlib.suppress(OSError):
                    vieux.unlink()
            # « expire » : l'échéance de CETTE action (heure murale), d'où part le compte à rebours de la carte ;
            # au-delà, la carte n'envoie plus « autoriser » (« Trop tard ») et nc-noeud n'exécute plus rien
            demande = {"id": ident, "serveur": self.serveur, "action": action, "resume": rendre_visible(decrite.resume),
                       "texte": rendre_visible(decrite.texte), "court": COURT, "expire": time.time() + reste,
                       "duree": round(reste)}
            fichier = d / "demande.json"
            ecrire_atomique(fichier, json.dumps(demande, ensure_ascii=False))
            try:
                if await ile_prevenue():
                    return await self.attendre(d / "reponses" / ident, limite)
                ns = await notification_a_boutons()
                if ns and len(rendre_visible(decrite.texte)) <= COURT:
                    return await self.par_notification(ns, decrite, limite)
                return "indisponible"
            finally:
                with contextlib.suppress(OSError):
                    fichier.unlink()
                with contextlib.suppress(OSError):
                    (d / "reponses" / ident).unlink()
                with contextlib.suppress(Exception):
                    await asyncio.shield(ile_prevenue())           # la carte se ferme tout de suite

    async def attendre(self, reponse, limite):
        while horloge() < limite:
            try:
                s = os.lstat(reponse)
                if stat.S_ISREG(s.st_mode) and s.st_uid == os.getuid():
                    v = reponse.read_text(encoding="utf-8").strip()
                    if v in ("autoriser", "refuser"):
                        if horloge() >= limite:                    # lue après l'échéance : trop tard
                            return "tard" if v == "autoriser" else "expire"
                        return "autorise" if v == "autoriser" else "refuse"
            except (FileNotFoundError, UnicodeError):
                pass
            await asyncio.sleep(0.15)
        return "expire"

    async def par_notification(self, ns, decrite, limite):
        """Sans l'île (openSUSE…) : une notification avec Autoriser et Refuser ; le texte entier doit y tenir."""
        reste = limite - horloge()
        corps = rendre_visible(decrite.resume + ("\n\n" + decrite.texte if decrite.texte else ""))
        args = [ns, "-a", "JARVIS", "-u", "critical", "-t", str(int(reste * 1000)),
                "-A", "autoriser=" + T("Autoriser", "Allow"), "-A", "refuser=" + T("Refuser", "Deny"), "--",
                T(f"JARVIS (depuis {self.serveur}) veut :", f"JARVIS (from {self.serveur}) wants to:"),
                html.escape(corps, quote=False)]
        try:
            code, out, _ = await lancer(args, delai=reste)
        except asyncio.TimeoutError:
            return "expire"
        v = out.decode("utf-8", "replace").strip()
        return "autorise" if code == 0 and v == "autoriser" else ("refuse" if v == "refuser" else "expire")


class ConfirmationDistance:
    """Confirmation relayée par le serveur (NOEUD_CONFIRMATION=distance ou les-deux, capacité « remote_confirm ») :
      → {"type": "confirm_request", "req_id": <celui de l'action>, "action": …, "summary": <ce qui sera fait, en entier,
         caractères cachés rendus visibles>, "expires_in": <secondes entières>, "code_required": true}
      ← {"type": "confirm_response", "req_id": …, "decision": "allow", "code": "123456"} ou "decision": "deny"
      ← {"type": "confirm_unavailable", "req_id": …} : le serveur ne peut pas la relayer (personne d'autorisé, chat
         occupé). Ce n'est pas un refus humain : la voie à distance seule est close. En « les-deux », la carte reste
         ouverte et l'écran peut encore autoriser ; en « distance » seule, refus (error_code « remote_unavailable »).
         Pas de période calme (la demande n'a été montrée à personne), pas compté comme un code faux.
      → {"type": "confirm_cancel", "req_id": …} quand la demande se termine sans décision venue de là (décidée sur
         l'écran, expirée, annulée).
    Seul un « allow » reçu avant l'échéance, pour ce req_id exact, avec le bon code TOTP (jamais déjà servi), autorise.
    Un « allow » sans code ou avec un code faux refuse la demande ; toute réponse hors demande en cours est ignorée et
    notée. Le serveur ne connaît pas le secret : sans ton code, il ne peut rien autoriser. Un code déjà servi ne compte
    pas comme un échec ; le serveur reçoit alors error_code « replay » (attendre le code suivant).
    Une seule réponse par req_id, quel qu'en soit le type : la première compte, les suivantes sont ignorées et notées.
    Une seule demande à distance à la fois : JARVIS-BIS remplaçait la demande en attente jusqu'à 9f4cdeb
    (telegram_bot.py:1535-1544), et le code tapé après avoir lu A autorisait B. C'est corrigé à f522291 (un chat occupé
    ne reçoit pas la nouvelle, telegram_bot.py:1570-1574), mais un autre serveur, ou plusieurs nœuds sur le même chat,
    peuvent encore se croiser : on garde ce verrou et la période calme. Les suivantes attendent leur tour et, si leur
    échéance passe avant, expirent sans qu'aucune confirm_request ne parte."""
    GARDEES = 256                       # demandes terminées dont on se souvient (réponse en double ou tardive)

    def __init__(self):
        self.attentes = {}              # req_id → (futur, échéance)
        self.finies = {}                # req_id → « décidée » ou « close » (ordre d'insertion : les plus anciennes d'abord)
        self.verrou = asyncio.Lock()    # une confirm_request en vol par nœud
        self.calme_jusqu = 0.0          # horloge monotone : rien ne part avant (période calme après une fin sans code)

    def impossible(self, ws, req_id, resume):
        return ws is None or ws.ferme or not isinstance(req_id, str) or not req_id or req_id in self.attentes \
            or req_id in self.finies or resume is None or longueur_utf16(resume) > MAX_RESUME_DISTANCE

    async def demander(self, ws, req_id, nom, resume, limite):
        """« autorise », « refuse », « expire » ou « indisponible »."""
        if limite - horloge() < 1:
            return "expire"
        if self.impossible(ws, req_id, resume):
            return "indisponible"
        # Ce verrou n'est jamais tenu en attendant un autre (la carte a le sien, pris dans sa propre tâche) : en
        # « les-deux », pas d'interblocage possible
        async with tour(self.verrou, limite) as pris:
            if not pris or limite - horloge() < 1:
                return "expire"
            # Période calme : tant qu'elle dure, on tient le verrou sans rien envoyer, pour ne pas remplacer chez le
            # serveur la demande précédente qu'une personne est peut-être en train de lire. On n'attend jamais au-delà
            # de notre propre échéance : passé elle, cette demande expire sans jamais partir.
            fin_calme = min(self.calme_jusqu, limite)
            while horloge() < fin_calme:
                await asyncio.sleep(min(0.15, max(0.0, fin_calme - horloge())))
            reste = limite - horloge()
            if reste < 1:
                return "expire"
            if self.impossible(ws, req_id, resume):            # connexion fermée, ou même req_id servi entre-temps
                return "indisponible"
            return await self.relayer(ws, req_id, nom, resume, limite, reste)

    async def relayer(self, ws, req_id, nom, resume, limite, reste):
        futur = asyncio.get_running_loop().create_future()
        self.attentes[req_id] = (futur, limite)
        fin = "close"
        # Calme par défaut : toute fin autre qu'un « allow » ou un « deny » venus du téléphone (expiration, décision sur
        # l'écran, code faux ou rejoué, annulation ou erreur PENDANT l'envoi, qui a peut-être atteint le serveur) garde
        # la voie au calme
        calme = True
        presentee = horloge()                                      # la demande t'est présentée à partir d'ici
        try:
            await ws.envoyer({"type": "confirm_request", "req_id": req_id, "action": nom, "summary": resume,
                              "expires_in": max(1, math.floor(reste)), "code_required": True})
            try:
                v = await asyncio.wait_for(asyncio.shield(futur), max(limite - horloge(), 0))
            except asyncio.TimeoutError:
                return "expire"
            fin = "décidée"
            # Code faux ou rejoué : un autre code peut arriver. Indisponible : montrée à personne, aucun code en route
            calme = v not in ("allow", "deny", "unavailable")
            return {"allow": "autorise", "deny": "refuse", "replay": "rejoue", "unavailable": "injoignable"}.get(v, "code")
        except (OSError, ErreurWS):
            return "indisponible"
        finally:
            self.attentes.pop(req_id, None)
            self.finies[req_id] = fin
            while len(self.finies) > self.GARDEES:
                self.finies.pop(next(iter(self.finies)))
            # Ouvrir la période calme AVANT d'envoyer confirm_cancel et de rendre le verrou : la demande suivante,
            # déjà en attente du verrou, la verra et patientera. La response de CETTE demande, elle, part tout de suite
            # (elle ne passe pas par le verrou), donc avant que la suivante ne relaye.
            if calme:
                # Jusqu'au plus tard de : fin + DISTANCE_CALME, et présentation + FRAPPE_MAX (un code tapé lentement en
                # lisant cette demande). La demande suivante reste bornée par sa propre échéance (voir demander).
                self.calme_jusqu = max(self.calme_jusqu, horloge() + distance_calme(), presentee + frappe_max())
            if fin != "décidée":                                   # l'autre côté a décidé, ou plus personne n'attend
                with contextlib.suppress(Exception):
                    await asyncio.shield(ws.envoyer({"type": "confirm_cancel", "req_id": req_id}))

    def recue(self, msg):
        """Une confirm_response ou une confirm_unavailable du serveur ; ignorée (et notée) si elle ne répond à aucune
        demande en cours. La première réponse pour un req_id compte, de l'un ou l'autre type ; les suivantes sont
        ignorées."""
        genre = "confirm_unavailable" if msg.get("type") == "confirm_unavailable" else "confirm_response"
        rid = msg.get("req_id")
        dec = "unavailable" if genre == "confirm_unavailable" else msg.get("decision")
        montre = str(rid)[:80]
        if not isinstance(rid, str) or rid not in self.attentes:
            raison = {"décidée": "en double", "close": "tardive"}.get(self.finies.get(rid) if isinstance(rid, str) else None,
                                                                     "inconnue")
            journal(genre, montre, f"ignorée ({raison})")
            return
        futur, limite = self.attentes[rid]
        if dec not in ("allow", "deny", "unavailable"):
            journal(genre, montre, "ignorée (décision illisible)")
        elif futur.done():
            journal(genre, montre, "ignorée (en double)")
        elif horloge() >= limite:
            journal(genre, montre, "ignorée (tardive)")
        elif dec == "allow":
            ok, raison = verifier_code_distant(msg.get("code"))
            if not ok:
                journal(genre, montre, f"code refusé ({raison})")
            futur.set_result("allow" if ok else ("replay" if raison == "déjà servi" else "code"))
        else:
            if dec == "unavailable":
                journal(genre, montre, "le serveur ne peut pas relayer (pas un refus)")
            futur.set_result(dec)


def resume_distance(nom, decrite):
    """Ce qui part au serveur pour la confirmation à distance : exactement ce qui sera fait (commande entière, chemin,
    taille, sha256 et premières lignes d'un fichier écrit, texte copié, notification), caractères cachés rendus
    visibles, seules les valeurs secrètes exactes de la configuration masquées. None si ce résumé ne peut pas être
    honnête : un motif générique de secret le changerait (on ne montre pas une commande tronquée), ou il est trop
    long pour un message (compté en UTF-16)."""
    s = decrite.resume
    if nom == "write_file" and decrite.sha:
        s += f"\nsha256 {decrite.sha}"
    if decrite.texte and nom in ("exec", "clipboard_write", "notify", "write_file"):
        s += " :\n" + decrite.texte
    s = rendre_visible(secrets_exacts(s))
    if motifs_trouves(s) or longueur_utf16(s) > MAX_RESUME_DISTANCE:
        return None
    return s


SOURCES = {"ecran": ("écran", "sur le PC", "on the PC"), "distance": ("distance", "à distance", "remotely")}
DECISIONS = {"refuse": ("refusé", "Refusé {o}.", "Denied {o}."),
             "expire": ("expiré (refusé)", "Pas de réponse en {s} s : refusé.", "No answer within {s} s: denied."),
             "tard": ("autorisé trop tard (rien fait)", "Autorisé {o} après {s} s, trop tard : rien n'a été fait.",
                      "Allowed {o} after {s} s, too late: nothing was done."),
             "code": ("refusé (code absent ou faux)", "Code de confirmation absent ou faux : refusé.",
                      "Confirmation code missing or wrong: denied."),
             "rejoue": ("refusé (code déjà servi)", "Code déjà servi : attends le code suivant de l'appli.",
                        "Code already used: wait for the next code of the app."),
             "injoignable": ("refusé (à distance indisponible)",
                             "Le serveur ne peut pas relayer la demande à distance (personne pour la recevoir) : refusé.",
                             "The server cannot relay the remote request (nobody to receive it): denied."),
             "indisponible": ("refusé (pas de confirmation possible)",
                              "Confirmation impossible (ni l'île, ni notification à boutons, ni demande à distance) : refusé.",
                              "Cannot confirm (neither the island, nor a notification with buttons, nor a remote request): denied.")}


# ── Bac à sable (exec en session de confiance) ───────────────────────────────────────────────────────────────────
# Les listes et la commande systemd-run sont dans nc-bac, partagé avec nc-ia (les IA en ligne de commande tournent dans le
# même bac). Ici : le dossier de travail et les réglages propres au nœud (NOEUD_BAC_INTERDITS, NOEUD_BAC_RESEAU).
BAC_INTERDITS = BAC.BAC_INTERDITS


def bac_perso():
    """NOEUD_BAC_INTERDITS : tes dossiers en plus (voir nc-bac). None si une entrée ne convient pas."""
    return BAC.perso(reglage)


def dossier_travail_bac():
    """Le seul dossier où un exec de session peut écrire (ReadWritePaths), créé au besoin."""
    d = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "nc-noeud/travail"
    with contextlib.suppress(OSError):
        d.mkdir(parents=True, exist_ok=True)
    return d


def bac_inaccessibles():
    return BAC.inaccessibles(HOME, reglage)


def bac_argv(cmd, cwd, budget):
    """La commande de systemd-run qui exécute cmd dans le bac, ou None si systemd-run (ou env) est absent. nc-bac y
    met ProtectSystem=strict, /dev/shm en lecture seule, KillSignal=SIGKILL, et « env -i » avec environnement_bac()."""
    return BAC.argv(cmd, cwd, budget, home=HOME, reglage=reglage, programme=programme, ecriture=[dossier_travail_bac()],
                    env=environnement_bac(), reseau_prive=reglage("NOEUD_BAC_RESEAU", "oui") == "non",
                    description="nc-noeud")


def environnement_bac():
    """Les seules variables d'une commande du bac : PATH, HOME, la langue, TZ et TERM=dumb, rien de secret. L'unité
    hérite sinon de tout l'environnement du gestionnaire systemd (environment.d, import-environment : clés d'API du
    profil, SSH_AUTH_SOCK…) ; nc-bac l'efface (env -i) et ne remet que cette liste (valeurs non secrètes)."""
    garder = {"PATH": os.environ.get("PATH") or "/usr/local/bin:/usr/bin:/bin", "HOME": str(HOME), "TERM": "dumb"}
    for k, v in os.environ.items():
        if k in ("LANG", "LANGUAGE", "TZ") or k.startswith("LC_"):
            garder[k] = v
    return [k + "=" + v for k, v in sorted(garder.items()) if "=" not in k and "\0" not in v and "\n" not in v]


async def bac_tient():
    """Une sonde : le bac se met-il en place ici ? (systemd-run présent, bus utilisateur joignable, namespaces permis).
    False → confirmation normale, jamais d'exécution hors du bac."""
    argv = bac_argv(":", str(HOME), 10)                        # mêmes propriétés que le vrai run, commande inoffensive
    if argv is None:
        return False
    try:
        code, _, _ = await lancer(argv, delai=10)
    except (asyncio.TimeoutError, OSError):
        return False
    return code == 0


class Session:
    """Session de confiance (issue #21) : une rafale d'actions couvertes sans redemander. Liée à la connexion (jeton
    tiré à chaque connexion : une reconnexion ferme la session) ET à l'origine EXACTE de l'action qui l'a ouverte.
    Durée FIXE depuis l'ouverture, jamais prolongée ; SESSION_ACTIONS_MAX actions au plus."""
    def __init__(self, jeton, origin, minutes):
        self.jeton = jeton                     # identifie la connexion WebSocket courante
        self.origin = origin                   # origine annoncée (clé stable), vérifiée à l'identique
        self.minutes = minutes
        self.ouverte = horloge()
        self.limite = self.ouverte + minutes * 60
        self.reste = SESSION_ACTIONS_MAX

    def valide(self, jeton, origin):
        return (self.jeton == jeton and origin is not None and self.origin == origin
                and horloge() < self.limite and self.reste > 0)

    def reste_s(self):
        return max(0, int(round(self.limite - horloge())))


# ── Le nœud ───────────────────────────────────────────────────────────────────────────────────────────────────────
class Noeud:
    def __init__(self, c):
        self.c = c
        self.serveur = urllib.parse.urlsplit(c["URL"]).hostname or "?"
        self.confirmation = Confirmation(self.serveur)
        self.distance = ConfirmationDistance()
        self.distance_annoncee = False         # « remote_confirm » envoyé dans le register de cette connexion
        self.ws = None
        self.taches = set()
        self.session = None                    # session de confiance en cours (Session) ou None
        self.jeton_connexion = None            # tiré à chaque connexion : une reconnexion ferme la session
        retenir_secrets(c)

    def fin_action_session(self, sess, resume_court, souci):
        """Une action couverte par la session sess s'est terminée (faite, en échec, trop tard ou refusée) : état relu par
        l'île, notification sur ce PC, et fermeture quand la dernière place est prise."""
        en_cours = self.session is sess
        if en_cours:
            self.ecrire_etat_session(resume_court)
        prevenir(T("JARVIS, session : " + resume_court, "JARVIS, session: " + resume_court),
                 (souci.capitalize() + " · " if souci else "")
                 + T(f"{max(0, sess.reste)} action(s) restantes, {sess.reste_s()} s",
                     f"{max(0, sess.reste)} action(s) left, {sess.reste_s()} s"))
        if en_cours and sess.reste <= 0:
            self.fermer_session(T(f"{SESSION_ACTIONS_MAX} actions atteintes", f"{SESSION_ACTIONS_MAX} actions reached"))

    def fermer_session(self, raison):
        """Ferme la session de confiance (deny, session_end, IA/pilotage coupé, code faux, expiration, « Arrêter »
        depuis l'île) : notifie, note au journal, retire le fichier d'état que l'île lit."""
        if self.session is None:
            return
        self.session = None
        journal("session", T(f"session de confiance ({raison})", f"trust session ({raison})"), "fermée")
        prevenir(T("JARVIS : session terminée", "JARVIS: session ended"), raison)
        with contextlib.suppress(Exception):
            (dossier_runtime() / "session.json").unlink()
        with contextlib.suppress(Exception):
            (dossier_runtime() / "session-stop").unlink()

    def ecrire_etat_session(self, resume_origine):
        """Écrit l'état de la session (XDG_RUNTIME_DIR, 0600) : l'île l'affiche et propose « Arrêter la session »."""
        s = self.session
        if s is None:
            return
        with contextlib.suppress(Exception):
            ecrire_atomique(dossier_runtime() / "session.json", json.dumps(
                {"ouverte": time.time(), "expire": time.time() + s.reste_s(), "reste_s": s.reste_s(),
                 "reste_actions": s.reste, "minutes": s.minutes, "origine": resume_origine[:200],
                 "serveur": self.serveur}, ensure_ascii=False))

    def session_arretee_depuis_ile(self):
        """Vrai si l'île a demandé d'arrêter la session (fichier session-stop) ; le fichier est retiré."""
        try:
            f = dossier_runtime() / "session-stop"
        except Refus:
            return False
        if f.exists():
            with contextlib.suppress(OSError):
                f.unlink()
            return True
        return False

    @staticmethod
    def delai(nom, p, trame=None):
        """Le délai de confirmation de cette action ; NC_NOEUD_DELAI le raccourcit, en tests seulement
        (NC_NOEUD_TESTS=1), jamais en dessous de 0,5 s."""
        return raccourci_tests("NC_NOEUD_DELAI", delai_confirmation(nom, p, trame), 0.5)

    async def confirmer(self, nom, decrite, limite, req_id):
        """(décision, source) : sur l'écran, à distance, ou les deux à la fois (la première décision l'emporte, l'autre
        côté est fermé : la carte disparaît, le serveur reçoit confirm_cancel)."""
        mode = mode_effectif()
        if mode != "ecran" and not self.distance_annoncee:
            # Réglage changé depuis la connexion (nc-reglages relance le service) : le serveur ne sait pas encore
            # relayer ; une personne valide quand même, sur l'écran
            mode = "ecran"
        cotes = {}
        if mode in ("ecran", "les-deux"):
            cotes["ecran"] = asyncio.ensure_future(self.confirmation.demander(nom, decrite, limite))
        if mode in ("distance", "les-deux"):
            cotes["distance"] = asyncio.ensure_future(
                self.distance.demander(self.ws, req_id, nom, resume_distance(nom, decrite), limite))
        resultats = {}
        try:
            en_cours = set(cotes.values())
            while en_cours:
                faits, en_cours = await asyncio.wait(en_cours, return_when=asyncio.FIRST_COMPLETED)
                for source, t in cotes.items():
                    if t in faits:
                        try:
                            resultats[source] = t.result()
                        except Refus as e:
                            print(f"nc-noeud : {e}", file=sys.stderr, flush=True)
                            resultats[source] = "indisponible"
                # Une vraie décision : on n'attend plus l'autre ; un refus arrivé dans le même tour l'emporte
                for d in ("refuse", "code", "rejoue", "autorise", "tard"):
                    for source in ("ecran", "distance"):
                        if resultats.get(source) == d:
                            return d, source
            for d in ("tard", "expire"):
                for source, r in resultats.items():
                    if r == d:
                        return d, source
            # « confirm_unavailable » n'est pas une décision : en « les-deux », on a attendu l'écran ci-dessus ; seule la
            # distance seule finit sur ce refus-là (error_code « remote_unavailable »)
            if resultats and all(r == "injoignable" for r in resultats.values()):
                return "injoignable", "distance"
            return "indisponible", next(iter(resultats), "ecran")
        finally:
            restants = [t for t in cotes.values() if not t.done()]
            for t in restants:
                t.cancel()
            if restants:
                await asyncio.gather(*restants, return_exceptions=True)

    async def decider(self, action, params, req_id=None, trame=None, origin=None):
        """Le résultat à renvoyer au serveur, selon la politique ; tout est noté dans le journal.
        trame : le « timeout » de la trame d'action (secondes, aae5b9b), s'il y en a un.
        origin : l'origine annoncée par le serveur ({"via","chat","conversation"}), pour lier une session de confiance."""
        recu = horloge()                                             # l'échéance part de la réception
        nom = ALIAS.get(action, action)
        try:
            trame = delai_trame(trame)
        except Refus as e:
            journal(nom, "", e.decision)
            return {"success": False, "error": str(e), "denied": True}
        if ia_coupee():
            self.fermer_session(T("IA coupée", "AI off"))
            journal(nom, "", "refusé (IA coupée)")
            return {"success": False, "error": T("L'IA est coupée sur ce PC (IA_MODE=non) : refusé.",
                                                 "AI is turned off on this PC (IA_MODE=non): denied.")}
        if reglage("NOEUD_JARVIS", "non") != "oui":
            self.fermer_session(T("pilotage coupé", "control off"))
            journal(nom, "", "refusé (pilotage coupé)")
            return {"success": False, "error": T("Le pilotage de ce PC par JARVIS est coupé.", "JARVIS control of this PC is off.")}
        if nom not in SANS_CONFIRMATION and nom not in AVEC_CONFIRMATION:
            journal(nom, "", "refusé (action non permise)")
            return {"success": False, "error": T(f"Action non permise sur ce PC : {nom[:40]}", f"Action not allowed on this PC: {nom[:40]}")}
        p = params if isinstance(params, dict) else {}
        try:
            decrite = preparer(nom, p)
        except Refus as e:
            journal(nom, str(e), e.decision)
            return {"success": False, "error": str(e)}
        resume = decrite.resume + (" : " + decrite.texte if decrite.texte else "")
        sha = decrite.sha
        resume_court = rendre_visible(sans_secrets(decrite.resume))[:200]
        # Session de confiance (issue #21) : une rafale d'actions couvertes sans redemander, après UNE autorisation.
        # L'île peut l'arrêter ; l'expiration est relue à chaque action.
        if self.session is not None and self.session_arretee_depuis_ile():
            self.fermer_session(T("arrêtée depuis l'île", "stopped from the island"))
        if self.session is not None and horloge() >= self.session.limite:
            self.fermer_session(T("expirée", "expired"))
        minutes = session_minutes()
        oc = origine_cle(origin)
        peut_session = minutes > 0 and nom in COUVERTES_SESSION and oc is not None
        sess = None
        if peut_session and self.session is not None and self.session.valide(self.jeton_connexion, oc):
            # Réservée tout de suite, avant le moindre await : des actions arrivées ensemble (traitées en parallèle) ne
            # passent pas toutes sur la dernière place, la limite de SESSION_ACTIONS_MAX tient
            sess = self.session
            sess.reste -= 1
        reutilise = sess is not None
        ouvre = peut_session and self.session is None                # une seule session à la fois (origine différente → non)
        if (reutilise or ouvre) and nom == "exec" and not await bac_tient():
            # Le bac ne tient pas (systemd-run absent, pas de bus utilisateur, namespaces refusés) : pas de session,
            # confirmation normale, jamais d'exécution hors du bac
            if reutilise and self.session is sess:
                self.fermer_session(T("bac à sable indisponible", "sandbox unavailable"))
            reutilise = ouvre = False
        if reutilise and self.session is not sess:
            reutilise = False                                        # fermée pendant la sonde (île, refus…) : on confirme
        bac = nom == "exec" and (reutilise or ouvre)                 # un exec de session passe toujours par le bac
        # Commande, fichier, capture, écriture du presse-papiers : toujours une personne qui autorise — sauf une action
        # couverte par une session de confiance en cours
        confirmer = (not reutilise) and (
            nom in AVEC_CONFIRMATION or reglage("NOEUD_SANS_CONFIRMATION", "oui") == "non" or (
                # Un code copié par l'appli (ou KDE Connect) ne doit pas pouvoir être lu par le serveur qui le demande
                nom == "clipboard_read" and mode_confirmation() != "ecran" and totp_secret() is not None))
        try:
            delai = self.delai(nom, p, trame) if confirmer else None
            # Échéance du serveur : annoncée dans la trame, sinon la plus courte connue pour cette action
            echeance = recu + (trame if trame is not None else delai_confirmation(nom, p) + MARGE_SERVEUR)
        except Refus as e:
            if reutilise:            # la place prise se voit, et la session se ferme si c'était la dernière
                self.fin_action_session(sess, resume_court, T("refusé", "denied"))
            journal(nom, resume, sha=sha, decision=("session, " if reutilise else "") + e.decision + " (délai trop court)")
            return {"success": False, "error": str(e), "denied": True}
        source = None
        if confirmer:
            decrite_conf = decrite
            if ouvre:                                                # la carte et le résumé disent qu'une session s'ouvre
                sfx = T(f" et ouvre une session de {minutes} min ({SESSION_ACTIONS_MAX} actions au plus) pour cette conversation",
                        f" and opens a {minutes} min session (at most {SESSION_ACTIONS_MAX} actions) for this conversation")
                decrite_conf = Action(decrite.resume + sfx, decrite.texte, decrite.executer, decrite.sha)
            limite = recu + delai                                    # échéance absolue, horloge monotone
            decision, source = await self.confirmer(nom, decrite_conf, limite, req_id)
            if decision == "autorise" and horloge() >= limite:      # le serveur a déjà abandonné : rien n'est fait
                decision = "tard"
            o = T(SOURCES[source][1], SOURCES[source][2])
            if decision != "autorise":
                if self.session is not None and decision in ("refuse", "code"):
                    self.fermer_session(T("refusé", "denied"))      # un refus (ou un code faux) ferme la session en cours
                d = DECISIONS[decision]
                journal(nom, resume, sha=sha, decision=d[0] + ("" if decision in ("expire", "indisponible", "injoignable")
                                                                 else f" ({SOURCES[source][0]})"))
                codes = {"code": "bad_code", "rejoue": "replay", "injoignable": "remote_unavailable"}
                return {"success": False, "error": T(d[1], d[2]).format(s=f"{delai:g}", o=o), "denied": True,
                        **({"error_code": codes[decision]} if decision in codes else {})}
        # Relu juste avant d'exécuter (B2-09) : couper l'IA ou le pilotage pendant la confirmation l'emporte sur « allow »
        if ia_coupee():
            self.fermer_session(T("IA coupée", "AI off"))
            journal(nom, resume, sha=sha, decision="refusé (IA coupée)")
            return {"success": False, "error": T("L'IA est coupée sur ce PC (IA_MODE=non) : refusé.",
                                                 "AI is turned off on this PC (IA_MODE=non): denied."), "denied": True}
        if reglage("NOEUD_JARVIS", "non") != "oui":
            self.fermer_session(T("pilotage coupé", "control off"))
            journal(nom, resume, sha=sha, decision="refusé (pilotage coupé)")
            return {"success": False, "error": T("Le pilotage de ce PC par JARVIS est coupé.", "JARVIS control of this PC is off."),
                    "denied": True}
        if source == "distance":
            # Le code prouve que tu es là, pas ce que tu as lu : ce PC dit ce qui a été autorisé
            prevenir(T("JARVIS : autorisé à distance", "JARVIS: allowed remotely"),
                     rendre_visible(sans_secrets(resume))[:400])
        if ouvre and confirmer:                                     # ouverture SEULEMENT après une autorisation réussie
            if self.session is None:
                self.session = Session(self.jeton_connexion, oc, minutes)
                self.ecrire_etat_session(resume_court)
                prevenir(T("JARVIS : session ouverte", "JARVIS: session opened"),
                         T(f"Toute demande du serveur pendant {minutes} min passe sans confirmation (dans le bac).",
                           f"Any request from the server for {minutes} min goes through without confirmation "
                           "(in the sandbox)."))
            else:
                ouvre = False          # une autre autorisation, arrivée en même temps, l'a déjà ouverte : pas de remise à zéro
        # Temps qui reste pour exécuter : échéance du serveur, moins la marge, moins ce qui est passé (B2-11)
        budget = echeance - MARGE_SERVEUR - horloge()
        if budget < BUDGET_MIN:
            if reutilise:
                self.fin_action_session(sess, resume_court, T("trop tard, rien fait", "too late, nothing done"))
            journal(nom, resume, sha=sha, decision=(f"autorisé trop tard (rien fait) ({SOURCES[source][0]})" if source
                                                    else ("session, trop tard (rien fait)" if reutilise
                                                          else "trop tard (rien fait)")))
            return {"success": False, "denied": True,
                    "error": T("Trop tard : plus le temps d'exécuter avant que le serveur abandonne, rien n'a été fait.",
                               "Too late: no time left to run before the server gives up, nothing was done.")}
        try:
            appel = decrite.executer(budget, bac) if nom == "exec" else decrite.executer(budget)
            res = await asyncio.wait_for(appel, budget + (0.5 if nom == "exec" else 0))
        except Refus as e:
            if reutilise:
                self.fin_action_session(sess, resume_court, T("refusé", "denied"))
            journal(nom, resume, sha=sha, decision=("session, " if reutilise else "") + e.decision)
            return {"success": False, "error": str(e)}
        except asyncio.TimeoutError:
            b = round(budget, 1)
            res = {"success": False, "error": T(f"Délai de {b:g} s dépassé.", f"{b:g} s timeout exceeded.")}
        except (OSError, UnicodeError) as e:
            res = {"success": False, "error": str(e)[:300]}
        except BaseException:
            # Connexion fermée pendant qu'une commande de session tourne (tâches annulées), ou toute autre erreur : la
            # commande a démarré sans confirmation, elle se voit et se note quand même, puis l'erreur suit son cours
            if reutilise:
                self.fin_action_session(sess, resume_court, T("interrompue", "interrupted"))
                journal(nom, resume, sha=sha, decision="session (interrompue)")
            raise
        if reutilise:
            # Action couverte par la session (déjà décomptée à la décision) : notifiée et journalisée même si la
            # session a été fermée pendant qu'elle tournait
            self.fin_action_session(sess, resume_court, None if res.get("success") else T("échec", "failed"))
            journal(nom, resume, sha=sha, decision="session" + ("" if res.get("success") else " (échec)"))
            return {**res, "session": {"reste_s": sess.reste_s(), "reste_actions": max(0, sess.reste)}}
        journal(nom, resume, sha=sha, decision=(f"autorisé ({SOURCES[source][0]})" if confirmer else "sans confirmation")
                + ("" if res.get("success") else " (échec)"))
        if self.session is not None and ouvre and confirmer:        # l'action qui a ouvert la session : état joint
            res = {**res, "session": {"reste_s": self.session.reste_s(), "reste_actions": self.session.reste}}
        return res

    async def traiter(self, msg):
        req_id = msg.get("req_id")
        try:
            res = await self.decider(str(msg.get("action") or ""), msg.get("params") or {}, req_id, msg.get("timeout"),
                                     msg.get("origin"))
        except Exception as e:                                       # jamais de réponse manquante
            res = {"success": False, "error": T("Erreur sur le PC : ", "Error on the PC: ") + str(e)[:200]}
        with contextlib.suppress(Exception):
            await self.ws.envoyer({**res, "type": "response", "req_id": req_id})

    async def garder(self, ws):
        """Ping WebSocket toutes les 25 s ; rien reçu depuis 75 s : la connexion est morte, on la referme."""
        while not ws.ferme:
            await asyncio.sleep(25)
            if time.monotonic() - ws.dernier > 75:
                await ws.fermer()
                return
            with contextlib.suppress(Exception):
                await ws.trame(0x9, b"nc")

    async def servir(self, ws):
        self.ws = ws
        self.fermer_session(T("reconnexion", "reconnection"))       # une reconnexion ferme toute session de confiance
        self.jeton_connexion = uuid.uuid4().hex                     # lie une session à CETTE connexion
        pc = A.nom_du_pc() or socket.gethostname() or "linux"
        mode = mode_effectif(dire=True)
        self.distance_annoncee = mode in ("distance", "les-deux")
        minutes_session = session_minutes()                         # trust_session annoncé seulement si le réglage est actif
        await ws.envoyer({"type": "register", "node_id": A.client_id(self.c) or pc, "hostname": pc, "os": "linux",
                          "capabilities": CAPACITES + (["remote_confirm"] if self.distance_annoncee else [])
                                        + (["trust_session"] if minutes_session > 0 else []),
                          "metadata": {"client": "nc-noeud", "confirmation": True, "confirmation_mode": mode,
                                       "trust_session_minutes": minutes_session}})
        print(T(f"nc-noeud : connecté à {self.serveur}.", f"nc-noeud: connected to {self.serveur}."), file=sys.stderr, flush=True)
        garde = asyncio.ensure_future(self.garder(ws))
        try:
            while True:
                brut = await ws.recevoir()
                if brut is None:
                    return
                try:
                    msg = json.loads(brut)
                except ValueError:
                    continue
                if not isinstance(msg, dict):
                    continue
                if msg.get("type") == "ping":
                    await ws.envoyer({"type": "pong"})
                elif msg.get("type") in ("confirm_response", "confirm_unavailable"):
                    self.distance.recue(msg)
                elif msg.get("type") in ("totp_prompt", "totp_prompt_cancel"):
                    # JARVIS-BIS be109d5 : invite TOTP pour une action sur UN AUTRE PC. Jamais affichée ici : une fenêtre
                    # qui demande un code d'authentification surgie d'un serveur habituerait à le taper n'importe où.
                    # Pas de réponse non plus : le serveur n'attend rien (l'action se confirme sur l'autre PC ou par
                    # Telegram) et un totp_prompt_response « deny » refuserait l'action de l'autre PC et fermerait sa
                    # session de confiance (node_hub.py, send_confirm_response). Ni fenêtre, ni envoi : une ligne au journal.
                    journal(str(msg.get("type")), str(msg.get("req_id") or "")[:80], "ignorée (invite d'un autre PC)")
                elif msg.get("type") == "session_end":
                    self.fermer_session(T("demande du serveur", "server request"))
                elif msg.get("type") == "action" and msg.get("req_id"):
                    t = asyncio.ensure_future(self.traiter(msg))
                    self.taches.add(t)
                    t.add_done_callback(self.taches.discard)
        finally:
            garde.cancel()
            for t in list(self.taches):
                t.cancel()
            self.fermer_session(T("connexion fermée", "connection closed"))
            await ws.fermer()

    async def boucle(self):
        attente = 3
        while True:
            if reglage("NOEUD_JARVIS", "non") != "oui":
                print(T("nc-noeud : « Laisser JARVIS piloter ce PC » est sur non (nc-reglages) : arrêt.",
                        "nc-noeud: “Let JARVIS control this PC” is off (nc-settings): stopping."), file=sys.stderr)
                return 0
            try:
                ws = await connecter(self.c)
                attente = 3
                await self.servir(ws)
                raison = T("connexion fermée", "connection closed")
            except Definitif:
                raise
            except (OSError, EOFError, asyncio.IncompleteReadError, asyncio.LimitOverrunError, asyncio.TimeoutError,
                    ssl.SSLError, ErreurWS, UnicodeError) as e:
                raison = str(e) or type(e).__name__
            print(T(f"nc-noeud : {raison} ; nouvel essai dans {attente} s.", f"nc-noeud: {raison}; retrying in {attente} s."),
                  file=sys.stderr, flush=True)
            await asyncio.sleep(attente)
            attente = min(attente * 2, 30)


def main():
    global A
    try:
        A = charger_assistant()
    except (OSError, SyntaxError, ImportError):
        print("nc-noeud : nc-assistant introuvable (~/.local/bin).", file=sys.stderr)
        return SORTIE_DEFINITIVE
    args = sys.argv[1:]
    if args and args[0] in ("aide", "help", "-h", "--help"):
        print(T(__doc__, DOC_EN).strip())
        return 0
    if args and args[0] == "totp":
        return commande_totp(args[1:])
    if args:
        print(T("nc-noeud : commande inconnue (nc-noeud aide).", "nc-noeud: unknown command (nc-noeud aide)."), file=sys.stderr)
        return 2
    try:
        c = A.configuration()
        adresse_ws(c)
    except (A.Erreur, Definitif) as e:
        print(f"nc-noeud : {e}", file=sys.stderr)
        return SORTIE_DEFINITIVE
    try:
        return asyncio.run(Noeud(c).boucle())
    except Definitif as e:
        print(f"nc-noeud : {e}", file=sys.stderr)
        return SORTIE_DEFINITIVE


def interrompre(*_):
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrompre)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
