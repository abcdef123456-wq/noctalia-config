HOME = Path.home()
DOC_EN = """This PC as a JARVIS “node” (issue #12), with your confirmation, no external Python dependency.

  nc-noeud            connects to the JARVIS server (nc-noeud.service, off by default) and waits for its requests
  nc-noeud totp creer|verifier CODE|retirer   remote confirmation code (TOTP, for your authenticator app)
  nc-noeud aide       this help

No confirmation: music, notification, clipboard read, lock, folder listing. Confirmation in the island (or a
notification with buttons), remotely (relayed by the server, e.g. on Telegram, with the 6-digit code of your
authenticator app: without your code, the server cannot allow anything), or both: command, file read or write,
screenshot, clipboard write; denied before the server gives up (when the request carries its timeout: that timeout
minus 3 s, a quarter of which, at most 15 s, is kept to run, and at most 60 s; otherwise 12 s for a file, screenshot
or clipboard, 17 s for a relayed action, up to 17 s for a command): never done late, and execution stops 3 s before
the server gives up. Always denied: protected paths, everything while AI is off (IA_MODE=non), any other action.
wss://, or ws:// only to a private or Tailscale host; the secret key goes in the X-Secret-Key header, never in the URL.
Log: ~/.local/state/noctalia-config/noeud.log (0600).
"""

# Délai de confirmation par action, toujours 3 s sous celui du serveur JARVIS-BIS (révision 8ff25c3) : passé ce délai,
# le serveur a déjà répondu « échec » à JARVIS, et rien ne doit plus être fait. Côté serveur (core/node_hub.py,
# core/hardware_relay.py, core/tools/dispatcher.py) :
#   - read_file, write_file : 15 s (NodeHub.read_file, write_file) ;
#   - exec : timeout demandé + 5 s (NodeHub.exec_cmd, qui envoie toujours « timeout ») ;
#   - HardwareRelay.execute (outils « matériels ») : 20 s pour screenshot, lock, clipboard_set, clipboard_get, media,
#     notify et run_shell (envoyé en « exec », avec les paramètres de l'outil : node_id ou node, pas toujours timeout),
#     et pour toute action quand un nœud est désigné ;
#   - send_action par défaut, /api/node/{id}/action : 30 s.
# 64523e5 attend 35 s partout, mais n'annonce ni son délai ni sa révision : sans annonce, on garde le plus court connu.
# Depuis aae5b9b (issue #17), chaque trame d'action porte « timeout » (secondes). Sur ce temps utile (timeout - 3),
# la confirmation prend les trois quarts, 60 s au plus, et laisse le reste pour exécuter : un quart, 15 s au plus
# (issue #20 : taper un code sur le téléphone prend 25 à 40 s, le serveur envoie 65 s pour les actions sensibles).
# 35 → 24 s (8 s pour exécuter), 65 → 47 s (15 s), 80 → 60 s (17 s), 6 → 2 s (1 s) ; sous 6 s, refus direct.
# Dans les deux cas, l'exécution elle-même s'arrête 3 s avant que le serveur abandonne (B2-11).
MARGE_SERVEUR = 3
DELAI_MAX_TRAME = 60               # confirmation la plus longue, même si le serveur annonce plus
RESERVE_EXEC = 15                  # laissées pour exécuter après une confirmation au dernier moment (au plus)
PART_EXEC = 4                      # … ou un quart du temps utile, pour une trame courte
TRAME_ABSURDE = 3600               # au-delà, la valeur annoncée est ignorée (délais connus ci-dessous)
DELAI_CONFIRMATION = 25            # le plus long possible (une commande au long délai)
DELAI_RELAIS = 20 - MARGE_SERVEUR  # 17 s : action peut-être relayée par HardwareRelay (20 s)
DELAIS_FIXES = {"read_file": 15 - MARGE_SERVEUR, "write_file": 15 - MARGE_SERVEUR,
                "screenshot": 12, "clipboard_write": 12}
EXEC_MIN = 2 * MARGE_SERVEUR       # commande (ou trame) au délai plus court : pas le temps de te demander, refus direct
BUDGET_MIN = 1                     # moins d'1 s pour exécuter avant l'abandon du serveur : rien n'est fait
DELAI_ENVOI = 20                   # une écriture WebSocket qui ne passe pas en 20 s : le serveur ne lit plus, on ferme
# Après qu'une demande à distance finit SANS « allow » ni « deny » venus du téléphone (expiration, décision prise sur
# l'écran en « les-deux », code faux ou rejoué, envoi interrompu), on garde le verrou distance au calme avant de relayer
# la suivante : la demande suivante ne doit pas remplacer, chez le serveur, celle que tu es en train de lire, sinon le
# code tapé pour l'une autoriserait l'autre. Le calme dure jusqu'au plus tard de :
#   - la fin de la demande + DISTANCE_CALME (un code encore en route) ;
#   - le moment où elle t'a été présentée + FRAPPE_MAX : taper un code prend 25 à 40 s (mesuré dans l'issue #20), donc
#     une demande qui expire à 12 s laisse un code arriver jusqu'à 40 s après sa présentation.
# Toujours borné par l'échéance de celle qui attend : passé elle, elle expire sans partir. Une confirm_unavailable du
# serveur (personne pour la relayer : la demande n'a été montrée à personne, aucun code n'est en route) n'en ouvre pas.
DISTANCE_CALME = 15
FRAPPE_MAX = 40
MAX_RESUME_DISTANCE = 3500         # résumé envoyé pour la confirmation à distance (un message Telegram : 4096)
MAX_FICHIER = 5 * 1024 * 1024      # lecture et écriture de fichiers, comme le client de l'upstream
MAX_SORTIE = 1024 * 1024           # sortie d'une commande renvoyée au serveur (chaque flux)
MAX_TEXTE = 64 * 1024              # ce que la carte peut montrer en entier : au-delà, pas de confirmation possible
MAX_TRAME = 32 * 1024 * 1024       # message reçu du serveur
COURT = 400                        # caractères montrés avant « Voir tout »
SORTIE_DEFINITIVE = 3              # configuration absente ou refusée : systemd ne relance pas (RestartPreventExitStatus)

# Session de confiance (issue #21) : une rafale d'actions couvertes, sans redemander à chaque fois, après UNE
# autorisation. Désactivée par défaut, courte, et bornée en nombre. Voir la classe Session et le bac à sable plus bas.
SESSION_MINUTES_MAX = 15           # durée demandée au plus (NOEUD_SESSION_MINUTES) ; au-delà ramenée à 15
SESSION_ACTIONS_MAX = 20           # actions couvertes au plus par session (l'action d'ouverture, confirmée, non comprise)
# Ce qu'une session couvre : exec seulement, toujours dans le bac (~ en lecture seule). write_file non : il est fait par
# nc-noeud lui-même, hors du bac, et seuls les chemins protégés le bornent (pensés pour une écriture confirmée, aperçu
# sous les yeux). Jamais read_file, presse-papiers…
COUVERTES_SESSION = frozenset({"exec"})

# Actions du protocole (clients/node_agent.py, core/node_hub.py) : noms de l'upstream ramenés aux nôtres
ALIAS = {"clipboard_get": "clipboard_read", "clipboard_set": "clipboard_write", "run_shell": "exec"}
SANS_CONFIRMATION = {"media", "notify", "clipboard_read", "lock", "list_files"}
AVEC_CONFIRMATION = {"exec", "read_file", "write_file", "screenshot", "clipboard_write"}
CAPACITES = ["exec", "read_file", "write_file", "list_files", "screenshot", "lock", "clipboard_get", "clipboard_set",
             "media", "notify"]
MEDIA = {"play", "pause", "play-pause", "next", "previous", "stop", "status", "metadata", "volume"}

