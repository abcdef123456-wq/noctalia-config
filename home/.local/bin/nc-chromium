#!/usr/bin/env python3
"""nc-chromium COMMANDE [ARGUMENTS…] : lance un navigateur Chromium (Chrome, Brave, Vivaldi, Edge…) par XWayland, pour
pouvoir glisser un onglet vers une autre fenêtre. Hyprland n'a pas le protocole xdg_toplevel_drag_v1 dont Chromium a besoin
en Wayland natif ; en X11, il déplace ses fenêtres lui-même.

Ajoute --ozone-platform=x11 et --force-device-scale-factor=<échelle de l'écran actif> (la config d'Hyprland a
xwayland.force_zero_scaling : XWayland ne met rien à l'échelle, sinon l'interface serait minuscule).
Lancement normal, sans ces drapeaux, quand :
  - le réglage NAVIGATEURS_XWAYLAND (nc-reglages → Fenêtres) n'est pas « oui » (défaut : non) ;
  - NC_CHROMIUM_WAYLAND=1 ;
  - il n'y a pas de DISPLAY (pas d'XWayland) ;
  - l'utilisateur a déjà donné --ozone-platform.
L'échelle vient de GDK_SCALE si elle est posée, sinon de « hyprctl monitors -j » (lecture seule), sinon 1.
COMMANDE peut être le navigateur ou « flatpak run … ID » : les drapeaux vont alors après l'identifiant de l'appli.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path


def reglage(cle, defaut):
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    try:
        for l in (Path(base) / "nc/reglages.conf").read_text(encoding="utf-8", errors="replace").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"') or defaut
    except OSError:
        pass
    return defaut


def echelle():
    """Échelle de l'écran actif : 1 si on ne sait pas."""
    try:
        v = float(os.environ.get("GDK_SCALE", ""))
        if v > 0:
            return v
    except ValueError:
        pass
    try:
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        ecrans = json.loads(r.stdout)
        actif = next((e for e in ecrans if e.get("focused")), ecrans[0])
        v = float(actif.get("scale", 1))
        return v if v > 0 else 1.0
    except Exception:
        return 1.0


def position_drapeaux(cmd):
    """Où insérer les drapeaux dans cmd : après le programme (et après l'identifiant de l'appli pour flatpak run)."""
    i = 0
    if os.path.basename(cmd[0]) == "env":
        i = 1
        while i < len(cmd) and (cmd[i].startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", cmd[i])):
            i += 1
    if i >= len(cmd):
        return len(cmd)
    if os.path.basename(cmd[i]) == "flatpak" and "run" in cmd[i + 1:]:
        j = cmd.index("run", i + 1) + 1
        while j < len(cmd) and cmd[j].startswith("-"):
            j += 1
        return min(j + 1, len(cmd))
    return i + 1


def main(args):
    if not args:
        sys.exit("Usage : nc-chromium <navigateur> [arguments]")
    if os.path.basename(args[0]) == "nc-chromium":      # déjà enveloppé : on saute le doublon
        args = args[1:]
        if not args:
            sys.exit("Usage : nc-chromium <navigateur> [arguments]")
    drapeaux = []
    if (reglage("NAVIGATEURS_XWAYLAND", "non") == "oui" and os.environ.get("NC_CHROMIUM_WAYLAND") != "1"
            and os.environ.get("DISPLAY") and not any(a == "--ozone-platform" or a.startswith("--ozone-platform=") for a in args)):
        drapeaux = ["--ozone-platform=x11", "--force-device-scale-factor=%g" % echelle()]
    p = position_drapeaux(args)
    cmd = args[:p] + drapeaux + args[p:]
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        sys.exit("nc-chromium : %s : %s" % (cmd[0], e.strerror))


if __name__ == "__main__":
    main(sys.argv[1:])
