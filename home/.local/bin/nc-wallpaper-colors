#!/usr/bin/env python3
"""nc-wallpaper-colors : choisit la méthode de couleurs Noctalia la plus adaptée au fond d'écran.

Appelé par le hook Noctalia v5 « wallpaper_changed » (chemin dans NOCTALIA_WALLPAPER_PATH) ou avec l'image en argument.
  - image colorée       -> « vibrant » : reprend la couleur marquante (orange du tigre, rouge d'une voiture…)
  - image quasi neutre  -> « muted »   : palette sobre, sans couleur inventée (photo noir et blanc…)
Mesure : 98e centile de la chroma OKLCH (capte aussi une petite zone vive, ex. un feu arrière) sur une miniature 64x64, en ignorant les pixels très sombres et très clairs.
Usage : nc-wallpaper-colors [IMAGE] [--dry-run]
"""
import json
import math
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# ImageMagick 7 (magick) ou 6 (convert, Debian et Ubuntu) : même syntaxe ici
MAGICK = shutil.which("magick") or shutil.which("convert") or "magick"
MAGICK_ABSENT = not (shutil.which("magick") or shutil.which("convert"))
DELAI = int(os.environ.get("NC_WALLPAPER_DELAI") or 60)      # secondes laissées à ImageMagick par image (une image géante ne bloque pas le hook Noctalia)


def paquet_magick():
    """Nom du paquet ImageMagick de la famille de la distribution (/etc/os-release) : imagemagick sur Arch et Debian,
    ImageMagick sur Fedora et openSUSE."""
    ids = ""
    try:
        for l in open("/etc/os-release", encoding="utf-8", errors="replace"):
            if l.startswith(("ID=", "ID_LIKE=")):
                ids += " " + l.split("=", 1)[1].strip().strip('"').lower()
    except OSError:
        pass
    if any(m in ids for m in ("fedora", "rhel", "suse")):
        return "ImageMagick"
    return "imagemagick"

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-wallpaper-colors: picks the Noctalia color method that best suits the wallpaper.

Called by the Noctalia v5 "wallpaper_changed" hook (path in NOCTALIA_WALLPAPER_PATH) or with the image as argument.
  - colorful image      -> "vibrant": takes the striking color (orange of the tiger, red of a car…)
  - near-neutral image  -> "muted"  : understated palette, no invented color (black and white photo…)
Measure: 98th percentile of the OKLCH chroma (also catches a small vivid area, e.g. a tail light) on a 64x64 thumbnail, ignoring very dark and very bright pixels.
Usage: nc-wallpaper-colors [IMAGE] [--dry-run]
"""

THRESHOLD = 0.045  # chroma OKLCH ; au-dessous : image considérée comme neutre


def _lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def oklch(r, g, b):
    r, g, b = _lin(r / 255), _lin(g / 255), _lin(b / 255)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B)


def colorfulness(path):
    raw = subprocess.run([MAGICK, str(path) + "[0]", "-resize", "64x64!", "-colorspace", "sRGB", "-depth", "8", "rgb:-"],
                         capture_output=True, check=True, timeout=DELAI).stdout
    chromas = sorted(c for L, c in (oklch(*raw[i:i + 3]) for i in range(0, len(raw) - 2, 3)) if 0.08 < L < 0.95)
    if not chromas:
        return 0.0
    return chromas[min(len(chromas) - 1, int(len(chromas) * 0.98))]


def boot_size():
    """Définition du plus grand écran branché (2560x1600 si Hyprland ne répond pas)."""
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout)
        w, h = max(((m["width"], m["height"]) for m in mons), key=lambda wh: wh[0] * wh[1])
        return f"{w}x{h}"
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return "2560x1600"


def main():
    args = [a for a in sys.argv[1:] if a != "--dry-run"]
    src = args[0] if args else os.environ.get("NOCTALIA_WALLPAPER_PATH", "")
    if any(a in ("-h", "--help") for a in args):
        print(T(__doc__, USAGE_EN))
        return
    if not src:
        sys.exit(T(__doc__, USAGE_EN))
    img = Path(src).expanduser()
    if not img.is_file():
        sys.exit(T(f"nc-wallpaper-colors : image introuvable : {img}", f"nc-wallpaper-colors: image not found: {img}"))
    if MAGICK_ABSENT:
        pq = paquet_magick()
        sys.exit(T(f"nc-wallpaper-colors : ImageMagick manquant (paquet {pq}) : installe-le, nc-maj le fait aussi",
                   f"nc-wallpaper-colors: ImageMagick missing (package {pq}): install it, nc-update does it too"))
    # Copie réduite du fond, affichée dès l'ouverture de session avant Noctalia (nc-boot-wallpaper). Écrite dans un
    # temporaire du même dossier puis posée d'un coup : une image illisible ou une coupure ne laisse jamais un JPEG cassé.
    boot = tmp = None
    if "--dry-run" not in sys.argv:
        boot = Path.home() / ".cache/nc/wallpaper-boot.jpg"
        boot.parent.mkdir(parents=True, exist_ok=True)
        tmp = boot.with_name(f".wallpaper-boot.{os.getpid()}.tmp")
        size = boot_size()
        try:
            copie = subprocess.Popen([MAGICK, str(img) + "[0]", "-resize", size + "^", "-gravity", "center",
                                      "-extent", size, "-quality", "90", "jpg:" + str(tmp)])
        except OSError:
            copie = None
    try:
        c = colorfulness(img)
    except subprocess.TimeoutExpired:
        sys.exit(T(f"nc-wallpaper-colors : image trop lourde, lecture abandonnée au bout de {DELAI} s : {img}",
                   f"nc-wallpaper-colors: image too heavy, reading given up after {DELAI} s: {img}"))
    except (subprocess.CalledProcessError, OSError):
        sys.exit(T(f"nc-wallpaper-colors : image illisible : {img}", f"nc-wallpaper-colors: unreadable image: {img}"))
    finally:
        if tmp is not None:
            ok = False
            if copie is not None:
                try:
                    ok = copie.wait(timeout=DELAI) == 0
                except subprocess.TimeoutExpired:
                    copie.kill()                  # le fils lancé ici, et lui seul
                    copie.wait()
            if ok:
                try:
                    os.replace(tmp, boot)
                except OSError:
                    pass
            try:
                tmp.unlink()
            except OSError:
                pass
    method = "vibrant" if c >= THRESHOLD else "muted"
    print(f"{img.name}: chroma={c:.3f} -> {method}")
    if "--dry-run" in sys.argv:
        return
    cur = subprocess.run(["noctalia", "msg", "color-scheme-get"], capture_output=True, text=True).stdout.split()
    if cur != ["wallpaper", method]:
        subprocess.run(["noctalia", "msg", "color-scheme-set", "wallpaper", method], check=False,
                       stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
