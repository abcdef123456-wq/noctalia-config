#!/usr/bin/env python3
"""nc-verrou-place : place l'écran de verrouillage (heure, musique, mot de passe, batterie) au centre de l'écran réel.

install.sh calcule ces positions d'après l'écran vu pendant l'installation ; si l'échelle choisie ensuite diffère, si
un autre écran était branché ou si l'écran change, tout se retrouvait décalé. Relancé à chaque ouverture de session et
à chaque écran branché (nc/ecrans.lua) : ~/.config/noctalia/zx-verrou.toml (centre et hauteurs en proportion de
l'écran du portable, sinon du premier écran), rechargé par Noctalia seulement s'il change.
Noctalia recopie aussi ces positions dans son état (~/.local/state/noctalia/settings.toml, après une modification
depuis ses réglages ou une mise à jour), qui passe avant la config : elles y sont recentrées de la même façon (sinon,
chez certains, l'heure restait en bas à droite pour toujours).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

try:
    import tomllib
except ImportError:           # Python < 3.11 : rien à faire sans lecteur TOML (les positions de l'installation restent)
    sys.exit(0)

# Les dossiers de Noctalia, comme lui (configDir, stateDir de src/util/file_utils.h) : NOCTALIA_*_HOME, puis
# XDG_*_HOME, puis ~/.config et ~/.local/state ; sinon les positions iraient dans un fichier que Noctalia ne lit pas
DIR = os.path.join(os.environ.get("NOCTALIA_CONFIG_HOME") or os.environ.get("XDG_CONFIG_HOME")
                   or os.path.expanduser("~/.config"), "noctalia")
OUT = os.path.join(DIR, "zx-verrou.toml")
ETAT = os.path.join(os.environ.get("NOCTALIA_STATE_HOME") or os.environ.get("XDG_STATE_HOME")
                    or os.path.expanduser("~/.local/state"), "noctalia", "settings.toml")
# Hauteur de chaque élément, en proportion de l'écran (mêmes valeurs que install.sh)
HAUTEUR = {"nc/verrou:heure": 0.30, "nc/verrou:musique": 0.64, "login_box": 0.86, "nc/verrou:batterie": 0.93}


def ecrire(chemin, contenu):
    """Écrit le fichier d'un coup : temporaire au nom unique dans le même dossier (deux exécutions qui se croisent ne
    partagent jamais le même fichier), mêmes droits que l'ancien fichier (os.replace les perdait), puis os.replace."""
    fd, tmp = tempfile.mkstemp(prefix=os.path.basename(chemin) + ".", suffix=".nc-tmp", dir=os.path.dirname(chemin))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(contenu)
        try:
            shutil.copymode(chemin, tmp)             # le fichier existe : ses droits sont gardés
        except OSError:
            masque = os.umask(0)
            os.umask(masque)
            os.chmod(tmp, 0o666 & ~masque)           # nouveau fichier : droits habituels (mkstemp donne 0600)
        os.replace(tmp, chemin)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def nettoyer_etat(lignes, widgets, ordre):
    """Noctalia ajoute son propre champ de mot de passe (« lockscreen-login-box@ÉCRAN », grand cadre d'origine) pour
    chaque écran qui n'en a pas à son nom : écran renommé (eDP-1 / eDP-2 selon la carte graphique), écran de secours
    (FALLBACK), projecteur… et les met dans son ordre d'affichage à la place des nôtres : l'écran de verrouillage
    redevenait celui d'origine. On les retire de l'état et on y remet l'ordre de la config."""
    sortie, saute = [], False
    for x in lignes:
        m = re.match(r'\s*\[lockscreen_widgets\.widget\.(?:"([^"]*)"|([^.\]]+))', x)
        if m:
            nom = m.group(1) or m.group(2)
            saute = nom.startswith("lockscreen-login-box@") and nom not in widgets
        elif re.match(r"\s*\[", x):
            saute = False
        if saute:
            continue
        if ordre and re.match(r"\s*widget_order\s*=", x):
            x = re.match(r"(\s*)", x).group(1) + "widget_order = [ " + ", ".join(json.dumps(o) for o in ordre) + " ]"
        sortie.append(x)
    return sortie


def recentrer_etat(nom_ecran, l, h, widgets, ordre):
    """Mêmes positions dans l'état de Noctalia (édité ligne à ligne : le reste du fichier ne bouge pas). Vrai si changé."""
    try:
        with open(ETAT, encoding="utf-8") as f:
            lignes = nettoyer_etat(f.read().split("\n"), widgets, ordre)
            f.seek(0)
            avant = f.read().split("\n")
    except OSError:
        return False
    # Sections [lockscreen_widgets.widget.NOM] (pas leurs .settings) : début, fin, type
    sections, debut = [], None
    for i, x in enumerate(lignes + ["["]):
        if re.match(r"\s*\[", x):
            if debut is not None:
                sections.append((debut, i))
            debut = i if re.match(r"\s*\[lockscreen_widgets\.widget\.(\"[^\"]*\"|[^.\]]+)\]\s*$", x) else None
    for d, f in sections:
        corps = "\n".join(lignes[d:f])
        t = re.search(r'^\s*type\s*=\s*"([^"]*)"', corps, re.M)
        part = HAUTEUR.get(t.group(1)) if t else None
        if part is None:
            continue
        valeurs = {"cx": f"{l / 2:.1f}", "cy": f"{h * part:.1f}", "output": json.dumps(nom_ecran),
                   "placement_width": f"{l:.1f}", "placement_height": f"{h:.1f}"}
        for i in range(d + 1, f):
            m = re.match(r"(\s*)(cx|cy|output|placement_width|placement_height)\s*=", lignes[i])
            if m:
                lignes[i] = f"{m.group(1)}{m.group(2)} = {valeurs[m.group(2)]}"
    if lignes == avant:
        return False
    ecrire(ETAT, "\n".join(lignes))
    return True


def main():
    try:
        ecrans = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)
        with open(os.path.join(DIR, "config.toml"), "rb") as f:
            config = tomllib.load(f).get("lockscreen_widgets", {})
        widgets, ordre = config.get("widget", {}), config.get("widget_order", [])
    except (OSError, ValueError):
        return
    ecrans = [e for e in ecrans if not e.get("disabled")]
    if not ecrans or not widgets:
        return
    e = next((e for e in ecrans if e["name"].startswith(("eDP", "LVDS", "DSI"))), ecrans[0])
    l, h = e["width"] / e["scale"], e["height"] / e["scale"]
    if e.get("transform", 0) % 2:
        l, h = h, l
    texte = "# Écrit par nc-verrou-place : écran de verrouillage centré sur l'écran réel. Ne pas éditer.\n"
    for nom, w in widgets.items():
        part = HAUTEUR.get(w.get("type"))
        if part is None:
            continue
        cle = nom if nom.replace("-", "").replace("_", "").isalnum() else json.dumps(nom)
        texte += (f"\n[lockscreen_widgets.widget.{cle}]\ntype = {json.dumps(w['type'])}\noutput = {json.dumps(e['name'])}\n"
                  f"cx = {l / 2:.1f}\ncy = {h * part:.1f}\n")
    change = recentrer_etat(e["name"], l, h, widgets, ordre)
    try:
        if open(OUT, encoding="utf-8").read() == texte and not change:
            return
    except OSError:
        pass
    ecrire(OUT, texte)
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True)


if __name__ == "__main__":
    import sys as _sys
    if len(_sys.argv) > 1:          # un argument inconnu ne lance rien : usage et code 2 (-h, --help, aide : usage et code 0)
        _aide = _sys.argv[1] in ("-h", "--help", "aide")
        print("usage : %s (sans argument)" % __import__("os").path.basename(_sys.argv[0]), file=_sys.stdout if _aide else _sys.stderr)
        _sys.exit(0 if _aide else 2)
    main()
