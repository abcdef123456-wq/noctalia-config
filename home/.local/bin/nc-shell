#!/usr/bin/env bash
# nc-shell : état de la barre Noctalia v5 (barre, menus, fond d'écran).
#   nc-shell            afficher l'état
#   nc-shell restart    la redémarrer (les fenêtres ouvertes ne sont pas fermées)
set -euo pipefail
UNIT=noctalia.service
case "${1:-}" in
  "") systemctl --user is-active --quiet "$UNIT" && echo "Noctalia v5 active." || echo "Noctalia v5 arrêtée : nc-shell restart" ;;
  restart)
    systemctl --user restart "$UNIT"; sleep 2
    systemctl --user is-active --quiet "$UNIT" && echo "Noctalia v5 redémarrée." || { echo "Noctalia n'a pas démarré : journalctl --user -u $UNIT" >&2; exit 1; } ;;
  *) sed -n '2,4p' "$0"; exit 1 ;;
esac
