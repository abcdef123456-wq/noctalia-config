POURQUOI_EN = ("Why so many small commands? Each one does a single thing, and anything can call it: keyboard shortcuts, "
               "the island, the bar, services, and you in the terminal. They work the same on Arch, Debian and Fedora, "
               "can be tested one by one, and updates replace them without ever touching your settings (~/.config/nc).")


def nom_affiche(nom):
    return NOMS_ANGLAIS.get(nom, nom) if EN else nom


def en_anglais(lignes):
    """Les lignes (commande, exemple, explication) en anglais (explication française si pas encore traduite)."""
    return [(n, *ANGLAIS.get(n, (ex, txt))) if EN else (n, ex, txt) for n, ex, txt in lignes]


POURQUOI = ("Pourquoi autant de petites commandes ? Chacune fait une seule chose, et tout le monde peut l'appeler : "
            "les raccourcis clavier, l'île, la barre, les services et toi dans le terminal. Elles marchent pareil sur "
            "Arch, Debian et Fedora, se testent une par une, et les mises à jour les remplacent sans jamais toucher à "
            "tes réglages (~/.config/nc).")


def couleurs():
    """Accent du thème (île) pour les titres, si le terminal sait afficher les couleurs."""
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return "", "", "", ""
    acc = "\033[1m"
    try:
        import json
        with open(os.path.expanduser("~/.config/nc/palette-ile.json"), encoding="utf-8") as f:
            h = json.load(f)["accent"].lstrip("#")
        acc = "\033[1;38;2;%d;%d;%dm" % tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except (OSError, ValueError, KeyError):
        pass
    return acc, "\033[1m", "\033[2m", "\033[0m"


def couper(texte, largeur, retrait):
    import textwrap
    return textwrap.fill(texte, max(30, largeur), initial_indent="", subsequent_indent=" " * retrait)


def tout():
    acc, gras, doux, fin = couleurs()
    largeur = min(110, shutil.get_terminal_size((100, 30)).columns)
    col = 16
    print(T(f"\n{acc}Les commandes de noctalia-config{fin}   {doux}nc-aide NOM : le détail d'une commande{fin}\n",
            f"\n{acc}noctalia-config commands{fin}   {doux}nc-help NAME: details of one command{fin}\n"))

    def bloc(titre, sous_titre, lignes):
        print(f"{acc}{titre}{fin}  {doux}{sous_titre}{fin}")
        for nom, ex, txt in lignes:
            if not os.path.exists(os.path.join(BIN, nom)) and nom not in ("nc-aide",):
                continue
            t = couper(txt, largeur - col - 4, col + 4)
            print(f"  {gras}{nom_affiche(nom):<{col}}{fin}  {t}")
            if ex and ex != nom_affiche(nom):
                print(f"  {'':<{col}}  {doux}{T('ex. : ', 'e.g. ')}{ex}{fin}")
        print()

    bloc(T("À taper toi-même", "Type them yourself"), "", en_anglais(A_TAPER))
    bloc(T("Derrière les raccourcis", "Behind the shortcuts"), T("(tu peux aussi les taper)", "(you can type them too)"),
         en_anglais(RACCOURCIS))
    bloc(T("Automatiques", "Automatic"), T("(rien à faire : services et démarrage)", "(nothing to do: services and startup)"),
         en_anglais([(n, "", t) for n, t in AUTOMATIQUES]))
    print(f"{doux}{couper(T(POURQUOI, POURQUOI_EN), largeur - 2, 0)}{fin}\n")


def detail(nom):
    if not nom.startswith(("nc-", "nvidia-", "cmatrix")):
        nom = "nc-" + nom
    francais = {v: k for k, v in NOMS_ANGLAIS.items()}
    nom = francais.get(nom, nom)              # nom anglais (nc-settings…) : celui du script
    chemin = os.path.join(BIN, nom)
    if not os.path.isfile(chemin):
        sys.exit(T(f"nc-aide : pas de commande « {nom} » (nc-aide pour la liste)",
                   f"nc-help: no command “{nom}” (nc-help for the list)"))
    acc, gras, doux, fin = couleurs()
    connu = {n: t for n, _, t in en_anglais(A_TAPER + RACCOURCIS + [(n, "", t) for n, t in AUTOMATIQUES])}
    print(f"\n{acc}{nom_affiche(nom)}{fin}" + (f"  {doux}({nom}){fin}" if nom_affiche(nom) != nom else ""))
    if nom in connu:
        print(f"  {connu[nom]}\n")
    # L'en-tête du script : commentaires (#) ou docstring Python, jusqu'au code
    lignes = []
    with open(chemin, encoding="utf-8", errors="replace") as f:
        texte = f.read().splitlines()[1:]
    if EN:
        # En anglais : l'aide anglaise du script (DOC_EN = """…""" en Python), sinon rien (son en-tête est en français)
        tout_texte = "\n".join(texte)
        m = re.search(r'^(?:DOC_EN|USAGE_EN)\s*=\s*(?:\(\s*)?"""(.*?)"""', tout_texte, re.S | re.M)
        texte = ['"""'] + m.group(1).splitlines() + ['"""'] if m else []
    if texte and texte[0].startswith('"""'):
        for l in texte:
            lignes.append(l.replace('"""', ""))
            if l.rstrip().endswith('"""') and len(lignes) > 1 or l.strip() == '"""' and len(lignes) > 1:
                break
    else:
        for l in texte:
            if not l.startswith("#"):
                break
            lignes.append(re.sub(r"^# ?", "", l))
    for l in lignes:
        if l.strip():
            print(f"  {doux if not l.startswith(' ') else ''}{l}{fin}")
    print()


def main():
    a = sys.argv[1:]
    if not a:
        tout()
    elif a[0] in ("-h", "--help"):
        print(T(__doc__, DOC_EN).strip())
    else:
        detail(a[0])


if __name__ == "__main__":
    main()
