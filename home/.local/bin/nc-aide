    ("nc-claude", "nc-claude etat", "Claude Code dans l'île (comme coucou) : ce qu'il fait, quand il a fini, ses "
                                    "demandes ; nc-claude installer / retirer."),
    ("nc-meteo", "nc-meteo texte", "La météo (Open-Meteo, sans compte), comme dans l'île ; ville : nc-reglages → Île."),
    ("nc-memoire", "nc-memoire", "Qui utilise la mémoire : la config d'un côté, tes applis de l'autre."),
    ("nc-pouls", "nc-pouls diag", "Halo musical : « diag » dit pourquoi il ne pulse pas."),
    ("nc-sysinfo", "nc-sysinfo sante", "Infos du PC : modele, ecrans, disques, sante (usure de la batterie)…"),
    ("nvidia-run", "nvidia-run steam", "Lance un programme sur la carte NVIDIA d'un PC hybride."),
    ("cmatrix", "cmatrix", "Pluie façon Matrix dans le terminal, aux couleurs du thème."),
]
RACCOURCIS = [
    ("nc-capture", "nc-capture zone", "Captures d'écran (Impr. écran, Super + P…), enregistrées et copiées."),
    ("nc-brightness", "nc-brightness set 50", "Luminosité de l'écran (touches de luminosité, F5 / F6)."),
    ("nc-media", "nc-media play-pause", "Touches de musique : visent le lecteur qu'on entend."),
