    ("nc-shell", "État de la barre Noctalia."),
]

POURQUOI = ("Pourquoi autant de petites commandes ? Chacune fait une seule chose, et tout le monde peut l'appeler : "
            "les raccourcis clavier, l'île, la barre, les services et toi dans le terminal. Elles marchent pareil sur "
            "Arch, Debian et Fedora, se testent une par une, et les mises à jour les remplacent sans jamais toucher à "
            "tes réglages (~/.config/nc).")


def couleurs():
    """Accent du thème (île) pour les titres, si le terminal sait afficher les couleurs."""
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return "", "", "", ""
    acc = "\033[1m"
    try:
        import json
        with open(os.path.expanduser("~/.config/nc/palette-ile.json"), encoding="utf-8") as f:
            h = json.load(f)["accent"].lstrip("#")
        acc = "\033[1;38;2;%d;%d;%dm" % tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except (OSError, ValueError, KeyError):
        pass
    return acc, "\033[1m", "\033[2m", "\033[0m"


def couper(texte, largeur, retrait):
    import textwrap
    return textwrap.fill(texte, max(30, largeur), initial_indent="", subsequent_indent=" " * retrait)


def tout():
    acc, gras, doux, fin = couleurs()
    largeur = min(110, shutil.get_terminal_size((100, 30)).columns)
    col = 16
    print(f"\n{acc}Les commandes de noctalia-config{fin}   {doux}nc-aide NOM : le détail d'une commande{fin}\n")

    def bloc(titre, sous_titre, lignes):
        print(f"{acc}{titre}{fin}  {doux}{sous_titre}{fin}")
        for nom, ex, txt in lignes:
            if not os.path.exists(os.path.join(BIN, nom)) and nom not in ("nc-aide",):
                continue
            t = couper(txt, largeur - col - 4, col + 4)
            print(f"  {gras}{nom:<{col}}{fin}  {t}")
            if ex and ex != nom:
                print(f"  {'':<{col}}  {doux}ex. : {ex}{fin}")
        print()

    bloc("À taper toi-même", "", A_TAPER)
    bloc("Derrière les raccourcis", "(tu peux aussi les taper)", RACCOURCIS)
    bloc("Automatiques", "(rien à faire : services et démarrage)", [(n, "", t) for n, t in AUTOMATIQUES])
    print(f"{doux}{couper(POURQUOI, largeur - 2, 0)}{fin}\n")


def detail(nom):
    if not nom.startswith(("nc-", "nvidia-", "cmatrix")):
        nom = "nc-" + nom
    chemin = os.path.join(BIN, nom)
    if not os.path.isfile(chemin):
        sys.exit(f"nc-aide : pas de commande « {nom} » (nc-aide pour la liste)")
    acc, gras, doux, fin = couleurs()
    connu = {n: t for n, _, t in A_TAPER + RACCOURCIS} | dict(AUTOMATIQUES)
    print(f"\n{acc}{nom}{fin}")
    if nom in connu:
        print(f"  {connu[nom]}\n")
    # L'en-tête du script : commentaires (#) ou docstring Python, jusqu'au code
    lignes = []
    with open(chemin, encoding="utf-8", errors="replace") as f:
        texte = f.read().splitlines()[1:]
    if texte and texte[0].startswith('"""'):
        for l in texte:
            lignes.append(l.replace('"""', ""))
            if l.rstrip().endswith('"""') and len(lignes) > 1 or l.strip() == '"""' and len(lignes) > 1:
                break
    else:
        for l in texte:
            if not l.startswith("#"):
                break
            lignes.append(re.sub(r"^# ?", "", l))
    for l in lignes:
        if l.strip():
            print(f"  {doux if not l.startswith(' ') else ''}{l}{fin}")
    print()


def main():
    a = sys.argv[1:]
    if not a:
        tout()
    elif a[0] in ("-h", "--help"):
        print(__doc__.strip())
    else:
        detail(a[0])


if __name__ == "__main__":
    main()
