    ("nc-apps", "", "La liste des applis et des fichiers pour la recherche (Super + R)."),
]
AUTOMATIQUES = [
    ("nc-profile-sync", "Adapte tout au profil d'énergie et au secteur : fréquence de l'écran, effets, luminosité."),
    ("nc-theme-sync", "Couleurs du terminal, des bordures et de l'île, tirées du fond d'écran."),
    ("nc-wallpaper-colors", "Choisit la façon de tirer les couleurs du fond d'écran."),
    ("nc-icones", "Dessine les icônes du terminal et des fichiers aux couleurs du thème."),
    ("nc-couvercle", "Couvercle fermé : veille, ou écran éteint et PC qui continue (réglable)."),
