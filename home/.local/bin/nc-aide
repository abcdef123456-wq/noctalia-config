#!/usr/bin/env python3
"""nc-aide : à quoi sert chaque commande de noctalia-config.
  nc-aide          toutes les commandes, rangées : celles à taper, celles des raccourcis, celles qui tournent seules
  nc-aide NOM      le détail d'une commande (ce qu'elle fait, ses options)
"""
import os
import re
import shutil
import sys


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


DOC_EN = """nc-help: what each noctalia-config command is for.
  nc-help          every command, grouped: the ones you type, the ones behind shortcuts, the ones that run on their own
  nc-help NAME     details of one command (what it does, its options)
"""

BIN = os.path.expanduser("~/.local/bin")

