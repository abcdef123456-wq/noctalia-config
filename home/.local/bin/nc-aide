#!/usr/bin/env python3
"""nc-aide : à quoi sert chaque commande de noctalia-config.
  nc-aide          toutes les commandes, rangées : celles à taper, celles des raccourcis, celles qui tournent seules
  nc-aide NOM      le détail d'une commande (ce qu'elle fait, ses options)
"""
import os
import re
import shutil
import sys

BIN = os.path.expanduser("~/.local/bin")

# (commande, exemple, explication) — rangées par usage
A_TAPER = [
    ("nc-reglages", "nc-reglages", "Tous les réglages, aux flèches : île, apparence, animations, énergie, clavier, veille, "
                                   "terminal, raccourcis… Gardés à chaque mise à jour."),
    ("nc-raccourci", "nc-raccourci", "Tes raccourcis clavier : changer les touches, en désactiver, en ajouter."),
    ("nc-maj", "nc-maj", "Met la config à jour depuis GitHub (ne refait que ce qui a changé)."),
    ("nc-diag", "nc-diag rapport", "Vérifie toute l'installation et dit quoi faire si quelque chose cloche ; "
                                   "« rapport » copie le bilan, prêt à envoyer pour avoir de l'aide."),
    ("nc-aide", "nc-aide nc-anim", "Cette aide ; avec un nom, le détail d'une commande."),
    ("nc-sauvegarde", "nc-sauvegarde --fonds", "Tous tes réglages dans un seul fichier (pour réinstaller, ou les donner à "
                                               "un ami) ; nc-sauvegarde restaurer FICHIER pour les remettre."),
    ("nc-anim", "nc-anim neige", "Les animations (bouton d'arrêt) : nc-anim liste, en jouer une, "
