#!/usr/bin/env python3
"""nc-logiciels : chercher un logiciel à installer et l'installer (Spotlight : Super + R, préfixe « + »).

  nc-logiciels chercher TERME [--rapide] [--max N]
        les paquets qui correspondent, en JSON (le plus pertinent d'abord) : dépôts de la distribution (pacman, dnf,
        apt ou zypper), AUR (avec paru ou yay, sur Arch) et Flatpak. --rapide : seulement les dépôts de la
        distribution (suggestions du Spotlight pendant la frappe). Réglages SPOTLIGHT_AUR et SPOTLIGHT_FLATPAK.
  nc-logiciels installer SOURCE NOM
        ouvre un terminal qui l'installe (un mot de passe y est demandé : le tien avec sudo, celui de root sur openSUSE ou
        sans sudo (su) ; paru ou yay te montrent le PKGBUILD)
  nc-logiciels terminal SOURCE NOM
        l'installation elle-même, dans ce terminal

SOURCE : depot, aur ou flatpak. Rien n'est installé sans le terminal : il montre la commande et attend ta confirmation.
Icônes : celles des catalogues AppStream de la distribution quand ils sont là (XML d'Arch, Fedora, openSUSE ; YAML de
Debian et Ubuntu : index gardé dans ~/.cache/nc/logiciels-icones.json, refait quand un catalogue change), puis celles
de Flatpak ; sinon des noms à chercher dans le thème d'icônes (champ « noms_icone », pour le Spotlight).
Les noms sont vérifiés (lettres, chiffres, @ . _ + -) et passés en arguments, jamais à un shell.
"""
import gzip
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request

HOME = Path.home()
BIN = HOME / ".local/bin"
REGLAGES = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "nc/reglages.conf"
AUR_RPC = os.environ.get("NC_AUR_RPC") or "https://aur.archlinux.org/rpc/v5/search/"
NOM = re.compile(r"[A-Za-z0-9@._+-]{1,120}")
ENV_C = dict(os.environ, LC_ALL="C", LANG="C")          # sorties des gestionnaires de paquets en anglais (analysables)
# Paquets rarement voulus depuis un lanceur : bibliothèques, modules de langages, symboles de débogage
ANNEXES = re.compile(r"^(lib|python-|python3-|perl-|ruby-|rubygem-|haskell-|ghc-|r-|node-|nodejs-|golang-|rust-|texlive-|php-|lua-|ocaml-)|-(debug|debuginfo|debugsource|dev|devel|doc|docs|headers|static)$")


def _langue():
    """fr ou en : NC_LANGUE, puis LANGUE des réglages, puis la langue du système (LC_ALL, LC_MESSAGES, LANG, /etc/locale.conf)."""
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        l = reglage("LANGUE", "")
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', Path(os.environ.get("NC_LOCALE_CONF") or "/etc/locale.conf").read_text())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


def T(fr, en):
    return en if _langue() == "en" else fr


def reglage(cle, defaut):
    try:
        for l in REGLAGES.read_text(encoding="utf-8", errors="replace").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


def avertir(texte):
    """Un souci qui ne doit pas rester muet (stderr : le JSON de la recherche reste intact)."""
    print("nc-logiciels : " + texte, file=sys.stderr)


def lancer(cmd, delai=8):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=delai, env=ENV_C, stdin=subprocess.DEVNULL)
        return r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def famille():
    for outil, nom in (("pacman", "arch"), ("dnf", "fedora"), ("apt-get", "debian"), ("zypper", "suse")):
        if shutil.which(outil):
            return nom
    return ""


def assistant_aur():
    return next((a for a in ("paru", "yay") if shutil.which(a)), "")


def mots(terme):
    """Les mots de la recherche, réduits aux caractères d'un nom de paquet (pas d'expression régulière surprise)."""
    return [m for m in re.split(r"[^A-Za-z0-9@._+-]+", terme.lower()) if m][:4]


# ── Icônes ─────────────────────────────────────────────────────────────────────────────────────────────────────
CATALOGUES = [Path(d) for d in (os.environ.get("NC_SWCATALOG_DIRS") or
              "/usr/share/swcatalog:/var/lib/swcatalog:/var/cache/swcatalog:/usr/share/app-info:/var/lib/app-info:/var/cache/app-info").split(":") if d]
FLATPAK_APPSTREAM = [Path(d) for d in (os.environ.get("NC_FLATPAK_APPSTREAM") or
                     "/var/lib/flatpak/appstream:" + str(HOME / ".local/share/flatpak/appstream")).split(":") if d]
CACHE_ICONES = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "nc/logiciels-icones.json"
SUFFIXES = re.compile(r"-(bin|git|appimage|nightly|beta|stable|wayland|electron|desktop|latest|official|stable-bin)$")


def fichiers_catalogue():
    res = []
    for d in CATALOGUES:
        for sous in ("xml", "xmls", "yaml"):
            if (d / sous).is_dir():
                res += sorted(f for f in (d / sous).iterdir() if f.is_file() and re.search(r"\.(xml|yml|yaml)(\.gz)?$", f.name))
    return res


def lire_texte(f):
    with (gzip.open(f, "rt", encoding="utf-8", errors="replace") if f.name.endswith(".gz") else open(f, encoding="utf-8", errors="replace")) as h:
        return h.read()


def chemin_icone(racine, origine, nom):
    """Icône « en cache » d'un catalogue : icons/<origine>/<taille>/<nom>, la plus proche de 64 px."""
    # PNG puis SVG ; un .jxl (JPEG XL) n'est pas lisible sans kimageformats : on cherche le même nom en PNG/SVG, sinon rien
    base, ext = os.path.splitext(nom)
    noms = [nom] if ext.lower() in (".png", ".svg", ".svgz", ".xpm") else [base + ".png", base + ".svg"] if ext.lower() == ".jxl" else [nom]
    for n in noms:
        for taille in ("64x64", "128x128", "48x48", "64x64@2"):
            f = racine / "icons" / origine / taille / n
            if f.is_file() and f.suffix.lower() != ".jxl":
                return str(f)
    return ""


def icone_yaml(doc):
    """Dans un composant DEP-11 (Debian, Ubuntu) : le premier nom de fichier sous « Icon: » → « cached: »."""
    lignes = doc.splitlines()
    for i, l in enumerate(lignes):
        if l.startswith("Icon:"):
            bloc = []
            for m in lignes[i + 1:]:
                if m and not m[0].isspace():
                    break
                bloc.append(m)
            cache = "\n".join(bloc).split("cached:", 1)
            n = re.search(r"name:\s*(\S+)", cache[1]) if len(cache) == 2 else None
            return n[1] if n else ""
    return ""


def construire_index():
    """{paquet: chemin de l'icône} depuis les catalogues AppStream (XML ou YAML DEP-11), sans bibliothèque externe."""
    index = {}
    for f in fichiers_catalogue():
        racine = f.parent.parent
        try:
            texte = lire_texte(f)
        except (OSError, EOFError, ValueError):
            continue
        if f.name.endswith((".xml", ".xml.gz")):
            origine = (re.search(r'<components[^>]*\sorigin="([^"]+)"', texte) or [None, ""])[1]
            for c in re.finditer(r"<component\b.*?</component>", texte, re.S):
                bloc = c.group(0)
                paquet = re.search(r"<pkgname>([^<]+)</pkgname>", bloc)
                icone = re.search(r'<icon type="cached"[^>]*>([^<]+)</icon>', bloc)
                if paquet and icone and paquet[1] not in index:
                    chemin = chemin_icone(racine, origine, icone[1].strip())
                    if chemin:
                        index[paquet[1].strip()] = chemin
        else:
            origine = (re.search(r"^Origin:\s*(\S+)", texte, re.M) or [None, ""])[1]
            for doc in texte.split("\n---"):
                paquet = re.search(r"^Package:\s*(\S+)", doc, re.M)
                nom = icone_yaml(doc)
                if paquet and nom and paquet[1] not in index:
                    chemin = chemin_icone(racine, origine, nom)
                    if chemin:
                        index[paquet[1]] = chemin
    return index


def index_icones():
    """L'index, depuis le cache s'il correspond encore aux catalogues (chemins et dates), sinon refait."""
    signature = [[str(f), f.stat().st_mtime_ns] for f in fichiers_catalogue()]
    if not signature:
        return {}
    try:
        c = json.loads(CACHE_ICONES.read_text(encoding="utf-8"))
        if c.get("signature") == signature:
            return c.get("index", {})
    except (OSError, ValueError):
        pass
    index = construire_index()
    try:
        CACHE_ICONES.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_ICONES.with_suffix(".tmp")
        tmp.write_text(json.dumps({"signature": signature, "index": index}), encoding="utf-8")
        tmp.replace(CACHE_ICONES)
    except OSError:
        pass
    return index


def icone_flatpak(appid):
    for d in FLATPAK_APPSTREAM:
        if not d.is_dir():
            continue
        for f in d.glob(f"*/*/active/icons/*/{appid}.png"):
            if "128x128" in str(f) or "64x64" in str(f):
                return str(f)
    return ""


def noms_icone(x):
    """Noms à chercher dans le thème d'icônes (Papirus en a beaucoup, même d'applis non installées)."""
    n = x["nom"].lower()
    noms = [x["nom"]] if x["source"] == "flatpak" else []
    noms += [n, SUFFIXES.sub("", n)]
    if x.get("titre"):
        noms.append(x["titre"].lower().replace(" ", "-"))
    if "-" in n and len(n.split("-")[0]) > 2:
        noms.append(n.split("-")[0])
    return list(dict.fromkeys(noms))


def ajouter_icones(res):
    index = index_icones() if any(x["source"] == "depot" for x in res) else {}
    for x in res:
        x["icone"] = index.get(x["nom"], "") if x["source"] == "depot" else icone_flatpak(x["nom"]) if x["source"] == "flatpak" else ""
        if x["icone"].lower().endswith(".jxl"):      # ancien cache : JPEG XL illisible, on laisse le repli du thème
            x["icone"] = ""
        x["noms_icone"] = noms_icone(x)
    return res


# ── Sources ────────────────────────────────────────────────────────────────────────────────────────────────────
def depot_arch(m):
    # pacman -Ss : expressions régulières POSIX, mots combinés en ET ; . et + échappés
    sortie = lancer(["pacman", "-Ss", "--"] + [re.sub(r"([.+])", r"\\\1", x) for x in m])
    if not sortie.strip() and not list(Path(os.environ.get("NC_PACMAN_SYNC") or "/var/lib/pacman/sync").glob("*.db")):
        avertir(T("la base de pacman est vide : lance « sudo pacman -Sy » dans un terminal, puis cherche à nouveau.",
                  "the pacman database is empty: run \"sudo pacman -Sy\" in a terminal, then search again."))
    res, cur = [], None
    for l in sortie.splitlines():
        if not l.startswith(" "):
            r = re.match(r"(\S+)/(\S+) (\S+)(.*)", l)
            cur = r and dict(source="depot", depot=r[1], nom=r[2], version=r[3], description="", installe="[installed" in r[4])
            if cur:
                res.append(cur)
        elif cur is not None:
            cur["description"] = l.strip()
    return res


def depot_fedora(m):
    # Cache seulement (-C) : pas de téléchargement des métadonnées à chaque touche
    try:
        p = subprocess.run(["dnf", "-q", "-C", "search", "--"] + m, capture_output=True, text=True, timeout=10, env=ENV_C,
                           stdin=subprocess.DEVNULL)
        sortie = p.stdout
        if p.returncode != 0 and not sortie.strip():
            avertir(T("dnf n'a rien pu lire (cache absent ou périmé ?) : lance « dnf makecache » dans un terminal, puis cherche à nouveau.",
                      "dnf could not read anything (missing or stale cache?): run \"dnf makecache\" in a terminal, then search again."))
    except (OSError, subprocess.TimeoutExpired):
        sortie = ""
    res = []
    for l in sortie.splitlines():
        r = re.match(r"\s*([A-Za-z0-9@._+-]+)\.(?:x86_64|aarch64|noarch|i686)\s*:?\s*(.*)", l)
        if r:
            res.append(dict(source="depot", depot="fedora", nom=r[1], version="", description=r[2].strip(" :"), installe=None))
    return res


def depot_debian(m):
    sortie = lancer(["apt-cache", "search", "--"] + m)
    res = []
    for l in sortie.splitlines():
        nom, _, desc = l.partition(" - ")
        if NOM.fullmatch(nom.strip()):
            res.append(dict(source="depot", depot="debian", nom=nom.strip(), version="", description=desc.strip(), installe=None))
    return res


def marquer_installes(res):
    """Fedora et Debian : l'état « installé » n'est demandé qu'aux paquets gardés (après tri et coupe), en un seul appel."""
    inconnus = [x for x in res if x["installe"] is None]
    if not inconnus:
        return
    noms = [x["nom"] for x in inconnus]
    if famille() == "fedora":
        sortie = lancer(["rpm", "-q", "--qf", "%{NAME}\\n"] + noms)
        installes = {l.strip() for l in sortie.splitlines() if l.strip() and " " not in l}
    else:
        sortie = lancer(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n"] + noms)
        installes = {l.split()[0] for l in sortie.splitlines() if len(l.split()) > 1 and l.split()[1].startswith("ii")}
    for x in inconnus:
        x["installe"] = x["nom"] in installes


def depot_suse(m):
    sortie = lancer(["zypper", "--non-interactive", "--no-refresh", "--xmlout", "search", "-t", "package", "--"] + m, delai=10)
    res = []
    for l in re.findall(r"<solvable [^>]*>", sortie):
        a = dict(re.findall(r'(\w+)="([^"]*)"', l))
        if a.get("name") and NOM.fullmatch(a["name"]):
            res.append(dict(source="depot", depot="opensuse", nom=a["name"], version="", description=a.get("summary", ""),
                            installe=a.get("status") == "installed"))
    return res


def aur(m):
    """L'API de l'AUR (recherche par nom et description sur le premier mot, puis filtre sur les autres)."""
    if not m:
        return []
    try:
        url = AUR_RPC + urllib.parse.quote(m[0]) + "?by=name-desc"
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "nc-logiciels"}), timeout=4) as r:
            d = json.loads(r.read(4_000_000))
    except (OSError, ValueError):
        return []
    installes = set(lancer(["pacman", "-Qq"]).split())
    res = []
    for p in d.get("results") or []:
        nom, desc = str(p.get("Name", "")), str(p.get("Description") or "")
        if not NOM.fullmatch(nom) or not all(x in (nom + " " + desc).lower() for x in m[1:]):
            continue
        res.append(dict(source="aur", depot="aur", nom=nom, version=str(p.get("Version", "")), description=desc,
                        installe=nom in installes, popularite=float(p.get("Popularity") or 0)))
    return res


def flatpak(m):
    sortie = lancer(["flatpak", "search", "--columns=application,name,description,version,remotes", "--"] + m, delai=10)
    installes = set(lancer(["flatpak", "list", "--app", "--columns=application"]).split())
    res = []
    for l in sortie.splitlines():
        c = l.split("\t")
        # flatpak search ne tient compte que du premier mot : on filtre sur tous (nom + titre + description)
        if len(c) >= 5 and NOM.fullmatch(c[0]) and "." in c[0] and all(x in (c[0] + " " + c[1] + " " + c[2]).lower() for x in m[1:]):
            res.append(dict(source="flatpak", depot=c[4].split(",")[0].strip() or "flathub", nom=c[0], titre=c[1],
                            version=c[3], description=c[2], installe=c[0] in installes))
    return res


def score(x, m):
    q = " ".join(m)
    n, t = x["nom"].lower(), (x.get("titre") or "").lower()
    if n == q or t == q:
        s = 100
    elif n.startswith(q) or t.startswith(q):
        s = 85
    elif all(w in n or w in t for w in m):
        s = 65
    else:
        s = 30                                                  # trouvé dans la description
    if ANNEXES.search(n):
        s -= 25
    # Les dépôts officiels d'abord à pertinence égale ; dans l'AUR, un paquet populaire passe devant un abandonné
    s += {"depot": 8, "flatpak": 4, "aur": 0}[x["source"]]
    s += min(5, 2 * math.log10(1 + x.get("popularite", 0) * 10)) if x["source"] == "aur" else 0
    return s - len(n) / 100                                     # à égalité, le nom le plus court


def chercher(terme, rapide=False, maximum=30):
    m = mots(terme)
    if not m or len(" ".join(m)) < 2:
        return []
    res = {"arch": depot_arch, "fedora": depot_fedora, "debian": depot_debian, "suse": depot_suse}.get(famille(), lambda _: [])(m)
    if not rapide:
        if famille() == "arch" and assistant_aur() and reglage("SPOTLIGHT_AUR", "oui") != "non":
            vus = {x["nom"] for x in res}
            res += [x for x in aur(m) if x["nom"] not in vus]
        if shutil.which("flatpak") and reglage("SPOTLIGHT_FLATPAK", "oui") != "non":
            res += flatpak(m)
    for x in res:
        x["score"] = round(score(x, m), 2)
    res.sort(key=lambda x: -x["score"])
    res = res[:maximum]                                         # coupe d'abord : l'état « installé » ne se demande qu'à ceux-là
    marquer_installes(res)
    if rapide:
        # Suggestions pendant la frappe : pas les modules d'une appli déjà installée (« firefox-adblock-plus » quand
        # on tape « fire » pour lancer Firefox)
        installes = [x["nom"] + "-" for x in res if x["installe"]]
        res = [x for x in res if x["installe"] or not any(x["nom"].startswith(i) for i in installes)]
    return ajouter_icones(res)


# ── Installation ───────────────────────────────────────────────────────────────────────────────────────────────
def avec_droits(cmd):
    """cmd précédée de ce qu'il faut pour agir en administrateur : sudo s'il est là ; sinon su -c (Debian installé avec un
    mot de passe root, sans sudo), sinon pkexec. Aucun des trois : message clair."""
    if shutil.which("sudo"):
        return ["sudo"] + cmd
    if shutil.which("su"):
        return ["su", "-c", shlex.join(cmd)]
    if shutil.which("pkexec"):
        return ["pkexec"] + cmd
    raise ValueError(T("ni sudo, ni su, ni pkexec : impossible d'installer un paquet de la distribution depuis ici",
                       "no sudo, su or pkexec: cannot install a distribution package from here"))


def phrase_mot_de_passe(cmd):
    """Quel mot de passe sera demandé (openSUSE : sudo veut celui de root ; su : celui de root)."""
    if cmd and cmd[0] == "su" or (cmd and cmd[0] == "sudo" and famille() == "suse"):
        return T("Le mot de passe demandé est celui de root (administrateur).", "The password asked is root's (administrator).")
    if cmd and cmd[0] == "sudo":
        return T("Le mot de passe demandé est le tien.", "The password asked is your own.")
    return ""


def commande(source, nom, depot=""):
    if not NOM.fullmatch(nom):
        raise ValueError(T("nom de paquet invalide", "invalid package name"))
    if source == "aur":
        a = assistant_aur()
        if not a:
            raise ValueError(T("ni paru ni yay : l'AUR n'est pas disponible", "neither paru nor yay: the AUR is unavailable"))
        return [a, "-S", "--", nom]
    if source == "flatpak":
        if not shutil.which("flatpak"):
            raise ValueError(T("Flatpak n'est pas installé", "Flatpak is not installed"))
        return ["flatpak", "install", depot if NOM.fullmatch(depot or "") else "flathub", nom]
    if source == "depot":
        f = famille()
        base = {"arch": ["pacman", "-S", "--needed", "--", nom], "fedora": ["dnf", "install", "--", nom],
                "debian": ["apt", "install", "--", nom], "suse": ["zypper", "install", "--", nom]}.get(f)
        if not base:
            raise ValueError(T("gestionnaire de paquets non reconnu", "unrecognized package manager"))
        return avec_droits(base)
    raise ValueError(T("source inconnue (depot, aur ou flatpak)", "unknown source (depot, aur or flatpak)"))


def commande_terminal(cmd):
    """Celle de nc-apps (xdg-terminal-exec, $TERMINAL, puis kitty, foot, alacritty, ptyxis, ghostty, wezterm…) : une seule liste
    de terminaux et d'options, chargée depuis nc-apps plutôt que recopiée."""
    ici = Path(__file__).resolve().parent / "nc-apps"
    chemin = str(ici if ici.exists() else BIN / "nc-apps")
    l = importlib.machinery.SourceFileLoader("nc_apps", chemin)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("nc_apps", l))
    l.exec_module(mod)
    return mod.commande_terminal(cmd)


def installer(source, nom, depot=""):
    commande(source, nom, depot)                                # vérifié avant d'ouvrir un terminal
    moi = str(BIN / "nc-logiciels")
    args = [moi, "terminal", source, nom] + ([depot] if depot else [])
    cmd = commande_terminal(args)
    if not cmd:
        raise ValueError(T("aucun terminal trouvé", "no terminal found"))
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        try:
            code = p.wait(timeout=1.5)          # un terminal qui démarre reste ouvert ; s'il échoue, c'est tout de suite
        except subprocess.TimeoutExpired:
            return
    except OSError as e:
        raise ValueError(T(f"le terminal ne se lance pas ({e})", f"the terminal did not start ({e})"))
    if code != 0:
        texte = T(f"Le terminal ne s'est pas ouvert (code {code}) : l'installation de {nom} n'a pas commencé.",
                  f"The terminal did not open (code {code}): the installation of {nom} did not start.")
        try:
            subprocess.run(["notify-send", "-a", "Spotlight", "-u", "critical", T("Installation impossible", "Installation failed"), texte],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
        raise ValueError(texte)


def terminal(source, nom, depot=""):
    cmd = commande(source, nom, depot)
    print(T(f"Installation de {nom} : ", f"Installing {nom}: ") + " ".join(cmd), flush=True)
    mdp = phrase_mot_de_passe(cmd)
    print((mdp + "\n" if mdp else ""), flush=True)
    code = subprocess.run(cmd).returncode
    if code == 0:
        texte = T(f"{nom} est installé : tu le trouves dans le Spotlight (Super + R).", f"{nom} is installed: find it in the Spotlight (Super + R).")
        try:
            subprocess.run(["notify-send", "-a", "Spotlight", "-i", "system-software-install", T("Installé", "Installed"), texte],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass                                                # pas de notify-send : le message du terminal suffit
    else:
        texte = T(f"Installation non terminée (code {code}).", f"Installation not completed (code {code}).")
    print("\n" + texte)
    try:
        input(T("Entrée pour fermer.", "Press Enter to close."))
    except (EOFError, KeyboardInterrupt):
        pass
    return code


def main(a):
    try:
        if a[:1] in (["chercher"], ["search"]) and len(a) >= 2:
            rapide = "--rapide" in a or "--fast" in a
            maximum = 30
            if "--max" in a:
                i = a.index("--max")
                maximum = max(1, min(100, int(a[i + 1]))) if i + 1 < len(a) and a[i + 1].isdigit() else 30
            terme = a[1]
            print(json.dumps(chercher(terme, rapide, maximum), ensure_ascii=False))
            return 0
        if a[:1] in (["installer"], ["install"]) and len(a) in (3, 4):
            installer(a[1], a[2], a[3] if len(a) == 4 else "")
            return 0
        if a[:1] == ["terminal"] and len(a) in (3, 4):
            return terminal(a[1], a[2], a[3] if len(a) == 4 else "")
    except ValueError as e:
        print("nc-logiciels : " + str(e), file=sys.stderr)
        return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
