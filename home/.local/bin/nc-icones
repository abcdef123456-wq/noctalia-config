# Fichiers : feuille claire aux coins arrondis, coin replié, symbole du type dans sa couleur ; étiquette (PDF, ZIP…)
# en bas pour les formats qu'on reconnaît à leur nom. Les applis demandent d'abord l'icône précise du type puis son
# icône générique : le thème NC passant avant Papirus, les icônes génériques ci-dessous servent pour tous les fichiers.
FICHIER = """<defs>
    <linearGradient id="feuille" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{papier}"/><stop offset="1" stop-color="{papier2}"/>
    </linearGradient>
  </defs>
  <path d="M68 24 H156 L208 76 V212 Q208 232 188 232 H68 Q48 232 48 212 V44 Q48 24 68 24 Z" fill="url(#feuille)"/>
  <path d="M156 24 V60 Q156 76 172 76 H208 Z" fill="{pli}"/>
  <g fill="none" stroke="{couleur}" stroke-width="11" stroke-linecap="round" stroke-linejoin="round">{symbole}</g>
  {etiquette}"""
ETIQUETTE = """<rect x="62" y="176" width="{l}" height="38" rx="11" fill="{couleur}"/>
  <text x="{cx}" y="203" text-anchor="middle" font-family="Adwaita Sans, Inter, sans-serif" font-weight="700" font-size="24" fill="#ffffff">{texte}</text>"""
# Symboles centrés vers (128, 124)
TYPES = {
    # nom : (couleur, symbole, étiquette, autres noms)
