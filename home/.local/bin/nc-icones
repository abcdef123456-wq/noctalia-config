MaxSize=512
Type=Scalable
"""


# ── Couleurs ──
def couleurs():
    try:
        c = json.loads(COULEURS.read_text())
    except (OSError, ValueError):
        c = {}
    return {"fond": c.get("mSurface", "#1b1b22"), "accent": c.get("mPrimary", "#8fa8ff"),
            "accent2": c.get("mSecondary", c.get("mPrimary", "#8fa8ff")), "texte": c.get("mOnSurface", "#e6e6ef"),
            "erreur": c.get("mError", "#ff5c6c")}


def rvb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def melange(a, b, t):
    """Couleur entre a (t = 0) et b (t = 1)."""
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(rvb(a), rvb(b)))


def clarte(h):
    r, g, b = (x / 255 for x in rvb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


# ── Dessins ──
# Dossier : dos sombre avec onglet arrondi, face en dégradé (accent principal vers secondaire), fin liseré clair en
# haut de la face ; symbole du dossier gravé au centre de la face, dans une teinte sombre de la même couleur.
DOSSIER = """<defs>
    <linearGradient id="face" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{haut}"/><stop offset="1" stop-color="{bas}"/>
    </linearGradient>
  </defs>
  <path d="M24 70 Q24 50 44 50 H98 Q108 50 115 57 L125 67 H212 Q232 67 232 87 V196 Q232 216 212 216 H44 Q24 216 24 196 Z" fill="{dos}"/>
  <rect x="24" y="90" width="208" height="126" rx="20" fill="url(#face)"/>
  <path d="M44 91 H212" stroke="#ffffff" stroke-opacity=".35" stroke-width="2" stroke-linecap="round"/>
  <g fill="none" stroke="{trait}" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" opacity=".78">{symbole}</g>"""

