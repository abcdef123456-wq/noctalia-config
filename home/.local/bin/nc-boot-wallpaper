#!/usr/bin/env bash
# nc-boot-wallpaper : affiche le fond d'écran dès l'ouverture de session, sans écran noir pendant que
# Noctalia démarre. swaybg montre la copie réduite (~/.cache/nc/wallpaper-boot.jpg), puis s'arrête
# dès que le fond de Noctalia est en place. Lancé par Hyprland (exec-once).
command -v swaybg >/dev/null || exit 0
img="$HOME/.cache/nc/wallpaper-boot.jpg"
[ -r "$img" ] || img=$(jq -r '.wallpapers | to_entries | map(.value) | first // empty' "$HOME/.cache/noctalia/wallpapers.json" 2>/dev/null)
[ -r "$img" ] || exit 0

swaybg -m fill -i "$img" &
pid=$!
# Attend la couche « noctalia-wallpaper » (20 s au plus), puis laisse finir son fondu d'apparition.
for _ in $(seq 100); do
  hyprctl layers -j 2>/dev/null | grep -q '"noctalia-wallpaper-' && break
  sleep 0.2
done
sleep 2.5
kill "$pid" 2>/dev/null
