STYLE_FICHIER = os.path.join(HOME, ".config/nc/style.conf")       # valeurs du style du bureau (écrit ici)
STYLE_AVANT = os.path.join(HOME, ".config/nc/style-avant")         # palette Noctalia d'avant le style Apple
VEILLE_SRC = os.path.join(HOME, ".config/hypr/hypridle.conf")
VEILLE_OUT = os.path.join(HOME, ".config/nc/hypridle.conf")
VEILLE_UNITE = os.path.join(HOME, ".config/systemd/user/hypridle.service.d/nc-reglages.conf")
KITTY_OUT = os.path.join(HOME, ".config/kitty/nc-reglages.conf")
NOCTALIA_DIR = os.path.join(os.environ.get("NOCTALIA_CONFIG_HOME", os.path.join(HOME, ".config")), "noctalia")
# Noctalia lit tous les .toml de son dossier par ordre alphabétique, le dernier l'emporte : après settings.toml
# (réglages faits dans Noctalia), avant zz-economie.toml (profil Économie, qui doit gagner)
NOCTALIA_OUT = os.path.join(NOCTALIA_DIR, "zy-reglages.toml")


def charger(nom, fichier):
    chargeur = importlib.machinery.SourceFileLoader(nom, os.path.join(BIN, fichier))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(nom, chargeur))
    chargeur.exec_module(mod)
    return mod


def sortie(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ── Choix calculés sur ce PC ────────────────────────────────────────────────────────────────────────────────────
def frequences():
    """Fréquences de l'écran du portable dans sa définition native (de la plus basse à la plus haute)."""
    try:
        mons = json.loads(sortie(["hyprctl", "monitors", "all", "-j"]) or "[]")
    except ValueError:
        return []
    m = next((x for x in mons if x.get("name", "").startswith("eDP")), None)
    if not m:
        return []
    modes = []
    for s in m.get("availableModes", []):
        r = re.match(r"(\d+)x(\d+)@([\d.]+)", s)
        if r:
            modes.append((int(r[1]) * int(r[2]), round(float(r[3]))))
    if not modes:
        return []
    px = max(p for p, _ in modes)
    return sorted({hz for p, hz in modes if p == px})


def polices(motif, preferees):
    """Polices installées : d'abord celles de la liste (si présentes), puis les autres qui suivent le motif."""
    familles = set()
    for l in sortie(["fc-list", ":", "family"]).splitlines():
        for f in l.split(","):
            familles.add(f.strip())
    res = [p for p in preferees if p in familles]
    res += sorted(f for f in familles if re.search(motif, f) and f not in res)
    return res[:14]


# ── Les réglages ────────────────────────────────────────────────────────────────────────────────────────────────
class R:
    """Un réglage : clé du fichier, section, nom, genre (ouinon, choix, entier, hz, texte, dossier), valeur de la config."""

    def __init__(self, cle, section, nom, genre, defaut, aide="", choix=None, mini=0, maxi=100, pas=1, unite="",
                 groupe="", zero="", essai=""):
        self.cle, self.section, self.nom, self.genre, self.defaut, self.aide = cle, section, nom, genre, defaut, aide
        self._choix, self.mini, self.maxi, self.pas, self.unite = choix, mini, maxi, pas, unite
        self.groupe, self.zero, self.essai = groupe, zero, essai

    def choix(self):
        """[(valeur, nom affiché)] pour ouinon, choix et hz."""
        if self.genre == "ouinon":
            return [("oui", "Oui"), ("non", "Non")]
        if self.genre == "hz":
            l = frequences()
            res = [("max", f"La plus haute{f' ({l[-1]} Hz)' if l else ''}"), ("low", "60 Hz, sinon la plus basse")]
            return res + [(str(h), f"{h} Hz") for h in l]
        c = self._choix() if callable(self._choix) else (self._choix or [])
        return [(x, x) if isinstance(x, str) else x for x in c]

    def montrer(self, v):
        if self.genre in ("ouinon", "choix", "hz"):
            for val, nom in self.choix():
                if val == v:
                    return nom
            return f"{v} Hz" if self.genre == "hz" and v.isdigit() else v
        if self.genre == "entier":
            if v == "0" and self.zero:
                return self.zero
            return f"{v}{' ' + self.unite if self.unite else ''}"
        if self.genre == "dossier" and v == "auto":
            return "automatique"
        if self.genre == "texte" and v == "systeme":
            return "celle du système"
        return v

    def valider(self, v):
        """Valeur normalisée, ou ValueError avec un message."""
        v = v.strip()
        if self.genre == "ouinon":
            l = v.lower()
            if l in ("oui", "o", "yes", "y", "true", "1"):
                return "oui"
            if l in ("non", "n", "no", "false", "0"):
                return "non"
            raise ValueError("oui ou non")
        if self.genre == "choix":
            vals = [c for c, _ in self.choix()]
            if v in vals:
                return v
            raise ValueError("valeurs possibles : " + ", ".join(vals))
        if self.genre == "entier":
            if not re.fullmatch(r"-?\d{1,5}", v) or not self.mini <= int(v) <= self.maxi:
                raise ValueError(f"un nombre de {self.mini} à {self.maxi}")
            return str(int(v))
        if self.genre == "hz":
            if v in ("max", "low") or (v.isdigit() and 20 <= int(v) <= 500):
                return v
            raise ValueError("max, low ou une fréquence en Hz (ex. 60)")
        if self.genre == "dossier":
            if v == "auto":
                return v
            v = os.path.expanduser(v)
            if not v.startswith("/"):
                raise ValueError("un chemin complet (ex. ~/Images/Captures), ou auto")
            return v.replace(HOME, "~", 1)
        if self.genre == "texte":
            if self.cle == "CLAVIER_DISPOSITION" and v != "systeme":
                if not re.fullmatch(r"[a-z]{2,3}(,[a-z]{2,3})*", v) or \
                        any(not os.path.exists(f"/usr/share/X11/xkb/symbols/{x}") for x in v.split(",")):
                    raise ValueError("codes de disposition séparés par des virgules (ex. us, fr, us,fr), ou systeme")
            if not v:
                raise ValueError("une valeur")
            return v
        return v


def animations_bouton():
    """Ce que peut faire le bouton d'arrêt : actions, animations de nc-anim (dont les tiennes)."""
    res = [("doigts", "Des doigts partout")]
    for l in sortie([os.path.join(HOME, ".local/bin/nc-anim"), "liste", "--brut"]).splitlines():
        n, _, d = l.partition("\t")
        if n and n != "doigts":
            res.append((n, d))
    return res + [("aleatoire", "Une animation au hasard"), ("menu", "Menu Éteindre / Redémarrer / Veille"),
                  ("verrouiller", "Verrouiller l'écran"), ("veille", "Mettre en veille"),
                  ("eteindre", "Éteindre (comme d'habitude)"), ("rien", "Rien")]


