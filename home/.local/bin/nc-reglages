def police_apple():
    """SF Pro si elle est installée, sinon Inter (très proche), sinon rien."""
    familles = set(sortie(["fc-list", ":", "family"]).replace(",", "\n").splitlines())
    for p in ("SF Pro Display", "SF Pro Text", "SF Pro", "Inter", "Inter Variable"):
        if p in familles:
            return p
    return ""


_style_cache = [None, {}]


def style_vals():
    """Valeurs données par le style du bureau (~/.config/nc/style.conf)."""
    try:
        t = os.path.getmtime(STYLE_FICHIER)
    except OSError:
        return {}
    if _style_cache[0] != t:
        v = {}
        with open(STYLE_FICHIER, encoding="utf-8") as f:
            for l in f:
                m = re.match(r"\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$", l)
                if m:
                    v[m[1]] = m[2]
        _style_cache[:] = [t, v]
    return _style_cache[1]


def effectifs(vals):
    """Valeurs en vigueur : celles du style, puis les tiennes."""
    return {**{k: v for k, v in style_vals().items() if k != "STYLE"}, **vals}


def valeur(vals, cle):
    if cle in vals:
        return vals[cle]
    st = style_vals()
    return st[cle] if cle in st and cle != "STYLE" else PAR_CLE[cle].defaut


def regler(vals, cle, v):
    """Change (ou remet, si v est la valeur de la config) un réglage ; renvoie son groupe d'application."""
    r = PAR_CLE[cle]
    v = r.valider(v)
    # Fichier relu juste avant d'écrire : un réglage changé ailleurs entre-temps (autre fenêtre de nc-reglages,
    # ligne de commande) n'est pas écrasé ; vals est mis à jour sur place avec l'état du fichier
    frais = lire()
    vals.clear()
    vals.update(frais)
    base = style_vals().get(cle, r.defaut) if cle != "STYLE" else r.defaut
    if v == base:
        vals.pop(cle, None)
    else:
        vals[cle] = v
    ecrire(vals)
    if cle == "LANGUE":
        # Langue changée : le texte suit tout de suite (écran des réglages ouvert)
        global EN
        EN = _langue() == "en"
    return r.groupe


# ── Application ─────────────────────────────────────────────────────────────────────────────────────────────────
VEILLE_CLES = ("VEILLE_VERROU", "VEILLE_SUSPENSION", "VEILLE_SECTEUR", "VEILLE_ECRAN", "VEILLE_BAISSE_BATTERIE",
               "VEILLE_ECRAN_BATTERIE")


def texte_veille(vals, src):
    """Config de hypridle avec tes délais, tirée de ~/.config/hypr/hypridle.conf (src) : chaque listener de src est
    reconnu à sa commande, son délai remplacé, ou il est retiré (délai 0). Les deux listeners « sur batterie »
    (assombrir plus tôt, écran verrouillé éteint) testent le secteur eux-mêmes et ne font rien sur secteur."""
    def entier(cle):
        v = vals.get(cle)
        return int(v if v not in (None, "") else PAR_CLE[cle].defaut)
    verrou, susp, secteur = entier("VEILLE_VERROU"), entier("VEILLE_SUSPENSION"), entier("VEILLE_SECTEUR")
    ecran, baisse_bat, ecran_bat = entier("VEILLE_ECRAN"), entier("VEILLE_BAISSE_BATTERIE"), entier("VEILLE_ECRAN_BATTERIE")
    t_baisse = max(30, verrou * 60 - 150) if verrou else 0
    t_ecran = ecran * 60 if ecran else (verrou * 60 + 30 if verrou else 0)

    def bloc(m):
        b = m.group(0)
        # Écran éteint : « nc-ecran off » (ou un ancien hypridle.conf, à dpms direct)
        eteint = "nc-ecran off" in b or "dpms" in b
        if "power_supply" in b and "nc-brightness dim" in b:
            # Sur batterie : assombrir plus tôt ; inutile sans assombrissement normal ou s'il vient avant
            t = baisse_bat if baisse_bat and t_baisse and baisse_bat < t_baisse else 0
        elif "power_supply" in b and eteint:
            # Sur batterie, écran verrouillé : éteint après ce délai ; inutile si l'écran s'éteint déjà avant
            t = ecran_bat if ecran_bat and not (t_ecran and t_ecran <= ecran_bat) else 0
        elif "nc-brightness dim" in b:
            t = t_baisse
        elif eteint:
            t = t_ecran
        elif "lock-session" in b:
            t = verrou * 60
        elif "suspend" in b:
            t = susp * 60
        else:
            return b
        return re.sub(r"timeout\s*=\s*\d+", f"timeout = {t}", b) if t > 0 else ""

    texte = re.sub(r"(?ms)^listener\s*\{.*?^\}\n?", bloc, src)
    if secteur:
        # PC branché, ou sans batterie (PC de bureau) : veille après ce délai
        texte += ("\n# nc-reglages : veille sur secteur\nlistener {\n    timeout = %d\n    on-timeout = sh -c 'ls -d "
                  "/sys/class/power_supply/BAT* >/dev/null 2>&1 || exec systemctl suspend; for s in /sys/class/power_supply/*; "
                  "do [ \"$(cat $s/type)\" = Mains ] && [ \"$(cat $s/online)\" = 1 ] && exec systemctl suspend; done; exit 0'\n}\n"
                  % (secteur * 60))
    return (f"# Généré par nc-reglages depuis ~/.config/hypr/hypridle.conf (verrouillage : {verrou} min, "
            f"veille : {susp} min, sur secteur : {secteur or 'jamais'}, sur batterie : assombri après "
            f"{baisse_bat or 'comme sur secteur'} s, écran verrouillé éteint après {ecran_bat or 'comme sur secteur'} s). "
            f"Ne pas éditer.\n" + texte)


def relancer_hypridle():
    # Marque « écran verrouillé » (on_lock_cmd de hypridle) retirée : hypridle relancé pendant un verrouillage ne la
    # retirerait pas au déverrouillage (au pire, l'écran verrouillé ne s'éteint pas plus tôt jusqu'au suivant)
    try:
        os.remove(os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "nc-verrouille"))
    except OSError:
        pass
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    subprocess.run(["systemctl", "--user", "restart", "hypridle.service"], capture_output=True)


def appliquer_veille(vals):
    if all(vals.get(c) is None for c in VEILLE_CLES if c != "VEILLE_ECRAN") and not int(vals.get("VEILLE_ECRAN") or 0):
        # Délais de la config : hypridle lit ~/.config/hypr/hypridle.conf tel quel
        if os.path.exists(VEILLE_UNITE):
            for f in (VEILLE_UNITE, VEILLE_OUT):
                try:
                    os.remove(f)
                except FileNotFoundError:
                    pass
            relancer_hypridle()
        return
    try:
        with open(VEILLE_SRC, encoding="utf-8") as f:
            src = f.read()
    except OSError:
        return
    os.makedirs(os.path.dirname(VEILLE_OUT), exist_ok=True)
    with open(VEILLE_OUT, "w", encoding="utf-8") as f:
        f.write(texte_veille(vals, src))
    hi = sortie(["sh", "-c", "command -v hypridle"]).strip() or "/usr/bin/hypridle"
    os.makedirs(os.path.dirname(VEILLE_UNITE), exist_ok=True)
    with open(VEILLE_UNITE, "w", encoding="utf-8") as f:
        f.write(f"# nc-reglages : la veille avec tes délais\n[Service]\nExecStart=\nExecStart={hi} -c %h/.config/nc/hypridle.conf\n")
    relancer_hypridle()


def appliquer_terminal(vals):
    c = []
    if "TERMINAL_OPACITE" in vals:
        c.append(f"background_opacity {int(vals['TERMINAL_OPACITE']) / 100:.2f}")
    if "TERMINAL_TAILLE" in vals:
        c.append(f"font_size {vals['TERMINAL_TAILLE']}")
    if "TERMINAL_POLICE" in vals:
        c.append(f"font_family {vals['TERMINAL_POLICE']}")
    if "TERMINAL_CURSEUR" in vals:
        c.append(f"cursor_shape {vals['TERMINAL_CURSEUR']}")
    if vals.get("TERMINAL_TRAINEE") == "non":
        c.append("cursor_trail 0")
    if "TERMINAL_MARGE" in vals:
        c.append(f"window_padding_width {vals['TERMINAL_MARGE']}")
    if "TERMINAL_HISTORIQUE" in vals:
        c.append(f"scrollback_lines {vals['TERMINAL_HISTORIQUE']}")
    if vals.get("TERMINAL_CLOCHE") == "oui":
        c.append("enable_audio_bell yes")
    if vals.get("TERMINAL_CLIGNOTE") == "non":
        c.append("cursor_blink_interval 0")
    if vals.get("TERMINAL_COPIE_SELECTION") == "oui":
        c.append("copy_on_select clipboard")
    if vals.get("TERMINAL_LIGATURES") == "non":
        c.append("disable_ligatures always")
    texte = "# Écrit par nc-reglages. Ne pas éditer.\n" + "\n".join(c) + "\n" if c else ""
    ancien = open(KITTY_OUT, encoding="utf-8").read() if os.path.exists(KITTY_OUT) else ""
    if texte == ancien:
        return
    if texte:
        with open(KITTY_OUT, "w", encoding="utf-8") as f:
            f.write(texte)
    elif os.path.exists(KITTY_OUT):
        os.remove(KITTY_OUT)
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)      # kitty relit sa config


def toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    return json.dumps(v, ensure_ascii=False)


def appliquer_noctalia(vals):
    tables = {}

    def mettre(table, cle, v):
        tables.setdefault(table, {})[cle] = v

    def oui(k):
        return vals[k] == "oui"

    if "THEME_MODE" in vals:
        mettre("theme", "mode", vals["THEME_MODE"])
    if "POLICE" in vals:
        mettre("shell", "font_family", vals["POLICE"])
    if "ANIMATIONS_VITESSE" in vals:
        mettre("shell.animation", "speed", float(vals["ANIMATIONS_VITESSE"]))
    if "COINS_ECRAN" in vals:
        mettre("shell.screen_corners", "enabled", oui("COINS_ECRAN"))
    if "VERROU_FLOU" in vals:
        mettre("lockscreen", "blur_intensity", int(vals["VERROU_FLOU"]) / 100)
    if "DOCK_POSITION" in vals:
        mettre("dock", "position", vals["DOCK_POSITION"])
    if any(k in vals for k in ("NUIT", "NUIT_TEMPERATURE", "NUIT_DEBUT", "NUIT_FIN")):
        nuit = valeur(vals, "NUIT")
        mettre("nightlight", "enabled", nuit != "non")
        mettre("nightlight", "force", nuit == "toujours")
        mettre("nightlight", "temperature_night", int(valeur(vals, "NUIT_TEMPERATURE")))
        if nuit == "soir":
            mettre("location", "custom_schedule", True)
            mettre("location", "sunset", valeur(vals, "NUIT_DEBUT"))
            mettre("location", "sunrise", valeur(vals, "NUIT_FIN"))
    if style_vals().get("STYLE") == "oled":
        mettre("theme", "pure_black_dark", True)       # fonds noirs purs
    if style_vals().get("STYLE") == "apple":
        # Barre de menus façon Mac : une bande translucide sur toute la largeur (l'île y fait l'encoche), sans
        # pastilles (le dock est déjà en verre dépoli)
        mettre("bar.default", "capsule", False)
        mettre("bar.default", "background_opacity", 0.55)
    TOUTES = ["disc", "fade", "wipe", "stripes", "honeycomb", "zoom"]
    for cle, table in (("ANIM_VERROU", "lockscreen"), ("ANIM_FOND", "wallpaper")):
        if cle in vals:
            v = vals[cle]
            mettre(table, "transition", TOUTES if v == "aleatoire" else [] if v == "aucune" else [v])
        if cle + "_DUREE" in vals:
            mettre(table, "transition_duration", float(vals[cle + "_DUREE"]))
    if "BARRE_OPACITE" in vals:
        mettre("bar.default", "capsule_opacity", int(vals["BARRE_OPACITE"]) / 100)
    if "BARRE_SYSTEME" in vals and tomllib:
        # La liste de droite de la barre, telle qu'installée, avec ou sans la pastille d'infos système
        try:
            with open(os.path.join(NOCTALIA_DIR, "config.toml"), "rb") as f:
                fin = tomllib.load(f)["bar"]["default"]["end"]
            if not oui("BARRE_SYSTEME"):
                fin = [w for w in fin if w != "group:sys"]
            mettre("bar.default", "end", fin)
        except (OSError, KeyError, ValueError):
            pass
    for cle, nom in (("DOCK", "enabled"), ("DOCK_AUTO", "auto_hide"), ("DOCK_LOUPE", "magnification")):
        if cle in vals:
            mettre("dock", nom, oui(cle))
    if "DOCK_TAILLE" in vals:
        mettre("dock", "icon_size", int(vals["DOCK_TAILLE"]))
    if "FONDS_ROTATION" in vals:
        mettre("wallpaper.automation", "enabled", oui("FONDS_ROTATION"))
    if "FONDS_INTERVALLE" in vals:
        mettre("wallpaper.automation", "interval_seconds", int(vals["FONDS_INTERVALLE"]) * 60)
    if "FONDS_DOSSIER" in vals:
        mettre("wallpaper", "directory", os.path.expanduser(vals["FONDS_DOSSIER"]))

    if vals.get("EFFETS") == "aucun":
        # Plus aucun effet : en dernier, passe devant les choix d'animations et de transitions (qui restent gardés)
        mettre("shell.animation", "enabled", False)
        mettre("wallpaper", "transition", [])
        mettre("lockscreen", "transition", [])
        mettre("dock", "magnification", False)

    texte = ""
    if tables:
        texte = "# Écrit par nc-reglages (tes réglages de Noctalia). Ne pas éditer : nc-reglages.\n"
        for t, kv in tables.items():
            texte += f"\n[{t}]\n" + "".join(f"{k} = {toml_val(v)}\n" for k, v in kv.items())
    ancien = open(NOCTALIA_OUT, encoding="utf-8").read() if os.path.exists(NOCTALIA_OUT) else ""
    if texte == ancien:
        return
    if texte:
        os.makedirs(NOCTALIA_DIR, exist_ok=True)
        with open(NOCTALIA_OUT, "w", encoding="utf-8") as f:
            f.write(texte)
    elif os.path.exists(NOCTALIA_OUT):
        os.remove(NOCTALIA_OUT)
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True)


def appliquer_curseur(vals):
    taille = valeur(vals, "CURSEUR_TAILLE")
    choisi = valeur(vals, "CURSEUR_THEME")
    theme = (choisi if choisi != "systeme" else "") or os.environ.get("XCURSOR_THEME") or \
        sortie(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"]).strip().strip("'") or "Adwaita"
    subprocess.run(["hyprctl", "setcursor", theme, taille], capture_output=True)
    if choisi != "systeme":
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", theme], capture_output=True)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", taille], capture_output=True)
    subprocess.run(["hyprctl", "reload"], capture_output=True)      # variables XCURSOR_SIZE des applis lancées ensuite


def appliquer_style(vals):
    """Écrit les valeurs du style choisi dans style.conf (lues par Hyprland, l'île et nc-reglages) et change la palette
    de Noctalia (Apple), en gardant celle d'avant pour la remettre."""
    style = vals.get("STYLE", "noctalia")
    texte = "# Écrit par nc-reglages : valeurs du style du bureau. Ne pas éditer (nc-reglages → Apparence).\n"
    texte += f"STYLE={style}\n"
    prereglage = dict(STYLES.get(style, {}))
    if style == "apple":
        p = police_apple()
        if p:
            prereglage["POLICE"] = p
    texte += "".join(f"{k}={v}\n" for k, v in prereglage.items())
    ancien = open(STYLE_FICHIER, encoding="utf-8").read() if os.path.exists(STYLE_FICHIER) else ""
    if texte != ancien:
        os.makedirs(os.path.dirname(STYLE_FICHIER), exist_ok=True)
        with open(STYLE_FICHIER, "w", encoding="utf-8") as f:
            f.write(texte)
    # Palette de Noctalia (couleurs de tout le bureau : barre, applis GTK et Qt, terminal…) ; celle d'avant le premier
    # style est gardée pour la remettre
    actuelle = sortie(["noctalia", "msg", "color-scheme-get"]).strip()
    cible = PALETTES.get(style)
    des_styles = {" ".join(p) for p in PALETTES.values()}
    if not actuelle:
        pass                                       # Noctalia ne tourne pas : palette changée au prochain passage
    elif cible:
        if actuelle not in des_styles:
            with open(STYLE_AVANT, "w", encoding="utf-8") as f:
                f.write(actuelle + "\n")
        if actuelle != " ".join(cible):
            subprocess.run(["noctalia", "msg", "color-scheme-set"] + cible, capture_output=True)
    elif actuelle in des_styles:
        try:
            avant = open(STYLE_AVANT, encoding="utf-8").read().split()
        except OSError:
            avant = []
        if len(avant) < 2 or " ".join(avant) in des_styles:
            avant = ["wallpaper", "vibrant"]
        subprocess.run(["noctalia", "msg", "color-scheme-set"] + avant, capture_output=True)
    # Bordures, ombres et terminal (nc-theme-sync lit style.conf), puis tout ce que le style touche
    subprocess.run([os.path.join(HOME, ".local/bin/nc-theme-sync")], capture_output=True)
    return ["hypr", "noctalia", "terminal"]


def code_noeud_pret():
    """Le code de confirmation à distance de nc-noeud est créé, vérifié, à toi seul (0600) et pas bloqué (seuls
    « verifie » et « bloque » sont regardés), comme nc-noeud le demande."""
    chemin = os.path.join(HOME, ".config/nc/noeud-totp.json")
    etat = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"),
                        "noctalia-config/noeud-totp-etat.json")
    try:
        st = os.lstat(chemin)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
            return False
        with open(chemin, encoding="utf-8") as f:
            if json.load(f).get("verifie") is not True:
                return False
    except (OSError, ValueError, AttributeError):
        return False
    try:
        with open(etat, encoding="utf-8") as f:
            return json.load(f).get("bloque") is not True
    except FileNotFoundError:
        return True
    except (OSError, ValueError, AttributeError):
        return False


def appliquer(groupes, vals=None):
    vals = lire() if vals is None else vals
    groupes = list(groupes)
    if "style" in groupes:
        groupes.remove("style")
        groupes += [g for g in appliquer_style(vals) if g not in groupes]
    vals = effectifs(vals)
    for g in groupes:
        if g == "hypr":
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        elif g == "energie":
            subprocess.run(["systemctl", "--user", "restart", "nc-profile-sync.service"], capture_output=True)
            subprocess.run(["hyprctl", "reload"], capture_output=True)      # effets de l'Économie (nc/energie.lua)
        elif g == "veille":
            appliquer_veille(vals)
        elif g == "terminal":
            appliquer_terminal(vals)
        elif g == "noctalia":
            appliquer_noctalia(vals)
        elif g == "effets":
            subprocess.run(["hyprctl", "reload"], capture_output=True)
            appliquer_noctalia(vals)
        elif g == "couvercle":
            subprocess.run(["systemctl", "--user", "enable", "nc-couvercle.service"], capture_output=True)
            subprocess.run(["systemctl", "--user", "restart", "nc-couvercle.service"], capture_output=True)
        elif g == "claude":
            # Hooks de Claude Code ajoutés ou retirés (seulement si Claude Code est là)
            if os.path.isdir(os.path.join(HOME, ".claude")) or shutil.which("claude"):
                quoi = "retirer" if vals.get("CLAUDE_ILE") == "non" else "installer"
                subprocess.run([os.path.join(HOME, ".local/bin/nc-claude"), quoi], capture_output=True)
        elif g.startswith("ia:"):
            # Autres IA (Antigravity, opencode, Codex…) : branchées ou retirées par nc-claude
            ia = g[3:]
            quoi = "retirer" if vals.get(ia.upper() + "_ILE") == "non" else "installer"
            subprocess.run([os.path.join(HOME, ".local/bin/nc-claude"), quoi, ia], capture_output=True)
        elif g == "noeud":
            # JARVIS qui pilote ce PC : le service suit le réglage (activé et lancé, ou arrêté et désactivé)
            quoi = ["enable", "--now"] if vals.get("NOEUD_JARVIS") == "oui" else ["disable", "--now"]
            subprocess.run(["systemctl", "--user", *quoi, "nc-noeud.service"], capture_output=True)
        elif g == "noeud-confirmation":
            # Le serveur apprend à la connexion si ce PC accepte la confirmation à distance : on se reconnecte
            if vals.get("NOEUD_JARVIS") == "oui":
                subprocess.run(["systemctl", "--user", "try-restart", "nc-noeud.service"], capture_output=True)
            if vals.get("NOEUD_CONFIRMATION") in ("distance", "les-deux") and not code_noeud_pret():
                # Sans code enrôlé, nc-noeud reste sur l'écran : on dit quoi faire
                subprocess.run(["notify-send", "-a", "nc-reglages", T("Code de confirmation à créer", "Confirmation code needed"),
                                T("À distance, il faut le code de ton appli : dans un terminal, « nc-noeud totp creer » puis "
                                  "« nc-noeud totp verifier CODE ». En attendant, JARVIS demande sur l'écran.",
                                  "Remotely, the code of your app is needed: in a terminal, “nc-noeud totp creer” then "
                                  "“nc-noeud totp verifier CODE”. Until then, JARVIS asks on the screen.")],
                               capture_output=True)
        elif g == "curseur":
            appliquer_curseur(vals)
        elif g == "firefox":
            ff = os.path.join(HOME, ".local/bin/nc-firefox")
            if vals.get("FIREFOX_STYLE") == "oui":
                subprocess.run([ff, "installer"], capture_output=True)
                quoi = "installer" if vals.get("FIREFOX_COULEURS") == "oui" else "desinstaller"
                subprocess.run([ff, "extension", quoi], capture_output=True)
            else:
                subprocess.run([ff, "desinstaller"], capture_output=True)      # retire aussi l'extension
        elif g == "langue":
            # Hyprland (raccourcis, notifications) relit sa config ; l'île et les commandes relisent le réglage seules
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        # île, captures, halo : relu tout seul


# ── Raccourcis (moteur : nc-raccourci) ─────────────────────────────────────────────────────────────────────────
rc = None


def raccourcis():
    """Lignes de la section Raccourcis : titres, raccourcis actifs (de la config et les tiens), désactivés."""
    global rc
    if rc is None:
        rc = charger("ncraccourci", "nc-raccourci")
    conf = rc.read_conf()
    groupes, ordre = {}, []
    for b in rc.live_binds():
        if not b["desc"]:
            continue
        if b["desc"] not in groupes:
            groupes[b["desc"]] = []
            ordre.append(b["desc"])
        if b["id"] not in groupes[b["desc"]]:
            groupes[b["desc"]].append(b["id"])
    lignes = {s: [] for s in rc.nckeys.SECTIONS}
    mes = "Mes raccourcis" if "Mes raccourcis" in lignes else rc.nckeys.SECTIONS[-1]
    for d in ordre:
        sec, sep, texte = d.partition("|")
        sec = sec.strip() if sep and sec.strip() in lignes else mes
        ids = groupes[d]
        mien = next((e for e in conf if e[0] == "ajout" and rc.id_of(e[1]) in ids), None)
        origs = [rc.original_id(i, conf) for i in ids]
        lignes[sec].append({"genre": "raccourci", "nom": rc.desc_text(d), "ids": ids, "origs": origs, "mien": mien,
                            "change": any(o != i for o, i in zip(origs, ids)), "desactive": False})
    off = {}
    for e in conf:
        if e[0] == "aucun":
            nom = e[2] if len(e) > 2 and e[2] else T("Raccourci de la config", "Config shortcut")
            off.setdefault(nom, []).append(e[1])
    for nom, ids in off.items():
        lignes[mes].append({"genre": "raccourci", "nom": nom, "ids": ids, "origs": ids, "mien": None,
                                         "change": True, "desactive": True})
    res = [{"genre": "ajouter", "nom": T("Ajouter un raccourci…", "Add a shortcut…")}]
    for s in rc.nckeys.SECTIONS:
        if lignes[s]:
            res.append({"genre": "titre", "nom": nom_section(s)})
            res += lignes[s]
    return res


def touches_de(ligne):
    noms = list(dict.fromkeys(rc.human(i) for i in ligne["ids"]))      # sans doublons (molette haut / bas)
    fins = [n.split(" + ")[-1] for n in noms]
    mods = " + ".join(noms[0].split(" + ")[:-1])
    if len(noms) > 1 and set(fins) <= {"←", "→", "↑", "↓"}:
        return f"{mods} + {T('flèches', 'arrows')}" if mods else T("flèches", "arrows")
    if len(noms) > 3:
        return f"{noms[0]} … {noms[-1].split(' + ')[-1]}"
    return "  /  ".join(noms)


# ── Capture d'une combinaison (kitty) ──────────────────────────────────────────────────────────────────────────
US_POSITION = {"`": 49, "-": 20, "=": 21, "[": 34, "]": 35, ";": 47, "'": 48, "\\": 51, ",": 59, ".": 60, "/": 61}
FONCTIONS = {"P": "F1", "Q": "F2", "R": "F3", "S": "F4", "A": "haut", "B": "bas", "C": "droite", "D": "gauche",
             "H": "Début", "F": "Fin"}
TILDE = {"3": "Suppr", "15": "F5", "17": "F6", "18": "F7", "19": "F8", "20": "F9", "21": "F10", "23": "F11", "24": "F12"}


def lire_sequence(ecran, limite):
    """Une touche du terminal (octets bruts) ; None si rien avant la limite."""
    ecran.nodelay(True)
    octets = []
    try:
        while time.time() < limite:
            c = ecran.getch()
            if c == -1:
                if octets:
                    break
                time.sleep(0.01)
                continue
            octets.append(c)
            if octets[0] != 27:
                break
            if len(octets) > 2 and (chr(c).isalpha() or chr(c) == "~"):       # fin d'une séquence CSI
                break
    finally:
        ecran.nodelay(False)
    return bytes(o for o in octets if o < 256).decode("utf-8", "replace") if octets else None


def touches_de_sequence(s):
    """Séquence du protocole clavier de kitty -> texte pour nc-raccourci (« Super+Maj+T »), « annuler », ou None."""
    m = re.fullmatch(r"\x1b\[(\d+)(?::(\d*))?(?::(\d+))?(?:;(\d+))?u", s)
    if m:
        code, base, mods = int(m[1]), int(m[3]) if m[3] else None, int(m[4] or 1) - 1
        if code == 27 and not mods:
            return "annuler"
        noms = {13: "Entrée", 9: "Tab", 32: "Espace", 27: "Échap"}
        if code in noms:
            touche = noms[code]
        else:
            ch = chr(code)
            b = chr(base) if base else ch
            touche = None
            if len(ch) == 1 and ch.isascii() and ch.isalpha():
                touche = ch.upper()
            elif b.isdigit():
                touche = b
            elif ch.isdigit():
                touche = ch
            elif b in US_POSITION:
                touche = f"code:{US_POSITION[b]}"
        if not touche:
            return None
    else:
        m = re.fullmatch(r"\x1b\[(\d+)?(?:;(\d+))?([A-Z~])", s) or re.fullmatch(r"\x1bO()()([PQRS])", s)
        if not m:
            return "annuler" if s == "\x1b" else None
        mods = int(m[2] or 1) - 1
        touche = TILDE.get(m[1] or "") if m[3] == "~" else FONCTIONS.get(m[3])
        if not touche:
            return None
    noms_mods = [n for bit, n in ((8, "Super"), (4, "Ctrl"), (2, "Alt"), (1, "Maj")) if mods & bit]
    return "+".join(noms_mods + [touche])


def capturer(ecran, ui):
    """Attend une combinaison de touches ; renvoie son texte, ou None (annulé). Hyprland passe en mode « capture »
    (aucun de ses raccourcis ne réagit) le temps de l'appui, avec un retour automatique au bout de 20 s."""
    if os.environ.get("TERM") != "xterm-kitty" and not os.environ.get("KITTY_WINDOW_ID"):
        return ui.saisir(T("Nouvelles touches", "New keys"), "",
                         T("Ex. Super+T, Super+Maj+B, Ctrl+Alt+F", "E.g. Super+T, Super+Shift+B, Ctrl+Alt+F"))
    subprocess.run(["hyprctl", "eval",
                    "nc.capture_jeton = (nc.capture_jeton or 0) + 1 local j = nc.capture_jeton "
                    "hl.dispatch(hl.dsp.submap('nc-capture')) hl.timer(function() if nc.capture_jeton == j and hl.get_current_submap() == 'nc-capture' "
                    "then hl.dispatch(hl.dsp.submap('reset')) end end, { timeout = 20000, type = 'oneshot' })"],
                   capture_output=True)
    sys.stdout.write("\x1b[>5u")              # protocole clavier de kitty : modificateurs et touche d'origine
    sys.stdout.flush()
    ecran.keypad(False)
    try:
        limite = time.time() + 20
        while time.time() < limite:
            s = lire_sequence(ecran, limite)
            if s is None:
                return None
            t = touches_de_sequence(s)
            if t == "annuler":
                return None
            if t and ("+" in t or re.fullmatch(r"F\d+", t)):
                return t
            if t:
                ui.statut(T("Ajoute au moins Super, Ctrl ou Alt (Échap pour annuler)",
                            "Add at least Super, Ctrl or Alt (Esc to cancel)"), erreur=True)
                ui.dessiner_popup_capture()
        return None
    finally:
        sys.stdout.write("\x1b[<u")
        sys.stdout.flush()
        ecran.keypad(True)
        subprocess.run(["hyprctl", "eval", "hl.dispatch(hl.dsp.submap('reset'))"], capture_output=True)


# ── Écran ───────────────────────────────────────────────────────────────────────────────────────────────────────
def couper(t, w):
    return t if len(t) <= w else t[:max(0, w - 1)] + "…"


def configurer_assistant(terminal=False):
    """Saisie privée par le client : URL et clé ne passent jamais dans reglages.conf ni dans les arguments. `terminal` :
    les questions dans le terminal, sans essayer la fenêtre « Connexion JARVIS » de l'île."""
    try:
        return subprocess.run([sys.executable, os.path.join(BIN, "nc-assistant"), "configurer",
                               *(["--terminal"] if terminal else [])]).returncode
    except OSError:
        return 1


def verifier_assistant():
    """Teste la connexion distante sans afficher la clé ; retourne (code, message court)."""
    try:
        r = subprocess.run([sys.executable, os.path.join(BIN, "nc-assistant"), "verifier"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return 1, T("Test impossible.", "Test impossible.")
    lignes = (r.stdout if r.returncode == 0 else (r.stderr or r.stdout)).strip().splitlines()
    if r.returncode == 0:
        return 0, (lignes[0] if lignes else T("Connexion OK.", "Connection OK."))
    erreur = next((l for l in lignes if l.startswith(("Connexion impossible :", "Connection failed:"))), None)
    return r.returncode, (erreur or (lignes[-1] if lignes else T("Connexion impossible.", "Connection failed.")))


class Ecran:
    def __init__(self, ecran, section_depart=0):
        self.e = ecran
        self.vals = lire()
        self.sec = section_depart
        self.pos = {}                       # position dans chaque section
        self.focus = "items" if section_depart else "sections"
        self.haut = 0
        self.attente, self.derniere = set(), 0.0
        self.msg, self.msg_err, self.msg_fin = "", False, 0.0
        self.lignes_r = None
        self.titre_capture = ""
        try:                                # terminaux très simples : pas de curseur invisible ni de couleurs
            curses.curs_set(0)
            curses.use_default_colors()
        except curses.error:
            pass
        for i, c in enumerate((curses.COLOR_BLUE, curses.COLOR_YELLOW, curses.COLOR_GREEN, curses.COLOR_RED), 1):
            curses.init_pair(i, c, -1)
        self.ACC, self.MOD, self.OK, self.ERR = (curses.color_pair(i) for i in (1, 2, 3, 4))
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(0)
        if section_depart:
            self.deplacer(0)

    # Lignes de la section courante
    def items(self):
        if getattr(self, "sec_vue", None) != self.sec:     # une section affichée (à nouveau) : ses sessions relues
            self.sec_vue, self.lignes_s, self.lignes_d = self.sec, None, None
        if SECTIONS[self.sec] == "Raccourcis":
            if self.lignes_r is None:
                self.lignes_r = raccourcis()
            return self.lignes_r
        if SECTIONS[self.sec] == "Nouveautés":
            if getattr(self, "lignes_n", None) is None:
                self.lignes_n = ([{"genre": "titre", "nom": T("Une nouvelle version est disponible : nc-maj pour l'installer",
                                                              "A new version is available: nc-update to install it")}]
                                 if maj_disponible() else []) + nouveautes()
                if not self.lignes_n:
                    self.lignes_n = [{"genre": "titre", "nom": T("Historique introuvable (dépôt de la config absent)",
                                                                 "History not found (config repository missing)")}]
            return self.lignes_n
        lignes = [r for r in VISIBLES if r.section == SECTIONS[self.sec]]
        if SECTIONS[self.sec] == "Énergie":
            lignes = lignes_gpu() + lignes                 # le mode graphique en tête (rien sans objet)
        if SECTIONS[self.sec] == "Fenêtres":
            if getattr(self, "lignes_s", None) is None:
                self.lignes_s = lignes_sessions()          # lue une fois par affichage de la section, pas à chaque dessin
            lignes = lignes + [{"genre": "titre", "nom": T("Sessions enregistrées", "Saved sessions")}] + self.lignes_s
        if SECTIONS[self.sec] == "Barre et dock":
            if getattr(self, "lignes_d", None) is None:
                self.lignes_d = lignes_dock()              # lue une fois par affichage de la section
            lignes = lignes + [{"genre": "titre", "nom": T("Applis épinglées au dock", "Apps pinned to the dock")}] + self.lignes_d
        if SECTIONS[self.sec] == "Intelligence artificielle":
            lignes += [{"genre": "assistant", "action": "ia-cles", "nom": T("Clés d'API des IA", "AI API keys"),
                        "aide": T("Saisie masquée, chaque clé essayée tout de suite (nc-ia configurer).",
                                  "Hidden input, each key tested right away (nc-ai configure).")},
                       {"genre": "assistant", "action": "ia-tester", "nom": T("Tester les IA disponibles", "Test the available AIs"),
                        "aide": T("Une question d'un mot à chacune (nc-ia tester).", "A one-word question to each (nc-ai test).")}]
        if SECTIONS[self.sec] == "Agents IA (coucou)":
            for action, nom, aide in [
                ("tableau", T("Ouvrir le cockpit JARVIS", "Open JARVIS dashboard"), T("Chat et gestion plein écran, partagés avec l’île.", "Fullscreen chat and management, shared with the island.")),
                ("deployer", T("Déployer JARVIS sur ce PC", "Deploy JARVIS on this PC"), T("Assistant d’installation facultatif ; aucun backend installé par nc-maj.", "Optional setup; nc-update does not install a backend.")),
                ("serveur", T("Déployer JARVIS sur serveur SSH", "Deploy JARVIS on an SSH server"), T("Saisit la cible SSH, prépare les services et conserve les réglages existants.", "Enter an SSH host, prepare services and preserve existing settings.")),
            ]:
                lignes.append({"genre": "assistant", "action": action, "nom": nom, "aide": aide})
            lignes.insert(0, {"genre": "assistant", "action": "verifier",
                              "nom": T("Tester l'assistant distant", "Test remote assistant"),
                              "aide": T("Teste l'URL, la clé, le certificat TLS et l'état du runner ; la clé n'est jamais affichée.",
                                        "Tests the URL, key, TLS certificate and runner status; the key is never displayed.")})
            lignes.insert(0, {"genre": "assistant", "action": "configurer",
                              "nom": T("Configurer l'assistant distant", "Configure remote assistant"),
                              "aide": T("URL du serveur, clé secrète (saisie masquée) et utilisateur ; conservés séparément dans assistant.conf. Pour un autre réseau, utilise l'URL HTTPS d'un tunnel.",
                                        "Server URL, secret key (hidden input) and user; kept separately in assistant.conf. For another network, use the HTTPS URL of a tunnel.")})
        return lignes

    @staticmethod
    def selectionnable(it):
        return not (isinstance(it, dict) and it["genre"] == "titre")

    def courant(self):
        its = self.items()
        if not its:
            return None, 0
        i = max(0, min(self.pos.get(self.sec, 0), len(its) - 1))
        while i < len(its) - 1 and not self.selectionnable(its[i]):
            i += 1
        return its[i], i

    def statut(self, texte, erreur=False):
        self.msg, self.msg_err, self.msg_fin = texte, erreur, time.time() + 3

    # ── Dessin ──
    def dessiner(self):
        e = self.e
        e.erase()
        h, w = e.getmaxyx()
        if h < 14 or w < 70:
            e.addstr(0, 0, couper(T("Agrandis le terminal pour voir les réglages (70 × 14 au moins).",
                                    "Make the terminal bigger to see the settings (at least 70 × 14)."), w - 1))
            e.refresh()
            return
        titre = T("Réglages", "Settings")
        e.addstr(0, 2, titre, curses.A_BOLD | self.ACC)
        e.addstr(0, 2 + len(titre), T("  de noctalia-config", "  of noctalia-config"), curses.A_DIM)
        chemin = "~/.config/nc/" + ("raccourcis.conf" if SECTIONS[self.sec] == "Raccourcis" else "reglages.conf")
        e.addstr(0, max(32, w - len(chemin) - 2), chemin, curses.A_DIM)
        # Sections
        lg = 22
        # Liste des sections : défile si la fenêtre est trop basse pour toutes les montrer
        place = h - 6
        debut = 0 if len(SECTIONS) <= place else min(max(0, self.sec - place + 2), len(SECTIONS) - place)
        self.debut_sec = debut                     # pour le clic (liste défilée)
        for i, s in enumerate(SECTIONS):
            y = 2 + i - debut
            if y < 2:
                continue
            if y >= h - 4:
                break
            n = len(rc.read_conf()) if (s == "Raccourcis" and rc) else sum(1 for r in VISIBLES if r.section == s and r.cle in self.vals)
            if i == self.sec:
                attr = (curses.A_REVERSE | self.ACC | curses.A_BOLD) if self.focus == "sections" else (curses.A_BOLD | self.ACC)
                e.addstr(y, 1, couper(f" {nom_section(s)}", lg - 3).ljust(lg - 3), attr)
            else:
                e.addstr(y, 1, couper(f" {nom_section(s)}", lg - 3))
            if n:
                e.addstr(y, lg - 2, "●", self.MOD)
        for y in range(2, h - 4):
            e.addstr(y, lg, "│", curses.A_DIM)
        # Réglages de la section
        x0, iw = lg + 4, w - lg - 6
        its = self.items()
        cur, ci = self.courant()
        zone = h - 7
        if ci < self.haut:
            self.haut = ci
        elif ci >= self.haut + zone:
            self.haut = ci - zone + 1
        if ci <= 1:
            self.haut = 0
        col = min(42, iw // 2 + 4)
        for k, it in enumerate(its[self.haut:self.haut + zone]):
            i, y = self.haut + k, 2 + k
            sel = (i == ci and self.focus == "items")
            if isinstance(it, R):
                v = it.montrer(valeur(self.vals, it.cle))
                if sel and it.genre in ("ouinon", "choix", "hz", "entier"):
                    v = f"‹ {v} ›"
                elif sel:
                    v = f"{v}   ↵"
                self.ligne(y, x0, iw, col, it.nom, v, sel, it.cle in self.vals)
            elif it["genre"] == "titre":
                e.addstr(y, x0, couper(it["nom"], iw), curses.A_BOLD | self.ACC)
            elif it["genre"] == "assistant":
                v = T("Tester… ↵", "Test… ↵") if it.get("action") == "verifier" else \
                    f"{it['affiche']} ↵" if it.get("affiche") else T("Ouvrir… ↵", "Open… ↵")
                self.ligne(y, x0, iw, col, it["nom"], v, sel, False)
            elif it["genre"] == "info":
                self.ligne(y, x0, iw, col, it["nom"], it["valeur"], sel, False)
            elif it["genre"] == "ajouter":
                self.ligne(y, x0, iw, col, "+ " + it["nom"], "", sel, False)
            elif it["genre"] == "nouveaute":
                self.ligne(y, x0, iw, max(col, iw - 14), it["titre"], it["date"], sel, False)
            else:
                t = T("désactivé", "disabled") if it["desactive"] else touches_de(it)
                self.ligne(y, x0, iw, col, it["nom"], t, sel, it["change"] or bool(it["mien"]), gris=it["desactive"])
        if len(its) > zone:
            e.addstr(2, w - 2, "▲" if self.haut > 0 else " ", curses.A_DIM)
            e.addstr(h - 6, w - 2, "▼" if self.haut + zone < len(its) else " ", curses.A_DIM)
        # Explication du réglage choisi
        aide = ""
        if self.focus == "items" and cur is not None:
            if isinstance(cur, R):
                aide = cur.aide
                st = style_vals()
                du_style = cur.cle in st and cur.cle != "STYLE"
                if cur.cle in self.vals:
                    base = st[cur.cle] if du_style else cur.defaut
                    if EN:
                        origine = "Desktop style" if du_style else "Config"
                        aide = (aide + "  " if aide else "") + f"{origine} value: {cur.montrer(base)} (r to restore it)."
                    else:
                        origine = "du style Apple" if du_style else "de la config"
                        aide = (aide + "  " if aide else "") + f"Valeur {origine} : {cur.montrer(base)} (r pour la remettre)."
                elif du_style:
                    aide = (aide + "  " if aide else "") + T("Valeur donnée par le style Apple.", "Value set by the desktop style.")
            elif cur["genre"] in ("assistant", "info"):
                aide = cur["aide"]
            elif cur["genre"] == "nouveaute":
                aide = " · ".join(cur["points"][1:4]) or cur["points"][0]
                aide = (aide[:240] + "…") if len(aide) > 240 else aide
            elif cur["genre"] == "ajouter":
                aide = T("Une appli (va à sa fenêtre si elle est ouverte, sinon la lance), un bureau, une page de l'île ou une commande.",
                         "An app (goes to its window if it's open, otherwise launches it), a workspace, an island page or a command.")
            elif cur["genre"] == "raccourci":
                if cur["mien"]:
                    aide = T("Un de tes raccourcis. Entrée : changer les touches ou le retirer.",
                             "One of your shortcuts. Enter: change the keys or remove it.")
                elif cur["desactive"]:
                    aide = T("Raccourci de la config désactivé. Entrée : le réactiver.",
                             "Config shortcut disabled. Enter: turn it back on.")
                else:
                    aide = T("Entrée : changer les touches ou désactiver.", "Enter: change the keys or disable it.")
                    if cur["change"]:
                        aide += T("  À l'origine : ", "  Originally: ") + f"{' / '.join(rc.human(o) for o in cur['origs'][:3])}."
        elif self.focus == "sections":
            aide = T("Choisis une section. Un point marque ce que tu as changé.",
                     "Choose a section. A dot marks what you've changed.")
        for k, l in enumerate(textwrap.wrap(aide, w - 4)[:2]):
            e.addstr(h - 4 + k, 2, l, curses.A_DIM)
        if self.msg and time.time() < self.msg_fin:
            e.addstr(h - 2, 2, couper(("✗ " if self.msg_err else "✓ ") + self.msg, w - 4), self.ERR if self.msg_err else self.OK)
        if self.focus == "sections":
            bas = T("↑↓ section    → ou Entrée : ouvrir    q : quitter", "↑↓ section    → or Enter: open    q: quit")
        elif SECTIONS[self.sec] == "Raccourcis":
            bas = T("↑↓ choisir    Entrée : modifier    Échap : sections    q : quitter",
                    "↑↓ choose    Enter: edit    Esc: sections    q: quit")
        elif SECTIONS[self.sec] == "Nouveautés":
            bas = T("↑↓ choisir    Entrée : tout ce qu'elle apporte    Échap : sections    q : quitter",
                    "↑↓ choose    Enter: everything it brings    Esc: sections    q: quit")
        elif isinstance(cur, dict) and cur["genre"] == "info":
            bas = T("↑↓ choisir    Échap : sections    q : quitter", "↑↓ choose    Esc: sections    q: quit")
        elif isinstance(cur, dict) and cur["genre"] == "assistant":
            if cur.get("action") == "session-supprimer":
                bas = T("↑↓ choisir    Entrée : supprimer (une confirmation d'abord)    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: delete (confirmation first)    Esc: sections    q: quit")
            elif cur.get("action") == "dock-appli":
                bas = T("↑↓ choisir    Entrée : monter, descendre ou retirer du dock    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: move up, down or remove from the dock    Esc: sections    q: quit")
            elif cur.get("action") == "dock-ajouter":
                bas = T("↑↓ choisir    Entrée : ajouter une appli au dock    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: add an app to the dock    Esc: sections    q: quit")
            elif cur.get("action") == "mode-graphique":
                bas = T("↑↓ choisir    Entrée : changer de mode (une confirmation d'abord)    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: change mode (confirmation first)    Esc: sections    q: quit")
            elif cur.get("action") == "verifier":
                bas = T("↑↓ choisir    Entrée : tester la connexion    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: test connection    Esc: sections    q: quit")
            else:
                bas = T("↑↓ choisir    Entrée : configurer la connexion    Échap : sections    q : quitter",
                        "↑↓ choose    Enter: configure connection    Esc: sections    q: quit")
        else:
            bas = T("↑↓ choisir    ← → changer    Entrée : choisir dans la liste    r : valeur de la config    Échap : sections    q : quitter",
                    "↑↓ choose    ← → change    Enter: pick from the list    r: config value    Esc: sections    q: quit")
            cur_r = self.courant()[0]
            if isinstance(cur_r, R) and cur_r.essai:
                bas = T("↑↓ choisir    ← → changer    Entrée : liste    e : essayer    r : valeur de la config    Échap : sections    q : quitter",
                        "↑↓ choose    ← → change    Enter: list    e: try it    r: config value    Esc: sections    q: quit")
        e.addstr(h - 1, 2, couper(bas, w - 4), curses.A_DIM)
        e.refresh()

    def ligne(self, y, x0, iw, col, nom, v, sel, change, gris=False):
        e = self.e
        if change:
            e.addstr(y, x0 - 2, "●", self.MOD)
        if sel:
            attr = curses.A_REVERSE | self.ACC | curses.A_BOLD
            e.addstr(y, x0 - 1, " " * (iw + 1), attr)
            e.addstr(y, x0, couper(nom, col - 2), attr)
            e.addstr(y, x0 + col, couper(v, iw - col), attr)
        else:
            e.addstr(y, x0, couper(nom, col - 2), curses.A_DIM if gris else curses.A_NORMAL)
            e.addstr(y, x0 + col, couper(v, iw - col), curses.A_DIM if gris else self.ACC)

    # ── Fenêtres par-dessus ──
    def boite(self, titre, n, larg):
        h, w = self.e.getmaxyx()
        larg = min(w - 4, larg)
        haut = n + 4
        win = curses.newwin(haut, larg, max(1, (h - haut) // 2), (w - larg) // 2)
        win.keypad(True)
        win.erase()
        win.box()
        win.addstr(0, 2, f" {couper(titre, larg - 6)} ", curses.A_BOLD | self.ACC)
        return win, larg

    def afficher(self, titre, points):
        """Texte à lire (une mise à jour en détail) : un point par ligne, ↑↓ si c'est long ; une touche ferme."""
        h, w = self.e.getmaxyx()
        larg = min(w - 4, 100)
        lignes = []
        for p in points:
            for k, l in enumerate(textwrap.wrap(p, larg - 10) or [""]):
                lignes.append(("• " if k == 0 else "  ") + l)
        vue = max(3, min(len(lignes), h - 8))
        haut = 0
        while True:
            self.dessiner()
            win, larg = self.boite(titre, vue + 1, larg)
            for k, l in enumerate(lignes[haut:haut + vue]):
                win.addstr(2 + k, 3, couper(l, larg - 6))
            pied = (T("↑↓ défiler · une touche : fermer", "↑↓ scroll · any key: close") if len(lignes) > vue
                    else T("Une touche : fermer", "Any key: close"))
            win.addstr(2 + vue, 3, couper(pied, larg - 6), curses.A_DIM)
            win.refresh()
            c = win.getch()
            if c in (curses.KEY_DOWN, ord("j")) and haut + vue < len(lignes):
                haut += 1
            elif c in (curses.KEY_UP, ord("k")) and haut > 0:
                haut -= 1
            elif c not in (curses.KEY_DOWN, curses.KEY_UP, ord("j"), ord("k"), -1):
                return

    def choisir(self, titre, options, aide="", texte=""):
        """Liste d'options (↑↓ Entrée, Échap) ; renvoie l'indice ou None. texte : une explication sur plusieurs lignes,
        au-dessus des options (une question)."""
        i = 0
        larg = max(44, len(titre) + 8, *(len(o) + 8 for o in options), 66 if texte else 0)
        while True:
            self.dessiner()
            lt = textwrap.wrap(texte, min(larg, self.e.getmaxyx()[1] - 4) - 6) if texte else []
            nt = len(lt) + 1 if lt else 0
            win, larg = self.boite(titre, nt + len(options) + (2 if aide else 0), larg)
            for k, l in enumerate(lt):
                win.addstr(2 + k, 3, couper(l, larg - 6))
            for k, o in enumerate(options):
                win.addstr(2 + nt + k, 3, couper(o, larg - 6).ljust(larg - 6), (curses.A_REVERSE | self.ACC) if k == i else 0)
            if aide:
                win.addstr(3 + nt + len(options), 3, couper(aide, larg - 6), curses.A_DIM)
            win.refresh()
            c = win.getch()
            if c in (curses.KEY_UP, ord("k")):
                i = (i - 1) % len(options)
            elif c in (curses.KEY_DOWN, ord("j")):
                i = (i + 1) % len(options)
            elif c in (10, 13, curses.KEY_ENTER, ord(" ")):
                return i
            elif c in (27, ord("q")):
                return None

    def saisir(self, titre, initial="", aide=""):
        """Ligne de texte modifiable ; renvoie le texte ou None (Échap)."""
        texte = list(initial)
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        try:
            while True:
                self.dessiner()
                win, larg = self.boite(titre, 2 if aide else 1, 70)
                champ = larg - 6
                vu = "".join(texte)[-(champ - 1):]
                if aide:
                    win.addstr(3, 3, couper(aide, champ), curses.A_DIM)
                win.addstr(2, 3, vu.ljust(champ), curses.A_UNDERLINE)
                win.move(2, 3 + len(vu))
                win.refresh()
                c = win.get_wch()
                if c in ("\n", "\r", curses.KEY_ENTER):
                    return "".join(texte).strip()
                if c == "\x1b":
                    return None
                if c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    texte = texte[:-1]
                elif c == "\x15":           # Ctrl + U : tout effacer
                    texte = []
                elif isinstance(c, str) and c.isprintable():
                    texte.append(c)
        finally:
            try:
                curses.curs_set(0)
            except curses.error:
                pass

    def filtrer(self, titre, elements):
        """Longue liste avec recherche en tapant : elements = [(texte, valeur)] ; renvoie la valeur ou None."""
        q, i = "", 0
        while True:
            vus = [x for x in elements if q.lower() in x[0].lower()] if q else elements
            i = max(0, min(i, len(vus) - 1))
            h, _ = self.e.getmaxyx()
            n = max(3, min(len(vus), h - 12))
            debut = max(0, i - n + 1)
            self.dessiner()
            win, larg = self.boite(titre, n + 2, 64)
            win.addstr(2, 3, (T("Rechercher : ", "Search: ") + q).ljust(larg - 6), curses.A_UNDERLINE)
            for k, (t, _) in enumerate(vus[debut:debut + n]):
                win.addstr(4 + k, 3, couper(t, larg - 6).ljust(larg - 6), (curses.A_REVERSE | self.ACC) if debut + k == i else 0)
            if not vus:
                win.addstr(4, 3, T("Aucun résultat", "No results"), curses.A_DIM)
            win.refresh()
            c = win.get_wch()
            if c in ("\n", "\r", curses.KEY_ENTER):
                return vus[i][1] if vus else None
            if c == "\x1b":
                return None
            if c == curses.KEY_UP:
                i -= 1
            elif c == curses.KEY_DOWN:
                i += 1
            elif c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                q, i = q[:-1], 0
            elif isinstance(c, str) and c.isprintable():
                q, i = q + c, 0

    def dessiner_popup_capture(self):
        self.dessiner()
        win, larg = self.boite(self.titre_capture, 5, 60)
        if self.msg and time.time() < self.msg_fin and self.msg_err:
            win.addstr(2, 3, couper(self.msg, larg - 6), self.ERR)
        win.addstr(3, 3, T("Appuie sur la nouvelle combinaison…", "Press the new key combination…"), curses.A_BOLD)
        win.addstr(4, 3, couper(T("ex. Super + T, Super + Maj + B, Ctrl + Alt + F", "e.g. Super + T, Super + Shift + B, Ctrl + Alt + F"),
                                larg - 6), curses.A_DIM)
        win.addstr(6, 3, T("Échap : annuler", "Esc: cancel"), curses.A_DIM)
        win.refresh()

    def nouvelles_touches(self, titre):
        self.titre_capture = titre
        self.msg = ""
        self.dessiner_popup_capture()
        return capturer(self.e, self)

    # ── Actions ──
    def mode_graphique(self):
        """Changer de mode graphique : la carte de confirmation de l'île si elle tourne, sinon la question ici ; le
        redémarrage seulement après « Redémarrer… » (nc-gpu-mode basculer --sans-question)."""
        self.statut(T("Ouverture de la confirmation…", "Opening the confirmation…"))
        self.dessiner()
        if ile_appel("gpuMode", 3) == "ok":
            self.statut(T("Confirmation ouverte dans l'île", "Confirmation opened in the island"))
            return
        g = etat_gpu()
        if not g:
            self.statut(T("Ce PC n'a pas de mode graphique à changer", "This PC has no graphics mode to change"), erreur=True)
            return
        cible, titre, texte, bouton = question_gpu(g)
        if not bouton:
            self.afficher(titre, [texte])
            return
        if self.choisir(titre, [bouton, T("Annuler", "Cancel")], texte=texte) != 0:
            self.statut(T("Rien n'a changé", "Nothing changed"))
            return
        # Un terminal normal : pkexec ou sudo peuvent demander le mot de passe (bascule par le module legion_laptop)
        curses.def_prog_mode()
        curses.endwin()
        try:
            code = subprocess.run([os.path.join(BIN, "nc-gpu-mode"), "basculer", "--sans-question", cible]).returncode
        except (KeyboardInterrupt, OSError):
            code = 130
        finally:
            curses.reset_prog_mode()
            curses.flushinp()
            self.e.touchwin()
            self.e.refresh()
        if code != 0:
            self.statut(T("Le changement de mode a échoué", "The mode change failed"), erreur=True)

    def supprimer_session(self, it):
        """Supprimer une session enregistrée (nc-session supprimer NOM), après confirmation ; Annuler ou Échap : rien."""
        nom = it["session"]
        if self.choisir(it["nom"], [T("Supprimer", "Delete"), T("Annuler", "Cancel")], texte=it["confirmer"]) != 0:
            self.statut(T("Rien n'a changé", "Nothing changed"))
            return
        try:
            r = subprocess.run([os.path.join(BIN, "nc-session"), "supprimer", nom], capture_output=True, text=True, timeout=10)
            code, message = r.returncode, (r.stdout.strip() or r.stderr.strip()).split("\n")[-1]
        except (OSError, subprocess.TimeoutExpired):
            code, message = 1, ""
        self.lignes_s = None                               # relue : la session n'y est plus
        if code == 0:
            self.statut(message or T(f"Session « {nom} » supprimée", f"Session “{nom}” deleted"))
        else:
            self.statut(message or T("Suppression impossible", "Could not delete"), erreur=True)

    def dock(self, action, app):
        """nc-dock epingler|retirer APP, son message en bas, puis la liste relue."""
        try:
            r = subprocess.run([os.path.join(BIN, "nc-dock"), action, app], capture_output=True, text=True, timeout=10)
            code, message = r.returncode, (r.stdout.strip() or r.stderr.strip()).split("\n")[-1]
        except (OSError, subprocess.TimeoutExpired):
            code, message = 1, ""
        self.lignes_d = None
        self.statut(message or (T("Dock mis à jour", "Dock updated") if code == 0 else T("Dock inchangé", "Dock unchanged")),
                    erreur=code != 0)

    def changer_dock(self, it):
        """Une appli épinglée : monter, descendre (seulement si elle peut bouger) ou retirer ; le curseur la suit."""
        actions = ([("monter", T("Monter (vers le début du dock)", "Move up (towards the start of the dock)"))] if it["place"] > 0 else []) \
            + ([("descendre", T("Descendre (vers la fin du dock)", "Move down (towards the end of the dock)"))]
               if it["place"] < it["nombre"] - 1 else []) \
            + [("retirer", T("Retirer du dock", "Remove from the dock")), (None, T("Annuler", "Cancel"))]
        i = self.choisir(it["nom"], [a[1] for a in actions])
        if i is None or actions[i][0] is None:
            self.statut(T("Rien n'a changé", "Nothing changed"))
            return
        action = actions[i][0]
        self.dock(action, it["app"])
        if action in ("monter", "descendre") and self.sec in self.pos:
            self.pos[self.sec] += -1 if action == "monter" else 1

    def epingler_au_dock(self):
        """Une partie du nom, puis l'appli parmi celles qui correspondent (8 au plus) ; Échap : rien."""
        texte = self.saisir(T("Ajouter une appli au dock", "Add an app to the dock"), "",
                            T("Une partie de son nom (ex. fire, fichiers)", "Part of its name (e.g. fire, files)"))
        if not texte or not texte.strip():
            return
        try:
            applis = json.loads(sortie([os.path.join(BIN, "nc-apps"), "list"]) or "[]")
        except ValueError:
            applis = []
        deja = [x["id"] for x in dock_epinglees()]
        choix = applis_a_epingler([a for a in applis if isinstance(a, dict)], texte, deja)[:8]
        if not choix:
            self.statut(T(f"Aucune appli installée ne correspond à « {texte.strip()} »",
                          f"No installed app matches “{texte.strip()}”"), erreur=True)
            return
        i = self.choisir(T("Épingler au dock", "Pin to the dock"), [a.get("name") or a["id"] for a in choix],
                         aide=T("Entrée : épingler · Échap : rien", "Enter: pin · Esc: nothing"))
        if i is None:
            self.statut(T("Rien n'a changé", "Nothing changed"))
            return
        self.dock("epingler", choix[i]["id"])

    def assistant(self, it=None):
        if isinstance(it, dict) and it.get("action") == "mode-graphique":
            self.mode_graphique()
            return
        if isinstance(it, dict) and it.get("action") == "session-supprimer":
            self.supprimer_session(it)
            return
        if isinstance(it, dict) and it.get("action") == "dock-appli":
            self.changer_dock(it)
            return
        if isinstance(it, dict) and it.get("action") == "dock-ajouter":
            self.epingler_au_dock()
            return
        if isinstance(it, dict) and it.get("action") == "verifier":
            self.statut(T("Test de la connexion…", "Testing connection…"))
            self.dessiner()
            code, message = verifier_assistant()
            self.statut(message, erreur=code != 0)
            return
        if isinstance(it, dict) and it.get("action") == "ia-tester":
            self.statut(T("Essai des IA…", "Testing the AIs…"))
            self.dessiner()
            r = subprocess.run([os.path.join(BIN, "nc-ia"), "tester", "--json"], capture_output=True, text=True)
            try:
                res = json.loads(r.stdout)
                message = " · ".join(("✓ " if x["ok"] else "✗ ") + x["nom"] for x in res) or T("Aucune IA disponible", "No AI available")
            except ValueError:
                message = (r.stderr.strip() or T("Essai impossible", "Test failed"))[:200]
            self.statut(message, erreur=r.returncode != 0)
            return
        # Le client récupère un terminal normal pour input/getpass, puis on retrouve l'écran des réglages.
        curses.def_prog_mode()
        curses.endwin()
        try:
            action = it.get("action") if isinstance(it, dict) else None
            if action in ("tableau", "deployer", "serveur"):
                code = subprocess.run([sys.executable, os.path.join(BIN, "nc-jarvis"), action]).returncode
            elif action == "ia-cles":
                code = subprocess.run([os.path.join(BIN, "nc-ia"), "configurer"]).returncode
            else:
                code = configurer_assistant()
        except (KeyboardInterrupt, OSError):
            code = 130
        finally:
            curses.reset_prog_mode()
            curses.flushinp()
            self.e.touchwin()
            self.e.refresh()
        message = T("Action JARVIS terminée", "JARVIS action finished") if action in ("tableau", "deployer", "serveur") \
            else T("Clés des IA enregistrées", "AI keys saved") if action == "ia-cles" else T("Connexion de l'assistant enregistrée", "Assistant connection saved")
        self.statut(message if code == 0 else
                    T("Configuration interrompue ou échouée", "Configuration interrupted or failed"),
                    erreur=code != 0)

    def changer(self, r, sens):
        """← → : valeur suivante ou précédente (ou ± pas)."""
        v = valeur(self.vals, r.cle)
        if r.genre in ("ouinon", "choix", "hz"):
            vals = [c for c, _ in r.choix()]
            if not vals:
                return
            i = vals.index(v) if v in vals else 0
            nv = vals[(i + sens) % len(vals)]
        elif r.genre == "entier":
            n = int(v) if re.fullmatch(r"-?\d+", v) else int(r.defaut)
            nv = str(max(r.mini, min(r.maxi, n + sens * r.pas)))
        else:
            return self.entree(r)
        self.poser(r, nv)

    def essayer(self, r):
        """Touche e : montre l'animation choisie (réglages appliqués d'abord)."""
        if self.attente:
            appliquer(self.attente, self.vals)
            self.attente.clear()
        if r.essai == "bouton":
            v = valeur(self.vals, r.cle)
            if v in ("menu", "verrouiller", "veille", "eteindre", "rien"):
                self.statut(T("Rien à essayer : ce n'est pas une animation", "Nothing to try: this isn't an animation"))
                return
            subprocess.Popen([os.path.join(HOME, ".local/bin/nc-anim"), v], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.statut(T("Animation lancée : une touche la ferme", "Animation started: any key closes it"))
        elif r.essai == "verrou":
            time.sleep(0.4)                          # le temps que Noctalia relise sa config
            subprocess.Popen(["loginctl", "lock-session"])
        elif r.essai == "fond":
            time.sleep(0.4)
            subprocess.Popen(["noctalia", "msg", "wallpaper-next"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def poser(self, r, v):
        try:
            g = regler(self.vals, r.cle, v)
        except ValueError as err:
            self.statut(T("Valeur refusée : ", "Value rejected: ") + str(err), erreur=True)
            return
        if g:
            self.attente.add(g)
        if r.cle == "LANGUE":
            self.lignes_r = self.lignes_n = None       # relues dans la nouvelle langue
        self.derniere = time.time()
        self.statut(f"{r.nom}{T(' : ', ': ')}{r.montrer(valeur(self.vals, r.cle))}")

    def entree(self, r):
        if r.genre == "ouinon":
            return self.changer(r, 1)
        if r.genre in ("choix", "hz"):
            ch = r.choix()
            v = valeur(self.vals, r.cle)
            opts = [("✓ " if c == v else "  ") + n for c, n in ch]
            extra = r.genre == "hz"
            i = self.choisir(r.nom, opts + ([T("  Autre fréquence…", "  Other refresh rate…")] if extra else []))
            if i is None:
                return
            if extra and i == len(ch):
                t = self.saisir(r.nom, "", T("Fréquence en Hz : la plus proche que ton écran propose sera prise",
                                             "Refresh rate in Hz: the closest one your screen offers will be used"))
                if t:
                    self.poser(r, t)
                return
            return self.poser(r, ch[i][0])
        sep = "" if EN and r.unite in ("%", "/s") else " "
        aide = {"entier": T("De ", "From ") + f"{r.mini}{T(' à ', ' to ')}{r.maxi}{sep + r.unite if r.unite else ''}",
                "dossier": T("Un chemin (ex. ~/Images/Captures), ou auto", "A path (e.g. ~/Pictures/Screenshots), or auto"),
                "texte": T("Ex. us, fr, us,fr — ou systeme", "E.g. us, fr, us,fr — or system")}.get(r.genre, "")
        t = self.saisir(r.nom, valeur(self.vals, r.cle), aide)
        if t:
            self.poser(r, t)

    def action_raccourci(self, it):
        def faire(fn, *a):
            try:
                self.statut(fn(*a))
            except rc.Refus as err:
                self.statut(str(err), erreur=True)
            self.lignes_r = None

        if it["genre"] == "ajouter":
            return self.ajouter_raccourci()
        if it["desactive"]:
            if self.choisir(it["nom"], [T("Réactiver", "Turn back on"), T("Annuler", "Cancel")]) == 0:
                faire(rc.retablir_ids, it["ids"])
            return
        opts, fns = [], []
        if len(it["ids"]) == 1 and rc.modifiable(it["ids"][0]):
            opts.append(T("Changer les touches", "Change the keys"))
            fns.append("touches")
        if it["mien"]:
            opts.append(T("Retirer ce raccourci", "Remove this shortcut"))
            fns.append("retirer")
        else:
            opts.append(T("Désactiver", "Disable"))
            fns.append("desactiver")
            if it["change"]:
                opts.append(T("Remettre les touches d'origine", "Restore the original keys"))
                fns.append("origine")
        i = self.choisir(f"{it['nom']}  ({touches_de(it)})", opts)
        if i is None:
            return
        f = fns[i]
        if f == "touches":
            t = self.nouvelles_touches(T("Nouvelles touches : ", "New keys: ") + it["nom"])
            if t:
                faire(rc.changer_id, it["ids"][0], t)
        elif f == "retirer":
            faire(rc.retirer_ajout, it["mien"][1])
        elif f == "desactiver":
            faire(rc.desactiver_ids, it["ids"], it["nom"])
        elif f == "origine":
            faire(rc.retablir_ids, it["origs"])

    def ajouter_raccourci(self):
        i = self.choisir(T("Ajouter un raccourci", "Add a shortcut"),
                         [T("Ouvrir une appli", "Open an app"), T("Aller à un bureau", "Go to a workspace"),
                          T("Ouvrir une page de l'île", "Open an island page"), T("Lancer une commande", "Run a command")])
        if i is None:
            return
        if i == 0:
            apps = sorted(rc.apps(), key=lambda a: a["name"].lower())
            choix = self.filtrer(T("Quelle appli ?", "Which app?"), [(a["name"], a) for a in apps])
            if not choix:
                return
            typ, val, nom = "appli", choix["id"], choix["name"]
        elif i == 1:
            k = self.choisir(T("Quel bureau ?", "Which workspace?"), [T("Bureau ", "Workspace ") + str(n) for n in range(1, 11)])
            if k is None:
                return
            typ, val, nom = "bureau", str(k + 1), T("Bureau ", "Workspace ") + str(k + 1)
        elif i == 2:
            pages = [("centre", T("Centre de contrôle", "Control Center")), ("notifications", "Notifications"),
                     ("son", T("Son", "Sound")), ("reseau", "Wi-Fi"), ("bluetooth", "Bluetooth"),
                     ("systeme", T("Système", "System")), ("calendrier", T("Calendrier", "Calendar")),
                     ("minuteur", T("Minuteur", "Timer"))]
            k = self.choisir(T("Quelle page de l'île ?", "Which island page?"), [n for _, n in pages])
            if k is None:
                return
            typ, val, nom = "ile", pages[k][0], T("Île : ", "Island: ") + pages[k][1]
        else:
            c = self.saisir(T("Commande à lancer", "Command to run"), "",
                            T("Ex. kitty -e htop, ou notify-send Bonjour", "E.g. kitty -e htop, or notify-send Hello"))
            if not c:
                return
            n = self.saisir(T("Nom dans la fiche Super + /", "Name in the Super + / cheat sheet"), c)
            typ, val, nom = "commande", c, n or c
        t = self.nouvelles_touches(T("Touches pour : ", "Keys for: ") + nom)
        if not t:
            return
        try:
            self.statut(rc.ajouter(t, typ, val, nom))
        except rc.Refus as err:
            self.statut(str(err), erreur=True)
        self.lignes_r = None

    def deplacer(self, d):
        its = self.items()
        _, i = self.courant()
        j = i + d
        while 0 <= j < len(its) and not self.selectionnable(its[j]):
            j += d if d else 1
        if 0 <= j < len(its):
            self.pos[self.sec] = j

    def clic(self):
        try:
            _, x, y, _, etat = curses.getmouse()
        except curses.error:
            return
        if etat & curses.BUTTON4_PRESSED:
            return self.deplacer(-1)
        if etat & getattr(curses, "BUTTON5_PRESSED", 0x200000):
            return self.deplacer(1)
        if not etat & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
            return
        lg_x = 22
        h = self.e.getmaxyx()[0]
        sec = y - 2 + getattr(self, "debut_sec", 0)
        if x < lg_x and 2 <= y < h - 4 and sec < len(SECTIONS):
            self.sec, self.focus, self.haut = sec, "items", 0
            self.deplacer(0)
            return
        if x > lg_x and y >= 2:
            i = self.haut + y - 2
            its = self.items()
            if i < len(its) and self.selectionnable(its[i]):
                deja = self.pos.get(self.sec, 0) == i and self.focus == "items"
                self.pos[self.sec], self.focus = i, "items"
                if deja:
                    it = its[i]
                    if isinstance(it, R):
                        self.changer(it, 1) if it.genre in ("ouinon",) else self.entree(it)
                    elif it["genre"] == "assistant":
                        self.assistant(it)
                    elif it["genre"] != "info":
                        self.action_raccourci(it)

    def boucle(self):
        self.e.timeout(150)
        while True:
            if self.attente and time.time() - self.derniere > 0.4:
                appliquer(self.attente, self.vals)
                self.attente = set()
            self.dessiner()
            try:
                c = self.e.get_wch()
            except curses.error:
                continue
            if c == curses.KEY_RESIZE:
                continue
            if c == curses.KEY_MOUSE:
                self.clic()
                continue
            if c in ("q", "Q") or (c == "\x1b" and self.focus == "sections"):
                break
            if self.focus == "sections":
                if c in (curses.KEY_UP, "k"):
                    self.sec, self.haut = (self.sec - 1) % len(SECTIONS), 0
                elif c in (curses.KEY_DOWN, "j"):
                    self.sec, self.haut = (self.sec + 1) % len(SECTIONS), 0
                elif c in (curses.KEY_RIGHT, "\n", "\r", "\t", curses.KEY_ENTER, "l"):
                    self.focus = "items"
                    self.deplacer(0)
                continue
            cur, _ = self.courant()
            if c in ("\t", "\x1b", curses.KEY_BTAB):
                self.focus = "sections"
            elif c in (curses.KEY_UP, "k"):
                self.deplacer(-1)
            elif c in (curses.KEY_DOWN, "j"):
                self.deplacer(1)
            elif c == curses.KEY_PPAGE:
                for _ in range(8):
                    self.deplacer(-1)
            elif c == curses.KEY_NPAGE:
                for _ in range(8):
                    self.deplacer(1)
            elif cur is None:
                continue
            elif isinstance(cur, R):
                if c in (curses.KEY_LEFT, "h", "-"):
                    self.changer(cur, -1)
                elif c in (curses.KEY_RIGHT, "l", "+"):
                    self.changer(cur, 1)
                elif c in ("\n", "\r", " ", curses.KEY_ENTER):
                    self.entree(cur)
                elif c in ("r", "R") and cur.cle in self.vals:
                    st = style_vals()
                    self.poser(cur, st[cur.cle] if cur.cle in st and cur.cle != "STYLE" else cur.defaut)
                    du = cur.cle in st and cur.cle != "STYLE"
                    self.statut(T(f"{cur.nom} : valeur {'du style' if du else 'de la config'}",
                                  f"{cur.nom}: {'desktop style' if du else 'config'} value"))
                elif c in ("e", "E") and cur.essai:
                    self.essayer(cur)
            elif cur["genre"] == "assistant":
                if c in ("\n", "\r", " ", curses.KEY_ENTER, curses.KEY_RIGHT):
                    self.assistant(cur)
                elif c == curses.KEY_LEFT:
                    self.focus = "sections"
            elif cur["genre"] == "nouveaute":
                if c in ("\n", "\r", " ", curses.KEY_ENTER, curses.KEY_RIGHT):
                    self.afficher(f"{cur['date']} · {cur['titre']}", cur["points"])
                elif c == curses.KEY_LEFT:
                    self.focus = "sections"
            elif cur["genre"] == "info":                   # lecture seule
                if c == curses.KEY_LEFT:
                    self.focus = "sections"
            else:
                if c in ("\n", "\r", " ", curses.KEY_ENTER, curses.KEY_RIGHT):
                    self.action_raccourci(cur)
                elif c == curses.KEY_LEFT:
                    self.focus = "sections"
        if self.attente:
            appliquer(self.attente, self.vals)


def tui(section=0):
    os.environ.setdefault("ESCDELAY", "25")
    # Fenêtre fermée ou programme arrêté : sortie propre (le mode « capture » de Hyprland est quitté plus bas)
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(1))
    try:
        curses.wrapper(lambda e: Ecran(e, section).boucle())
    finally:
        # Jamais bloqué dans le mode « capture » de Hyprland, même après une erreur
        if sortie(["hyprctl", "submap"]).strip() == "nc-capture":
            subprocess.run(["hyprctl", "eval", "hl.dispatch(hl.dsp.submap('reset'))"], capture_output=True)


# ── Ligne de commande ───────────────────────────────────────────────────────────────────────────────────────────
def catalogue_raccourcis():
    """Les raccourcis (section Raccourcis du terminal) en lignes de catalogue, genre « raccourci » ; [] sans Hyprland."""
    try:
        lignes = raccourcis()
    except Exception:
        return []
    res, groupe = [], ""
    for l in lignes:
        if l["genre"] == "titre":
            groupe = l["nom"]
            continue
        if l["genre"] != "raccourci":
            continue
        t = touches_de(l)
        res.append(dict(cle="raccourci:" + ",".join(l["ids"]), section="Raccourcis", sectionNom=nom_section("Raccourcis"),
                        nom=l["nom"], genre="raccourci", defaut="", aide=groupe, choix=[], mini=0, maxi=0, pas=1, unite="",
                        zero="", valeur=t, affiche=t, modifie=bool(l["change"] or l["desactive"]), groupe="",
                        ids=l["ids"], origs=l["origs"], mien=(l["mien"][1] if l["mien"] else ""),
                        desactive=bool(l["desactive"]), change=bool(l["change"]),
                        modifiable=len(l["ids"]) == 1 and not l["desactive"] and bool(rc.modifiable(l["ids"][0]))))
    return res


def action_raccourci(d):
    """Un changement de raccourci venu de la fenêtre graphique : {action, ids, origs, touches, nom, mien} ; message."""
    global rc
    if rc is None:
        rc = charger("ncraccourci", "nc-raccourci")
    a = d.get("action")
    ids = [str(i) for i in d.get("ids") or []]
    if a == "changer" and len(ids) == 1 and isinstance(d.get("touches"), str):
        return rc.changer_id(ids[0], d["touches"])
    if a == "desactiver" and ids:
        return rc.desactiver_ids(ids, str(d.get("nom") or ""))
    if a == "reactiver" and ids:
        return rc.retablir_ids(ids)
    if a == "origine" and d.get("origs"):
        return rc.retablir_ids([str(i) for i in d["origs"]])
    if a == "retirer" and isinstance(d.get("mien"), str) and d["mien"]:
        return rc.retirer_ajout(d["mien"])
    if a == "renommer" and isinstance(d.get("mien"), str) and d["mien"] and isinstance(d.get("nom"), str):
        return rc.renommer_ajout(d["mien"], d["nom"])
    if a == "ajouter" and isinstance(d.get("touches"), str) and isinstance(d.get("cible"), str) and d["cible"].strip():
        return rc.cmd_add(d["touches"], d["cible"].strip(), str(d.get("nom") or "").strip())
    raise ValueError(T("action de raccourci invalide", "invalid shortcut action"))


def catalogue(vals):
    """Les réglages visibles, leur valeur et tout ce qui permet de les présenter : pour la fenêtre graphique."""
    res = []
    for r in VISIBLES:
        v = valeur(vals, r.cle)
        res.append(dict(cle=r.cle, section=r.section, sectionNom=nom_section(r.section), nom=r.nom, genre=r.genre,
                        defaut=r.defaut, aide=r.aide, choix=[[a, b] for a, b in r.choix()] if r.genre in ("ouinon", "choix", "hz") else [],
                        mini=r.mini, maxi=r.maxi, pas=r.pas, unite=r.unite, zero=r.zero, valeur=v, affiche=r.montrer(v),
                        modifie=r.cle in vals, groupe=r.groupe))
    # Actions qui ouvrent une fenêtre (pas des valeurs) : en tête de leur section
    actions = [dict(cle="action:jarvis-connexion", section="Agents IA (coucou)", sectionNom=nom_section("Agents IA (coucou)"),
                    nom=T("Connexion à l'assistant JARVIS", "JARVIS assistant connection"), genre="action", defaut="",
                    aide=T("Adresse du serveur, clé secrète et test de la connexion, dans une fenêtre.",
                           "Server address, secret key and connection test, in a window."),
                    choix=[], mini=0, maxi=0, pas=1, unite="", zero="", valeur="", affiche=T("Configurer…", "Configure…"),
                    modifie=False, groupe="", commande=["nc-assistant", "configurer"])]
    sec_ia = "Intelligence artificielle"
    for cle_a, nom_a, aide_a, cmd in reversed((
            ("action:ia-cles", T("Clés d'API des IA", "AI API keys"),
             T("Anthropic, OpenAI, Gemini, Mistral, Groq, DeepSeek, OpenRouter et l'adresse d'Ollama : saisie masquée, "
               "chaque clé essayée tout de suite, gardée dans ~/.config/nc/ia.conf (0600).",
               "Anthropic, OpenAI, Gemini, Mistral, Groq, DeepSeek, OpenRouter and the Ollama address: hidden input, each "
               "key tested right away, kept in ~/.config/nc/ia.conf (0600)."), ["nc-ia", "configurer"]),
            ("action:ia-tester", T("Tester les IA disponibles", "Test the available AIs"),
             T("Une question d'un mot à chacune : laquelle répond, et en combien de temps.",
               "A one-word question to each: which one answers, and how fast."), ["nc-ia", "fenetre-test"]))):
        actions.append(dict(cle=cle_a, section=sec_ia, sectionNom=nom_section(sec_ia), nom=nom_a, genre="action", defaut="",
                            aide=aide_a, choix=[], mini=0, maxi=0, pas=1, unite="", zero="", valeur="",
                            affiche=T("Ouvrir…", "Open…"), modifie=False, groupe="", commande=cmd))
    # Rapports de l'IA sur les dernières mises à jour (nc-ia rapport-maj) : en tête de « Mises à jour », le résumé et le détail
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path(HOME, ".cache")) / "nc/rapports"
    for genre in ("systeme", "config"):
        try:
            d = json.loads((cache / f"{genre}.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        quand = time.strftime("%d/%m/%Y" if not EN else "%b %d, %Y", time.localtime(d.get("date", 0)))
        actions.append(dict(cle="rapport:" + genre, section="Mises à jour", sectionNom=nom_section("Mises à jour"),
                            nom=f"{d.get('titre', '')} · {quand}", genre="rapport", defaut="",
                            aide=str(d.get("resume", ""))[:3000], details=[str(x)[:300] for x in d.get("details", [])][:200],
                            ia=d.get("ia", ""), choix=[], mini=0, maxi=0, pas=1, unite="", zero="", valeur="",
                            affiche=T("Détails", "Details"), modifie=False, groupe=""))
    # Mode graphique (Énergie) : l'information puis l'action, en tête ; rien sans objet. Chaque ligne passe devant la
    # première de sa section : l'action est donc posée avant l'information
    for g in reversed(lignes_gpu()):
        actions.append(dict(cle=g["cle"], section="Énergie", sectionNom=nom_section("Énergie"), nom=g["nom"],
                            genre="info" if g["genre"] == "info" else "action", defaut="", aide=g["aide"], choix=[],
                            mini=0, maxi=0, pas=1, unite="", zero="", valeur=g.get("valeur", ""),
                            affiche=g.get("valeur") or g.get("affiche", ""), modifie=False, groupe="",
                            **({} if g["genre"] == "info" else {"commande": ["nc-reglages", "mode-graphique"]})))
    for a in actions:
        i = next((k for k, x in enumerate(res) if x["section"] == a["section"]), len(res))
        res.insert(i, a)
    # Sessions enregistrées : à la fin de Fenêtres. Le bouton demande confirmation sur sa ligne (« confirmer » : la
    # question, « bouton » : le mot du bouton qui confirme), puis la fenêtre relit le catalogue (« relire »)
    fin = max((k + 1 for k, x in enumerate(res) if x["section"] == "Fenêtres"), default=len(res))
    lignes = []
    for s in lignes_sessions():
        ligne = dict(cle=s["cle"], section="Fenêtres", sectionNom=nom_section("Fenêtres"), nom=s["nom"], genre=s["genre"],
                     defaut="", aide=s["aide"], choix=[], mini=0, maxi=0, pas=1, unite="", zero="", valeur=s.get("valeur", ""),
                     affiche=s.get("affiche", s.get("valeur", "")), modifie=False, groupe="")
        if s["genre"] == "assistant":
            ligne.update(genre="action", commande=["nc-session", "supprimer", s["session"]], confirmer=s["confirmer"],
                         bouton=T("Supprimer", "Delete"), relire=True)
        lignes.append(ligne)
    res[fin:fin] = lignes
    # Applis épinglées au dock : à la fin de Barre et dock, « Retirer » sans confirmation (puis relecture) ; l'ajout,
    # qui demande de choisir parmi toutes les applis, et l'ordre se font dans le Spotlight, le dock ou le terminal :
    # ici une ligne qui le dit (une ligne de la fenêtre n'a qu'un bouton)
    fin = max((k + 1 for k, x in enumerate(res) if x["section"] == "Barre et dock"), default=len(res))
    lignes = []
    for s in lignes_dock():
        ligne = dict(cle=s["cle"], section="Barre et dock", sectionNom=nom_section("Barre et dock"), nom=s["nom"],
                     genre=s["genre"], defaut="", aide=s["aide"], choix=[], mini=0, maxi=0, pas=1, unite="", zero="",
                     valeur=s.get("valeur", ""), affiche=s.get("affiche", s.get("valeur", "")), modifie=False, groupe="")
        if s.get("action") == "dock-appli":
            ligne.update(genre="action", commande=["nc-dock", "retirer", s["app"]], relire=True, affiche=T("Retirer", "Remove"))
        elif s.get("action") == "dock-ajouter":
            ligne.update(genre="info", valeur="", affiche="",
                         aide=T("Dans le Spotlight (Super + R) : clic droit sur l'appli, ou Alt + P ; ou clic droit sur son "
                                "icône dans le dock → Épingler. Pour changer l'ordre : nc-reglages dans le terminal "
                                "(Barre et dock), ou nc-dock monter|descendre ID.",
                                "In Spotlight (Super + R): right-click the app, or Alt + P; or right-click its icon in the "
                                "dock → Pin. To change the order: nc-settings in the terminal (Bar and Dock), or "
                                "nc-dock up|down ID."))
        lignes.append(ligne)
    res[fin:fin] = lignes
    return res + catalogue_raccourcis() + catalogue_nouveautes()


def catalogue_nouveautes():
    """La section Nouveautés du terminal pour la fenêtre graphique : une ligne « rapport » par mise à jour (titre, date,
    ses points en détail), et en tête l'annonce d'une version pas encore installée."""
    base = dict(section="Nouveautés", sectionNom=nom_section("Nouveautés"), defaut="", choix=[], mini=0, maxi=0, pas=1,
                unite="", zero="", valeur="", modifie=False, groupe="")
    res = []
    if maj_disponible():
        res.append(dict(base, cle="nouveaute:dispo", genre="info", nom=T("Une nouvelle version est disponible",
                                                                          "A new version is available"),
                        aide=T("nc-maj l'installe (ou « Mettre à jour » dans sa notification).",
                               "nc-update installs it (or “Update” in its notification)."), affiche=""))
    for x in nouveautes():
        res.append(dict(base, cle="nouveaute:" + x["id"], genre="rapport", nom=x["titre"], aide=x["date"],
                        details=[p[:300] for p in x["points"]][:50], ia="", affiche=T("Détails", "Details")))
    if not res:
        res.append(dict(base, cle="nouveaute:aucune", genre="info", nom=T("Historique inconnu", "Unknown history"),
                        aide=T("Lance nc-maj une fois : il note le chemin du dépôt (~/.config/nc/depot).",
                               "Run nc-update once: it records the repository path (~/.config/nc/depot)."), affiche=""))
    return res


def mode_graphique_cli():
    """nc-reglages mode-graphique (bouton de la fenêtre des réglages) : la carte de confirmation de l'île ; sans île, la
    question au terminal ; sans terminal non plus, dans un terminal ouvert pour elle. Jamais de redémarrage sans « oui »."""
    if ile_appel("gpuMode", 5) == "ok":
        return 0
    g = etat_gpu()
    if not g:
        print(T("Ce PC n'a pas de mode graphique à changer (une seule carte graphique, ou pas d'écran interne).",
                "This PC has no graphics mode to change (single GPU, or no built-in display)."))
        return 0
    if sys.stdin.isatty() and sys.stdout.isatty():
        cible, titre, texte, bouton = question_gpu(g)
        print(f"{titre}\n{texte}")
        if not bouton:
            return 0
        try:
            rep = input(f"{bouton} ? {T('[o/N]', '[y/N]')} ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
        if rep not in ("o", "oui", "y", "yes"):
            return 0
        return subprocess.run([os.path.join(BIN, "nc-gpu-mode"), "basculer", "--sans-question", cible]).returncode
    terminal = shutil.which("kitty")
    if not terminal:
        return 1
    subprocess.Popen([terminal, "--class", "nc-reglages", "-e", os.path.join(BIN, "nc-reglages"), "mode-graphique"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def ile_appel_reglages(delai, section=""):
    """Demande à l'île d'ouvrir ses réglages, sur une section si donnée (son nom affiché ; voir ile_appel)."""
    return ile_appel("reglagesSection", delai, section) if section else ile_appel("reglages", delai)


def ile_appel(fonction, delai, *args):
    """Appelle une fonction de l'île (IpcHandler « ile » de shell.qml). Rend « ok », « absente » (pas de qs), « arretee »
    (aucune île ne répond), « lente » (pas de réponse dans le délai) ou « inconnue » (une île tourne mais ne connaît pas
    la fonction : ancienne config gardée après un rechargement à chaud raté)."""
    if not shutil.which("qs"):
        return "absente"
    try:
        p = subprocess.run(["qs", "-c", "nc-ile", "ipc", "call", "ile", fonction, *args], capture_output=True,
                           text=True, timeout=delai)
    except subprocess.TimeoutExpired:
        return "lente"
    except OSError:
        return "absente"
    sortie = (p.stdout + p.stderr).lower()
    # Quickshell 0.3 répond « Function not found. » (ou « Target not found. ») avec le code 0 : le code seul ne suffit pas
    if "not found" in sortie or "no function" in sortie:
        return "inconnue"
    return "ok" if p.returncode == 0 else "arretee"      # ex. « No running instances… », code 255


def ile_reparer(attente=4.0):
    """Une seule tentative : redémarre nc-ile.service, puis attend (au plus `attente` s) que l'île annonce reglages().
    Rien si l'île est désactivée exprès (comme nc-shell-msg). Rend True si le redémarrage a eu lieu."""
    try:
        if subprocess.run(["systemctl", "--user", "is-enabled", "--quiet", "nc-ile.service"], capture_output=True,
                          timeout=3).returncode != 0:
            return False
        if subprocess.run(["systemctl", "--user", "restart", "nc-ile.service"], capture_output=True,
                          timeout=10).returncode != 0:
            return False
    except (OSError, subprocess.TimeoutExpired):
        return False
    fin = time.monotonic() + attente
    while time.monotonic() < fin:
        try:
            p = subprocess.run(["qs", "-c", "nc-ile", "ipc", "show"], capture_output=True, text=True,
                               timeout=max(0.3, min(1.0, fin - time.monotonic())))
            if re.search(r"\bfunction reglages\(", p.stdout):
                break
        except (OSError, subprocess.TimeoutExpired):
            pass
        time.sleep(0.25)
    return True                                          # le second essai dira si l'île répond


def section_demandee(nom):
    """« nc-reglages fenetre SECTION » : la section (nom français de SECTIONS) d'après son nom français ou anglais, sans
    accent ni majuscule ; None si aucune ne correspond."""
    def simple(t):
        return "".join(c for c in unicodedata.normalize("NFD", t.strip().lower()) if not unicodedata.combining(c))
    for s in SECTIONS:
        if simple(nom) in (simple(s), simple(SECTIONS_EN.get(s, s))):
            return s
    return None


def fenetre_ouverte(section=None):
    """Demande à l'île sa fenêtre des réglages (sur `section`, nom français de SECTIONS) ; si elle ne répond pas, un
    redémarrage (ile_reparer) et un second essai. Rend True si la fenêtre est ouverte ; aucun repli ici."""
    nom = nom_section(section) if section else ""
    etat = ile_appel_reglages(5, nom)                    # premier essai : l'île peut être occupée au démarrage
    if etat == "ok":
        return True
    return etat != "absente" and ile_reparer() and ile_appel_reglages(2, nom) == "ok"


def bureau_graphique():
    """Une session graphique sur ce PC (WAYLAND_DISPLAY ou HYPRLAND_INSTANCE_SIGNATURE), et pas par SSH : la fenêtre
    s'ouvrirait sur l'écran du PC, loin de celui qui tape."""
    e = os.environ
    return bool(e.get("WAYLAND_DISPLAY") or e.get("HYPRLAND_INSTANCE_SIGNATURE")) \
        and not (e.get("SSH_CONNECTION") or e.get("SSH_TTY"))


def fenetre_graphique(section=None):
    """nc-reglages fenetre [SECTION] : la fenêtre graphique vit dans l'île Quickshell. Si l'île ne répond pas (arrêtée,
    ou tournant encore avec l'ancienne config après une mise à jour), un redémarrage, puis un second essai ; sinon une
    notification et l'écran des réglages dans un terminal (aussi sans Quickshell : openSUSE, Debian sans qs compilé).
    C'est le seul endroit qui ouvre encore l'écran du terminal tout seul : les touches, menus et boutons du bureau
    passent tous par ici (tests/test_portes_reglages.py)."""
    if fenetre_ouverte(section):
        return 0
    try:                                                 # avant le terminal, plus de silence
        subprocess.run(["notify-send", "-a", "noctalia-config", "-i", "preferences-system",
                        T("L'île ne répond pas : réglages ouverts dans le terminal. Diagnostic : nc-diag",
                          "The island is not responding: settings opened in the terminal. Diagnosis: nc-diag")],
                       stdin=subprocess.DEVNULL, capture_output=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        pass
    terminal = shutil.which("kitty")
    if not terminal:
        return 1
    # Repli : l'écran du terminal (« terminal », sinon nc-reglages retenterait la fenêtre), sur la même section
    cmd = [os.path.join(BIN, "nc-reglages")]
    if section == "Nouveautés":
        cmd = ["sh", "-c", '"$0" nouveautes | less -R', cmd[0]]
    else:
        cmd += ["terminal"] + ([section] if section else [])
    subprocess.Popen([terminal, "--class", "nc-reglages", "-e", *cmd],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def cli(a):
    vals = lire()
    if a[0] == "assistant" and len(a) == 2 and a[1] in ("verifier", "verify", "test"):
        code, message = verifier_assistant()
        print(message, file=sys.stdout if code == 0 else sys.stderr)
        sys.exit(code)
    if a[0] in ("nouveautes", "nouveautés", "news"):
        if maj_disponible():
            print(T("Une nouvelle version est disponible : nc-maj pour l'installer.\n",
                    "A new version is available: nc-update to install it.\n"))
        for x in nouveautes():
            print(f"{x['date']}  {x['titre']}")
            for p in x["points"]:
                for k, l in enumerate(textwrap.wrap(p, 100)):
                    print(("    • " if k == 0 else "      ") + l)
            print()
        return
    if a[0] in ("catalogue", "catalog"):
        # Tout ce que la fenêtre graphique des réglages (île, Parametres.qml) a besoin de savoir, en JSON
        print(json.dumps(catalogue(vals), ensure_ascii=False))
        return
    if a[0] in ("raccourci", "shortcut") and len(a) == 2:
        # Fenêtre graphique : un changement de raccourci, en JSON (jamais passé à un shell)
        try:
            d = json.loads(a[1])
            if not isinstance(d, dict):
                raise ValueError("JSON")
            print(action_raccourci(d))
        except (ValueError, rc.Refus if rc else ValueError) as e:
            sys.exit(T(f"nc-reglages : {e}", f"nc-settings: {e}"))
        return
    if a[0] in ("capture", "capturer"):
        # Fenêtre graphique : Hyprland sans ses raccourcis le temps de taper une combinaison (20 s au plus) ; « fin » rend
        if len(a) == 2 and a[1] in ("fin", "end"):
            subprocess.run(["hyprctl", "eval", "hl.dispatch(hl.dsp.submap('reset'))"], capture_output=True)
        else:
            subprocess.run(["hyprctl", "eval",
                            "nc.capture_jeton = (nc.capture_jeton or 0) + 1 local j = nc.capture_jeton "
                            "hl.dispatch(hl.dsp.submap('nc-capture')) hl.timer(function() if nc.capture_jeton == j and hl.get_current_submap() == 'nc-capture' "
                            "then hl.dispatch(hl.dsp.submap('reset')) end end, { timeout = 20000, type = 'oneshot' })"],
                           capture_output=True)
        return
    if a[0] in ("fenetre", "fenêtre", "window", "gui"):
        section = section_demandee(" ".join(a[1:])) if len(a) > 1 else None
        if len(a) > 1 and not section:
            sys.exit(T(f"nc-reglages : section inconnue : {' '.join(a[1:])} (sections : {', '.join(SECTIONS)})",
                       f"nc-settings: unknown section: {' '.join(a[1:])} (sections: "
                       f"{', '.join(SECTIONS_EN.get(s, s) for s in SECTIONS)})"))
        sys.exit(fenetre_graphique(section))
    if a[0] in ("mode-graphique", "graphics-mode"):
        sys.exit(mode_graphique_cli())
    if a[0] in ("liste", "list", "ls", "settings"):
        sec = None
        for r in VISIBLES:
            if r.section != sec:
                print(f"\n  {nom_section(r.section)}")
                sec = r.section
            m = "●" if r.cle in vals else " "
            print(f"   {m} {r.nom:<44} {r.montrer(valeur(vals, r.cle)):<30} {r.cle}")
        print()
    elif a[0] == "get" and len(a) == 2 and a[1] in PAR_CLE:
        print(valeur(vals, a[1]))
    elif a[0] == "set" and len(a) == 3 and a[1] in PAR_CLE:
        try:
            g = regler(vals, a[1], a[2])
        except ValueError as e:
            sys.exit(T(f"nc-reglages : valeur refusée pour {a[1]} : {e}", f"nc-settings: value rejected for {a[1]}: {e}"))
        appliquer([g] if g else [], vals)
        r = PAR_CLE[a[1]]
        print(f"{r.nom}{T(' : ', ': ')}{r.montrer(valeur(vals, a[1]))}")
    elif a[0] == "reset":
        if len(a) == 2:
            if a[1] not in PAR_CLE:
                sys.exit(T(f"nc-reglages : réglage inconnu : {a[1]}", f"nc-settings: unknown setting: {a[1]}"))
            vals.pop(a[1], None)
            groupes = {PAR_CLE[a[1]].groupe}
        else:
            groupes = {PAR_CLE[k].groupe for k in vals if k in PAR_CLE}
            vals = {}
        ecrire(vals)
        appliquer([g for g in groupes if g], vals)
        print(T("Valeur de la config remise.", "Config value restored."))
    elif a[0] in ("appliquer", "apply"):
        appliquer(["style", "veille", "terminal", "noctalia"] + (["curseur"] if "CURSEUR_TAILLE" in vals else []), vals)
    elif a[0] in ("-h", "--help", "aide", "help"):
        print(T(__doc__.strip(), USAGE_EN))
    else:
        sys.exit(T("nc-reglages : commande ou réglage inconnu (nc-reglages aide, nc-reglages liste)",
                   "nc-settings: unknown command or setting (nc-settings help, nc-settings list)"))


# Commandes qui ouvrent la fenêtre en session graphique (sur cette section), l'écran texte sinon
PORTES_FENETRE = {(): None, ("raccourcis",): "Raccourcis", ("shortcuts",): "Raccourcis",
                  ("assistant",): "Agents IA (coucou)"}


def main(args):
    """nc-reglages, nc-reglages raccourcis, nc-reglages assistant : la fenêtre des réglages (sur sa section) quand on
    est devant le bureau graphique et que l'île répond ; sinon l'écran texte comme avant (SSH, console, sans île :
    openSUSE). nc-reglages terminal (ou tui) : l'écran texte, exprès."""
    porte = tuple(args) in PORTES_FENETRE
    if porte and bureau_graphique():
        if fenetre_ouverte(PORTES_FENETRE[tuple(args)]):
            print(T("Réglages ouverts dans la fenêtre", "Settings opened in the window"))
            return 0
        print(T("L'île ne répond pas : réglages dans le terminal. Diagnostic : nc-diag",
                "The island is not responding: settings in the terminal. Diagnosis: nc-diag"), file=sys.stderr)
    if args[:1] == ["assistant"] and len(args) == 1:
        return configurer_assistant(terminal=True)       # saisie de l'URL et de la clé, dans le terminal
    if porte or args[:1] in (["terminal"], ["tui"]):
        section = 0
        if args[:1] in (["terminal"], ["tui"]) and len(args) > 1:
            nom = section_demandee(" ".join(args[1:]))
            if not nom:
                sys.exit(T(f"nc-reglages : section inconnue : {' '.join(args[1:])} (sections : {', '.join(SECTIONS)})",
                           f"nc-settings: unknown section: {' '.join(args[1:])} (sections: "
                           f"{', '.join(SECTIONS_EN.get(s, s) for s in SECTIONS)})"))
            section = SECTIONS.index(nom)
        elif porte and args:                             # nc-reglages raccourcis
            section = SECTIONS.index("Raccourcis")
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            cli(["liste"])                               # pas d'écran (tube, script) : la liste
        else:
            tui(section)
        return 0
    cli(args)
    return 0


if __name__ == "__main__":
    locale.setlocale(locale.LC_ALL, "")
    sys.exit(main(sys.argv[1:]))
