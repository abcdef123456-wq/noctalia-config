    tomllib = None


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-settings (also nc-reglages): noctalia-config settings, in the island's window or in the terminal.

  nc-settings                     the settings window; the text screen (arrow keys) over SSH, on a console without
                                  a graphical desktop, without the island or when the island does not respond
  nc-settings shortcuts           the same, straight to keyboard shortcuts
  nc-settings assistant           the same, on the JARVIS assistant connection (AI Agents section); without the
                                  window, the URL and key are typed in the terminal
  nc-settings assistant verify    test the remote connection (network, key, TLS, runner)
  nc-settings terminal [SECTION]  the text screen, on purpose, even at the graphical desktop (also: tui)
  nc-settings window [SECTION]    the graphical settings window (island; also Super + Alt + , and the Settings app),
                                  opened on SECTION if given (e.g. Shortcuts, What's New); without the island, the
                                  text screen in a terminal
  nc-settings list                all settings and their values
  nc-settings graphics-mode       change graphics mode (Hybrid ↔ Discrete): confirmation in the island, otherwise here
  nc-settings get KEY             a setting's value
  nc-settings set KEY VALUE       change a setting (e.g. nc-settings set HZ_ECO 60)
  nc-settings reset [KEY]         back to the config's value (every setting without KEY)
  nc-settings apply               rewrite what depends on them (run by updates)
  nc-settings news                what's new in the latest updates of the config

On the text screen: ↑ ↓ to choose, ← → to change the value (applied right away), Enter to type or open,
r to restore the config's value, Tab to switch between sections and settings, q to quit.
Your settings are kept in ~/.config/nc/reglages.conf (only what you change), your shortcuts in
~/.config/nc/raccourcis.conf: updates (nc-update) never touch them. Every part of the config reads
these files: Hyprland, the island, Noctalia (bar, dock, wallpapers…), power profiles, sleep, the terminal.
French command and subcommand names work too (nc-reglages liste, appliquer, raccourcis…)."""

