      "", mini=0, maxi=240, pas=5, unite="min", zero="Jamais", groupe="veille"),
    R("VEILLE_SECTEUR", "Veille", "Mise en veille sur secteur après", "entier", "0",
      "PC branché (ou PC de bureau).", mini=0, maxi=240, pas=5, unite="min", zero="Jamais", groupe="veille"),
    R("COUVERCLE", "Veille", "Couvercle fermé", "choix", "veille",
      "Écran éteint : le PC continue de tourner (téléchargements, musique…), sans veille tant que le couvercle est fermé. "
      "Attention à la chaleur dans un sac.",
      [("veille", "Mise en veille"), ("ecran", "Écran éteint, le PC continue")], groupe="couvercle"),
    R("COUVERCLE_VERROU", "Veille", "Verrouiller en fermant le couvercle", "ouinon", "oui", "Quand le PC continue de tourner, couvercle fermé."),
    # Terminal
    R("TERMINAL_OPACITE", "Terminal", "Opacité du fond", "entier", "88", mini=50, maxi=100, pas=2, unite="%", groupe="terminal"),
    R("TERMINAL_TAILLE", "Terminal", "Taille du texte", "entier", "11", mini=8, maxi=24, unite="pt", groupe="terminal"),
    R("TERMINAL_POLICE", "Terminal", "Police", "choix", "CaskaydiaCove Nerd Font Mono", "Polices « Nerd Font Mono » installées.",
      lambda: polices(r"Nerd Font Mono$", ["CaskaydiaCove Nerd Font Mono", "JetBrainsMono Nerd Font Mono", "FiraCode Nerd Font Mono"]),
      groupe="terminal"),
    R("TERMINAL_CURSEUR", "Terminal", "Forme du curseur", "choix", "beam", "",
      [("beam", "Barre fine"), ("block", "Bloc"), ("underline", "Souligné")], groupe="terminal"),
    R("TERMINAL_TRAINEE", "Terminal", "Traînée du curseur", "ouinon", "oui", "Le curseur laisse une courte traînée quand il saute.", groupe="terminal"),
    R("TERMINAL_MARGE", "Terminal", "Marge autour du texte", "entier", "10", mini=0, maxi=40, unite="px", groupe="terminal"),
    R("TERMINAL_ACCUEIL", "Terminal", "Accueil à l'ouverture", "ouinon", "oui", "Logo et infos du PC à chaque nouveau terminal."),
    # Captures
    R("CAPTURES_DOSSIER", "Captures", "Dossier des captures d'écran", "dossier", "auto", "Automatique : Captures, dans ton dossier Images."),
