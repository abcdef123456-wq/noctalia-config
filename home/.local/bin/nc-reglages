def police_apple():
    """SF Pro si elle est installée, sinon Inter (très proche), sinon rien."""
    familles = set(sortie(["fc-list", ":", "family"]).replace(",", "\n").splitlines())
    for p in ("SF Pro Display", "SF Pro Text", "SF Pro", "Inter", "Inter Variable"):
        if p in familles:
            return p
    return ""


_style_cache = [None, {}]


def style_vals():
    """Valeurs données par le style du bureau (~/.config/nc/style.conf)."""
    try:
        t = os.path.getmtime(STYLE_FICHIER)
    except OSError:
        return {}
    if _style_cache[0] != t:
        v = {}
        with open(STYLE_FICHIER, encoding="utf-8") as f:
            for l in f:
                m = re.match(r"\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$", l)
                if m:
                    v[m[1]] = m[2]
        _style_cache[:] = [t, v]
    return _style_cache[1]


def effectifs(vals):
    """Valeurs en vigueur : celles du style, puis les tiennes."""
    return {**{k: v for k, v in style_vals().items() if k != "STYLE"}, **vals}


def valeur(vals, cle):
    if cle in vals:
        return vals[cle]
    st = style_vals()
    return st[cle] if cle in st and cle != "STYLE" else PAR_CLE[cle].defaut


def regler(vals, cle, v):
    """Change (ou remet, si v est la valeur de la config) un réglage ; renvoie son groupe d'application."""
    r = PAR_CLE[cle]
    v = r.valider(v)
    # Fichier relu juste avant d'écrire : un réglage changé ailleurs entre-temps (autre fenêtre de nc-reglages,
    # ligne de commande) n'est pas écrasé ; vals est mis à jour sur place avec l'état du fichier
    frais = lire()
    vals.clear()
    vals.update(frais)
    base = style_vals().get(cle, r.defaut) if cle != "STYLE" else r.defaut
    if v == base:
        vals.pop(cle, None)
    else:
        vals[cle] = v
    ecrire(vals)
    if cle == "LANGUE":
        # Langue changée : le texte suit tout de suite (écran des réglages ouvert)
        global EN
        EN = _langue() == "en"
    return r.groupe


# ── Application ─────────────────────────────────────────────────────────────────────────────────────────────────
def appliquer_veille(vals):
    verrou, susp, secteur = vals.get("VEILLE_VERROU"), vals.get("VEILLE_SUSPENSION"), vals.get("VEILLE_SECTEUR")
    if verrou is None and susp is None and secteur is None:
        if os.path.exists(VEILLE_UNITE):
            for f in (VEILLE_UNITE, VEILLE_OUT):
                try:
                    os.remove(f)
                except FileNotFoundError:
                    pass
            subprocess.run(["systemctl", "--user", "daemon-reload"])
            subprocess.run(["systemctl", "--user", "restart", "hypridle.service"], capture_output=True)
        return
    try:
        src = open(VEILLE_SRC, encoding="utf-8").read()
    except OSError:
        return
    verrou = int(verrou or PAR_CLE["VEILLE_VERROU"].defaut)
    susp = int(susp or PAR_CLE["VEILLE_SUSPENSION"].defaut)
    secteur = int(secteur or 0)

    def bloc(m):
        b = m.group(0)
        if "nc-brightness dim" in b:
            t = max(30, verrou * 60 - 150) if verrou else 0
        elif "dpms" in b:
            t = verrou * 60 + 30 if verrou else 0
        elif "lock-session" in b:
            t = verrou * 60
        elif "suspend" in b:
            t = susp * 60
        else:
            return b
        return re.sub(r"timeout\s*=\s*\d+", f"timeout = {t}", b) if t > 0 else ""

    texte = re.sub(r"(?ms)^listener\s*\{.*?^\}\n?", bloc, src)
    if secteur:
        # PC branché, ou sans batterie (PC de bureau) : veille après ce délai
        texte += ("\n# nc-reglages : veille sur secteur\nlistener {\n    timeout = %d\n    on-timeout = sh -c 'ls -d "
                  "/sys/class/power_supply/BAT* >/dev/null 2>&1 || exec systemctl suspend; for s in /sys/class/power_supply/*; "
                  "do [ \"$(cat $s/type)\" = Mains ] && [ \"$(cat $s/online)\" = 1 ] && exec systemctl suspend; done; exit 0'\n}\n"
                  % (secteur * 60))
    os.makedirs(os.path.dirname(VEILLE_OUT), exist_ok=True)
    with open(VEILLE_OUT, "w", encoding="utf-8") as f:
        f.write(f"# Généré par nc-reglages depuis ~/.config/hypr/hypridle.conf (verrouillage : {verrou} min, "
                f"veille : {susp} min, sur secteur : {secteur or 'jamais'}). Ne pas éditer.\n" + texte)
    hi = sortie(["sh", "-c", "command -v hypridle"]).strip() or "/usr/bin/hypridle"
    os.makedirs(os.path.dirname(VEILLE_UNITE), exist_ok=True)
    with open(VEILLE_UNITE, "w", encoding="utf-8") as f:
        f.write(f"# nc-reglages : la veille avec tes délais\n[Service]\nExecStart=\nExecStart={hi} -c %h/.config/nc/hypridle.conf\n")
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    subprocess.run(["systemctl", "--user", "restart", "hypridle.service"], capture_output=True)


def appliquer_terminal(vals):
    c = []
    if "TERMINAL_OPACITE" in vals:
        c.append(f"background_opacity {int(vals['TERMINAL_OPACITE']) / 100:.2f}")
    if "TERMINAL_TAILLE" in vals:
        c.append(f"font_size {vals['TERMINAL_TAILLE']}")
    if "TERMINAL_POLICE" in vals:
        c.append(f"font_family {vals['TERMINAL_POLICE']}")
    if "TERMINAL_CURSEUR" in vals:
        c.append(f"cursor_shape {vals['TERMINAL_CURSEUR']}")
    if vals.get("TERMINAL_TRAINEE") == "non":
        c.append("cursor_trail 0")
    if "TERMINAL_MARGE" in vals:
        c.append(f"window_padding_width {vals['TERMINAL_MARGE']}")
    texte = "# Écrit par nc-reglages. Ne pas éditer.\n" + "\n".join(c) + "\n" if c else ""
    ancien = open(KITTY_OUT, encoding="utf-8").read() if os.path.exists(KITTY_OUT) else ""
    if texte == ancien:
        return
    if texte:
        with open(KITTY_OUT, "w", encoding="utf-8") as f:
            f.write(texte)
    elif os.path.exists(KITTY_OUT):
        os.remove(KITTY_OUT)
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)      # kitty relit sa config


def toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    return json.dumps(v, ensure_ascii=False)


def appliquer_noctalia(vals):
    tables = {}

    def mettre(table, cle, v):
        tables.setdefault(table, {})[cle] = v

    def oui(k):
        return vals[k] == "oui"

    if "THEME_MODE" in vals:
        mettre("theme", "mode", vals["THEME_MODE"])
    if "POLICE" in vals:
        mettre("shell", "font_family", vals["POLICE"])
    if "ANIMATIONS_VITESSE" in vals:
        mettre("shell.animation", "speed", float(vals["ANIMATIONS_VITESSE"]))
    if "COINS_ECRAN" in vals:
        mettre("shell.screen_corners", "enabled", oui("COINS_ECRAN"))
    if "VERROU_FLOU" in vals:
        mettre("lockscreen", "blur_intensity", int(vals["VERROU_FLOU"]) / 100)
    if "DOCK_POSITION" in vals:
        mettre("dock", "position", vals["DOCK_POSITION"])
    if any(k in vals for k in ("NUIT", "NUIT_TEMPERATURE", "NUIT_DEBUT", "NUIT_FIN")):
        nuit = valeur(vals, "NUIT")
        mettre("nightlight", "enabled", nuit != "non")
        mettre("nightlight", "force", nuit == "toujours")
        mettre("nightlight", "temperature_night", int(valeur(vals, "NUIT_TEMPERATURE")))
        if nuit == "soir":
            mettre("location", "custom_schedule", True)
            mettre("location", "sunset", valeur(vals, "NUIT_DEBUT"))
            mettre("location", "sunrise", valeur(vals, "NUIT_FIN"))
    if style_vals().get("STYLE") == "oled":
        mettre("theme", "pure_black_dark", True)       # fonds noirs purs
    if style_vals().get("STYLE") == "apple":
        # Barre de menus façon Mac : une bande translucide sur toute la largeur (l'île y fait l'encoche), sans
        # pastilles (le dock est déjà en verre dépoli)
        mettre("bar.default", "capsule", False)
        mettre("bar.default", "background_opacity", 0.55)
    TOUTES = ["disc", "fade", "wipe", "stripes", "honeycomb", "zoom"]
    for cle, table in (("ANIM_VERROU", "lockscreen"), ("ANIM_FOND", "wallpaper")):
        if cle in vals:
            v = vals[cle]
            mettre(table, "transition", TOUTES if v == "aleatoire" else [] if v == "aucune" else [v])
        if cle + "_DUREE" in vals:
            mettre(table, "transition_duration", float(vals[cle + "_DUREE"]))
    if "BARRE_OPACITE" in vals:
        mettre("bar.default", "capsule_opacity", int(vals["BARRE_OPACITE"]) / 100)
    if "BARRE_SYSTEME" in vals and tomllib:
        # La liste de droite de la barre, telle qu'installée, avec ou sans la pastille d'infos système
        try:
            with open(os.path.join(NOCTALIA_DIR, "config.toml"), "rb") as f:
                fin = tomllib.load(f)["bar"]["default"]["end"]
            if not oui("BARRE_SYSTEME"):
                fin = [w for w in fin if w != "group:sys"]
            mettre("bar.default", "end", fin)
        except (OSError, KeyError, ValueError):
            pass
    for cle, nom in (("DOCK", "enabled"), ("DOCK_AUTO", "auto_hide"), ("DOCK_LOUPE", "magnification")):
        if cle in vals:
            mettre("dock", nom, oui(cle))
    if "DOCK_TAILLE" in vals:
        mettre("dock", "icon_size", int(vals["DOCK_TAILLE"]))
    if "FONDS_ROTATION" in vals:
        mettre("wallpaper.automation", "enabled", oui("FONDS_ROTATION"))
    if "FONDS_INTERVALLE" in vals:
        mettre("wallpaper.automation", "interval_seconds", int(vals["FONDS_INTERVALLE"]) * 60)
    if "FONDS_DOSSIER" in vals:
        mettre("wallpaper", "directory", os.path.expanduser(vals["FONDS_DOSSIER"]))

    if vals.get("EFFETS") == "aucun":
        # Plus aucun effet : en dernier, passe devant les choix d'animations et de transitions (qui restent gardés)
        mettre("shell.animation", "enabled", False)
        mettre("wallpaper", "transition", [])
        mettre("lockscreen", "transition", [])
        mettre("dock", "magnification", False)

    texte = ""
    if tables:
        texte = "# Écrit par nc-reglages (tes réglages de Noctalia). Ne pas éditer : nc-reglages.\n"
        for t, kv in tables.items():
            texte += f"\n[{t}]\n" + "".join(f"{k} = {toml_val(v)}\n" for k, v in kv.items())
    ancien = open(NOCTALIA_OUT, encoding="utf-8").read() if os.path.exists(NOCTALIA_OUT) else ""
    if texte == ancien:
        return
    if texte:
        os.makedirs(NOCTALIA_DIR, exist_ok=True)
        with open(NOCTALIA_OUT, "w", encoding="utf-8") as f:
            f.write(texte)
    elif os.path.exists(NOCTALIA_OUT):
        os.remove(NOCTALIA_OUT)
    subprocess.run(["noctalia", "msg", "config-reload"], capture_output=True)


def appliquer_curseur(vals):
    taille = valeur(vals, "CURSEUR_TAILLE")
    theme = os.environ.get("XCURSOR_THEME") or sortie(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"]).strip().strip("'") or "Adwaita"
    subprocess.run(["hyprctl", "setcursor", theme, taille], capture_output=True)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", taille], capture_output=True)
    subprocess.run(["hyprctl", "reload"], capture_output=True)      # variables XCURSOR_SIZE des applis lancées ensuite


def appliquer_style(vals):
    """Écrit les valeurs du style choisi dans style.conf (lues par Hyprland, l'île et nc-reglages) et change la palette
    de Noctalia (Apple), en gardant celle d'avant pour la remettre."""
    style = vals.get("STYLE", "noctalia")
    texte = "# Écrit par nc-reglages : valeurs du style du bureau. Ne pas éditer (nc-reglages → Apparence).\n"
    texte += f"STYLE={style}\n"
    prereglage = dict(STYLES.get(style, {}))
    if style == "apple":
        p = police_apple()
        if p:
            prereglage["POLICE"] = p
    texte += "".join(f"{k}={v}\n" for k, v in prereglage.items())
    ancien = open(STYLE_FICHIER, encoding="utf-8").read() if os.path.exists(STYLE_FICHIER) else ""
    if texte != ancien:
        os.makedirs(os.path.dirname(STYLE_FICHIER), exist_ok=True)
        with open(STYLE_FICHIER, "w", encoding="utf-8") as f:
            f.write(texte)
    # Palette de Noctalia (couleurs de tout le bureau : barre, applis GTK et Qt, terminal…) ; celle d'avant le premier
    # style est gardée pour la remettre
    actuelle = sortie(["noctalia", "msg", "color-scheme-get"]).strip()
    cible = PALETTES.get(style)
    des_styles = {" ".join(p) for p in PALETTES.values()}
    if not actuelle:
        pass                                       # Noctalia ne tourne pas : palette changée au prochain passage
    elif cible:
        if actuelle not in des_styles:
            with open(STYLE_AVANT, "w", encoding="utf-8") as f:
                f.write(actuelle + "\n")
        if actuelle != " ".join(cible):
            subprocess.run(["noctalia", "msg", "color-scheme-set"] + cible, capture_output=True)
    elif actuelle in des_styles:
        try:
            avant = open(STYLE_AVANT, encoding="utf-8").read().split()
        except OSError:
            avant = []
        if len(avant) < 2 or " ".join(avant) in des_styles:
            avant = ["wallpaper", "vibrant"]
        subprocess.run(["noctalia", "msg", "color-scheme-set"] + avant, capture_output=True)
    # Bordures, ombres et terminal (nc-theme-sync lit style.conf), puis tout ce que le style touche
    subprocess.run([os.path.join(HOME, ".local/bin/nc-theme-sync")], capture_output=True)
    return ["hypr", "noctalia", "terminal"]


def appliquer(groupes, vals=None):
    vals = lire() if vals is None else vals
    groupes = list(groupes)
    if "style" in groupes:
        groupes.remove("style")
        groupes += [g for g in appliquer_style(vals) if g not in groupes]
    vals = effectifs(vals)
    for g in groupes:
        if g == "hypr":
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        elif g == "energie":
            subprocess.run(["systemctl", "--user", "restart", "nc-profile-sync.service"], capture_output=True)
            subprocess.run(["hyprctl", "reload"], capture_output=True)      # effets de l'Économie (nc/energie.lua)
        elif g == "veille":
            appliquer_veille(vals)
        elif g == "terminal":
            appliquer_terminal(vals)
        elif g == "noctalia":
            appliquer_noctalia(vals)
        elif g == "effets":
            subprocess.run(["hyprctl", "reload"], capture_output=True)
            appliquer_noctalia(vals)
        elif g == "couvercle":
            subprocess.run(["systemctl", "--user", "enable", "nc-couvercle.service"], capture_output=True)
            subprocess.run(["systemctl", "--user", "restart", "nc-couvercle.service"], capture_output=True)
        elif g == "claude":
            # Hooks de Claude Code ajoutés ou retirés (seulement si Claude Code est là)
            if os.path.isdir(os.path.join(HOME, ".claude")) or shutil.which("claude"):
                quoi = "retirer" if vals.get("CLAUDE_ILE") == "non" else "installer"
                subprocess.run([os.path.join(HOME, ".local/bin/nc-claude"), quoi], capture_output=True)
        elif g.startswith("ia:"):
            # Autres IA (Antigravity, opencode, Codex…) : branchées ou retirées par nc-claude
            ia = g[3:]
            quoi = "retirer" if vals.get(ia.upper() + "_ILE") == "non" else "installer"
            subprocess.run([os.path.join(HOME, ".local/bin/nc-claude"), quoi, ia], capture_output=True)
        elif g == "curseur":
            appliquer_curseur(vals)
        elif g == "langue":
            # Hyprland (raccourcis, notifications) relit sa config ; l'île et les commandes relisent le réglage seules
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        # île, captures, halo : relu tout seul


# ── Raccourcis (moteur : nc-raccourci) ─────────────────────────────────────────────────────────────────────────
rc = None


def raccourcis():
    """Lignes de la section Raccourcis : titres, raccourcis actifs (de la config et les tiens), désactivés."""
    global rc
    if rc is None:
        rc = charger("ncraccourci", "nc-raccourci")
    conf = rc.read_conf()
    groupes, ordre = {}, []
    for b in rc.live_binds():
        if not b["desc"]:
            continue
        if b["desc"] not in groupes:
            groupes[b["desc"]] = []
            ordre.append(b["desc"])
        if b["id"] not in groupes[b["desc"]]:
            groupes[b["desc"]].append(b["id"])
    lignes = {s: [] for s in rc.nckeys.SECTIONS}
    mes = "Mes raccourcis" if "Mes raccourcis" in lignes else rc.nckeys.SECTIONS[-1]
    for d in ordre:
        sec, sep, texte = d.partition("|")
        sec = sec.strip() if sep and sec.strip() in lignes else mes
        ids = groupes[d]
        mien = next((e for e in conf if e[0] == "ajout" and rc.id_of(e[1]) in ids), None)
        origs = [rc.original_id(i, conf) for i in ids]
        lignes[sec].append({"genre": "raccourci", "nom": rc.desc_text(d), "ids": ids, "origs": origs, "mien": mien,
                            "change": any(o != i for o, i in zip(origs, ids)), "desactive": False})
    off = {}
    for e in conf:
        if e[0] == "aucun":
            nom = e[2] if len(e) > 2 and e[2] else T("Raccourci de la config", "Config shortcut")
            off.setdefault(nom, []).append(e[1])
    for nom, ids in off.items():
        lignes[mes].append({"genre": "raccourci", "nom": nom, "ids": ids, "origs": ids, "mien": None,
                                         "change": True, "desactive": True})
    res = [{"genre": "ajouter", "nom": T("Ajouter un raccourci…", "Add a shortcut…")}]
    for s in rc.nckeys.SECTIONS:
        if lignes[s]:
            res.append({"genre": "titre", "nom": nom_section(s)})
            res += lignes[s]
    return res


def touches_de(ligne):
    noms = list(dict.fromkeys(rc.human(i) for i in ligne["ids"]))      # sans doublons (molette haut / bas)
    fins = [n.split(" + ")[-1] for n in noms]
    mods = " + ".join(noms[0].split(" + ")[:-1])
    if len(noms) > 1 and set(fins) <= {"←", "→", "↑", "↓"}:
        return f"{mods} + {T('flèches', 'arrows')}" if mods else T("flèches", "arrows")
    if len(noms) > 3:
        return f"{noms[0]} … {noms[-1].split(' + ')[-1]}"
    return "  /  ".join(noms)


# ── Capture d'une combinaison (kitty) ──────────────────────────────────────────────────────────────────────────
US_POSITION = {"`": 49, "-": 20, "=": 21, "[": 34, "]": 35, ";": 47, "'": 48, "\\": 51, ",": 59, ".": 60, "/": 61}
FONCTIONS = {"P": "F1", "Q": "F2", "R": "F3", "S": "F4", "A": "haut", "B": "bas", "C": "droite", "D": "gauche",
             "H": "Début", "F": "Fin"}
TILDE = {"3": "Suppr", "15": "F5", "17": "F6", "18": "F7", "19": "F8", "20": "F9", "21": "F10", "23": "F11", "24": "F12"}


def lire_sequence(ecran, limite):
    """Une touche du terminal (octets bruts) ; None si rien avant la limite."""
    ecran.nodelay(True)
    octets = []
    try:
        while time.time() < limite:
            c = ecran.getch()
            if c == -1:
                if octets:
                    break
                time.sleep(0.01)
                continue
            octets.append(c)
            if octets[0] != 27:
                break
            if len(octets) > 2 and (chr(c).isalpha() or chr(c) == "~"):       # fin d'une séquence CSI
                break
    finally:
        ecran.nodelay(False)
    return bytes(o for o in octets if o < 256).decode("utf-8", "replace") if octets else None


def touches_de_sequence(s):
    """Séquence du protocole clavier de kitty -> texte pour nc-raccourci (« Super+Maj+T »), « annuler », ou None."""
    m = re.fullmatch(r"\x1b\[(\d+)(?::(\d*))?(?::(\d+))?(?:;(\d+))?u", s)
    if m:
        code, base, mods = int(m[1]), int(m[3]) if m[3] else None, int(m[4] or 1) - 1
        if code == 27 and not mods:
            return "annuler"
        noms = {13: "Entrée", 9: "Tab", 32: "Espace", 27: "Échap"}
        if code in noms:
            touche = noms[code]
        else:
            ch = chr(code)
            b = chr(base) if base else ch
            touche = None
            if len(ch) == 1 and ch.isascii() and ch.isalpha():
                touche = ch.upper()
            elif b.isdigit():
                touche = b
            elif ch.isdigit():
                touche = ch
            elif b in US_POSITION:
                touche = f"code:{US_POSITION[b]}"
        if not touche:
            return None
    else:
        m = re.fullmatch(r"\x1b\[(\d+)?(?:;(\d+))?([A-Z~])", s) or re.fullmatch(r"\x1bO()()([PQRS])", s)
        if not m:
            return "annuler" if s == "\x1b" else None
        mods = int(m[2] or 1) - 1
        touche = TILDE.get(m[1] or "") if m[3] == "~" else FONCTIONS.get(m[3])
        if not touche:
            return None
    noms_mods = [n for bit, n in ((8, "Super"), (4, "Ctrl"), (2, "Alt"), (1, "Maj")) if mods & bit]
    return "+".join(noms_mods + [touche])


def capturer(ecran, ui):
    """Attend une combinaison de touches ; renvoie son texte, ou None (annulé). Hyprland passe en mode « capture »
    (aucun de ses raccourcis ne réagit) le temps de l'appui, avec un retour automatique au bout de 20 s."""
    if os.environ.get("TERM") != "xterm-kitty" and not os.environ.get("KITTY_WINDOW_ID"):
        return ui.saisir(T("Nouvelles touches", "New keys"), "",
                         T("Ex. Super+T, Super+Maj+B, Ctrl+Alt+F", "E.g. Super+T, Super+Shift+B, Ctrl+Alt+F"))
    subprocess.run(["hyprctl", "eval",
                    "hl.dispatch(hl.dsp.submap('nc-capture')) hl.timer(function() if hl.get_current_submap() == 'nc-capture' "
                    "then hl.dispatch(hl.dsp.submap('reset')) end end, { timeout = 20000, type = 'oneshot' })"],
                   capture_output=True)
    sys.stdout.write("\x1b[>5u")              # protocole clavier de kitty : modificateurs et touche d'origine
    sys.stdout.flush()
    ecran.keypad(False)
    try:
        limite = time.time() + 20
        while time.time() < limite:
            s = lire_sequence(ecran, limite)
            if s is None:
                return None
            t = touches_de_sequence(s)
            if t == "annuler":
                return None
            if t and ("+" in t or re.fullmatch(r"F\d+", t)):
                return t
            if t:
                ui.statut(T("Ajoute au moins Super, Ctrl ou Alt (Échap pour annuler)",
                            "Add at least Super, Ctrl or Alt (Esc to cancel)"), erreur=True)
                ui.dessiner_popup_capture()
        return None
    finally:
        sys.stdout.write("\x1b[<u")
        sys.stdout.flush()
        ecran.keypad(True)
        subprocess.run(["hyprctl", "eval", "hl.dispatch(hl.dsp.submap('reset'))"], capture_output=True)


# ── Écran ───────────────────────────────────────────────────────────────────────────────────────────────────────
def couper(t, w):
    return t if len(t) <= w else t[:max(0, w - 1)] + "…"


class Ecran:
    def __init__(self, ecran, section_depart=0):
        self.e = ecran
        self.vals = lire()
        self.sec = section_depart
        self.pos = {}                       # position dans chaque section
        self.focus = "items" if section_depart else "sections"
        self.haut = 0
        self.attente, self.derniere = set(), 0.0
        self.msg, self.msg_err, self.msg_fin = "", False, 0.0
        self.lignes_r = None
        self.titre_capture = ""
        try:                                # terminaux très simples : pas de curseur invisible ni de couleurs
            curses.curs_set(0)
            curses.use_default_colors()
        except curses.error:
            pass
        for i, c in enumerate((curses.COLOR_BLUE, curses.COLOR_YELLOW, curses.COLOR_GREEN, curses.COLOR_RED), 1):
            curses.init_pair(i, c, -1)
        self.ACC, self.MOD, self.OK, self.ERR = (curses.color_pair(i) for i in (1, 2, 3, 4))
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(0)
        if section_depart:
            self.deplacer(0)

    # Lignes de la section courante
    def items(self):
        if SECTIONS[self.sec] == "Raccourcis":
            if self.lignes_r is None:
                self.lignes_r = raccourcis()
            return self.lignes_r
        if SECTIONS[self.sec] == "Nouveautés":
            if getattr(self, "lignes_n", None) is None:
                self.lignes_n = ([{"genre": "titre", "nom": T("Une nouvelle version est disponible : nc-maj pour l'installer",
                                                              "A new version is available: nc-update to install it")}]
                                 if maj_disponible() else []) + nouveautes()
                if not self.lignes_n:
                    self.lignes_n = [{"genre": "titre", "nom": T("Historique introuvable (dépôt de la config absent)",
                                                                 "History not found (config repository missing)")}]
            return self.lignes_n
        return [r for r in VISIBLES if r.section == SECTIONS[self.sec]]

    @staticmethod
    def selectionnable(it):
        return not (isinstance(it, dict) and it["genre"] == "titre")

    def courant(self):
        its = self.items()
        if not its:
            return None, 0
        i = max(0, min(self.pos.get(self.sec, 0), len(its) - 1))
        while i < len(its) - 1 and not self.selectionnable(its[i]):
            i += 1
        return its[i], i

    def statut(self, texte, erreur=False):
        self.msg, self.msg_err, self.msg_fin = texte, erreur, time.time() + 3

    # ── Dessin ──
    def dessiner(self):
        e = self.e
        e.erase()
        h, w = e.getmaxyx()
        if h < 14 or w < 70:
            e.addstr(0, 0, couper(T("Agrandis le terminal pour voir les réglages (70 × 14 au moins).",
                                    "Make the terminal bigger to see the settings (at least 70 × 14)."), w - 1))
            e.refresh()
            return
        titre = T("Réglages", "Settings")
        e.addstr(0, 2, titre, curses.A_BOLD | self.ACC)
        e.addstr(0, 2 + len(titre), T("  de noctalia-config", "  of noctalia-config"), curses.A_DIM)
        chemin = "~/.config/nc/" + ("raccourcis.conf" if SECTIONS[self.sec] == "Raccourcis" else "reglages.conf")
        e.addstr(0, max(32, w - len(chemin) - 2), chemin, curses.A_DIM)
        # Sections
        lg = 22
        # Liste des sections : défile si la fenêtre est trop basse pour toutes les montrer
        place = h - 6
        debut = 0 if len(SECTIONS) <= place else min(max(0, self.sec - place + 2), len(SECTIONS) - place)
        self.debut_sec = debut                     # pour le clic (liste défilée)
        for i, s in enumerate(SECTIONS):
            y = 2 + i - debut
            if y < 2:
                continue
            if y >= h - 4:
                break
            n = len(rc.read_conf()) if (s == "Raccourcis" and rc) else sum(1 for r in VISIBLES if r.section == s and r.cle in self.vals)
            if i == self.sec:
                attr = (curses.A_REVERSE | self.ACC | curses.A_BOLD) if self.focus == "sections" else (curses.A_BOLD | self.ACC)
                e.addstr(y, 1, couper(f" {nom_section(s)}", lg - 3).ljust(lg - 3), attr)
            else:
                e.addstr(y, 1, couper(f" {nom_section(s)}", lg - 3))
            if n:
                e.addstr(y, lg - 2, "●", self.MOD)
        for y in range(2, h - 4):
            e.addstr(y, lg, "│", curses.A_DIM)
        # Réglages de la section
        x0, iw = lg + 4, w - lg - 6
        its = self.items()
        cur, ci = self.courant()
        zone = h - 7
        if ci < self.haut:
            self.haut = ci
        elif ci >= self.haut + zone:
            self.haut = ci - zone + 1
        if ci <= 1:
            self.haut = 0
        col = min(42, iw // 2 + 4)
        for k, it in enumerate(its[self.haut:self.haut + zone]):
            i, y = self.haut + k, 2 + k
            sel = (i == ci and self.focus == "items")
            if isinstance(it, R):
                v = it.montrer(valeur(self.vals, it.cle))
                if sel and it.genre in ("ouinon", "choix", "hz", "entier"):
                    v = f"‹ {v} ›"
                elif sel:
                    v = f"{v}   ↵"
                self.ligne(y, x0, iw, col, it.nom, v, sel, it.cle in self.vals)
            elif it["genre"] == "titre":
                e.addstr(y, x0, couper(it["nom"], iw), curses.A_BOLD | self.ACC)
            elif it["genre"] == "ajouter":
                self.ligne(y, x0, iw, col, "+ " + it["nom"], "", sel, False)
            elif it["genre"] == "nouveaute":
                self.ligne(y, x0, iw, max(col, iw - 14), it["titre"], it["date"], sel, False)
            else:
                t = T("désactivé", "disabled") if it["desactive"] else touches_de(it)
                self.ligne(y, x0, iw, col, it["nom"], t, sel, it["change"] or bool(it["mien"]), gris=it["desactive"])
        if len(its) > zone:
            e.addstr(2, w - 2, "▲" if self.haut > 0 else " ", curses.A_DIM)
            e.addstr(h - 6, w - 2, "▼" if self.haut + zone < len(its) else " ", curses.A_DIM)
        # Explication du réglage choisi
        aide = ""
        if self.focus == "items" and cur is not None:
            if isinstance(cur, R):
                aide = cur.aide
                st = style_vals()
                du_style = cur.cle in st and cur.cle != "STYLE"
                if cur.cle in self.vals:
                    base = st[cur.cle] if du_style else cur.defaut
                    if EN:
                        origine = "Desktop style" if du_style else "Config"
                        aide = (aide + "  " if aide else "") + f"{origine} value: {cur.montrer(base)} (r to restore it)."
                    else:
                        origine = "du style Apple" if du_style else "de la config"
                        aide = (aide + "  " if aide else "") + f"Valeur {origine} : {cur.montrer(base)} (r pour la remettre)."
                elif du_style:
                    aide = (aide + "  " if aide else "") + T("Valeur donnée par le style Apple.", "Value set by the desktop style.")
            elif cur["genre"] == "nouveaute":
                aide = " · ".join(cur["points"][1:4]) or cur["points"][0]
                aide = (aide[:240] + "…") if len(aide) > 240 else aide
            elif cur["genre"] == "ajouter":
                aide = T("Une appli (va à sa fenêtre si elle est ouverte, sinon la lance), un bureau, une page de l'île ou une commande.",
                         "An app (goes to its window if it's open, otherwise launches it), a workspace, an island page or a command.")
            elif cur["genre"] == "raccourci":
                if cur["mien"]:
                    aide = T("Un de tes raccourcis. Entrée : changer les touches ou le retirer.",
                             "One of your shortcuts. Enter: change the keys or remove it.")
                elif cur["desactive"]:
                    aide = T("Raccourci de la config désactivé. Entrée : le réactiver.",
                             "Config shortcut disabled. Enter: turn it back on.")
                else:
                    aide = T("Entrée : changer les touches ou désactiver.", "Enter: change the keys or disable it.")
                    if cur["change"]:
                        aide += T("  À l'origine : ", "  Originally: ") + f"{' / '.join(rc.human(o) for o in cur['origs'][:3])}."
        elif self.focus == "sections":
            aide = T("Choisis une section. Un point marque ce que tu as changé.",
                     "Choose a section. A dot marks what you've changed.")
        for k, l in enumerate(textwrap.wrap(aide, w - 4)[:2]):
            e.addstr(h - 4 + k, 2, l, curses.A_DIM)
        if self.msg and time.time() < self.msg_fin:
            e.addstr(h - 2, 2, couper(("✗ " if self.msg_err else "✓ ") + self.msg, w - 4), self.ERR if self.msg_err else self.OK)
        if self.focus == "sections":
            bas = T("↑↓ section    → ou Entrée : ouvrir    q : quitter", "↑↓ section    → or Enter: open    q: quit")
        elif SECTIONS[self.sec] == "Raccourcis":
            bas = T("↑↓ choisir    Entrée : modifier    Échap : sections    q : quitter",
                    "↑↓ choose    Enter: edit    Esc: sections    q: quit")
        elif SECTIONS[self.sec] == "Nouveautés":
            bas = T("↑↓ choisir    Entrée : tout ce qu'elle apporte    Échap : sections    q : quitter",
                    "↑↓ choose    Enter: everything it brings    Esc: sections    q: quit")
        else:
            bas = T("↑↓ choisir    ← → changer    Entrée : choisir dans la liste    r : valeur de la config    Échap : sections    q : quitter",
                    "↑↓ choose    ← → change    Enter: pick from the list    r: config value    Esc: sections    q: quit")
            cur_r = self.courant()[0]
            if isinstance(cur_r, R) and cur_r.essai:
                bas = T("↑↓ choisir    ← → changer    Entrée : liste    e : essayer    r : valeur de la config    Échap : sections    q : quitter",
                        "↑↓ choose    ← → change    Enter: list    e: try it    r: config value    Esc: sections    q: quit")
        e.addstr(h - 1, 2, couper(bas, w - 4), curses.A_DIM)
        e.refresh()

    def ligne(self, y, x0, iw, col, nom, v, sel, change, gris=False):
        e = self.e
        if change:
            e.addstr(y, x0 - 2, "●", self.MOD)
        if sel:
            attr = curses.A_REVERSE | self.ACC | curses.A_BOLD
            e.addstr(y, x0 - 1, " " * (iw + 1), attr)
            e.addstr(y, x0, couper(nom, col - 2), attr)
            e.addstr(y, x0 + col, couper(v, iw - col), attr)
        else:
            e.addstr(y, x0, couper(nom, col - 2), curses.A_DIM if gris else curses.A_NORMAL)
            e.addstr(y, x0 + col, couper(v, iw - col), curses.A_DIM if gris else self.ACC)

    # ── Fenêtres par-dessus ──
    def boite(self, titre, n, larg):
        h, w = self.e.getmaxyx()
        larg = min(w - 4, larg)
        haut = n + 4
        win = curses.newwin(haut, larg, max(1, (h - haut) // 2), (w - larg) // 2)
        win.keypad(True)
        win.erase()
        win.box()
        win.addstr(0, 2, f" {couper(titre, larg - 6)} ", curses.A_BOLD | self.ACC)
        return win, larg

    def afficher(self, titre, points):
        """Texte à lire (une mise à jour en détail) : un point par ligne, ↑↓ si c'est long ; une touche ferme."""
        h, w = self.e.getmaxyx()
        larg = min(w - 4, 100)
        lignes = []
        for p in points:
            for k, l in enumerate(textwrap.wrap(p, larg - 10) or [""]):
                lignes.append(("• " if k == 0 else "  ") + l)
        vue = max(3, min(len(lignes), h - 8))
        haut = 0
        while True:
            self.dessiner()
            win, larg = self.boite(titre, vue + 1, larg)
            for k, l in enumerate(lignes[haut:haut + vue]):
                win.addstr(2 + k, 3, couper(l, larg - 6))
            pied = (T("↑↓ défiler · une touche : fermer", "↑↓ scroll · any key: close") if len(lignes) > vue
                    else T("Une touche : fermer", "Any key: close"))
            win.addstr(2 + vue, 3, couper(pied, larg - 6), curses.A_DIM)
            win.refresh()
            c = win.getch()
            if c in (curses.KEY_DOWN, ord("j")) and haut + vue < len(lignes):
                haut += 1
            elif c in (curses.KEY_UP, ord("k")) and haut > 0:
                haut -= 1
            elif c not in (curses.KEY_DOWN, curses.KEY_UP, ord("j"), ord("k"), -1):
                return

    def choisir(self, titre, options, aide=""):
        """Liste d'options (↑↓ Entrée, Échap) ; renvoie l'indice ou None."""
        i = 0
        larg = max(44, len(titre) + 8, *(len(o) + 8 for o in options))
        while True:
            self.dessiner()
            win, larg = self.boite(titre, len(options) + (2 if aide else 0), larg)
            for k, o in enumerate(options):
                win.addstr(2 + k, 3, couper(o, larg - 6).ljust(larg - 6), (curses.A_REVERSE | self.ACC) if k == i else 0)
            if aide:
                win.addstr(3 + len(options), 3, couper(aide, larg - 6), curses.A_DIM)
            win.refresh()
            c = win.getch()
            if c in (curses.KEY_UP, ord("k")):
                i = (i - 1) % len(options)
            elif c in (curses.KEY_DOWN, ord("j")):
                i = (i + 1) % len(options)
            elif c in (10, 13, curses.KEY_ENTER, ord(" ")):
                return i
            elif c in (27, ord("q")):
                return None

    def saisir(self, titre, initial="", aide=""):
        """Ligne de texte modifiable ; renvoie le texte ou None (Échap)."""
        texte = list(initial)
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        try:
            while True:
                self.dessiner()
                win, larg = self.boite(titre, 2 if aide else 1, 70)
                champ = larg - 6
                vu = "".join(texte)[-(champ - 1):]
                if aide:
                    win.addstr(3, 3, couper(aide, champ), curses.A_DIM)
                win.addstr(2, 3, vu.ljust(champ), curses.A_UNDERLINE)
                win.move(2, 3 + len(vu))
                win.refresh()
                c = win.get_wch()
                if c in ("\n", "\r", curses.KEY_ENTER):
                    return "".join(texte).strip()
                if c == "\x1b":
                    return None
                if c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    texte = texte[:-1]
                elif c == "\x15":           # Ctrl + U : tout effacer
                    texte = []
                elif isinstance(c, str) and c.isprintable():
                    texte.append(c)
        finally:
            try:
                curses.curs_set(0)
            except curses.error:
                pass

    def filtrer(self, titre, elements):
        """Longue liste avec recherche en tapant : elements = [(texte, valeur)] ; renvoie la valeur ou None."""
        q, i = "", 0
        while True:
            vus = [x for x in elements if q.lower() in x[0].lower()] if q else elements
            i = max(0, min(i, len(vus) - 1))
            h, _ = self.e.getmaxyx()
            n = max(3, min(len(vus), h - 12))
            debut = max(0, i - n + 1)
            self.dessiner()
            win, larg = self.boite(titre, n + 2, 64)
            win.addstr(2, 3, (T("Rechercher : ", "Search: ") + q).ljust(larg - 6), curses.A_UNDERLINE)
            for k, (t, _) in enumerate(vus[debut:debut + n]):
                win.addstr(4 + k, 3, couper(t, larg - 6).ljust(larg - 6), (curses.A_REVERSE | self.ACC) if debut + k == i else 0)
            if not vus:
                win.addstr(4, 3, T("Aucun résultat", "No results"), curses.A_DIM)
            win.refresh()
            c = win.get_wch()
            if c in ("\n", "\r", curses.KEY_ENTER):
                return vus[i][1] if vus else None
            if c == "\x1b":
                return None
            if c == curses.KEY_UP:
                i -= 1
            elif c == curses.KEY_DOWN:
                i += 1
            elif c in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                q, i = q[:-1], 0
            elif isinstance(c, str) and c.isprintable():
                q, i = q + c, 0

    def dessiner_popup_capture(self):
        self.dessiner()
        win, larg = self.boite(self.titre_capture, 5, 60)
        if self.msg and time.time() < self.msg_fin and self.msg_err:
            win.addstr(2, 3, couper(self.msg, larg - 6), self.ERR)
        win.addstr(3, 3, T("Appuie sur la nouvelle combinaison…", "Press the new key combination…"), curses.A_BOLD)
        win.addstr(4, 3, couper(T("ex. Super + T, Super + Maj + B, Ctrl + Alt + F", "e.g. Super + T, Super + Shift + B, Ctrl + Alt + F"),
                                larg - 6), curses.A_DIM)
        win.addstr(6, 3, T("Échap : annuler", "Esc: cancel"), curses.A_DIM)
        win.refresh()

    def nouvelles_touches(self, titre):
        self.titre_capture = titre
        self.msg = ""
        self.dessiner_popup_capture()
        return capturer(self.e, self)

    # ── Actions ──
    def changer(self, r, sens):
        """← → : valeur suivante ou précédente (ou ± pas)."""
        v = valeur(self.vals, r.cle)
        if r.genre in ("ouinon", "choix", "hz"):
            vals = [c for c, _ in r.choix()]
            if not vals:
                return
            i = vals.index(v) if v in vals else 0
            nv = vals[(i + sens) % len(vals)]
        elif r.genre == "entier":
            n = int(v) if re.fullmatch(r"-?\d+", v) else int(r.defaut)
            nv = str(max(r.mini, min(r.maxi, n + sens * r.pas)))
        else:
            return self.entree(r)
        self.poser(r, nv)

    def essayer(self, r):
        """Touche e : montre l'animation choisie (réglages appliqués d'abord)."""
        if self.attente:
            appliquer(self.attente, self.vals)
            self.attente.clear()
        if r.essai == "bouton":
            v = valeur(self.vals, r.cle)
            if v in ("menu", "verrouiller", "veille", "eteindre", "rien"):
                self.statut(T("Rien à essayer : ce n'est pas une animation", "Nothing to try: this isn't an animation"))
                return
            subprocess.Popen([os.path.join(HOME, ".local/bin/nc-anim"), v], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.statut(T("Animation lancée : une touche la ferme", "Animation started: any key closes it"))
        elif r.essai == "verrou":
            time.sleep(0.4)                          # le temps que Noctalia relise sa config
            subprocess.Popen(["loginctl", "lock-session"])
        elif r.essai == "fond":
            time.sleep(0.4)
            subprocess.Popen(["noctalia", "msg", "wallpaper-next"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def poser(self, r, v):
        try:
            g = regler(self.vals, r.cle, v)
        except ValueError as err:
            self.statut(T("Valeur refusée : ", "Value rejected: ") + str(err), erreur=True)
            return
        if g:
            self.attente.add(g)
        if r.cle == "LANGUE":
            self.lignes_r = self.lignes_n = None       # relues dans la nouvelle langue
        self.derniere = time.time()
        self.statut(f"{r.nom}{T(' : ', ': ')}{r.montrer(valeur(self.vals, r.cle))}")

    def entree(self, r):
        if r.genre == "ouinon":
            return self.changer(r, 1)
        if r.genre in ("choix", "hz"):
            ch = r.choix()
            v = valeur(self.vals, r.cle)
            opts = [("✓ " if c == v else "  ") + n for c, n in ch]
            extra = r.genre == "hz"
            i = self.choisir(r.nom, opts + ([T("  Autre fréquence…", "  Other refresh rate…")] if extra else []))
            if i is None:
                return
            if extra and i == len(ch):
                t = self.saisir(r.nom, "", T("Fréquence en Hz : la plus proche que ton écran propose sera prise",
                                             "Refresh rate in Hz: the closest one your screen offers will be used"))
                if t:
                    self.poser(r, t)
                return
            return self.poser(r, ch[i][0])
        sep = "" if EN and r.unite in ("%", "/s") else " "
        aide = {"entier": T("De ", "From ") + f"{r.mini}{T(' à ', ' to ')}{r.maxi}{sep + r.unite if r.unite else ''}",
                "dossier": T("Un chemin (ex. ~/Images/Captures), ou auto", "A path (e.g. ~/Pictures/Screenshots), or auto"),
                "texte": T("Ex. us, fr, us,fr — ou systeme", "E.g. us, fr, us,fr — or system")}.get(r.genre, "")
        t = self.saisir(r.nom, valeur(self.vals, r.cle), aide)
        if t:
            self.poser(r, t)

    def action_raccourci(self, it):
        def faire(fn, *a):
            try:
                self.statut(fn(*a))
            except rc.Refus as err:
                self.statut(str(err), erreur=True)
            self.lignes_r = None

        if it["genre"] == "ajouter":
            return self.ajouter_raccourci()
        if it["desactive"]:
            if self.choisir(it["nom"], [T("Réactiver", "Turn back on"), T("Annuler", "Cancel")]) == 0:
                faire(rc.retablir_ids, it["ids"])
            return
        opts, fns = [], []
        if len(it["ids"]) == 1 and rc.modifiable(it["ids"][0]):
            opts.append(T("Changer les touches", "Change the keys"))
            fns.append("touches")
        if it["mien"]:
            opts.append(T("Retirer ce raccourci", "Remove this shortcut"))
            fns.append("retirer")
        else:
            opts.append(T("Désactiver", "Disable"))
            fns.append("desactiver")
            if it["change"]:
                opts.append(T("Remettre les touches d'origine", "Restore the original keys"))
                fns.append("origine")
        i = self.choisir(f"{it['nom']}  ({touches_de(it)})", opts)
        if i is None:
            return
        f = fns[i]
        if f == "touches":
            t = self.nouvelles_touches(T("Nouvelles touches : ", "New keys: ") + it["nom"])
            if t:
                faire(rc.changer_id, it["ids"][0], t)
        elif f == "retirer":
            faire(rc.retirer_ajout, it["mien"][1])
        elif f == "desactiver":
            faire(rc.desactiver_ids, it["ids"], it["nom"])
        elif f == "origine":
            faire(rc.retablir_ids, it["origs"])

    def ajouter_raccourci(self):
        i = self.choisir(T("Ajouter un raccourci", "Add a shortcut"),
                         [T("Ouvrir une appli", "Open an app"), T("Aller à un bureau", "Go to a workspace"),
                          T("Ouvrir une page de l'île", "Open an island page"), T("Lancer une commande", "Run a command")])
        if i is None:
            return
        if i == 0:
            apps = sorted(rc.apps(), key=lambda a: a["name"].lower())
            choix = self.filtrer(T("Quelle appli ?", "Which app?"), [(a["name"], a) for a in apps])
            if not choix:
                return
            typ, val, nom = "appli", choix["id"], choix["name"]
        elif i == 1:
            k = self.choisir(T("Quel bureau ?", "Which workspace?"), [T("Bureau ", "Workspace ") + str(n) for n in range(1, 11)])
            if k is None:
                return
            typ, val, nom = "bureau", str(k + 1), T("Bureau ", "Workspace ") + str(k + 1)
        elif i == 2:
            pages = [("centre", T("Centre de contrôle", "Control Center")), ("notifications", "Notifications"),
                     ("son", T("Son", "Sound")), ("reseau", "Wi-Fi"), ("bluetooth", "Bluetooth"),
                     ("systeme", T("Système", "System")), ("calendrier", T("Calendrier", "Calendar")),
                     ("minuteur", T("Minuteur", "Timer"))]
            k = self.choisir(T("Quelle page de l'île ?", "Which island page?"), [n for _, n in pages])
            if k is None:
                return
            typ, val, nom = "ile", pages[k][0], T("Île : ", "Island: ") + pages[k][1]
        else:
            c = self.saisir(T("Commande à lancer", "Command to run"), "",
                            T("Ex. kitty -e htop, ou notify-send Bonjour", "E.g. kitty -e htop, or notify-send Hello"))
            if not c:
                return
            n = self.saisir(T("Nom dans la fiche Super + /", "Name in the Super + / cheat sheet"), c)
            typ, val, nom = "commande", c, n or c
        t = self.nouvelles_touches(T("Touches pour : ", "Keys for: ") + nom)
        if not t:
            return
        try:
            self.statut(rc.ajouter(t, typ, val, nom))
        except rc.Refus as err:
            self.statut(str(err), erreur=True)
        self.lignes_r = None

    def deplacer(self, d):
        its = self.items()
        _, i = self.courant()
        j = i + d
        while 0 <= j < len(its) and not self.selectionnable(its[j]):
            j += d if d else 1
        if 0 <= j < len(its):
            self.pos[self.sec] = j

    def clic(self):
        try:
            _, x, y, _, etat = curses.getmouse()
        except curses.error:
            return
        if etat & curses.BUTTON4_PRESSED:
            return self.deplacer(-1)
        if etat & getattr(curses, "BUTTON5_PRESSED", 0x200000):
            return self.deplacer(1)
        if not etat & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
            return
        lg_x = 22
        h = self.e.getmaxyx()[0]
        sec = y - 2 + getattr(self, "debut_sec", 0)
        if x < lg_x and 2 <= y < h - 4 and sec < len(SECTIONS):
            self.sec, self.focus, self.haut = sec, "items", 0
            self.deplacer(0)
            return
        if x > lg_x and y >= 2:
            i = self.haut + y - 2
            its = self.items()
            if i < len(its) and self.selectionnable(its[i]):
                deja = self.pos.get(self.sec, 0) == i and self.focus == "items"
                self.pos[self.sec], self.focus = i, "items"
                if deja:
                    it = its[i]
                    if isinstance(it, R):
                        self.changer(it, 1) if it.genre in ("ouinon",) else self.entree(it)
                    else:
                        self.action_raccourci(it)

    def boucle(self):
        self.e.timeout(150)
        while True:
            if self.attente and time.time() - self.derniere > 0.4:
                appliquer(self.attente, self.vals)
                self.attente = set()
            self.dessiner()
            try:
                c = self.e.get_wch()
            except curses.error:
                continue
            if c == curses.KEY_RESIZE:
                continue
            if c == curses.KEY_MOUSE:
                self.clic()
                continue
            if c in ("q", "Q") or (c == "\x1b" and self.focus == "sections"):
                break
            if self.focus == "sections":
                if c in (curses.KEY_UP, "k"):
                    self.sec, self.haut = (self.sec - 1) % len(SECTIONS), 0
                elif c in (curses.KEY_DOWN, "j"):
                    self.sec, self.haut = (self.sec + 1) % len(SECTIONS), 0
                elif c in (curses.KEY_RIGHT, "\n", "\r", "\t", curses.KEY_ENTER, "l"):
                    self.focus = "items"
                    self.deplacer(0)
                continue
            cur, _ = self.courant()
            if c in ("\t", "\x1b", curses.KEY_BTAB):
                self.focus = "sections"
            elif c in (curses.KEY_UP, "k"):
                self.deplacer(-1)
            elif c in (curses.KEY_DOWN, "j"):
                self.deplacer(1)
            elif c == curses.KEY_PPAGE:
                for _ in range(8):
                    self.deplacer(-1)
            elif c == curses.KEY_NPAGE:
                for _ in range(8):
                    self.deplacer(1)
            elif cur is None:
                continue
            elif isinstance(cur, R):
                if c in (curses.KEY_LEFT, "h", "-"):
                    self.changer(cur, -1)
                elif c in (curses.KEY_RIGHT, "l", "+"):
                    self.changer(cur, 1)
                elif c in ("\n", "\r", " ", curses.KEY_ENTER):
                    self.entree(cur)
                elif c in ("r", "R") and cur.cle in self.vals:
                    st = style_vals()
                    self.poser(cur, st[cur.cle] if cur.cle in st and cur.cle != "STYLE" else cur.defaut)
                    du = cur.cle in st and cur.cle != "STYLE"
                    self.statut(T(f"{cur.nom} : valeur {'du style' if du else 'de la config'}",
                                  f"{cur.nom}: {'desktop style' if du else 'config'} value"))
                elif c in ("e", "E") and cur.essai:
                    self.essayer(cur)
            elif cur["genre"] == "nouveaute":
                if c in ("\n", "\r", " ", curses.KEY_ENTER, curses.KEY_RIGHT):
                    self.afficher(f"{cur['date']} · {cur['titre']}", cur["points"])
                elif c == curses.KEY_LEFT:
                    self.focus = "sections"
            else:
                if c in ("\n", "\r", " ", curses.KEY_ENTER, curses.KEY_RIGHT):
                    self.action_raccourci(cur)
                elif c == curses.KEY_LEFT:
                    self.focus = "sections"
        if self.attente:
            appliquer(self.attente, self.vals)


def tui(section=0):
    os.environ.setdefault("ESCDELAY", "25")
    # Fenêtre fermée ou programme arrêté : sortie propre (le mode « capture » de Hyprland est quitté plus bas)
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(1))
    try:
        curses.wrapper(lambda e: Ecran(e, section).boucle())
    finally:
        # Jamais bloqué dans le mode « capture » de Hyprland, même après une erreur
        if sortie(["hyprctl", "submap"]).strip() == "nc-capture":
            subprocess.run(["hyprctl", "eval", "hl.dispatch(hl.dsp.submap('reset'))"], capture_output=True)


# ── Ligne de commande ───────────────────────────────────────────────────────────────────────────────────────────
def cli(a):
    vals = lire()
    if a[0] in ("nouveautes", "nouveautés", "news"):
        if maj_disponible():
            print(T("Une nouvelle version est disponible : nc-maj pour l'installer.\n",
                    "A new version is available: nc-update to install it.\n"))
        for x in nouveautes():
            print(f"{x['date']}  {x['titre']}")
            for p in x["points"]:
                for k, l in enumerate(textwrap.wrap(p, 100)):
                    print(("    • " if k == 0 else "      ") + l)
            print()
        return
    if a[0] in ("liste", "list", "ls", "settings"):
        sec = None
        for r in VISIBLES:
            if r.section != sec:
                print(f"\n  {nom_section(r.section)}")
                sec = r.section
            m = "●" if r.cle in vals else " "
            print(f"   {m} {r.nom:<44} {r.montrer(valeur(vals, r.cle)):<30} {r.cle}")
        print()
    elif a[0] == "get" and len(a) == 2 and a[1] in PAR_CLE:
        print(valeur(vals, a[1]))
    elif a[0] == "set" and len(a) == 3 and a[1] in PAR_CLE:
        try:
            g = regler(vals, a[1], a[2])
        except ValueError as e:
            sys.exit(T(f"nc-reglages : valeur refusée pour {a[1]} : {e}", f"nc-settings: value rejected for {a[1]}: {e}"))
        appliquer([g] if g else [], vals)
        r = PAR_CLE[a[1]]
        print(f"{r.nom}{T(' : ', ': ')}{r.montrer(valeur(vals, a[1]))}")
    elif a[0] == "reset":
        if len(a) == 2:
            if a[1] not in PAR_CLE:
                sys.exit(T(f"nc-reglages : réglage inconnu : {a[1]}", f"nc-settings: unknown setting: {a[1]}"))
            vals.pop(a[1], None)
            groupes = {PAR_CLE[a[1]].groupe}
        else:
            groupes = {PAR_CLE[k].groupe for k in vals if k in PAR_CLE}
            vals = {}
        ecrire(vals)
        appliquer([g for g in groupes if g], vals)
        print(T("Valeur de la config remise.", "Config value restored."))
    elif a[0] in ("appliquer", "apply"):
        appliquer(["style", "veille", "terminal", "noctalia"] + (["curseur"] if "CURSEUR_TAILLE" in vals else []), vals)
    elif a[0] in ("-h", "--help", "aide", "help"):
        print(T(__doc__.strip(), USAGE_EN))
    else:
        sys.exit(T("nc-reglages : commande ou réglage inconnu (nc-reglages aide, nc-reglages liste)",
                   "nc-settings: unknown command or setting (nc-settings help, nc-settings list)"))


if __name__ == "__main__":
    locale.setlocale(locale.LC_ALL, "")
    args = sys.argv[1:]
    if not args or args[0] in ("raccourcis", "shortcuts"):
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            cli(["liste"])
        else:
            tui(SECTIONS.index("Raccourcis") if args else 0)
    else:
        cli(args)
