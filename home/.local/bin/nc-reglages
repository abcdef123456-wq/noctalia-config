_CHOIX_IA = []


def choix_ia():
    """Les IA de nc-ia, marquées si elles ne sont pas disponibles : pour IA_CHOIX et SPOTLIGHT_IA (lues une fois)."""
    if not _CHOIX_IA:
        try:
            ia = charger("ncia", "nc-ia")
            _CHOIX_IA.extend((i, ia.nom(i) + ("" if ia.disponible(i) else T(" (non disponible)", " (not available)")))
                             for i in ia.FOURNISSEURS)
        except Exception:
            return [("claude", "Claude Code"), ("jarvis", "JARVIS")]
    return list(_CHOIX_IA)


def nom_section(s):
    return T(s, SECTIONS_EN.get(s, s))


