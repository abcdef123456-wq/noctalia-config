# Réglages qui n'ont de sens qu'avec un certain matériel : cachés sur un PC qui ne l'a pas (PC de bureau : ni batterie,
# ni couvercle, ni pavé tactile, ni écran intégré). Ils restent utilisables en ligne de commande.
MATERIEL = {
    "BATTERIE_ALERTE": "batterie", "HZ_BALANCED_BAT": "batterie", "HALO_BATTERIE": "batterie", "VEILLE_SUSPENSION": "batterie",
    "COUVERCLE": "couvercle", "COUVERCLE_VERROU": "couvercle",
    "DEFILEMENT_NATUREL": "pave", "TAPOTER_CLIC": "pave", "GESTES": "pave",
    "LUMINOSITE_PAS": "ecran",
    **{f"{x.upper()}_ILE": "ia:" + x for x in ("antigravity", "opencode", "codex", "gemini", "cursor", "copilot", "qwen", "kiro", "amp")}, "ECO_BRIGHTNESS_MAX": "ecran",
    "HZ_PERFORMANCE": "ecran", "HZ_BALANCED_AC": "ecran", "HZ_ECO": "ecran",
    "PROFIL_SECTEUR": "batterie", "PROFIL_BATTERIE": "batterie", "ECO_AUTO": "batterie",
    "ECO_CLAVIER": "clavier", "ECO_BLUETOOTH": "bluetooth", "GPU_PERFORMANCE": "hybride",
}


def materiel():
    import glob

    def existe(motif):
        return bool(glob.glob(motif))
    try:
        entrees = open("/proc/bus/input/devices", encoding="utf-8", errors="ignore").read().lower()
    except OSError:
        entrees = ""
    # IA installées (même détection que nc-claude) : leur réglage n'apparaît que si elles sont là
    ias = {"antigravity": (("agy", "antigravity"), ("~/.gemini/antigravity-cli", "~/.gemini/config")),
           "opencode": (("opencode",), ("~/.config/opencode",)), "codex": (("codex",), ("~/.codex",)),
           "gemini": (("gemini",), ()), "cursor": (("cursor-agent", "cursor"), ("~/.cursor",)),
           "copilot": (("copilot",), ("~/.copilot",)), "qwen": (("qwen",), ("~/.qwen",)),
           "kiro": (("kiro-cli", "kiro"), ("~/.kiro",)), "amp": (("amp",), ("~/.config/amp",))}
    dispo = {"ia:" + k: any(shutil.which(p) for p in v[0]) or any(os.path.isdir(os.path.expanduser(d)) for d in v[1])
             for k, v in ias.items()}
    # PC hybride : une carte NVIDIA et une autre (même détection que nc-profile-sync)
    cartes = set()
    for d in glob.glob("/sys/bus/pci/devices/*"):
        try:
            if open(d + "/class").read().startswith("0x03"):
                cartes.add(open(d + "/vendor").read().strip() == "0x10de")
        except OSError:
            pass
    return {**dispo, "batterie": existe("/sys/class/power_supply/BAT*"), "couvercle": existe("/proc/acpi/button/lid/*"),
            "pave": "touchpad" in entrees or "trackpad" in entrees, "ecran": existe("/sys/class/backlight/*"),
            "clavier": existe("/sys/class/leds/*kbd_backlight*"), "bluetooth": existe("/sys/class/bluetooth/*"),
            "hybride": cartes == {True, False}}


_DISPO = materiel()
VISIBLES = [r for r in REGLAGES if _DISPO.get(MATERIEL.get(r.cle, ""), True)]
SECTIONS = []
for _r in VISIBLES:
    if _r.section not in SECTIONS:
        SECTIONS.append(_r.section)
SECTIONS.append("Raccourcis")
SECTIONS.append("Nouveautés")


# ── Nouveautés : les 10 dernières mises à jour du dépôt (une mise à jour = un commit) ─────────────────────────────
def nouveautes(n=10):
    """[{date, titre, points, id}] des n dernières mises à jour, la plus récente d'abord ; points : ce qu'elle apporte."""
    try:
        depot = open(os.path.join(HOME, ".config/nc/depot"), encoding="utf-8").read().strip()
    except OSError:
        return []
    brut = sortie(["git", "-C", depot, "log", f"-{n}", "--date=format:%Y-%m-%d", "--format=%h%x1f%cd%x1f%s%x1e"])
    res = []
    for bloc in brut.split("\x1e"):
        p = bloc.strip().split("\x1f")
        if len(p) < 3:
            continue
        # « A ; B ; C » : un point par partie, la première sert de titre (un « ; » entre parenthèses ne coupe pas)
        points, prof, cur = [], 0, ""
        for i, ch in enumerate(p[2]):
            prof += (ch == "(") - (ch == ")")
            if ch == ";" and prof <= 0 and p[2][i - 1:i] == " ":
                points.append(cur.strip()); cur = ""
            else:
                cur += ch
        points = [x for x in points + [cur.strip()] if x]
        points = [x if x.startswith(("nc-", "nvidia-")) else x[0].upper() + x[1:] for x in points]
        titre = re.split(r"\s:\s|\s\(", points[0])[0] if points else p[2]
        a, m, j = (p[1].split("-") + ["", "", ""])[:3]
        mois = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
        date = (f"{mois[int(m) - 1]} {int(j)}, {a}" if EN else f"{j}/{m}/{a}") if m.isdigit() and j.isdigit() else p[1]
        res.append({"genre": "nouveaute", "id": p[0], "date": date, "titre": titre, "points": points})
    return res


def maj_disponible():
    """Une version plus récente a été annoncée (nc-maj verifier) et n'est pas encore installée."""
    try:
        annonce = open(os.path.join(HOME, ".cache/nc/maj-annoncee"), encoding="utf-8").read().strip()
        depot = open(os.path.join(HOME, ".config/nc/depot"), encoding="utf-8").read().strip()
    except OSError:
        return False
    return subprocess.run(["git", "-C", depot, "merge-base", "--is-ancestor", annonce, "HEAD"],
                          capture_output=True).returncode != 0


# ── Fichier ─────────────────────────────────────────────────────────────────────────────────────────────────────
def lire():
    vals = {}
    try:
        with open(FICHIER, encoding="utf-8") as f:
            for l in f:
                m = re.match(r"\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$", l)
                if m:
                    vals[m[1]] = re.sub(r'^"(.*)"$', r"\1", m[2])
    except FileNotFoundError:
        pass
    return vals


def ecrire(vals):
    os.makedirs(os.path.dirname(FICHIER), exist_ok=True)
    lignes = ["# Tes réglages de noctalia-config : seulement ce que tu as changé, le reste suit la config.",
              "# Gardé tel quel par les mises à jour. Le plus simple pour le changer : la commande nc-reglages."]
    sec = None
    for r in REGLAGES:
        if r.cle in vals:
            if r.section != sec:
                lignes += ["", f"# {r.section}"]
                sec = r.section
            lignes.append(f"{r.cle}={vals[r.cle]}")
    autres = [k for k in vals if k not in PAR_CLE]
    if autres:
        lignes += ["", "# Autres"] + [f"{k}={vals[k]}" for k in autres]
    tmp = FICHIER + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lignes) + "\n")
    os.replace(tmp, FICHIER)


