def charger(nom, fichier):
    chargeur = importlib.machinery.SourceFileLoader(nom, os.path.join(BIN, fichier))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(nom, chargeur))
    chargeur.exec_module(mod)
    return mod


def sortie(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ── Choix calculés sur ce PC ────────────────────────────────────────────────────────────────────────────────────
def frequences():
    """Fréquences de l'écran du portable dans sa définition native (de la plus basse à la plus haute)."""
    try:
        mons = json.loads(sortie(["hyprctl", "monitors", "all", "-j"]) or "[]")
    except ValueError:
        return []
    m = next((x for x in mons if x.get("name", "").startswith("eDP")), None)
    if not m:
        return []
    modes = []
    for s in m.get("availableModes", []):
        r = re.match(r"(\d+)x(\d+)@([\d.]+)", s)
        if r:
            modes.append((int(r[1]) * int(r[2]), round(float(r[3]))))
    if not modes:
        return []
    px = max(p for p, _ in modes)
    return sorted({hz for p, hz in modes if p == px})


def polices(motif, preferees):
    """Polices installées : d'abord celles de la liste (si présentes), puis les autres qui suivent le motif."""
    familles = set()
    for l in sortie(["fc-list", ":", "family"]).splitlines():
        for f in l.split(","):
            familles.add(f.strip())
    res = [p for p in preferees if p in familles]
    res += sorted(f for f in familles if re.search(motif, f) and f not in res)
    return res[:14]


# ── Les réglages ────────────────────────────────────────────────────────────────────────────────────────────────
class L:
    """Texte dans les deux langues : str(L(fr, en)) donne celui de la langue en cours (suit LANGUE sans relancer)."""
    __slots__ = ("fr", "en")

    def __init__(self, fr, en):
        self.fr, self.en = fr, en

    def __str__(self):
        return T(self.fr, self.en)


class R:
    """Un réglage : clé du fichier, section, nom, genre (ouinon, choix, entier, hz, texte, dossier), valeur de la config.
    Nom, aide, zero et noms des choix : texte ou L(fr, en) ; la section reste en français (clé), voir nom_section."""

    def __init__(self, cle, section, nom, genre, defaut, aide="", choix=None, mini=0, maxi=100, pas=1, unite="",
                 groupe="", zero="", essai=""):
        self.cle, self.section, self._nom, self.genre, self.defaut, self._aide = cle, section, nom, genre, defaut, aide
        self._choix, self.mini, self.maxi, self.pas, self.unite = choix, mini, maxi, pas, unite
        self.groupe, self._zero, self.essai = groupe, zero, essai

    nom = property(lambda self: str(self._nom))
    aide = property(lambda self: str(self._aide))
    zero = property(lambda self: str(self._zero))

    def choix(self):
        """[(valeur, nom affiché)] pour ouinon, choix et hz."""
        if self.genre == "ouinon":
            return [("oui", T("Oui", "Yes")), ("non", T("Non", "No"))]
        if self.genre == "hz":
            l = frequences()
            res = [("max", f"{T('La plus haute', 'Highest')}{f' ({l[-1]} Hz)' if l else ''}"),
                   ("low", T("60 Hz, sinon la plus basse", "60 Hz, or the lowest"))]
            return res + [(str(h), f"{h} Hz") for h in l]
        c = self._choix() if callable(self._choix) else (self._choix or [])
        return [(x, x) if isinstance(x, str) else (x[0], str(x[1])) for x in c]

    def montrer(self, v):
        if self.genre in ("ouinon", "choix", "hz"):
            for val, nom in self.choix():
                if val == v:
                    return nom
            return f"{v} Hz" if self.genre == "hz" and v.isdigit() else v
        if self.genre == "entier":
            if v == "0" and self.zero:
                return self.zero
            sep = "" if EN and self.unite in ("%", "/s") else " "
            return f"{v}{sep + self.unite if self.unite else ''}"
        if self.genre == "dossier" and v == "auto":
            return T("automatique", "automatic")
        if self.genre == "texte" and v == "systeme":
            return T("celle du système", "system default")
        if self.genre == "texte" and v == "auto":
            return T("automatique", "automatic")
        if self.genre == "texte" and v == "aucun":
            return T("aucun", "none")
        return v

    def valider(self, v):
        """Valeur normalisée, ou ValueError avec un message."""
        v = v.strip()
        if self.genre == "ouinon":
            l = v.lower()
            if l in ("oui", "o", "yes", "y", "true", "1"):
                return "oui"
            if l in ("non", "n", "no", "false", "0"):
                return "non"
            raise ValueError(T("oui ou non", "yes or no"))
        if self.genre == "choix":
            vals = [c for c, _ in self.choix()]
            if v in vals:
                return v
            raise ValueError(T("valeurs possibles : ", "possible values: ") + ", ".join(vals))
        if self.genre == "entier":
            if not re.fullmatch(r"-?\d{1,5}", v) or not self.mini <= int(v) <= self.maxi:
                raise ValueError(T(f"un nombre de {self.mini} à {self.maxi}", f"a number from {self.mini} to {self.maxi}"))
            return str(int(v))
        if self.genre == "hz":
            if v in ("max", "low") or (v.isdigit() and 20 <= int(v) <= 500):
                return v
            raise ValueError(T("max, low ou une fréquence en Hz (ex. 60)", "max, low or a refresh rate in Hz (e.g. 60)"))
        if self.genre == "dossier":
            if v == "auto":
                return v
            v = os.path.expanduser(v)
            if not v.startswith("/"):
                raise ValueError(T("un chemin complet (ex. ~/Images/Captures), ou auto",
                                   "a full path (e.g. ~/Pictures/Screenshots), or auto"))
            return v.replace(HOME, "~", 1)
        if self.genre == "texte":
            # Mots anglais acceptés pour les valeurs gardées en français
            if self.cle == "CLAVIER_DISPOSITION" and v.lower() == "system":
                v = "systeme"
            if self.cle == "VERROU_MESSAGE" and v.lower() == "none":
                v = "aucun"
            if self.cle == "CLAVIER_DISPOSITION" and v != "systeme":
                if not re.fullmatch(r"[a-z]{2,3}(,[a-z]{2,3})*", v) or \
                        any(not os.path.exists(f"/usr/share/X11/xkb/symbols/{x}") for x in v.split(",")):
                    raise ValueError(T("codes de disposition séparés par des virgules (ex. us, fr, us,fr), ou systeme",
                                       "comma-separated layout codes (e.g. us, fr, us,fr), or system"))
            if not v:
                raise ValueError(T("une valeur", "a value"))
            return v
        return v


def animations_bouton():
    """Ce que peut faire le bouton d'arrêt : actions, animations de nc-anim (dont les tiennes)."""
    res = [("doigts", T("Des doigts partout", "Fingers everywhere"))]
    for l in sortie([os.path.join(HOME, ".local/bin/nc-anim"), "liste", "--brut"]).splitlines():
        n, _, d = l.partition("\t")
        if n and n != "doigts":
            res.append((n, d))
    return res + [("aleatoire", T("Une animation au hasard", "A random animation")),
                  ("menu", T("Menu Éteindre / Redémarrer / Veille", "Shut Down / Restart / Sleep menu")),
                  ("verrouiller", T("Verrouiller l'écran", "Lock the screen")), ("veille", T("Mettre en veille", "Sleep")),
                  ("eteindre", T("Éteindre (comme d'habitude)", "Shut down (as usual)")), ("rien", T("Rien", "Nothing"))]


