PAR_CLE = {r.cle: r for r in REGLAGES}

# Réglages qui n'ont de sens qu'avec un certain matériel : cachés sur un PC qui ne l'a pas (PC de bureau : ni batterie,
# ni couvercle, ni pavé tactile, ni écran intégré). Ils restent utilisables en ligne de commande.
MATERIEL = {
    "BATTERIE_ALERTE": "batterie", "HZ_BALANCED_BAT": "batterie", "HALO_BATTERIE": "batterie", "VEILLE_SUSPENSION": "batterie",
    "VEILLE_BAISSE_BATTERIE": "batterie", "VEILLE_ECRAN_BATTERIE": "batterie",
    "COUVERCLE": "couvercle", "COUVERCLE_VERROU": "couvercle",
    "DEFILEMENT_NATUREL": "pave", "TAPOTER_CLIC": "pave", "GESTES": "pave",
    "LUMINOSITE_PAS": "ecran",
    **{f"{x.upper()}_ILE": "ia:" + x for x in ("antigravity", "opencode", "codex", "gemini", "cursor", "copilot", "qwen", "kiro", "amp")}, "ECO_BRIGHTNESS_MAX": "ecran",
    "HZ_PERFORMANCE": "ecran", "HZ_BALANCED_AC": "ecran", "HZ_ECO": "ecran",
    "PROFIL_SECTEUR": "batterie", "PROFIL_BATTERIE": "batterie", "ECO_AUTO": "batterie",
    "ECO_CLAVIER": "clavier", "ECO_BLUETOOTH": "bluetooth", "GPU_REGLE": "hybride", "GPU_JAMAIS_RTX": "hybride",
    "GPU_MUX_PROPOSER": "mux", "GPU_MUX_AVERTIR": "mux",
    "BAT_RELEVES": "batterie", "BAT_CLAVIER": "clavier-batterie",
    "PAVE_PENDANT_FRAPPE": "pave", "PAVE_CLIC_MILIEU": "pave", "SPOTLIGHT_AUR": "aur", "SPOTLIGHT_FLATPAK": "flatpak", "MAJ_AUR": "aur", "MAJ_INSTANTANE": "btrfs",
}


def materiel():
    import glob

    def existe(motif):
        return bool(glob.glob(motif))
    try:
        entrees = open("/proc/bus/input/devices", encoding="utf-8", errors="ignore").read().lower()
    except OSError:
        entrees = ""
    # IA installées (même détection que nc-claude) : leur réglage n'apparaît que si elles sont là
    ias = {"antigravity": (("agy", "antigravity"), ("~/.gemini/antigravity-cli", "~/.gemini/config")),
           "opencode": (("opencode",), ("~/.config/opencode",)), "codex": (("codex",), ("~/.codex",)),
           "gemini": (("gemini",), ()), "cursor": (("cursor-agent", "cursor"), ("~/.cursor",)),
           "copilot": (("copilot",), ("~/.copilot",)), "qwen": (("qwen",), ("~/.qwen",)),
           "kiro": (("kiro-cli", "kiro"), ("~/.kiro",)), "amp": (("amp",), ("~/.config/amp",))}
    dispo = {"ia:" + k: any(shutil.which(p) for p in v[0]) or any(os.path.isdir(os.path.expanduser(d)) for d in v[1])
             for k, v in ias.items()}
    # PC hybride : une carte NVIDIA et une autre (même détection que nc-profile-sync)
    cartes = set()
    for d in glob.glob("/sys/bus/pci/devices/*"):
        try:
            if open(d + "/class").read().startswith("0x03"):
                cartes.add(open(d + "/vendor").read().strip() == "0x10de")
        except OSError:
            pass
    return {**dispo, "batterie": existe("/sys/class/power_supply/BAT*"), "couvercle": existe("/proc/acpi/button/lid/*"),
            "pave": "touchpad" in entrees or "trackpad" in entrees, "ecran": existe("/sys/class/backlight/*"),
            "clavier": existe("/sys/class/leds/*kbd_backlight*"), "bluetooth": existe("/sys/class/bluetooth/*"),
            "clavier-batterie": existe("/sys/class/leds/*kbd_backlight*") and existe("/sys/class/power_supply/BAT*"),
            "hybride": cartes == {True, False},
            # Un mode graphique à choisir (nc-gpu-mode : une NVIDIA et un écran interne ; en mode Dédiée, le BIOS peut
            # cacher la carte intégrée), sans lancer nc-gpu-mode
            "mux": True in cartes and existe("/sys/class/drm/card*-eDP-*"),
            "aur": bool(shutil.which("pacman") and (shutil.which("paru") or shutil.which("yay"))), "flatpak": bool(shutil.which("flatpak")),
            "btrfs": sortie(["findmnt", "-no", "FSTYPE", "/"]).strip() == "btrfs"}


_DISPO = materiel()


# ── Mode graphique (portable à MUX : Hybride ou Dédiée, nc-gpu-mode) ─────────────────────────────────────────────
# Pas un réglage du fichier : une information (le mode actuel) et une action (en changer, ce qui redémarre le PC).
# Cachées comme un réglage sans le matériel voulu, quand nc-gpu-mode répond « sans-objet » (une seule carte
# graphique, ou pas d'écran interne). Lu seulement pour la section Énergie et le catalogue, pas à chaque commande.
def etat_gpu():
    """{mode, methode, bios_direct, carte_ecran} de « nc-gpu-mode json », ou {} s'il n'y a pas de mode à choisir."""
    try:
        d = json.loads(sortie_memo([os.path.join(BIN, "nc-gpu-mode"), "json"]) or "{}")
    except ValueError:
        return {}
    return d if isinstance(d, dict) and d.get("mode") in ("hybride", "dediee") else {}


def nom_mode_gpu(m):
    return {"dediee": T("Dédiée", "Discrete"), "hybride": T("Hybride", "Hybrid")}.get(m, m)


def lignes_gpu():
    """Section Énergie : [information, action] du mode graphique, ou [] (sans objet)."""
    g = etat_gpu()
    if not g:
        return []
    m = g.get("methode", "")
    autre = "dediee" if g["mode"] == "hybride" else "hybride"
    maniere = T("se change dans le BIOS", "changed in the BIOS") if m in ("bios", "") else T(f"se change par {m}", f"changed with {m}")
    info = {"genre": "info", "cle": "info:mode-graphique", "nom": T("Mode graphique", "Graphics mode"),
            "valeur": f"{nom_mode_gpu(g['mode'])} · {maniere}",
            "aide": T("Hybride : l'écran passe par la carte intégrée, la carte NVIDIA dort tant qu'aucune appli ne la demande "
                      "(autonomie). Dédiée : l'écran est branché sur la carte NVIDIA, pour un bureau plus fluide (G-Sync), "
                      "environ 10 à 20 W de plus. Conseil : Hybride sur batterie, Dédiée sur secteur.",
                      "Hybrid: the screen goes through the integrated graphics, the NVIDIA card sleeps until an app asks for "
                      "it (battery life). Discrete: the screen is wired to the NVIDIA card, for a smoother desktop (G-Sync), "
                      "about 10 to 20 W more. Tip: Hybrid on battery, Discrete when plugged in.")}
    action = {"genre": "assistant", "action": "mode-graphique", "cle": "action:mode-graphique",
              "nom": T("Changer de mode graphique…", "Change graphics mode…"),
              "affiche": T(f"Passer en {nom_mode_gpu(autre)}…", f"Switch to {nom_mode_gpu(autre)}…"),
              "aide": T(f"Passer en {nom_mode_gpu(autre)} : une confirmation s'ouvre dans l'île (sinon ici), puis le PC "
                        f"redémarre{' dans son BIOS' if m in ('bios', '') else ''}.",
                        f"Switch to {nom_mode_gpu(autre)}: a confirmation opens in the island (otherwise here), then the PC "
                        f"restarts{' into its BIOS' if m in ('bios', '') else ''}.")}
    return [info, action]


def question_gpu(g):
    """(cible, titre, texte, bouton) de la confirmation, comme la carte de l'île (ModeGraphique.qml) ; bouton vide :
    rien à confirmer (BIOS sans démarrage direct : seulement la touche à presser)."""
    cible = "dediee" if g.get("mode") == "hybride" else "hybride"
    n = nom_mode_gpu(cible)
    titre = T(f"Passer en mode {n} ?", f"Switch to {n} mode?")
    if g.get("methode", "") in ("bios", ""):
        if not g.get("bios_direct"):
            return (cible, titre,
                    T(f"Ton PC change de mode dans son BIOS : redémarre, appuie sur F2 dès l'allumage, choisis GPU Working "
                      f"Mode → {n}, puis F10.",
                      f"Your PC switches mode in its BIOS: restart, press F2 right at power-on, choose GPU Working Mode → "
                      f"{n}, then F10."), "")
        return (cible, titre,
                T(f"Ton PC redémarre dans son BIOS : choisis GPU Working Mode → {n}, puis F10. Les applis ouvertes seront fermées.",
                  f"Your PC restarts into its BIOS: choose GPU Working Mode → {n}, then F10. Open apps will be closed."),
                T("Redémarrer dans le BIOS", "Restart into BIOS"))
    return (cible, titre,
            T(f"Ton PC passe en mode {n}, puis redémarre. Les applis ouvertes seront fermées.",
              f"Your PC switches to {n} mode, then restarts. Open apps will be closed."),
            T("Redémarrer", "Restart"))


# ── Sessions enregistrées (nc-session) : une ligne par session, et sa suppression ───────────────────────────────────
# Pas des réglages : la liste de ~/.config/nc/sessions, lue par « nc-session liste --json » à l'affichage de la section
# Fenêtres (terminal) ou du catalogue (fenêtre graphique), jamais en boucle. Supprimer demande toujours confirmation.
def sessions():
    """[{nom, fenetres, applis}] des sessions enregistrées ; [] sans nc-session ou s'il ne répond pas."""
    try:
        d = json.loads(sortie([os.path.join(BIN, "nc-session"), "liste", "--json"]) or "[]")
    except ValueError:
        return []
    return [s for s in d if isinstance(s, dict) and isinstance(s.get("nom"), str) and s["nom"]] if isinstance(d, list) else []


def lignes_sessions():
    """Section Fenêtres : une ligne par session (bouton « Supprimer… », confirmation d'abord), ou « Aucune session
    enregistrée »."""
    res = []
    for s in sessions():
        nom, n = s["nom"], int(s.get("fenetres") or 0)
        applis = ", ".join(str(a) for a in (s.get("applis") or []) if a)
        compte = T(f"{n} fenêtre{'s' if n > 1 else ''}", f"{n} window{'s' if n != 1 else ''}")
        res.append({"genre": "assistant", "action": "session-supprimer", "session": nom, "cle": "session:" + nom,
                    "nom": T(f"Session « {nom} »", f"Session “{nom}”"),
                    "affiche": T("Supprimer…", "Delete…"),
                    "aide": compte + (T(" : ", ": ") + applis if applis else ""),
                    "confirmer": T(f"Supprimer la session « {nom} » ? Ses fenêtres restent ouvertes : seule la disposition "
                                   "enregistrée est effacée.",
                                   f"Delete the session “{nom}”? Its windows stay open: only the saved layout is erased.")})
    if not res:
        res.append({"genre": "info", "cle": "info:sessions", "nom": T("Aucune session enregistrée", "No saved session"),
                    "valeur": "",
                    "aide": T("Super + Maj + W (ou nc-session enregistrer NOM) enregistre la disposition actuelle des fenêtres.",
                              "Super + Shift + W (or nc-session save NAME) saves the current window layout.")})
    return res


# ── Applis épinglées au dock (nc-dock, issue #16) : une ligne par appli et son retrait, puis l'ajout ────────────────
# Pas des réglages non plus : la liste du dock de Noctalia, lue par « nc-dock liste --json » à l'affichage de la section
# Barre et dock (terminal) ou du catalogue (fenêtre graphique). Dans le terminal, Entrée sur une appli : monter,
# descendre ou retirer ; dans la fenêtre graphique : « Retirer » (sans confirmation : ça se remet d'un geste, clic droit
# dans le Spotlight ou dans le dock, ou « Ajouter une appli… » ici).
def dock_epinglees():
    """[{id, nom}] des applis épinglées au dock ; [] sans nc-dock ou s'il ne répond pas."""
    try:
        d = json.loads(sortie([os.path.join(BIN, "nc-dock"), "liste", "--json"]) or "[]")
    except ValueError:
        return []
    return [x for x in d if isinstance(x, dict) and isinstance(x.get("id"), str) and x["id"]] if isinstance(d, list) else []


def lignes_dock():
    res = []
    epinglees = dock_epinglees()
    for k, x in enumerate(epinglees):
        res.append({"genre": "assistant", "action": "dock-appli", "app": x["id"], "cle": "dock:" + x["id"],
                    "nom": x.get("nom") or x["id"], "affiche": T("Monter, descendre, retirer…", "Move up, down, remove…"),
                    "place": k, "nombre": len(epinglees),
                    "aide": T(f"Épinglée au dock, {k + 1}ᵉ place ({x['id']}).", f"Pinned to the dock, place {k + 1} ({x['id']}).")
                    + ("" if x.get("nom") else T(" Elle n'est plus installée.", " It is no longer installed."))})
    if not res:
        res.append({"genre": "info", "cle": "info:dock-vide", "nom": T("Aucune appli épinglée", "No pinned app"),
                    "valeur": "", "aide": T("Le dock ne montre que les applis ouvertes.", "The dock only shows open apps.")})
    res.append({"genre": "assistant", "action": "dock-ajouter", "cle": "dock:ajouter",
                "nom": T("Ajouter une appli…", "Add an app…"), "affiche": T("Choisir…", "Choose…"),
                "aide": T("Tape une partie de son nom. Aussi dans le Spotlight (Super + R) : clic droit sur l'appli, ou Alt + P.",
                          "Type part of its name. Also in Spotlight (Super + R): right-click the app, or Alt + P.")})
    return res


def applis_a_epingler(applis, texte, deja):
    """Les applis installées (nc-apps list) dont le nom ou l'identifiant contient texte (sans accent ni majuscule), pas
    déjà épinglées : celles dont le nom commence par texte d'abord, puis par ordre alphabétique."""
    def simple(t):
        return "".join(c for c in unicodedata.normalize("NFD", str(t).strip().lower()) if not unicodedata.combining(c))
    t = simple(texte)
    if not t:
        return []
    res = [a for a in applis if a.get("id") and a["id"] not in deja
           and (t in simple(a.get("name", "")) or t in simple(a["id"]))]
    return sorted(res, key=lambda a: (not simple(a.get("name", "")).startswith(t), simple(a.get("name", ""))))


VISIBLES =[r for r in REGLAGES if _DISPO.get(MATERIEL.get(r.cle, ""), True)]
SECTIONS = []
for _r in VISIBLES:
    if _r.section not in SECTIONS:
        SECTIONS.append(_r.section)
SECTIONS.append("Raccourcis")
SECTIONS.append("Nouveautés")


# ── Nouveautés : les 10 dernières mises à jour du dépôt (une mise à jour = un commit) ─────────────────────────────
def nouveautes(n=10):
    """[{date, titre, points, id}] des n dernières mises à jour, la plus récente d'abord ; points : ce qu'elle apporte."""
    try:
        depot = open(os.path.join(HOME, ".config/nc/depot"), encoding="utf-8").read().strip()
    except OSError:
        return []
    brut = sortie(["git", "-C", depot, "log", f"-{n}", "--date=format:%Y-%m-%d", "--format=%h%x1f%cd%x1f%s%x1e"])
    res = []
    for bloc in brut.split("\x1e"):
        p = bloc.strip().split("\x1f")
        if len(p) < 3:
            continue
        # « A ; B ; C » : un point par partie, la première sert de titre (un « ; » entre parenthèses ne coupe pas)
        points, prof, cur = [], 0, ""
        for i, ch in enumerate(p[2]):
            prof += (ch == "(") - (ch == ")")
            if ch == ";" and prof <= 0 and p[2][i - 1:i] == " ":
                points.append(cur.strip()); cur = ""
            else:
                cur += ch
        points = [x for x in points + [cur.strip()] if x]
        points = [x if x.startswith(("nc-", "nvidia-")) else x[0].upper() + x[1:] for x in points]
        titre = re.split(r"\s:\s|\s\(", points[0])[0] if points else p[2]
        a, m, j = (p[1].split("-") + ["", "", ""])[:3]
        mois = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
        date = (f"{mois[int(m) - 1]} {int(j)}, {a}" if EN else f"{j}/{m}/{a}") if m.isdigit() and j.isdigit() else p[1]
        res.append({"genre": "nouveaute", "id": p[0], "date": date, "titre": titre, "points": points})
    return res


def maj_disponible():
    """Une version plus récente a été annoncée (nc-maj verifier) et n'est pas encore installée."""
    try:
        annonce = open(os.path.join(HOME, ".cache/nc/maj-annoncee"), encoding="utf-8").read().strip()
        depot = open(os.path.join(HOME, ".config/nc/depot"), encoding="utf-8").read().strip()
    except OSError:
        return False
    # Même base que nc-maj verifier : la version installée si une installation lancée par nc-maj n'est pas allée au
    # bout (marqueur installation-en-cours, effacé par install.sh à son « Terminé »), sinon HEAD
    base = "HEAD"
    if os.path.exists(os.path.join(HOME, ".config/nc/installation-en-cours")):
        try:
            v = open(os.path.join(HOME, ".config/nc/version-installee"), encoding="utf-8").read().strip()
        except OSError:
            v = ""
        if v and subprocess.run(["git", "-C", depot, "rev-parse", "-q", "--verify", v + "^{commit}"],
                                capture_output=True).returncode == 0:
            base = v
    return subprocess.run(["git", "-C", depot, "merge-base", "--is-ancestor", annonce, base],
                          capture_output=True).returncode != 0


# ── Fichier ─────────────────────────────────────────────────────────────────────────────────────────────────────
def lire():
    vals = {}
    try:
        with open(FICHIER, encoding="utf-8") as f:
            for l in f:
                m = re.match(r"\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$", l)
                if m:
                    vals[m[1]] = re.sub(r'^"(.*)"$', r"\1", m[2])
    except FileNotFoundError:
        pass
    # Ancien réglage GPU_PERFORMANCE (nvidia | integree) : remplacé par GPU_REGLE, « integree » devient « jamais »
    # (même reprise que nc-gpu-regle) ; disparaît du fichier à la prochaine écriture
    ancien = vals.pop("GPU_PERFORMANCE", None)
    if ancien == "integree" and "GPU_REGLE" not in vals:
        vals["GPU_REGLE"] = "jamais"
    return vals


# Rappels qui se taisent après trois « Non » de suite (nc-profile-sync, fichier d'état gpu-mux) : le réglage qui les
# coupe, et ses lignes dans le fichier d'état. Le réglage repasse de « non » à « oui » : ses lignes sont effacées, le
# rappel revient (une fois par jour au plus pour la proposition au branchement, comme avant).
RAPPELS = {"GPU_MUX_PROPOSER": ("jour", "non"), "GPU_MUX_AVERTIR": ("avertir_non",)}


def relancer_rappels(avant, apres):
    effacer = [l for cle, lignes in RAPPELS.items()
               if valeur(avant, cle) == "non" and valeur(apres, cle) == "oui" for l in lignes]
    if not effacer:
        return
    etat = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"),
                        "noctalia-config/gpu-mux")
    try:
        with open(etat, encoding="utf-8") as f:
            garder = [l for l in f if l.split("=", 1)[0] not in effacer]
        with open(etat + ".tmp", "w", encoding="utf-8") as f:
            f.writelines(garder)
        os.replace(etat + ".tmp", etat)
    except OSError:
        pass                                     # pas de fichier d'état : rien à effacer


def ecrire(vals):
    # Seul chemin d'écriture (regler : écran, fenêtre graphique, set ; reset) : l'ancien fichier sert à voir quels
    # rappels repassent à « oui »
    avant = lire()
    os.makedirs(os.path.dirname(FICHIER), exist_ok=True)
    lignes = ["# Tes réglages de noctalia-config : seulement ce que tu as changé, le reste suit la config.",
              "# Gardé tel quel par les mises à jour. Le plus simple pour le changer : la commande nc-reglages."]
    sec = None
    for r in REGLAGES:
        if r.cle in vals:
            if r.section != sec:
                lignes += ["", f"# {r.section}"]
                sec = r.section
            lignes.append(f"{r.cle}={vals[r.cle]}")
    autres = [k for k in vals if k not in PAR_CLE]
    if autres:
        lignes += ["", "# Autres"] + [f"{k}={vals[k]}" for k in autres]
    tmp = FICHIER + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lignes) + "\n")
    os.replace(tmp, FICHIER)
    relancer_rappels(avant, vals)


# Ce que change chaque style (en plus de sa palette, de la barre et du dock, voir appliquer_style et
