#!/usr/bin/env bash
# legion-finger : le bouton d'arrêt fait apparaître des doigts partout sur le fond flouté, sans éteindre. Une touche quitte.
hyprctl clients -j | grep -q '"class": "fingerpop"' && exit 0
exec kitty --class fingerpop -o background_opacity=0.35 -o font_size=60 -o confirm_os_window_close=0 -o hide_window_decorations=yes \
  -o window_padding_width=0 python3 -c '
import os,random,select,sys,time
r,c=os.get_terminal_size()[1],os.get_terminal_size()[0]
w=sys.stdout.write
w("\033[?25l\033[2J")
import termios,tty
fd=sys.stdin.fileno(); old=termios.tcgetattr(fd); tty.setcbreak(fd)
while not select.select([sys.stdin],[],[],0.12)[0]:
    w("\033[%d;%dH\U0001F595"%(random.randint(1,r),random.randint(1,max(1,c-1)))); sys.stdout.flush()
'
