#!/usr/bin/env bash
# nc-term-logo : logo du terminal (accueil fastfetch) aux couleurs du thème.
#   nc-term-logo              logo de la distribution (SVG officiel) rempli d'un dégradé couleur principale -> secondaire,
#                             avec un léger halo : ~/.cache/nc/term-logo.png ; puis le dessin ci-dessous s'il est choisi
#   nc-term-logo dessin [NOM] logo dessiné : silhouette en dégradé de haut en bas (couleurs du fond d'écran), fond transparent
#                             (NOM : distribution, arch, fedora, macOS, Windows… comme TERMINAL_LOGO) :
#                             ~/.cache/nc/term-dessin.png ; logos dans ~/.local/share/nc/logos (Simple Icons, CC0)
# Ne refait rien si les couleurs et le logo n'ont pas changé. Appelé par nc-theme-sync à chaque changement de couleurs
# et par nc-greeting (Terminal → Style du logo : dessin).
set -uo pipefail

COLORS="$HOME/.config/noctalia/colors.json"
OUT="$HOME/.cache/nc/term-logo.png"
DESSIN="${NC_DESSIN:-$HOME/.cache/nc/term-dessin.png}"   # NC_DESSIN : ailleurs (logo de la fenêtre de projection)
LOGOS="$HOME/.local/share/nc/logos"
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/style.conf" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }

. /etc/os-release 2>/dev/null
# Logo vectoriel installé par la distribution
svg_systeme() {
  local n f
  for n in ${LOGO:+"$LOGO"} "${ID:-linux}-logo" "${ID:-linux}linux-logo" "${ID:-linux}-logo-icon" "distributor-logo-${ID:-linux}"; do
    for f in "/usr/share/pixmaps/$n.svg" "/usr/share/icons/hicolor/scalable/apps/$n.svg"; do
      [ -r "$f" ] && { echo "$f"; return 0; }
    done
  done
  return 1
}
# Logo du dépôt pour un nom de TERMINAL_LOGO ou un ID de distribution (os-release)
svg_depot() {
  local n
  n="$(echo "$1" | tr '[:upper:]' '[:lower:]')"
  case "$n" in
    macos) n=apple ;; archlinux) n=arch ;; opensuse*) n=opensuse ;; popos|pop_os) n=pop ;; redhat) n=rhel ;;
    mint) n=linuxmint ;; alma) n=almalinux ;;
  esac
  [ -r "$LOGOS/$n.svg" ] && echo "$LOGOS/$n.svg"
}

# ImageMagick 7 (magick) ou 6 (convert, Debian et Ubuntu) : même syntaxe ici ; ni l'un ni l'autre : pas de logo
IM=$(command -v magick >/dev/null && echo magick || { command -v convert >/dev/null && echo convert; }) || true
[ -n "$IM" ] || exit 0
p=$(jq -r '.mPrimary // "#8aadf4"' "$COLORS" 2>/dev/null); [ -n "$p" ] || p="#8aadf4"
s=$(jq -r '.mSecondary // .mTertiary // "#c6a0f6"' "$COLORS" 2>/dev/null); [ -n "$s" ] || s="#c6a0f6"

# Mélange de deux couleurs #rrggbb : mix A B POURCENTAGE_DE_A
mix() {
  local a=${1#\#} b=${2#\#} k=$3 i r=""
  for i in 0 2 4; do
    r+=$(printf '%02x' $(( (16#${a:$i:2} * k + 16#${b:$i:2} * (100 - k)) / 100 )))
  done
  echo "#$r"
}

dessin() {
  local nom=${1:-$(reglage TERMINAL_LOGO)} svg key tmp haut bas
  nom=${nom:-distribution}
  if [ "$nom" = distribution ]; then
    svg="$(svg_depot "${ID:-linux}" || svg_systeme || svg_depot linux)"
  else
    svg="$(svg_depot "$nom" || { [ "$(echo "$nom" | tr '[:upper:]' '[:lower:]')" = "${ID:-}" ] && svg_systeme; })"
  fi
  [ -n "$svg" ] || return 1          # pas de dessin pour ce logo : l'accueil garde le logo de fastfetch
  key="$p $s $nom $svg d6"
  [ -r "$DESSIN" ] && [ "$(cat "$DESSIN.key" 2>/dev/null)" = "$key" ] && return 0
  mkdir -p "$(dirname "$DESSIN")"
  tmp=$(mktemp -d) || return 1
  # Le dossier temporaire s'en va même si le script est interrompu (arrêt, fermeture de session) en plein calcul
  TMP_DESSIN="$tmp"; trap 'rm -rf "$TMP_DESSIN"' EXIT; trap 'exit 143' INT TERM HUP
  haut=$(mix "#ffffff" "$p" 30)      # couleur principale éclaircie en haut, secondaire en bas
  bas=$(mix "#ffffff" "$s" 8)
  if [ "${ID:-}" = arch ] && [ "$svg" != "${svg#/usr/}" ]; then sed -E '/<path d="m23[59]\./d' "$svg" > "$tmp/logo.svg"; else cp "$svg" "$tmp/logo.svg"; fi
  # Juste le logo, sur fond transparent (pas de carré autour) : silhouette remplie du dégradé, centrée dans une image
  # un peu plus haute que large (20 colonnes x 12 lignes du terminal, la hauteur des infos de fastfetch)
  "$IM" -background none -density 600 "$tmp/logo.svg" -trim +repage -resize 440x440 \
    -gravity center -extent 520x624 -alpha extract "$tmp/mask.png" &&
  "$IM" -size 520x624 "gradient:$haut-$bas" "$tmp/mask.png" -alpha off -compose CopyOpacity -composite \
    -strip "PNG32:$tmp/out.png" &&
    mv "$tmp/out.png" "$DESSIN" && echo "$key" > "$DESSIN.key"
  local r=$?
  rm -rf "$tmp"
  trap - EXIT INT TERM HUP
  return $r
}

if [ "${1:-}" = dessin ] || [ "${1:-}" = drawn ]; then
  dessin "${2:-}"
  exit $?
fi

# Dessin choisi : refait aux nouvelles couleurs en même temps que le logo
[ "$(reglage TERMINAL_LOGO_STYLE)" != simple ] && dessin >/dev/null 2>&1

svg="$(svg_systeme)" || exit 0   # pas de logo vectoriel : l'accueil utilisera le logo texte de fastfetch
key="$p $s $svg v2"
[ -r "$OUT" ] && [ "$(cat "$OUT.key" 2>/dev/null)" = "$key" ] && exit 0

mkdir -p "$(dirname "$OUT")"
tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
trap 'exit 143' INT TERM HUP
# Logo Arch : on retire le petit « ™ » (les deux tracés en bas à droite du SVG officiel) ; autres logos tels quels
if [ "${ID:-}" = arch ]; then sed -E '/<path d="m23[59]\./d' "$svg" > "$tmp/logo.svg"; else cp "$svg" "$tmp/logo.svg"; fi
# Silhouette (canal alpha) du logo, 440 px de haut, centrée dans un carré de 560 px (marge pour le halo)
"$IM" -background none -density 400 "$tmp/logo.svg" -trim +repage -resize x440 \
  -gravity center -extent 560x560 -alpha extract "$tmp/mask.png" || exit 0
# Dégradé diagonal principal -> secondaire, découpé par la silhouette
"$IM" -size 560x560 -define gradient:angle=135 "gradient:$p-$s" "$tmp/mask.png" \
  -alpha off -compose CopyOpacity -composite "$tmp/logo.png"
# Halo : silhouette floutée, couleur principale, 45 % d'opacité
"$IM" -size 560x560 "xc:$p" \( "$tmp/mask.png" -blur 0x18 -evaluate multiply 0.45 \) \
  -alpha off -compose CopyOpacity -composite "$tmp/glow.png"
"$IM" "$tmp/glow.png" "$tmp/logo.png" -background none -compose Over -composite -strip "PNG32:$tmp/out.png" &&
  mv "$tmp/out.png" "$OUT" && echo "$key" > "$OUT.key"
