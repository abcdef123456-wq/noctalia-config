#!/usr/bin/env python3
"""nc-pouls : le halo de la fenêtre active pulse sur les basses de la musique.

Tourne en service (nc-pouls.service) : dès qu'un lecteur joue (Spotify, navigateur, mpv… vus par playerctl), il
écoute la sortie son avec cava et transmet le niveau des basses à Hyprland (nc.halo, dans nc/automatismes.lua).
Rien ne se passe en profil Économie ni en mode jeu, ni sur batterie hors profil Performance (sauf avec le réglage
HALO_BATTERIE=oui de nc-reglages) ; sans musique, cava est arrêté (aucun coût).

  nc-pouls          service (lancé par systemd)
  nc-pouls demo     8 secondes de pulsation de démonstration, sans musique
  nc-pouls diag     vérifie chaque condition et dit pourquoi le halo ne pulse pas
Couper / remettre : Super + Alt + M, ou systemctl --user disable --now nc-pouls
"""
import glob
import math
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import time

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-pouls: the glow of the active window pulses to the bass of the music.

Runs as a service (nc-pouls.service): as soon as a player is playing (Spotify, browser, mpv… seen by playerctl), it
listens to the sound output with cava and passes the bass level to Hyprland (nc.halo, in nc/automatismes.lua).
Nothing happens in Power Saver or game mode, nor on battery outside the Performance profile (unless the
HALO_BATTERIE=oui setting of nc-settings is on); without music, cava is stopped (no cost).

  nc-pouls          service (started by systemd)
  nc-pouls demo     8 seconds of demo pulsing, without music
  nc-pouls diag     checks each condition and says why the glow does not pulse
Turn off / on: Super + Alt + M, or systemctl --user disable --now nc-pouls"""


RUN = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
PROFIL = os.path.expanduser("~/.config/hypr/nc/profil.lua")
REGLAGES = os.path.expanduser("~/.config/nc/reglages.conf")
CAVA_CONF = """[general]
bars = 8
framerate = 40
[input]
method = {methode}
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10
[smoothing]
noise_reduction = 55
"""


def socket_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig and os.path.exists(f"{RUN}/hypr/{sig}/.socket.sock"):
        return f"{RUN}/hypr/{sig}/.socket.sock"
    socks = sorted(glob.glob(f"{RUN}/hypr/*/.socket.sock"), key=os.path.getmtime)
    return socks[-1] if socks else None


def hypr(cmd):
    p = socket_path()
    if not p:
        return
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(0.5)
            s.connect(p)
            s.sendall(cmd.encode())
            s.recv(256)
    except OSError:
        pass


def halo(n):
    hypr(f"eval nc.halo({n:.2f})")


def halo_sur_batterie():
    """Réglage HALO_BATTERIE (nc-reglages) : halo aussi sur batterie, en Équilibré."""
    try:
        return re.search(r"^HALO_BATTERIE=\"?oui", open(REGLAGES).read(), re.M) is not None
    except OSError:
        return False


def autorise():
    """Pas en Économie, pas en mode jeu, pas sur batterie hors Performance (sauf réglage HALO_BATTERIE)."""
    if os.path.exists(f"{RUN}/nc-mode-jeu"):
        return False
    try:
        t = open(PROFIL).read()
    except OSError:
        return True
    profil = (re.search(r'profil\s*=\s*"([a-z-]+)"', t) or [None, "balanced"])[1]
    batterie = re.search(r"batterie\s*=\s*true", t) is not None
    return profil != "power-saver" and (not batterie or profil == "performance" or halo_sur_batterie())


def musique():
    try:
        out = subprocess.run(["playerctl", "-a", "status"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "Playing" in out


def demo():
    t0 = time.time()
    while time.time() - t0 < 8:
        t = time.time() - t0
        beat = (t * 2.1) % 1          # environ 126 battements par minute
        halo(max(0.0, math.exp(-beat * 6)) * (0.7 + 0.3 * math.sin(t)))
        time.sleep(1 / 40)
    halo(0)


def ecrire_conf(methode):
    conf = f"{RUN}/nc-pouls-cava.conf"
    with open(conf, "w") as f:
        f.write(CAVA_CONF.replace("{methode}", methode))
    return conf


def lancer_cava(methode):
    return subprocess.Popen(["cava", "-p", ecrire_conf(methode)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def log(msg):
    print(T(f"nc-pouls : {msg}", f"nc-pouls: {msg}"), file=sys.stderr, flush=True)


def service():
    if not shutil.which("cava"):
        log(T("cava introuvable : le halo ne peut pas écouter la musique (installe le paquet cava)",
              "cava not found: the glow cannot listen to the music (install the cava package)"))
    # Entrée son de cava : PipeWire, sinon PulseAudio (cava sans PipeWire, comme sur certaines distributions)
    methodes, m = ["pipewire", "pulse"], 0
    cava, niveau, envoye, prochain_test, depart = None, 0.0, -1.0, 0.0, 0.0
    while True:
        now = time.time()
        if now >= prochain_test:
            prochain_test = now + 2
            actif = musique() and autorise()
            if actif and cava is None and shutil.which("cava"):
                cava, depart = lancer_cava(methodes[m]), now
            elif not actif and cava is not None:
                cava.terminate()
                cava = None
                niveau, envoye = 0.0, -1.0
                halo(0)
        if cava is None:
            time.sleep(1)
            continue
        r, _, _ = select.select([cava.stdout], [], [], 0.25)
        if not r:
            continue
        ligne = cava.stdout.readline()
        if not ligne:                              # cava arrêté (son coupé, PipeWire relancé…)
            err = cava.stderr.read().strip() if cava.stderr else ""
            if time.time() - depart < 3:           # arrêté tout de suite : essaie l'autre entrée son
                log(T(f"cava ne démarre pas avec {methodes[m]} ({err[:160] or 'sans message'})",
                      f"cava does not start with {methodes[m]} ({err[:160] or 'no message'})"))
                m = (m + 1) % len(methodes)
            cava = None
            halo(0)
            continue
        barres = [int(x) for x in ligne.strip().strip(";").split(";") if x.isdigit()]
        if len(barres) < 2:
            continue
        basse = max(barres[0], barres[1]) / 100
        # Montée immédiate, retombée douce : la pulsation suit le rythme sans clignoter
        niveau = basse if basse > niveau else niveau * 0.86 + basse * 0.14
        if abs(niveau - envoye) >= 0.04:
            halo(niveau)
            envoye = niveau


def diag():
    """Chaque condition du halo, avec ✓ ou ✗, et la raison quand il ne pulse pas."""
    ok_tout = True

    def ligne(ok, texte, conseil=""):
        nonlocal ok_tout
        ok_tout = ok_tout and ok
        print(f"  {'✓' if ok else '✗'} {texte}" + (f"\n      → {conseil}" if not ok and conseil else ""))

    print(T("Halo musical : diagnostic\n", "Music glow: diagnostics\n"))
    actif = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "nc-pouls"]).returncode == 0
    ligne(actif, T("service nc-pouls lancé", "nc-pouls service running"),
          T("Super + Alt + M, ou : systemctl --user enable --now nc-pouls", "Super + Alt + M, or: systemctl --user enable --now nc-pouls"))
    ligne(socket_path() is not None, T("Hyprland joignable", "Hyprland reachable"))
    ligne(shutil.which("cava") is not None, T("cava installé", "cava installed"), T("installe le paquet cava", "install the cava package"))
    try:
        out = subprocess.run(["playerctl", "-a", "status"], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    ligne("Playing" in out, T("de la musique joue (playerctl)", "music is playing (playerctl)"),
          T("lance une musique ; le halo ne pulse que pendant la lecture", "play some music; the glow only pulses during playback"))
    jeu = os.path.exists(f"{RUN}/nc-mode-jeu")
    ligne(not jeu, T("mode jeu coupé", "game mode off"), T("Super + Alt + G pour quitter le mode jeu", "Super + Alt + G to leave game mode"))
    try:
        t = open(PROFIL).read()
        profil = (re.search(r'profil\s*=\s*"([a-z-]+)"', t) or [None, "balanced"])[1]
        batterie = re.search(r"batterie\s*=\s*true", t) is not None
    except OSError:
        profil, batterie = "balanced", False
    noms = {"power-saver": T("Économie", "Power Saver"), "balanced": T("Équilibré", "Balanced"), "performance": "Performance"}
    ligne(profil != "power-saver", T(f"profil d'énergie : {noms.get(profil, profil)}", f"power profile: {noms.get(profil, profil)}"),
          T("pas de halo en Économie", "no glow in Power Saver"))
    if batterie and profil != "performance":
        ligne(halo_sur_batterie(), T("sur batterie en Équilibré : halo autorisé", "on battery in Balanced: glow allowed"),
              T("il est coupé sur batterie pour l'autonomie ; pour le garder : nc-reglages set HALO_BATTERIE oui",
                "it is off on battery to save power; to keep it: nc-settings set HALO_BATTERIE oui"))
    # cava : une entrée son qui fonctionne
    if shutil.which("cava"):
        bonne = None
        for methode in ("pipewire", "pulse"):
            p = lancer_cava(methode)
            r, _, _ = select.select([p.stdout], [], [], 2.5)
            vivant = bool(r) and bool(p.stdout.readline())
            p.terminate()
            if vivant:
                bonne = methode
                break
        ligne(bonne is not None, T(f"cava écoute le son{f' (entrée {bonne})' if bonne else ''}",
                                   f"cava hears the sound{f' (input {bonne})' if bonne else ''}"),
              T("cava n'arrive pas à lire le son : vérifie PipeWire (systemctl --user status pipewire pipewire-pulse)",
                "cava cannot read the sound: check PipeWire (systemctl --user status pipewire pipewire-pulse)"))
    # Hyprland : la fonction du halo et les ombres
    p = subprocess.run(["hyprctl", "eval", "nc.halo(0)"], capture_output=True, text=True)
    ligne(p.stdout.strip() == "ok", T("fonction du halo présente dans Hyprland", "glow function present in Hyprland"),
          T(f"Hyprland répond : {p.stdout.strip() or p.stderr.strip()} (relance nc-maj, puis hyprctl reload)",
            f"Hyprland replies: {p.stdout.strip() or p.stderr.strip()} (run nc-update again, then hyprctl reload)"))
    p = subprocess.run(["hyprctl", "getoption", "decoration:shadow:enabled", "-j"], capture_output=True, text=True)
    ligne('"bool": true' in p.stdout.replace('":true', '": true'), T("ombres des fenêtres actives", "active window shadows"),
          T("le halo est l'ombre de la fenêtre : réactive « Halo coloré de la fenêtre active » dans nc-reglages",
            "the glow is the window's shadow: turn \"Colored glow of the active window\" back on in nc-settings"))
    if ok_tout:
        print("\n" + T("Tout est bon : lance une musique, le halo de la fenêtre active doit pulser. Essai sans musique : nc-pouls demo",
                       "All good: play some music, the glow of the active window should pulse. Try without music: nc-pouls demo"))
    else:
        print("\n" + T("Corrige les points marqués ✗, puis : systemctl --user restart nc-pouls",
                       "Fix the items marked ✗, then: systemctl --user restart nc-pouls"))


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "diag":
        diag()
    elif len(sys.argv) > 1 and sys.argv[1] == "demo":
        demo()
    elif len(sys.argv) > 1:
        print(T(__doc__.strip(), USAGE_EN))
    else:
        try:
            service()
        finally:
            halo(0)
