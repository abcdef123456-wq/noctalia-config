#!/usr/bin/env python3
"""nc-meteo : la météo pour l'île (Open-Meteo : gratuit, sans clé ni compte), en JSON.
  nc-meteo           la météo actuelle, les prochaines heures et les prochains jours (gardée 20 min en cache)
  nc-meteo texte     la même chose en clair
Ville : nc-reglages → Île → « Ville de la météo » (METEO_VILLE) ; vide : estimée d'après ta connexion internet.
Vie privée : ville vide ou « auto » = position estimée par ipwho.is d'après ton IP, puis météo par Open-Meteo
(une ville saisie n'envoie que son nom à Open-Meteo, jamais à ipwho.is). Ville introuvable : {"erreur": "ville introuvable"}.
"""
import json
import math
import os
import re
import tempfile
import sys
import time
import urllib.parse
import urllib.request

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-weather: the weather for the island (Open-Meteo: free, no key or account), as JSON.
  nc-weather         current weather, the next hours and the next days (cached for 20 min)
  nc-weather text    the same thing in plain text
City: nc-settings → Island → "Weather city" (METEO_VILLE); empty: guessed from your internet connection.
Privacy: empty or "auto" = position estimated by ipwho.is from your IP, then weather by Open-Meteo
(a typed city only sends its name to Open-Meteo, never to ipwho.is). Unknown city: {"erreur": "ville introuvable"}."""

HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "nc", "meteo.json")
DUREE = 20 * 60
PERIME = 3 * 3600      # hors ligne : au-delà, la météo gardée est marquée « perime »


class VilleIntrouvable(Exception):
    pass

# Codes météo de l'OMM -> (icône Material Symbols le jour, la nuit, texte)
CODES = {
    0: ("sunny", "clear_night", "Ciel dégagé"), 1: ("partly_cloudy_day", "partly_cloudy_night", "Plutôt dégagé"),
    2: ("partly_cloudy_day", "partly_cloudy_night", "Partiellement nuageux"), 3: ("cloud", "cloud", "Couvert"),
    45: ("foggy", "foggy", "Brouillard"), 48: ("foggy", "foggy", "Brouillard givrant"),
    51: ("rainy_light", "rainy_light", "Bruine légère"), 53: ("rainy_light", "rainy_light", "Bruine"),
    55: ("rainy", "rainy", "Bruine forte"), 56: ("rainy_light", "rainy_light", "Bruine verglaçante"),
    57: ("rainy", "rainy", "Bruine verglaçante"), 61: ("rainy_light", "rainy_light", "Pluie faible"),
    63: ("rainy", "rainy", "Pluie"), 65: ("rainy_heavy", "rainy_heavy", "Forte pluie"),
    66: ("rainy", "rainy", "Pluie verglaçante"), 67: ("rainy_heavy", "rainy_heavy", "Pluie verglaçante"),
    71: ("weather_snowy", "weather_snowy", "Neige faible"), 73: ("weather_snowy", "weather_snowy", "Neige"),
    75: ("ac_unit", "ac_unit", "Forte neige"), 77: ("weather_snowy", "weather_snowy", "Grains de neige"),
    80: ("rainy_light", "rainy_light", "Averses"), 81: ("rainy", "rainy", "Averses"), 82: ("rainy_heavy", "rainy_heavy", "Fortes averses"),
    85: ("weather_snowy", "weather_snowy", "Averses de neige"), 86: ("ac_unit", "ac_unit", "Averses de neige"),
    95: ("thunderstorm", "thunderstorm", "Orage"), 96: ("thunderstorm", "thunderstorm", "Orage et grêle"),
    99: ("thunderstorm", "thunderstorm", "Orage et grêle"),
}
# Le JSON reste en français (l'île le traduit elle-même) ; en anglais, seul « nc-meteo texte » est traduit
JOURS = ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."]
JOURS_EN = dict(zip(JOURS, ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]))
CIEL_EN = {
    0: "Clear", 1: "Mostly clear", 2: "Partly cloudy", 3: "Cloudy", 45: "Fog", 48: "Freezing fog",
    51: "Light drizzle", 53: "Drizzle", 55: "Heavy drizzle", 56: "Freezing drizzle", 57: "Freezing drizzle",
    61: "Light rain", 63: "Rain", 65: "Heavy rain", 66: "Freezing rain", 67: "Freezing rain",
    71: "Light snow", 73: "Snow", 75: "Heavy snow", 77: "Snow grains", 80: "Showers", 81: "Showers",
    82: "Heavy showers", 85: "Snow showers", 86: "Snow showers", 95: "Thunderstorm", 96: "Thunderstorm with hail",
    99: "Thunderstorm with hail",
}


def reglage(cle, defaut=""):
    try:
        with open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
            for l in f:
                if l.startswith(cle + "="):
                    defaut = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return defaut


def lire(url):
    req = urllib.request.Request(url, headers={"User-Agent": "noctalia-config (nc-meteo)"})
    with urllib.request.urlopen(req, timeout=8) as r:
        return json.loads(r.read().decode())


def lieu(ville):
    """(latitude, longitude, nom, estimée) de la ville choisie, sinon d'après la connexion (estimée : peut être fausse)."""
    if ville:
        r = lire(f"https://geocoding-api.open-meteo.com/v1/search?count=1&language={T('fr', 'en')}&name=" + urllib.parse.quote(ville))
        if r.get("results"):
            x = r["results"][0]
            return x["latitude"], x["longitude"], x.get("name", ville), False
        raise VilleIntrouvable(ville)       # saisie mais inconnue : jamais de repli sur l'IP (ipwho.is)
    r = lire("https://ipwho.is/?fields=latitude,longitude,city,success")
    if r.get("success") is False:
        raise OSError("position introuvable")
    return r["latitude"], r["longitude"], r.get("city", ""), True


def arrondi(x):
    """Arrondi d'affichage : 12,5 donne 13 (round() de Python arrondit au pair : 12,5 donne 12).
    Pour un négatif, -2,5 donne -2 (arrondi vers le haut)."""
    return math.floor(x + 0.5)


def icone(code, jour=True):
    c = CODES.get(code, ("cloud", "cloud", "—"))
    return c[0] if jour else c[1]


def meteo():
    ville = reglage("METEO_VILLE", "auto")
    ville = "" if ville == "auto" else ville
    try:
        with open(CACHE, encoding="utf-8") as f:
            c = json.load(f)
        if time.time() - c.get("t", 0) < DUREE and c.get("demande") == ville:
            c.setdefault("estimee", ville == "")
            return c
    except (OSError, ValueError):
        c = None
    try:
        lat, lon, nom, estimee = lieu(ville)
        q = urllib.parse.urlencode({
            "latitude": lat, "longitude": lon, "timezone": "auto", "forecast_days": 5,
            "current": "temperature_2m,apparent_temperature,weather_code,is_day,wind_speed_10m,relative_humidity_2m",
            "hourly": "temperature_2m,weather_code,is_day", "daily": "weather_code,temperature_2m_max,temperature_2m_min",
        })
        r = lire("https://api.open-meteo.com/v1/forecast?" + q)
    except VilleIntrouvable:
        return {"erreur": "ville introuvable"}
    except (OSError, ValueError, KeyError):
        # Pas de réseau : la dernière météo connue, mais seulement pour la même ville, et marquée « perime » au-delà de 3 h
        if isinstance(c, dict) and c.get("demande") == ville and "temp" in c:
            c = dict(c)
            if time.time() - c.get("t", 0) > PERIME:
                c["perime"] = True
            return c
        return {"erreur": "hors ligne"}
    try:
        cur = r["current"]
        jour = bool(cur.get("is_day", 1))
        h = r["hourly"]
        maintenant = cur["time"][:13]
        debut = next((i for i, t in enumerate(h["time"]) if t[:13] >= maintenant), 0)
        heures = [{"h": h["time"][i][11:13] + " h", "t": arrondi(h["temperature_2m"][i]),
                   "icone": icone(h["weather_code"][i], bool(h["is_day"][i]))} for i in range(debut + 1, min(debut + 7, len(h["time"])))]
        d = r["daily"]
        jours = []
        for i, t in enumerate(d["time"]):
            a, m, j = (int(x) for x in t.split("-"))
            nom_jour = "Aujourd'hui" if i == 0 else JOURS[__import__("datetime").date(a, m, j).weekday()]
            jours.append({"jour": nom_jour, "min": arrondi(d["temperature_2m_min"][i]), "max": arrondi(d["temperature_2m_max"][i]),
                          "icone": icone(d["weather_code"][i])})
        res = {
            "t": time.time(), "demande": ville, "ville": nom, "estimee": estimee, "temp": arrondi(cur["temperature_2m"]),
            "ressenti": arrondi(cur["apparent_temperature"]), "vent": arrondi(cur["wind_speed_10m"]),
            "humidite": arrondi(cur.get("relative_humidity_2m", 0)), "code": cur["weather_code"],
            "icone": icone(cur["weather_code"], jour), "texte": CODES.get(cur["weather_code"], ("", "", "—"))[2],
            "min": jours[0]["min"] if jours else None, "max": jours[0]["max"] if jours else None,
            "heures": heures, "jours": jours,
        }
    except (TypeError, IndexError, KeyError, ValueError, AttributeError, OverflowError):
        return c if isinstance(c, dict) and c.get("demande") == ville and "temp" in c else {"erreur": "réponse illisible"}          # un null ou un champ manquant : la dernière météo connue
    # L'écriture du cache ne doit jamais empêcher d'afficher la météo (nom unique : deux instances en même temps)
    tmp = None
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(CACHE), prefix="meteo.", suffix=".tmp")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(res, f, ensure_ascii=False)
        os.replace(tmp, CACHE)
    except OSError:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return res


def nom_ville(m):
    """Le nom de la ville ; « (estimée) » / « (estimated) » quand elle vient de la connexion et non d'un réglage."""
    v = m.get("ville", "")
    return v + T(" (estimée)", " (estimated)") if m.get("estimee") and v else v


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "aide", "help"):
        return print(T(__doc__.strip(), USAGE_EN))
    m = meteo()
    if len(sys.argv) > 1 and sys.argv[1] in ("texte", "text"):
        if m.get("erreur") == "ville introuvable":
            print(T("Ville introuvable : change-la dans nc-reglages → Île.", "City not found: change it in nc-settings → Island."))
            return
        if "temp" not in m:
            print(T("Météo indisponible (hors ligne ?)", "Weather unavailable (offline?)"))
            return
        if not EN:
            print(f"{nom_ville(m)} : {m['temp']} °C, {m['texte'].lower()} (ressenti {m['ressenti']} °C, min {m['min']}, max {m['max']})")
            print("  " + "   ".join(f"{x['h']} {x['t']}°" for x in m["heures"]))
            print("  " + "   ".join(f"{x['jour']} {x['min']}/{x['max']}°" for x in m["jours"]))
            if m.get("estimee"):
                print("  " + "Choisir ma ville : nc-reglages → Île (Ville de la météo)")
            return

        def heure(h):
            try:
                n = int(h.split()[0])
            except (ValueError, IndexError):
                return h
            return f"{n % 12 or 12} {'AM' if n < 12 else 'PM'}"
        def jour(j):
            return "Today" if j == "Aujourd'hui" else JOURS_EN.get(j, j)
        ciel = CIEL_EN.get(m.get("code"), m["texte"]).lower()
        print(f"{nom_ville(m)}: {m['temp']}°C, {ciel} (feels like {m['ressenti']}°C, low {m['min']}, high {m['max']})")
        print("  " + "   ".join(f"{heure(x['h'])} {x['t']}°" for x in m["heures"]))
        print("  " + "   ".join(f"{jour(x['jour'])} {x['min']}/{x['max']}°" for x in m["jours"]))
        if m.get("estimee"):
            print("  " + "Choose my city: nc-settings → Island (Weather city)")
        return
    print(json.dumps(m, ensure_ascii=False))


if __name__ == "__main__":
    main()
