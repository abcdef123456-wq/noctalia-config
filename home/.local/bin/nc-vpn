#!/usr/bin/env python3
"""nc-vpn : les connexions VPN et WireGuard de NetworkManager, pilotées depuis le bureau (panneau VPN de l'île, Super + Alt + V).
  nc-vpn etat-json            les connexions de type vpn et wireguard en JSON : {"disponible", "connexions", "actives"}
                              (uuid, nom, type, active, interface) ; nmcli absent ou NetworkManager arrêté : {"disponible": false}
  nc-vpn liste                les mêmes en clair
  nc-vpn connecter UUID       monte ce tunnel (déjà monté : rien à faire) ; plusieurs tunnels peuvent être montés à la fois
  nc-vpn deconnecter UUID     coupe ce tunnel
  nc-vpn tout-deconnecter     coupe tous les tunnels montés
  nc-vpn importer FICHIER     importe un .ovpn (OpenVPN) ou un .conf (WireGuard) dans NetworkManager, en connexion privée
                              à toi et sans connexion automatique
  nc-vpn indicateur --json    le tunnel RÉELLEMENT monté, pour la pilule : {"disponible", "actif", "fournisseur", "pays", "nom", "nombre"}
                              (un seul nmcli ; fournisseur et pays déduits du nom de la connexion et de l'interface, sans réseau)
  nc-vpn mullvad etat-json    l'application officielle Mullvad (commande `mullvad`, hors NetworkManager) : {"installe", "connecte", "pays", "hote"}
  nc-vpn mullvad connecter | deconnecter | pays CC    les pilote (`mullvad connect`, `mullvad disconnect`, `mullvad relay set location cc`)
  nc-vpn mullvad pays-json    les pays de Mullvad (`mullvad relay list`) en JSON : {"pays": [{"cc", "nom"}]}
  nc-vpn fournisseurs-json [--verifier-proton]    Nord, Proton et Mullvad pour la fenêtre : {"contrat": 1, "fournisseurs": [{"id", "nom", "etat": absent | sans_compte | pilote_appli | pret,
                              "message", "pays" (seulement à l'état pret), "pays_actif", "connecte", "peut_login", "probleme", "pilotage"}]}
                              (fournisseur absent : "installation": {"mode": auto | guide, "lien", "etapes"})
  nc-vpn installer-client nord|proton|mullvad    client absent seulement : ouvre un terminal (kitty) qui lance le script fixe nc-vpn-installer (étapes
                              visibles, sudo demande lui-même le mot de passe, aucune règle sudoers) ; rend la main à la fermeture de la fenêtre
  nc-vpn fournisseur nord|proton|mullvad connecter CC | deconnecter | login    CC : deux lettres MAJUSCULES (FR). Nord : la CLI nordvpn ;
                              Mullvad : mullvad ; Proton : la CLI officielle protonvpn (sinon ouvre l'appli, sans la piloter ni la fermer).
                              Le login lance le parcours officiel (navigateur, appli) : jamais de mot de passe, de numéro de compte ni de jeton chez nous
  nc-vpn killswitch activer | desactiver | etat | etat-json | limites    bloque toute sortie hors du tunnel monté (VPN_KILLSWITCH à oui ;
                              assistant root facultatif posé par install.sh ; les limites sont affichées avant d'activer)
  nc-vpn ip-publique          ton adresse IP publique, si tu l'as demandé (nc-reglages → Île : VPN_IP_PUBLIQUE et VPN_IP_SERVICE)
Contrat JSON pour les scripts et JARVIS (docs/vpn-contrat.md, "contrat": 1) : etat-json et killswitch etat-json en JSON ;
connecter UUID, deconnecter UUID, tout-deconnecter et killswitch activer|desactiver acceptent --json en dernier argument
(succès : {"contrat", "ok": true, …} ; erreur : {"contrat", "ok": false, "code", "erreur"} sur la sortie standard, code de sortie 1).
Alias : status --json = etat-json, connect = connecter, disconnect = deconnecter. Rappel : après une mise à jour, relance `nc-jarvis deployer`.
Tout passe par nmcli, en arguments (jamais par une ligne de shell), et par l'UUID de la connexion. Ni root, ni pkexec.
Importer refuse un fichier qui ferait exécuter quelque chose (up, down, route-up, script-security 2, plugin, PostUp…), un lien,
un fichier trop gros (64 Kio). Les certificats donnés par un chemin relatif (ca, cert, key, tls-auth, tls-crypt…) sont lus depuis
le dossier du .ovpn et mis dans une copie temporaire (PEM texte seulement, 64 Kio au plus en tout) ; l'original n'est jamais
modifié. Un bloc <auth-user-pass> (identifiant puis mot de passe) est accepté : l'identifiant va dans la connexion, le mot de
passe dans le trousseau de la session (secret-tool, paquet libsecret ; il faut un trousseau ouvert : gnome-keyring, KeePassXC,
KWallet…), jamais dans un fichier ; sans trousseau l'import est refusé. Les secrets restent chez NetworkManager ou dans le
trousseau : jamais dans nos fichiers, jamais dans les journaux ni dans la sortie.
"""
import fcntl
import json
import os
import re
import selectors
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-vpn: NetworkManager's VPN and WireGuard connections, driven from the desktop (island VPN panel, Super + Alt + V).
  nc-vpn etat-json            the vpn and wireguard connections as JSON: {"disponible", "connexions", "actives"}
                              (uuid, nom, type, active, interface); no nmcli or NetworkManager stopped: {"disponible": false}
  nc-vpn liste                the same in plain text
  nc-vpn connecter UUID       bring this tunnel up (already up: nothing to do); several tunnels can be up at once
  nc-vpn deconnecter UUID     bring this tunnel down
  nc-vpn tout-deconnecter     bring every active tunnel down
  nc-vpn importer FILE        import an .ovpn (OpenVPN) or .conf (WireGuard) file into NetworkManager, private to you
                              and without autoconnect
  nc-vpn indicateur --json    the tunnel that is REALLY up, for the pill: {"disponible", "actif", "fournisseur", "pays", "nom", "nombre"}
                              (one nmcli; provider and country guessed from the connection and interface names, no network)
  nc-vpn mullvad etat-json    the official Mullvad app (`mullvad` command, outside NetworkManager): {"installe", "connecte", "pays", "hote"}
  nc-vpn mullvad connecter | deconnecter | pays CC    drive it (`mullvad connect`, `mullvad disconnect`, `mullvad relay set location cc`)
  nc-vpn mullvad pays-json    Mullvad's countries (`mullvad relay list`) as JSON: {"pays": [{"cc", "nom"}]}
  nc-vpn fournisseurs-json [--verifier-proton]    Nord, Proton and Mullvad for the window: {"contrat": 1, "fournisseurs": [{"id", "nom", "etat": absent | sans_compte | pilote_appli | pret,
                              "message", "pays" (only when pret), "pays_actif", "connecte", "peut_login", "probleme", "pilotage"}]}
                              (absent provider: "installation": {"mode": auto | guide, "lien", "etapes"})
  nc-vpn installer-client nord|proton|mullvad    absent client only: opens a terminal (kitty) running the fixed nc-vpn-installer script (visible
                              steps, sudo asks for the password itself, no sudoers rule); returns when the window is closed
  nc-vpn fournisseur nord|proton|mullvad connecter CC | deconnecter | login    CC: two UPPERCASE letters (FR). Nord: the nordvpn CLI;
                              Mullvad: mullvad; Proton: the official protonvpn CLI (else opens the app, never driving or closing it).
                              Login starts the official flow (browser, app): never a password, account number or token on our side
  nc-vpn killswitch activer | desactiver | etat | etat-json | limites    block everything leaving outside the tunnel that is up
                              (VPN_KILLSWITCH set to oui; optional root helper installed by install.sh; the limits are shown before enabling)
  nc-vpn ip-publique          your public IP address, if you asked for it (nc-settings → Island: VPN_IP_PUBLIQUE and VPN_IP_SERVICE)
JSON contract for scripts and JARVIS (docs/vpn-contrat.md, "contrat": 1): etat-json and killswitch etat-json print JSON;
connecter UUID, deconnecter UUID, tout-deconnecter and killswitch activer|desactiver accept --json as the last argument
(success: {"contrat", "ok": true, …}; error: {"contrat", "ok": false, "code", "erreur"} on standard output, exit code 1).
Aliases: status --json = etat-json, connect = connecter, disconnect = deconnecter. Reminder: after an update, run `nc-jarvis deployer` again.
Everything goes through nmcli, as arguments (never a shell line), by connection UUID. No root, no pkexec.
Import refuses a file that would run something (up, down, route-up, script-security 2, plugin, PostUp…), a link, a file that
is too big (64 KiB). Certificates given by a relative path (ca, cert, key, tls-auth, tls-crypt…) are read from the .ovpn's
folder and put into a temporary copy (text PEM only, 64 KiB at most in all); the original is never modified. An
<auth-user-pass> block (username then password) is accepted: the username goes into the connection, the password into the
session keyring (secret-tool, libsecret package; an unlocked keyring is needed: gnome-keyring, KeePassXC, KWallet…), never
into a file; without a keyring the import is refused. Secrets stay with NetworkManager or in the keyring: never in our files,
logs or output."""

TYPES = ("vpn", "wireguard")
UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
MAX_OCTETS = 64 * 1024

# OpenVPN : directives qui exécutent un programme ou chargent du code (et « iproute », « pkcs11-providers »)
OVPN_EXEC = ("up", "down", "route-up", "route-pre-down", "ipchange", "client-connect", "client-disconnect", "learn-address",
             "tls-verify", "auth-user-pass-verify", "plugin", "iproute", "pkcs11-providers", "dns-updown", "tls-crypt-v2-verify")
# OpenVPN : directives qui feraient lire un autre fichier de configuration (non vérifié ici) ou écrire un fichier n'importe où
OVPN_AUTRES = ("config", "log", "log-append", "writepid", "status", "management")
WG_EXEC = ("preup", "postup", "predown", "postdown")
# Fichiers de certificats donnés par un chemin : la copie temporaire est effacée, un chemin relatif ne mènerait plus à rien
OVPN_FICHIERS = ("ca", "cert", "key", "pkcs12", "tls-auth", "tls-crypt", "tls-crypt-v2", "secret", "crl-verify", "extra-certs", "dh")


CODES_REFUS = ("pas_installe", "aucun_tunnel", "plusieurs_tunnels", "serveur_nom", "mullvad", "firewall", "nm_indisponible", "autre")
CONTRAT = 1      # version du contrat JSON (docs/vpn-contrat.md) : change seulement si un champ disparaît ou change de sens


class Echec(Exception):
    """Une erreur annoncée. `code` est stable (contrat JSON) : echec, uuid_invalide, nm_indisponible, inconnue,
    echec_partiel, occupe, killswitch_coupe, killswitch_refuse, killswitch_actif. `refus` (killswitch etat-json) vient d'un Echec dont le
    code donne `refus_code` : pas_installe, aucun_tunnel, plusieurs_tunnels, serveur_nom, mullvad, nm_indisponible, autre."""
    def __init__(self, message="", code="echec"):
        super().__init__(message)
        self.code = code


def nmcli(args, delai=15):
    """(code, sortie, erreur) d'un nmcli lancé en arguments, en anglais (messages stables). 127 : nmcli absent."""
    if not shutil.which("nmcli"):
        return 127, "", ""
    env = dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C")
    try:
        r = subprocess.run(["nmcli"] + args, capture_output=True, text=True, errors="replace", timeout=delai, env=env,
                           stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return 126, "", ""
    return r.returncode, r.stdout, r.stderr


def champs_nmcli(ligne):
    """Découpe une ligne de « nmcli -t » : séparateur « : », échappé par « \\: » (et « \\\\ » pour l'antislash)."""
    res, cur, i = [], [], 0
    while i < len(ligne):
        c = ligne[i]
        if c == "\\" and i + 1 < len(ligne):
            cur.append(ligne[i + 1]); i += 2
            continue
        if c == ":":
            res.append("".join(cur)); cur = []
        else:
            cur.append(c)
        i += 1
    res.append("".join(cur))
    return res


def etat():
    """{"disponible": False} ou {"disponible": True, "connexions": [...], "actives": [...]}."""
    code, out, _ = nmcli(["-t", "-c", "no", "-f", "UUID,TYPE,ACTIVE,DEVICE,NAME", "connection", "show"])
    if code != 0:
        return {"disponible": False}
    connexions = []
    for ligne in out.splitlines():
        f = champs_nmcli(ligne)
        if len(f) < 5:
            continue
        uuid, typ, active, dev = f[0], f[1], f[2], f[3]
        nom = ":".join(f[4:])        # le nom est le dernier champ : un « : » non échappé n'y casserait rien
        if typ not in TYPES or not UUID.fullmatch(uuid):
            continue
        on = active == "yes"
        connexions.append({"uuid": uuid.lower(), "nom": nom, "type": "wireguard" if typ == "wireguard" else "vpn", "active": on,
                           "interface": dev if on and dev not in ("", "--") else ""})
    return {"disponible": True, "connexions": connexions, "actives": [c for c in connexions if c["active"]]}


def uuid_valide(u):
    if not isinstance(u, str) or not UUID.fullmatch(u):
        raise Echec(T("UUID invalide (forme attendue : 8-4-4-4-12 chiffres hexadécimaux).",
                      "Invalid UUID (expected form: 8-4-4-4-12 hexadecimal digits)."), "uuid_invalide")
    return u.lower()


def connue(u):
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."), "nm_indisponible")
    for c in e["connexions"]:
        if c["uuid"] == u:
            return c
    raise Echec(T("Cette connexion n'est pas un VPN ou un WireGuard connu de NetworkManager.",
                  "This connection is not a VPN or WireGuard known to NetworkManager."), "inconnue")


def court(texte, n=200):
    ligne = (texte or "").strip().splitlines()
    return ligne[0][:n] if ligne else ""


def connecter(u):
    u = uuid_valide(u)
    nettoyer_abandonnes()
    c = connue(u)
    if c["active"]:
        return {"nom": c["nom"], "deja": True}
    # Mot de passe gardé par le trousseau (password-flags=1) : aucun agent de secrets ne tourne forcément (Hyprland sans nm-applet),
    # donc on le relit et on le donne à nmcli par un fichier temporaire (format « vpn.secrets.password:… »), jamais en argument
    agent = c["type"] == "vpn" and mot_de_passe_agent_owned(u)
    mdp = lire_secret(u) if agent else None
    d = None
    try:
        args = ["connection", "up", "uuid", u]
        if mdp is not None:
            d = dossier_prive()
            fichier = os.path.join(d, "mdp")
            fd = os.open(fichier, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(("vpn.secrets.password:" + mdp + "\n").encode("utf-8"))
            args += ["passwd-file", fichier]
        code, _, err = nmcli(args, delai=120)
    except OSError:
        raise Echec(T("Impossible d'écrire le fichier temporaire du mot de passe.", "Could not write the temporary password file."))
    finally:
        if d:
            shutil.rmtree(d, ignore_errors=True)
    if code != 0:
        if agent and mdp is None and re.search(r"secrets? (were|was) required|no secrets", err or "", re.I):
            raise Echec(T(f"Connexion impossible : {c['nom']} (secret introuvable dans le trousseau : réimporte le profil ou ouvre ton trousseau)",
                          f"Could not connect: {c['nom']} (secret not found in the keyring: import the profile again or unlock your keyring)"))
        msg = court(masquer(err, mdp)).replace(d or "\0", "")
        raise Echec(T(f"Connexion impossible : {c['nom']}", f"Could not connect: {c['nom']}") + (" (" + msg + ")" if msg else ""))
    return {"nom": c["nom"], "deja": False}


def deconnecter(u):
    u = uuid_valide(u)
    c = connue(u)
    if not c["active"]:
        return {"nom": c["nom"], "deja": True}
    code, _, err = nmcli(["connection", "down", "uuid", u], delai=60)
    if code != 0:
        raise Echec(T(f"Déconnexion impossible : {c['nom']}", f"Could not disconnect: {c['nom']}") + (" (" + court(err) + ")" if court(err) else ""))
    return {"nom": c["nom"], "deja": False}


def tout_deconnecter():
    """{"coupes": [connexions], "rates": [connexions]} ; Echec si NetworkManager manque."""
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."), "nm_indisponible")
    coupes, rates = [], []
    for c in e["actives"]:
        code, _, _ = nmcli(["connection", "down", "uuid", c["uuid"]], delai=60)
        (rates if code != 0 else coupes).append(c)
    return {"coupes": coupes, "rates": rates}


# ── Un seul changement de VPN à la fois ──────────────────────────────────────────────────────────────────────────
_verrou = None


def verrou_changement():
    """connecter, deconnecter et tout-deconnecter ne tournent pas en même temps (flock non bloquant sur
    $XDG_RUNTIME_DIR/nc-vpn.lock, gardé jusqu'à la fin du processus, relâché par le noyau même si nc-vpn est tué). Occupé :
    Echec de code « occupe ». Un verrou impossible à créer ne bloque rien."""
    global _verrou
    if _verrou is not None:      # déjà tenu par ce processus (mullvad_connecter appelle mullvad_agir deux fois)
        return
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if not base or not os.path.isdir(base) or os.stat(base).st_uid != os.getuid():
            return
        fd = os.open(os.path.join(base, "nc-vpn.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise Echec(T("Un autre changement de VPN est en cours.", "Another VPN change is in progress."), "occupe")
    _verrou = fd


# ── Sorties : texte pour le bureau, JSON (--json) pour JARVIS et les scripts (docs/vpn-contrat.md) ──────────────
def sortie_json(d):
    print(json.dumps(dict({"contrat": CONTRAT, "ok": True}, **d), ensure_ascii=False))


def agir_connexion(cmd, u, en_json):
    """connecter / deconnecter UUID : le même code pour le texte et le JSON."""
    verrou_changement()
    r = (connecter if cmd == "connecter" else deconnecter)(u)
    actif = cmd == "connecter"
    if en_json:
        return sortie_json({"action": cmd, "uuid": uuid_valide(u), "nom": r["nom"], "actif": actif, "deja": r["deja"]})
    if actif:
        print(T(f"Déjà connecté : {r['nom']}", f"Already connected: {r['nom']}") if r["deja"]
              else T(f"Connecté : {r['nom']}", f"Connected: {r['nom']}"))
    else:
        print(T(f"Déjà déconnecté : {r['nom']}", f"Already disconnected: {r['nom']}") if r["deja"]
              else T(f"Déconnecté : {r['nom']}", f"Disconnected: {r['nom']}"))


def agir_tout(en_json):
    verrou_changement()
    r = tout_deconnecter()
    if en_json:
        brut = lambda l: [{"uuid": c["uuid"], "nom": c["nom"]} for c in l]
        d = {"action": "tout-deconnecter", "coupes": brut(r["coupes"]), "rates": brut(r["rates"])}
        if r["rates"]:
            print(json.dumps(dict({"contrat": CONTRAT, "ok": False, "code": "echec_partiel",
                                   "erreur": T("Certains tunnels n'ont pas pu être coupés.", "Some tunnels could not be disconnected.")}, **d),
                             ensure_ascii=False))
            sys.exit(1)
        return sortie_json(d)
    if not r["coupes"] and not r["rates"]:
        return print(T("Aucun tunnel connecté.", "No tunnel connected."))
    for c in r["coupes"]:
        print(T(f"Déconnecté : {c['nom']}", f"Disconnected: {c['nom']}"))
    for c in r["rates"]:
        print(T(f"Déconnexion impossible : {c['nom']}", f"Could not disconnect: {c['nom']}"), file=sys.stderr)
    if r["rates"]:
        sys.exit(1)


# ── Import ──────────────────────────────────────────────────────────────────────────────────────────────────────
def lire_fichier(chemin):
    """Les octets d'un fichier ordinaire (jamais un lien), de 64 Kio au plus, en .ovpn ou .conf."""
    if not isinstance(chemin, str) or chemin == "" or "\0" in chemin:
        raise Echec(T("Chemin de fichier invalide.", "Invalid file path."))
    nom = os.path.basename(chemin)
    if os.path.splitext(nom)[1].lower() not in (".ovpn", ".conf"):
        raise Echec(T("Seuls les fichiers .ovpn (OpenVPN) et .conf (WireGuard) sont acceptés.",
                      "Only .ovpn (OpenVPN) and .conf (WireGuard) files are accepted."))
    try:
        if stat.S_ISLNK(os.lstat(chemin).st_mode):
            raise Echec(T("Un lien symbolique est refusé : donne le fichier lui-même.", "A symbolic link is refused: give the file itself."))
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except Echec:
        raise
    except OSError:
        raise Echec(T("Fichier introuvable ou illisible.", "File not found or unreadable."))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Echec(T("Ce n'est pas un fichier ordinaire.", "This is not a regular file."))
        if st.st_size > MAX_OCTETS:
            raise Echec(T("Fichier trop gros (64 Kio au plus).", "File too big (64 KiB at most)."))
        donnees = b""
        while len(donnees) <= MAX_OCTETS:
            bloc = os.read(fd, MAX_OCTETS + 1 - len(donnees))
            if not bloc:
                break
            donnees += bloc
    except OSError:
        raise Echec(T("Fichier illisible.", "File unreadable."))
    finally:
        os.close(fd)
    if len(donnees) > MAX_OCTETS:
        raise Echec(T("Fichier trop gros (64 Kio au plus).", "File too big (64 KiB at most)."))
    if b"\0" in donnees:
        raise Echec(T("Ce n'est pas un fichier texte.", "This is not a text file."))
    return nom, donnees


def verifier(texte):
    """Refuse (Echec) ce qui exécute quelque chose ou demande un traitement de mot de passe. Retourne 'openvpn' ou 'wireguard'.
    Chaque ligne est examinée, y compris dans les blocs <…> ; les lignes de commentaire (# ou ;) sont ignorées."""
    texte = texte.lstrip("﻿")
    wireguard = False
    for brute in texte.splitlines():
        ligne = brute.strip()
        if ligne == "" or ligne[0] in "#;":
            continue
        if re.match(r"\[\s*interface\s*\]", ligne, re.I):
            wireguard = True
        if re.match(r"<\s*/?\s*auth-user-pass\s*>", ligne, re.I):
            raise Echec(T("Un bloc <auth-user-pass> inattendu est refusé (un seul bloc, de deux lignes : identifiant puis mot de passe).",
                          "An unexpected <auth-user-pass> block is refused (a single block of two lines: username then password)."))
        # OpenVPN lit les guillemets n'importe où dans un mot (u"p" est « up ») : ils sont retirés avant de lire la directive
        m = re.match(r"-{0,2}([A-Za-z][A-Za-z0-9_-]*)(?=$|[\s=])\s*(.*)$", ligne.replace('"', "").replace("'", ""))
        if not m:
            continue
        mot, reste = m.group(1).lower(), m.group(2)
        if mot in OVPN_EXEC:
            raise Echec(T(f"Directive refusée « {mot} » : elle ferait exécuter un programme. Retire-la du fichier.",
                          f"Directive refused \"{mot}\": it would run a program. Remove it from the file."))
        if mot in OVPN_AUTRES and not wireguard:
            raise Echec(T(f"Directive refusée « {mot} » : elle ferait lire ou écrire un autre fichier. Retire-la du fichier.",
                          f"Directive refused \"{mot}\": it would read or write another file. Remove it from the file."))
        if mot in WG_EXEC:
            raise Echec(T(f"Directive refusée « {m.group(1)} » : elle ferait exécuter une commande. Retire-la du fichier.",
                          f"Directive refused \"{m.group(1)}\": it would run a command. Remove it from the file."))
        if mot == "script-security":
            niveau = (reste.split() or [""])[0].lower()
            if niveau not in ("0", "1", "none", "builtin"):
                raise Echec(T("Directive refusée « script-security » au-dessus de 1 : elle autorise l'exécution de scripts.",
                              "Directive refused \"script-security\" above 1: it allows scripts to run."))
        if mot in OVPN_FICHIERS and not wireguard:
            arg = (reste.split() or [""])[0]
            if arg and arg != "[inline]" and not arg.startswith("/"):
                raise Echec(T(f"Le certificat « {mot} {arg} » est donné par un chemin relatif : il ne serait pas retrouvé après l'import. Mets-le dans le fichier (bloc <{mot}>…</{mot}>) ou donne un chemin complet.",
                              f"The certificate \"{mot} {arg}\" is given by a relative path: it would not be found after the import. Put it in the file (<{mot}>…</{mot}> block) or give a full path."))
            if arg.startswith("/"):
                fichier_lisible(mot, arg)
    return "wireguard" if wireguard else "openvpn"


def fichier_lisible(mot, chemin):
    """Un certificat donné par un chemin complet : openvpn le lira en root (lancé par NetworkManager). Il doit donc être un
    fichier ordinaire que l'utilisateur peut lire LUI-MÊME (sinon un .ovpn douteux ferait lire par root un fichier interdit,
    voire l'enverrait au serveur), sans lien ni détour, hors de /proc, /sys et /dev."""
    reel = os.path.realpath(chemin)
    ok = reel == os.path.normpath(chemin) and not re.match(r"/(proc|sys|dev)(/|$)", reel)
    if ok:
        try:
            ok = stat.S_ISREG(os.lstat(chemin).st_mode) and os.access(chemin, os.R_OK)
        except OSError:
            ok = False
    if not ok:
        raise Echec(T(f"Le certificat « {mot} {chemin} » est refusé : ce doit être un fichier ordinaire (pas un lien, ni dans /proc, /sys ou /dev) que tu peux lire toi-même. Sinon, mets-le dans le fichier (bloc <{mot}>…</{mot}>).",
                      f"The certificate \"{mot} {chemin}\" is refused: it must be a regular file (not a link, nor in /proc, /sys or /dev) that you can read yourself. Otherwise, put it in the file (<{mot}>…</{mot}> block)."))


def dossier_prive():
    """Un dossier 0700 neuf, sous XDG_RUNTIME_DIR (le dossier privé de la session) si possible."""
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if base and os.path.isdir(base) and os.stat(base).st_uid == os.getuid():
            d = tempfile.mkdtemp(prefix="nc-vpn-", dir=base)
        else:
            d = tempfile.mkdtemp(prefix="nc-vpn-")
    except OSError:
        raise Echec(T("Impossible de créer un dossier temporaire privé.", "Could not create a private temporary folder."))
    os.chmod(d, 0o700)
    return d


# Dossier abandonné : un nc-vpn tué avant son « finally » (SIGKILL, coupure de courant) peut laisser « nc-vpn-*/mdp » (le mot de
# passe en clair, 0600) dans XDG_RUNTIME_DIR. Le ménage de connecter() et d'importer() efface ceux de plus de SEUIL secondes.
# Le seuil doit rester LARGEMENT au-dessus du plus long travail légitime : connecter() dure au plus ~190 s (état de NetworkManager
# 15 s, agent-owned ~20 s, secret-tool 30 s, nmcli up 120 s) et importer() ~60 s. Si l'un de ces délais augmente, on monte ce
# seuil (tests/test_nc_vpn_menage.py vérifie qu'il reste au moins le double de la somme des délais de connecter).
SEUIL_DOSSIER_ABANDONNE = 600       # secondes (10 minutes)


def nettoyer_abandonnes(seuil=None):
    """Efface les dossiers DIRECTS de XDG_RUNTIME_DIR nommés « nc-vpn-* » (le préfixe de dossier_prive), qui sont à nous
    (lstat st_uid), ne sont pas des liens (S_ISDIR sur lstat) et dont le mtime date de plus que le seuil. Un lien, un fichier,
    le dossier d'un autre préfixe ou d'un autre utilisateur ne sont jamais touchés ; rmtree ne suit aucun lien ; toute erreur est ignorée."""
    seuil = SEUIL_DOSSIER_ABANDONNE if seuil is None else seuil
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if not base or not os.path.isdir(base) or os.stat(base).st_uid != os.getuid():
            return
        with os.scandir(base) as it:
            entrees = [e.name for e in it if e.name.startswith("nc-vpn-")]
    except OSError:
        return
    maintenant = time.time()
    for nom in entrees:
        chemin = os.path.join(base, nom)
        try:
            st = os.lstat(chemin)
            if stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and maintenant - st.st_mtime > seuil:
                shutil.rmtree(chemin, ignore_errors=True)
        except OSError:
            pass


def arret_propre(num, _cadre):
    """SIGTERM, SIGINT, SIGHUP : une exception, pour que les « finally » (effacement du dossier du mot de passe) s'exécutent."""
    raise SystemExit(128 + num)


BLOC_AUTH_DEBUT = re.compile(r"<\s*auth-user-pass\s*>", re.I)
BLOC_AUTH_FIN = re.compile(r"<\s*/\s*auth-user-pass\s*>", re.I)
# Le schéma et les attributs du trousseau de nm-applet et de GNOME Shell (KEYRING_UUID_TAG « connection-uuid »,
# KEYRING_SN_TAG « setting-name », KEYRING_SK_TAG « setting-key » dans leurs sources)
SCHEMA_NM = "org.freedesktop.NetworkManager.Connection"


def masquer(texte, secret):
    """Un message d'outil : le mot de passe (et sa forme échappée) n'y apparaît jamais."""
    if not secret:
        return texte or ""
    texte = (texte or "").replace(secret, "***")
    for forme in (json.dumps(secret)[1:-1], repr(secret)[1:-1]):
        if forme:
            texte = texte.replace(forme, "***")
    return texte


def extraire_auth(texte):
    """(texte sans le bloc <auth-user-pass>, identifiant, mot de passe). Le bloc (deux lignes : identifiant puis mot de passe)
    est remplacé par la directive « auth-user-pass » seule, pour que NetworkManager crée une connexion à mot de passe.
    Sans bloc : (texte, None, None)."""
    sortie, bloc, trouve, fin = [], None, False, None
    for brute in texte.splitlines():
        ligne = brute.strip()
        if bloc is None:
            if BLOC_AUTH_DEBUT.fullmatch(ligne):
                if trouve:
                    raise Echec(T("Un seul bloc <auth-user-pass> est accepté.", "Only one <auth-user-pass> block is accepted."))
                bloc, trouve = [], True
                sortie.append("auth-user-pass")
            else:
                sortie.append(brute)
        elif BLOC_AUTH_FIN.fullmatch(ligne):
            lignes = [x.rstrip("\r") for x in bloc]
            if len(lignes) != 2 or not lignes[0].strip() or not lignes[1]:
                raise Echec(T("Le bloc <auth-user-pass> doit avoir deux lignes : l'identifiant, puis le mot de passe (qui ne peut pas contenir de saut de ligne, de retour chariot ni de caractère nul).",
                              "The <auth-user-pass> block must have two lines: the username, then the password (which cannot contain a line break, a carriage return or a NUL character)."))
            ident, mdp = lignes[0].strip(), lignes[1]
            if re.search(r"[,\\\x00-\x1f\x7f]", ident):
                raise Echec(T("L'identifiant du bloc <auth-user-pass> contient un caractère non accepté (virgule, antislash ou caractère de contrôle).",
                              "The username in the <auth-user-pass> block contains an unsupported character (comma, backslash or control character)."))
            if re.search(r"[\x00-\x1f\x7f]", mdp):
                raise Echec(T("Le mot de passe du bloc <auth-user-pass> contient un saut de ligne, un retour chariot, un caractère nul ou un autre caractère de contrôle : import refusé.",
                              "The password in the <auth-user-pass> block contains a line break, a carriage return, a NUL or another control character: import refused."))
            bloc, fin = None, (ident, mdp)
        else:
            bloc.append(brute)
    if bloc is not None:
        raise Echec(T("Le bloc <auth-user-pass> n'est pas fermé.", "The <auth-user-pass> block is not closed."))
    if not trouve:
        return texte, None, None
    return "\n".join(sortie) + "\n", fin[0], fin[1]


# Certificats donnés par un chemin relatif : lus depuis le dossier du .ovpn, mis EN LIGNE (<ca>…</ca>) dans la copie
DIRECTION = ("tls-auth", "secret")     # ces deux directives peuvent porter un sens (0 ou 1) : il devient « key-direction N »


def chemin_relatif_sur(dossier, arg):
    """Le chemin absolu de `arg` (relatif) depuis `dossier`, ou Echec. Confiné au dossier du .ovpn (sous-dossiers permis,
    comme les paquets des fournisseurs) : un « ../../.ssh/… » d'un fichier téléchargé ferait copier une clé de l'utilisateur
    dans la connexion ; vérifié à chaque « .. », avant toute lecture. Chaque dossier traversé doit être lisible et traversable,
    et aucun lien n'est suivi."""
    base = os.path.normpath(os.path.abspath(dossier))
    sort = Echec(T(f"Le chemin « {arg} » sort du dossier du profil : refusé. Donne un chemin complet, ou mets le fichier à côté du profil.",
                   f"The path \"{arg}\" leaves the profile's folder: refused. Give a full path, or put the file next to the profile."))
    cur = base
    parties = [x for x in arg.split("/") if x not in ("", ".")]
    for i, part in enumerate(parties):
        if part == ".." and cur == base:
            raise sort
        if not os.access(cur, os.R_OK | os.X_OK):        # « .. » compris : pas de détour par un dossier qu'il ne peut pas ouvrir
            raise Echec(T(f"Le chemin « {arg} » passe par un dossier que tu ne peux pas ouvrir.", f"The path \"{arg}\" goes through a folder you cannot open."))
        if part == "..":
            cur = os.path.dirname(cur)
            continue
        cur = os.path.join(cur, part)
        if i < len(parties) - 1 and stat.S_ISLNK(os.lstat(cur).st_mode if os.path.lexists(cur) else 0):
            raise Echec(T(f"Le chemin « {arg} » passe par un lien symbolique : refusé.", f"The path \"{arg}\" goes through a symbolic link: refused."))
    if os.path.commonpath([base, cur]) != base:
        raise sort
    return cur


# Étiquettes PEM permises pour un VPN (certificats, clés, CRL, clé statique OpenVPN, paramètres DH) : une clé SSH ou PGP n'a
# rien à faire dans un profil VPN et n'est jamais recopiée
PEM_PERMIS = ("CERTIFICATE", "TRUSTED CERTIFICATE", "X509 CRL", "PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY",
              "ENCRYPTED PRIVATE KEY", "OpenVPN Static key V1", "DH PARAMETERS")


def lire_pem(mot, chemin):
    """Le texte PEM d'un certificat ou d'une clé (blocs -----BEGIN … -----END seulement), 64 Kio au plus."""
    try:
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        raise Echec(T(f"Le fichier « {mot} » est introuvable ou illisible.", f"The \"{mot}\" file is not found or unreadable."))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Echec(T(f"« {mot} » n'est pas un fichier ordinaire.", f"\"{mot}\" is not a regular file."))
        donnees = b""
        while len(donnees) <= MAX_OCTETS:
            bloc = os.read(fd, MAX_OCTETS + 1 - len(donnees))
            if not bloc:
                break
            donnees += bloc
    except OSError:
        raise Echec(T(f"Le fichier « {mot} » est illisible.", f"The \"{mot}\" file is unreadable."))
    finally:
        os.close(fd)
    if len(donnees) > MAX_OCTETS:
        raise Echec(T(f"Le fichier « {mot} » est trop gros (64 Kio au plus).", f"The \"{mot}\" file is too big (64 KiB at most)."))
    pas_pem = Echec(T(f"Le fichier « {mot} » n'est pas un PEM texte (-----BEGIN … -----END) : un pkcs12 ou un fichier binaire ne peut pas être mis dans le fichier. Convertis-le en PEM.",
                      f"The \"{mot}\" file is not a text PEM (-----BEGIN … -----END): a pkcs12 or binary file cannot be put into the file. Convert it to PEM."))
    try:
        texte = donnees.decode("utf-8")
    except UnicodeDecodeError:
        raise pas_pem
    if re.search(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", texte):
        raise pas_pem
    sortie, dedans, etiquette = [], False, ""
    for brute in texte.splitlines():
        ligne = brute.strip()
        m = re.fullmatch(r"-----BEGIN ([A-Za-z0-9 ]+)-----", ligne)
        if m:
            if dedans:
                raise pas_pem
            if m.group(1) not in PEM_PERMIS:
                raise Echec(T(f"Le fichier « {mot} » contient « {m.group(1)[:40]} », qui n'est pas un certificat ni une clé de VPN : refusé.",
                              f"The \"{mot}\" file contains \"{m.group(1)[:40]}\", which is not a VPN certificate or key: refused."))
            etiquette = m.group(1)
            dedans = True
        if dedans:
            if ligne.startswith("<"):                 # ne jamais laisser le fichier fermer notre bloc et ajouter des directives
                raise pas_pem
            sortie.append(ligne)
        m = re.fullmatch(r"-----END ([A-Za-z0-9 ]+)-----", ligne)
        if m:
            if not dedans or m.group(1) != etiquette:
                raise pas_pem
            dedans = False
    if dedans or not sortie:
        raise pas_pem
    return "\n".join(sortie) + "\n"


def mettre_en_ligne(texte, dossier):
    """Remplace chaque certificat donné par un chemin relatif (ca, cert, key, tls-auth, tls-crypt…) par un bloc <ca>…</ca>
    contenant le PEM du fichier, lu depuis `dossier`. Les chemins complets et « [inline] » sont laissés tels quels."""
    sortie, ferme = [], None
    for brute in texte.splitlines():
        ligne = brute.strip()
        if ferme is not None:                          # à l'intérieur d'un bloc <…> : recopié tel quel (verifier le relira)
            sortie.append(brute)
            if re.fullmatch(r"<\s*/\s*" + ferme + r"\s*>", ligne, re.I):
                ferme = None
            continue
        ouvre = re.fullmatch(r"<\s*([A-Za-z0-9_-]+)\s*>", ligne)
        if ouvre:
            ferme = re.escape(ouvre.group(1))
            sortie.append(brute)
            continue
        m = re.match(r"-{0,2}([A-Za-z][A-Za-z0-9_-]*)(?=$|[\s=])\s*(.*)$", ligne.replace('"', "").replace("'", "")) if ligne and ligne[0] not in "#;" else None
        if not m or m.group(1).lower() not in OVPN_FICHIERS:
            sortie.append(brute)
            continue
        mot = m.group(1).lower()
        try:
            jetons = shlex.split(ligne, comments=False)
        except ValueError:
            sortie.append(brute)                        # guillemets mal fermés : verifier tranchera
            continue
        if jetons and jetons[0].lstrip("-").lower() != mot or len(jetons) < 2:
            sortie.append(brute)
            continue
        arg = jetons[1]
        if arg == "[inline]" or arg.startswith("/"):
            sortie.append(brute)
            continue
        if mot == "pkcs12":
            raise Echec(T("Le certificat « pkcs12 » donné par un chemin relatif est un fichier binaire : il ne peut pas être mis dans le fichier. Convertis-le en PEM (blocs <ca>, <cert>, <key>) ou donne un chemin complet.",
                          "The \"pkcs12\" certificate given by a relative path is a binary file: it cannot be put into the file. Convert it to PEM (<ca>, <cert>, <key> blocks) or give a full path."))
        extra = jetons[2:]
        if mot in DIRECTION and len(extra) == 1 and extra[0] in ("0", "1"):
            sens = extra[0]
        elif extra:
            raise Echec(T(f"La directive « {mot} » a des arguments en plus du fichier : donne-lui seulement le fichier, ou mets le certificat dans le fichier.",
                          f"The \"{mot}\" directive has extra arguments after the file: give it the file only, or put the certificate into the file."))
        else:
            sens = None
        chemin = chemin_relatif_sur(dossier, arg)
        fichier_lisible(mot, chemin)
        sortie.append(f"<{mot}>")
        sortie.extend(lire_pem(mot, chemin).splitlines())
        sortie.append(f"</{mot}>")
        if sens is not None:
            sortie.append("key-direction " + sens)
    return "\n".join(sortie) + "\n"


def trousseau_dispo():
    return shutil.which("secret-tool") is not None


def attributs_nm(uuid):
    return ["xdg:schema", SCHEMA_NM, "connection-uuid", uuid, "setting-name", "vpn", "setting-key", "password"]


def lire_secret(uuid):
    """Le mot de passe du trousseau pour cette connexion, ou None (trousseau absent, fermé, entrée absente). Les arguments de
    secret-tool n'ont pas de secret ; il arrive sur sa sortie, jamais journalisée."""
    if not trousseau_dispo():
        return None
    try:
        r = subprocess.run(["secret-tool", "lookup"] + attributs_nm(uuid), capture_output=True, timeout=30,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C"))
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout:
        return None
    try:
        mdp = r.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if re.search("[\x00-\x1f\x7f\x85\u2028\u2029]", mdp):       # le passwd-file est d'une ligne par secret : \n, \r ou NUL en injecteraient une autre
        raise Echec(T("Le mot de passe du trousseau contient un saut de ligne ou un caractère de contrôle : connexion refusée. Réimporte le profil.",
                      "The keyring password contains a line break or a control character: connection refused. Import the profile again."))
    return mdp


def service_secret():
    """True / False : un service Secret (org.freedesktop.secrets) tourne ou peut être lancé par le bus de session ; None : on ne
    peut pas le savoir (ni gdbus ni busctl). Ne démarre rien : on interroge seulement le bus, avec un délai court."""
    env = dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C")
    nom = "org.freedesktop.secrets"
    if shutil.which("gdbus"):
        base = ["gdbus", "call", "--session", "--timeout", "3", "--dest", "org.freedesktop.DBus", "--object-path", "/org/freedesktop/DBus", "--method"]
        essais = [(base + ["org.freedesktop.DBus.NameHasOwner", nom], lambda o: "true" in o),
                  (base + ["org.freedesktop.DBus.ListActivatableNames"], lambda o: "'" + nom + "'" in o)]
    elif shutil.which("busctl"):
        base = ["busctl", "--user", "--timeout=3", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus"]
        essais = [(base + ["NameHasOwner", "s", nom], lambda o: o.split()[-1:] == ["true"]),
                  (base + ["ListActivatableNames"], lambda o: '"' + nom + '"' in o)]
    else:
        return None
    reponse = False
    for args, ok in essais:
        try:
            r = subprocess.run(args, capture_output=True, text=True, errors="replace", timeout=5, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0:
            reponse = True
            if ok(r.stdout):
                return True
    return False if reponse else None


def mot_de_passe_agent_owned(uuid):
    """Vrai si la connexion VPN garde son mot de passe chez un agent (password-flags=1)."""
    code, out, _ = nmcli(["-t", "-g", "vpn.data", "connection", "show", "uuid", uuid])
    return code == 0 and re.search(r"(^|[\s,])password-flags\s*=\s*1\s*(,|$)", out.strip().replace("\\", "")) is not None


def garder_secret(uuid, mdp):
    """Range le mot de passe dans le trousseau (service Secret du bus de session), avec les attributs que NetworkManager
    lit pour ce VPN. Le secret passe par l'entrée standard de secret-tool, jamais par ses arguments."""
    args = ["secret-tool", "store", "--label=" + "NetworkManager VPN " + uuid] + attributs_nm(uuid)
    try:
        r = subprocess.run(args, input=mdp.encode("utf-8"), capture_output=True, timeout=60,
                           env=dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C"))
    except subprocess.TimeoutExpired:
        raise Echec(T("Le trousseau n'a pas répondu à temps (est-il verrouillé ?) : import annulé.",
                      "The keyring did not answer in time (is it locked?): import cancelled."))
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("secret-tool n'a pas pu être lancé : import annulé.", "secret-tool could not be run: import cancelled."))
    if r.returncode != 0:
        detail = court(masquer((r.stderr or b"").decode("utf-8", "replace"), mdp))
        raise Echec(T("Le trousseau a refusé le mot de passe (service Secret absent, fermé ou refus) : import annulé.",
                      "The keyring refused the password (no Secret service, locked, or refused): import cancelled.")
                    + (" (" + detail + ")" if detail else ""))


def utilisateur():
    import getpass
    try:
        u = getpass.getuser()
    except Exception:
        u = ""
    if not re.fullmatch(r"[A-Za-z0-9._][A-Za-z0-9._-]*\$?", u or ""):
        raise Echec(T("Nom d'utilisateur introuvable.", "User name not found."))
    return u


def importer(chemin):
    nettoyer_abandonnes()
    nom, donnees = lire_fichier(chemin)
    texte = donnees.decode("utf-8", errors="replace")
    ext = os.path.splitext(nom)[1].lower()
    ident = mdp = None
    if ext == ".ovpn":
        texte, ident, mdp = extraire_auth(texte)          # le mot de passe quitte le texte ici : la copie n'en a plus
        # certificats relatifs lus depuis le dossier du .ovpn et mis en ligne ; le résultat complet repasse par verifier()
        texte = mettre_en_ligne(texte, os.path.dirname(os.path.realpath(chemin)))
        donnees = texte.encode("utf-8")
        if len(donnees) > MAX_OCTETS:
            raise Echec(T("Une fois les certificats mis dans le fichier, il dépasse 64 Kio : import refusé.",
                          "Once the certificates are put into the file, it exceeds 64 KiB: import refused."))
    typ = verifier(texte)
    if ext == ".ovpn" and typ == "wireguard":
        raise Echec(T("Un fichier .ovpn ne peut pas contenir une section WireGuard.", "An .ovpn file cannot contain a WireGuard section."))
    if not nmcli(["-t", "-f", "RUNNING", "general"])[1].strip() == "running":
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."))
    if mdp is not None and not trousseau_dispo():
        raise Echec(T("Ce fichier contient un mot de passe, à ranger dans le trousseau, mais secret-tool est absent (paquet libsecret sur Arch et Fedora, libsecret-tools sur Debian, secret-tool sur openSUSE). Import refusé.",
                      "This file holds a password, to be stored in the keyring, but secret-tool is missing (libsecret package on Arch and Fedora, libsecret-tools on Debian, secret-tool on openSUSE). Import refused."))
    if mdp is not None and service_secret() is False:
        raise Echec(T("Ce fichier contient un mot de passe, à ranger dans le trousseau, mais aucun service Secret ne répond sur le bus de la session. "
                      "Installe et lance un trousseau : gnome-keyring (Arch, Debian, Fedora, openSUSE : paquet gnome-keyring), ou KeePassXC (paquet keepassxc) "
                      "avec l'intégration Secret Service activée. Import refusé.",
                      "This file holds a password, to be stored in the keyring, but no Secret service answers on the session bus. "
                      "Install and start a keyring: gnome-keyring (Arch, Debian, Fedora, openSUSE: package gnome-keyring), or KeePassXC (package keepassxc) "
                      "with the Secret Service integration enabled. Import refused."))
    user = utilisateur()
    avant = {c["uuid"] for c in etat().get("connexions", [])}
    sur = re.sub(r"[^A-Za-z0-9._-]", "_", nom)[:60] or "vpn" + ext
    d = dossier_prive()
    copie = os.path.join(d, sur)
    try:
        fd = os.open(copie, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(donnees)
        except OSError:
            raise Echec(T("Impossible d'écrire la copie temporaire.", "Could not write the temporary copy."))
        os.chmod(copie, 0o600)
        code, out, err = nmcli(["connection", "import", "type", typ, "file", copie], delai=60)
        if code != 0:
            msg = masquer(court(err or out), mdp).replace(copie, nom).replace(d, "")
            raise Echec(T("NetworkManager a refusé l'import", "NetworkManager refused the import") + (" (" + msg + ")" if msg else "") + ".")
        m = re.search(r"\(([0-9a-fA-F-]{36})\)", out)
        u = m.group(1).lower() if m and UUID.fullmatch(m.group(1)) else ""
        if not u:                                    # message inattendu : la nouvelle connexion se trouve par différence
            nouvelles = [c["uuid"] for c in etat().get("connexions", []) if c["uuid"] not in avant]
            u = nouvelles[0] if len(nouvelles) == 1 else ""
        if not u:
            raise Echec(T("Import fait, mais la connexion n'a pas été retrouvée : règle-la dans NetworkManager.",
                          "Imported, but the connection was not found: set it up in NetworkManager."))
    finally:
        shutil.rmtree(d, ignore_errors=True)
    modif = ["connection", "modify", "uuid", u, "connection.autoconnect", "no", "connection.permissions", "user:" + user]
    if ident is not None:    # le mot de passe sera gardé par le trousseau de l'utilisateur (« agent-owned »), pas par NetworkManager
        modif += ["+vpn.data", "username=" + ident + ",password-flags=1"]
    code, _, _ = nmcli(modif)
    if code != 0:
        nmcli(["connection", "delete", "uuid", u])   # jamais une connexion importée qui se lancerait seule ou serait ouverte à tous
        raise Echec(T("Impossible de rendre la connexion privée : import annulé.", "Could not make the connection private: import cancelled."))
    if mdp is not None:
        try:
            garder_secret(u, mdp)
        except Echec:
            nmcli(["connection", "delete", "uuid", u])   # pas de connexion sans son mot de passe
            raise
    c = next((x for x in etat().get("connexions", []) if x["uuid"] == u), None)
    print(T(f"Importé : {c['nom'] if c else nom} ({u}), privé à {user}, sans connexion automatique.",
            f"Imported: {c['nom'] if c else nom} ({u}), private to {user}, no autoconnect."))


# ── Indicateur de la pilule : le tunnel réellement monté, fournisseur et pays déduits des noms, sans réseau ────────
# Table des fournisseurs (motif cherché, sans tenir compte des majuscules, dans le NOM de la connexion puis dans l'INTERFACE).
# Un client installé mais pas monté n'apparaît jamais ici : seules les connexions ACTIVES de NetworkManager sont regardées.
# Aucun motif => fournisseur vide, et la pilule ne montre que le nom de la connexion (texte brut, borné).
# Exemples de noms : « ProtonVPN FR#12 », « mullvad-fr1 », « fr123.nordvpn.com.udp ».
_D, _F = r"(?<![a-z0-9])", r"(?![a-z0-9])"
FOURNISSEURS = (
    ("Proton VPN", r"proton"),                              # interface proton0, nom « ProtonVPN FR#12 »
    # Mullvad : interface wg-mullvad, nom « mullvad-fr1 », ou nom d'un fichier du générateur WireGuard de Mullvad (« se-got-wg-001 »,
    # pays-ville-wg-numéro) importé tel quel
    ("Mullvad", r"mullvad|" + _D + r"[a-z]{2}-[a-z]{3}-(wg|ovpn|br)-[0-9]{2,3}" + _F),
    ("NordVPN", r"nordvpn|nordlynx|" + _D + r"nord" + _F),  # interface nordlynx, nom « fr123.nordvpn.com.udp »
    ("Surfshark", r"surfshark"),
    ("ExpressVPN", r"express\s*vpn|lightway"),
    ("Private Internet Access", r"private\s*internet\s*access|" + _D + r"pia" + _F),
    ("Windscribe", r"windscribe"),
    ("CyberGhost", r"cyberghost"),
    ("IVPN", _D + r"ivpn" + _F),
    ("AirVPN", r"air\s*vpn"),
)
# Codes pays ISO 3166-1 à deux lettres (une valeur doit y figurer pour devenir un pays) ; « UK » est lu comme « GB ».
ISO_PAYS = frozenset(("AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ "
                      "CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR "
                      "GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP "
                      "KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT "
                      "MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW "
                      "SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG "
                      "UM US UY UZ VA VC VE VG VI VN VU WF WS YE YT ZA ZM ZW").split())
MOTS_PAYS = re.compile(r"[^A-Za-z0-9]+")


def fournisseur_de(nom, interface):
    for libelle, motif in FOURNISSEURS:
        if re.search(motif, nom or "", re.I) or re.search(motif, interface or "", re.I):
            return libelle
    return ""


def pays_de(nom):
    """Le code pays (deux lettres, validé) d'un nom de connexion, sinon vide. Un mot compte s'il est tout en majuscules (« FR »,
    « FR#12 »), ou en minuscules suivi de chiffres (« fr1 », « fr123 »), ou s'il est le premier mot (« fr-par-wg-001 »). Les mots
    courts ordinaires (« it », « in », « no », « my »…) ne comptent donc pas au milieu d'un nom. Le préfixe « nc-vpn- » (nos propres
    profils, sans tenir compte des majuscules) est retiré d'abord : « nc-vpn-labo » ne donne plus NC, « nc-vpn-FR#12 » donne FR."""
    nom, retire = re.subn(r"^\s*nc-vpn-", "", nom or "", flags=re.I)
    mots = [m for m in MOTS_PAYS.split(nom) if m]
    # Nos profils (« nc-vpn-my-lab », « nc-vpn-de-maison ») : un premier mot de deux lettres en minuscules sans chiffres n'est un pays
    # que dans la forme fournisseur « fr-par-wg-001 » ; les majuscules (« FR#12 ») et les mots à chiffres (« fr1 ») restent lus.
    premier_ok = not retire or bool(re.match(r"[a-z]{2}-[a-z]{3}-", nom))
    for i, m in enumerate(mots):
        g = re.fullmatch(r"([A-Za-z]{2})([0-9]*)", m)
        if not g:
            continue
        lettres, chiffres = g.group(1), g.group(2)
        if not (lettres.isupper() or (lettres.islower() and (chiffres or (i == 0 and premier_ok)))):
            continue
        code = "GB" if lettres.upper() == "UK" else lettres.upper()
        if re.fullmatch(r"[A-Z]{2}", code) and code in ISO_PAYS:
            return code
    return ""


def nom_borne(nom, n=40):
    """Texte brut sans caractère de contrôle, de 40 signes au plus."""
    propre = "".join(" " if (ord(c) < 32 or 0x7f <= ord(c) < 0xa0) else c for c in (nom or "")).strip()
    return propre[:n]


def horodatages(uuids):
    """{uuid: secondes depuis l'époque} de l'activation des connexions « uuids » (champ TIMESTAMP de nmcli : la dernière
    activation réussie). Une valeur absente ou illisible n'y figure pas."""
    if not uuids:
        return {}
    code, out, _ = nmcli(["-t", "-c", "no", "-g", "UUID,TIMESTAMP", "connection", "show"])
    res = {}
    if code == 0:
        for ligne in out.splitlines():
            f = champs_nmcli(ligne)
            if len(f) == 2 and f[0].lower() in uuids and re.fullmatch(r"[0-9]{1,12}", f[1]) and 0 < int(f[1]) <= time.time() + 60:
                res[f[0].lower()] = int(f[1])
    return res


def etat_enrichi():
    """etat() + pour chaque connexion « fournisseur » et « pays » (déduits du nom, sans réseau) et, si elle est montée, « depuis »
    (secondes depuis l'époque de son activation, absent si inconnu)."""
    e = etat()
    if not e["disponible"]:
        return e
    depuis = horodatages({c["uuid"] for c in e["actives"]})
    for c in e["connexions"]:
        c["fournisseur"] = fournisseur_de(c["nom"], c["interface"])
        c["pays"] = (pays_proton_nom(c["nom"]) if c["fournisseur"] == "Proton VPN" else "") or pays_de(c["nom"])
        if c["uuid"] in depuis:
            c["depuis"] = depuis[c["uuid"]]
    return e


def nordlynx_monte():
    """Vrai si l'interface « nordlynx » existe (tunnel du client NordVPN natif, hors NetworkManager) : une simple présence dans
    /sys/class/net, aucun appel de la CLI `nordvpn`, aucun réseau. Le client la crée à la connexion et l'enlève à la déconnexion."""
    return os.path.isdir(os.path.join(SYSFS, "class", "net", "nordlynx"))


def indicateur():
    """Le tunnel ACTIF à montrer (un seul appel nmcli). Aucune géolocalisation, aucun secret, aucun débit.
    Plusieurs tunnels : un FOURNISSEUR RECONNU passe avant un profil perso (« nc-vpn-labo »), même s'il n'est pas le premier de
    NetworkManager ; à défaut, le tunnel `nordlynx` du client Nord natif (présence de l'interface seulement, pays inconnu : « NordVPN »
    seul), puis le premier tunnel de NetworkManager. « nombre » compte tous les tunnels vus.
    Sans tunnel NetworkManager monté, et seulement si la commande `mullvad` existe : l'état de l'application officielle Mullvad
    (un `mullvad status --json`, 2 s au plus). Un tunnel NetworkManager réellement monté passe toujours avant. « mullvad » dit
    seulement si l'application est installée (la pilule en tire sa veille `mullvad status listen`)."""
    e = etat()
    mv = shutil.which("mullvad") is not None
    rien = {"disponible": e["disponible"], "actif": False, "fournisseur": "", "pays": "", "nom": "", "nombre": 0, "mullvad": mv}
    actives = e.get("actives") or []
    nord = nordlynx_monte()
    if not actives and not nord:
        if mv:
            m = mullvad_etat()
            if m["connecte"]:
                return {"disponible": True, "actif": True, "fournisseur": "Mullvad", "pays": m["pays"], "nom": "Mullvad",
                        "nombre": 1, "mullvad": True}
        return rien
    nord_hors_nm = nord and not any(c["interface"] == "nordlynx" for c in actives)
    nombre = len(actives) + (1 if nord_hors_nm else 0)
    reconnue = next((c for c in actives if fournisseur_de(c["nom"], c["interface"])), None)
    if reconnue is None and nord_hors_nm:
        return {"disponible": True, "actif": True, "fournisseur": "NordVPN", "pays": "", "nom": "NordVPN", "nombre": nombre, "mullvad": mv}
    c = reconnue or actives[0]
    f = fournisseur_de(c["nom"], c["interface"])
    return {"disponible": True, "actif": True, "fournisseur": f,
            "pays": (pays_proton_nom(c["nom"]) if f == "Proton VPN" else "") or pays_de(c["nom"]),
            "nom": nom_borne(c["nom"]), "nombre": nombre, "mullvad": mv}


# ── Application officielle Mullvad (commande `mullvad`, démon mullvad-daemon ; son tunnel est hors de NetworkManager) ──────
# Option retenue : `mullvad status --json` (-j, présente dans mullvad-cli 2025.14 et dans mullvad-cli/src/cmds/status.rs du dépôt
# officiel github.com/mullvad/mullvadvpn-app). Le numéro de compte n'est JAMAIS gardé : `mullvad account get` (qui l'écrit) n'est
# lancé que pour un oui/non, sa sortie est jetée ; aucun champ de sortie gardé (seuls l'état, le pays et le nom du relais sont extraits) ; toute longue suite de chiffres vue dans un message
# est remplacée avant d'être montrée. Tout en argv, 2 s au plus pour une lecture.
def env_cli():
    """Environnement des outils lancés : anglais fixe (les phrases sont lues), ni couleur ni terminal."""
    return dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C", NO_COLOR="1", TERM="dumb")


def arreter_groupe(p):
    """SIGTERM puis, si besoin, SIGKILL à tout le groupe de processus lancé par lancer_borne."""
    for sig, attente in ((signal.SIGTERM, 0.5), (signal.SIGKILL, 2)):
        try:
            os.killpg(p.pid, sig)
        except OSError:
            break
        try:
            p.wait(timeout=attente)
            break
        except subprocess.TimeoutExpired:
            continue
    try:
        p.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def lancer_borne(argv, delai, borne=64 * 1024):
    """(code, sortie, erreur) en octets : la commande tourne dans son propre groupe, stdin fermé, et sa sortie est lue par
    morceaux ; passé `borne` octets (par flux) ou `delai` secondes, le groupe est arrêté (SIGTERM puis SIGKILL). Codes :
    124 délai dépassé, 125 sortie trop longue (le début lu est rendu), 126 lancement impossible."""
    try:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             start_new_session=True, env=env_cli())
    except (OSError, subprocess.SubprocessError):
        return 126, b"", b""
    sel = selectors.DefaultSelector()
    tampons = {p.stdout: bytearray(), p.stderr: bytearray()}
    for f in tampons:
        os.set_blocking(f.fileno(), False)
        sel.register(f, selectors.EVENT_READ)
    fin, arret = time.monotonic() + delai, 0
    try:
        while sel.get_map() and not arret:
            reste = fin - time.monotonic()
            if reste <= 0:
                arret = 124
                break
            for cle, _ in sel.select(min(reste, 0.2)):
                f = cle.fileobj
                try:
                    d = os.read(f.fileno(), 16384)
                except BlockingIOError:
                    continue
                except OSError:
                    d = b""
                if not d:
                    sel.unregister(f)
                    continue
                tampons[f] += d
                if len(tampons[f]) > borne:
                    del tampons[f][borne:]
                    arret = 125
        if arret:
            arreter_groupe(p)
        else:
            try:
                p.wait(timeout=max(0.5, fin - time.monotonic()))
            except subprocess.TimeoutExpired:
                arret = 124
                arreter_groupe(p)
    finally:
        sel.close()
        for f in tampons:
            f.close()
    return (arret or p.returncode), bytes(tampons[p.stdout]), bytes(tampons[p.stderr])


def mullvad(args, delai=2, borne=64 * 1024):
    """(code, sortie, erreur) de `mullvad` lancé en arguments, lecture bornée. 127 : commande absente."""
    exe = shutil.which("mullvad")
    if not exe:
        return 127, "", ""
    code, out, err = lancer_borne([exe] + args, delai, borne)
    return code, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")


def epure(texte):
    """Retire d'un message toute suite de 12 chiffres ou plus (même séparés par des espaces ou tirets) : un numéro de compte."""
    return re.sub(r"(?:[0-9][ -]?){12,}", "[…]", texte or "")


RELAIS = re.compile(r"(?<![a-z0-9])([a-z]{2})-[a-z]{3}-(?:wg|ovpn|br|bridge)-[0-9]{2,3}(?![a-z0-9])", re.I)


def mullvad_etat():
    """{"installe", "connecte", "pays", "hote"} d'après `mullvad status --json`. Le JSON est celui du démon (état « connected »
    sous la clé « state » ; le relais est cherché dans les textes de « details »). Sans JSON lisible, la sortie texte
    (« Connected … Relay: se-got-wg-004 ») sert de secours. Rien d'autre n'est gardé."""
    res = {"installe": shutil.which("mullvad") is not None, "connecte": False, "pays": "", "hote": ""}
    if not res["installe"]:
        return res
    code, out, _ = mullvad(["status", "--json"])
    if code != 0:
        code, out, _ = mullvad(["status"])
        if code != 0:
            return res
        res["connecte"] = bool(re.match(r"\s*connected", out, re.I))
        out_texte = out
    else:
        out_texte = ""
        try:
            d = json.loads(out)
        except ValueError:
            d = None
        if isinstance(d, dict):
            res["connecte"] = str(d.get("state", "")).lower() == "connected"
            out_texte = " ".join(chaines(d.get("details")))
        else:
            res["connecte"] = bool(re.match(r"\s*connected", out, re.I))
            out_texte = out
    if res["connecte"]:
        m = RELAIS.search(out_texte)
        if m:
            res["hote"] = m.group(0).lower()
            res["pays"] = m.group(1).upper() if m.group(1).upper() in ISO_PAYS else ""
        if not res["pays"]:
            res["pays"] = code_pays_json(out)
    return res


def chaines(v, profondeur=0):
    """Tous les textes d'une valeur JSON (au plus 4 niveaux), pour y chercher un nom de relais."""
    if profondeur > 4:
        return []
    if isinstance(v, str):
        return [v[:200]]
    if isinstance(v, dict):
        return [t for x in v.values() for t in chaines(x, profondeur + 1)]
    if isinstance(v, list):
        return [t for x in v[:20] for t in chaines(x, profondeur + 1)]
    return []


def code_pays_json(brut):
    """Un code pays à deux lettres porté par une clé « country_code » du JSON du démon, validé ; sinon vide."""
    m = re.search(r'"country_code"\s*:\s*"([A-Za-z]{2})"', brut or "")
    return m.group(1).upper() if m and m.group(1).upper() in ISO_PAYS else ""


def mullvad_agir(a):
    """connecter | deconnecter | pays CC : en arguments seulement ; CC doit être ^[a-z]{2}$ (et un code ISO)."""
    if not shutil.which("mullvad"):
        raise Echec(T("L'application Mullvad n'est pas installée.", "The Mullvad app is not installed."))
    if a == ["connecter"]:
        args, ok = ["connect"], T("Mullvad : connexion demandée.", "Mullvad: connection requested.")
    elif a == ["deconnecter"]:
        args, ok = ["disconnect"], T("Mullvad : déconnecté.", "Mullvad: disconnected.")
    elif len(a) == 2 and a[0] == "pays":
        if not re.fullmatch(r"[a-z]{2}", a[1]) or a[1].upper() not in ISO_PAYS:
            raise Echec(T("Code pays invalide (deux lettres minuscules, par exemple « fr »).", "Invalid country code (two lowercase letters, e.g. \"fr\")."))
        args, ok = ["relay", "set", "location", a[1]], T(f"Mullvad : pays choisi, {a[1]}.", f"Mullvad: country set to {a[1]}.")
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)
    verrou_changement()
    code, _, err = mullvad(args, delai=30)
    if code != 0:
        msg = filtre_secret(nettoyer_sortie(err.encode("utf-8", "replace")))
        raise Echec(T("Mullvad a refusé", "Mullvad refused") + (" (" + msg + ")" if msg else "") + ".")
    print(ok)


BORNE_RELAIS = 1024 * 1024      # `mullvad relay list` est long (tous les relais) : sa borne à elle, les autres lectures gardent 64 Kio
PAYS_RELAIS = re.compile(r"^([^\s].*?)\s+\(([a-z]{2})\)\s*$")


def mullvad_pays_json():
    """Les pays que connaît l'application (`mullvad relay list`, lignes de pays sans retrait : « Sweden (se) »), triés par nom
    traduit (le nom vient du code, jamais de la sortie de la commande), code validé. Aucun numéro de compte n'y figure. Application absente ou muette : liste vide."""
    res = []
    if shutil.which("mullvad"):
        code, out, _ = mullvad(["relay", "list"], delai=10, borne=BORNE_RELAIS)
        if code == 0:
            for ligne in nettoyer_sortie(out.encode("utf-8", "replace")).splitlines():
                m = PAYS_RELAIS.match(ligne)
                if m and m.group(2).upper() in ISO_PAYS:
                    res.append({"cc": m.group(2).upper(), "nom": nom_pays(m.group(2).upper())})
    vus, uniques = set(), []
    for x in sorted(res, key=lambda x: cle_nom(x["nom"])):
        if x["cc"] not in vus:
            vus.add(x["cc"])
            uniques.append(x)
    return {"pays": uniques[:150]}


def mullvad_compte():
    """« oui », « non », « revoque » ou None (inconnu : service arrêté, sortie illisible) d'après `mullvad account get`.
    Phrases des sources officielles (mullvad-cli/src/cmds/account.rs, fonction get) : « Not logged in on any account »,
    « The current device has been revoked », et une ligne « Mullvad account: … » quand un compte est connecté. La sortie
    contient le numéro de compte : elle est lue en mémoire (4 Kio au plus), analysée ici, puis jetée. Elle n'est ni gardée,
    ni affichée, ni journalisée, pas même tronquée."""
    code, out, err = mullvad(["account", "get"], delai=10, borne=4096)
    texte = out + "\n" + err
    if re.search(r"not logged in", texte, re.I):
        return "non"
    if re.search(r"has been revoked", texte, re.I):
        return "revoque"
    if code == 0 and re.search(r"^\s*Mullvad account:", texte, re.I | re.M):
        return "oui"
    return None


def mullvad_json():
    """L'état pour le panneau : celui de mullvad_etat(), « compte » (connecté au compte : oui, non, ou null si inconnu) et
    « revoque » (l'appareil a été révoqué : plus de compte sur cet appareil). Connecté, le compte va de soi ; déconnecté, il est
    demandé à `mullvad account get` (oui/non seulement, voir mullvad_compte)."""
    e = mullvad_etat()
    e["compte"] = None
    e["revoque"] = False
    if e["installe"] and not e["connecte"]:
        c = mullvad_compte()
        e["compte"] = None if c is None else c == "oui"
        e["revoque"] = c == "revoque"
    elif e["connecte"]:
        e["compte"] = True
    return e


# ── Fournisseurs (Nord, Proton, Mullvad) : trois états, des pays seulement quand le compte est connecté ─────────────────
# États : « absent » (commande introuvable), « sans_compte » (client installé, pas de compte connecté, ou client inutilisable
# pour une raison dite dans « probleme »), « pilote_appli » (Proton : tout se fait dans l'application officielle), « pret » (compte
# connecté). Jamais d'adresse e-mail, de numéro de compte ni de jeton :
# seul un oui/non en est tiré. Toutes les commandes en argv, stdin fermé, délai borné, sortie bornée et nettoyée (couleurs ANSI,
# retours chariot, animations d'attente). Le nom d'un client installé ne fait jamais office de fournisseur connecté.
CONTRAT_FOURNISSEURS = 1
MAX_SORTIE = 64 * 1024
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]")
# Pays : « CODE Nom anglais » (la liste de secours de Mullvad, et la table qui donne un code aux noms que la CLI de Nord liste sans code)
NOMS_PAYS = ("AD Andorra|AE United Arab Emirates|AF Afghanistan|AL Albania|AM Armenia|AO Angola|AR Argentina|AT Austria|AU Australia|"
             "AZ Azerbaijan|BA Bosnia and Herzegovina|BB Barbados|BD Bangladesh|BE Belgium|BG Bulgaria|BH Bahrain|BM Bermuda|"
             "BN Brunei Darussalam|BO Bolivia|BR Brazil|BS Bahamas|BT Bhutan|BZ Belize|CA Canada|CH Switzerland|CI Cote d'Ivoire|"
             "CL Chile|CN China|CO Colombia|CR Costa Rica|CY Cyprus|CZ Czech Republic|DE Germany|DK Denmark|DO Dominican Republic|"
             "DZ Algeria|EC Ecuador|EE Estonia|EG Egypt|ES Spain|ET Ethiopia|FI Finland|FR France|GB United Kingdom|GE Georgia|"
             "GH Ghana|GI Gibraltar|GL Greenland|GR Greece|GT Guatemala|GU Guam|HK Hong Kong|HN Honduras|HR Croatia|HU Hungary|"
             "ID Indonesia|IE Ireland|IL Israel|IM Isle of Man|IN India|IQ Iraq|IS Iceland|IT Italy|JE Jersey|JM Jamaica|JO Jordan|"
             "JP Japan|KE Kenya|KG Kyrgyzstan|KH Cambodia|KR South Korea|KW Kuwait|KZ Kazakhstan|LA Laos|LB Lebanon|LI Liechtenstein|"
             "LK Sri Lanka|LT Lithuania|LU Luxembourg|LV Latvia|MA Morocco|MC Monaco|MD Moldova|ME Montenegro|MK North Macedonia|"
             "MM Myanmar|MN Mongolia|MO Macao|MT Malta|MU Mauritius|MX Mexico|MY Malaysia|NG Nigeria|NL Netherlands|NO Norway|"
             "NP Nepal|NZ New Zealand|PA Panama|PE Peru|PH Philippines|PK Pakistan|PL Poland|PR Puerto Rico|PT Portugal|PY Paraguay|"
             "QA Qatar|RO Romania|RS Serbia|RU Russia|SA Saudi Arabia|SE Sweden|SG Singapore|SI Slovenia|SK Slovakia|SN Senegal|"
             "TH Thailand|TN Tunisia|TR Turkey|TT Trinidad and Tobago|TW Taiwan|UA Ukraine|UG Uganda|US United States|UY Uruguay|"
             "UZ Uzbekistan|VE Venezuela|VN Vietnam|ZA South Africa")
NOMS_PAYS_ALIAS = {"czechia": "CZ", "turkiye": "TR", "macau": "MO", "korea south": "KR", "brunei": "BN", "cote divoire": "CI",
                   "united states of america": "US", "usa": "US", "uk": "GB", "great britain": "GB", "russian federation": "RU"}
CODE_NOM = {x[:2]: x[3:] for x in NOMS_PAYS.split("|")}
# Mêmes codes, noms français (le nom affiché vient TOUJOURS du code ISO et de ces tables, jamais d'un nom donné par une CLI)
NOMS_PAYS_FR = ("AD Andorre|AE Émirats arabes unis|AF Afghanistan|AL Albanie|AM Arménie|AO Angola|AR Argentine|AT Autriche|AU Australie|"
                "AZ Azerbaïdjan|BA Bosnie-Herzégovine|BB Barbade|BD Bangladesh|BE Belgique|BG Bulgarie|BH Bahreïn|BM Bermudes|"
                "BN Brunei|BO Bolivie|BR Brésil|BS Bahamas|BT Bhoutan|BZ Belize|CA Canada|CH Suisse|CI Côte d'Ivoire|"
                "CL Chili|CN Chine|CO Colombie|CR Costa Rica|CY Chypre|CZ Tchéquie|DE Allemagne|DK Danemark|DO République dominicaine|"
                "DZ Algérie|EC Équateur|EE Estonie|EG Égypte|ES Espagne|ET Éthiopie|FI Finlande|FR France|GB Royaume-Uni|GE Géorgie|"
                "GH Ghana|GI Gibraltar|GL Groenland|GR Grèce|GT Guatemala|GU Guam|HK Hong Kong|HN Honduras|HR Croatie|HU Hongrie|"
                "ID Indonésie|IE Irlande|IL Israël|IM Île de Man|IN Inde|IQ Irak|IS Islande|IT Italie|JE Jersey|JM Jamaïque|JO Jordanie|"
                "JP Japon|KE Kenya|KG Kirghizistan|KH Cambodge|KR Corée du Sud|KW Koweït|KZ Kazakhstan|LA Laos|LB Liban|LI Liechtenstein|"
                "LK Sri Lanka|LT Lituanie|LU Luxembourg|LV Lettonie|MA Maroc|MC Monaco|MD Moldavie|ME Monténégro|MK Macédoine du Nord|"
                "MM Birmanie|MN Mongolie|MO Macao|MT Malte|MU Maurice|MX Mexique|MY Malaisie|NG Nigéria|NL Pays-Bas|NO Norvège|"
                "NP Népal|NZ Nouvelle-Zélande|PA Panama|PE Pérou|PH Philippines|PK Pakistan|PL Pologne|PR Porto Rico|PT Portugal|PY Paraguay|"
                "QA Qatar|RO Roumanie|RS Serbie|RU Russie|SA Arabie saoudite|SE Suède|SG Singapour|SI Slovénie|SK Slovaquie|SN Sénégal|"
                "TH Thaïlande|TN Tunisie|TR Turquie|TT Trinité-et-Tobago|TW Taïwan|UA Ukraine|UG Ouganda|US États-Unis|UY Uruguay|"
                "UZ Ouzbékistan|VE Venezuela|VN Vietnam|ZA Afrique du Sud")
CODE_NOM_FR = {x[:2]: x[3:] for x in NOMS_PAYS_FR.split("|")}


def nom_pays(cc):
    """Le nom d'un pays dans la langue du bureau, d'après son code ISO (table interne). Code hors table : le code lui-même."""
    return (CODE_NOM if EN else CODE_NOM_FR).get(cc) or CODE_NOM.get(cc) or cc


def cle_nom(nom):
    """Clé de comparaison d'un nom de pays : sans accents, sans apostrophes, en minuscules, « _ » et « - » lus comme des espaces."""
    import unicodedata
    s = unicodedata.normalize("NFKD", nom or "")
    s = "".join(c for c in s if not unicodedata.combining(c)).lower().replace("'", "").replace("’", "")
    return " ".join(re.split(r"[\s_-]+", s.strip()))


NOM_CODE = {cle_nom(n): c for c, n in CODE_NOM.items()}
NOM_CODE.update(NOMS_PAYS_ALIAS)
HOTES_NORD = ("nordaccount.com", "nordvpn.com")
SECRET_LONG = re.compile(r"[A-Za-z0-9_+/=.-]{24,}")


def filtre_secret(texte, n=200):
    """Une ligne de message d'un outil, sans URL (de rappel ou autre), sans adresse e-mail, sans longue suite de chiffres ni jeton."""
    t = (texte or "").strip().splitlines()
    t = t[0] if t else ""
    t = re.sub(r"[A-Za-z][A-Za-z0-9+.-]*://\S*", "[URL]", t)
    t = re.sub(r"[^\s@]+@[^\s@]+", "[…]", t)
    t = SECRET_LONG.sub("[…]", epure(t))
    return nom_borne(t, n)


def nettoyer_sortie(octets):
    """Texte brut d'une sortie de CLI : 64 Kio au plus, couleurs ANSI retirées, retours chariot lus comme des sauts de ligne
    (les animations d'attente en réécrivent la ligne), caractères de contrôle retirés."""
    t = ANSI.sub("", (octets or b"")[:MAX_SORTIE].decode("utf-8", errors="replace"))
    t = t.replace("\r\n", "\n").replace("\r", "\n")
    return re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", t)


def cli_fournisseur(nom, args, delai=10):
    """(code, texte propre) de la commande `nom` lancée en argv, stdin fermé. 127 : absente ; 126 : lancement impossible ;
    124 : délai dépassé (la commande est tuée : une question interactive posée à un stdin fermé ne bloque donc jamais)."""
    exe = shutil.which(nom)
    if not exe:
        return 127, ""
    code, out, err = lancer_borne([exe] + args, delai, MAX_SORTIE)
    if code in (124, 126):
        return code, ""
    return code, nettoyer_sortie(out + b"\n" + err)


def probleme_cli(code, texte):
    """Le défaut qui rend une CLI inutilisable : delai, lancement, permission, consentement, demon ; sinon vide."""
    if code == 124:
        return "delai"
    if code == 126:
        return "lancement"
    if re.search(r"permission denied", texte, re.I):
        return "permission"
    if re.search(r"\(y/n\)|we value your privacy|collect and use limited", texte, re.I):
        return "consentement"
    if re.search(r"isn'?t running|not running|connection refused|socket not found|nordvpnd", texte, re.I):
        return "demon"
    return ""


def message_probleme(fid, probleme):
    nom = {"nord": "nordvpn", "mullvad": "mullvad", "proton": "protonvpn-app"}.get(fid, fid)
    if probleme == "permission":
        return T("Ajoute ton compte au groupe nordvpn (sudo usermod -aG nordvpn $USER), puis rouvre la session.",
                 "Add your account to the nordvpn group (sudo usermod -aG nordvpn $USER), then log in again.")
    if probleme == "consentement":
        return T("Ouvre un terminal et lance nordvpn une fois : il pose une question (statistiques anonymes) à laquelle répondre.",
                 "Open a terminal and run nordvpn once: it asks a question (anonymous statistics) to answer.")
    if probleme == "demon":
        return T("Le service nordvpnd ne tourne pas (sudo systemctl enable --now nordvpnd).",
                 "The nordvpnd service is not running (sudo systemctl enable --now nordvpnd).")
    if probleme == "delai":
        return T(f"{nom} ne répond pas à temps. Si c'est la première fois, ouvre un terminal et lance {nom} une fois.",
                 f"{nom} did not answer in time. If this is the first time, open a terminal and run {nom} once.")
    return T(f"{nom} n'a pas pu être lancé.", f"{nom} could not be run.")


def fiche(fid, nom, etat_, message, pays=None, pays_actif="", connecte=False, peut_login=False, probleme="", pilotage="direct",
          pays_probleme=""):
    """Une entrée de fournisseurs-json. « pays » n'existe qu'à l'état « pret » ; « pays_probleme » (« delai » ou vide) dit pourquoi la
    liste des pays manque alors que le compte est valide."""
    f = {"id": fid, "nom": nom, "etat": etat_, "message": message}
    if etat_ == "pret":
        f["pays"] = pays or []
    f.update({"pays_actif": pays_actif if etat_ in ("pret", "pilote_appli") else "",
              "connecte": bool(connecte) and etat_ in ("pret", "pilote_appli"),
              "peut_login": bool(peut_login), "probleme": probleme, "pilotage": pilotage,
              "pays_probleme": pays_probleme if etat_ == "pret" else ""})
    return f


# ── Nord : la CLI officielle `nordvpn` (dépôt NordSecurity/nordvpn-linux, dossier cli/) ──────────────────────────────────
# Sous-commandes lues dans les sources : `account` (affiche « Account information » si connecté ; sinon « You're not logged in »
# ou une demande de reconnexion), `countries` (noms avec « _ », un par ligne quand la sortie n'est pas un terminal),
# `connect NOM`, `disconnect`, `status` (« Status: Connected », « Country: Nom »), `login` (affiche « Continue in the browser: URL »
# et ne lance pas lui-même le navigateur ; pose la question du consentement si besoin) ; socket refusé : « Permission denied… ».
# `account` affiche l'adresse e-mail : sa sortie n'est JAMAIS gardée ; seuls comptent « Account information » et l'état de
# l'abonnement (ligne « Subscription: » ou, avant, « VPN Service: », cli/cli_account.go), lu en mémoire par nord_abonnement.
def nord_exe():
    return shutil.which("nordvpn") is not None


def nord_pays_liste():
    """([{"code","nom","cli"}…], probleme) d'après `nordvpn countries`. Seuls les noms de la CLI (lettres, « _ », « ' » ou « . »)
    qui ont un code ISO connu sont gardés ; « cli » est le nom exact à redonner à `connect` (jamais montré), « nom » vient du code,
    dans la langue du bureau, et la liste est triée par ce nom."""
    code, t = cli_fournisseur("nordvpn", ["countries"], 10)
    p = probleme_cli(code, t)
    if p:
        return [], p
    res = []
    for mot in t.split():
        if not re.fullmatch(r"[A-Za-z][A-Za-z_'.-]{1,39}", mot):
            continue
        c = NOM_CODE.get(cle_nom(mot))
        if c and c not in {x["code"] for x in res}:
            res.append({"code": c, "nom": nom_pays(c), "cli": mot})
    res.sort(key=lambda x: cle_nom(x["nom"]))
    return res, ""


def nord_abonnement(t):
    """« actif », « inactif » ou « inconnu », lu dans la sortie de `account` (en mémoire seulement, jamais renvoyée). Seules les
    lignes « Subscription: » (CLI actuelle : « Active until Mar 3, 2026 » ou « Inactive ») et « VPN Service: » (anciennes
    versions : « Active (Expires on …) », « Expired ») comptent ; « Dedicated IP » et « Dedicated Server » ont la même forme et
    ne disent rien du VPN. Un refus l'emporte ; sans ligne ou avec une valeur inconnue : rien n'est confirmé."""
    vus = set()
    for v in re.findall(r"(?im)^[ \t]*(?:Subscription|VPN Service)[ \t]*:[ \t]*([^\n]{0,80})$", t):
        if re.match(r"(?:inactive|expired|not active|no subscription|none)\b", v, re.I):
            vus.add("inactif")
        elif re.match(r"active\b", v, re.I):
            vus.add("actif")
        else:
            vus.add("inconnu")
    if "inactif" in vus:
        return "inactif"
    return "actif" if vus == {"actif"} else "inconnu"


def nord_acces():
    """None si NordVPN est installé, le compte connecté ET l'abonnement VPN actif ; sinon la fiche qui dit pourquoi. Un compte
    connecté ne suffit pas : sans abonnement, `connect` échoue (« Your account has expired »). Appelé par la liste des
    fournisseurs et avant toute connexion."""
    if not nord_exe():
        return fiche("nord", "NordVPN", "absent", T("NordVPN n'est pas installé.", "NordVPN is not installed."))
    code, t = cli_fournisseur("nordvpn", ["account"], 10)
    p = probleme_cli(code, t)
    if p:
        return fiche("nord", "NordVPN", "sans_compte", message_probleme("nord", p), peut_login=p == "consentement", probleme=p)
    if code != 0 or "Account information" not in t:
        return fiche("nord", "NordVPN", "sans_compte",
                     T("NordVPN est installé, mais aucun compte n'est connecté.", "NordVPN is installed, but no account is signed in."),
                     peut_login=True)
    abo = nord_abonnement(t)
    if abo == "inactif":
        return fiche("nord", "NordVPN", "sans_compte",
                     T("Le compte NordVPN est connecté, mais son abonnement VPN est inactif ou expiré : aucun pays n'est disponible. "
                       "Renouvelle-le sur le site de NordVPN, puis rouvre cette fenêtre.",
                       "The NordVPN account is signed in, but its VPN subscription is inactive or expired: no country is available. "
                       "Renew it on the NordVPN website, then reopen this window."),
                     probleme="abonnement_inactif")
    if abo != "actif":
        return fiche("nord", "NordVPN", "sans_compte",
                     T("Le compte NordVPN est connecté, mais l'état de son abonnement VPN n'a pas pu être confirmé. "
                       "Vérifie-le avec « nordvpn account » ou dans ton compte NordVPN.",
                       "The NordVPN account is signed in, but its VPN subscription status could not be confirmed. "
                       "Check it with \"nordvpn account\" or in your NordVPN account."),
                     probleme="abonnement_inconnu")
    return None


def nord_fournisseur():
    refus = nord_acces()
    if refus:
        return refus
    pays, _ = nord_pays_liste()
    code, t = cli_fournisseur("nordvpn", ["status"], 8)
    connecte = code == 0 and re.search(r"^\s*Status:\s*Connected\s*$", t, re.I | re.M) is not None
    actif = ""
    m = re.search(r"^\s*Country:\s*(.{1,60})$", t, re.M)
    if connecte and m:
        actif = NOM_CODE.get(cle_nom(m.group(1)), "")
    return fiche("nord", "NordVPN", "pret", T("Compte NordVPN connecté.", "NordVPN account signed in."),
                 pays=[{"code": x["code"], "nom": x["nom"]} for x in pays], pays_actif=actif, connecte=connecte)


def code_pays_ok(cc):
    if not isinstance(cc, str) or not re.fullmatch(r"[A-Z]{2}", cc) or cc not in ISO_PAYS:
        raise Echec(T("Code pays invalide (deux lettres majuscules, par exemple « FR »).", "Invalid country code (two uppercase letters, e.g. \"FR\")."))
    return cc


def nord_connecter(cc):
    code_pays_ok(cc)
    if not nord_exe():
        raise Echec(T("NordVPN n'est pas installé.", "NordVPN is not installed."))
    if killswitch_etat() is True:
        raise Echec(T("Coupe d'abord le kill switch : il bloquerait NordVPN.", "Turn the kill switch off first: it would block NordVPN."),
                    "killswitch_actif")
    refus = nord_acces()                 # compte connecté et abonnement actif, revérifiés juste avant connect
    if refus:
        raise Echec(refus["message"])
    pays, p = nord_pays_liste()
    if p:
        raise Echec(message_probleme("nord", p))
    nom = next((x["cli"] for x in pays if x["code"] == cc), "")
    if not nom:
        raise Echec(T("NordVPN ne propose pas ce pays (ou aucun compte n'est connecté).", "NordVPN does not offer this country (or no account is signed in)."))
    code, t = cli_fournisseur("nordvpn", ["connect", nom], 90)
    p = probleme_cli(code, t)
    if p:
        raise Echec(message_probleme("nord", p))
    if code != 0 or re.search(r"not logged in|log in again|please log in", t, re.I):
        detail = filtre_secret(t)
        raise Echec(T("NordVPN a refusé la connexion", "NordVPN refused the connection") + (" (" + detail + ")" if detail else "") + ".")
    print(T(f"NordVPN : connexion demandée ({cc}).", f"NordVPN: connection requested ({cc})."))


def nord_deconnecter():
    if not nord_exe():
        raise Echec(T("NordVPN n'est pas installé.", "NordVPN is not installed."))
    code, t = cli_fournisseur("nordvpn", ["disconnect"], 30)
    p = probleme_cli(code, t)
    if p:
        raise Echec(message_probleme("nord", p))
    if code != 0:
        detail = filtre_secret(t)
        raise Echec(T("NordVPN a refusé", "NordVPN refused") + (" (" + detail + ")" if detail else "") + ".")
    print(T("NordVPN : déconnecté.", "NordVPN: disconnected."))


# Forme exacte acceptée, lue sur la chaîne BRUTE avant tout découpage : l'hôte est fait de lettres, chiffres et « - » séparés par
# des points et finit par nordaccount.com ou nordvpn.com ; le « % » n'est permis que dans le chemin et la requête (les paramètres
# OAuth y sont encodés) ; aucune barre oblique inverse, guillemet, apostrophe, accent grave, accolade, « | », « ^ », « < », « > »
# ni espace.
URL_NORD = re.compile(r"https://((?:[a-z0-9-]+\.)*(?:nordaccount|nordvpn)\.com)(?:[/?][^\s\\\"'`<>{}|^]*)?")


def url_nord_sure(url):
    """Vrai pour une URL https d'un domaine Nord attendu (nordaccount.com, nordvpn.com et leurs sous-domaines), sans identifiant,
    sur le port 443, sans caractère douteux. La chaîne brute est comparée d'abord à URL_NORD ; urlsplit doit ensuite lire
    EXACTEMENT le même hôte : les deux lectures ne peuvent pas diverger."""
    if not isinstance(url, str) or len(url) > 2048 or not re.fullmatch(r"[\x21-\x7e]+", url):
        return False
    m = URL_NORD.fullmatch(url)
    if not m:
        return False
    try:
        p = urllib.parse.urlsplit(url)
        h = p.hostname
        port = p.port
    except ValueError:
        return False
    return p.scheme == "https" and not p.username and not p.password and port is None and h == m.group(1)


def ouvrir(args):
    """Lance un programme à part (navigateur, application officielle), sans l'attendre ni lire sa sortie. Faux si impossible."""
    exe = shutil.which(args[0])
    if not exe:
        return False
    try:
        subprocess.Popen([exe] + args[1:], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except (OSError, subprocess.SubprocessError):
        return False
    return True


def nord_login():
    """`nordvpn login` (parcours officiel, aucun mot de passe ni jeton chez nous) : il donne une URL, ouverte avec xdg-open si
    elle est en https sur un domaine Nord. L'URL n'est jamais affichée ni journalisée."""
    if not nord_exe():
        raise Echec(T("NordVPN n'est pas installé.", "NordVPN is not installed."))
    code, t = cli_fournisseur("nordvpn", ["login"], 20)
    p = probleme_cli(code, t)
    if p:
        raise Echec(message_probleme("nord", p))
    if re.search(r"already logged in", t, re.I):
        return print(T("NordVPN : un compte est déjà connecté.", "NordVPN: an account is already signed in."))
    m = re.search(r"Continue in the browser:\s*(https://\S+)", t)
    if not m or not url_nord_sure(m.group(1)):
        raise Echec(T("NordVPN n'a pas donné d'adresse de connexion sûre : lance « nordvpn login » dans un terminal.",
                      "NordVPN did not give a safe login address: run \"nordvpn login\" in a terminal."))
    if not ouvrir(["xdg-open", m.group(1)]):
        raise Echec(T("Impossible d'ouvrir le navigateur (xdg-open) : lance « nordvpn login » dans un terminal.",
                      "Could not open the browser (xdg-open): run \"nordvpn login\" in a terminal."))
    print(T("NordVPN : la page de connexion s'ouvre dans le navigateur.", "NordVPN: the login page is opening in the browser."))


API_FOURNISSEURS = {
    "nord": {"fiche": nord_fournisseur, "connecter": nord_connecter, "deconnecter": nord_deconnecter, "login": nord_login},
}


# ── Proton : la CLI officielle `protonvpn` (paquet proton-vpn-cli, dépôt ProtonVPN/proton-vpn-cli, module proton.vpn.cli) ───
# Sources lues (version 1.0.5, lecture seule des fichiers installés, jamais lancée) :
#   - `connect --country X` : X est un code à 2 lettres (insensible à la casse) ou un nom anglais (commands/server.py, option
#     --country ; core/controller.py validate_country_input : len == 2 => code) ; nous donnons toujours le code ISO MAJUSCULE.
#   - `countries` est un GROUPE : la liste est `countries list`, un tableau « Country  Code » (tabulate « simple », nom puis code
#     en majuscules, commands/location_discovery.py) ; sans compte : « Authentication required… ».
#   - `info` : « Account: 'NOM' » (« None » sans compte) : NOM est un nom de compte, jamais gardé.
#   - `status` n'est JAMAIS lancé : il passe par get_vpn_connector (commands/server.py ; core/api.py l.121-139), donc par
#     initialize_state puis _apply_kill_switch_setting (core/vpnconnector.py l.284-306) : il RÉAPPLIQUE le réglage du kill switch
#     de Proton, ce qui, pendant un connect lancé ailleurs, peut le désactiver. Le tunnel, son serveur et son pays se lisent dans
#     NetworkManager : la connexion s'appelle « ProtonVPN NOM_DU_SERVEUR » (backend/networkmanager/core/networkmanager.py l.221,
#     _get_servername ; protocol/wireguard/wireguard.py l.153, openvpn.py l.249, protun.py l.175) et l'interface est « proton0 »
#     (VIRTUAL_DEVICE_NAME, wireguard.py l.97, openvpn.py l.201, protun.py l.129).
#   - `info` et `countries list` n'appellent pas get_vpn_connector eux-mêmes (Controller.create ne fait que get_settings ->
#     ProtonVPNAPI.load_settings, core/api.py l.218), MAIS load_settings passe par _force_protun_for_free_users ->
#     _should_force_protun_for_free_users (l.150-180) qui, pour un compte gratuit avec le drapeau PROTUN_ONLY, appelle get_vpn_connector :
#     le même effet de bord est donc possible. Ces deux commandes ne sont lancées que sur une action EXPLICITE (ouverture de l'onglet
#     Proton, fin d'un login), jamais sur un événement NetworkManager, au démarrage, par relire() ni par l'indicateur, jamais
#     pendant qu'un tunnel Proton monte (état NetworkManager « activating »), et toujours sous le verrou des changements.
#   - `signin USERNAME` : le nom est un ARGUMENT OBLIGATOIRE ; le mot de passe, le TOTP et le code de clé de sécurité sont demandés
#     par le terminal (getpass, click.prompt) : la saisie reste dans le terminal de Proton.
#   - la CLI et l'appli GTK ne tournent pas ensemble : si l'appli est sur le bus de session (proton.vpn.app.gtk), la CLI écrit
#     « Error: Proton VPN desktop app is currently running… » sur la sortie standard et sort avec le code 0 (__init__.py).
# Les sorties brutes (qui contiennent un nom de compte, une IP…) ne sont jamais affichées, journalisées ni mises en JSON : on
# n'en tire que des booléens et un code pays. Tout est en argv, stdin fermé, délai borné.
PROTON_APPLI_OUVERTE = re.compile(r"desktop app is currently running|cannot run simultaneously", re.I)
PROTON_SANS_COMPTE = re.compile(r"authentication required|sign in with", re.I)

# Proton installé en Flatpak (com.protonvpn.www, sur Flathub). Sources lues :
#   - manifeste github.com/flathub/com.protonvpn.www (com.protonvpn.www.yml) : `command: protonvpn-app` (l'appli), module
#     proton-vpn-cli (tag v1.0.5) installé par `pip3 install --prefix=${FLATPAK_DEST}` ; le setup.py de ce tag
#     (github.com/ProtonVPN/proton-vpn-cli, v1.0.5) déclare le point d'entrée « protonvpn=proton.vpn.cli:main » : la commande
#     `protonvpn` est donc dans /app/bin du Flatpak. Le manifeste ne la montre pas en toutes lettres (aucun essai réel fait ici) :
#     si elle manque, `flatpak run` échoue et l'état devient « illisible », sans rien de pire.
#   - le manifeste donne `--own-name=proton.vpn.app.gtk` à l'appli : le nom D-Bus de l'appli Flatpak est le même que celui de
#     l'appli native ; nous ne comptons pas sur la CLI du bac à sable pour le voir, nous demandons à `flatpak ps` (voir plus bas).
#   - man flatpak-info : `flatpak info [--user|--system] NOM` rend 0 si installé (la sortie est jetée) ; man flatpak-run :
#     `flatpak run [--user|--system] --command=COMMANDE APP ARGS…` ; man flatpak-ps : `flatpak ps --columns=application`.
# Ordre : la CLI native d'abord, puis le Flatpak. Aucun appel réseau ; flatpak absent : silence. Le démarrage d'un Flatpak est plus
# long (bac à sable, portails) : chaque délai de la CLI gagne DELAI_FLATPAK secondes quand elle passe par flatpak.
FLATPAK_PROTON = "com.protonvpn.www"
DELAI_FLATPAK = 15          # secondes ajoutées aux délais de la CLI quand elle tourne dans le Flatpak
DELAI_FLATPAK_LECTURE = 8   # `flatpak info` et `flatpak ps`
_FLATPAK_PORTEE = []        # mémoire du processus : [(portée, chemin de flatpak)], ("", "") si absent


def flatpak_dossiers():
    """{portée: dossier} où le Flatpak Proton s'installe : $XDG_DATA_HOME/flatpak/app/ID (défaut ~/.local/share) et
    /var/lib/flatpak/app/ID. NC_VPN_FLATPAK_USER et NC_VPN_FLATPAK_SYSTEM les remplacent (tests). Une installation système ailleurs
    (/etc/flatpak/installations.d) n'est pas vue : limite connue, voir docs/vpn-contrat.md."""
    data = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return {"--user": os.environ.get("NC_VPN_FLATPAK_USER") or os.path.join(data, "flatpak", "app", FLATPAK_PROTON),
            "--system": os.environ.get("NC_VPN_FLATPAK_SYSTEM") or os.path.join("/var/lib/flatpak/app", FLATPAK_PROTON)}


def flatpak_proton():
    """(portée, chemin de flatpak) : (« --user » ou « --system », exe) où le Flatpak Proton est installé, sinon ("", ""). Aucun
    processus tant qu'aucun des dossiers d'installation n'existe (os.path.isdir seulement) ; ensuite `flatpak info` confirme (jamais de
    réseau). Une fois par processus."""
    if _FLATPAK_PORTEE:
        return _FLATPAK_PORTEE[0]
    res = ("", "")
    exe = shutil.which("flatpak")
    if exe:
        for portee, dossier in flatpak_dossiers().items():
            if not os.path.isdir(dossier):
                continue
            code, _, _ = lancer_borne([exe, "info", portee, FLATPAK_PROTON], DELAI_FLATPAK_LECTURE)
            if code == 0:
                res = (portee, exe)
                break
    _FLATPAK_PORTEE.append(res)
    return res


def proton_cli_argv():
    """La commande de la CLI : [protonvpn] (native, prioritaire) ; sinon celle du Flatpak ; sinon None."""
    exe = shutil.which("protonvpn")
    if exe:
        return [exe]
    portee, flatpak = flatpak_proton()
    if portee:
        return [flatpak, "run", portee, "--command=protonvpn", FLATPAK_PROTON]
    return None


def proton_cli_exe():
    return proton_cli_argv() is not None


NOM_BUS_PROTON = "proton.vpn.app.gtk"


def proton_nom_bus():
    """True / False : le nom D-Bus de l'appli Proton (manifeste Flatpak : --own-name=proton.vpn.app.gtk) a un propriétaire sur le bus de
    session (`gdbus call … NameHasOwner`, argv, 3 s côté gdbus, 5 s côté nous, comme service_secret). None : gdbus absent, en erreur ou
    réponse illisible. Contrairement à `flatpak ps`, cela distingue l'appli d'une CLI du même Flatpak."""
    gdbus = shutil.which("gdbus")
    if not gdbus:
        return None
    code, out, _ = lancer_borne([gdbus, "call", "--session", "--timeout", "3", "--dest", "org.freedesktop.DBus", "--object-path",
                                 "/org/freedesktop/DBus", "--method", "org.freedesktop.DBus.NameHasOwner", NOM_BUS_PROTON], 5, 4096)
    if code != 0:
        return None
    texte = nettoyer_sortie(out).strip()
    if re.fullmatch(r"\(true,?\)", texte):
        return True
    if re.fullmatch(r"\(false,?\)", texte):
        return False
    return None


def proton_flatpak_ouvert():
    """Vrai si l'APPLI Flatpak Proton tourne : d'abord le nom D-Bus proton.vpn.app.gtk (proton_nom_bus, il a un propriétaire = ouverte) ;
    si le bus ne répond pas (gdbus absent ou en erreur), repli sur `flatpak ps --columns=application` (une ligne par instance :
    l'identifiant ; ne distingue pas l'appli d'une CLI du même Flatpak, donc plus prudent). Sortie illisible ou commande en échec :
    faux (la CLI dit elle-même si l'appli est ouverte). Rien de /proc."""
    bus = proton_nom_bus()
    if bus is not None:
        return bus
    exe = shutil.which("flatpak")
    if not exe:
        return False
    code, out, _ = lancer_borne([exe, "ps", "--columns=application"], DELAI_FLATPAK_LECTURE, 16 * 1024)
    if code != 0:
        return False
    texte = nettoyer_sortie(out)
    return any(l.split()[:1] == [FLATPAK_PROTON] for l in texte.splitlines() if l.strip())


def proton_cli(args, delai):
    """(code, texte propre) de `protonvpn ARGS` : CLI native ou Flatpak, même nettoyage et mêmes filtres que cli_fournisseur. Dans
    le Flatpak, l'appli ouverte est détectée d'abord (même résultat que le message de la CLI native : « appli ouverte »)."""
    argv = proton_cli_argv()
    if not argv:
        return 127, ""
    flatpak = len(argv) > 1
    if flatpak and proton_flatpak_ouvert():
        return 0, "Error: Proton VPN desktop app is currently running\n"
    code, out, err = lancer_borne(argv + args, delai + (DELAI_FLATPAK if flatpak else 0), MAX_SORTIE)
    if code in (124, 126):
        return code, ""
    return code, nettoyer_sortie(out + b"\n" + err)


def proton_appli_argv():
    """L'application graphique officielle : `protonvpn-app` (native) ou `flatpak run com.protonvpn.www`, sinon None."""
    exe = shutil.which("protonvpn-app")
    if exe:
        return [exe]
    portee, flatpak = flatpak_proton()
    if portee:
        return [flatpak, "run", portee, FLATPAK_PROTON]
    return None


def proton_exe():
    """L'application graphique officielle (`protonvpn-app`, ou le Flatpak)."""
    return proton_appli_argv() is not None


def proton_connexions():
    """Les connexions NetworkManager de Proton (nom « ProtonVPN … » ou interface proton0), ou None si NetworkManager est indisponible."""
    e = etat()
    if not e["disponible"]:
        return None
    return [c for c in e["connexions"] if re.match(r"\s*proton\s*vpn(\s|$)", c["nom"], re.I) or c["interface"] == "proton0"]


def pays_proton_nom(nom):
    """Le code pays d'une connexion « ProtonVPN NOM_DU_SERVEUR » (règle de proton_pays_serveur), sinon vide."""
    m = re.match(r"\s*proton\s*vpn\s+([A-Za-z0-9#-]{1,30})", nom or "", re.I)
    return proton_pays_serveur(m.group(1)) if m else ""


def proton_en_montee_strict():
    """True / False : une connexion « ProtonVPN … » est (ou n'est pas) en train de monter (état NetworkManager « activating ») ;
    None : nmcli en erreur, absent ou en délai, on ne sait pas."""
    code, out, _ = nmcli(["-t", "-c", "no", "-f", "STATE,NAME", "connection", "show", "--active"])
    if code != 0:
        return None
    for ligne in out.splitlines():
        etat_, _, nom = ligne.partition(":")
        if etat_.strip().lower() == "activating" and re.match(r"\s*proton\s*vpn(\s|$)", nom.replace("\\:", ":"), re.I):
            return True
    return False


def proton_en_montee():
    """Vrai si une connexion « ProtonVPN … » est en train de monter ; faux aussi quand on ne sait pas (garde de lecture : voir
    proton_en_montee_strict pour la version qui distingue)."""
    return proton_en_montee_strict() is True


def proton_tunnel_nm():
    """(monté, code pays, en montée) d'après NetworkManager seul : les connexions « ProtonVPN … » ACTIVES et leur nom de serveur."""
    actives = [c for c in (proton_connexions() or []) if c["active"]]
    return bool(actives), (pays_proton_nom(actives[0]["nom"]) if actives else ""), proton_en_montee()


def verrou_essai():
    """(pris, fd) : tente le verrou des changements (le même que verrou_changement) sans attendre ; l'appelant ferme fd. Pris faux
    si un autre changement le tient. Verrou impossible à créer : pris vrai, fd None (comme verrou_changement, rien n'est bloqué)."""
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if not base or not os.path.isdir(base) or os.stat(base).st_uid != os.getuid():
            return True, None
        fd = os.open(os.path.join(base, "nc-vpn.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return True, None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return False, None
    return True, fd


def proton_cache_chemin():
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if base and os.path.isdir(base) and os.stat(base).st_uid == os.getuid():
            return os.path.join(base, "nc-vpn-proton.json")
    except OSError:
        pass
    return ""


def proton_cache_lire():
    """Le dernier relevé EXPLICITE (dans le dossier d'exécution de la session, mémoire vive) : seulement {appli_ouverte, compte,
    pays (codes ISO), probleme}. Aucun nom de compte. Invalide ou absent : None."""
    chemin = proton_cache_chemin()
    if not chemin:
        return None
    try:
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, encoding="utf-8") as f:
            d = json.loads(f.read(8192))
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict) or d.get("compte") not in (True, False, None) or not isinstance(d.get("appli_ouverte"), bool) \
            or d.get("probleme", "") not in ("", "delai", "lancement", "illisible") or not isinstance(d.get("pays"), list) \
            or d.get("pays_probleme", "") not in ("", "delai"):
        return None
    return {"appli_ouverte": d["appli_ouverte"], "compte": d["compte"], "probleme": d.get("probleme", ""),
            "pays_probleme": d.get("pays_probleme", ""),
            "pays": [c for c in d["pays"][:300] if isinstance(c, str) and c in ISO_PAYS]}


def proton_cache_ecrire(r):
    chemin = proton_cache_chemin()
    if not chemin:
        return
    tmp = chemin + ".tmp%d" % os.getpid()
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"appli_ouverte": r["appli_ouverte"], "compte": r["compte"], "probleme": r["probleme"], "pays": r["pays"],
                       "pays_probleme": r["pays_probleme"]}, f)
        os.replace(tmp, chemin)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def proton_pays_liste(texte):
    """Les codes ISO du tableau de `countries list` (dernière colonne, majuscules) ; le nom vient du code, jamais de la CLI."""
    res = []
    for ligne in texte.splitlines():
        m = re.fullmatch(r"\S.{0,80}?\s{2,}([A-Z]{2})\s*", ligne)
        if m and m.group(1) in ISO_PAYS and m.group(1) not in res:
            res.append(m.group(1))
    return res


def proton_pays_serveur(nom):
    """Le code pays d'un nom de serveur Proton : « IT#23 » donne IT ; « UK#3 » donne GB. Secure Core : si le 1er segment est CH, IS ou
    SE (pays d'entrée) et le 2e un pays ISO, c'est le 2e (« CH-US#1 » donne US) ; sinon le 1er (« US-CA#12 » donne US, « US-FREE#5 »
    aussi). Vide si rien n'est lisible."""
    mots = nom.upper().split("#")[0].split("-")

    def iso(m):
        m = "GB" if m == "UK" else m
        return m if re.fullmatch(r"[A-Z]{2}", m) and m in ISO_PAYS else ""
    if len(mots) >= 2 and mots[0] in ("CH", "IS", "SE") and iso(mots[1]):
        return iso(mots[1])
    return iso(mots[0])


def delai_pays_proton():
    """20 s pour `countries list` ; NC_VPN_PROTON_DELAI_PAYS (1 à 60) ne sert qu'aux tests."""
    try:
        return min(60.0, max(1.0, float(os.environ.get("NC_VPN_PROTON_DELAI_PAYS", "20"))))
    except ValueError:
        return 20.0


def proton_lire_cli():
    """Relevé EXPLICITE de la CLI, réduit à des booléens et des codes : {"appli_ouverte", "compte" (True/False/None inconnu), "pays"
    (codes ISO), "probleme"}. `info` d'abord ; la liste des pays seulement avec un compte, et si elle dépasse son délai on s'arrête là.
    Jamais `status` (voir plus haut). L'appelant tient le verrou et a vérifié qu'aucun tunnel Proton ne monte."""
    r = {"appli_ouverte": False, "compte": None, "pays": [], "probleme": "", "pays_probleme": ""}
    code, t = proton_cli(["info"], 10)
    if code in (124, 126):
        r["probleme"] = "delai" if code == 124 else "lancement"
        return r
    if PROTON_APPLI_OUVERTE.search(t):
        r["appli_ouverte"] = True
        return r
    m = re.search(r"^\s*Account:\s*'(.*)'\s*$", t, re.M)
    if code != 0 or not m:
        r["probleme"] = "illisible"
        return r
    r["compte"] = m.group(1).strip() not in ("", "None")
    del m, t                                    # le nom de compte n'est gardé nulle part
    if not r["compte"]:
        return r
    code, t = proton_cli(["countries", "list"], delai_pays_proton())
    if code == 124:                             # délai dépassé : le compte reste valide, la liste manque (dit à l'utilisateur)
        r["pays_probleme"] = "delai"
        return r
    if PROTON_APPLI_OUVERTE.search(t):
        r["appli_ouverte"] = True
        return r
    if PROTON_SANS_COMPTE.search(t):            # la session n'est plus valable : comme sans compte
        r["compte"] = False
        return r
    if code == 0:
        r["pays"] = proton_pays_liste(t)
    return r


def proton_verifier():
    """Le relevé explicite (proton_lire_cli) s'il est permis, noté pour les lectures automatiques ; None s'il ne l'est pas : un tunnel
    Proton monte (NetworkManager « activating »), ou un autre changement tient le verrou. Dans ces cas aucune commande n'est lancée."""
    if proton_en_montee():
        return None
    pris, fd = verrou_essai()
    if not pris:
        return None
    try:
        r = proton_lire_cli()
    finally:
        if fd is not None:
            os.close(fd)
    proton_cache_ecrire(r)
    return r


def proton_msg_appli_ouverte():
    return T("Ferme l'application Proton VPN pour piloter depuis l'île : la CLI et l'application ne tournent pas ensemble.",
             "Close the Proton VPN app to drive it from the island: the CLI and the app cannot run together.")


def proton_msg_probleme(p):
    argv = proton_cli_argv() or []
    cmd = "flatpak run --command=protonvpn " + FLATPAK_PROTON + " info" if len(argv) > 1 else "protonvpn info"     # la commande à proposer
    if p == "delai":
        return T(f"protonvpn ne répond pas à temps. Si c'est la première fois, lance « {cmd} » dans un terminal.",
                 f"protonvpn did not answer in time. If this is the first time, run \"{cmd}\" in a terminal.")
    if p == "lancement":
        return T("protonvpn n'a pas pu être lancé.", "protonvpn could not be run.")
    return T(f"L'état de Proton VPN est illisible : lance « {cmd} » dans un terminal.",
             f"Proton VPN's state cannot be read: run \"{cmd}\" in a terminal.")


def proton_fiche_appli(probleme=""):
    """Sans CLI (ou CLI bloquée par l'appli ouverte) : « pilote_appli », Proton se pilote dans son application. Une connexion
    NetworkManager « ProtonVPN … » ACTIVE rend connecte vrai et donne le pays actif ; son absence ne dit rien du compte."""
    monte, actif, _ = proton_tunnel_nm()
    msg = proton_msg_appli_ouverte() if probleme == "appli_ouverte" else T(
        "Ouvre-la pour te connecter et choisir un pays ; l'île montre ensuite le tunnel, sans piloter l'application.",
        "Open it to sign in and pick a country; the island then shows the tunnel, without driving the app.")
    return fiche("proton", "Proton VPN", "pilote_appli", msg, pays_actif=actif, connecte=monte, peut_login=True, probleme=probleme,
                 pilotage="appli")


VERIFIER_PROTON = False        # vrai seulement avec « fournisseurs-json --verifier-proton » (action explicite de la fenêtre)


def proton_fournisseur():
    """CLI présente : absent / sans_compte / pret. Sans l'option explicite, AUCUNE commande protonvpn n'est lancée : l'état du compte
    et la liste des pays viennent du dernier relevé explicite (proton_cache_lire), le tunnel de NetworkManager. CLI absente mais
    appli graphique présente : pilote_appli. Ni l'une ni l'autre : absent."""
    if not proton_cli_exe():
        if proton_exe():
            return proton_fiche_appli()
        return fiche("proton", "Proton VPN", "absent", T("Proton VPN n'est pas installé.", "Proton VPN is not installed."), pilotage="appli")
    c = (proton_verifier() if VERIFIER_PROTON else None) or proton_cache_lire()
    if c is None:
        return fiche("proton", "Proton VPN", "sans_compte",
                     T("Le compte Proton VPN n'est pas encore vérifié : ouvre l'onglet Proton VPN.",
                       "The Proton VPN account is not checked yet: open the Proton VPN tab."), probleme="non_verifie")
    if c["appli_ouverte"]:
        return proton_fiche_appli("appli_ouverte")
    if c["probleme"]:
        return fiche("proton", "Proton VPN", "sans_compte", proton_msg_probleme(c["probleme"]), probleme=c["probleme"])
    if c["compte"] is False:
        return fiche("proton", "Proton VPN", "sans_compte",
                     T("Proton VPN est installé, mais aucun compte n'est connecté.", "Proton VPN is installed, but no account is signed in."),
                     peut_login=True)
    monte, pays_nm, _ = proton_tunnel_nm()
    pays = sorted(({"code": x, "nom": nom_pays(x)} for x in c["pays"]), key=lambda x: cle_nom(x["nom"]))
    return fiche("proton", "Proton VPN", "pret", T("Compte Proton VPN connecté.", "Proton VPN account signed in."), pays=pays,
                 pays_actif=pays_nm, connecte=monte, pays_probleme=c["pays_probleme"])


def proton_ouvrir(message):
    if not proton_exe():
        raise Echec(T("Proton VPN n'est pas installé.", "Proton VPN is not installed."))
    argv = proton_appli_argv()
    if not argv or not ouvrir(argv):
        raise Echec(T("Impossible de lancer l'application Proton VPN.", "Could not start the Proton VPN app."))
    print(message)


def proton_aucun_tunnel_nm():
    """Vrai SEULEMENT si NetworkManager répond et ne montre aucune connexion Proton active ou en montée (lecture bornée par nmcli ;
    3 essais, une seconde entre deux, le temps que la déconnexion soit prise en compte). NetworkManager muet, absent ou en erreur :
    faux (on ne confirme jamais sur une absence de réponse)."""
    for essai in range(3):
        actives = proton_connexions()
        if actives is None:
            return False
        if not [c for c in actives if c["active"]]:
            montee = proton_en_montee_strict()
            if montee is None:                  # nmcli muet ou en erreur au second appel : pas confirmé
                return False
            if not montee:
                return True
        if essai < 2:
            time.sleep(1)
    return False


def proton_cli_agir(args, delai, succes, confirme_par_nm=False):
    """Lance `protonvpn ARGS` et ne rend la main que si le code est 0 et que la sortie contient `succes` (motif en début de ligne).
    Exception (confirme_par_nm, la déconnexion) : le message de succès avec un code NON nul n'est un succès que si NetworkManager
    confirme ensuite qu'aucun tunnel Proton n'est actif (proton_aucun_tunnel_nm) ; sinon c'est un refus.
    Sinon un message prévu à l'avance : la sortie brute n'est JAMAIS reprise (elle peut porter une IP, un nom de compte)."""
    code, t = proton_cli(args, delai)
    if code == 124:
        raise Echec(proton_msg_probleme("delai"))
    if code == 126:
        raise Echec(proton_msg_probleme("lancement"))
    if PROTON_APPLI_OUVERTE.search(t):
        raise Echec(proton_msg_appli_ouverte())
    if re.search(succes, t, re.M) and (code == 0 or (confirme_par_nm and proton_aucun_tunnel_nm())):
        return
    if PROTON_SANS_COMPTE.search(t):
        raise Echec(T("Aucun compte Proton VPN n'est connecté : utilise « Se connecter au compte ».",
                      "No Proton VPN account is signed in: use \"Log in to the account\"."))
    if re.search(r"free plan", t, re.I):
        raise Echec(T("Le choix du pays demande un abonnement Proton VPN payant.", "Choosing a country needs a paid Proton VPN plan."))
    if re.search(r"invalid country|no servers found", t, re.I):
        raise Echec(T("Proton VPN ne propose pas ce pays.", "Proton VPN does not offer this country."))
    if re.search(r"2FA Required", t):
        raise Echec(T("Proton VPN demande une authentification de sécurité supplémentaire : ouvre l'application Proton VPN.",
                      "Proton VPN asks for an extra security authentication: open the Proton VPN app."))
    raise Echec(T("Proton VPN a refusé la demande.", "Proton VPN refused the request."))


def proton_connecter(cc):
    code_pays_ok(cc)
    if proton_cli_exe():
        if killswitch_etat() is True:
            raise Echec(T("Coupe d'abord le kill switch : il bloquerait Proton VPN.", "Turn the kill switch off first: it would block Proton VPN."),
                        "killswitch_actif")
        proton_cli_agir(["connect", "--country", cc], 90, r"^Connected to ")
        return print(T(f"Proton VPN : connexion demandée ({cc}).", f"Proton VPN: connection requested ({cc})."))
    proton_ouvrir(T(f"Proton VPN : l'application officielle s'ouvre, choisis le pays ({cc}) et connecte-toi dedans.",
                    f"Proton VPN: the official app is opening, pick the country ({cc}) and connect there."))


def proton_deconnecter():
    if proton_cli_exe():
        proton_cli_agir(["disconnect"], 30, r"^Disconnected\.", confirme_par_nm=True)
        return print(T("Proton VPN : déconnecté.", "Proton VPN: disconnected."))
    proton_ouvrir(T("Proton VPN : l'application officielle s'ouvre, déconnecte-toi dedans (nous ne la fermons ni ne la pilotons jamais).",
                    "Proton VPN: the official app is opening, disconnect there (we never close or drive it)."))


# Dans la fenêtre du terminal : la ligne est lue par le shell du terminal puis donnée à `protonvpn signin` ; le mot de passe, le
# code TOTP ou la clé de sécurité sont demandés par Proton lui-même. Rien de ce script n'est composé avec une valeur variable
# (le message et le chemin de la CLI sont des arguments positionnels).
SCRIPT_SIGNIN = 'printf "%s " "$1"; IFS= read -r u && [ -n "$u" ] && "$2" signin -- "$u"'


def proton_login():
    """L'appli officielle si elle est installée (ouverte, détachée) ; sinon une fenêtre kitty qui lance `protonvpn signin` : la saisie
    (nom de compte, mot de passe, TOTP) se fait dans le terminal de Proton, jamais chez nous. On attend la fermeture de la fenêtre
    (comme nc-assistant-install) : l'île relit l'état ensuite."""
    # L'appli native d'abord (comme avant). L'appli Flatpak seulement si la CLI vient du Flatpak ou si seule elle existe : la session de
    # compte de la CLI native et celle du Flatpak ne sont pas forcément partagées, avec la CLI native on garde la fenêtre kitty.
    if shutil.which("protonvpn-app") or (not shutil.which("protonvpn") and proton_exe()):
        return proton_ouvrir(T("Proton VPN : l'application officielle s'ouvre, connecte ton compte dedans.",
                               "Proton VPN: the official app is opening, sign in to your account there."))
    exe = shutil.which("protonvpn")           # la fenêtre de connexion ne sert qu'avec la CLI native (le Flatpak a son appli, prise plus haut)
    if not exe:
        raise Echec(T("Proton VPN n'est pas installé.", "Proton VPN is not installed."))
    kitty = shutil.which("kitty")
    if not kitty:
        raise Echec(T("kitty est introuvable : dans un terminal, lance « protonvpn signin ton-nom-de-compte ».",
                      "kitty not found: in a terminal, run \"protonvpn signin your-account-name\"."))
    invite = T("Nom de compte Proton :", "Proton account name:")
    try:
        r = subprocess.run([kitty, "--hold", "--title", "Proton VPN : " + T("connexion au compte", "account sign-in"), "sh", "-c",
                            SCRIPT_SIGNIN, "sh", invite, exe],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("Impossible d'ouvrir kitty : dans un terminal, lance « protonvpn signin ton-nom-de-compte ».",
                      "Could not open kitty: in a terminal, run \"protonvpn signin your-account-name\"."))
    if r.returncode != 0:
        raise Echec(T("La fenêtre de connexion s'est mal terminée.", "The sign-in window ended badly."))
    print(T("Proton VPN : fenêtre de connexion fermée, l'état est relu.", "Proton VPN: sign-in window closed, the state is read again."))


API_FOURNISSEURS["proton"] = {"fiche": proton_fournisseur, "connecter": proton_connecter, "deconnecter": proton_deconnecter,
                              "login": proton_login}


# ── Mullvad dans les fournisseurs (même application que `nc-vpn mullvad …`) ───────────────────────────────────────────────
# Sources (dépôt mullvad/mullvadvpn-app, mullvad-cli/src/cmds/account.rs) : `account get` écrit « Not logged in on any account »,
# « The current device has been revoked » ou, connecté, une ligne « Mullvad account: <numéro> » (code de sortie 0 dans les trois
# cas). Le numéro y figure : la sortie est analysée en mémoire puis jetée (mullvad_compte). `status` n'affiche PAS d'avertissement
# de compte quand il est déconnecté. `relay list` écrit une ligne par pays sans retrait, « Nom (code) » en minuscules, puis les
# villes et les relais en retrait (relay.rs). `relay set location CC`, `connect`, `disconnect`.
def mullvad_pays_liste():
    """([{"code","nom"}…], source) : les pays de `mullvad relay list` ; à défaut (commande en échec, rien de lisible), la liste
    ISO intégrée (« defaut »). Les noms sont bornés, en texte brut."""
    code, out, _ = mullvad(["relay", "list"], delai=10, borne=BORNE_RELAIS)
    res = []
    if code == 0:
        for ligne in nettoyer_sortie(out.encode("utf-8", "replace")).splitlines():
            m = re.fullmatch(r"([^\s(][^()\t]{0,58}?)\s+\(([a-z]{2})\)\s*", ligne)
            if m and m.group(2).upper() in ISO_PAYS and m.group(2).upper() not in {x["code"] for x in res}:
                res.append({"code": m.group(2).upper(), "nom": nom_pays(m.group(2).upper())})
    if res:
        return sorted(res, key=lambda x: cle_nom(x["nom"])), "relay"
    return sorted(({"code": c, "nom": nom_pays(c)} for c in CODE_NOM), key=lambda x: cle_nom(x["nom"])), "defaut"


def mullvad_fournisseur():
    if not shutil.which("mullvad"):
        return fiche("mullvad", "Mullvad", "absent", T("Mullvad n'est pas installé.", "Mullvad is not installed."))
    e = mullvad_json()
    if e["compte"] is None:
        return fiche("mullvad", "Mullvad", "sans_compte",
                     T("L'état de Mullvad est illisible : le service mullvad-daemon tourne-t-il ?",
                       "Mullvad's state cannot be read: is the mullvad-daemon service running?"), probleme="demon")
    if e["revoque"]:
        return fiche("mullvad", "Mullvad", "sans_compte",
                     T("Cet appareil a été révoqué : reconnecte-toi à ton compte dans l'application Mullvad.",
                       "This device has been revoked: sign in to your account again in the Mullvad app."),
                     peut_login=True, probleme="revoque")
    if e["compte"] is False:
        return fiche("mullvad", "Mullvad", "sans_compte",
                     T("Mullvad est installé, mais aucun compte n'est connecté.", "Mullvad is installed, but no account is signed in."),
                     peut_login=True)
    pays, _ = mullvad_pays_liste()
    return fiche("mullvad", "Mullvad", "pret", T("Compte Mullvad connecté.", "Mullvad account signed in."), pays=pays,
                 pays_actif=e["pays"] if e["connecte"] else "", connecte=e["connecte"])


def mullvad_connecter(cc):
    code_pays_ok(cc)
    if not shutil.which("mullvad"):
        raise Echec(T("Mullvad n'est pas installé.", "Mullvad is not installed."))
    mullvad_agir(["pays", cc.lower()])
    mullvad_agir(["connecter"])


def mullvad_deconnecter():
    mullvad_agir(["deconnecter"])


def mullvad_login():
    """Jamais de numéro de compte chez nous : on ouvre l'application graphique (`mullvad-vpn`), sinon on dit quoi lancer."""
    if not shutil.which("mullvad"):
        raise Echec(T("Mullvad n'est pas installé.", "Mullvad is not installed."))
    if shutil.which("mullvad-vpn") and ouvrir(["mullvad-vpn"]):
        return print(T("Mullvad : l'application s'ouvre, connecte ton compte dedans.", "Mullvad: the app is opening, sign in there."))
    raise Echec(T("Dans un terminal, lance : mullvad account login (le numéro de compte se tape là, jamais ici).",
                  "In a terminal, run: mullvad account login (the account number is typed there, never here)."))


API_FOURNISSEURS["mullvad"] = {"fiche": mullvad_fournisseur, "connecter": mullvad_connecter, "deconnecter": mullvad_deconnecter,
                               "login": mullvad_login}


# ── Installer le client d'un fournisseur absent (V6c) ───────────────────────────────────────────────────────────────────────
# Le plan (voie automatique ou parcours guidé) vient du script fixe du dépôt, `nc-vpn-installer ID --plan` (ni réseau ni root).
# Sa sortie est relue avec une liste blanche stricte : mode connu, lien https vers un site officiel connu, lignes de texte aux
# caractères sûrs. Rien d'autre n'est relayé tel quel dans l'île.
INSTALLEUR_IDS = ("nord", "proton", "mullvad")
INSTALLEUR_HOTES = ("protonvpn.com", "mullvad.net", "support.nordvpn.com")
INSTALLEUR_LIEN = re.compile(r"https://([a-z0-9.-]+)/[A-Za-z0-9._~/%?=&-]{0,200}")
INSTALLEUR_TEXTE = re.compile(r"[\w .,;:'’\"()/$«»…!?+=-]{1,300}")


# Variables qui changeraient ce que le script root-adjacent lit ou lance : retirées avant d'ouvrir le terminal. Le PATH y est fixe.
INSTALLEUR_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
INSTALLEUR_RETIRE = ("BASH_ENV", "ENV", "CDPATH", "GLOBIGNORE", "SHELLOPTS", "BASHOPTS", "PS4", "IFS", "GNUPGHOME", "CURL_HOME", "CURL_CA_BUNDLE",
                     "SSL_CERT_FILE", "SSL_CERT_DIR", "NC_OS_RELEASE", "NC_INSTALLER_TEST", "NC_TEST_EMPREINTE", "NC_TEST_CACHE",
                     "NC_TEST_APT_DIR", "NC_TEST_YUM_DIR")


def installeur_env():
    """Environnement du terminal d'installation : celui de la session, sans BASH_ENV, ENV, LD_*, BASH_FUNC_* ni variables de test,
    avec un PATH fixe et la langue du bureau."""
    env = {k: v for k, v in os.environ.items()
           if k not in INSTALLEUR_RETIRE and not k.startswith(("LD_", "BASH_FUNC_", "NC_TEST_", "CURL_"))}
    env["PATH"] = INSTALLEUR_PATH
    env["NC_LANGUE"] = "en" if EN else "fr"
    return env


def installeur_chemin():
    """Le script fixe du dépôt, installé à côté de ~/.local/bin (…/libexec/nc-vpn-installer), ou None."""
    p = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "libexec", "nc-vpn-installer")
    return p if os.path.isfile(p) else None


def installation_plan(fid):
    """{"mode": "auto" | "guide", "lien": str, "etapes": [str]} d'après `nc-vpn-installer ID --plan`, ou None (script absent, réponse
    illisible ou refusée par la liste blanche)."""
    exe = installeur_chemin()
    bash = shutil.which("bash")
    if fid not in INSTALLEUR_IDS or not exe or not bash:
        return None
    code, out, _ = lancer_borne([bash, exe, fid, "--plan"], 5, 8 * 1024)
    if code != 0:
        return None
    mode, lien, etapes = "", "", []
    for ligne in out.decode("utf-8", "replace").splitlines():
        cle, _, val = ligne.partition("=")
        if cle == "mode" and val in ("auto", "guide"):
            mode = val
        elif cle == "lien":
            m = INSTALLEUR_LIEN.fullmatch(val)
            if m and m.group(1) in INSTALLEUR_HOTES:
                lien = val
        elif cle == "etape" and INSTALLEUR_TEXTE.fullmatch(val) and "$(" not in val and len(etapes) < 8:
            etapes.append(val)
    if not mode or not lien or (mode == "guide" and not etapes):
        return None
    return {"mode": mode, "lien": lien, "etapes": etapes if mode == "guide" else []}


def fournisseurs_json():
    res = []
    for a in API_FOURNISSEURS.values():
        f = a["fiche"]()
        if f.get("etat") == "absent":                # « Installer » / « Voir comment installer » : seulement pour un client absent
            plan = installation_plan(f.get("id"))
            if plan:
                f["installation"] = plan
        res.append(f)
    return {"contrat": CONTRAT_FOURNISSEURS, "fournisseurs": res}


def installer_client(fid):
    """nc-vpn installer-client ID : ouvre une fenêtre kitty qui lance le script fixe du dépôt (étapes visibles, sudo demande lui-même
    le mot de passe dans ce terminal, aucune règle sudoers). Jamais lancé automatiquement ; refusé si le client est déjà là. On attend
    la fermeture de la fenêtre (l'appelant relit alors l'état)."""
    if fid not in INSTALLEUR_IDS:
        raise Echec(T("Fournisseur inconnu.", "Unknown provider."))
    f = API_FOURNISSEURS[fid]["fiche"]()
    if f.get("etat") != "absent":
        raise Echec(T("Le client est déjà installé.", "The client is already installed."))
    # bash par le PATH fixe ; kitty par celui de la session, comme partout dans nc-vpn (l'installeur officiel de kitty le pose dans
    # ~/.local/bin) : le script lancé dedans fixe son PATH lui-même
    exe, bash, kitty = installeur_chemin(), shutil.which("bash", path=INSTALLEUR_PATH), shutil.which("kitty")
    if not exe or not bash:
        raise Echec(T("Le script d'installation (nc-vpn-installer) est introuvable : relance install.sh.",
                      "The installer script (nc-vpn-installer) was not found: run install.sh again."))
    if not kitty:
        raise Echec(T("kitty est introuvable : ouvre un terminal et lance « bash ~/.local/libexec/nc-vpn-installer " + fid + " ».",
                      "kitty not found: open a terminal and run \"bash ~/.local/libexec/nc-vpn-installer " + fid + "\"."))
    titre = T("Installer ", "Install ") + f["nom"]
    try:
        r = subprocess.run([kitty, "--hold", "--title", titre, bash, exe, fid], stdin=subprocess.DEVNULL, env=installeur_env())
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("Impossible d'ouvrir kitty.", "Could not open kitty."))
    if r.returncode != 0:
        raise Echec(T("La fenêtre d'installation s'est mal terminée.", "The installation window ended badly."))
    print(T("Fenêtre d'installation fermée, l'état est relu.", "Installation window closed, the state is read again."))


def fournisseur_agir(a):
    """nc-vpn fournisseur ID connecter CC | deconnecter | login"""
    api = API_FOURNISSEURS.get(a[0]) if a else None
    if not api:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)
    if len(a) == 3 and a[1] == "connecter":
        verrou_changement()
        api["connecter"](a[2])
    elif a[1:] == ["deconnecter"]:
        verrou_changement()
        api["deconnecter"]()
    elif a[1:] == ["login"]:
        api["login"]()
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)


# ── IP publique (à la demande de l'île, jamais en boucle) ──────────────────────────────────────────────────────
def reglage(cle, defaut=""):
    try:
        with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
            val = defaut
            for x in f:
                if x.startswith(cle + "="):
                    val = x.split("=", 1)[1].strip().strip('"')
            return val
    except OSError:
        return defaut


def ip_publique():
    if reglage("VPN_IP_PUBLIQUE", "non") != "oui":
        print(json.dumps({"ip": ""}))
        return
    url = reglage("VPN_IP_SERVICE", "")
    p = urllib.parse.urlsplit(url)
    if p.scheme != "https" or not p.hostname or p.username or p.password:
        print(json.dumps({"ip": "", "erreur": T("adresse du service absente ou pas en https", "service address missing or not https")}))
        return
    try:
        class PasDeRedirection(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *a, **k):
                return None
        ouvre = urllib.request.build_opener(PasDeRedirection)
        with ouvre.open(urllib.request.Request(url, headers={"User-Agent": "nc-vpn"}), timeout=8) as r:
            brut = r.read(256).decode("ascii", errors="ignore").strip()
    except Exception:
        print(json.dumps({"ip": "", "erreur": T("service injoignable", "service unreachable")}))
        return
    import ipaddress
    try:
        ip = str(ipaddress.ip_address(brut))
    except ValueError:
        print(json.dumps({"ip": "", "erreur": T("réponse inattendue", "unexpected answer")}))
        return
    print(json.dumps({"ip": ip}))


# ── Kill switch : bloquer toute sortie hors du tunnel monté (réglage VPN_KILLSWITCH, coupé par défaut) ───────────────
# Tout le pare-feu est fait par l'assistant root system/nc-vpn-root (table nft « inet nc_vpn » à lui seul), appelé par
# « sudo -n » avec des arguments déjà validés ici ET là-bas. Ici : trouver le VRAI tunnel (TUN/TAP ou WireGuard) et ses
# endpoints (adresses IP) ; jamais de nom d'hôte résolu par nous, jamais de root, jamais de shell.
SYSFS = os.environ.get("NC_VPN_SYSFS", "/sys")                   # NC_VPN_SYSFS : un faux /sys, pour les tests
ROOT_VPN = os.environ.get("NC_VPN_ROOT", "/usr/local/bin/nc-vpn-root")
GDBUS_NM = ["gdbus", "call", "--system", "--dest", "org.freedesktop.NetworkManager"]


def limites():
    return [T("Ne dure pas après un redémarrage (à réactiver ensuite).", "Does not survive a reboot (enable it again afterwards)."),
            T("Ne couvre pas le forwarding des conteneurs ni des machines virtuelles.", "Does not cover container or virtual machine forwarding."),
            T("À couper pour changer de serveur : les adresses du serveur sont figées à l'activation.",
              "Turn it off to change server: the server addresses are fixed when you enable it."),
            T("Un seul serveur (pas de multi-remote) ; un tunnel doit être monté avant d'activer.",
              "One server only (no multi-remote); a tunnel must be up before enabling."),
            T("Le réseau local (sous-réseaux de tes cartes, /16 au plus large) reste joignable (sauf le DNS).",
              "Your local network (your cards' subnets, /16 at most) stays reachable (except DNS)."),
            T("Un rechargement de nftables (systemctl reload nftables, nft flush ruleset) efface la protection.",
              "Reloading nftables (systemctl reload nftables, nft flush ruleset) wipes the protection."),
            T("En cas de souci, depuis un terminal : sudo nft delete table inet nc_vpn",
              "If anything goes wrong, from a terminal: sudo nft delete table inet nc_vpn")]


def iface_tunnel(nom):
    """Vrai si /sys/class/net/NOM est un TUN/TAP (tun_flags) ou un WireGuard (DEVTYPE=wireguard)."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", nom or "") or not nom.strip("."):
        return False
    d = os.path.join(SYSFS, "class/net", nom)
    try:
        if os.path.isfile(os.path.join(d, "tun_flags")):
            return True
        with open(os.path.join(d, "uevent"), encoding="utf-8", errors="replace") as f:
            return "DEVTYPE=wireguard" in f.read().split()
    except OSError:
        return False


def sortie_ip_json():
    exe = shutil.which("ip")
    if not exe:
        return []
    try:
        r = subprocess.run([exe, "-j", "addr"], capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
        d = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    return d if isinstance(d, list) else []


def tunnel_de(c):
    """Le vrai tunnel d'une connexion montée. NetworkManager donne parfois le Wi-Fi comme « device » d'un OpenVPN : on retrouve
    alors le tun par les adresses que NetworkManager a données à la connexion, jamais « l'unique tunnel du système » (ce pourrait être tailscale0 ou le TAP d'une machine virtuelle)."""
    import ipaddress
    if iface_tunnel(c["interface"]):
        return c["interface"]
    code, out, _ = nmcli(["-t", "-g", "IP4.ADDRESS,IP6.ADDRESS", "connection", "show", "uuid", c["uuid"]])
    adr = set()
    for m in re.finditer(r"([0-9A-Fa-f:.]+)/[0-9]{1,3}", out if code == 0 else ""):
        try:
            adr.add(ipaddress.ip_address(m.group(1)))
        except ValueError:
            pass
    trouves = []
    for itf in sortie_ip_json():
        nom = itf.get("ifname") if isinstance(itf, dict) else None
        if not isinstance(nom, str) or not iface_tunnel(nom):
            continue
        for a in itf.get("addr_info") or []:
            try:
                if ipaddress.ip_address(a.get("local")) in adr:
                    trouves.append(nom)
            except (ValueError, TypeError):
                pass
    trouves = sorted(set(trouves))
    if len(trouves) == 1:
        return trouves[0]
    raise Echec(T("Impossible de retrouver l'interface du tunnel (TUN/TAP ou WireGuard) de cette connexion.",
                  "Could not find the tunnel interface (TUN/TAP or WireGuard) of this connection."))


def ip_ou_refus(texte, port, proto):
    import ipaddress
    brut = texte.strip("[]")
    try:
        # Même validation que l'assistant root : avant ipaddress (qui accepte « %zone » avec n'importe quel signe)
        if not re.fullmatch(r"[0-9A-Fa-f:.]{2,45}", brut):
            raise ValueError(brut)
        ip = ipaddress.ip_address(brut)
        if getattr(ip, "scope_id", None) or ip.is_link_local or ip.is_unspecified or ip.is_loopback or ip.is_multicast:
            raise ValueError(brut)
    except ValueError:
        raise Echec(T("L'adresse du serveur est un nom (« %s ») : le kill switch demande une adresse IP. Mets l'adresse IP du serveur dans la connexion."
                      % court(texte, 60), "The server address is a name (\"%s\"): the kill switch needs an IP address. Put the server's IP address in the connection."
                      % court(texte, 60)), "serveur_nom")
    return "%s@%d/%s" % (ip, port, proto)


def endpoints_openvpn(uuid):
    code, out, _ = nmcli(["-t", "-g", "vpn.data", "connection", "show", "uuid", uuid])
    if code != 0:
        raise Echec(T("Réglages de la connexion illisibles.", "Could not read the connection settings."))
    d = {}
    for m in re.split(r",\s*(?=[A-Za-z0-9_.-]+\s*=)", out.strip().replace("\\", "")):
        k, _, v = m.partition("=")
        d[k.strip()] = v.strip()
    entrees = [e.strip() for e in d.get("remote", "").split(",") if e.strip()]
    if not entrees:
        raise Echec(T("Pas d'adresse de serveur (remote) dans la connexion.", "No server address (remote) in the connection."))
    if len(entrees) > 1:
        raise Echec(T("Plusieurs serveurs (multi-remote) : le kill switch n'en gère qu'un.", "Several servers (multi-remote): the kill switch handles only one."))
    e = entrees[0]
    import ipaddress
    try:
        ipaddress.ip_address(e)
        hote, port, proto = e, None, None
    except ValueError:
        m = re.fullmatch(r"\[([^\]]+)\](?::([0-9]+))?(?::([A-Za-z0-9-]+))?", e)
        if m:
            hote, port, proto = m.groups()
        else:
            p = e.split(":")
            hote, port, proto = p[0], (p[1] if len(p) > 1 else None), (p[2] if len(p) > 2 else None)
    port = port or d.get("port") or "1194"
    proto = proto or ("tcp" if d.get("proto-tcp", "no") == "yes" else "udp")
    if not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
        raise Echec(T("Port du serveur invalide.", "Invalid server port."))
    return [ip_ou_refus(hote, int(port), "tcp" if proto.startswith("tcp") else "udp")]


def endpoints_wireguard(uuid):
    if not shutil.which("gdbus"):
        raise Echec(T("gdbus est absent (paquet glib2 / libglib2.0-bin) : impossible de lire les pairs WireGuard.",
                      "gdbus is missing (glib2 / libglib2.0-bin package): cannot read the WireGuard peers."))

    def appel(chemin, methode, *args):
        try:
            r = subprocess.run(GDBUS_NM + ["--object-path", chemin, "--method", methode] + list(args), capture_output=True, text=True,
                               timeout=8, stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C"))
        except (OSError, subprocess.SubprocessError):
            return ""
        return r.stdout if r.returncode == 0 else ""
    sortie = appel("/org/freedesktop/NetworkManager/Settings", "org.freedesktop.NetworkManager.Settings.GetConnectionByUuid", uuid)
    m = re.search(r"'(/org/freedesktop/NetworkManager/Settings/[0-9]+)'", sortie)
    if not m:
        raise Echec(T("Connexion introuvable chez NetworkManager.", "Connection not found in NetworkManager."))
    reglages = appel(m.group(1), "org.freedesktop.NetworkManager.Settings.Connection.GetSettings")
    brut = re.findall(r"'endpoint': <'([^']+)'>", reglages)
    if not brut:
        raise Echec(T("Aucun serveur (endpoint) dans la connexion WireGuard.", "No server (endpoint) in the WireGuard connection."))
    res = []
    for b in brut[:8]:
        hote, _, port = b.rpartition(":")
        if not hote or not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
            raise Echec(T("Adresse de serveur WireGuard invalide.", "Invalid WireGuard server address."))
        res.append(ip_ou_refus(hote, int(port), "udp"))
    return res


def resoudre_tunnel():
    """{"tunnel", "nom", "endpoints"} du tunnel monté, ou un refus (Echec) qui dit pourquoi."""
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."), "nm_indisponible")
    actives = e["actives"]
    if not actives:
        if mullvad_etat()["connecte"]:
            raise Echec(T("Mullvad est connecté : utilise sa protection, `mullvad lockdown-mode set on`.",
                          "Mullvad is connected: use its own protection, `mullvad lockdown-mode set on`."), "mullvad")
        raise Echec(T("Aucun tunnel monté : monte d'abord un tunnel, puis active le kill switch.", "No tunnel is up: bring one up first, then enable the kill switch."), "aucun_tunnel")
    if len(actives) > 1:
        raise Echec(T("Plusieurs tunnels montés : le kill switch n'en protège qu'un seul, coupe les autres.",
                      "Several tunnels are up: the kill switch protects only one, bring the others down."), "plusieurs_tunnels")
    c = actives[0]
    iface = tunnel_de(c)
    eps = endpoints_wireguard(c["uuid"]) if c["type"] == "wireguard" else endpoints_openvpn(c["uuid"])
    return {"tunnel": iface, "nom": c["nom"], "endpoints": eps}


def appeler_root(args):
    """(code, sortie, erreur) de « sudo -n nc-vpn-root ARGS » ; Echec clair si l'assistant ou sudo manque."""
    if not os.path.exists(ROOT_VPN):
        raise Echec(T("L'assistant du kill switch n'est pas installé : lance install.sh pour le poser (avec ton accord).",
                      "The kill switch helper is not installed: run install.sh to set it up (with your consent)."))
    sudo = shutil.which("sudo")
    if not sudo:
        raise Echec(T("sudo est absent.", "sudo is missing."))
    try:
        r = subprocess.run([sudo, "-n", ROOT_VPN] + args, capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("L'assistant du kill switch n'a pas répondu.", "The kill switch helper did not answer."))
    if r.returncode != 0 and re.search(r"password is required|may not run sudo|not allowed|a terminal is required", r.stderr, re.I):
        raise Echec(T("La règle sudo de l'assistant manque : relance install.sh pour la poser (avec ton accord).",
                      "The helper's sudo rule is missing: run install.sh again to set it up (with your consent)."))
    return r.returncode, r.stdout, r.stderr


def message_root(err):
    return re.sub(r"^nc-vpn-root:\s*", "", court(err, 240))


def assistant_installe():
    """L'assistant est posé ET la règle sudo existe : « sudo -n -l ASSISTANT etat » (en argv, sans mot de passe) ne lance rien,
    il demande seulement à sudo si cette commande exacte est permise. Faux sinon : « pas installé », pas « inconnu »."""
    if not os.path.exists(ROOT_VPN):
        return False
    sudo = shutil.which("sudo")
    if not sudo:
        return False
    try:
        r = subprocess.run([sudo, "-n", "-l", ROOT_VPN, "etat"], capture_output=True, text=True, timeout=15, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def killswitch_etat():
    """True / False d'après l'assistant (« etat »), None si inconnu (l'assistant ne répond pas)."""
    try:
        code, out, _ = appeler_root(["etat"])
    except Echec:
        return None
    if code != 0:
        return None
    return out.strip() == "actif"


def killswitch(a, en_json=False):
    if a == ["limites"]:
        for l in limites():
            print("- " + l)
    elif a == ["activer"]:
        if reglage("VPN_KILLSWITCH", "non") != "oui":
            raise Echec(T("Le kill switch est coupé dans les réglages (nc-reglages → Île → VPN : kill switch, VPN_KILLSWITCH).",
                          "The kill switch is off in the settings (nc-settings → Island → VPN: kill switch, VPN_KILLSWITCH)."), "killswitch_coupe")
        if not en_json:
            print(T("Limites du kill switch :", "Kill switch limits:"))
            for l in limites():
                print("- " + l)
        t = resoudre_tunnel()
        code, out, err = appeler_root(["activer", t["tunnel"]] + t["endpoints"])
        if code != 0:
            raise Echec(T("Kill switch refusé : ", "Kill switch refused: ") + message_root(err), "killswitch_refuse")
        if en_json:
            return sortie_json({"action": "killswitch-activer", "actif": True})
        print(T("Kill switch actif : tout ce qui sort hors du tunnel %s est bloqué." % t["tunnel"],
                "Kill switch on: everything leaving outside tunnel %s is blocked." % t["tunnel"]))
    elif a == ["desactiver"]:
        code, out, err = appeler_root(["desactiver"])
        if code != 0:
            raise Echec(T("Impossible de couper le kill switch : ", "Could not turn the kill switch off: ") + message_root(err)
                        + T(" (en terminal : sudo nft delete table inet nc_vpn)", " (in a terminal: sudo nft delete table inet nc_vpn)"),
                        "killswitch_refuse")
        if en_json:
            return sortie_json({"action": "killswitch-desactiver", "actif": False})
        print(T("Kill switch coupé.", "Kill switch off."))
    elif a == ["etat"]:
        if not assistant_installe():
            print(T("Kill switch : pas installé (l'assistant se pose avec ton accord : install.sh --seulement killswitch)",
                    "Kill switch: not installed (the helper is set up with your consent: install.sh --seulement killswitch)"))
            return
        s = killswitch_etat()
        print(T("Kill switch : ", "Kill switch: ") + (T("actif", "on") if s else T("inactif", "off") if s is False else T("inconnu", "unknown")))
    elif a == ["etat-json"]:
        installe = assistant_installe()
        actif = killswitch_etat() if installe else None
        refus, refus_code = "", ""
        if not installe:
            refus_code = "pas_installe"
            refus = T("Pas installé : l'assistant se pose avec ton accord (install.sh --seulement killswitch).",
                      "Not installed: the helper is set up with your consent (install.sh --seulement killswitch).")
        elif actif is not True:
            try:
                resoudre_tunnel()
            except Echec as e:
                refus = str(e)
                refus_code = e.code if e.code in CODES_REFUS else "autre"
        print(json.dumps({"contrat": CONTRAT, "installe": installe, "voulu": reglage("VPN_KILLSWITCH", "non") == "oui", "actif": actif,
                          "refus": refus, "refus_code": refus_code, "limites": limites()}, ensure_ascii=False))
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)


ALIAS = {"status": "etat-json", "connect": "connecter", "disconnect": "deconnecter"}


def main():
    global VERIFIER_PROTON
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "aide", "help"):
        return print(T(__doc__.strip(), USAGE_EN))
    # Alias de compatibilité : ils se réécrivent en commande d'origine, puis passent par le MÊME code (aucune logique en double)
    if a[:2] == ["status", "--json"] and len(a) == 2:
        a = ["etat-json"]
    elif a[0] in ALIAS and a[0] != "status":
        a = [ALIAS[a[0]]] + a[1:]
    cmd = a[0]
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, arret_propre)
    en_json = a[-1:] == ["--json"] and cmd in ("connecter", "deconnecter", "tout-deconnecter", "killswitch")
    if en_json:
        a = a[:-1]
    try:
        if cmd == "etat-json" and len(a) == 1:
            print(json.dumps(dict({"contrat": CONTRAT, "connexions": [], "actives": []}, **etat_enrichi()), ensure_ascii=False))
        elif cmd == "liste" and len(a) == 1:
            e = etat()
            if not e["disponible"]:
                return print(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."))
            for c in e["connexions"]:
                print(("* " if c["active"] else "  ") + c["nom"] + "  [" + c["type"] + "]" + ("  " + c["interface"] if c["interface"] else "") + "  " + c["uuid"])
        elif cmd in ("connecter", "deconnecter") and len(a) == 2:
            agir_connexion(cmd, a[1], en_json)
        elif cmd == "tout-deconnecter" and len(a) == 1:
            agir_tout(en_json)
        elif cmd == "importer" and len(a) == 2:
            importer(a[1])
        elif cmd == "indicateur" and a[1:] == ["--json"]:
            print(json.dumps(indicateur(), ensure_ascii=False))
        elif cmd == "mullvad" and a[1:] == ["pays-json"]:
            print(json.dumps(mullvad_pays_json(), ensure_ascii=False))
        elif cmd == "mullvad" and a[1:] == ["etat-json"]:
            print(json.dumps(mullvad_json(), ensure_ascii=False))
        elif cmd == "mullvad" and len(a) >= 2:
            mullvad_agir(a[1:])
        elif cmd == "fournisseurs-json" and (len(a) == 1 or a[1:] == ["--verifier-proton"]):
            VERIFIER_PROTON = len(a) == 2
            print(json.dumps(fournisseurs_json(), ensure_ascii=False))
        elif cmd == "installer-client" and len(a) == 2:
            installer_client(a[1])
        elif cmd == "fournisseur" and len(a) >= 3:
            fournisseur_agir(a[1:])
        elif cmd == "killswitch":
            killswitch(a[1:], en_json)
        elif cmd == "ip-publique" and len(a) == 1:
            ip_publique()
        else:
            print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
            sys.exit(2)
    except Echec as e:
        if en_json:      # le contrat : l'erreur est un objet JSON sur la sortie standard, code de sortie 1
            print(json.dumps({"contrat": CONTRAT, "ok": False, "code": e.code, "erreur": str(e)}, ensure_ascii=False))
        else:
            print("nc-vpn : " + str(e), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
