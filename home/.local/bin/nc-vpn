#!/usr/bin/env python3
"""nc-vpn : les connexions VPN et WireGuard de NetworkManager, pilotées depuis le bureau (panneau VPN de l'île, Super + Alt + V).
  nc-vpn etat-json            les connexions de type vpn et wireguard en JSON : {"disponible", "connexions", "actives"}
                              (uuid, nom, type, active, interface) ; nmcli absent ou NetworkManager arrêté : {"disponible": false}
  nc-vpn liste                les mêmes en clair
  nc-vpn connecter UUID       monte ce tunnel (déjà monté : rien à faire) ; plusieurs tunnels peuvent être montés à la fois
  nc-vpn deconnecter UUID     coupe ce tunnel
  nc-vpn tout-deconnecter     coupe tous les tunnels montés
  nc-vpn importer FICHIER     importe un .ovpn (OpenVPN) ou un .conf (WireGuard) dans NetworkManager, en connexion privée
                              à toi et sans connexion automatique
  nc-vpn indicateur --json    le tunnel RÉELLEMENT monté, pour la pilule : {"disponible", "actif", "fournisseur", "pays", "nom", "nombre"}
                              (un seul nmcli ; fournisseur et pays déduits du nom de la connexion et de l'interface, sans réseau)
  nc-vpn mullvad etat-json    l'application officielle Mullvad (commande `mullvad`, hors NetworkManager) : {"installe", "connecte", "pays", "hote"}
  nc-vpn mullvad connecter | deconnecter | pays CC    les pilote (`mullvad connect`, `mullvad disconnect`, `mullvad relay set location cc`)
  nc-vpn killswitch activer | desactiver | etat | etat-json | limites    bloque toute sortie hors du tunnel monté (VPN_KILLSWITCH à oui ;
                              assistant root facultatif posé par install.sh ; les limites sont affichées avant d'activer)
  nc-vpn ip-publique          ton adresse IP publique, si tu l'as demandé (nc-reglages → Île : VPN_IP_PUBLIQUE et VPN_IP_SERVICE)
Contrat JSON pour les scripts et JARVIS (docs/vpn-contrat.md, "contrat": 1) : etat-json et killswitch etat-json en JSON ;
connecter UUID, deconnecter UUID, tout-deconnecter et killswitch activer|desactiver acceptent --json en dernier argument
(succès : {"contrat", "ok": true, …} ; erreur : {"contrat", "ok": false, "code", "erreur"} sur la sortie standard, code de sortie 1).
Alias : status --json = etat-json, connect = connecter, disconnect = deconnecter. Rappel : après une mise à jour, relance `nc-jarvis deployer`.
Tout passe par nmcli, en arguments (jamais par une ligne de shell), et par l'UUID de la connexion. Ni root, ni pkexec.
Importer refuse un fichier qui ferait exécuter quelque chose (up, down, route-up, script-security 2, plugin, PostUp…), un lien,
un fichier trop gros (64 Kio). Les certificats donnés par un chemin relatif (ca, cert, key, tls-auth, tls-crypt…) sont lus depuis
le dossier du .ovpn et mis dans une copie temporaire (PEM texte seulement, 64 Kio au plus en tout) ; l'original n'est jamais
modifié. Un bloc <auth-user-pass> (identifiant puis mot de passe) est accepté : l'identifiant va dans la connexion, le mot de
passe dans le trousseau de la session (secret-tool, paquet libsecret ; il faut un trousseau ouvert : gnome-keyring, KeePassXC,
KWallet…), jamais dans un fichier ; sans trousseau l'import est refusé. Les secrets restent chez NetworkManager ou dans le
trousseau : jamais dans nos fichiers, jamais dans les journaux ni dans la sortie.
"""
import json
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-vpn: NetworkManager's VPN and WireGuard connections, driven from the desktop (island VPN panel, Super + Alt + V).
  nc-vpn etat-json            the vpn and wireguard connections as JSON: {"disponible", "connexions", "actives"}
                              (uuid, nom, type, active, interface); no nmcli or NetworkManager stopped: {"disponible": false}
  nc-vpn liste                the same in plain text
  nc-vpn connecter UUID       bring this tunnel up (already up: nothing to do); several tunnels can be up at once
  nc-vpn deconnecter UUID     bring this tunnel down
  nc-vpn tout-deconnecter     bring every active tunnel down
  nc-vpn importer FILE        import an .ovpn (OpenVPN) or .conf (WireGuard) file into NetworkManager, private to you
                              and without autoconnect
  nc-vpn indicateur --json    the tunnel that is REALLY up, for the pill: {"disponible", "actif", "fournisseur", "pays", "nom", "nombre"}
                              (one nmcli; provider and country guessed from the connection and interface names, no network)
  nc-vpn mullvad etat-json    the official Mullvad app (`mullvad` command, outside NetworkManager): {"installe", "connecte", "pays", "hote"}
  nc-vpn mullvad connecter | deconnecter | pays CC    drive it (`mullvad connect`, `mullvad disconnect`, `mullvad relay set location cc`)
  nc-vpn killswitch activer | desactiver | etat | etat-json | limites    block everything leaving outside the tunnel that is up
                              (VPN_KILLSWITCH set to oui; optional root helper installed by install.sh; the limits are shown before enabling)
  nc-vpn ip-publique          your public IP address, if you asked for it (nc-settings → Island: VPN_IP_PUBLIQUE and VPN_IP_SERVICE)
JSON contract for scripts and JARVIS (docs/vpn-contrat.md, "contrat": 1): etat-json and killswitch etat-json print JSON;
connecter UUID, deconnecter UUID, tout-deconnecter and killswitch activer|desactiver accept --json as the last argument
(success: {"contrat", "ok": true, …}; error: {"contrat", "ok": false, "code", "erreur"} on standard output, exit code 1).
Aliases: status --json = etat-json, connect = connecter, disconnect = deconnecter. Reminder: after an update, run `nc-jarvis deployer` again.
Everything goes through nmcli, as arguments (never a shell line), by connection UUID. No root, no pkexec.
Import refuses a file that would run something (up, down, route-up, script-security 2, plugin, PostUp…), a link, a file that
is too big (64 KiB). Certificates given by a relative path (ca, cert, key, tls-auth, tls-crypt…) are read from the .ovpn's
folder and put into a temporary copy (text PEM only, 64 KiB at most in all); the original is never modified. An
<auth-user-pass> block (username then password) is accepted: the username goes into the connection, the password into the
session keyring (secret-tool, libsecret package; an unlocked keyring is needed: gnome-keyring, KeePassXC, KWallet…), never
into a file; without a keyring the import is refused. Secrets stay with NetworkManager or in the keyring: never in our files,
logs or output."""

TYPES = ("vpn", "wireguard")
UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
MAX_OCTETS = 64 * 1024

# OpenVPN : directives qui exécutent un programme ou chargent du code (et « iproute », « pkcs11-providers »)
OVPN_EXEC = ("up", "down", "route-up", "route-pre-down", "ipchange", "client-connect", "client-disconnect", "learn-address",
             "tls-verify", "auth-user-pass-verify", "plugin", "iproute", "pkcs11-providers", "dns-updown", "tls-crypt-v2-verify")
# OpenVPN : directives qui feraient lire un autre fichier de configuration (non vérifié ici) ou écrire un fichier n'importe où
OVPN_AUTRES = ("config", "log", "log-append", "writepid", "status", "management")
WG_EXEC = ("preup", "postup", "predown", "postdown")
# Fichiers de certificats donnés par un chemin : la copie temporaire est effacée, un chemin relatif ne mènerait plus à rien
OVPN_FICHIERS = ("ca", "cert", "key", "pkcs12", "tls-auth", "tls-crypt", "tls-crypt-v2", "secret", "crl-verify", "extra-certs", "dh")


CONTRAT = 1      # version du contrat JSON (docs/vpn-contrat.md) : change seulement si un champ disparaît ou change de sens


class Echec(Exception):
    """Une erreur annoncée. `code` est stable (contrat JSON) : echec, uuid_invalide, nm_indisponible, inconnue,
    echec_partiel, killswitch_coupe, killswitch_refuse."""
    def __init__(self, message="", code="echec"):
        super().__init__(message)
        self.code = code


def nmcli(args, delai=15):
    """(code, sortie, erreur) d'un nmcli lancé en arguments, en anglais (messages stables). 127 : nmcli absent."""
    if not shutil.which("nmcli"):
        return 127, "", ""
    env = dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C")
    try:
        r = subprocess.run(["nmcli"] + args, capture_output=True, text=True, errors="replace", timeout=delai, env=env,
                           stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return 126, "", ""
    return r.returncode, r.stdout, r.stderr


def champs_nmcli(ligne):
    """Découpe une ligne de « nmcli -t » : séparateur « : », échappé par « \\: » (et « \\\\ » pour l'antislash)."""
    res, cur, i = [], [], 0
    while i < len(ligne):
        c = ligne[i]
        if c == "\\" and i + 1 < len(ligne):
            cur.append(ligne[i + 1]); i += 2
            continue
        if c == ":":
            res.append("".join(cur)); cur = []
        else:
            cur.append(c)
        i += 1
    res.append("".join(cur))
    return res


def etat():
    """{"disponible": False} ou {"disponible": True, "connexions": [...], "actives": [...]}."""
    code, out, _ = nmcli(["-t", "-c", "no", "-f", "UUID,TYPE,ACTIVE,DEVICE,NAME", "connection", "show"])
    if code != 0:
        return {"disponible": False}
    connexions = []
    for ligne in out.splitlines():
        f = champs_nmcli(ligne)
        if len(f) < 5:
            continue
        uuid, typ, active, dev = f[0], f[1], f[2], f[3]
        nom = ":".join(f[4:])        # le nom est le dernier champ : un « : » non échappé n'y casserait rien
        if typ not in TYPES or not UUID.fullmatch(uuid):
            continue
        on = active == "yes"
        connexions.append({"uuid": uuid.lower(), "nom": nom, "type": "wireguard" if typ == "wireguard" else "vpn", "active": on,
                           "interface": dev if on and dev not in ("", "--") else ""})
    return {"disponible": True, "connexions": connexions, "actives": [c for c in connexions if c["active"]]}


def uuid_valide(u):
    if not isinstance(u, str) or not UUID.fullmatch(u):
        raise Echec(T("UUID invalide (forme attendue : 8-4-4-4-12 chiffres hexadécimaux).",
                      "Invalid UUID (expected form: 8-4-4-4-12 hexadecimal digits)."), "uuid_invalide")
    return u.lower()


def connue(u):
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."), "nm_indisponible")
    for c in e["connexions"]:
        if c["uuid"] == u:
            return c
    raise Echec(T("Cette connexion n'est pas un VPN ou un WireGuard connu de NetworkManager.",
                  "This connection is not a VPN or WireGuard known to NetworkManager."), "inconnue")


def court(texte, n=200):
    ligne = (texte or "").strip().splitlines()
    return ligne[0][:n] if ligne else ""


def connecter(u):
    u = uuid_valide(u)
    nettoyer_abandonnes()
    c = connue(u)
    if c["active"]:
        return {"nom": c["nom"], "deja": True}
    # Mot de passe gardé par le trousseau (password-flags=1) : aucun agent de secrets ne tourne forcément (Hyprland sans nm-applet),
    # donc on le relit et on le donne à nmcli par un fichier temporaire (format « vpn.secrets.password:… »), jamais en argument
    agent = c["type"] == "vpn" and mot_de_passe_agent_owned(u)
    mdp = lire_secret(u) if agent else None
    d = None
    try:
        args = ["connection", "up", "uuid", u]
        if mdp is not None:
            d = dossier_prive()
            fichier = os.path.join(d, "mdp")
            fd = os.open(fichier, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(("vpn.secrets.password:" + mdp + "\n").encode("utf-8"))
            args += ["passwd-file", fichier]
        code, _, err = nmcli(args, delai=120)
    except OSError:
        raise Echec(T("Impossible d'écrire le fichier temporaire du mot de passe.", "Could not write the temporary password file."))
    finally:
        if d:
            shutil.rmtree(d, ignore_errors=True)
    if code != 0:
        if agent and mdp is None and re.search(r"secrets? (were|was) required|no secrets", err or "", re.I):
            raise Echec(T(f"Connexion impossible : {c['nom']} (secret introuvable dans le trousseau : réimporte le profil ou ouvre ton trousseau)",
                          f"Could not connect: {c['nom']} (secret not found in the keyring: import the profile again or unlock your keyring)"))
        msg = court(masquer(err, mdp)).replace(d or "\0", "")
        raise Echec(T(f"Connexion impossible : {c['nom']}", f"Could not connect: {c['nom']}") + (" (" + msg + ")" if msg else ""))
    return {"nom": c["nom"], "deja": False}


def deconnecter(u):
    u = uuid_valide(u)
    c = connue(u)
    if not c["active"]:
        return {"nom": c["nom"], "deja": True}
    code, _, err = nmcli(["connection", "down", "uuid", u], delai=60)
    if code != 0:
        raise Echec(T(f"Déconnexion impossible : {c['nom']}", f"Could not disconnect: {c['nom']}") + (" (" + court(err) + ")" if court(err) else ""))
    return {"nom": c["nom"], "deja": False}


def tout_deconnecter():
    """{"coupes": [connexions], "rates": [connexions]} ; Echec si NetworkManager manque."""
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."), "nm_indisponible")
    coupes, rates = [], []
    for c in e["actives"]:
        code, _, _ = nmcli(["connection", "down", "uuid", c["uuid"]], delai=60)
        (rates if code != 0 else coupes).append(c)
    return {"coupes": coupes, "rates": rates}


# ── Sorties : texte pour le bureau, JSON (--json) pour JARVIS et les scripts (docs/vpn-contrat.md) ──────────────
def sortie_json(d):
    print(json.dumps(dict({"contrat": CONTRAT, "ok": True}, **d), ensure_ascii=False))


def agir_connexion(cmd, u, en_json):
    """connecter / deconnecter UUID : le même code pour le texte et le JSON."""
    r = (connecter if cmd == "connecter" else deconnecter)(u)
    actif = cmd == "connecter"
    if en_json:
        return sortie_json({"action": cmd, "uuid": uuid_valide(u), "nom": r["nom"], "actif": actif, "deja": r["deja"]})
    if actif:
        print(T(f"Déjà connecté : {r['nom']}", f"Already connected: {r['nom']}") if r["deja"]
              else T(f"Connecté : {r['nom']}", f"Connected: {r['nom']}"))
    else:
        print(T(f"Déjà déconnecté : {r['nom']}", f"Already disconnected: {r['nom']}") if r["deja"]
              else T(f"Déconnecté : {r['nom']}", f"Disconnected: {r['nom']}"))


def agir_tout(en_json):
    r = tout_deconnecter()
    if en_json:
        brut = lambda l: [{"uuid": c["uuid"], "nom": c["nom"]} for c in l]
        d = {"action": "tout-deconnecter", "coupes": brut(r["coupes"]), "rates": brut(r["rates"])}
        if r["rates"]:
            print(json.dumps(dict({"contrat": CONTRAT, "ok": False, "code": "echec_partiel",
                                   "erreur": T("Certains tunnels n'ont pas pu être coupés.", "Some tunnels could not be disconnected.")}, **d),
                             ensure_ascii=False))
            sys.exit(1)
        return sortie_json(d)
    if not r["coupes"] and not r["rates"]:
        return print(T("Aucun tunnel connecté.", "No tunnel connected."))
    for c in r["coupes"]:
        print(T(f"Déconnecté : {c['nom']}", f"Disconnected: {c['nom']}"))
    for c in r["rates"]:
        print(T(f"Déconnexion impossible : {c['nom']}", f"Could not disconnect: {c['nom']}"), file=sys.stderr)
    if r["rates"]:
        sys.exit(1)


# ── Import ──────────────────────────────────────────────────────────────────────────────────────────────────────
def lire_fichier(chemin):
    """Les octets d'un fichier ordinaire (jamais un lien), de 64 Kio au plus, en .ovpn ou .conf."""
    if not isinstance(chemin, str) or chemin == "" or "\0" in chemin:
        raise Echec(T("Chemin de fichier invalide.", "Invalid file path."))
    nom = os.path.basename(chemin)
    if os.path.splitext(nom)[1].lower() not in (".ovpn", ".conf"):
        raise Echec(T("Seuls les fichiers .ovpn (OpenVPN) et .conf (WireGuard) sont acceptés.",
                      "Only .ovpn (OpenVPN) and .conf (WireGuard) files are accepted."))
    try:
        if stat.S_ISLNK(os.lstat(chemin).st_mode):
            raise Echec(T("Un lien symbolique est refusé : donne le fichier lui-même.", "A symbolic link is refused: give the file itself."))
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except Echec:
        raise
    except OSError:
        raise Echec(T("Fichier introuvable ou illisible.", "File not found or unreadable."))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Echec(T("Ce n'est pas un fichier ordinaire.", "This is not a regular file."))
        if st.st_size > MAX_OCTETS:
            raise Echec(T("Fichier trop gros (64 Kio au plus).", "File too big (64 KiB at most)."))
        donnees = b""
        while len(donnees) <= MAX_OCTETS:
            bloc = os.read(fd, MAX_OCTETS + 1 - len(donnees))
            if not bloc:
                break
            donnees += bloc
    except OSError:
        raise Echec(T("Fichier illisible.", "File unreadable."))
    finally:
        os.close(fd)
    if len(donnees) > MAX_OCTETS:
        raise Echec(T("Fichier trop gros (64 Kio au plus).", "File too big (64 KiB at most)."))
    if b"\0" in donnees:
        raise Echec(T("Ce n'est pas un fichier texte.", "This is not a text file."))
    return nom, donnees


def verifier(texte):
    """Refuse (Echec) ce qui exécute quelque chose ou demande un traitement de mot de passe. Retourne 'openvpn' ou 'wireguard'.
    Chaque ligne est examinée, y compris dans les blocs <…> ; les lignes de commentaire (# ou ;) sont ignorées."""
    texte = texte.lstrip("﻿")
    wireguard = False
    for brute in texte.splitlines():
        ligne = brute.strip()
        if ligne == "" or ligne[0] in "#;":
            continue
        if re.match(r"\[\s*interface\s*\]", ligne, re.I):
            wireguard = True
        if re.match(r"<\s*/?\s*auth-user-pass\s*>", ligne, re.I):
            raise Echec(T("Un bloc <auth-user-pass> inattendu est refusé (un seul bloc, de deux lignes : identifiant puis mot de passe).",
                          "An unexpected <auth-user-pass> block is refused (a single block of two lines: username then password)."))
        # OpenVPN lit les guillemets n'importe où dans un mot (u"p" est « up ») : ils sont retirés avant de lire la directive
        m = re.match(r"-{0,2}([A-Za-z][A-Za-z0-9_-]*)(?=$|[\s=])\s*(.*)$", ligne.replace('"', "").replace("'", ""))
        if not m:
            continue
        mot, reste = m.group(1).lower(), m.group(2)
        if mot in OVPN_EXEC:
            raise Echec(T(f"Directive refusée « {mot} » : elle ferait exécuter un programme. Retire-la du fichier.",
                          f"Directive refused \"{mot}\": it would run a program. Remove it from the file."))
        if mot in OVPN_AUTRES and not wireguard:
            raise Echec(T(f"Directive refusée « {mot} » : elle ferait lire ou écrire un autre fichier. Retire-la du fichier.",
                          f"Directive refused \"{mot}\": it would read or write another file. Remove it from the file."))
        if mot in WG_EXEC:
            raise Echec(T(f"Directive refusée « {m.group(1)} » : elle ferait exécuter une commande. Retire-la du fichier.",
                          f"Directive refused \"{m.group(1)}\": it would run a command. Remove it from the file."))
        if mot == "script-security":
            niveau = (reste.split() or [""])[0].lower()
            if niveau not in ("0", "1", "none", "builtin"):
                raise Echec(T("Directive refusée « script-security » au-dessus de 1 : elle autorise l'exécution de scripts.",
                              "Directive refused \"script-security\" above 1: it allows scripts to run."))
        if mot in OVPN_FICHIERS and not wireguard:
            arg = (reste.split() or [""])[0]
            if arg and arg != "[inline]" and not arg.startswith("/"):
                raise Echec(T(f"Le certificat « {mot} {arg} » est donné par un chemin relatif : il ne serait pas retrouvé après l'import. Mets-le dans le fichier (bloc <{mot}>…</{mot}>) ou donne un chemin complet.",
                              f"The certificate \"{mot} {arg}\" is given by a relative path: it would not be found after the import. Put it in the file (<{mot}>…</{mot}> block) or give a full path."))
            if arg.startswith("/"):
                fichier_lisible(mot, arg)
    return "wireguard" if wireguard else "openvpn"


def fichier_lisible(mot, chemin):
    """Un certificat donné par un chemin complet : openvpn le lira en root (lancé par NetworkManager). Il doit donc être un
    fichier ordinaire que l'utilisateur peut lire LUI-MÊME (sinon un .ovpn douteux ferait lire par root un fichier interdit,
    voire l'enverrait au serveur), sans lien ni détour, hors de /proc, /sys et /dev."""
    reel = os.path.realpath(chemin)
    ok = reel == os.path.normpath(chemin) and not re.match(r"/(proc|sys|dev)(/|$)", reel)
    if ok:
        try:
            ok = stat.S_ISREG(os.lstat(chemin).st_mode) and os.access(chemin, os.R_OK)
        except OSError:
            ok = False
    if not ok:
        raise Echec(T(f"Le certificat « {mot} {chemin} » est refusé : ce doit être un fichier ordinaire (pas un lien, ni dans /proc, /sys ou /dev) que tu peux lire toi-même. Sinon, mets-le dans le fichier (bloc <{mot}>…</{mot}>).",
                      f"The certificate \"{mot} {chemin}\" is refused: it must be a regular file (not a link, nor in /proc, /sys or /dev) that you can read yourself. Otherwise, put it in the file (<{mot}>…</{mot}> block)."))


def dossier_prive():
    """Un dossier 0700 neuf, sous XDG_RUNTIME_DIR (le dossier privé de la session) si possible."""
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if base and os.path.isdir(base) and os.stat(base).st_uid == os.getuid():
            d = tempfile.mkdtemp(prefix="nc-vpn-", dir=base)
        else:
            d = tempfile.mkdtemp(prefix="nc-vpn-")
    except OSError:
        raise Echec(T("Impossible de créer un dossier temporaire privé.", "Could not create a private temporary folder."))
    os.chmod(d, 0o700)
    return d


# Dossier abandonné : un nc-vpn tué avant son « finally » (SIGKILL, coupure de courant) peut laisser « nc-vpn-*/mdp » (le mot de
# passe en clair, 0600) dans XDG_RUNTIME_DIR. Le ménage de connecter() et d'importer() efface ceux de plus de SEUIL secondes.
# Le seuil doit rester LARGEMENT au-dessus du plus long travail légitime : connecter() dure au plus ~190 s (état de NetworkManager
# 15 s, agent-owned ~20 s, secret-tool 30 s, nmcli up 120 s) et importer() ~60 s. Si l'un de ces délais augmente, on monte ce
# seuil (tests/test_nc_vpn_menage.py vérifie qu'il reste au moins le double de la somme des délais de connecter).
SEUIL_DOSSIER_ABANDONNE = 600       # secondes (10 minutes)


def nettoyer_abandonnes(seuil=None):
    """Efface les dossiers DIRECTS de XDG_RUNTIME_DIR nommés « nc-vpn-* » (le préfixe de dossier_prive), qui sont à nous
    (lstat st_uid), ne sont pas des liens (S_ISDIR sur lstat) et dont le mtime date de plus que le seuil. Un lien, un fichier,
    le dossier d'un autre préfixe ou d'un autre utilisateur ne sont jamais touchés ; rmtree ne suit aucun lien ; toute erreur est ignorée."""
    seuil = SEUIL_DOSSIER_ABANDONNE if seuil is None else seuil
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        if not base or not os.path.isdir(base) or os.stat(base).st_uid != os.getuid():
            return
        with os.scandir(base) as it:
            entrees = [e.name for e in it if e.name.startswith("nc-vpn-")]
    except OSError:
        return
    maintenant = time.time()
    for nom in entrees:
        chemin = os.path.join(base, nom)
        try:
            st = os.lstat(chemin)
            if stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and maintenant - st.st_mtime > seuil:
                shutil.rmtree(chemin, ignore_errors=True)
        except OSError:
            pass


def arret_propre(num, _cadre):
    """SIGTERM, SIGINT, SIGHUP : une exception, pour que les « finally » (effacement du dossier du mot de passe) s'exécutent."""
    raise SystemExit(128 + num)


BLOC_AUTH_DEBUT = re.compile(r"<\s*auth-user-pass\s*>", re.I)
BLOC_AUTH_FIN = re.compile(r"<\s*/\s*auth-user-pass\s*>", re.I)
# Le schéma et les attributs du trousseau de nm-applet et de GNOME Shell (KEYRING_UUID_TAG « connection-uuid »,
# KEYRING_SN_TAG « setting-name », KEYRING_SK_TAG « setting-key » dans leurs sources)
SCHEMA_NM = "org.freedesktop.NetworkManager.Connection"


def masquer(texte, secret):
    """Un message d'outil : le mot de passe (et sa forme échappée) n'y apparaît jamais."""
    if not secret:
        return texte or ""
    texte = (texte or "").replace(secret, "***")
    for forme in (json.dumps(secret)[1:-1], repr(secret)[1:-1]):
        if forme:
            texte = texte.replace(forme, "***")
    return texte


def extraire_auth(texte):
    """(texte sans le bloc <auth-user-pass>, identifiant, mot de passe). Le bloc (deux lignes : identifiant puis mot de passe)
    est remplacé par la directive « auth-user-pass » seule, pour que NetworkManager crée une connexion à mot de passe.
    Sans bloc : (texte, None, None)."""
    sortie, bloc, trouve, fin = [], None, False, None
    for brute in texte.splitlines():
        ligne = brute.strip()
        if bloc is None:
            if BLOC_AUTH_DEBUT.fullmatch(ligne):
                if trouve:
                    raise Echec(T("Un seul bloc <auth-user-pass> est accepté.", "Only one <auth-user-pass> block is accepted."))
                bloc, trouve = [], True
                sortie.append("auth-user-pass")
            else:
                sortie.append(brute)
        elif BLOC_AUTH_FIN.fullmatch(ligne):
            lignes = [x.rstrip("\r") for x in bloc]
            if len(lignes) != 2 or not lignes[0].strip() or not lignes[1]:
                raise Echec(T("Le bloc <auth-user-pass> doit avoir deux lignes : l'identifiant, puis le mot de passe (qui ne peut pas contenir de saut de ligne, de retour chariot ni de caractère nul).",
                              "The <auth-user-pass> block must have two lines: the username, then the password (which cannot contain a line break, a carriage return or a NUL character)."))
            ident, mdp = lignes[0].strip(), lignes[1]
            if re.search(r"[,\\\x00-\x1f\x7f]", ident):
                raise Echec(T("L'identifiant du bloc <auth-user-pass> contient un caractère non accepté (virgule, antislash ou caractère de contrôle).",
                              "The username in the <auth-user-pass> block contains an unsupported character (comma, backslash or control character)."))
            if re.search(r"[\x00-\x1f\x7f]", mdp):
                raise Echec(T("Le mot de passe du bloc <auth-user-pass> contient un saut de ligne, un retour chariot, un caractère nul ou un autre caractère de contrôle : import refusé.",
                              "The password in the <auth-user-pass> block contains a line break, a carriage return, a NUL or another control character: import refused."))
            bloc, fin = None, (ident, mdp)
        else:
            bloc.append(brute)
    if bloc is not None:
        raise Echec(T("Le bloc <auth-user-pass> n'est pas fermé.", "The <auth-user-pass> block is not closed."))
    if not trouve:
        return texte, None, None
    return "\n".join(sortie) + "\n", fin[0], fin[1]


# Certificats donnés par un chemin relatif : lus depuis le dossier du .ovpn, mis EN LIGNE (<ca>…</ca>) dans la copie
DIRECTION = ("tls-auth", "secret")     # ces deux directives peuvent porter un sens (0 ou 1) : il devient « key-direction N »


def chemin_relatif_sur(dossier, arg):
    """Le chemin absolu de `arg` (relatif) depuis `dossier`, ou Echec. Confiné au dossier du .ovpn (sous-dossiers permis,
    comme les paquets des fournisseurs) : un « ../../.ssh/… » d'un fichier téléchargé ferait copier une clé de l'utilisateur
    dans la connexion ; vérifié à chaque « .. », avant toute lecture. Chaque dossier traversé doit être lisible et traversable,
    et aucun lien n'est suivi."""
    base = os.path.normpath(os.path.abspath(dossier))
    sort = Echec(T(f"Le chemin « {arg} » sort du dossier du profil : refusé. Donne un chemin complet, ou mets le fichier à côté du profil.",
                   f"The path \"{arg}\" leaves the profile's folder: refused. Give a full path, or put the file next to the profile."))
    cur = base
    parties = [x for x in arg.split("/") if x not in ("", ".")]
    for i, part in enumerate(parties):
        if part == ".." and cur == base:
            raise sort
        if not os.access(cur, os.R_OK | os.X_OK):        # « .. » compris : pas de détour par un dossier qu'il ne peut pas ouvrir
            raise Echec(T(f"Le chemin « {arg} » passe par un dossier que tu ne peux pas ouvrir.", f"The path \"{arg}\" goes through a folder you cannot open."))
        if part == "..":
            cur = os.path.dirname(cur)
            continue
        cur = os.path.join(cur, part)
        if i < len(parties) - 1 and stat.S_ISLNK(os.lstat(cur).st_mode if os.path.lexists(cur) else 0):
            raise Echec(T(f"Le chemin « {arg} » passe par un lien symbolique : refusé.", f"The path \"{arg}\" goes through a symbolic link: refused."))
    if os.path.commonpath([base, cur]) != base:
        raise sort
    return cur


# Étiquettes PEM permises pour un VPN (certificats, clés, CRL, clé statique OpenVPN, paramètres DH) : une clé SSH ou PGP n'a
# rien à faire dans un profil VPN et n'est jamais recopiée
PEM_PERMIS = ("CERTIFICATE", "TRUSTED CERTIFICATE", "X509 CRL", "PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY",
              "ENCRYPTED PRIVATE KEY", "OpenVPN Static key V1", "DH PARAMETERS")


def lire_pem(mot, chemin):
    """Le texte PEM d'un certificat ou d'une clé (blocs -----BEGIN … -----END seulement), 64 Kio au plus."""
    try:
        fd = os.open(chemin, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        raise Echec(T(f"Le fichier « {mot} » est introuvable ou illisible.", f"The \"{mot}\" file is not found or unreadable."))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Echec(T(f"« {mot} » n'est pas un fichier ordinaire.", f"\"{mot}\" is not a regular file."))
        donnees = b""
        while len(donnees) <= MAX_OCTETS:
            bloc = os.read(fd, MAX_OCTETS + 1 - len(donnees))
            if not bloc:
                break
            donnees += bloc
    except OSError:
        raise Echec(T(f"Le fichier « {mot} » est illisible.", f"The \"{mot}\" file is unreadable."))
    finally:
        os.close(fd)
    if len(donnees) > MAX_OCTETS:
        raise Echec(T(f"Le fichier « {mot} » est trop gros (64 Kio au plus).", f"The \"{mot}\" file is too big (64 KiB at most)."))
    pas_pem = Echec(T(f"Le fichier « {mot} » n'est pas un PEM texte (-----BEGIN … -----END) : un pkcs12 ou un fichier binaire ne peut pas être mis dans le fichier. Convertis-le en PEM.",
                      f"The \"{mot}\" file is not a text PEM (-----BEGIN … -----END): a pkcs12 or binary file cannot be put into the file. Convert it to PEM."))
    try:
        texte = donnees.decode("utf-8")
    except UnicodeDecodeError:
        raise pas_pem
    if re.search(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", texte):
        raise pas_pem
    sortie, dedans, etiquette = [], False, ""
    for brute in texte.splitlines():
        ligne = brute.strip()
        m = re.fullmatch(r"-----BEGIN ([A-Za-z0-9 ]+)-----", ligne)
        if m:
            if dedans:
                raise pas_pem
            if m.group(1) not in PEM_PERMIS:
                raise Echec(T(f"Le fichier « {mot} » contient « {m.group(1)[:40]} », qui n'est pas un certificat ni une clé de VPN : refusé.",
                              f"The \"{mot}\" file contains \"{m.group(1)[:40]}\", which is not a VPN certificate or key: refused."))
            etiquette = m.group(1)
            dedans = True
        if dedans:
            if ligne.startswith("<"):                 # ne jamais laisser le fichier fermer notre bloc et ajouter des directives
                raise pas_pem
            sortie.append(ligne)
        m = re.fullmatch(r"-----END ([A-Za-z0-9 ]+)-----", ligne)
        if m:
            if not dedans or m.group(1) != etiquette:
                raise pas_pem
            dedans = False
    if dedans or not sortie:
        raise pas_pem
    return "\n".join(sortie) + "\n"


def mettre_en_ligne(texte, dossier):
    """Remplace chaque certificat donné par un chemin relatif (ca, cert, key, tls-auth, tls-crypt…) par un bloc <ca>…</ca>
    contenant le PEM du fichier, lu depuis `dossier`. Les chemins complets et « [inline] » sont laissés tels quels."""
    sortie, ferme = [], None
    for brute in texte.splitlines():
        ligne = brute.strip()
        if ferme is not None:                          # à l'intérieur d'un bloc <…> : recopié tel quel (verifier le relira)
            sortie.append(brute)
            if re.fullmatch(r"<\s*/\s*" + ferme + r"\s*>", ligne, re.I):
                ferme = None
            continue
        ouvre = re.fullmatch(r"<\s*([A-Za-z0-9_-]+)\s*>", ligne)
        if ouvre:
            ferme = re.escape(ouvre.group(1))
            sortie.append(brute)
            continue
        m = re.match(r"-{0,2}([A-Za-z][A-Za-z0-9_-]*)(?=$|[\s=])\s*(.*)$", ligne.replace('"', "").replace("'", "")) if ligne and ligne[0] not in "#;" else None
        if not m or m.group(1).lower() not in OVPN_FICHIERS:
            sortie.append(brute)
            continue
        mot = m.group(1).lower()
        try:
            jetons = shlex.split(ligne, comments=False)
        except ValueError:
            sortie.append(brute)                        # guillemets mal fermés : verifier tranchera
            continue
        if jetons and jetons[0].lstrip("-").lower() != mot or len(jetons) < 2:
            sortie.append(brute)
            continue
        arg = jetons[1]
        if arg == "[inline]" or arg.startswith("/"):
            sortie.append(brute)
            continue
        if mot == "pkcs12":
            raise Echec(T("Le certificat « pkcs12 » donné par un chemin relatif est un fichier binaire : il ne peut pas être mis dans le fichier. Convertis-le en PEM (blocs <ca>, <cert>, <key>) ou donne un chemin complet.",
                          "The \"pkcs12\" certificate given by a relative path is a binary file: it cannot be put into the file. Convert it to PEM (<ca>, <cert>, <key> blocks) or give a full path."))
        extra = jetons[2:]
        if mot in DIRECTION and len(extra) == 1 and extra[0] in ("0", "1"):
            sens = extra[0]
        elif extra:
            raise Echec(T(f"La directive « {mot} » a des arguments en plus du fichier : donne-lui seulement le fichier, ou mets le certificat dans le fichier.",
                          f"The \"{mot}\" directive has extra arguments after the file: give it the file only, or put the certificate into the file."))
        else:
            sens = None
        chemin = chemin_relatif_sur(dossier, arg)
        fichier_lisible(mot, chemin)
        sortie.append(f"<{mot}>")
        sortie.extend(lire_pem(mot, chemin).splitlines())
        sortie.append(f"</{mot}>")
        if sens is not None:
            sortie.append("key-direction " + sens)
    return "\n".join(sortie) + "\n"


def trousseau_dispo():
    return shutil.which("secret-tool") is not None


def attributs_nm(uuid):
    return ["xdg:schema", SCHEMA_NM, "connection-uuid", uuid, "setting-name", "vpn", "setting-key", "password"]


def lire_secret(uuid):
    """Le mot de passe du trousseau pour cette connexion, ou None (trousseau absent, fermé, entrée absente). Les arguments de
    secret-tool n'ont pas de secret ; il arrive sur sa sortie, jamais journalisée."""
    if not trousseau_dispo():
        return None
    try:
        r = subprocess.run(["secret-tool", "lookup"] + attributs_nm(uuid), capture_output=True, timeout=30,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C"))
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout:
        return None
    try:
        mdp = r.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if re.search("[\x00-\x1f\x7f\x85\u2028\u2029]", mdp):       # le passwd-file est d'une ligne par secret : \n, \r ou NUL en injecteraient une autre
        raise Echec(T("Le mot de passe du trousseau contient un saut de ligne ou un caractère de contrôle : connexion refusée. Réimporte le profil.",
                      "The keyring password contains a line break or a control character: connection refused. Import the profile again."))
    return mdp


def service_secret():
    """True / False : un service Secret (org.freedesktop.secrets) tourne ou peut être lancé par le bus de session ; None : on ne
    peut pas le savoir (ni gdbus ni busctl). Ne démarre rien : on interroge seulement le bus, avec un délai court."""
    env = dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C")
    nom = "org.freedesktop.secrets"
    if shutil.which("gdbus"):
        base = ["gdbus", "call", "--session", "--timeout", "3", "--dest", "org.freedesktop.DBus", "--object-path", "/org/freedesktop/DBus", "--method"]
        essais = [(base + ["org.freedesktop.DBus.NameHasOwner", nom], lambda o: "true" in o),
                  (base + ["org.freedesktop.DBus.ListActivatableNames"], lambda o: "'" + nom + "'" in o)]
    elif shutil.which("busctl"):
        base = ["busctl", "--user", "--timeout=3", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus"]
        essais = [(base + ["NameHasOwner", "s", nom], lambda o: o.split()[-1:] == ["true"]),
                  (base + ["ListActivatableNames"], lambda o: '"' + nom + '"' in o)]
    else:
        return None
    reponse = False
    for args, ok in essais:
        try:
            r = subprocess.run(args, capture_output=True, text=True, errors="replace", timeout=5, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0:
            reponse = True
            if ok(r.stdout):
                return True
    return False if reponse else None


def mot_de_passe_agent_owned(uuid):
    """Vrai si la connexion VPN garde son mot de passe chez un agent (password-flags=1)."""
    code, out, _ = nmcli(["-t", "-g", "vpn.data", "connection", "show", "uuid", uuid])
    return code == 0 and re.search(r"(^|[\s,])password-flags\s*=\s*1\s*(,|$)", out.strip().replace("\\", "")) is not None


def garder_secret(uuid, mdp):
    """Range le mot de passe dans le trousseau (service Secret du bus de session), avec les attributs que NetworkManager
    lit pour ce VPN. Le secret passe par l'entrée standard de secret-tool, jamais par ses arguments."""
    args = ["secret-tool", "store", "--label=" + "NetworkManager VPN " + uuid] + attributs_nm(uuid)
    try:
        r = subprocess.run(args, input=mdp.encode("utf-8"), capture_output=True, timeout=60,
                           env=dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C"))
    except subprocess.TimeoutExpired:
        raise Echec(T("Le trousseau n'a pas répondu à temps (est-il verrouillé ?) : import annulé.",
                      "The keyring did not answer in time (is it locked?): import cancelled."))
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("secret-tool n'a pas pu être lancé : import annulé.", "secret-tool could not be run: import cancelled."))
    if r.returncode != 0:
        detail = court(masquer((r.stderr or b"").decode("utf-8", "replace"), mdp))
        raise Echec(T("Le trousseau a refusé le mot de passe (service Secret absent, fermé ou refus) : import annulé.",
                      "The keyring refused the password (no Secret service, locked, or refused): import cancelled.")
                    + (" (" + detail + ")" if detail else ""))


def utilisateur():
    import getpass
    try:
        u = getpass.getuser()
    except Exception:
        u = ""
    if not re.fullmatch(r"[A-Za-z0-9._][A-Za-z0-9._-]*\$?", u or ""):
        raise Echec(T("Nom d'utilisateur introuvable.", "User name not found."))
    return u


def importer(chemin):
    nettoyer_abandonnes()
    nom, donnees = lire_fichier(chemin)
    texte = donnees.decode("utf-8", errors="replace")
    ext = os.path.splitext(nom)[1].lower()
    ident = mdp = None
    if ext == ".ovpn":
        texte, ident, mdp = extraire_auth(texte)          # le mot de passe quitte le texte ici : la copie n'en a plus
        # certificats relatifs lus depuis le dossier du .ovpn et mis en ligne ; le résultat complet repasse par verifier()
        texte = mettre_en_ligne(texte, os.path.dirname(os.path.realpath(chemin)))
        donnees = texte.encode("utf-8")
        if len(donnees) > MAX_OCTETS:
            raise Echec(T("Une fois les certificats mis dans le fichier, il dépasse 64 Kio : import refusé.",
                          "Once the certificates are put into the file, it exceeds 64 KiB: import refused."))
    typ = verifier(texte)
    if ext == ".ovpn" and typ == "wireguard":
        raise Echec(T("Un fichier .ovpn ne peut pas contenir une section WireGuard.", "An .ovpn file cannot contain a WireGuard section."))
    if not nmcli(["-t", "-f", "RUNNING", "general"])[1].strip() == "running":
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."))
    if mdp is not None and not trousseau_dispo():
        raise Echec(T("Ce fichier contient un mot de passe, à ranger dans le trousseau, mais secret-tool est absent (paquet libsecret sur Arch et Fedora, libsecret-tools sur Debian, secret-tool sur openSUSE). Import refusé.",
                      "This file holds a password, to be stored in the keyring, but secret-tool is missing (libsecret package on Arch and Fedora, libsecret-tools on Debian, secret-tool on openSUSE). Import refused."))
    if mdp is not None and service_secret() is False:
        raise Echec(T("Ce fichier contient un mot de passe, à ranger dans le trousseau, mais aucun service Secret ne répond sur le bus de la session. "
                      "Installe et lance un trousseau : gnome-keyring (Arch, Debian, Fedora, openSUSE : paquet gnome-keyring), ou KeePassXC (paquet keepassxc) "
                      "avec l'intégration Secret Service activée. Import refusé.",
                      "This file holds a password, to be stored in the keyring, but no Secret service answers on the session bus. "
                      "Install and start a keyring: gnome-keyring (Arch, Debian, Fedora, openSUSE: package gnome-keyring), or KeePassXC (package keepassxc) "
                      "with the Secret Service integration enabled. Import refused."))
    user = utilisateur()
    avant = {c["uuid"] for c in etat().get("connexions", [])}
    sur = re.sub(r"[^A-Za-z0-9._-]", "_", nom)[:60] or "vpn" + ext
    d = dossier_prive()
    copie = os.path.join(d, sur)
    try:
        fd = os.open(copie, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(donnees)
        except OSError:
            raise Echec(T("Impossible d'écrire la copie temporaire.", "Could not write the temporary copy."))
        os.chmod(copie, 0o600)
        code, out, err = nmcli(["connection", "import", "type", typ, "file", copie], delai=60)
        if code != 0:
            msg = masquer(court(err or out), mdp).replace(copie, nom).replace(d, "")
            raise Echec(T("NetworkManager a refusé l'import", "NetworkManager refused the import") + (" (" + msg + ")" if msg else "") + ".")
        m = re.search(r"\(([0-9a-fA-F-]{36})\)", out)
        u = m.group(1).lower() if m and UUID.fullmatch(m.group(1)) else ""
        if not u:                                    # message inattendu : la nouvelle connexion se trouve par différence
            nouvelles = [c["uuid"] for c in etat().get("connexions", []) if c["uuid"] not in avant]
            u = nouvelles[0] if len(nouvelles) == 1 else ""
        if not u:
            raise Echec(T("Import fait, mais la connexion n'a pas été retrouvée : règle-la dans NetworkManager.",
                          "Imported, but the connection was not found: set it up in NetworkManager."))
    finally:
        shutil.rmtree(d, ignore_errors=True)
    modif = ["connection", "modify", "uuid", u, "connection.autoconnect", "no", "connection.permissions", "user:" + user]
    if ident is not None:    # le mot de passe sera gardé par le trousseau de l'utilisateur (« agent-owned »), pas par NetworkManager
        modif += ["+vpn.data", "username=" + ident + ",password-flags=1"]
    code, _, _ = nmcli(modif)
    if code != 0:
        nmcli(["connection", "delete", "uuid", u])   # jamais une connexion importée qui se lancerait seule ou serait ouverte à tous
        raise Echec(T("Impossible de rendre la connexion privée : import annulé.", "Could not make the connection private: import cancelled."))
    if mdp is not None:
        try:
            garder_secret(u, mdp)
        except Echec:
            nmcli(["connection", "delete", "uuid", u])   # pas de connexion sans son mot de passe
            raise
    c = next((x for x in etat().get("connexions", []) if x["uuid"] == u), None)
    print(T(f"Importé : {c['nom'] if c else nom} ({u}), privé à {user}, sans connexion automatique.",
            f"Imported: {c['nom'] if c else nom} ({u}), private to {user}, no autoconnect."))


# ── Indicateur de la pilule : le tunnel réellement monté, fournisseur et pays déduits des noms, sans réseau ────────
# Table des fournisseurs (motif cherché, sans tenir compte des majuscules, dans le NOM de la connexion puis dans l'INTERFACE).
# Un client installé mais pas monté n'apparaît jamais ici : seules les connexions ACTIVES de NetworkManager sont regardées.
# Aucun motif => fournisseur vide, et la pilule ne montre que le nom de la connexion (texte brut, borné).
# Exemples de noms : « ProtonVPN FR#12 », « mullvad-fr1 », « fr123.nordvpn.com.udp ».
_D, _F = r"(?<![a-z0-9])", r"(?![a-z0-9])"
FOURNISSEURS = (
    ("Proton VPN", r"proton"),                              # interface proton0, nom « ProtonVPN FR#12 »
    # Mullvad : interface wg-mullvad, nom « mullvad-fr1 », ou nom d'un fichier du générateur WireGuard de Mullvad (« se-got-wg-001 »,
    # pays-ville-wg-numéro) importé tel quel
    ("Mullvad", r"mullvad|" + _D + r"[a-z]{2}-[a-z]{3}-(wg|ovpn|br)-[0-9]{2,3}" + _F),
    ("NordVPN", r"nordvpn|nordlynx|" + _D + r"nord" + _F),  # interface nordlynx, nom « fr123.nordvpn.com.udp »
    ("Surfshark", r"surfshark"),
    ("ExpressVPN", r"express\s*vpn|lightway"),
    ("Private Internet Access", r"private\s*internet\s*access|" + _D + r"pia" + _F),
    ("Windscribe", r"windscribe"),
    ("CyberGhost", r"cyberghost"),
    ("IVPN", _D + r"ivpn" + _F),
    ("AirVPN", r"air\s*vpn"),
)
# Codes pays ISO 3166-1 à deux lettres (une valeur doit y figurer pour devenir un pays) ; « UK » est lu comme « GB ».
ISO_PAYS = frozenset(("AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ "
                      "CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR "
                      "GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP "
                      "KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT "
                      "MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW "
                      "SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG "
                      "UM US UY UZ VA VC VE VG VI VN VU WF WS YE YT ZA ZM ZW").split())
MOTS_PAYS = re.compile(r"[^A-Za-z0-9]+")


def fournisseur_de(nom, interface):
    for libelle, motif in FOURNISSEURS:
        if re.search(motif, nom or "", re.I) or re.search(motif, interface or "", re.I):
            return libelle
    return ""


def pays_de(nom):
    """Le code pays (deux lettres, validé) d'un nom de connexion, sinon vide. Un mot compte s'il est tout en majuscules (« FR »,
    « FR#12 »), ou en minuscules suivi de chiffres (« fr1 », « fr123 »), ou s'il est le premier mot (« fr-par-wg-001 »). Les mots
    courts ordinaires (« it », « in », « no », « my »…) ne comptent donc pas au milieu d'un nom."""
    mots = [m for m in MOTS_PAYS.split(nom or "") if m]
    for i, m in enumerate(mots):
        g = re.fullmatch(r"([A-Za-z]{2})([0-9]*)", m)
        if not g:
            continue
        lettres, chiffres = g.group(1), g.group(2)
        if not (lettres.isupper() or (lettres.islower() and (chiffres or i == 0))):
            continue
        code = "GB" if lettres.upper() == "UK" else lettres.upper()
        if re.fullmatch(r"[A-Z]{2}", code) and code in ISO_PAYS:
            return code
    return ""


def nom_borne(nom, n=40):
    """Texte brut sans caractère de contrôle, de 40 signes au plus."""
    propre = "".join(" " if (ord(c) < 32 or 0x7f <= ord(c) < 0xa0) else c for c in (nom or "")).strip()
    return propre[:n]


def indicateur():
    """Le premier tunnel ACTIF de NetworkManager (un seul appel nmcli). Aucune géolocalisation, aucun secret, aucun débit.
    Sans tunnel NetworkManager monté, et seulement si la commande `mullvad` existe : l'état de l'application officielle Mullvad
    (un `mullvad status --json`, 2 s au plus). Un tunnel NetworkManager réellement monté passe toujours avant. « mullvad » dit
    seulement si l'application est installée (la pilule en tire sa veille `mullvad status listen`)."""
    e = etat()
    mv = shutil.which("mullvad") is not None
    rien = {"disponible": e["disponible"], "actif": False, "fournisseur": "", "pays": "", "nom": "", "nombre": 0, "mullvad": mv}
    actives = e.get("actives") or []
    if not actives:
        if mv:
            m = mullvad_etat()
            if m["connecte"]:
                return {"disponible": True, "actif": True, "fournisseur": "Mullvad", "pays": m["pays"], "nom": "Mullvad",
                        "nombre": 1, "mullvad": True}
        return rien
    c = actives[0]
    return {"disponible": True, "actif": True, "fournisseur": fournisseur_de(c["nom"], c["interface"]),
            "pays": pays_de(c["nom"]), "nom": nom_borne(c["nom"]), "nombre": len(actives), "mullvad": mv}


# ── Application officielle Mullvad (commande `mullvad`, démon mullvad-daemon ; son tunnel est hors de NetworkManager) ──────
# Option retenue : `mullvad status --json` (-j, présente dans mullvad-cli 2025.14 et dans mullvad-cli/src/cmds/status.rs du dépôt
# officiel github.com/mullvad/mullvadvpn-app). Le numéro de compte n'est JAMAIS lu : ni `mullvad account get`, ni aucun champ
# de sortie gardé (seuls l'état, le pays et le nom du relais sont extraits) ; toute longue suite de chiffres vue dans un message
# est remplacée avant d'être montrée. Tout en argv, 2 s au plus pour une lecture.
def mullvad(args, delai=2):
    """(code, sortie, erreur) de `mullvad` lancé en arguments. 127 : commande absente."""
    exe = shutil.which("mullvad")
    if not exe:
        return 127, "", ""
    try:
        r = subprocess.run([exe] + args, capture_output=True, text=True, errors="replace", timeout=delai,
                           env=dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C"), stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return 126, "", ""
    return r.returncode, r.stdout, r.stderr


def epure(texte):
    """Retire d'un message toute suite de 12 chiffres ou plus (même séparés par des espaces ou tirets) : un numéro de compte."""
    return re.sub(r"(?:[0-9][ -]?){12,}", "[…]", texte or "")


RELAIS = re.compile(r"(?<![a-z0-9])([a-z]{2})-[a-z]{3}-(?:wg|ovpn|br|bridge)-[0-9]{2,3}(?![a-z0-9])", re.I)


def mullvad_etat():
    """{"installe", "connecte", "pays", "hote"} d'après `mullvad status --json`. Le JSON est celui du démon (état « connected »
    sous la clé « state » ; le relais est cherché dans les textes de « details »). Sans JSON lisible, la sortie texte
    (« Connected … Relay: se-got-wg-004 ») sert de secours. Rien d'autre n'est gardé."""
    res = {"installe": shutil.which("mullvad") is not None, "connecte": False, "pays": "", "hote": ""}
    if not res["installe"]:
        return res
    code, out, _ = mullvad(["status", "--json"])
    if code != 0:
        code, out, _ = mullvad(["status"])
        if code != 0:
            return res
        res["connecte"] = bool(re.match(r"\s*connected", out, re.I))
        out_texte = out
    else:
        out_texte = ""
        try:
            d = json.loads(out)
        except ValueError:
            d = None
        if isinstance(d, dict):
            res["connecte"] = str(d.get("state", "")).lower() == "connected"
            out_texte = " ".join(chaines(d.get("details")))
        else:
            res["connecte"] = bool(re.match(r"\s*connected", out, re.I))
            out_texte = out
    if res["connecte"]:
        m = RELAIS.search(out_texte)
        if m:
            res["hote"] = m.group(0).lower()
            res["pays"] = m.group(1).upper() if m.group(1).upper() in ISO_PAYS else ""
        if not res["pays"]:
            res["pays"] = code_pays_json(out)
    return res


def chaines(v, profondeur=0):
    """Tous les textes d'une valeur JSON (au plus 4 niveaux), pour y chercher un nom de relais."""
    if profondeur > 4:
        return []
    if isinstance(v, str):
        return [v[:200]]
    if isinstance(v, dict):
        return [t for x in v.values() for t in chaines(x, profondeur + 1)]
    if isinstance(v, list):
        return [t for x in v[:20] for t in chaines(x, profondeur + 1)]
    return []


def code_pays_json(brut):
    """Un code pays à deux lettres porté par une clé « country_code » du JSON du démon, validé ; sinon vide."""
    m = re.search(r'"country_code"\s*:\s*"([A-Za-z]{2})"', brut or "")
    return m.group(1).upper() if m and m.group(1).upper() in ISO_PAYS else ""


def mullvad_agir(a):
    """connecter | deconnecter | pays CC : en arguments seulement ; CC doit être ^[a-z]{2}$ (et un code ISO)."""
    if not shutil.which("mullvad"):
        raise Echec(T("L'application Mullvad n'est pas installée.", "The Mullvad app is not installed."))
    if a == ["connecter"]:
        args, ok = ["connect"], T("Mullvad : connexion demandée.", "Mullvad: connection requested.")
    elif a == ["deconnecter"]:
        args, ok = ["disconnect"], T("Mullvad : déconnecté.", "Mullvad: disconnected.")
    elif len(a) == 2 and a[0] == "pays":
        if not re.fullmatch(r"[a-z]{2}", a[1]) or a[1].upper() not in ISO_PAYS:
            raise Echec(T("Code pays invalide (deux lettres minuscules, par exemple « fr »).", "Invalid country code (two lowercase letters, e.g. \"fr\")."))
        args, ok = ["relay", "set", "location", a[1]], T(f"Mullvad : pays choisi, {a[1]}.", f"Mullvad: country set to {a[1]}.")
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)
    code, _, err = mullvad(args, delai=30)
    if code != 0:
        msg = court(epure(err))
        raise Echec(T("Mullvad a refusé", "Mullvad refused") + (" (" + msg + ")" if msg else "") + ".")
    print(ok)


def mullvad_json():
    """L'état pour le panneau : celui de mullvad_etat() et « compte » (connecté au compte : oui, non, ou null si inconnu).
    Le texte de `mullvad status` n'est lu que pour y trouver l'avertissement « not logged in » ; il n'est pas gardé."""
    e = mullvad_etat()
    e["compte"] = None
    if e["installe"] and not e["connecte"]:
        code, out, err = mullvad(["status"])
        if code == 0 or out or err:
            e["compte"] = not re.search(r"not logged in", out + err, re.I)
    elif e["connecte"]:
        e["compte"] = True
    return e


# ── IP publique (à la demande de l'île, jamais en boucle) ──────────────────────────────────────────────────────
def reglage(cle, defaut=""):
    try:
        with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8", errors="replace") as f:
            val = defaut
            for x in f:
                if x.startswith(cle + "="):
                    val = x.split("=", 1)[1].strip().strip('"')
            return val
    except OSError:
        return defaut


def ip_publique():
    if reglage("VPN_IP_PUBLIQUE", "non") != "oui":
        print(json.dumps({"ip": ""}))
        return
    url = reglage("VPN_IP_SERVICE", "")
    p = urllib.parse.urlsplit(url)
    if p.scheme != "https" or not p.hostname or p.username or p.password:
        print(json.dumps({"ip": "", "erreur": T("adresse du service absente ou pas en https", "service address missing or not https")}))
        return
    try:
        class PasDeRedirection(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *a, **k):
                return None
        ouvre = urllib.request.build_opener(PasDeRedirection)
        with ouvre.open(urllib.request.Request(url, headers={"User-Agent": "nc-vpn"}), timeout=8) as r:
            brut = r.read(256).decode("ascii", errors="ignore").strip()
    except Exception:
        print(json.dumps({"ip": "", "erreur": T("service injoignable", "service unreachable")}))
        return
    import ipaddress
    try:
        ip = str(ipaddress.ip_address(brut))
    except ValueError:
        print(json.dumps({"ip": "", "erreur": T("réponse inattendue", "unexpected answer")}))
        return
    print(json.dumps({"ip": ip}))


# ── Kill switch : bloquer toute sortie hors du tunnel monté (réglage VPN_KILLSWITCH, coupé par défaut) ───────────────
# Tout le pare-feu est fait par l'assistant root system/nc-vpn-root (table nft « inet nc_vpn » à lui seul), appelé par
# « sudo -n » avec des arguments déjà validés ici ET là-bas. Ici : trouver le VRAI tunnel (TUN/TAP ou WireGuard) et ses
# endpoints (adresses IP) ; jamais de nom d'hôte résolu par nous, jamais de root, jamais de shell.
SYSFS = os.environ.get("NC_VPN_SYSFS", "/sys")                   # NC_VPN_SYSFS : un faux /sys, pour les tests
ROOT_VPN = os.environ.get("NC_VPN_ROOT", "/usr/local/bin/nc-vpn-root")
GDBUS_NM = ["gdbus", "call", "--system", "--dest", "org.freedesktop.NetworkManager"]


def limites():
    return [T("Ne dure pas après un redémarrage (à réactiver ensuite).", "Does not survive a reboot (enable it again afterwards)."),
            T("Ne couvre pas le forwarding des conteneurs ni des machines virtuelles.", "Does not cover container or virtual machine forwarding."),
            T("À couper pour changer de serveur : les adresses du serveur sont figées à l'activation.",
              "Turn it off to change server: the server addresses are fixed when you enable it."),
            T("Un seul serveur (pas de multi-remote) ; un tunnel doit être monté avant d'activer.",
              "One server only (no multi-remote); a tunnel must be up before enabling."),
            T("Le réseau local (sous-réseaux de tes cartes, /16 au plus large) reste joignable (sauf le DNS).",
              "Your local network (your cards' subnets, /16 at most) stays reachable (except DNS)."),
            T("Un rechargement de nftables (systemctl reload nftables, nft flush ruleset) efface la protection.",
              "Reloading nftables (systemctl reload nftables, nft flush ruleset) wipes the protection."),
            T("En cas de souci, depuis un terminal : sudo nft delete table inet nc_vpn",
              "If anything goes wrong, from a terminal: sudo nft delete table inet nc_vpn")]


def iface_tunnel(nom):
    """Vrai si /sys/class/net/NOM est un TUN/TAP (tun_flags) ou un WireGuard (DEVTYPE=wireguard)."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", nom or "") or not nom.strip("."):
        return False
    d = os.path.join(SYSFS, "class/net", nom)
    try:
        if os.path.isfile(os.path.join(d, "tun_flags")):
            return True
        with open(os.path.join(d, "uevent"), encoding="utf-8", errors="replace") as f:
            return "DEVTYPE=wireguard" in f.read().split()
    except OSError:
        return False


def sortie_ip_json():
    exe = shutil.which("ip")
    if not exe:
        return []
    try:
        r = subprocess.run([exe, "-j", "addr"], capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
        d = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    return d if isinstance(d, list) else []


def tunnel_de(c):
    """Le vrai tunnel d'une connexion montée. NetworkManager donne parfois le Wi-Fi comme « device » d'un OpenVPN : on retrouve
    alors le tun par les adresses que NetworkManager a données à la connexion, jamais « l'unique tunnel du système » (ce pourrait être tailscale0 ou le TAP d'une machine virtuelle)."""
    import ipaddress
    if iface_tunnel(c["interface"]):
        return c["interface"]
    code, out, _ = nmcli(["-t", "-g", "IP4.ADDRESS,IP6.ADDRESS", "connection", "show", "uuid", c["uuid"]])
    adr = set()
    for m in re.finditer(r"([0-9A-Fa-f:.]+)/[0-9]{1,3}", out if code == 0 else ""):
        try:
            adr.add(ipaddress.ip_address(m.group(1)))
        except ValueError:
            pass
    trouves = []
    for itf in sortie_ip_json():
        nom = itf.get("ifname") if isinstance(itf, dict) else None
        if not isinstance(nom, str) or not iface_tunnel(nom):
            continue
        for a in itf.get("addr_info") or []:
            try:
                if ipaddress.ip_address(a.get("local")) in adr:
                    trouves.append(nom)
            except (ValueError, TypeError):
                pass
    trouves = sorted(set(trouves))
    if len(trouves) == 1:
        return trouves[0]
    raise Echec(T("Impossible de retrouver l'interface du tunnel (TUN/TAP ou WireGuard) de cette connexion.",
                  "Could not find the tunnel interface (TUN/TAP or WireGuard) of this connection."))


def ip_ou_refus(texte, port, proto):
    import ipaddress
    brut = texte.strip("[]")
    try:
        # Même validation que l'assistant root : avant ipaddress (qui accepte « %zone » avec n'importe quel signe)
        if not re.fullmatch(r"[0-9A-Fa-f:.]{2,45}", brut):
            raise ValueError(brut)
        ip = ipaddress.ip_address(brut)
        if getattr(ip, "scope_id", None) or ip.is_link_local or ip.is_unspecified or ip.is_loopback or ip.is_multicast:
            raise ValueError(brut)
    except ValueError:
        raise Echec(T("L'adresse du serveur est un nom (« %s ») : le kill switch demande une adresse IP. Mets l'adresse IP du serveur dans la connexion."
                      % court(texte, 60), "The server address is a name (\"%s\"): the kill switch needs an IP address. Put the server's IP address in the connection."
                      % court(texte, 60)))
    return "%s@%d/%s" % (ip, port, proto)


def endpoints_openvpn(uuid):
    code, out, _ = nmcli(["-t", "-g", "vpn.data", "connection", "show", "uuid", uuid])
    if code != 0:
        raise Echec(T("Réglages de la connexion illisibles.", "Could not read the connection settings."))
    d = {}
    for m in re.split(r",\s*(?=[A-Za-z0-9_.-]+\s*=)", out.strip().replace("\\", "")):
        k, _, v = m.partition("=")
        d[k.strip()] = v.strip()
    entrees = [e.strip() for e in d.get("remote", "").split(",") if e.strip()]
    if not entrees:
        raise Echec(T("Pas d'adresse de serveur (remote) dans la connexion.", "No server address (remote) in the connection."))
    if len(entrees) > 1:
        raise Echec(T("Plusieurs serveurs (multi-remote) : le kill switch n'en gère qu'un.", "Several servers (multi-remote): the kill switch handles only one."))
    e = entrees[0]
    import ipaddress
    try:
        ipaddress.ip_address(e)
        hote, port, proto = e, None, None
    except ValueError:
        m = re.fullmatch(r"\[([^\]]+)\](?::([0-9]+))?(?::([A-Za-z0-9-]+))?", e)
        if m:
            hote, port, proto = m.groups()
        else:
            p = e.split(":")
            hote, port, proto = p[0], (p[1] if len(p) > 1 else None), (p[2] if len(p) > 2 else None)
    port = port or d.get("port") or "1194"
    proto = proto or ("tcp" if d.get("proto-tcp", "no") == "yes" else "udp")
    if not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
        raise Echec(T("Port du serveur invalide.", "Invalid server port."))
    return [ip_ou_refus(hote, int(port), "tcp" if proto.startswith("tcp") else "udp")]


def endpoints_wireguard(uuid):
    if not shutil.which("gdbus"):
        raise Echec(T("gdbus est absent (paquet glib2 / libglib2.0-bin) : impossible de lire les pairs WireGuard.",
                      "gdbus is missing (glib2 / libglib2.0-bin package): cannot read the WireGuard peers."))

    def appel(chemin, methode, *args):
        try:
            r = subprocess.run(GDBUS_NM + ["--object-path", chemin, "--method", methode] + list(args), capture_output=True, text=True,
                               timeout=8, stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C"))
        except (OSError, subprocess.SubprocessError):
            return ""
        return r.stdout if r.returncode == 0 else ""
    sortie = appel("/org/freedesktop/NetworkManager/Settings", "org.freedesktop.NetworkManager.Settings.GetConnectionByUuid", uuid)
    m = re.search(r"'(/org/freedesktop/NetworkManager/Settings/[0-9]+)'", sortie)
    if not m:
        raise Echec(T("Connexion introuvable chez NetworkManager.", "Connection not found in NetworkManager."))
    reglages = appel(m.group(1), "org.freedesktop.NetworkManager.Settings.Connection.GetSettings")
    brut = re.findall(r"'endpoint': <'([^']+)'>", reglages)
    if not brut:
        raise Echec(T("Aucun serveur (endpoint) dans la connexion WireGuard.", "No server (endpoint) in the WireGuard connection."))
    res = []
    for b in brut[:8]:
        hote, _, port = b.rpartition(":")
        if not hote or not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
            raise Echec(T("Adresse de serveur WireGuard invalide.", "Invalid WireGuard server address."))
        res.append(ip_ou_refus(hote, int(port), "udp"))
    return res


def resoudre_tunnel():
    """{"tunnel", "nom", "endpoints"} du tunnel monté, ou un refus (Echec) qui dit pourquoi."""
    e = etat()
    if not e["disponible"]:
        raise Echec(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."))
    actives = e["actives"]
    if not actives:
        if mullvad_etat()["connecte"]:
            raise Echec(T("Mullvad est connecté : utilise sa protection, `mullvad lockdown-mode set on`.",
                          "Mullvad is connected: use its own protection, `mullvad lockdown-mode set on`."))
        raise Echec(T("Aucun tunnel monté : monte d'abord un tunnel, puis active le kill switch.", "No tunnel is up: bring one up first, then enable the kill switch."))
    if len(actives) > 1:
        raise Echec(T("Plusieurs tunnels montés : le kill switch n'en protège qu'un seul, coupe les autres.",
                      "Several tunnels are up: the kill switch protects only one, bring the others down."))
    c = actives[0]
    iface = tunnel_de(c)
    eps = endpoints_wireguard(c["uuid"]) if c["type"] == "wireguard" else endpoints_openvpn(c["uuid"])
    return {"tunnel": iface, "nom": c["nom"], "endpoints": eps}


def appeler_root(args):
    """(code, sortie, erreur) de « sudo -n nc-vpn-root ARGS » ; Echec clair si l'assistant ou sudo manque."""
    if not os.path.exists(ROOT_VPN):
        raise Echec(T("L'assistant du kill switch n'est pas installé : lance install.sh pour le poser (avec ton accord).",
                      "The kill switch helper is not installed: run install.sh to set it up (with your consent)."))
    sudo = shutil.which("sudo")
    if not sudo:
        raise Echec(T("sudo est absent.", "sudo is missing."))
    try:
        r = subprocess.run([sudo, "-n", ROOT_VPN] + args, capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        raise Echec(T("L'assistant du kill switch n'a pas répondu.", "The kill switch helper did not answer."))
    if r.returncode != 0 and re.search(r"password is required|may not run sudo|not allowed|a terminal is required", r.stderr, re.I):
        raise Echec(T("La règle sudo de l'assistant manque : relance install.sh pour la poser (avec ton accord).",
                      "The helper's sudo rule is missing: run install.sh again to set it up (with your consent)."))
    return r.returncode, r.stdout, r.stderr


def message_root(err):
    return re.sub(r"^nc-vpn-root:\s*", "", court(err, 240))


def assistant_installe():
    """L'assistant est posé ET la règle sudo existe : « sudo -n -l ASSISTANT etat » (en argv, sans mot de passe) ne lance rien,
    il demande seulement à sudo si cette commande exacte est permise. Faux sinon : « pas installé », pas « inconnu »."""
    if not os.path.exists(ROOT_VPN):
        return False
    sudo = shutil.which("sudo")
    if not sudo:
        return False
    try:
        r = subprocess.run([sudo, "-n", "-l", ROOT_VPN, "etat"], capture_output=True, text=True, timeout=15, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def killswitch_etat():
    """True / False d'après l'assistant (« etat »), None si inconnu (l'assistant ne répond pas)."""
    try:
        code, out, _ = appeler_root(["etat"])
    except Echec:
        return None
    if code != 0:
        return None
    return out.strip() == "actif"


def killswitch(a, en_json=False):
    if a == ["limites"]:
        for l in limites():
            print("- " + l)
    elif a == ["activer"]:
        if reglage("VPN_KILLSWITCH", "non") != "oui":
            raise Echec(T("Le kill switch est coupé dans les réglages (nc-reglages → Île → VPN : kill switch, VPN_KILLSWITCH).",
                          "The kill switch is off in the settings (nc-settings → Island → VPN: kill switch, VPN_KILLSWITCH)."), "killswitch_coupe")
        if not en_json:
            print(T("Limites du kill switch :", "Kill switch limits:"))
            for l in limites():
                print("- " + l)
        t = resoudre_tunnel()
        code, out, err = appeler_root(["activer", t["tunnel"]] + t["endpoints"])
        if code != 0:
            raise Echec(T("Kill switch refusé : ", "Kill switch refused: ") + message_root(err), "killswitch_refuse")
        if en_json:
            return sortie_json({"action": "killswitch-activer", "actif": True})
        print(T("Kill switch actif : tout ce qui sort hors du tunnel %s est bloqué." % t["tunnel"],
                "Kill switch on: everything leaving outside tunnel %s is blocked." % t["tunnel"]))
    elif a == ["desactiver"]:
        code, out, err = appeler_root(["desactiver"])
        if code != 0:
            raise Echec(T("Impossible de couper le kill switch : ", "Could not turn the kill switch off: ") + message_root(err)
                        + T(" (en terminal : sudo nft delete table inet nc_vpn)", " (in a terminal: sudo nft delete table inet nc_vpn)"),
                        "killswitch_refuse")
        if en_json:
            return sortie_json({"action": "killswitch-desactiver", "actif": False})
        print(T("Kill switch coupé.", "Kill switch off."))
    elif a == ["etat"]:
        if not assistant_installe():
            print(T("Kill switch : pas installé (l'assistant se pose avec ton accord : install.sh --seulement killswitch)",
                    "Kill switch: not installed (the helper is set up with your consent: install.sh --seulement killswitch)"))
            return
        s = killswitch_etat()
        print(T("Kill switch : ", "Kill switch: ") + (T("actif", "on") if s else T("inactif", "off") if s is False else T("inconnu", "unknown")))
    elif a == ["etat-json"]:
        installe = assistant_installe()
        actif = killswitch_etat() if installe else None
        refus = ""
        if not installe:
            refus = T("Pas installé : l'assistant se pose avec ton accord (install.sh --seulement killswitch).",
                      "Not installed: the helper is set up with your consent (install.sh --seulement killswitch).")
        elif actif is not True:
            try:
                resoudre_tunnel()
            except Echec as e:
                refus = str(e)
        print(json.dumps({"contrat": CONTRAT, "installe": installe, "voulu": reglage("VPN_KILLSWITCH", "non") == "oui", "actif": actif,
                          "refus": refus, "limites": limites()}, ensure_ascii=False))
    else:
        print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
        sys.exit(2)


ALIAS = {"status": "etat-json", "connect": "connecter", "disconnect": "deconnecter"}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "aide", "help"):
        return print(T(__doc__.strip(), USAGE_EN))
    # Alias de compatibilité : ils se réécrivent en commande d'origine, puis passent par le MÊME code (aucune logique en double)
    if a[:2] == ["status", "--json"] and len(a) == 2:
        a = ["etat-json"]
    elif a[0] in ALIAS and a[0] != "status":
        a = [ALIAS[a[0]]] + a[1:]
    cmd = a[0]
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, arret_propre)
    en_json = a[-1:] == ["--json"] and cmd in ("connecter", "deconnecter", "tout-deconnecter", "killswitch")
    if en_json:
        a = a[:-1]
    try:
        if cmd == "etat-json" and len(a) == 1:
            print(json.dumps(dict({"contrat": CONTRAT}, **etat()), ensure_ascii=False))
        elif cmd == "liste" and len(a) == 1:
            e = etat()
            if not e["disponible"]:
                return print(T("NetworkManager n'est pas disponible.", "NetworkManager is not available."))
            for c in e["connexions"]:
                print(("* " if c["active"] else "  ") + c["nom"] + "  [" + c["type"] + "]" + ("  " + c["interface"] if c["interface"] else "") + "  " + c["uuid"])
        elif cmd in ("connecter", "deconnecter") and len(a) == 2:
            agir_connexion(cmd, a[1], en_json)
        elif cmd == "tout-deconnecter" and len(a) == 1:
            agir_tout(en_json)
        elif cmd == "importer" and len(a) == 2:
            importer(a[1])
        elif cmd == "indicateur" and a[1:] == ["--json"]:
            print(json.dumps(indicateur(), ensure_ascii=False))
        elif cmd == "mullvad" and a[1:] == ["etat-json"]:
            print(json.dumps(mullvad_json(), ensure_ascii=False))
        elif cmd == "mullvad" and len(a) >= 2:
            mullvad_agir(a[1:])
        elif cmd == "killswitch":
            killswitch(a[1:], en_json)
        elif cmd == "ip-publique" and len(a) == 1:
            ip_publique()
        else:
            print(T(__doc__.strip(), USAGE_EN), file=sys.stderr)
            sys.exit(2)
    except Echec as e:
        if en_json:      # le contrat : l'erreur est un objet JSON sur la sortie standard, code de sortie 1
            print(json.dumps({"contrat": CONTRAT, "ok": False, "code": e.code, "erreur": str(e)}, ensure_ascii=False))
        else:
            print("nc-vpn : " + str(e), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
