#!/bin/sh
# nc-presse-capture : lancé par l'île à chaque copie (wl-paste --watch). Une ligne par copie, sur la sortie standard :
#   T:<texte sur une ligne, retours à la ligne remplacés par \037>      texte (4 000 caractères au plus, « … » s'il est coupé)
#   I:<octets>:<identifiant>:<chemin>                                   image PNG, gardée en fichier privé (0600) par
#                                                                       nc-ile-memo dans ~/.local/state/nc/ile/images
#                                                                       (l'identifiant vient de l'empreinte du contenu)
# Rien pour une copie de la dictée ou un mot de passe de nc-mdp (marques nc-dictee-copie, nc-secret-copie de moins de 5 s) ni pour ce qu'un gestionnaire de mots de passe marque comme secret (x-kde-passwordManagerHint, x-nc-secret), ni pour la sélection déjà là quand la veille démarre.
# Le contenu n'est jamais journalisé.
# Une copie de nc-dictee (texte dicté, marque datée de moins de 5 s) : jamais gardée dans l'historique
# Un argument inconnu ne lance rien : usage et code 2 (-h, --help, aide : usage et code 0)
if [ $# -gt 0 ]; then
  case "$1" in -h|--help|aide) echo "usage : nc-presse-capture (sans argument)"; exit 0 ;; esac
  echo "usage : nc-presse-capture (sans argument)" >&2; exit 2
fi
# La sélection déjà là quand la veille de l'île (re)démarre n'est jamais gardée : wl-paste --watch lance sa commande
# aussi pour elle (protocole data-control : « The first selection event is sent upon binding »). Elle est déjà dans
# l'historique, ou en a été exclue (mot de passe, dictée). L'île pose NC_PRESSE_VEILLE=1 ; le premier appel venu d'un
# nouveau wl-paste est celui-là : un fichier par veille, nc-presse-veille.<pid du wl-paste>, qui contient l'heure de
# départ de ce wl-paste (champ 22 de /proc/<pid>/stat) ; absent ou autre heure (pid réutilisé) : premier appel.
# Sans XDG_RUNTIME_DIR, ou /proc illisible : rien n'est gardé.
if [ "${NC_PRESSE_VEILLE:-}" = 1 ]; then
  [ -n "${XDG_RUNTIME_DIR:-}" ] || exit 0
  st=$(cat "/proc/$PPID/stat" 2>/dev/null) || exit 0
  # Compté après la dernière « ) » : le nom du processus peut contenir espaces et parenthèses
  h=$(printf '%s\n' "${st##*) }" | cut -d' ' -f20)
  case "$h" in ''|*[!0-9]*) exit 0 ;; esac
  v="$XDG_RUNTIME_DIR/nc-presse-veille.$PPID"
  p=""
  [ -f "$v" ] && [ ! -L "$v" ] && p=$(head -c 32 "$v" 2>/dev/null)
  if [ "$p" != "$h" ]; then
    # Ménage : les fichiers des veilles dont le wl-paste n'existe plus (pid tout en chiffres seulement)
    for f in "$XDG_RUNTIME_DIR"/nc-presse-veille.*; do
      q=${f##*/nc-presse-veille.}
      case "$q" in ''|*[!0-9]*) continue ;; esac
      [ -d "/proc/$q" ] || rm -f "$f" 2>/dev/null
    done
    # Écrit à côté (mktemp : 0600, création exclusive, préfixe hors du motif du ménage) puis renommé (mv -T : atomique ;
    # un lien posé à la place de « v » est remplacé, jamais suivi ; un dossier n'est jamais rempli)
    n=$(mktemp "$XDG_RUNTIME_DIR/nc-presse-veille-tmp.XXXXXX" 2>/dev/null) || exit 0
    { printf '%s\n' "$h" > "$n" && mv -fT "$n" "$v"; } 2>/dev/null || rm -f "$n"
    exit 0
  fi
fi
# Marques de moins de 5 s : copie de la dictée, ou mot de passe de nc-mdp (utile quand wl-copy n'a pas --sensitive).
# Âge de 0 à 4 s seulement : une marque datée dans le futur (horloge reculée) ne coupe pas l'historique.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  for m in "$XDG_RUNTIME_DIR/nc-dictee-copie" "$XDG_RUNTIME_DIR/nc-secret-copie"; do
    [ -e "$m" ] || continue
    d=$(stat -c %Y "$m" 2>/dev/null) || continue
    a=$(( $(date +%s) - d ))
    [ "$a" -ge 0 ] && [ "$a" -lt 5 ] && exit 0
  done
fi
t=$(wl-paste --list-types 2>/dev/null) || exit 0
case "$t" in *x-kde-passwordManagerHint*|*x-nc-secret*) exit 0 ;; esac
tmp=""
trap '[ -n "$tmp" ] && rm -f "$tmp"' EXIT
if printf '%s' "$t" | grep -q '^image/png'; then
  # Même image copiée plusieurs fois (recopier depuis l'île) : même identifiant, donc même entrée et même fichier.
  # Le contenu passe par un fichier temporaire privé (mktemp : 0600) pour en calculer l'empreinte (sha256sum, coreutils).
  tmp=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/nc-presse.XXXXXX" 2>/dev/null) || exit 0
  wl-paste -t image/png 2>/dev/null > "$tmp" || exit 0
  id=""
  if command -v sha256sum >/dev/null 2>&1; then
    h=$(sha256sum < "$tmp" 2>/dev/null | cut -c1-32)
    [ -n "$h" ] && id="h$h"
  fi
  [ -n "$id" ] || id="$(date +%s%N 2>/dev/null || date +%s)$$"
  p=$("${NC_ILE_MEMO:-$HOME/.local/bin/nc-ile-memo}" image "$id" < "$tmp") || exit 0
  [ -n "$p" ] && [ -f "$p" ] && printf 'I:%s:%s:%s\n' "$(wc -c < "$p")" "$id" "$p"
elif printf '%s' "$t" | grep -qE '^(text/plain|UTF8_STRING|STRING|TEXT)'; then
  printf 'T:'
  # 4 000 caractères (pas octets) : head -c coupait un caractère accentué en deux. python3 compte en caractères et
  # marche pareil sous dash ; ${x:0:n} n'existe pas en sh. Sans python3 : head -c puis iconv -c, qui retire le
  # morceau de caractère resté au bout. Un texte coupé finit par « … ». Le \r est retiré avant le tr : \r\n ne donne
  # qu'un séparateur.
  if command -v python3 >/dev/null 2>&1; then
    wl-paste --no-newline -t text 2>/dev/null | tr -d '\r' | python3 -c 'import sys
brut = sys.stdin.buffer.read(20001)
d = brut[:20000].decode("utf-8", "ignore")
coupe = len(d) > 4000 or len(brut) > 20000
sys.stdout.buffer.write((d[:4000] + ("…" if coupe else "")).encode("utf-8"))' | tr '\n' '\037'
  else
    tmp=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/nc-presse.XXXXXX" 2>/dev/null) || exit 0
    wl-paste --no-newline -t text 2>/dev/null | tr -d '\r' > "$tmp"
    { head -c 4000 "$tmp" | { iconv -c -f UTF-8 -t UTF-8 2>/dev/null || cat; }
      [ "$(wc -c < "$tmp")" -gt 4000 ] && printf '\342\200\246'; } | tr '\n' '\037'
  fi
  printf '\n'
fi
exit 0
