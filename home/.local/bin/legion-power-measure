#!/usr/bin/env bash
# legion-power-measure : consommation réelle sur batterie (moyenne sur N secondes, 30 par défaut).
# À lancer débranché, sans toucher au PC pendant la mesure. Lecture seule, aucun privilège.
set -uo pipefail
N="${1:-30}"
[[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -ge 5 ] || { echo "Usage : legion-power-measure [secondes ≥ 5]" >&2; exit 1; }
BAT=/sys/class/power_supply/BAT0
[ "$(cat $BAT/status)" = Discharging ] || { echo "Débranche le chargeur : la mesure ne marche que sur batterie (état : $(cat $BAT/status))." >&2; exit 1; }

echo "Mesure pendant $N s… (ne touche à rien)"
sum=0; min=999999999; max=0
for _ in $(seq "$N"); do
  p=$(cat $BAT/power_now)
  sum=$((sum + p)); [ "$p" -lt "$min" ] && min=$p; [ "$p" -gt "$max" ] && max=$p
  sleep 1
done
awk -v s="$sum" -v n="$N" -v a="$min" -v b="$max" 'BEGIN{printf "Consommation moyenne : %.1f W  (min %.1f / max %.1f)\n", s/n/1e6, a/1e6, b/1e6}'

prof=$(gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
  --method org.freedesktop.DBus.Properties.Get net.hadess.PowerProfiles ActiveProfile 2>/dev/null | sed -nE "s/^\(<'([a-z-]+)'>,\)$/\1/p")
echo "Profil : ${prof:-?} · plateforme $(cat /sys/firmware/acpi/platform_profile) · EPP $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference) · boost $(cat /sys/devices/system/cpu/cpufreq/boost)"
echo "RTX : $(cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status) · luminosité $(brightnessctl -d amdgpu_bl2 -m | cut -d, -f4)"
command -v hyprctl >/dev/null && echo "Écran : $(hyprctl monitors -j 2>/dev/null | jq -r 'map("\(.name) \(.refreshRate|floor) Hz") | join(", ")')"
users=$(for p in /proc/[0-9]*; do ls -l "$p/fd" 2>/dev/null | grep -q /dev/nvidia && cat "$p/comm"; done 2>/dev/null | sort -u | tr '\n' ' ')
[ -n "$users" ] && echo "Processus qui gardent la RTX allumée : $users"
echo "Processus les plus gourmands (CPU) :"
ps -eo pcpu,comm --sort=-pcpu | sed -n '2,6p'
