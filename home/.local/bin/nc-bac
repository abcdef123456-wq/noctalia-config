#!/usr/bin/env python3
"""nc-bac : le bac à sable systemd --user partagé par nc-noeud (session de confiance) et nc-ia (IA en ligne de commande).
Un seul endroit pour les listes de chemins secrets et la construction de la commande systemd-run : les deux tournent
dans le MÊME bac, avec les mêmes droits. Module chargé par ses appelants (SourceFileLoader, comme nc-assistant) ; ne
fait rien tout seul. Aucune dépendance : tout ce qui change d'un appelant à l'autre (HOME, lecture des réglages,
recherche d'un programme) est passé en paramètre."""
import os
import re
from pathlib import Path

# Chemins protégés (relatifs au dossier personnel), vérifiés après résolution des liens symboliques, appliqués même
# après un « Autoriser » (sur l'écran ou à distance).
# Lecture et écriture : clés, identifiants et secrets (navigateurs, trousseaux, CLI d'IA et de cloud, messageries, le
# serveur JARVIS local et son .env), et ce qui s'exécute au démarrage (services, démarrage automatique, shells).
PROTEGES = [".ssh", ".gnupg", ".config/systemd", ".local/share/systemd", ".config/autostart", ".config/environment.d",
            ".bashrc", ".bash_profile", ".bash_login", ".bash_logout", ".zshrc", ".zshenv", ".zprofile", ".zlogin",
            ".zlogout", ".profile", ".config/fish", ".xprofile", ".xinitrc", ".xsession", ".xsessionrc",
            ".pam_environment", ".config/nc/assistant.conf", ".config/nc/ia.conf",
            ".config/gh", ".config/hub", ".git-credentials", ".netrc", ".password-store", ".local/share/keyrings",
            ".local/share/kwalletd", ".mozilla", ".librewolf", ".zen", ".floorp", ".thunderbird", ".config/chromium",
            ".config/google-chrome", ".config/BraveSoftware", ".config/vivaldi", ".config/microsoft-edge",
            ".var/app/org.mozilla.firefox", ".var/app/org.chromium.Chromium", ".var/app/com.google.Chrome",
            ".var/app/com.brave.Browser", ".claude", ".claude.json", ".codex", ".gemini", ".config/opencode",
            ".local/share/opencode", ".aws", ".azure", ".config/gcloud", ".kube", ".docker", ".pgpass", ".npmrc",
            ".pypirc", ".cargo/credentials", ".cargo/credentials.toml", ".config/rclone",
            ".local/share/TelegramDesktop", ".config/discord", ".config/Signal", ".local/share/jarvis-bis",
            ".local/state/nc-jarvis/connection.conf", ".config/nc/assistant.conf.backup-*", ".config/nc/noeud-totp.json",
            # Noctalia : l'historique du presse-papier chiffré et sa clé (storage.key, à côté), l'historique des notifications
            # (codes SMS, messages) ; le dossier entier, car d'autres fichiers d'état y sont aussi privés. Le dossier de
            # JARVIS déployé ailleurs que par défaut est ajouté d'après ses unités (jarvis_dossiers)
            ".local/state/noctalia", ".cache/noctalia"]

# ── Bac à sable (exec en session de confiance) ────────────────────────────────────────────────────────────────────
# Une session de confiance fait sauter la confirmation de chaque commande ; un contrôle sur le texte de la commande se
# contourne toujours (une commande peut lire ~/.ssh, lancer sudo, ou simuler des frappes). On enferme donc tout exec de
# session dans une unité systemd --user transitoire (sans root) :
#   - PrivateUsers + NoNewPrivileges : pas d'élévation (sudo setuid refusé) ;
#   - ProtectHome=read-only + ReadOnlyPaths=~ : rien ne s'écrit dans ~ (sauf le dossier de travail en ReadWritePaths ;
#     ReadOnlyPaths couvre aussi un ~ sur tmpfs, que ProtectHome seul laisserait inscriptible) ;
#   - InaccessiblePaths : les secrets et la config deviennent illisibles (le réseau reste ouvert : tout ce qui se lit
#     peut partir), plus large que PROTEGES ;
#   - tout $XDG_RUNTIME_DIR inaccessible : bus systemd/D-Bus (sinon systemd-run --user relance une unité HORS du bac),
#     hypr (l'ipc de Hyprland lancerait une commande hors du bac), wayland (frappe simulée), agent ssh/gpg, trousseau,
#     quickshell, pipewire, tmux ;
#   - PrivateTmp : /tmp privé (X11 @/tmp/.X11-unix, sockets tmux sous /tmp) ;
#   - RestrictAddressFamilies=AF_INET AF_INET6 : plus aucun socket unix, donc plus de socket abstrait (X11, bus) → un
#     exec de session ne peut lancer aucune appli graphique (lancer une appli reste confirmé une par une) ;
#   - RuntimeMaxSec : tué à l'échéance, --collect nettoie l'unité.
#   - PrivateDevices + PrivateIPC : ni caméra, ni micro, ni GPU, ni périphériques d'entrée ; IPC SysV à part ;
# Vérifié dans le manager UTILISATEUR, sans root, sur systemd 262 (Arch) ; les propriétés existent depuis bien avant
# systemd 254 (openSUSE Leap 15.6, la plus ancienne visée). Toute erreur de mise en place (systemd-run absent, pas de
# bus utilisateur, namespaces refusés comme sur Ubuntu avec apparmor restrict_unprivileged_userns) → pas de session,
# confirmation normale : jamais une exécution hors du bac. Approche choisie : liste noire (InaccessiblePaths) plutôt que
# liste blanche (ProtectHome=tmpfs + BindReadOnlyPaths), car une rafale d'outils veut lire des chemins variés du dépôt
# et du système ; on bloque ce qui est secret et on garde le reste lisible, le bac empêchant la fuite par les sockets.
# Le réseau reste ouvert dans le bac : tout ce qui s'y lit peut partir. D'où une liste plus large que PROTEGES
# (historiques, jetons d'outils, navigateurs, messageries, gestionnaires de mots de passe) ; ce qui n'y est pas reste
# lisible, tes dossiers à toi s'ajoutent par NOEUD_BAC_INTERDITS.
BAC_INTERDITS = [".config/nc", ".local/state/nc-jarvis", ".local/state/noctalia-config",
                 # Noctalia : presse-papier chiffré + sa clé storage.key, historique des notifications (+ ses images, le cache)
                 ".local/state/noctalia", ".cache/noctalia", ".local/share/jarvis-bis",
                 ".ssh", ".gnupg", ".local/share/keyrings", ".password-store",
                 ".mozilla", ".config/chromium", ".config/google-chrome", ".config/BraveSoftware",
                 ".config/discord", ".config/gh", ".config/git", ".git-credentials", ".netrc", ".docker", ".kube",
                 ".aws", ".claude", ".claude.json", ".codex", ".gemini", ".qwen", ".config/rclone",
                 # historiques (des jetons y sont souvent tapés à la main)
                 ".zsh_history", ".bash_history", ".local/share/fish", ".python_history", ".node_repl_history",
                 ".psql_history", ".mysql_history", ".lesshst", ".local/share/nvim/shada",
                 # jetons d'outils
                 ".npmrc", ".pypirc", ".cargo/credentials", ".cargo/credentials.toml", ".gradle/gradle.properties",
                 ".m2/settings.xml", ".ollama", ".config/hub", ".config/glab-cli", ".config/gcloud", ".azure",
                 ".config/doctl", ".terraform.d", ".wakatime.cfg", ".config/Code/User/globalStorage", ".vscode-server",
                 # applis Flatpak (navigateurs, messageries…), autres navigateurs
                 ".var/app", ".librewolf", ".zen", ".floorp", ".waterfox", ".config/vivaldi", ".config/microsoft-edge",
                 ".config/opera", ".config/chromium-browser",
                 # messageries (une session copiée vaut le compte)
                 ".local/share/TelegramDesktop", ".config/Signal", ".thunderbird", ".config/Slack", ".config/vesktop",
                 ".config/legcord", ".config/WebCord", ".config/Element",
                 # mots de passe, accès distants, synchronisation
                 ".config/Bitwarden", ".config/op", ".config/keepassxc", ".local/share/remmina", ".config/remmina",
                 ".config/syncthing",
                 # assistants de code et outils qui gardent des jetons ou des historiques
                 ".config/github-copilot", ".config/JetBrains", ".config/sops", ".vault-token", ".continue",
                 ".config/io.datasette.llm", ".cache/huggingface", ".config/aichat", ".config/filezilla",
                 ".cache/cliphist", ".config/VSCodium/User/globalStorage", ".config/Cursor/User/globalStorage",
                 # états et caches des moteurs d'IA (sessions, journaux, jetons de serveurs MCP, OpenCode v2 : opencode.db, Oh My Pi)
                 ".local/state/opencode", ".cache/opencode", ".cache/claude-cli-nodejs", ".local/state/claude",
                 # Oh My Pi : ~/.omp (agent.db = ses connexions, sessions, mcp.json, journaux) et, une fois « omp config
                 # migrate » fait, ses dossiers XDG
                 ".omp", ".omp/agent", ".local/share/omp", ".local/state/omp", ".cache/omp",
                 # l'état de nc-ia (son journal, les dossiers laissés par une version précédente)
                 ".local/state/nc-ia"]

# Variables qui déplacent des dossiers de ces listes : (variable, préfixe relatif à ~ qu'elle remplace). Un chemin de la
# liste est alors interdit aux DEUX endroits (le défaut et le dossier déplacé : tous les programmes ne lisent pas la
# variable). CLAUDE_CONFIG_DIR déplace aussi ~/.claude.json (dans ce dossier, vérifié dans Claude Code 2.1).
DEPLACEMENTS = [("XDG_CONFIG_HOME", ".config"), ("XDG_DATA_HOME", ".local/share"), ("XDG_STATE_HOME", ".local/state"),
                ("XDG_CACHE_HOME", ".cache"), ("CLAUDE_CONFIG_DIR", ".claude"), ("CODEX_HOME", ".codex"),
               ("PI_CODING_AGENT_DIR", ".omp/agent")]
# Hors de ~, seuls /tmp et /var/tmp conviennent : PrivateTmp les masque en entier dans le bac
TEMPORAIRES = ("/tmp/", "/var/tmp/")


def deplacements(home, environ=None):
    """{préfixe relatif à ~: dossier réel} pour chaque variable de DEPLACEMENTS posée. ValueError (message clair) si l'une
    pointe ailleurs de façon non gérée : chemin relatif, ou dossier hors de ~ (ni /tmp ni /var/tmp), que le bac ne mettrait
    ni en lecture seule ni hors de vue. Alors pas de bac plutôt qu'un vrai dossier de secrets lisible."""
    environ = os.environ if environ is None else environ
    home_reel = os.path.realpath(str(home))
    out = {}
    for var, pref in DEPLACEMENTS:
        v = environ.get(var) or ""
        if not v:
            continue
        if not os.path.isabs(v) or any(c in v for c in '"\\\n:'):
            raise ValueError(f"{var}={v} : chemin relatif ou avec un caractère refusé, le bac ne sait pas le protéger")
        r = os.path.realpath(v)
        if r == os.path.realpath(os.path.join(home_reel, pref)):
            continue                                            # l'emplacement par défaut : rien à faire
        if not (r == home_reel or r.startswith(home_reel + "/") or r.startswith(TEMPORAIRES)):
            raise ValueError(f"{var}={v} pointe hors de ton dossier personnel : le bac ne sait pas le protéger")
        out[pref] = Path(r)
    # PI_CONFIG_DIR (Oh My Pi) : un nom relatif à ~ (« .pi » donne ~/.pi), pas un chemin absolu ; sa valeur remplace « .omp ».
    # Un « .. » ou une sortie de ~ (lien compris) : le bac ne sait pas le protéger.
    cfg = environ.get("PI_CONFIG_DIR") or ""
    if cfg and cfg != ".omp":
        rel = cfg.lstrip("/")
        if any(c in cfg for c in '"\\\n:') or not rel or ".." in rel.split("/"):
            raise ValueError(f"PI_CONFIG_DIR={cfg} : nom refusé (« .. », caractère interdit), le bac ne sait pas le protéger")
        r = os.path.realpath(os.path.join(home_reel, rel))
        if not r.startswith(home_reel + "/"):
            raise ValueError(f"PI_CONFIG_DIR={cfg} sort de ton dossier personnel : le bac ne sait pas le protéger")
        if r != os.path.realpath(os.path.join(home_reel, ".omp")):
            out[".omp"] = Path(r)
    return out


def emplacement(home, rel, depl):
    """Là où un programme garde vraiment rel (relatif à ~), d'après les variables de DEPLACEMENTS (depl)."""
    if rel == ".claude.json" and ".claude" in depl:
        return depl[".claude"] / ".claude.json"
    # le préfixe le plus précis d'abord (PI_CODING_AGENT_DIR = « .omp/agent » avant PI_CONFIG_DIR = « .omp »)
    for pref, d in sorted(depl.items(), key=lambda x: -len(x[0])):
        if rel == pref:
            return d
        if rel.startswith(pref + "/"):
            return d / rel[len(pref) + 1:]
    return Path(home) / rel


def jarvis_dossiers(home, environ=None):
    """Les chemins du backend JARVIS déployé (nc-jarvis deployer --path, n'importe où), lus dans ses unités
    assistant-*.service : WorkingDirectory= et EnvironmentFile= (« - » et guillemets enlevés, %h = ton dossier personnel),
    et le dossier du backend lui-même (le parent de gateway/ ou home-runner/ que le déployeur met en WorkingDirectory=,
    quand il est dans ~ sans être ~) : son .env, son dépôt et ses données y sont. Liste de Path absolus (tels quels et
    réels), sans doublon. None si une unité existe mais ne se lit pas : pas de bac plutôt qu'un backend lisible. Un
    spécificateur inconnu (%t…) ou un chemin relatif est ignoré : le chemin ne peut pas être calculé."""
    environ = os.environ if environ is None else environ
    home = Path(home)
    homes = {home, Path(os.path.realpath(str(home)))}
    conf = environ.get("XDG_CONFIG_HOME") or ""
    dossiers = [home / ".config/systemd/user"] + ([Path(conf) / "systemd/user"] if conf and os.path.isabs(conf) else [])
    bruts = []                                                    # (chemin, est un dossier de travail)
    for d in dict.fromkeys(dossiers):
        try:
            unites = sorted(d.glob("assistant-*.service"))
        except OSError:
            return None
        for u in unites:
            try:
                lignes = u.read_text(errors="replace").splitlines()
            except FileNotFoundError:
                continue
            except OSError:
                return None
            for l in lignes:
                cle, egal, v = l.strip().partition("=")
                if not egal or cle not in ("WorkingDirectory", "EnvironmentFile"):
                    continue
                v = v.strip().lstrip("-").strip().strip('"').replace("%%", "\0").replace("%h", str(home))
                if v.startswith("~/"):
                    v = str(home) + v[1:]
                if "%" in v or not os.path.isabs(v) or "\n" in v:
                    continue
                bruts.append((Path(v.replace("\0", "%")), cle == "WorkingDirectory"))
    out = []
    for b, travail in bruts:
        for x in (b, Path(os.path.realpath(str(b)))):
            out.append(x)
            if travail and x.name in ("gateway", "home-runner") and x.parent not in homes and any(h in x.parents for h in homes):
                out.append(x.parent)
    return list(dict.fromkeys(out))


def perso(reglage):
    """NOEUD_BAC_INTERDITS : tes dossiers en plus (relatifs à ~, séparés par « : », « ~/ » permis). None si une entrée
    ne convient pas (chemin absolu, « .. », guillemet, barre oblique inverse) : alors pas de bac, donc pas de session,
    plutôt qu'un dossier que tu crois protégé et qui ne l'est pas."""
    rels = []
    for x in (reglage("NOEUD_BAC_INTERDITS", "") or "").split(":"):
        x = x.strip()
        if x.startswith("~/"):
            x = x[2:]
        if not x:
            continue
        if x.startswith("/") or ".." in Path(x).parts or any(c in x for c in '"\\\n'):
            return None
        rels.append(x)
    return rels


def inaccessibles(home, reglage, libres=(), environ=None, interdits_plus=()):
    """Les chemins rendus illisibles dans le bac : BAC_INTERDITS, PROTEGES et NOEUD_BAC_INTERDITS qui existent (jamais
    sous /tmp, que PrivateTmp masque déjà), à leur place par défaut ET là où une variable de DEPLACEMENTS les met, plus
    tout $XDG_RUNTIME_DIR. Seuls les chemins existants (sinon systemd refuse l'unité). libres : chemins relatifs à ~
    laissés lisibles (les identifiants du moteur d'IA lancé, et les siens seulement). None si NOEUD_BAC_INTERDITS ne
    convient pas, ou si une variable de DEPLACEMENTS pointe ailleurs de façon non gérée. interdits_plus : chemins
    relatifs à ~ ajoutés par l'appelant (nc-ia y met le dossier de travail de nc-noeud, à lui et pas au bac des IA)."""
    vus = []
    perso_ = perso(reglage)
    if perso_ is None:
        return None
    environ = os.environ if environ is None else environ
    try:
        depl = deplacements(home, environ)
    except ValueError:
        return None
    home = Path(home)
    for rel in dict.fromkeys(BAC_INTERDITS + PROTEGES + perso_ + list(interdits_plus)):
        if rel in libres:
            continue
        motif = any(c in rel for c in "*?[")                  # motif (ex. assistant.conf.backup-*) : on étend
        ailleurs = emplacement(home, rel, depl)
        # le dossier déplacé sous /tmp : PrivateTmp le masque déjà
        for p in [home / rel] + ([ailleurs] if ailleurs != home / rel and not str(ailleurs).startswith(TEMPORAIRES) else []):
            if motif:
                vus += [str(q) for q in p.parent.glob(p.name) if q.exists()]
            elif p.exists():
                vus.append(str(p))
    # Le backend JARVIS déployé ailleurs que par défaut (--path) : son dossier, d'après ses unités (aucun chemin /tmp)
    backend = jarvis_dossiers(home, environ)
    if backend is None:
        return None
    vus += [str(p) for p in backend if not str(p).startswith(TEMPORAIRES) and p.exists()]
    run = environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isdir(run) and not run.startswith(TEMPORAIRES):                  # PrivateTmp le masque déjà
        vus.append(run)
    # /run/user/<uid> peut contenir le bus, les sockets et des secrets : s'il existe et que XDG_RUNTIME_DIR pointe
    # ailleurs (ProtectSystem=strict ne le masque pas, il reste lisible), on le rend aussi illisible — sauf s'il
    # contient XDG_RUNTIME_DIR ou l'inverse (le masquer couperait alors le tmpfs remonté de la demande).
    standard = f"/run/user/{os.getuid()}"
    rr = os.path.realpath(run) if run else None           # (realpath("/\0") lèverait ValueError)
    if os.path.isdir(standard):
        sr = os.path.realpath(standard)
        if rr is None or (sr != rr and not rr.startswith(sr + "/") and not sr.startswith(rr + "/")):
            vus.append(standard)
    return list(dict.fromkeys(vus))


def _prop(nom, chemin):
    """nom=chemin ; entre guillemets si le chemin a une espace (systemd sépare sinon). None si guillemet ou barre
    oblique inverse : pas de bac plutôt qu'un chemin mal lu."""
    if '"' in chemin or "\\" in chemin or "\n" in chemin:
        return None
    return f'{nom}="{chemin}"' if " " in chemin else f"{nom}={chemin}"


def argv(cmd, cwd, budget, *, home, reglage, programme, ecriture=(), lecture_seule=(), libres=(), env=(), unite=None,
        interdits_plus=(),
         reseau_prive=False, description="nc-bac", remonter=(), remonter_lecture=()):
    """La commande de systemd-run qui exécute cmd dans le bac, ou None si systemd-run est absent (ou un chemin inadmissible).
    cmd : une chaîne (passée à /bin/sh -c) ou une liste (exécutée telle quelle, sans shell).
    ecriture : les seuls chemins inscriptibles (ReadWritePaths) ; lecture_seule : des chemins gardés en lecture seule même
    dans un dossier inscriptible ; libres : voir inaccessibles() ; env : noms de variables transmises (valeur prise dans
    l'environnement de systemd-run) ; unite : nom de l'unité (pour l'arrêter proprement) ; reseau_prive : aucun réseau ;
    description : le texte que le journal du gestionnaire écrit pour l'unité (sinon il y met la commande ENTIÈRE, donc la
    question posée à une IA ou la commande d'une session).
    remonter, remonter_lecture : des dossiers SOUS $XDG_RUNTIME_DIR que l'unité voit (inscriptibles, ou en lecture seule).
    Alors $XDG_RUNTIME_DIR devient un tmpfs vide en lecture seule (TemporaryFileSystem=…:ro, aussi sûr qu'inaccessible :
    aucun socket, rien des autres demandes) où seuls ces dossiers sont remontés (BindPaths, BindReadOnlyPaths). None si
    $XDG_RUNTIME_DIR manque, est sous /tmp, ou si un de ces dossiers n'est pas dedans."""
    sr, py = programme("systemd-run"), (programme("python3") or programme("python"))
    if not sr or not py:
        return None
    # PrivatePIDs (systemd 257) : un /proc à lui, aucun autre de tes processus visible ni joignable par un signal ;
    # sans lui, la sonde échoue et il n'y a pas de bac. SystemCallFilter retire ptrace, process_vm_* et le
    # trousseau du noyau (partagé entre espaces de noms). ProtectProc/ProcSubset ne valent pas pour --user : pas mis.
    # ProtectSystem=strict : tout le système en lecture seule (sauf /dev, /proc, /sys, et les ReadWritePaths/BindPaths),
    #   sinon le bac pouvait écrire hors de ~ (/dev/shm, /dev/mqueue, /var/spool/mail, /run/media/<user>, /mnt…).
    #   ReadOnlyPaths=/dev/shm : /dev reste accessible malgré strict, et /dev/shm est partagé entre tous les comptes.
    # KillSignal=SIGKILL + TimeoutStopSec=1s : un moteur qui ignore SIGTERM et garde sa sortie ouverte est tué tout de
    #   suite et l'unité ne traîne pas (sinon « systemctl stop » attendait jusqu'à 90 s pendant que nc-ia veut nettoyer).
    # PrivateDevices : un /dev à lui (null, zero, random, urandom, tty, pts, full, shm…), sans /dev/video*, /dev/snd, /dev/dri,
    #   /dev/input, /dev/hidraw… PrivateUsers garde ton uid, donc l'ACL « uaccess » (user:<uid>:rw) du système resterait
    #   valable : sans cela une commande de session filmait ou enregistrait, puis envoyait par le réseau.
    # PrivateIPC : ses propres files de messages et mémoires partagées SysV (pas celles du reste de ta session).
    props = ["PrivateUsers=yes", "NoNewPrivileges=yes", "PrivatePIDs=yes", "PrivateDevices=yes", "PrivateIPC=yes",
             "SystemCallFilter=~@debug @keyring",
             "ProtectHome=read-only", "PrivateTmp=yes", "ProtectSystem=strict", "ReadOnlyPaths=-/dev/shm",
             "KillSignal=SIGKILL", "TimeoutStopSec=1s",
             # OnFailure= vide : un greffon global (OnFailure=nc-panne@%n sur chaque service) ferait sinon une notification
             # « en panne » pour chaque commande ou question qui échoue ou dépasse son délai dans le bac
             "OnFailure=",
             "RestrictAddressFamilies=AF_INET AF_INET6", "ReadOnlyPaths=" + str(home)]
    for c in ecriture:
        props.append(_prop("ReadWritePaths", str(c)))
    for c in lecture_seule:
        props.append(_prop("ReadOnlyPaths", str(c)))
    props.append("RuntimeMaxSec=" + str(max(1, int(budget))))
    if None in props:
        return None
    # --expand-environment=no (systemd 254) : sans lui, systemd-run remplace ${VAR} et $VAR dans la ligne de commande par
    # l'environnement de l'unité (une question contenant ${OPENAI_API_KEY} y mettrait la clé, un "${f}" deviendrait vide).
    # --description : sinon le journal écrit « Started … /bin/sh -c <la commande entière> »
    out = [sr, "--user", "--wait", "--pipe", "--quiet", "--collect", "--expand-environment=no",
           "--description=" + (re.sub(r"[^A-Za-z0-9_.-]", "-", description or "") or "nc-bac")]
    # Une unité nommée « nc-bac-… » même sans nom donné : nc-panne ne la signale pas comme un service en panne
    out.append("--unit=" + (unite or "nc-bac-" + os.urandom(6).hex()))
    for p in props:
        out += ["-p", p]
    if reseau_prive:
        out += ["-p", "PrivateNetwork=yes"]                     # aucun réseau, 127.0.0.1 compris (services locaux)
    interdits = inaccessibles(home, reglage, libres, interdits_plus=interdits_plus)
    if interdits is None:
        return None
    if remonter or remonter_lecture:
        run = os.environ.get("XDG_RUNTIME_DIR") or ""
        if not run or not os.path.isabs(run) or run.startswith(TEMPORAIRES) or not os.path.isdir(run):
            return None
        run = os.path.realpath(run)
        interdits = [x for x in interdits if os.path.realpath(x) != run]
        # « :ro » est une option de TemporaryFileSystem et « : » sépare source et cible de BindPaths : refusé dans le chemin
        if ":" in run or _prop("TemporaryFileSystem", run + ":ro") is None:
            return None
        out += ["-p", _prop("TemporaryFileSystem", run + ":ro")]
        for nom, liste in (("BindPaths", remonter), ("BindReadOnlyPaths", remonter_lecture)):
            for d in liste:
                d = os.path.realpath(str(d))
                if not d.startswith(run + "/") or ":" in d or not os.path.isdir(d) or _prop(nom, d) is None:
                    return None
                out += ["-p", _prop(nom, d)]
    for x in interdits:
        # Un -p par chemin, entre guillemets (systemd sépare sinon aux espaces) ; un guillemet ou une barre oblique
        # inverse dans le chemin : pas de bac plutôt qu'un chemin mal lu
        if '"' in x or "\\" in x:
            return None
        out += ["-p", 'InaccessiblePaths="' + x + '"']
    # --setenv n'ENLÈVE rien : l'unité hérite sinon de TOUT l'environnement du gestionnaire systemd (vrais XDG_*_HOME,
    # DISPLAY, WAYLAND_DISPLAY, DBUS_SESSION_BUS_ADDRESS, HYPRLAND_INSTANCE_SIGNATURE, et avec uwsm toute clé exportée
    # comme OPENAI_API_KEY ou GITHUB_TOKEN). Plutôt qu'une liste noire (UnsetEnvironment, qui dépend de ce qu'on sait du
    # gestionnaire), un lanceur « python3 -I » efface TOUT et ne remet que la liste blanche avant d'exécuter la commande.
    # Une entrée « NOM » : sa valeur passe par --setenv (donc dans l'environnement de l'unité, JAMAIS dans la ligne de
    #   commande) ; le lanceur la relit dans os.environ. Les clés d'API de nc-ia n'apparaissent donc nulle part dans
    #   /proc/<pid>/cmdline (« env -i NOM="$NOM" » les y laissait, le temps de l'exec du processus env).
    # Une entrée « NOM=valeur » : valeur NON secrète (PATH, HOME, langue, TERM=dumb de nc-noeud), posée telle quelle.
    # Les XDG_*_HOME ne sont pas dans la liste : absents, chaque outil les déduit de HOME (le faux dossier personnel).
    noms, litteraux = [], []
    for e in env:
        nom, egal, valeur = e.partition("=")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", nom) or "\0" in valeur or "\n" in valeur:
            return None
        if egal:
            litteraux.append(nom + "=" + valeur)
        else:
            out.append("--setenv=" + nom)
            noms.append(nom)
    # Le lanceur : garde de os.environ (rempli par --setenv) les seuls noms voulus, y ajoute les littéraux, fait un
    # chdir puis execvpe. os.environ n'est jamais dans argv : les valeurs secrètes restent hors de la ligne de commande.
    # -I : isolé (ni variables PYTHON*, ni site, ni cwd dans sys.path). Le dossier de travail passe par chdir (pas par
    # WorkingDirectory : systemd refuse l'unité quand il tombe sur un tmpfs, ex. /dev/shm des tests).
    code = ("import os,sys\n"
            "a=sys.argv\n"
            "keep=set(a[1].split(',')) if a[1] else set()\n"
            "n=int(a[2])\n"
            "lit=dict(x.split('=',1) for x in a[3:3+n])\n"
            "cwd=a[3+n]; argv=a[4+n:]\n"
            "env={k:os.environ[k] for k in keep if k in os.environ}\n"
            "env.update(lit)\n"
            "os.chdir(cwd)\n"
            "os.execvpe(argv[0],argv,env)\n")
    lanceur = [str(py), "-I", "-c", code, ",".join(noms), str(len(litteraux)), *litteraux, str(cwd)]
    reste = ["/bin/sh", "-c", cmd] if isinstance(cmd, str) else [str(x) for x in cmd]
    out += ["--", *lanceur, *reste]
    return out
