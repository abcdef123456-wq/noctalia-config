#!/usr/bin/env bash
# legion-kill : ferme la fenêtre active ; si c'est la seule fenêtre de son processus (Discord & co), tue aussi le processus.
w=$(hyprctl activewindow -j); pid=$(jq -r '.pid // empty' <<<"$w")
[ -n "$pid" ] || exit 0
n=$(hyprctl clients -j | jq --argjson p "$pid" '[.[]|select(.pid==$p)]|length')
hyprctl dispatch killactive >/dev/null 2>&1
if [ "$n" -le 1 ]; then
  sleep 5
  kill -0 "$pid" 2>/dev/null && { kill -TERM "$pid"; sleep 0.6; kill -0 "$pid" 2>/dev/null && kill -KILL "$pid"; }
fi
true
