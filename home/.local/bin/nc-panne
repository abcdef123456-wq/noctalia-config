#!/usr/bin/env python3
"""nc-panne : un service de ta session qui tombe en panne (l'île, Noctalia, PipeWire, un service à toi…) est signalé
par une notification, avec « Redémarrer » et, si une IA est disponible, « Expliquer » : l'IA lit alors son état et la
fin de son journal (secrets masqués) et répond dans la conversation (nc-ia panne). Rien n'est envoyé sans ton clic.

Lancé par systemd (OnFailure= de tous les services de ta session : ~/.config/systemd/user/service.d/nc-panne.conf),
seulement quand un service finit en échec — pas pendant ses redémarrages automatiques, ni pendant la fermeture de la
session. Par défaut, seulement les services du bureau (PANNES=nc : nc-*, Noctalia, PipeWire, WirePlumber, portails,
agent polkit) ; PANNES=tous pour tous ceux de ta session, PANNES_IGNORER pour en écarter. Un même service n'est
signalé qu'une fois par demi-heure ; plusieurs pannes à quelques secondes d'écart (session cassée, mise à jour qui
n'a pas relancé ses services) font une seule notification, avec « Redémarrer tout ». Les services du système ne sont
jamais concernés.

  nc-panne signaler SERVICE.service   (systemd) la notification
  nc-panne essai                      une notification d'exemple, sans panne
Couper : nc-reglages → Notifications → « Signaler les services en panne » (PANNES=non).
« Redémarrer » remet d'abord le compteur de démarrages à zéro (systemctl reset-failed : un service en panne a souvent
atteint sa limite) et dit si le service est reparti.
"""
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "nc"
NB = HOME / ".local/bin"
UNITE_RE = re.compile(r"[A-Za-z0-9:_.\\@-]{1,200}\.service")
DELAI = 1800                         # un même service : une notification par demi-heure au plus
ATTENTE = float(os.environ.get("NC_PANNES_ATTENTE") or 3)   # les pannes de ces secondes-là sont regroupées
LOT = CACHE / "pannes-lot.json"      # { debut, pid : celui qui notifiera, unites : les pannes regroupées }
# PANNES=nc : les services du bureau seulement (ceux des applis, de GNOME ou KDE installés à côté restent muets)
DU_BUREAU = re.compile(r"(nc-|noctalia|pipewire|wireplumber|xdg-desktop-portal|plasma-polkit-agent|hyprpolkitagent|"
                       r"polkit-gnome|hypridle|hyprpaper|hyprsunset|uwsm)")


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(HOME / ".config/nc/reglages.conf", encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"
T = lambda fr, en: en if EN else fr


def reglage(cle, defaut):
    try:
        for l in (HOME / ".config/nc/reglages.conf").read_text(encoding="utf-8").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"') or defaut
    except OSError:
        pass
    return defaut


def sortie(cmd, delai=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=delai, stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


class Verrou:
    """Plusieurs pannes arrivent souvent ensemble : un seul nc-panne lit et écrit les registres à la fois."""
    def __enter__(self):
        import fcntl
        CACHE.mkdir(parents=True, exist_ok=True)
        self.f = open(CACHE / "pannes.lock", "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


def lire_json(f, defaut):
    try:
        d = json.loads(f.read_text(encoding="utf-8"))
        return d if isinstance(d, type(defaut)) else defaut
    except (OSError, ValueError):
        return defaut


def ecrire_json(f, d):
    try:
        tmp = f.with_name(f"{f.name}.{os.getpid()}")
        tmp.write_text(json.dumps(d), encoding="utf-8")
        os.replace(tmp, f)
    except OSError:
        pass


def deja_signale(unite):
    """Vrai si ce service a été signalé il y a moins d'une demi-heure ; sinon, note maintenant (sous le verrou)."""
    f = CACHE / "pannes.json"
    maintenant = time.time()
    d = {k: v for k, v in lire_json(f, {}).items() if isinstance(v, (int, float)) and maintenant - v < DELAI}
    if unite in d:
        return True
    d[unite] = maintenant
    ecrire_json(f, d)
    return False


def vivant(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def rejoindre_lot(unite):
    """Sous le verrou : vrai si un autre nc-panne rassemble déjà les pannes de ces secondes-ci (il signalera aussi
    celle-ci) ; sinon, ouvre un lot dont ce processus notifiera."""
    lot = lire_json(LOT, {})
    if lot.get("pid") != os.getpid() and 0 <= time.time() - float(lot.get("debut") or 0) < ATTENTE + 5 \
            and vivant(lot.get("pid")) and isinstance(lot.get("unites"), list):
        lot["unites"].append(unite)
        ecrire_json(LOT, lot)
        return True
    ecrire_json(LOT, {"debut": time.time(), "pid": os.getpid(), "unites": [unite]})
    return False


def fermer_lot(unite):
    """Sous le verrou : les pannes regroupées dans le lot de ce processus (au moins la sienne)."""
    lot = lire_json(LOT, {})
    if lot.get("pid") != os.getpid():
        return [unite]
    LOT.unlink(missing_ok=True)
    return [u for u in dict.fromkeys(lot.get("unites") or [unite]) if isinstance(u, str) and UNITE_RE.fullmatch(u)] or [unite]


def ia_permise():
    """L'IA n'est pas coupée (lecture des réglages seulement, sans réseau : la notification part tout de suite)."""
    ia = NB / "nc-ia"
    if not ia.exists():
        return False
    try:
        return subprocess.run([str(ia), "actif"], capture_output=True, timeout=5, stdin=subprocess.DEVNULL).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


# Unités transitoires lancées par systemd-run (le bac de nc-noeud et des IA, les tests, « run-p… ») : le drop-in
# global OnFailure= s'applique aussi à elles, et un « OnFailure= » vide posé à leur création ne l'efface pas. Leur
# échec (une commande refusée, une IA trop lente) n'est pas une panne du bureau : jamais signalé.
TRANSITOIRE = re.compile(r"(run-[pu][0-9]+(-i[0-9]+)?|(nc-ia|nc-bac|nc-noeud)-(test-)?[0-9a-f]{8,})\.service$")


def transitoire(unite):
    if TRANSITOIRE.match(unite):
        return True
    props = dict(l.split("=", 1) for l in sortie(["systemctl", "--user", "show", "-p", "Transient,LoadState", unite]).splitlines()
                 if "=" in l)
    # Déjà retirée (--collect) : plus rien à signaler ni à redémarrer
    return props.get("Transient") == "yes" or props.get("LoadState") == "not-found"


BAC = re.compile(r"nc-(ia|bac)-(test-)?[0-9a-f]{12}\.service")


def concerne(unite):
    # Les unités du bac à sable (une question à une IA, une commande de session de confiance) : un échec ou un délai
    # dépassé y est une réponse, pas un service du bureau en panne
    if BAC.fullmatch(unite):
        return False
    portee = reglage("PANNES", "nc")
    if portee == "non":
        return False
    if unite in re.split(r"[\s,;]+", reglage("PANNES_IGNORER", "")):
        return False
    if not (portee == "tous" or DU_BUREAU.match(unite)):
        return False
    return not transitoire(unite)


def session_ouverte():
    """Pendant la fermeture de la session, les services s'arrêtent (et parfois échouent) : rien à signaler."""
    if sortie(["systemctl", "--user", "is-system-running"]) == "stopping":
        return False
    return sortie(["systemctl", "--user", "is-active", "graphical-session.target"]) == "active"


_BALISAGE = []


def corps_sur(texte):
    """Le corps d'une notification : une ligne de journal peut contenir < > & ; échappés seulement pour un serveur qui
    lit le balisage (mako, dunst…). L'île ne le lit pas (elle les afficherait tels quels)."""
    if not _BALISAGE:
        _BALISAGE.append("body-markup" in sortie(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                                                  "--object-path", "/org/freedesktop/Notifications", "--method",
                                                  "org.freedesktop.Notifications.GetCapabilities"], 3)
                         if shutil.which("gdbus") else False)
    return texte.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") if _BALISAGE[0] else texte


def notifier(titre, corps):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", T("Système", "System"), "-i", "dialog-information", "--", titre, corps_sur(corps)],
                       capture_output=True, timeout=10, stdin=subprocess.DEVNULL)


def relancer(unites):
    """{unité: (repartie, erreur)} : le compteur de démarrages d'abord remis à zéro (un service en panne a souvent
    atteint sa limite), puis deux secondes pour voir s'il tient."""
    erreurs = {}
    for u in unites:
        subprocess.run(["systemctl", "--user", "reset-failed", u], capture_output=True, stdin=subprocess.DEVNULL, timeout=10)
        try:
            r = subprocess.run(["systemctl", "--user", "restart", u], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=90)
            erreurs[u] = r.stderr.strip() if r.returncode else ""
        except subprocess.TimeoutExpired:
            erreurs[u] = T("délai dépassé", "timed out")
    time.sleep(2)
    res = {}
    for u in unites:
        actif = sortie(["systemctl", "--user", "is-active", u])
        res[u] = (not erreurs[u] and actif == "active", (erreurs[u] or actif)[-300:])
    return res


def redemarrer(unite, desc):
    ok, erreur = relancer([unite])[unite]
    if ok:
        notifier(T(f"{desc} est reparti", f"{desc} is running again"), unite)
    else:
        notifier(T(f"{desc} ne repart pas", f"{desc} does not start"), erreur)


def expliquer(unites):
    try:
        r = subprocess.run([str(NB / "nc-ia"), "panne", *unites, "--livrer"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=600)
        if r.returncode != 0:                        # aucune IA joignable, coupée entre-temps…
            notifier(T("Explication impossible", "No explanation"), (r.stderr.strip() or "nc-ia")[-300:])
    except (OSError, subprocess.TimeoutExpired):
        notifier(T("Explication impossible", "No explanation"), T("délai dépassé", "timed out"))


def signaler_groupe(unites):
    """Plusieurs pannes ensemble : une seule notification, « Redémarrer tout » et, si l'IA est permise, « Expliquer »."""
    descs = {u: sortie(["systemctl", "--user", "show", u, "-p", "Description", "--value"]) or u for u in unites}
    lignes = [f"• {descs[u]} ({u})" for u in unites[:6]] + ([T(f"• et {len(unites) - 6} autre(s)", f"• and {len(unites) - 6} more")]
                                                            if len(unites) > 6 else [])
    cmd = ["notify-send", "-a", T("Système", "System"), "-i", "dialog-warning", "-A", "redemarrer=" + T("Redémarrer tout", "Restart all")]
    ia = ia_permise()
    if ia:
        cmd += ["-A", "expliquer=" + T("Expliquer", "Explain")]
    try:
        choix = subprocess.run(cmd + ["--", T(f"{len(unites)} services en panne", f"{len(unites)} services failed"),
                                      corps_sur("\n".join(lignes))],
                               capture_output=True, text=True, timeout=3600, stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if choix == "redemarrer":
        resultats = [(u, *v) for u, v in relancer(unites).items()]
        ok = [descs[u] for u, bon, _ in resultats if bon]
        ko = [f"{descs[u]} : {e}" for u, bon, e in resultats if not bon]
        if not ko:
            notifier(T("Services repartis", "Services running again"), ", ".join(ok))
        else:
            notifier(T(f"{len(ko)} service(s) ne repartent pas", f"{len(ko)} service(s) do not start"),
                     "\n".join(ko + ([T("Repartis : ", "Running again: ") + ", ".join(ok)] if ok else [])))
    elif choix == "expliquer" and ia:
        expliquer(unites)
    return 0


def derniere_ligne(unite):
    l = sortie(["journalctl", "--user", "-u", unite, "-n", "1", "--no-pager", "-o", "cat"])
    if not l:                            # journal non persistant (Debian minimale…) : l'état de systemd
        l = sortie(["systemctl", "--user", "status", unite, "-n", "3", "--no-pager"]).splitlines()[-1:] or [""]
        l = l[0].strip()
    return l[-300:]


def signaler(unite, essai=False):
    if not UNITE_RE.fullmatch(unite) or unite.startswith("nc-panne@"):
        return 2
    if not shutil.which("notify-send"):
        return 0
    if not essai:
        if not concerne(unite) or not session_ouverte():
            return 0
        with Verrou():
            if deja_signale(unite) or rejoindre_lot(unite):
                return 0                             # déjà signalé, ou un autre nc-panne la signalera avec la sienne
        time.sleep(ATTENTE)                          # d'autres pannes en même temps ? une seule notification
        with Verrou():
            unites = fermer_lot(unite)
        if len(unites) > 1:
            return signaler_groupe(unites)
    if essai:
        desc, ligne = T("Service d'exemple", "Example service"), T("(essai : aucun service n'est en panne)", "(test: no service failed)")
    else:
        desc = sortie(["systemctl", "--user", "show", unite, "-p", "Description", "--value"]) or unite
        ligne = derniere_ligne(unite)
    cmd = ["notify-send", "-a", T("Système", "System"), "-i", "dialog-warning",
           "-A", "redemarrer=" + T("Redémarrer", "Restart")]
    ia = not essai and ia_permise()
    if ia:
        cmd += ["-A", "expliquer=" + T("Expliquer", "Explain")]
    corps = corps_sur(T(f"{unite} s'est arrêté en échec.", f"{unite} stopped with a failure.") + (f"\n{ligne}" if ligne else ""))
    try:
        choix = subprocess.run(cmd + ["--", T(f"{desc} est en panne", f"{desc} has failed"), corps], capture_output=True,
                               text=True, timeout=3600, stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if essai:
        return 0
    if choix == "redemarrer":
        redemarrer(unite, desc)
    elif choix == "expliquer" and ia:
        expliquer([unite])
    return 0


def main(a):
    if a[:1] == ["signaler"] and len(a) == 2:
        return signaler(a[1])
    if a[:1] in (["essai"], ["test"]):
        return signaler("exemple.service", essai=True)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
