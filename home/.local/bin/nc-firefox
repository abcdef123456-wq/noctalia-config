#!/usr/bin/env python3
"""nc-firefox : la config Firefox du dépôt (préférences et style de l'île) dans ton profil.

  nc-firefox profil        affiche le dossier du profil par défaut (profiles.ini de ~/.config/mozilla/firefox,
                           ~/.mozilla/firefox, ou des versions Flatpak et Snap ; NC_FIREFOX_PROFIL le force)
  nc-firefox installer     copie user.js et chrome/ (userChrome.css, userContent.css) dans le profil, puis écrit
                           les couleurs ; un user.js à toi est gardé en user.js.avant-nc
  nc-firefox desinstaller  retire ce que nc-firefox a posé (rien d'autre), remet user.js.avant-nc s'il existe
  nc-firefox couleurs      écrit chrome/nc-couleurs.css depuis la palette de l'île (~/.config/nc/palette-ile.json) ;
                           appelé par nc-theme-sync à chaque fond d'écran, sans effet tant que rien n'est installé
  nc-firefox etat          0 si la config est en place dans le profil, 1 sinon ; dit « hôte natif introuvable »
                           si l'extension est posée mais que Firefox ne peut pas lancer son hôte

  nc-firefox extension installer | desinstaller | etat
      L'extension « Couleurs de l'île » : le thème de Firefox suit en direct les couleurs du fond d'écran, sans
      relancer (réglage FIREFOX_COULEURS de nc-reglages → Apparence). Elle est posée dans extensions/ du profil
      (chargée au prochain démarrage de Firefox, qui propose de l'activer : à accepter une seule fois) avec son hôte natif (ce script, déclaré dans
      ~/.mozilla/native-messaging-hosts, où Firefox le cherche même quand les profils sont rangés dans
      ~/.config/mozilla ; Flatpak et Snap : le dossier de leur .mozilla). Non signée : Firefox Developer Edition, Nightly et ESR l'acceptent
      (xpinstall.signatures.required à faux, pour TOUTES les extensions) ; avec la version grand public (Fedora, Snap d'Ubuntu, Flatpak),
      l'installation est refusée (code 4) au lieu de poser une extension que Firefox rejetterait.

Plusieurs dossiers de profils (un vieux ~/.mozilla/firefox derrière un Firefox Flatpak) : celui que Firefox a
utilisé en dernier. Les fichiers viennent de ~/.local/share/nc/firefox. Firefox relit user.js et chrome/ au démarrage : ferme-le et
rouvre-le. Sans Firefox ni profil : rien n'est fait, code 1. Noms anglais acceptés : profile, install, uninstall,
colors, status, extension.
"""
import configparser
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import threading
import time
import zipfile

HOME = Path.home()
SOURCE = Path(os.environ.get("NC_FIREFOX_SOURCE") or HOME / ".local/share/nc/firefox")
PALETTE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "nc/palette-ile.json"
MARQUE = "nc-firefox"
FICHIERS = ("user.js", "chrome/userChrome.css", "chrome/userContent.css")
EXTENSION_ID = "nc-couleurs@noctalia-config"
HOTE = "nc_firefox"
ACTIONS = {"profile": "profil", "install": "installer", "uninstall": "desinstaller", "colors": "couleurs", "status": "etat"}
BLOC_EXTENSION = f"""
// --- {MARQUE} extension : « Couleurs de l'île » (nc-firefox extension installer) ---
user_pref("xpinstall.signatures.required", false);                         // extension non signée (Developer Edition, Nightly, ESR)
user_pref("extensions.sideloadScopes", 1);                                 // extensions/ du profil lu au démarrage
"""
# extensions.autoDisableScopes reste à sa valeur par défaut (15) : Firefox désactive l'extension déposée dans le profil
# et propose de l'activer (une seule fois, elle le reste ensuite). Avec 14, tout fichier déposé dans extensions/ serait
# activé sans question.


def dossiers_candidats():
    xdg = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
    return [xdg / "mozilla/firefox", HOME / ".mozilla/firefox",
            HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox", HOME / "snap/firefox/common/.mozilla/firefox"]


def profil_de(base):
    """Le profil par défaut d'un dossier de profils (son profiles.ini), ou None : le profil « Default » de la section
    [Install…] (celui que Firefox ouvre), puis Default=1, puis le premier profil existant."""
    ini = base / "profiles.ini"
    if not ini.is_file():
        return None
    cfg = configparser.RawConfigParser()
    cfg.optionxform = str
    try:
        cfg.read(ini, encoding="utf-8")
    except configparser.Error:
        return None

    def chemin(section):
        p = cfg.get(section, "Path", fallback=None)
        if not p:
            return None
        rel = cfg.get(section, "IsRelative", fallback="1") == "1"
        d = base / p if rel else Path(p)
        return d if d.is_dir() else None

    for s in cfg.sections():
        if s.startswith("Install"):
            p = cfg.get(s, "Default", fallback="")
            if p and (base / p).is_dir():
                return base / p
    profils = [s for s in cfg.sections() if s.startswith("Profile")]
    for s in profils:
        if cfg.get(s, "Default", fallback="0") == "1" and chemin(s):
            return chemin(s)
    for s in profils:
        if chemin(s):
            return chemin(s)
    return None


def derniere_utilisation(d):
    """Quand Firefox a servi ce profil pour la dernière fois : le plus récent de prefs.js, compatibility.ini et
    times.json. Les fichiers que nc-firefox pose (user.js, chrome/) ne comptent pas : sinon le profil qu'il vient de
    toucher paraîtrait toujours le plus récent."""
    t = 0.0
    for nom in ("prefs.js", "compatibility.ini", "times.json"):
        try:
            t = max(t, (d / nom).stat().st_mtime)
        except OSError:
            pass
    return t


def profil():
    """Le dossier du profil par défaut, ou None. Priorité : NC_FIREFOX_PROFIL ; sinon le profil par défaut de chaque
    dossier de profils (voir profil_de), et, s'il y en a plusieurs (un vieux ~/.mozilla/firefox laissé derrière un
    Firefox Flatpak ou XDG, par exemple), celui que Firefox a utilisé en dernier ; à égalité, l'ordre de
    dossiers_candidats()."""
    force = os.environ.get("NC_FIREFOX_PROFIL")
    if force:
        return Path(force) if Path(force).is_dir() else None
    trouves = [d for d in (profil_de(b) for b in dossiers_candidats()) if d]
    if not trouves:
        return None
    return max(enumerate(trouves), key=lambda e: (derniere_utilisation(e[1]), -e[0]))[1]


def ecrire_atomique(f, texte):
    """Écrit dans un fichier temporaire du même dossier puis le renomme : Firefox (ou une coupure) ne voit jamais un
    fichier à moitié écrit."""
    tmp = f.with_name(f".{f.name}.nc-tmp{os.getpid()}")
    try:
        tmp.write_text(texte, encoding="utf-8")
        os.replace(tmp, f)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def pose_par_nc(f):
    try:
        return f.is_file() and MARQUE in f.read_text(encoding="utf-8", errors="replace")[:400]
    except OSError:
        return False


def reglage(cle, defaut):
    try:
        for l in (Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "nc/reglages.conf").read_text(encoding="utf-8", errors="replace").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"') or defaut
    except OSError:
        pass
    return defaut


def vaapi_utilisable():
    """Vrai si `vainfo` répond : un pilote VA-API est là (Intel, AMD, ou NVIDIA avec nvidia-vaapi-driver). Sans lui,
    ou sans vainfo, la préférence n'est pas posée : Firefox garde son choix par défaut."""
    if not shutil.which("vainfo"):
        return False
    try:
        return subprocess.run(["vainfo"], stdin=subprocess.DEVNULL, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def remises_a_zero(p, ancien, extension):
    """Valeurs que d'anciennes versions de nc-firefox ont posées dans user.js et que Firefox a gardées dans prefs.js
    (il n'y garde que ce qui diffère du défaut, même après le retrait de la ligne de user.js) : remises à leur valeur
    par défaut, une fois ; une valeur au défaut n'est plus enregistrée, et la remise disparaît d'elle-même à la
    réécriture suivante. Seulement si le user.js d'avant était celui de nc-firefox (jamais une valeur que tu as mise)."""
    if not ancien:
        return ""
    try:
        prefs = (p / "prefs.js").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    cas = [("gfx.webrender.all", "true", "false"), ("extensions.autoDisableScopes", "14", "15")]
    if not extension:
        cas.append(("xpinstall.signatures.required", "false", "true"))
    lignes = [f'user_pref("{cle}", {defaut});\n' for cle, posee, defaut in cas
              if re.search(r'user_pref\("' + re.escape(cle) + r'",\s*' + posee + r'\s*\)', prefs)]
    if not lignes:
        return ""
    return f"\n// --- {MARQUE} : anciennes valeurs remises par défaut (une fois) ---\n" + "".join(lignes)


def bloc_reglages():
    """Préférences qui suivent nc-reglages (Apparence → Firefox : …) ; plus bas dans user.js, elles l'emportent."""
    verticaux = reglage("FIREFOX_ONGLETS_VERTICAUX", "non") == "oui"
    return (f"\n// --- {MARQUE} : tes réglages (nc-reglages → Apparence) ---\n"
            f'user_pref("sidebar.revamp", {"true" if verticaux else "false"});\n'
            f'user_pref("sidebar.verticalTabs", {"true" if verticaux else "false"});\n'
            f'user_pref("browser.startup.page", {3 if reglage("FIREFOX_SESSION", "oui") != "non" else 1});\n'
            f'user_pref("general.smoothScroll", {"false" if reglage("FIREFOX_DEFILEMENT_DOUX", "oui") == "non" else "true"});\n'
            + ('user_pref("media.ffmpeg.vaapi.enabled", true);                            // vidéo par la carte graphique (vainfo répond)\n'
               if vaapi_utilisable() else ""))


def ecrire_user_js(p):
    """user.js = celui du dépôt, tes réglages, plus le bloc de l'extension si elle est installée."""
    garder_avant(p, "user.js", lire_empreintes(p))   # retouché à la main depuis : gardé avant la réécriture (revue FF-01b)
    ancien = pose_par_nc(p / "user.js")
    texte = (SOURCE / "user.js").read_text(encoding="utf-8") + bloc_reglages()
    extension = extension_etat(p) == 0
    if extension:
        texte += BLOC_EXTENSION
    texte += remises_a_zero(p, ancien, extension)
    ecrire_atomique(p / "user.js", texte)
    # Réécrit par nc-firefox lui-même (extension, réglages) : son empreinte suit, ce n'est pas une retouche
    d = lire_empreintes(p)
    if d:
        d["user.js"] = empreinte(p / "user.js")
        ecrire_atomique(p / EMPREINTES, json.dumps(d, indent=1))


# Tes fichiers à toi ne sont jamais perdus : un fichier qui n'est pas de nc-firefox est gardé en NOM.avant-nc avant la
# première installation (une sauvegarde déjà faite n'est jamais écrasée) et remis à la désinstallation ; un fichier de
# nc-firefox que tu as retouché depuis (empreinte différente de celle notée dans .nc-firefox.json) est gardé en
# NOM.retouche-nc avant d'être remplacé ou retiré.
EMPREINTES = ".nc-firefox.json"


def empreinte(f):
    try:
        return hashlib.sha256(f.read_bytes()).hexdigest()
    except OSError:
        return ""


def lire_empreintes(p):
    try:
        d = json.loads((p / EMPREINTES).read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def garder_avant(p, rel, empreintes):
    """Avant de poser (ou de retirer) rel : ta version est mise de côté si elle n'est pas celle de nc-firefox."""
    f = p / rel
    if not f.is_file():
        return
    if not pose_par_nc(f):
        sauve = f.with_name(f.name + ".avant-nc")
        if not sauve.exists():
            shutil.copy2(f, sauve)
            print(f"ton {rel} est gardé en {sauve}")
    elif empreintes.get(rel) and empreinte(f) != empreintes[rel]:
        # Une sauvegarde par version retouchée : une deuxième retouche n'écrase jamais la première
        sauve = f.with_name(f.name + ".retouche-nc")
        if sauve.exists() and empreinte(sauve) == empreinte(f):
            return
        n = 1
        while sauve.exists():
            sauve = f.with_name(f"{f.name}.retouche-nc.{time.strftime('%Y%m%d-%H%M%S')}" + (f"-{n}" if n > 1 else ""))
            n += 1
        shutil.copy2(f, sauve)
        print(f"tes retouches de {rel} sont gardées en {sauve}")


def noter_empreintes(p):
    d = {rel: empreinte(p / rel) for rel in FICHIERS if pose_par_nc(p / rel)}
    ecrire_atomique(p / EMPREINTES, json.dumps(d, indent=1))


def installer(p):
    for rel in FICHIERS:
        src = SOURCE / rel
        if not src.is_file():
            print(f"nc-firefox : source absente, {src}", file=sys.stderr)
            return 1
    empreintes = lire_empreintes(p)
    (p / "chrome").mkdir(exist_ok=True)
    for rel in FICHIERS:
        garder_avant(p, rel, empreintes)
    for rel in FICHIERS[1:]:
        shutil.copyfile(SOURCE / rel, p / rel)
    ecrire_user_js(p)
    couleurs(p)
    noter_empreintes(p)
    print(f"config Firefox installée dans {p} (relance Firefox)")
    return 0


def desinstaller(p):
    extension_desinstaller(p, silencieux=True, complet=True)
    empreintes = lire_empreintes(p)
    for rel in FICHIERS:
        f = p / rel
        if pose_par_nc(f):
            garder_avant(p, rel, empreintes)       # retouchée depuis l'installation : tes retouches gardées
            f.unlink()
        avant = f.with_name(f.name + ".avant-nc")
        if avant.is_file() and not f.exists():
            avant.replace(f)
            print(f"ton {rel} d'avant est remis")
    css = p / "chrome/nc-couleurs.css"
    if pose_par_nc(css):
        css.unlink()
    (p / EMPREINTES).unlink(missing_ok=True)
    print(f"config Firefox retirée de {p} (relance Firefox)")
    return 0


def etat(p):
    extension_etat(p, dire=True)
    return 0 if all(pose_par_nc(p / rel) for rel in FICHIERS) else 1


def lire_palette():
    try:
        pal = json.loads(PALETTE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(pal, dict):
        return None
    def couleur(v):
        return isinstance(v, str) and len(v) == 7 and v.startswith("#") and all(c in "0123456789abcdefABCDEF" for c in v[1:])
    propre = {k: v for k, v in pal.items() if couleur(v)}
    propre["sombre"] = pal.get("sombre") is not False
    return propre


def couleurs(p):
    """chrome/nc-couleurs.css : les couleurs de l'île en variables CSS. Seulement si le style est installé."""
    if not pose_par_nc(p / "chrome/userChrome.css"):
        return 0
    f = p / "chrome/nc-couleurs.css"
    pal = lire_palette()
    paires = [("fond", "fond"), ("carte", "carte"), ("carte-survol", "carteSurvol"), ("accent", "accent"),
              ("texte", "texte"), ("texte-sec", "texteSec")]
    lignes = [f"  --nc-couleur-{nom}: {pal[cle]};" for nom, cle in paires if pal and cle in pal]
    if not lignes:
        return 0
    # Seulement si le thème de Firefox (sombre, clair ou système) est du même côté que le fond d'écran : avec un thème
    # clair sur un fond sombre, les barres gardent les couleurs du thème de Firefox et seulement la forme de l'île
    media = f"@media (prefers-color-scheme: {'dark' if pal['sombre'] else 'light'})"
    if extension_etat(p) == 0:
        # Filet de sécurité : l'extension « Couleurs de l'île » donne les couleurs en direct, mais si son hôte ne
        # répond pas (Flatpak, Snap, dossier d'hôtes changé), il ne resterait aucune couleur. Les variables restent
        # donc, sous :root:not([lwtheme]) : dès que l'extension pose son thème, Firefox met l'attribut lwtheme sur la
        # fenêtre et ces variables figées s'effacent devant le thème en direct.
        css = (f"/* {MARQUE} : écrit par nc-theme-sync (nc-firefox couleurs). Filet de sécurité : l'extension « Couleurs de l'île »\n"
               "   donne les couleurs en direct (thème dynamique, attribut lwtheme) et ces variables ne servent alors plus ;\n"
               "   sans elle (hôte natif absent), elles donnent les couleurs du fond d'écran au démarrage. */\n"
               f"{media} {{\n  :root:not([lwtheme]) {{\n" + "\n".join("  " + l for l in lignes) + "\n  }\n}\n")
    else:
        css = (f"/* {MARQUE} : écrit par nc-theme-sync (nc-firefox couleurs), les couleurs du fond d'écran. Ne pas modifier :\n"
               "   régénéré à chaque changement de fond. Firefox le relit au démarrage. */\n"
               f"{media} {{\n  :root {{\n" + "\n".join("  " + l for l in lignes) + "\n  }\n}\n")
    if not f.is_file() or f.read_text(encoding="utf-8", errors="replace") != css:
        ecrire_atomique(f, css)
    return 0


# ── Extension « Couleurs de l'île » ───────────────────────────────────────────

def dossiers_hotes(p):
    """Où Firefox cherche les hôtes natifs de l'utilisateur : ~/.mozilla/native-messaging-hosts, MÊME quand les profils
    sont rangés à la façon XDG (~/.config/mozilla/firefox) ; il ne lit ni $XDG_CONFIG_HOME/mozilla/native-messaging-hosts
    ni celui de XDG_DATA_HOME (mesuré avec Firefox 159). Un ~/.mozilla qui ne contient que ce dossier ne fait pas
    chercher les profils là. Flatpak et Snap (profil dans …/.mozilla/firefox) : le .mozilla voisin du profil."""
    base = p.parent.parent          # …/.mozilla/firefox/<profil> → …/.mozilla
    if base.name == ".mozilla":
        return [base / "native-messaging-hosts"]
    return [HOME / ".mozilla/native-messaging-hosts"]


def hote_pose_par_nc(f):
    try:
        m = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return isinstance(m, dict) and m.get("name") == HOTE and str(m.get("description", "")).startswith("Couleurs de l'île")


def retirer_anciens_hotes(p):
    """Avant, le manifeste était posé à côté de profiles.ini (…/mozilla/native-messaging-hosts), où Firefox ne le lit
    pas : retiré s'il est de nc-firefox, avec le dossier s'il est resté vide."""
    nouveaux = set(dossiers_hotes(p))
    ancien = p.parent.parent / "native-messaging-hosts"
    if ancien in nouveaux:
        return
    f = ancien / (HOTE + ".json")
    if f.is_file() and hote_pose_par_nc(f):
        f.unlink()
        try:
            ancien.rmdir()
        except OSError:
            pass


def hote_manquant(p):
    """Un texte si l'extension est posée mais que Firefox ne peut pas lancer son hôte natif, sinon None."""
    if extension_etat(p) != 0:
        return None
    for d in dossiers_hotes(p):
        f = d / (HOTE + ".json")
        try:
            chemin = Path(json.loads(f.read_text(encoding="utf-8"))["path"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if chemin.is_file() and os.access(chemin, os.X_OK):
            return None
        return f"hôte natif cassé : {f} vise {chemin}, qui n'existe pas ou n'est pas exécutable (relance : nc-firefox extension installer)"
    return (f"hôte natif introuvable : pas de {HOTE}.json dans {dossiers_hotes(p)[0]}, l'extension « Couleurs de l'île » "
            "ne reçoit aucune couleur (relance : nc-firefox extension installer)")


def accepte_non_signee(p):
    """Firefox Developer Edition, Nightly ou ESR (Debian) acceptent une extension non signée ; le Firefox normal
    (Fedora, Arch « firefox », Flatpak, Snap d'Ubuntu) la refuse. Lu dans compatibility.ini du profil ; un profil
    jamais ouvert ne dit rien : on essaie."""
    cfg = configparser.RawConfigParser()
    try:
        cfg.read(p / "compatibility.ini", encoding="utf-8")
    except configparser.Error:
        return True
    dossier = cfg.get("Compatibility", "LastPlatformDir", fallback="").lower()
    version = cfg.get("Compatibility", "LastVersion", fallback="").split("_")[0].lower()
    if not dossier and not version:
        return True
    return any(m in dossier for m in ("developer", "nightly", "esr", "aurora")) or "a1" in version or "esr" in version


def extension_installer(p):
    src = SOURCE / "extension"
    if not accepte_non_signee(p):
        print("nc-firefox : ce Firefox refuse les extensions non signées (seuls Developer Edition, Nightly et ESR les "
              "acceptent) ; le style de l'île et ses couleurs au démarrage restent (nc-firefox installer)", file=sys.stderr)
        return 4
    if not (src / "manifest.json").is_file():
        print(f"nc-firefox : extension absente, {src}", file=sys.stderr)
        return 1
    (p / "extensions").mkdir(exist_ok=True)
    xpi = p / "extensions" / (EXTENSION_ID + ".xpi")
    with zipfile.ZipFile(xpi, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(src.iterdir()):
            if f.is_file():
                z.write(f, f.name)
    manifest = {"name": HOTE, "description": "Couleurs de l'île (noctalia-config) : la palette du fond d'écran pour Firefox",
                "path": str(HOME / ".local/bin/nc-firefox"), "type": "stdio", "allowed_extensions": [EXTENSION_ID]}
    for d in dossiers_hotes(p):
        d.mkdir(parents=True, exist_ok=True)
        ecrire_atomique(d / (HOTE + ".json"), json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    retirer_anciens_hotes(p)
    if pose_par_nc(p / "user.js") or not (p / "user.js").exists():
        if not pose_par_nc(p / "user.js"):
            installer(p)
        else:
            ecrire_user_js(p)
    couleurs(p)                                  # plus de couleurs figées : l'extension les donne en direct
    print(f"extension « Couleurs de l'île » posée dans {p} (relance Firefox : elle s'active au démarrage)")
    return 0


def extension_desinstaller(p, silencieux=False, complet=False):
    """complet : tout est retiré juste après ; user.js n'est pas réécrit (une retouche serait effacée avant d'être gardée)."""
    xpi = p / "extensions" / (EXTENSION_ID + ".xpi")
    if xpi.is_file():
        xpi.unlink()
    for d in dossiers_hotes(p):
        f = d / (HOTE + ".json")
        if f.is_file() and hote_pose_par_nc(f):              # dossier partagé : jamais le manifeste d'un autre
            f.unlink()
        for vide in (d, d.parent):                            # native-messaging-hosts, puis .mozilla, s'ils sont vides
            try:
                vide.rmdir()
            except OSError:
                break
    retirer_anciens_hotes(p)
    if complet:
        return 0
    if pose_par_nc(p / "user.js"):
        ecrire_user_js(p)
    couleurs(p)                                  # sans l'extension : les couleurs du fond, lues au démarrage
    if not silencieux:
        print(f"extension retirée de {p} (relance Firefox : il revient au thème d'avant)")
    return 0


def extension_etat(p, dire=False):
    if not (p / "extensions" / (EXTENSION_ID + ".xpi")).is_file():
        return 1
    if dire and (m := hote_manquant(p)):
        print(f"nc-firefox : {m}", file=sys.stderr)
    return 0


def hote():
    """Hôte natif (lancé par Firefox : nc-firefox CHEMIN_DU_MANIFESTE ID_EXTENSION) : envoie la palette tout de suite,
    puis à chaque changement de ~/.config/nc/palette-ile.json ; s'arrête quand Firefox ferme la liaison."""
    sortie = sys.stdout.buffer
    entree = sys.stdin.buffer
    fini = threading.Event()

    def envoyer(obj):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        try:
            sortie.write(struct.pack("<I", len(data)) + data)
            sortie.flush()
        except (OSError, ValueError):
            fini.set()

    def lire():
        while not fini.is_set():
            en_tete = entree.read(4)
            if len(en_tete) < 4:
                break
            n = struct.unpack("<I", en_tete)[0]
            entree.read(n)                      # seule demande possible : « couleurs »
            pal = lire_palette()
            if pal:
                envoyer({"palette": pal})
        fini.set()

    threading.Thread(target=lire, daemon=True).start()
    derniere = None
    parent = os.getppid()
    while not fini.is_set():
        if os.getppid() != parent:          # Firefox parti sans fermer la liaison (tué) : on ne reste pas orphelin
            break
        try:
            m = PALETTE.stat().st_mtime_ns
        except OSError:
            m = None
        if m is not None and m != derniere:
            derniere = m
            pal = lire_palette()
            if pal:
                envoyer({"palette": pal})
        fini.wait(1.0)
    os._exit(0)                              # sans attendre le fil bloqué sur l'entrée


def main(argv):
    if len(argv) >= 2 and argv[0].endswith(".json") and argv[1].startswith(EXTENSION_ID):
        return hote()
    if argv and argv[0] == "extension":
        sous = ACTIONS.get(argv[1], argv[1]) if len(argv) > 1 else "etat"
        fn = {"installer": extension_installer, "desinstaller": extension_desinstaller, "etat": extension_etat}.get(sous)
        if not fn:
            print(__doc__.strip(), file=sys.stderr)
            return 2
        p = profil()
        if sous == "etat" and p:
            return extension_etat(p, dire=True)
        return fn(p) if p else 1
    action = ACTIONS.get(argv[0], argv[0]) if argv else "profil"
    if action not in ("profil", "installer", "desinstaller", "couleurs", "etat"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    p = profil()
    if not p:
        if action == "profil":
            print("nc-firefox : aucun profil Firefox trouvé", file=sys.stderr)
        return 1
    if action == "profil":
        print(p)
        return 0
    return {"installer": installer, "desinstaller": desinstaller, "couleurs": couleurs, "etat": etat}[action](p)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
