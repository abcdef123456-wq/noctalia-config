#!/usr/bin/env python3
"""nc-firefox : la config Firefox du dépôt (préférences et style de l'île) dans ton profil.

  nc-firefox profil        affiche le dossier du profil par défaut (profiles.ini de ~/.config/mozilla/firefox,
                           ~/.mozilla/firefox, ou des versions Flatpak et Snap ; NC_FIREFOX_PROFIL le force)
  nc-firefox installer     copie user.js et chrome/ (userChrome.css, userContent.css) dans le profil, puis écrit
                           les couleurs ; un user.js à toi est gardé en user.js.avant-nc
  nc-firefox desinstaller  retire ce que nc-firefox a posé (rien d'autre), remet user.js.avant-nc s'il existe
  nc-firefox couleurs      écrit chrome/nc-couleurs.css depuis la palette de l'île (~/.config/nc/palette-ile.json) ;
                           appelé par nc-theme-sync à chaque fond d'écran, sans effet tant que rien n'est installé
  nc-firefox etat          0 si la config est en place dans le profil, 1 sinon

  nc-firefox extension installer | desinstaller | etat
      L'extension « Couleurs de l'île » : le thème de Firefox suit en direct les couleurs du fond d'écran, sans
      relancer (réglage FIREFOX_COULEURS de nc-reglages → Apparence). Elle est posée dans extensions/ du profil
      (chargée au prochain démarrage de Firefox, activée d'elle-même) avec son hôte natif (ce script, déclaré dans
      native-messaging-hosts). Non signée : Firefox Developer Edition, Nightly et ESR l'acceptent
      (xpinstall.signatures.required à faux) ; avec la version grand public (Fedora, Snap d'Ubuntu, Flatpak),
      l'installation est refusée (code 4) au lieu de poser une extension que Firefox rejetterait.

Les fichiers viennent de ~/.local/share/nc/firefox. Firefox relit user.js et chrome/ au démarrage : ferme-le et
rouvre-le. Sans Firefox ni profil : rien n'est fait, code 1. Noms anglais acceptés : profile, install, uninstall,
colors, status, extension.
"""
import configparser
import json
import os
from pathlib import Path
import shutil
import struct
import sys
import threading
import time
import zipfile

HOME = Path.home()
SOURCE = Path(os.environ.get("NC_FIREFOX_SOURCE") or HOME / ".local/share/nc/firefox")
PALETTE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "nc/palette-ile.json"
MARQUE = "nc-firefox"
FICHIERS = ("user.js", "chrome/userChrome.css", "chrome/userContent.css")
EXTENSION_ID = "nc-couleurs@noctalia-config"
HOTE = "nc_firefox"
ACTIONS = {"profile": "profil", "install": "installer", "uninstall": "desinstaller", "colors": "couleurs", "status": "etat"}
BLOC_EXTENSION = f"""
// --- {MARQUE} extension : « Couleurs de l'île » (nc-firefox extension installer) ---
user_pref("xpinstall.signatures.required", false);                         // extension non signée (Developer Edition, Nightly, ESR)
user_pref("extensions.sideloadScopes", 1);                                 // extensions/ du profil lu au démarrage
user_pref("extensions.autoDisableScopes", 14);                             // celles du profil sont activées d'elles-mêmes
"""


def dossiers_candidats():
    xdg = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
    return [xdg / "mozilla/firefox", HOME / ".mozilla/firefox",
            HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox", HOME / "snap/firefox/common/.mozilla/firefox"]


def profil():
    """Le dossier du profil par défaut, ou None. Priorité : NC_FIREFOX_PROFIL, puis le profil « Default » de la
    section [Install…] (celui que Firefox ouvre), puis Default=1, puis le premier profil existant."""
    force = os.environ.get("NC_FIREFOX_PROFIL")
    if force:
        return Path(force) if Path(force).is_dir() else None
    for base in dossiers_candidats():
        ini = base / "profiles.ini"
        if not ini.is_file():
            continue
        cfg = configparser.RawConfigParser()
        cfg.optionxform = str
        try:
            cfg.read(ini, encoding="utf-8")
        except configparser.Error:
            continue

        def chemin(section):
            p = cfg.get(section, "Path", fallback=None)
            if not p:
                return None
            rel = cfg.get(section, "IsRelative", fallback="1") == "1"
            d = base / p if rel else Path(p)
            return d if d.is_dir() else None

        for s in cfg.sections():
            if s.startswith("Install"):
                p = cfg.get(s, "Default", fallback="")
                if p and (base / p).is_dir():
                    return base / p
        profils = [s for s in cfg.sections() if s.startswith("Profile")]
        for s in profils:
            if cfg.get(s, "Default", fallback="0") == "1" and chemin(s):
                return chemin(s)
        for s in profils:
            if chemin(s):
                return chemin(s)
    return None


def pose_par_nc(f):
    try:
        return f.is_file() and MARQUE in f.read_text(encoding="utf-8", errors="replace")[:400]
    except OSError:
        return False


def reglage(cle, defaut):
    try:
        for l in (Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "nc/reglages.conf").read_text(encoding="utf-8").splitlines():
            if l.startswith(cle + "="):
                return l.split("=", 1)[1].strip().strip('"') or defaut
    except OSError:
        pass
    return defaut


def bloc_reglages():
    """Préférences qui suivent nc-reglages (Apparence → Firefox : …) ; plus bas dans user.js, elles l'emportent."""
    verticaux = reglage("FIREFOX_ONGLETS_VERTICAUX", "non") == "oui"
    return (f"\n// --- {MARQUE} : tes réglages (nc-reglages → Apparence) ---\n"
            f'user_pref("sidebar.revamp", {"true" if verticaux else "false"});\n'
            f'user_pref("sidebar.verticalTabs", {"true" if verticaux else "false"});\n'
            f'user_pref("browser.startup.page", {3 if reglage("FIREFOX_SESSION", "oui") != "non" else 1});\n'
            f'user_pref("general.smoothScroll", {"false" if reglage("FIREFOX_DEFILEMENT_DOUX", "oui") == "non" else "true"});\n')


def ecrire_user_js(p):
    """user.js = celui du dépôt, tes réglages, plus le bloc de l'extension si elle est installée."""
    texte = (SOURCE / "user.js").read_text(encoding="utf-8") + bloc_reglages()
    if extension_etat(p) == 0:
        texte += BLOC_EXTENSION
    (p / "user.js").write_text(texte, encoding="utf-8")


def installer(p):
    for rel in FICHIERS:
        src = SOURCE / rel
        if not src.is_file():
            print(f"nc-firefox : source absente, {src}", file=sys.stderr)
            return 1
    ancien = p / "user.js"
    if ancien.is_file() and not pose_par_nc(ancien):
        shutil.copy2(ancien, p / "user.js.avant-nc")
        print(f"ton user.js est gardé en {p / 'user.js.avant-nc'}")
    (p / "chrome").mkdir(exist_ok=True)
    for rel in FICHIERS[1:]:
        shutil.copyfile(SOURCE / rel, p / rel)
    ecrire_user_js(p)
    couleurs(p)
    print(f"config Firefox installée dans {p} (relance Firefox)")
    return 0


def desinstaller(p):
    extension_desinstaller(p, silencieux=True)
    for rel in FICHIERS:
        f = p / rel
        if pose_par_nc(f):
            f.unlink()
    css = p / "chrome/nc-couleurs.css"
    if pose_par_nc(css):
        css.unlink()
    avant = p / "user.js.avant-nc"
    if avant.is_file():
        avant.replace(p / "user.js")
        print("ton user.js d'avant est remis")
    print(f"config Firefox retirée de {p} (relance Firefox)")
    return 0


def etat(p):
    return 0 if all(pose_par_nc(p / rel) for rel in FICHIERS) else 1


def lire_palette():
    try:
        pal = json.loads(PALETTE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(pal, dict):
        return None
    def couleur(v):
        return isinstance(v, str) and len(v) == 7 and v.startswith("#") and all(c in "0123456789abcdefABCDEF" for c in v[1:])
    propre = {k: v for k, v in pal.items() if couleur(v)}
    propre["sombre"] = pal.get("sombre") is not False
    return propre


def couleurs(p):
    """chrome/nc-couleurs.css : les couleurs de l'île en variables CSS. Seulement si le style est installé."""
    if not pose_par_nc(p / "chrome/userChrome.css"):
        return 0
    pal = lire_palette()
    if not pal:
        return 0
    paires = [("fond", "fond"), ("carte", "carte"), ("carte-survol", "carteSurvol"), ("accent", "accent"),
              ("texte", "texte"), ("texte-sec", "texteSec")]
    lignes = [f"  --nc-couleur-{nom}: {pal[cle]};" for nom, cle in paires if cle in pal]
    if not lignes:
        return 0
    # Seulement si le thème de Firefox (sombre, clair ou système) est du même côté que le fond d'écran : avec un thème
    # clair sur un fond sombre, les barres gardent les couleurs du thème de Firefox et seulement la forme de l'île
    css = (f"/* {MARQUE} : écrit par nc-theme-sync (nc-firefox couleurs), les couleurs du fond d'écran. Ne pas modifier :\n"
           "   régénéré à chaque changement de fond. Firefox le relit au démarrage. */\n"
           f"@media (prefers-color-scheme: {'dark' if pal['sombre'] else 'light'}) {{\n  :root {{\n" + "\n".join("  " + l for l in lignes) + "\n  }\n}\n")
    f = p / "chrome/nc-couleurs.css"
    if not f.is_file() or f.read_text(encoding="utf-8", errors="replace") != css:
        f.write_text(css, encoding="utf-8")
    return 0


# ── Extension « Couleurs de l'île » ───────────────────────────────────────────

def dossiers_hotes(p):
    """Où Firefox cherche les hôtes natifs de l'utilisateur : à côté de profiles.ini (jamais ~/.mozilla créé de
    toutes pièces : Firefox y chercherait alors ses profils)."""
    base = p.parent.parent          # …/mozilla/firefox/<profil> → …/mozilla
    return [base / "native-messaging-hosts"]


def accepte_non_signee(p):
    """Firefox Developer Edition, Nightly ou ESR (Debian) acceptent une extension non signée ; le Firefox normal
    (Fedora, Arch « firefox », Flatpak, Snap d'Ubuntu) la refuse. Lu dans compatibility.ini du profil ; un profil
    jamais ouvert ne dit rien : on essaie."""
    cfg = configparser.RawConfigParser()
    try:
        cfg.read(p / "compatibility.ini", encoding="utf-8")
    except configparser.Error:
        return True
    dossier = cfg.get("Compatibility", "LastPlatformDir", fallback="").lower()
    version = cfg.get("Compatibility", "LastVersion", fallback="").split("_")[0].lower()
    if not dossier and not version:
        return True
    return any(m in dossier for m in ("developer", "nightly", "esr", "aurora")) or "a1" in version or "esr" in version


def extension_installer(p):
    src = SOURCE / "extension"
    if not accepte_non_signee(p):
        print("nc-firefox : ce Firefox refuse les extensions non signées (seuls Developer Edition, Nightly et ESR les "
              "acceptent) ; le style de l'île et ses couleurs au démarrage restent (nc-firefox installer)", file=sys.stderr)
        return 4
    if not (src / "manifest.json").is_file():
        print(f"nc-firefox : extension absente, {src}", file=sys.stderr)
        return 1
    (p / "extensions").mkdir(exist_ok=True)
    xpi = p / "extensions" / (EXTENSION_ID + ".xpi")
    with zipfile.ZipFile(xpi, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(src.iterdir()):
            if f.is_file():
                z.write(f, f.name)
    manifest = {"name": HOTE, "description": "Couleurs de l'île (noctalia-config) : la palette du fond d'écran pour Firefox",
                "path": str(HOME / ".local/bin/nc-firefox"), "type": "stdio", "allowed_extensions": [EXTENSION_ID]}
    for d in dossiers_hotes(p):
        d.mkdir(parents=True, exist_ok=True)
        (d / (HOTE + ".json")).write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    if pose_par_nc(p / "user.js") or not (p / "user.js").exists():
        if not pose_par_nc(p / "user.js"):
            installer(p)
        else:
            ecrire_user_js(p)
    print(f"extension « Couleurs de l'île » posée dans {p} (relance Firefox : elle s'active au démarrage)")
    return 0


def extension_desinstaller(p, silencieux=False):
    xpi = p / "extensions" / (EXTENSION_ID + ".xpi")
    if xpi.is_file():
        xpi.unlink()
    for d in dossiers_hotes(p):
        f = d / (HOTE + ".json")
        if f.is_file():
            f.unlink()
    if pose_par_nc(p / "user.js"):
        ecrire_user_js(p)
    if not silencieux:
        print(f"extension retirée de {p} (relance Firefox : il revient au thème d'avant)")
    return 0


def extension_etat(p):
    return 0 if (p / "extensions" / (EXTENSION_ID + ".xpi")).is_file() else 1


def hote():
    """Hôte natif (lancé par Firefox : nc-firefox CHEMIN_DU_MANIFESTE ID_EXTENSION) : envoie la palette tout de suite,
    puis à chaque changement de ~/.config/nc/palette-ile.json ; s'arrête quand Firefox ferme la liaison."""
    sortie = sys.stdout.buffer
    entree = sys.stdin.buffer
    fini = threading.Event()

    def envoyer(obj):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        try:
            sortie.write(struct.pack("<I", len(data)) + data)
            sortie.flush()
        except (OSError, ValueError):
            fini.set()

    def lire():
        while not fini.is_set():
            en_tete = entree.read(4)
            if len(en_tete) < 4:
                break
            n = struct.unpack("<I", en_tete)[0]
            entree.read(n)                      # seule demande possible : « couleurs »
            pal = lire_palette()
            if pal:
                envoyer({"palette": pal})
        fini.set()

    threading.Thread(target=lire, daemon=True).start()
    derniere = None
    parent = os.getppid()
    while not fini.is_set():
        if os.getppid() != parent:          # Firefox parti sans fermer la liaison (tué) : on ne reste pas orphelin
            break
        try:
            m = PALETTE.stat().st_mtime_ns
        except OSError:
            m = None
        if m is not None and m != derniere:
            derniere = m
            pal = lire_palette()
            if pal:
                envoyer({"palette": pal})
        fini.wait(1.0)
    os._exit(0)                              # sans attendre le fil bloqué sur l'entrée


def main(argv):
    if len(argv) >= 2 and argv[0].endswith(".json") and argv[1].startswith(EXTENSION_ID):
        return hote()
    if argv and argv[0] == "extension":
        sous = ACTIONS.get(argv[1], argv[1]) if len(argv) > 1 else "etat"
        fn = {"installer": extension_installer, "desinstaller": extension_desinstaller, "etat": extension_etat}.get(sous)
        if not fn:
            print(__doc__.strip(), file=sys.stderr)
            return 2
        p = profil()
        return fn(p) if p else 1
    action = ACTIONS.get(argv[0], argv[0]) if argv else "profil"
    if action not in ("profil", "installer", "desinstaller", "couleurs", "etat"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    p = profil()
    if not p:
        if action == "profil":
            print("nc-firefox : aucun profil Firefox trouvé", file=sys.stderr)
        return 1
    if action == "profil":
        print(p)
        return 0
    return {"installer": installer, "desinstaller": desinstaller, "couleurs": couleurs, "etat": etat}[action](p)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
