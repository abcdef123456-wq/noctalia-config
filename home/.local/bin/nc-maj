#!/usr/bin/env bash
# nc-maj : met ce bureau à jour depuis GitHub, en une commande.
# Récupère la dernière version du dépôt noctalia-config (git fetch, puis avance), puis relance install.sh, qui ne refait que ce qui
# a changé ou manque (tes fichiers personnels et tes couleurs ne sont pas touchés).
#   nc-maj                 mise à jour complète (une question avant chaque étape système pas encore faite)
#   nc-maj --no-system     seulement ta session
#   nc-maj verifier        y a-t-il une nouvelle version ? Une notification avec « Mettre à jour » (une fois par
#                          version ; lancé toutes les heures par nc-maj-verif.timer ; coupé par nc-reglages, MAJ_VERIFIER=non ;
#                          et par Telegram si « Alertes Telegram » : nc-alertes version, réessayé tant qu'il n'est pas parti)
#   nc-maj --help          cette aide (rien n'est récupéré ni installé) ; les autres options vont à install.sh
set -euo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
depot="$(cat "$HOME/.config/nc/depot" 2>/dev/null || true)"
# La dernière version qu'install.sh a menée à bout (il la note seulement s'il va jusqu'au bout), mais seulement si
# une installation lancée par nc-maj n'est pas allée au bout (marqueur installation-en-cours, écrit par nc-maj juste
# avant ./install.sh, effacé par install.sh à son « Terminé ») ; sinon HEAD. Après un install.sh qui échoue à moitié
# (ou un « non » à « On y va ? »), HEAD a déjà avancé : c'est cette version-là qui sert de base aux nouveautés, au
# rapport et à l'annonce, pour que la relance ne dise pas « Déjà à jour » en perdant ce qui n'a pas été installé.
# Sans marqueur, HEAD : qui pousse ses commits et copie les fichiers à la main, sans install.sh, n'est pas prévenu de
# ses propres versions (version-installee, restée ancienne, ne compte pas). Même base dans nc-reglages (maj_disponible)
en_cours="$HOME/.config/nc/installation-en-cours"
base_installee() {
  local v=""
  [ -e "$en_cours" ] && v="$(cat "$HOME/.config/nc/version-installee" 2>/dev/null || true)"
  [ -n "$v" ] && git rev-parse -q --verify "$v^{commit}" 2>/dev/null || git rev-parse HEAD
}

if [ "${1:-}" = verifier ] || [ "${1:-}" = check ]; then
  grep -qx 'MAJ_VERIFIER=non' "$HOME/.config/nc/reglages.conf" 2>/dev/null && exit 0
  [ -d "$depot/.git" ] || exit 0
  cd "$depot"
  # Adresse publique (https), sans clé ni mot de passe : jamais de question en arrière-plan
  # (« || … » : avec pipefail, un échec dans le tube quitterait le script en erreur, et le service avec : hors ligne,
  # ce n'est pas une panne — revue MAJ-01)
  url="$(git remote get-url origin 2>/dev/null | sed -E 's#^git@github\.com:#https://github.com/#')" || exit 0
  branche="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  distant="$(GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote "$url" "refs/heads/$branche" 2>/dev/null | cut -f1)" || distant=""
  [ -n "$distant" ] || exit 0                                  # hors ligne
  base="$(base_installee)"
  # À jour : la version publiée est déjà installée ici (ou plus ancienne que la tienne)
  git merge-base --is-ancestor "$distant" "$base" 2>/dev/null && exit 0
  annonce="${XDG_CACHE_HOME:-$HOME/.cache}/nc/maj-annoncee"
  telegram="${XDG_CACHE_HOME:-$HOME/.cache}/nc/maj-telegram"   # annoncée par JARVIS (Telegram), seulement si partie
  deja_bureau=0; [ "$(cat "$annonce" 2>/dev/null)" = "$distant" ] && deja_bureau=1
  deja_tg=0; [ "$(cat "$telegram" 2>/dev/null)" = "$distant" ] && deja_tg=1
  [ -x "$HOME/.local/bin/nc-alertes" ] || deja_tg=1
  [ "$deja_bureau" = 1 ] && [ "$deja_tg" = 1 ] && exit 0      # déjà annoncée partout
  mkdir -p "$(dirname "$annonce")"
  # Les grosses nouveautés : la nouvelle version est téléchargée (pas installée) pour lire ses messages de mise à jour ;
  # chacun ramené à son idée principale (avant « ; », sans les parenthèses), les 4 plus récents
  nouveau=""
  if GIT_TERMINAL_PROMPT=0 timeout 60 git fetch -q "$url" "$branche" 2>/dev/null; then
    # Les sujets absents de l'historique d'ici (après une réécriture en amont, les identifiants ont changé)
    sujets="$(awk 'NR == FNR { vus[$0]; next } !($0 in vus)' <(git log --format=%s "$base") <(git log --format=%s FETCH_HEAD) 2>/dev/null || true)"
    # Rien de nouveau à voir (seulement l'historique réécrit en amont : mêmes fichiers, mêmes sujets) : pas d'annonce
    if [ -z "$sujets" ] && git diff --quiet "$base" FETCH_HEAD 2>/dev/null; then
      echo "$distant" > "$annonce"; echo "$distant" > "$telegram"; exit 0
    fi
    nouveau="$(printf '%s\n' "$sujets" | python3 -c '
import os, re, sys
l = [x.strip() for x in sys.stdin if x.strip()]
def idee(s):
    while re.search(r" \([^()]*\)", s):      # parenthèses retirées avant : un « ; » dedans ne coupe pas
        s = re.sub(r" \([^()]*\)", "", s)
    s = s.split(" ; ")[0].split(" : ")[0]                # le titre seul : la bannière de l île a deux lignes
    s = re.sub(r"\s+", " ", s).strip(" ,;")
    return s if len(s) <= 48 else s[:47].rsplit(" ", 1)[0] + "…"
texte = " · ".join(idee(s) for s in l[:4])
autres = "others" if os.environ.get("NC_LANGUE") == "en" else "autres"
print(texte + (f" (+ {len(l) - 4} {autres})" if len(l) > 4 else ""))
' 2>/dev/null || true)"
  fi
  [ -n "$nouveau" ] || nouveau="$(t "Des améliorations sont disponibles." "Improvements are available.")"
  # Par Telegram aussi ; pas partie (JARVIS injoignable) : au passage suivant, même si le bureau l'a déjà annoncée.
  # Rien sans « Alertes Telegram » (nc-alertes sort tout de suite). En arrière-plan quand le bureau l'annonce : un
  # JARVIS injoignable ne retarde plus la notification (jusqu'à 90 s, revue MAJ-02)
  envoyer_tg() { timeout 90 "$HOME/.local/bin/nc-alertes" version "$nouveau" >/dev/null 2>&1 && echo "$distant" > "$telegram"; }
  if [ "$deja_tg" = 0 ]; then
    if [ "$deja_bureau" = 1 ]; then envoyer_tg || true; exit 0; fi
    envoyer_tg &
  fi
  [ "$deja_bureau" = 1 ] && exit 0
  echo "$distant" > "$annonce"
  choix="$(notify-send -a "noctalia-config" -i system-software-update -t 0 -A maj="$(t "Mettre à jour" "Update")" \
    -A tout="$(t "Tout voir" "See all")" -A tard="$(t "Plus tard" "Later")" \
    "$(t "Nouvelle version de la config" "New version of the config")" "$nouveau" 2>/dev/null || true)"
  [ "$choix" = maj ] && exec kitty --class nc-maj -e sh -c "$HOME/.local/bin/nc-maj; echo; printf '$(t "Entrée pour fermer" "Press Enter to close")'; read r"
  # « Tout voir » : la section Nouveautés de la fenêtre des réglages ; sans l'île, nc-reglages les montre dans un terminal
  [ "$choix" = tout ] && exec "$HOME/.local/bin/nc-reglages" fenetre Nouveautés
  wait || true                                                 # l'envoi Telegram finit avant le service
  exit 0
fi
# L'aide : tout de suite, sans rien récupérer (avant, la mise à jour était faite, puis install.sh affichait son aide
# et sortait en 0 : nc-maj lançait le rapport de l'IA et le bilan d'une installation qui n'avait pas eu lieu)
for a in "$@"; do
  case "$a" in
    -h|--help)
      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
      echo "$(t "Options d'install.sh (passées telles quelles) : --no-system, --files-only, --restore, --en, --fr" "install.sh options (passed as is): --no-system, --files-only, --restore, --en, --fr")"
      exit 0 ;;
  esac
done
if [ ! -d "$depot/.git" ]; then
  echo "$(t "Dépôt noctalia-config introuvable (${depot:-chemin inconnu})." "noctalia-config repository not found (${depot:-unknown path}).")" >&2
  echo "$(t "Clone-le puis lance l'installation une fois :" "Clone it, then run the installer once:") git clone https://github.com/abcdef123456-wq/noctalia-config.git ~/noctalia-config && ~/noctalia-config/install.sh" >&2
  exit 1
fi
cd "$depot"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "$(t "Le dépôt $depot contient des modifications locales : mise à jour annulée pour ne pas les écraser." "The repository $depot has local changes: update cancelled so they are not overwritten.")" >&2
  echo "$(t "(git status pour les voir ; git stash pour les mettre de côté)" "(git status to see them; git stash to set them aside)")" >&2
  exit 1
fi
avant="$(git rev-parse HEAD)"
base="$(base_installee)"                                       # = avant, sauf après un install.sh resté à moitié
branche="$(git rev-parse --abbrev-ref HEAD)"
ancien="$(git rev-parse -q --verify "refs/remotes/origin/$branche" 2>/dev/null || true)"   # l'amont avant ce fetch
# Pas de délai fixe : timeout couperait un fetch lent qui avance, et le sortirait du premier plan du terminal (ssh ou
# HTTPS ne pourraient plus demander une phrase de passe, un mot de passe ou l'empreinte de l'hôte). Seul un réseau
# bloqué est coupé : ssh abandonne une connexion qui ne s'établit pas en 20 s ou un serveur muet depuis une minute
# (sauf si tu as ta propre commande ssh : GIT_SSH_COMMAND, GIT_SSH, core.sshCommand), HTTPS un débit sous 1 ko/s
# pendant 60 s. En cas d'échec, une phrase, puis la dernière ligne de l'erreur de git
if [ -z "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && [ -z "$(git config core.sshCommand 2>/dev/null || true)" ]; then
  export GIT_SSH_COMMAND="ssh -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
fi
if ! erreur="$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 fetch -q origin "$branche" 2>&1 >/dev/null)"; then
  echo "$(t "GitHub injoignable (réseau coupé ou trop lent ?) : mise à jour annulée, rien n'a changé. Réessaie plus tard." "GitHub unreachable (network down or too slow?): update cancelled, nothing changed. Try again later.")" >&2
  erreur="$(printf '%s\n' "$erreur" | sed '/^[[:space:]]*$/d' | tail -n 1)"
  [ -z "$erreur" ] || echo "  (git : $erreur)" >&2
  echo "$(t "(git fetch origin dans $depot pour le détail)" "(git fetch origin in $depot for details)")" >&2
  exit 2
fi
amont="$(git rev-parse "refs/remotes/origin/$branche")"
# Un fichier non suivi à toi au même chemin qu'un fichier que la mise à jour apporte ou change : refus en le nommant
# (git reset --hard l'écraserait sans un mot, git merge s'arrêterait sur une erreur brute). Identique à celui de
# l'amont (git hash-object = l'objet de l'amont à ce chemin), rien ne serait perdu : il ne bloque pas, et il est retiré
# juste avant la mise à jour (git merge refuserait de le remplacer), qui le remet tel quel
caches=""; identiques=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ -f "$f" ] && [ ! -L "$f" ] &&
     [ "$(git hash-object -- "$f" 2>/dev/null || echo illisible)" = "$(git rev-parse -q --verify "$amont:$f" 2>/dev/null || echo absent)" ]; then
    identiques+=("$f"); continue
  fi
  # Ignoré ici (.gitignore, .git/info/exclude) : git status ne le montre pas, d'où l'explication
  if git check-ignore -q -- "$f" 2>/dev/null; then
    f="$f   $(t "(ignoré par git ici, mais la mise à jour se met à le suivre)" "(ignored by git here, but the update starts tracking it)")"
  fi
  caches="$caches$f"$'\n'
done < <(git -c core.quotePath=false ls-files -o | grep -Fx -f <(git -c core.quotePath=false diff --name-only HEAD "$amont") || true)
if [ -n "$caches" ]; then
  echo "$(t "Le dépôt $depot contient des fichiers à toi que la mise à jour écraserait : mise à jour annulée pour ne pas les perdre." "The repository $depot has files of yours the update would overwrite: update cancelled so they are not lost.")" >&2
  printf '%s' "$caches" | sed 's/^/  /' >&2
  echo "$(t "(déplace-les hors du dépôt, puis relance nc-maj)" "(move them out of the repository, then run nc-maj again)")" >&2
  exit 1
fi
# Chaque commit de HEAD a son équivalent dans l'amont (git cherry : aucun « + »). Sa sortie est lue en entier avant
# d'être cherchée : dans un tube, grep -q s'arrêtait au premier « + », git cherry mourait de SIGPIPE (141 avec
# pipefail) et le « ! » y voyait « aucun commit à toi ». Un git cherry en échec compte comme « des commits à toi »
sans_commit_a_toi() {
  local plus
  plus="$(git cherry "$amont" HEAD)" || plus="+"
  ! grep -q '^+' <<<"$plus"
}
reecrit=""
if git merge-base --is-ancestor HEAD "$amont"; then
  # Les fichiers identiques sont mis de côté (dans .git, même disque : mv garde droits et dates) juste avant l'avance,
  # qui les remet tels quels. Si l'avance échoue (verrou index.lock, un dossier de l'amont là où tu as un fichier…),
  # ils sont remis à leur place, puis une phrase en français et le code 1 : rien n'est perdu
  cote=""
  remettre() {   # chaque fichier mis de côté retourne à sa place, si l'avance ne l'y a pas déjà remis
    local f
    [ -n "$cote" ] || return 0
    for f in "${identiques[@]}"; do
      [ -e "$cote/$f" ] && [ ! -e "$f" ] && mkdir -p -- "$(dirname -- "$f")" && mv -f -- "$cote/$f" "$f"
    done
    rm -rf -- "$cote"
    return 0
  }
  trap 'remettre; exit 130' INT TERM HUP                      # interrompu entre les deux : remis aussi
  erreur=""
  if [ "${#identiques[@]}" != 0 ]; then
    cote="$(mktemp -d "$(git rev-parse --absolute-git-dir)/nc-maj-identiques.XXXXXX")" || erreur="mktemp"
    for f in "${identiques[@]}"; do
      [ -z "$erreur" ] || break
      { mkdir -p -- "$cote/$(dirname -- "$f")" && mv -f -- "$f" "$cote/$f"; } || erreur="mv $f"
    done
  fi
  if [ -n "$erreur" ] || ! erreur="$(git merge --ff-only -q "$amont" 2>&1)"; then
    remettre; trap - INT TERM HUP
    echo "$(t "La mise à jour n'a pas pu s'appliquer dans $depot : rien n'a changé (tes fichiers sont à leur place)." "The update could not be applied in $depot: nothing changed (your files are where they were).")" >&2
    erreur="$(printf '%s\n' "$erreur" | sed '/^[[:space:]]*$/d' | head -n 2)"
    [ -z "$erreur" ] || printf '%s\n' "$erreur" | sed 's/^/  (git : /; s/$/)/' >&2
    echo "$(t "(un autre git en cours ? Sinon, git merge --ff-only origin/$branche dans $depot pour le détail)" "(another git running? Otherwise, git merge --ff-only origin/$branche in $depot for details)")" >&2
    exit 1
  fi
  remettre; trap - INT TERM HUP
elif { [ -n "$ancien" ] && git merge-base --is-ancestor HEAD "$ancien"; } || sans_commit_a_toi; then
  # Historique du dépôt réécrit en amont (mêmes changements, nouveaux identifiants) et aucun commit à toi : la nouvelle
  # version est reprise telle quelle ; l'ancienne reste dans une branche de sauvegarde (rien n'est supprimé).
  # « Aucun commit à toi » : HEAD était dans l'amont d'avant ce fetch, ou chacun de ses commits a son équivalent dans
  # le nouvel amont (git cherry, aucun « + ») : l'amont d'avant ne suffit pas, un git pull ou un éditeur a pu
  # récupérer la réécriture plus tôt
  reecrit="nc-sauvegarde-$(date +%Y%m%d)"
  git rev-parse -q --verify "refs/heads/$reecrit" >/dev/null && reecrit="$reecrit-$(date +%H%M%S)"
  git branch "$reecrit" HEAD
  git reset -q --hard "$amont"
else
  echo "$(t "Le dépôt $depot a des commits à toi qui ne sont pas sur GitHub : mise à jour annulée pour ne pas les perdre." "The repository $depot has commits of yours that are not on GitHub: update cancelled so they are not lost.")" >&2
  echo "$(t "(git log origin/$branche..HEAD pour les voir)" "(git log origin/$branche..HEAD to see them)")" >&2
  exit 1
fi
apres="$(git rev-parse HEAD)"
lineaire=0; git merge-base --is-ancestor "$base" "$apres" && lineaire=1
# git --no-pager partout : dans un terminal, git log ouvrait less, et la mise à jour attendait un « q » avant install.sh
if [ "$base" = "$apres" ]; then echo "$(t "Déjà à jour" "Already up to date") ($(git --no-pager log -1 --format=%cd --date=short))."
elif [ "$lineaire" = 0 ]; then
  # Les identifiants ont changé : les nouveautés sont les sujets absents de l'ancien historique
  echo "$(t "Nouveautés :" "What's new:")"
  awk 'NR == FNR { vus[$0]; next } !($0 in vus) { print "  • " $0 }' <(git --no-pager log --format=%s "$base") <(git --no-pager log --format=%s HEAD)
else
  echo "$(t "Nouveautés :" "What's new:")"; git --no-pager log --format='  • %s' "$base..HEAD"
fi
[ -z "$reecrit" ] || echo "$(t "(historique du dépôt réorganisé ; ancienne version gardée dans la branche $reecrit)" "(repository history reorganized; old version kept in branch $reecrit)")"
# L'annonce de cette version est consommée : si install.sh échoue, nc-maj verifier pourra la refaire
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/nc/maj-annoncee"
# Installation en cours : install.sh efface ce marqueur à son « Terminé » ; resté là (échec, « non »), la relance et
# nc-maj verifier repartent de version-installee
mkdir -p "$(dirname "$en_cours")"; echo "$apres" > "$en_cours"
code=0; ./install.sh "$@" || code=$?
# --restore : install.sh remet les anciens fichiers et sort en 0 sans installer la nouvelle version (le marqueur
# reste) : pas une installation réussie, ni rapport ni bilan
restaurer=0; for a in "$@"; do [ "$a" = --restore ] && restaurer=1; done
# 10 : « non » à « On y va ? », rien n'a été installé : ni rapport ni bilan (ce n'est pas une réussite)
if [ "$code" = 10 ]; then
  echo "$(t "Installation annulée : la nouvelle version est téléchargée, pas installée. Relance nc-maj quand tu veux." "Install cancelled: the new version is downloaded, not installed. Run nc-update again whenever you like.")"
fi
# Rapport de l'IA (si elle est permise et joignable) : ce qui a changé, en clair, dans les réglages → Mises à jour
if [ "$code" = 0 ] && [ "$restaurer" = 0 ] && [ "$base" != "$apres" ] && [ "$lineaire" = 1 ] && [ -x "$HOME/.local/bin/nc-ia" ]; then
  setsid "$HOME/.local/bin/nc-ia" rapport-maj config "$base" "$apres" >/dev/null 2>&1 < /dev/null &
fi
# Bilan après la mise à jour : seulement ce qui cloche (rien de plus si tout va bien)
if [ "$code" = 0 ] && [ "$restaurer" = 0 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -x "$HOME/.local/bin/nc-diag" ]; then
  echo; "$HOME/.local/bin/nc-diag" court
fi
exit "$code"
