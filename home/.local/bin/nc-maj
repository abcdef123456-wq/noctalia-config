#!/usr/bin/env bash
# nc-maj : met ce bureau à jour depuis GitHub, en une commande.
# Récupère la dernière version du dépôt noctalia-config (git fetch, puis avance), puis relance install.sh, qui ne refait que ce qui
# a changé ou manque (tes fichiers personnels et tes couleurs ne sont pas touchés).
#   nc-maj                 mise à jour complète (une question avant chaque étape système pas encore faite)
#   nc-maj --no-system     seulement ta session
#   nc-maj verifier        y a-t-il une nouvelle version ? Une notification avec « Mettre à jour » (une fois par
#                          version ; lancé toutes les heures par nc-maj-verif.timer ; coupé par nc-reglages, MAJ_VERIFIER=non ;
#                          et par Telegram si « Alertes Telegram » : nc-alertes version, réessayé tant qu'il n'est pas parti)
set -euo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
depot="$(cat "$HOME/.config/nc/depot" 2>/dev/null || true)"

if [ "${1:-}" = verifier ] || [ "${1:-}" = check ]; then
  grep -qx 'MAJ_VERIFIER=non' "$HOME/.config/nc/reglages.conf" 2>/dev/null && exit 0
  [ -d "$depot/.git" ] || exit 0
  cd "$depot"
  # Adresse publique (https), sans clé ni mot de passe : jamais de question en arrière-plan
  # (« || … » : avec pipefail, un échec dans le tube quitterait le script en erreur, et le service avec : hors ligne,
  # ce n'est pas une panne — revue MAJ-01)
  url="$(git remote get-url origin 2>/dev/null | sed -E 's#^git@github\.com:#https://github.com/#')" || exit 0
  branche="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  distant="$(GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote "$url" "refs/heads/$branche" 2>/dev/null | cut -f1)" || distant=""
  [ -n "$distant" ] || exit 0                                  # hors ligne
  # À jour : la version publiée est déjà ici (ou plus ancienne que la tienne)
  git merge-base --is-ancestor "$distant" HEAD 2>/dev/null && exit 0
  annonce="${XDG_CACHE_HOME:-$HOME/.cache}/nc/maj-annoncee"
  telegram="${XDG_CACHE_HOME:-$HOME/.cache}/nc/maj-telegram"   # annoncée par JARVIS (Telegram), seulement si partie
  deja_bureau=0; [ "$(cat "$annonce" 2>/dev/null)" = "$distant" ] && deja_bureau=1
  deja_tg=0; [ "$(cat "$telegram" 2>/dev/null)" = "$distant" ] && deja_tg=1
  [ -x "$HOME/.local/bin/nc-alertes" ] || deja_tg=1
  [ "$deja_bureau" = 1 ] && [ "$deja_tg" = 1 ] && exit 0      # déjà annoncée partout
  mkdir -p "$(dirname "$annonce")"
  # Les grosses nouveautés : la nouvelle version est téléchargée (pas installée) pour lire ses messages de mise à jour ;
  # chacun ramené à son idée principale (avant « ; », sans les parenthèses), les 4 plus récents
  nouveau=""
  if GIT_TERMINAL_PROMPT=0 timeout 60 git fetch -q "$url" "$branche" 2>/dev/null; then
    # Les sujets absents de l'historique d'ici (après une réécriture en amont, les identifiants ont changé)
    sujets="$(awk 'NR == FNR { vus[$0]; next } !($0 in vus)' <(git log --format=%s HEAD) <(git log --format=%s FETCH_HEAD) 2>/dev/null || true)"
    # Rien de nouveau à voir (seulement l'historique réécrit en amont : mêmes fichiers, mêmes sujets) : pas d'annonce
    if [ -z "$sujets" ] && git diff --quiet HEAD FETCH_HEAD 2>/dev/null; then
      echo "$distant" > "$annonce"; echo "$distant" > "$telegram"; exit 0
    fi
    nouveau="$(printf '%s\n' "$sujets" | python3 -c '
import os, re, sys
l = [x.strip() for x in sys.stdin if x.strip()]
def idee(s):
    while re.search(r" \([^()]*\)", s):      # parenthèses retirées avant : un « ; » dedans ne coupe pas
        s = re.sub(r" \([^()]*\)", "", s)
    s = s.split(" ; ")[0].split(" : ")[0]                # le titre seul : la bannière de l île a deux lignes
    s = re.sub(r"\s+", " ", s).strip(" ,;")
    return s if len(s) <= 48 else s[:47].rsplit(" ", 1)[0] + "…"
texte = " · ".join(idee(s) for s in l[:4])
autres = "others" if os.environ.get("NC_LANGUE") == "en" else "autres"
print(texte + (f" (+ {len(l) - 4} {autres})" if len(l) > 4 else ""))
' 2>/dev/null || true)"
  fi
  [ -n "$nouveau" ] || nouveau="$(t "Des améliorations sont disponibles." "Improvements are available.")"
  # Par Telegram aussi ; pas partie (JARVIS injoignable) : au passage suivant, même si le bureau l'a déjà annoncée.
  # Rien sans « Alertes Telegram » (nc-alertes sort tout de suite). En arrière-plan quand le bureau l'annonce : un
  # JARVIS injoignable ne retarde plus la notification (jusqu'à 90 s, revue MAJ-02)
  envoyer_tg() { timeout 90 "$HOME/.local/bin/nc-alertes" version "$nouveau" >/dev/null 2>&1 && echo "$distant" > "$telegram"; }
  if [ "$deja_tg" = 0 ]; then
    if [ "$deja_bureau" = 1 ]; then envoyer_tg || true; exit 0; fi
    envoyer_tg &
  fi
  [ "$deja_bureau" = 1 ] && exit 0
  echo "$distant" > "$annonce"
  choix="$(notify-send -a "noctalia-config" -i system-software-update -t 0 -A maj="$(t "Mettre à jour" "Update")" \
    -A tout="$(t "Tout voir" "See all")" -A tard="$(t "Plus tard" "Later")" \
    "$(t "Nouvelle version de la config" "New version of the config")" "$nouveau" 2>/dev/null || true)"
  [ "$choix" = maj ] && exec kitty --class nc-maj -e sh -c "$HOME/.local/bin/nc-maj; echo; printf '$(t "Entrée pour fermer" "Press Enter to close")'; read r"
  [ "$choix" = tout ] && exec kitty --class nc-maj -e sh -c "$HOME/.local/bin/nc-reglages nouveautes | less -R"
  wait || true                                                 # l'envoi Telegram finit avant le service
  exit 0
fi
if [ ! -d "$depot/.git" ]; then
  echo "$(t "Dépôt noctalia-config introuvable (${depot:-chemin inconnu})." "noctalia-config repository not found (${depot:-unknown path}).")" >&2
  echo "$(t "Clone-le puis lance l'installation une fois :" "Clone it, then run the installer once:") git clone https://github.com/abcdef123456-wq/noctalia-config.git ~/noctalia-config && ~/noctalia-config/install.sh" >&2
  exit 1
fi
cd "$depot"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "$(t "Le dépôt $depot contient des modifications locales : mise à jour annulée pour ne pas les écraser." "The repository $depot has local changes: update cancelled so they are not overwritten.")" >&2
  echo "$(t "(git status pour les voir ; git stash pour les mettre de côté)" "(git status to see them; git stash to set them aside)")" >&2
  exit 1
fi
avant="$(git rev-parse HEAD)"
branche="$(git rev-parse --abbrev-ref HEAD)"
ancien="$(git rev-parse -q --verify "refs/remotes/origin/$branche" 2>/dev/null || true)"   # l'amont avant ce fetch
git fetch -q origin "$branche"
amont="$(git rev-parse "refs/remotes/origin/$branche")"
reecrit=""
if git merge-base --is-ancestor HEAD "$amont"; then
  git merge --ff-only -q "$amont"
elif [ -n "$ancien" ] && git merge-base --is-ancestor HEAD "$ancien"; then
  # Historique du dépôt réécrit en amont (mêmes changements, nouveaux identifiants) et aucun commit à toi : la nouvelle
  # version est reprise telle quelle ; l'ancienne reste dans une branche de sauvegarde (rien n'est supprimé)
  reecrit="nc-sauvegarde-$(date +%Y%m%d)"
  git rev-parse -q --verify "refs/heads/$reecrit" >/dev/null && reecrit="$reecrit-$(date +%H%M%S)"
  git branch "$reecrit" HEAD
  git reset -q --hard "$amont"
else
  echo "$(t "Le dépôt $depot a des commits à toi qui ne sont pas sur GitHub : mise à jour annulée pour ne pas les perdre." "The repository $depot has commits of yours that are not on GitHub: update cancelled so they are not lost.")" >&2
  echo "$(t "(git log origin/$branche..HEAD pour les voir)" "(git log origin/$branche..HEAD to see them)")" >&2
  exit 1
fi
if [ "$avant" = "$(git rev-parse HEAD)" ]; then echo "$(t "Déjà à jour" "Already up to date") ($(git log -1 --format=%cd --date=short))."
elif [ -n "$reecrit" ]; then
  # Les identifiants ont changé : les nouveautés sont les sujets absents de l'ancien historique
  echo "$(t "Nouveautés :" "What's new:")"
  awk 'NR == FNR { vus[$0]; next } !($0 in vus) { print "  • " $0 }' <(git log --format=%s "$avant") <(git log --format=%s HEAD)
  echo "$(t "(historique du dépôt réorganisé ; ancienne version gardée dans la branche $reecrit)" "(repository history reorganized; old version kept in branch $reecrit)")"
else
  echo "$(t "Nouveautés :" "What's new:")"; git log --format='  • %s' "$avant..HEAD"
fi
./install.sh "$@"
code=$?
# Rapport de l'IA (si elle est permise et joignable) : ce qui a changé, en clair, dans les réglages → Mises à jour
if [ "$code" = 0 ] && [ "$avant" != "$(git rev-parse HEAD)" ] && [ -z "$reecrit" ] && [ -x "$HOME/.local/bin/nc-ia" ]; then
  setsid "$HOME/.local/bin/nc-ia" rapport-maj config "$avant" "$(git rev-parse HEAD)" >/dev/null 2>&1 < /dev/null &
fi
# Bilan après la mise à jour : seulement ce qui cloche (rien de plus si tout va bien)
if [ "$code" = 0 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -x "$HOME/.local/bin/nc-diag" ]; then
  echo; "$HOME/.local/bin/nc-diag" court
fi
exit "$code"
