#!/usr/bin/env bash
# nc-capture : captures d'écran façon Mac, enregistrées ET copiées.
#   nc-capture ecran      écran entier (celui de la souris)              Impr. écran
#   nc-capture zone       zone choisie à la souris                       Super + P, Maj + Impr. écran
#   nc-capture retouche   zone, ouverte tout de suite dans Swappy        Super + Maj + S
#   nc-capture texte      le TEXTE d'une zone (image, vidéo, PDF scanné…) copié, prêt à coller   Super + Maj + T
# Fichier : ~/Images/Captures (dossier « Images » de ta langue), « Capture du 2026-10-15 à 23.25.10.png ».
# L'image est aussi copiée : Ctrl + V la colle directement. Une notification la montre ; un clic l'ouvre dans Swappy
# pour l'annoter (Ctrl + S y enregistre la version annotée à côté, Ctrl + C la copie) ; bouton « Supprimer » : à la
# corbeille. Dans Swappy, l'icône de corbeille efface seulement les annotations ; Échap ferme Swappy.
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }

mode="${1:-zone}"
# Choisir une zone à la souris. La vue des fenêtres (nc-ile), si elle est ouverte, lâche clavier et souris le temps du
# choix : sinon elle prenait le clic de la sélection.
choisir_zone() {
  local vue=0 rc
  hyprctl layers -j 2>/dev/null | grep -q '"namespace": *"nc-vue"' && vue=1
  [ "$vue" = 1 ] && qs -c nc-ile ipc call ile vuePause true >/dev/null 2>&1
  slurp -d 2>/dev/null; rc=$?
  [ "$vue" = 1 ] && qs -c nc-ile ipc call ile vuePause false >/dev/null 2>&1
  return $rc
}
# Noms anglais des modes (nc-screenshot screen | area | edit | text)
case "$mode" in
  screen) mode=ecran ;; area|region) mode=zone ;; edit|annotate) mode=retouche ;; text) mode=texte ;;
esac

# Texte d'une zone : lu par tesseract (français et anglais), copié ; rien n'est enregistré
if [ "$mode" = texte ]; then
  dire() { notify-send -a "$(t "Texte de l'écran" "Screen Text")" -i edit-copy "$@" 2>/dev/null || true; }
  command -v tesseract >/dev/null || { dire "$(t "tesseract n'est pas installé" "tesseract is not installed")" "$(t "nc-maj l'installe (lecture du texte des images)." "nc-update installs it (reads text from images).")"; exit 1; }
  zone="$(choisir_zone)" || exit 0
  [ -n "$zone" ] || exit 0
  langues="$(tesseract --list-langs 2>/dev/null | grep -xE 'fra|eng' | paste -sd+)"
  # Agrandie deux fois : tesseract lit bien mieux les petits caractères d'écran
  texte="$(grim -g "$zone" -s 2 - | tesseract stdin stdout ${langues:+-l "$langues"} 2>/dev/null | sed -e 's/[[:space:]]*$//' | cat -s)"
  texte="$(printf '%s' "$texte" | sed -e '/./,$!d')"          # sans lignes vides au début
  if [ -z "${texte//[[:space:]]/}" ]; then dire "$(t "Aucun texte trouvé" "No text found")" "$(t "Essaie une zone plus grande ou plus nette." "Try a larger or sharper area.")"; exit 0; fi
  printf '%s' "$texte" | wl-copy
  dire "$(t "Texte copié" "Text copied")" "$(printf '%s' "$texte" | head -c 180)"
  exit 0
fi
images="$(xdg-user-dir PICTURES 2>/dev/null)"
[ -n "$images" ] && [ "$images" != "$HOME" ] && [ "$images" != "$HOME/" ] || images="$HOME/Pictures"
dossier="$images/Captures"
# Dossier choisi avec nc-reglages (CAPTURES_DOSSIER)
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }
perso="$(reglage CAPTURES_DOSSIER)"
[ -n "$perso" ] && dossier="${perso/#\~/$HOME}"
mkdir -p "$dossier"
# Nom du fichier dans la langue choisie (le dossier, lui, ne change pas : les captures restent au même endroit)
fichier="$dossier/$(t "Capture du $(date '+%Y-%m-%d à %H.%M.%S')" "Screenshot $(date '+%Y-%m-%d at %H.%M.%S')").png"

case "$mode" in
  ecran)
    # Écran sous la souris (Hyprland), sinon tous les écrans
    sortie="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)"
    if [ -n "$sortie" ]; then grim -o "$sortie" "$fichier"; else grim "$fichier"; fi || exit 1 ;;
  zone|retouche)
    zone="$(choisir_zone)" || exit 0                    # Échap : rien n'est fait
    [ -n "$zone" ] || exit 0
    grim -g "$zone" "$fichier" || exit 1 ;;
  *) t "Usage : nc-capture ecran | zone | retouche | texte" "Usage: nc-screenshot screen | area | edit | text" >&2; echo >&2; exit 2 ;;
esac

# Copiée aussi, sauf si coupé dans nc-reglages (CAPTURES_COPIER)
copiee=1
if [ "$(reglage CAPTURES_COPIER)" = non ]; then copiee=0; else wl-copy --type image/png < "$fichier" 2>/dev/null; fi

# Swappy : enregistre la version annotée dans le même dossier
mkdir -p "$HOME/.config/swappy"
conf="$HOME/.config/swappy/config"
format="$(t "Capture annotée du %Y-%m-%d à %H.%M.%S.png" "Annotated Screenshot %Y-%m-%d at %H.%M.%S.png")"
if ! grep -qF "save_dir=$dossier" "$conf" 2>/dev/null || ! grep -qxF "save_filename_format=$format" "$conf" 2>/dev/null; then
  printf '[Default]\nsave_dir=%s\nsave_filename_format=%s\nshow_panel=true\nearly_exit=true\n' \
    "$dossier" "$format" > "$conf"
fi

if [ "$mode" = retouche ]; then
  exec swappy -f "$fichier"
fi

# Notification avec la capture (sauf si coupée : CAPTURES_NOTIF) ; clic : l'annoter dans Swappy (attente en arrière-plan,
# le raccourci rend la main)
[ "$(reglage CAPTURES_NOTIF)" = non ] && exit 0
if [ "$copiee" = 1 ]; then texte="$(t "Copiée aussi : Ctrl + V pour la coller. Clic pour l'annoter." "Also copied: Ctrl + V to paste it. Click to annotate.")"; else texte="$(t "Clic pour l'annoter." "Click to annotate.")"; fi
# « Demander à l'IA » : seulement si l'IA est permise (nc-ia actif) et l'explication des captures pas coupée
ia=()
if [ "$(reglage IA_CAPTURE)" != non ] && "$HOME/.local/bin/nc-ia" disponible 2>/dev/null; then ia=(-A "ia=$(t "Demander à l'IA" "Ask the AI")"); fi
(
  action="$(timeout 600 notify-send -a "$(t "Capture d'écran" "Screenshot")" -i "$fichier" -A "default=$(t "Annoter" "Annotate")" -A "supprimer=$(t "Supprimer" "Delete")" \
    -A "dossier=$(t "Ouvrir le dossier" "Show in Folder")" "${ia[@]}" "$(t "Capture enregistrée" "Screenshot saved")" "$texte" 2>/dev/null)"
  case "$action" in
    default) swappy -f "$fichier" ;;
    ia) "$HOME/.local/bin/nc-ia" fichier "$fichier" --notifier ;;     # l'IA du bureau l'explique (notification)
    supprimer) gio trash "$fichier" 2>/dev/null || rm -f "$fichier" ;;      # à la corbeille (récupérable)
    dossier) xdg-open "$dossier" ;;
  esac
) >/dev/null 2>&1 &
disown 2>/dev/null || true
exit 0
