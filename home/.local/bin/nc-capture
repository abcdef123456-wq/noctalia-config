#!/usr/bin/env bash
# nc-capture : captures d'écran façon Mac, enregistrées ET copiées.
#   nc-capture ecran      écran entier (celui de la souris)              Impr. écran
#   nc-capture zone       zone choisie à la souris                       Super + P, Maj + Impr. écran
#   nc-capture retouche   zone, ouverte tout de suite dans Swappy        Super + Maj + S
#   nc-capture texte      le TEXTE d'une zone (image, vidéo, PDF scanné…) copié, prêt à coller   Super + Maj + T
#   nc-capture ecran --dans 5     capture retardée de 1 à 30 s (le temps d'ouvrir un menu), compte à rebours en notification
#   nc-capture annuler    annule la capture retardée en attente                                  Ctrl + Maj + Impr. écran
# Fichier : ~/Images/Captures (dossier « Images » de ta langue), « Capture du 2026-10-15 à 23.25.10.png ».
# L'image est aussi copiée : Ctrl + V la colle directement. Une notification la montre ; un clic l'ouvre dans Swappy
# pour l'annoter (Ctrl + S y enregistre la version annotée à côté, Ctrl + C la copie) ; bouton « Supprimer » : à la
# corbeille. Dans Swappy, l'icône de corbeille efface seulement les annotations ; Échap ferme Swappy.
# Avec Cloud JARVIS (CLOUD_JARVIS=oui, PC associé) : bouton « Envoyer au cloud », dans le dossier « Captures » du cloud.
set -uo pipefail
# Captures et dossier privés : lisibles par toi seul (0600 / 0700), pas par les autres comptes du PC
umask 077
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }

mode=""; delai=-
usage() { t "Usage : nc-capture ecran | zone | retouche | texte [--dans 1..30] | annuler" "Usage: nc-screenshot screen | area | edit | text [--in 1..30] | cancel" >&2; echo >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --dans|--in) [ $# -ge 2 ] || usage; delai="$2"; shift 2 ;;
    --dans=*|--in=*) delai="${1#*=}"; shift ;;
    *) [ -n "$mode" ] || mode="$1"; shift ;;
  esac
done
mode="${mode:-zone}"
# Délai : un entier de 1 à 30, sinon refus poli
case "$delai" in
  -|[1-9]|[1-2][0-9]|30) ;;
  *) t "Délai refusé : choisis un nombre de secondes entre 1 et 30." "Delay refused: pick a number of seconds between 1 and 30." >&2; echo >&2; exit 2 ;;
esac
# Choisir une zone à la souris. La vue des fenêtres (nc-ile), si elle est ouverte, lâche clavier et souris le temps du
# choix : sinon elle prenait le clic de la sélection.
choisir_zone() {
  local vue=0 rc
  hyprctl layers -j 2>/dev/null | grep -q '"namespace": *"nc-vue"' && vue=1
  [ "$vue" = 1 ] && qs -c nc-ile ipc call ile vuePause true >/dev/null 2>&1
  slurp -d 2>/dev/null; rc=$?
  [ "$vue" = 1 ] && qs -c nc-ile ipc call ile vuePause false >/dev/null 2>&1
  return $rc
}
# Noms anglais des modes (nc-screenshot screen | area | edit | text)
case "$mode" in
  screen) mode=ecran ;; cancel) mode=annuler ;; area|region) mode=zone ;; edit|annotate) mode=retouche ;; text) mode=texte ;;
esac

# Capture retardée : un seul fichier de verrou (pid du processus qui attend) dans XDG_RUNTIME_DIR
verrou="${XDG_RUNTIME_DIR:-}/nc-capture-retard.pid"
if [ "$mode" = annuler ]; then
  pid="$(cat "$verrou" 2>/dev/null)"
  if [ -n "$pid" ] && grep -q nc-capture "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null; then exit 0; fi
  notify-send -a "$(t "Capture d'écran" "Screenshot")" -i dialog-information "$(t "Aucune capture en attente" "No screenshot pending")" 2>/dev/null || true
  exit 0
fi

# Un outil absent ne passe plus en silence : une notification nomme le paquet à installer (même nom sur Arch, Debian,
# Fedora et openSUSE pour grim, slurp, swappy et wl-clipboard)
avertir() { notify-send -a "$(t "Capture d'écran" "Screenshot")" -i dialog-warning "$@" 2>/dev/null || true; }
manque() {   # manque OUTIL PAQUET
  avertir "$(t "$1 n'est pas installé" "$1 is not installed")" "$(t "Installe le paquet « $2 » (nc-maj l'installe)." "Install the package “$2” (nc-update installs it).")"
}
outil_ok() { command -v "$1" >/dev/null 2>&1; }
case "$mode" in ecran|zone|retouche|texte)
  outil_ok grim || { manque grim grim; exit 1; }
  case "$mode" in zone|retouche|texte) outil_ok slurp || { manque slurp slurp; exit 1; } ;; esac
  [ "$mode" = retouche ] && { outil_ok swappy || { manque swappy swappy; exit 1; }; }
  [ "$mode" = texte ] && { outil_ok wl-copy || { manque wl-copy wl-clipboard; exit 1; }; }
  ;;
esac
# Réglage de nc-reglages (~/.config/nc/reglages.conf)
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }

# Compte à rebours : une seule notification, remplacée chaque seconde (aucun processus de plus que ce délai). Annulation :
# « nc-capture annuler » (SIGTERM) ferme la notification et libère le verrou.
if [ "$delai" != - ] && case "$mode" in ecran|zone|retouche|texte) true ;; *) false ;; esac; then
  [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] || { t "Capture retardée impossible : pas de dossier d'exécution." "Delayed screenshot impossible: no runtime folder." >&2; echo >&2; exit 1; }
  if ! ( set -C; echo $$ > "$verrou" ) 2>/dev/null; then
    ancien="$(cat "$verrou" 2>/dev/null)"
    if [ -n "$ancien" ] && grep -q nc-capture "/proc/$ancien/cmdline" 2>/dev/null; then
      avertir "$(t "Une capture est déjà en attente" "A screenshot is already pending")" "$(t "Annule-la avec « nc-capture annuler »." "Cancel it with “nc-screenshot cancel”.")"
      exit 1
    fi
    rm -f "$verrou"; ( set -C; echo $$ > "$verrou" ) 2>/dev/null || exit 1     # verrou resté d'un processus disparu
  fi
  nid=""
  compte() {   # compte TITRE [TEXTE] : affiche, ou remplace, la notification du compte à rebours
    local r=() i; [ -n "$nid" ] && r=(-r "$nid")
    i="$(notify-send -p -a "$(t "Capture d'écran" "Screenshot")" -i camera-photo -t 1500 "${r[@]}" "$1" "${2:-}" 2>/dev/null)" || return 0
    case "$i" in ''|*[!0-9]*) ;; *) nid="$i" ;; esac
  }
  trap 'compte "$(t "Capture annulée" "Screenshot cancelled")"; rm -f "$verrou"; exit 0' TERM INT
  for ((n = delai; n > 0; n--)); do
    compte "$(t "Capture dans $n s" "Screenshot in $n s")" "$(t "« nc-capture annuler » pour annuler." "“nc-screenshot cancel” to cancel.")"
    sleep 1
  done
  trap - TERM INT
  rm -f "$verrou"
  [ -z "$nid" ] || notify-send -a "$(t "Capture d'écran" "Screenshot")" -r "$nid" -t 1 "$(t "Capture…" "Capturing…")" 2>/dev/null
  # L'île coupe ses bannières (elle les reprend seule après 3 s) ; sans qs ou sans île, la capture se fait quand même
  timeout 2 qs -c nc-ile ipc call ile bannieresPause true >/dev/null 2>&1 || true
  sleep 0.4      # laisse l'île et la notification se retirer avant que grim ne regarde l'écran
fi

# Texte d'une zone : lu par tesseract (français et anglais), copié ; rien n'est enregistré
if [ "$mode" = texte ]; then
  dire() { notify-send -a "$(t "Texte de l'écran" "Screen Text")" -i edit-copy "$@" 2>/dev/null || true; }
  command -v tesseract >/dev/null || { dire "$(t "tesseract n'est pas installé" "tesseract is not installed")" "$(t "nc-maj l'installe (lecture du texte des images)." "nc-update installs it (reads text from images).")"; exit 1; }
  zone="$(choisir_zone)" || exit 0
  [ -n "$zone" ] || exit 0
  langues="$(tesseract --list-langs 2>/dev/null | grep -xE 'fra|eng' | paste -sd+)"
  # Agrandie deux fois : tesseract lit bien mieux les petits caractères d'écran
  texte="$(grim -g "$zone" -s 2 - | tesseract stdin stdout ${langues:+-l "$langues"} 2>/dev/null | sed -e 's/[[:space:]]*$//' | cat -s)"
  texte="$(printf '%s' "$texte" | sed -e '/./,$!d')"          # sans lignes vides au début
  if [ -z "${texte//[[:space:]]/}" ]; then dire "$(t "Aucun texte trouvé" "No text found")" "$(t "Essaie une zone plus grande ou plus nette." "Try a larger or sharper area.")"; exit 0; fi
  printf '%s' "$texte" | wl-copy
  # Le texte lu peut être un mot de passe : la notification (et son historique) ne montre que le nombre de caractères,
  # sauf si CAPTURES_APERCU=oui
  if [ "$(reglage CAPTURES_APERCU)" = oui ]; then
    dire "$(t "Texte copié" "Text copied")" "$(printf '%s' "$texte" | head -c 180)"
  else
    dire "$(t "Texte copié" "Text copied")" "$(t "${#texte} caractères copiés" "${#texte} characters copied")"
  fi
  exit 0
fi
images="$(xdg-user-dir PICTURES 2>/dev/null)"
[ -n "$images" ] && [ "$images" != "$HOME" ] && [ "$images" != "$HOME/" ] || images="$HOME/Pictures"
dossier="$images/Captures"
# Dossier choisi avec nc-reglages (CAPTURES_DOSSIER)
perso="$(reglage CAPTURES_DOSSIER)"
[ -n "$perso" ] && dossier="${perso/#\~/$HOME}"
mkdir -p "$dossier"
# Nom du fichier dans la langue choisie (le dossier, lui, ne change pas : les captures restent au même endroit).
# Réservé tout de suite par un fichier vide créé avec noclobber (set -C : échoue s'il existe, sans course) : deux
# captures dans la même seconde prennent « … -2.png », « … -3.png », au lieu de s'écraser.
fichier=""
reserver() {
  local base n=1 f
  base="$dossier/$(t "Capture du $(date '+%Y-%m-%d à %H.%M.%S')" "Screenshot $(date '+%Y-%m-%d at %H.%M.%S')")"
  f="$base.png"
  while ! ( set -C; : > "$f" ) 2>/dev/null; do
    n=$((n + 1)); f="$base-$n.png"
    [ "$n" -le 200 ] || return 1
  done
  fichier="$f"
}
# Une capture ratée ou annulée ne laisse pas son fichier vide
vider() { [ -n "$fichier" ] && [ ! -s "$fichier" ] && rm -f "$fichier"; return 0; }

case "$mode" in
  ecran)
    reserver || exit 1
    # Écran sous la souris (Hyprland), sinon tous les écrans
    sortie="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)"
    if [ -n "$sortie" ]; then grim -o "$sortie" "$fichier"; else grim "$fichier"; fi || { vider; exit 1; } ;;
  zone|retouche)
    zone="$(choisir_zone)" || exit 0                    # Échap : rien n'est fait
    [ -n "$zone" ] || exit 0
    reserver || exit 1
    grim -g "$zone" "$fichier" || { vider; exit 1; } ;;
  *) usage ;;
esac

# Copiée aussi, sauf si coupé dans nc-reglages (CAPTURES_COPIER)
copiee=1
if [ "$(reglage CAPTURES_COPIER)" = non ]; then
  copiee=0
elif ! outil_ok wl-copy; then
  copiee=0; manque wl-copy wl-clipboard
elif ! wl-copy --type image/png < "$fichier" 2>/dev/null; then
  copiee=0        # la copie a échoué : la notification ne dit pas « Copiée aussi » à tort
fi

# Swappy : enregistre la version annotée dans le même dossier
mkdir -p "$HOME/.config/swappy"
conf="$HOME/.config/swappy/config"
format="$(t "Capture annotée du %Y-%m-%d à %H.%M.%S.png" "Annotated Screenshot %Y-%m-%d at %H.%M.%S.png")"
# Seules ces deux clés sont réglées, dans [Default] : le reste de la config de l'utilisateur est gardé. Sans fichier :
# les réglages de départ (panneau, sortie rapide) sont posés aussi.
if [ ! -f "$conf" ]; then
  printf '[Default]\nsave_dir=%s\nsave_filename_format=%s\nshow_panel=true\nearly_exit=true\n' "$dossier" "$format" > "$conf"
else
  nouveau="$(mktemp "$conf.XXXXXX" 2>/dev/null)" && {
    SW_DIR="$dossier" SW_FORMAT="$format" awk '
      function fin_default() {
        if (en_default && !dir) print "save_dir=" ENVIRON["SW_DIR"]
        if (en_default && !fmt) print "save_filename_format=" ENVIRON["SW_FORMAT"]
        if (en_default) { dir = 1; fmt = 1 }
      }
      /^[ \t]*\[/ { fin_default(); en_default = ($0 ~ /^[ \t]*\[Default\][ \t]*$/); if (en_default) vu = 1 }
      en_default && /^[ \t]*save_dir[ \t]*=/ { print "save_dir=" ENVIRON["SW_DIR"]; dir = 1; next }
      en_default && /^[ \t]*save_filename_format[ \t]*=/ { print "save_filename_format=" ENVIRON["SW_FORMAT"]; fmt = 1; next }
      { print }
      END {
        fin_default()
        if (!vu) { print "[Default]"; print "save_dir=" ENVIRON["SW_DIR"]; print "save_filename_format=" ENVIRON["SW_FORMAT"] }
      }' "$conf" > "$nouveau" 2>/dev/null
    if cmp -s "$nouveau" "$conf"; then rm -f "$nouveau"; else chmod --reference="$conf" "$nouveau" 2>/dev/null; mv -f "$nouveau" "$conf"; fi
  }
fi

if [ "$mode" = retouche ]; then
  exec swappy -f "$fichier"
fi

# Notification avec la capture (sauf si coupée : CAPTURES_NOTIF) ; clic : l'annoter dans Swappy (attente en arrière-plan,
# le raccourci rend la main)
[ "$(reglage CAPTURES_NOTIF)" = non ] && exit 0
# Sans swappy : pas de bouton Annoter
annoter=()
if outil_ok swappy; then annoter=(-A "default=$(t "Annoter" "Annotate")"); fi
if [ "$copiee" = 1 ]; then texte="$(t "Copiée aussi : Ctrl + V pour la coller." "Also copied: Ctrl + V to paste it.")"; else texte=""; fi
if [ "${#annoter[@]}" -gt 0 ]; then
  texte="${texte:+$texte }$(t "Clic pour l'annoter." "Click to annotate.")"
else
  texte="${texte:+$texte }$(t "Pour annoter : installe le paquet « swappy »." "To annotate: install the package “swappy”.")"
fi
# « Demander à l'IA » : seulement si l'IA est permise (nc-ia actif) et l'explication des captures pas coupée
ia=()
if [ "$(reglage IA_CAPTURE)" != non ] && "$HOME/.local/bin/nc-ia" disponible 2>/dev/null; then ia=(-A "ia=$(t "Demander à l'IA" "Ask the AI")"); fi
# « Envoyer au cloud » : seulement avec CLOUD_JARVIS=oui et ce PC associé (le fichier local d'association, aucun appel réseau)
cloud=()
if [ "$(reglage CLOUD_JARVIS)" = oui ] && [ -x "$HOME/.local/bin/nc-cloud" ] \
   && [ -f "${XDG_STATE_HOME:-$HOME/.local/state}/nc-cloud/appareil.json" ]; then
  cloud=(-A "cloud=$(t "Envoyer au cloud" "Send to cloud")")
fi
# Dépose la capture dans « Captures » du cloud (créé s'il manque) ; la capture locale n'est jamais touchée
envoyer_cloud() {
  local sortie code titre corps
  sortie="$("$HOME/.local/bin/nc-cloud" deposer --racine Captures -- "$1" 2>&1)"; code=$?
  case "$code" in
    0) titre="$(t "Capture envoyée au cloud" "Screenshot sent to the cloud")"; corps="$(t "Dans le dossier « Captures »." "In the “Captures” folder.")" ;;
    3) titre="$(t "Capture non envoyée" "Screenshot not sent")"
       corps="$(t "Cloud injoignable : la capture reste sur ce PC." "Cloud unreachable: the screenshot stays on this PC.")" ;;
    6) titre="$(t "Capture non envoyée" "Screenshot not sent")"
       corps="$(t "Une capture du même nom est déjà dans « Captures » : rien n'est remplacé." "A screenshot with the same name is already in “Captures”: nothing replaced.")" ;;
    *) titre="$(t "Capture non envoyée" "Screenshot not sent")"; corps="$(printf '%s\n' "$sortie" | tail -n 1 | tr -d '\000-\037' | cut -c1-300)" ;;
  esac
  notify-send -a "$(t "Capture d'écran" "Screenshot")" -- "$titre" "$corps" 2>/dev/null      # « -- » : un corps en « - » n'est pas une option
}
(
  action="$(timeout 600 notify-send -a "$(t "Capture d'écran" "Screenshot")" -i "$fichier" "${annoter[@]}" -A "supprimer=$(t "Supprimer" "Delete")" \
    -A "dossier=$(t "Ouvrir le dossier" "Show in Folder")" "${ia[@]}" "${cloud[@]}" "$(t "Capture enregistrée" "Screenshot saved")" "$texte" 2>/dev/null)"
  case "$action" in
    default) swappy -f "$fichier" ;;
    ia) "$HOME/.local/bin/nc-ia" fichier "$fichier" --notifier ;;     # l'IA du bureau l'explique (notification)
    cloud) [ "${#cloud[@]}" -gt 0 ] && envoyer_cloud "$fichier" ;;
    supprimer) gio trash "$fichier" 2>/dev/null || rm -f "$fichier" ;;      # à la corbeille (récupérable)
    dossier) ( umask 022; xdg-open "$dossier" ) ;;
  esac
) >/dev/null 2>&1 &
disown 2>/dev/null || true
exit 0
