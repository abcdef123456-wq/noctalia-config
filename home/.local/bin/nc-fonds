#!/usr/bin/env bash
# nc-fonds : tes fonds d'écran à toi, rangés à part dans « Mes fonds » : le sous-dossier mes-fonds du dossier des fonds
# en cours (~/Pictures/Wallpapers/<thème>/mes-fonds dans un thème, ~/Pictures/Wallpapers/mes-fonds dans la base).
# Rien ne le livre, install.sh et nc-maj n'y touchent jamais. Boutons du carrousel (Super + W) et de nc-reglages → Fonds d'écran.
#   nc-fonds dossier                 le chemin de « Mes fonds » (rien n'est créé)
#   nc-fonds ouvrir                  le crée s'il manque, puis l'ouvre dans le gestionnaire de fichiers
#   nc-fonds ajouter [IMAGE…]        COPIE les images dans « Mes fonds » (sans image : le sélecteur de fichiers) ; refus
#                                    clair si ce n'est pas une image, avertissement (pas de refus) sous 2560 x 1600
#   nc-fonds retirer IMAGE           met à la corbeille un fond de « Mes fonds » (jamais un fond livré) : un fichier dont le
#                                    vrai chemin (liens résolus) est dans un mes-fonds sous ~/Pictures/Wallpapers, ou dans
#                                    le mes-fonds du dossier en cours
#   nc-fonds livres                  les fonds livrés, un chemin relatif à ~/Pictures/Wallpapers par ligne (le carrousel
#                                    ne propose « Masquer » que pour eux)
#   nc-fonds masquer IMAGE [--poser SUIVANT]
#                                    un fond LIVRÉ (seulement : jamais une image à toi) que tu ne veux plus : inscrit dans ~/.config/nc/fonds-masques.conf (un
#                                    chemin relatif à ~/Pictures/Wallpapers par ligne), puis mis à la corbeille ; install.sh
#                                    ne recopie jamais un fond de cette liste (ni rotation, ni mise à jour ne le ramènent).
#                                    --poser : c'était le fond affiché, SUIVANT le remplace (noctalia msg wallpaper-set)
#   nc-fonds reafficher              vide cette liste et recopie ces fonds depuis le dépôt installé (~/.config/nc/depot) ;
#                                    sans dépôt, dit de lancer la mise à jour (nc-maj), qui les remettra
#   nc-fonds a-ranger                combien de fonds TU as posés à la racine de ~/Pictures/Wallpapers (images qui ne sont
#                                    pas des fonds livrés) ; 0 si la question « ranger » a déjà eu sa réponse
#   nc-fonds ranger [--affiche FOND] [IMAGE]
#                                    (réponse « oui ») les déplace dans ~/Pictures/Wallpapers/mes-fonds (avec IMAGE : celle-là
#                                    seulement, et la question reste) ; si FOND (le fond
#                                    affiché) en fait partie, il est reposé sur son nouveau chemin
#   nc-fonds garder                  (réponse « non ») rien n'est déplacé, la question ne revient plus
# --notifier (ajouter, masquer, ranger) : le message part aussi en notification (le carrousel s'est fermé avant).
# Code 0 si c'est fait (ou annulé), 1 si refusé (message sur la sortie d'erreur), 2 pour un usage inconnu.
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
# Taille d'une image : magick identify (ImageMagick 7), sinon identify (livré avec ImageMagick 6, à côté de convert) ;
# sans l'un ni l'autre, l'image est acceptée sur son extension, avec un avertissement
if command -v magick >/dev/null; then IDENT=(magick identify)
elif command -v identify >/dev/null; then IDENT=(identify)
else IDENT=()
fi
EXTS="jpg jpeg png webp bmp avif jxl"          # celles que nc-carousel-thumbs découpe
usage() { echo "usage : nc-fonds dossier | ouvrir | ajouter [--notifier] [IMAGE…] | retirer IMAGE | livres | masquer [--notifier] IMAGE [--poser SUIVANT] | reafficher | a-ranger | ranger [--notifier] [--affiche FOND] [IMAGE] | garder"; }
refus() { echo "$1" >&2; exit 1; }

# Le dossier des fonds lu comme Noctalia : une seule règle, celle de nc-carousel-thumbs
src=$("${0%/*}/nc-carousel-thumbs" --dossier 2>/dev/null) || src=""
[ -n "$src" ] || src="$HOME/Pictures/Wallpapers"
mes="$src/mes-fonds"
FONDS="$HOME/Pictures/Wallpapers"
MASQUES="$HOME/.config/nc/fonds-masques.conf"     # même chemin et même règle dans panel.luau (cheminMasque)
RANGEMENT="$HOME/.config/nc/fonds-rangement"      # oui / non : la question « ranger » a eu sa réponse (lu par panel.luau)
# Les fonds de la base livrés par le dépôt (racine de home/Pictures/Wallpapers ; test_fonds_perso vérifie la liste).
# CREDITS.tsv ne suffit pas : il ne liste pas ces fonds-là
LIVRES_BASE="astronaut-dark-5120x2880-22768.jpg
bmw-m4-coupe-8k-7680x4320-24121.jpg
ctr-ferrari-458-7680x4320-27340.jpg
desert-doom-sand-dunes-dark-background-monochrome-landscape-3840x2160-6409.jpg
macos-mojave-sand-dunes-mojave-desert-california-night-dark-5120x2880-4051.jpg
mclaren-788hs-coupe-11520x6480-26955.jpg
mountain-landscape-5120x2880-24317.jpg
porsche-911-gt3-rs-3840x2160-25139.jpg
porsche-911-turbo-s-black-background-amoled-pitch-black-3840x2160-7730.jpg
porsche-taycan-3840x2160-26875.jpg
snow-mountains-5120x2880-25876.jpg
spider-man-dark-cyan-minimal-3840x2160-170.jpg
thorfinn-vinland-saga-5k-3840x2160-14948.jpg
tiger-dope-amoled-3840x2160-18370.jpg"

# Fonds posés par toi à la racine : images de ~/Pictures/Wallpapers qui ne sont pas des fonds livrés (A_RANGER)
a_ranger() {
  local f
  A_RANGER=()
  shopt -s nullglob nocaseglob
  for f in "$FONDS"/*.{jpg,jpeg,png,webp,bmp,avif,jxl}; do
    [ -f "$f" ] && ! grep -qxF -- "${f##*/}" <<<"$LIVRES_BASE" && A_RANGER+=("$f")
  done
  shopt -u nullglob nocaseglob
}

# Fonds livrés (chemins relatifs à ~/Pictures/Wallpapers) : ceux de la base (LIVRES_BASE) et ceux des thèmes, listés dans
# CREDITS.tsv, celui du dépôt installé s'il est là (la copie de ~ n'est jamais remplacée : elle peut dater)
livres() {
  local depot c
  printf '%s\n' "$LIVRES_BASE"
  depot="$(cat "$HOME/.config/nc/depot" 2>/dev/null || true)"
  c="$depot/home/Pictures/Wallpapers/CREDITS.tsv"
  { [ -n "$depot" ] && [ -f "$c" ]; } || c="$FONDS/CREDITS.tsv"
  awk -F '\t' 'NR > 1 && index($1, "/") && $1 !~ /(^|\/)\.\.(\/|$)/ && $1 !~ /(^|\/)mes-fonds\// { print $1 }' "$c" 2>/dev/null
  return 0
}

notifier=0
# Le message de fin : sur la sortie, et en notification avec --notifier
dire() {
  echo "$1"
  [ "$notifier" = 1 ] && notify-send -a "$(t "Fonds d'écran" "Wallpapers")" -i preferences-desktop-wallpaper "$1" 2>/dev/null
  return 0
}
# Pose un fond, comme partout dans le dépôt (le carrousel, nc-fond-jour-nuit, nc-session)
poser() { noctalia msg wallpaper-set "$1" >/dev/null 2>&1 || true; }
ajouter() {
  local f n e base ext dest i w h copies=0 refuses=0 msg="" avert=""
  if [ $# -eq 0 ]; then
    local titre sep=$'\x1f' sortie
    titre="$(t "Ajouter un fond d'écran" "Add a wallpaper")"
    if command -v zenity >/dev/null; then
      sortie=$(zenity --file-selection --multiple "--separator=$sep" "--title=$titre" \
        "--file-filter=$(t "Images" "Images") | *.jpg *.jpeg *.png *.webp *.bmp *.avif *.jxl *.JPG *.JPEG *.PNG *.WEBP" 2>/dev/null) || return 0
      IFS="$sep" read -r -a choisis <<<"$sortie"
    elif command -v kdialog >/dev/null; then
      sortie=$(kdialog --getopenfilename --multiple --separate-output "$HOME" "image/jpeg image/png image/webp image/bmp image/avif image/jxl" --title "$titre" 2>/dev/null) || return 0
      mapfile -t choisis <<<"$sortie"
    else
      refus "$(t "Aucun sélecteur de fichiers : installe zenity, ou mets tes images dans $mes." "No file picker: install zenity, or put your pictures in $mes.")"
    fi
    set -- "${choisis[@]}"
    [ $# -gt 0 ] && [ -n "$1" ] || return 0
  fi
  mkdir -p -- "$mes" || refus "$(t "Impossible de créer $mes." "Cannot create $mes.")"
  for f in "$@"; do
    n="${f##*/}"
    e="${n##*.}"; e="${e,,}"
    w=""; h=""
    if [ ! -f "$f" ] || [ "$e" = "$n" ] || [[ " $EXTS " != *" $e "* ]] ||
       { [ ${#IDENT[@]} -gt 0 ] && ! read -r w h < <("${IDENT[@]}" -format '%w %h\n' -- "${f}[0]" 2>/dev/null); }; then
      echo "$(t "« $n » n'est pas une image (jpg, png, webp, bmp, avif, jxl) : rien n'est copié." "\"$n\" is not a picture (jpg, png, webp, bmp, avif, jxl): nothing copied.")" >&2
      refuses=$((refuses + 1)); continue
    fi
    if [ -z "$w" ]; then
      avert="$(t "Attention : ImageMagick absent, « $n » est pris sur son extension (ni sa taille ni son contenu ne sont vérifiés)." "Note: ImageMagick missing, \"$n\" is taken on its extension (neither its size nor its content is checked).")"
      echo "$avert"
    elif [ "$w" -lt 2560 ] || [ "$h" -lt 1600 ]; then
      avert="$(t "Attention : « $n » fait ${w} x ${h}, moins que 2560 x 1600 : il peut paraître flou." "Note: \"$n\" is ${w} x ${h}, less than 2560 x 1600: it may look blurry.")"
      echo "$avert"
    fi
    # Même nom, autre image : un numéro ; même image : rien à faire
    base="${n%.*}"; ext="${n##*.}"; dest="$mes/$n"; i=2
    while [ -e "$dest" ] && ! cmp -s -- "$f" "$dest"; do dest="$mes/$base-$i.$ext"; i=$((i + 1)); done
    if [ ! -e "$dest" ]; then
      # Copie sous un nom que personne ne lit (.part), puis renommage : jamais d'image à moitié écrite dans le carrousel
      cp -- "$f" "$mes/.${dest##*/}.part" && mv -f -- "$mes/.${dest##*/}.part" "$dest" ||
        { rm -f -- "$mes/.${dest##*/}.part"; refus "$(t "Copie impossible de « $n »." "Cannot copy \"$n\".")"; }
    fi
    copies=$((copies + 1))
  done
  if [ "$copies" -gt 0 ]; then
    # restart, pas start : un passage en cours (réveillé par le début de la copie) pourrait ne pas voir l'image finie
    systemctl --user restart --no-block nc-carousel-thumbs.service >/dev/null 2>&1 || true
    msg="$(t "$copies fond(s) ajouté(s) dans Mes fonds." "$copies wallpaper(s) added to My wallpapers.")"
    [ "$notifier" = 1 ] && notify-send -a "$(t "Fonds d'écran" "Wallpapers")" -i preferences-desktop-wallpaper "$msg" "$avert" 2>/dev/null
    echo "$msg"
  fi
  if [ "$refuses" -gt 0 ]; then
    [ "$notifier" = 1 ] && notify-send -a "$(t "Fonds d'écran" "Wallpapers")" -i dialog-warning \
      "$(t "$refuses fichier(s) refusé(s) : ce ne sont pas des images." "$refuses file(s) refused: not pictures.")" 2>/dev/null
    [ "$copies" -gt 0 ] || exit 1
  fi
  return 0
}

case "${1:-}" in
  dossier) printf '%s\n' "$mes" ;;
  ouvrir)
    mkdir -p -- "$mes" || refus "$(t "Impossible de créer $mes." "Cannot create $mes.")"
    setsid xdg-open "$mes" >/dev/null 2>&1 < /dev/null &
    echo "$(t "Mes fonds : $mes" "My wallpapers: $mes")" ;;
  ajouter)
    shift
    [ "${1:-}" = --notifier ] && { notifier=1; shift; }
    ajouter "$@" ;;
  retirer)
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    # Seulement un fichier rangé directement dans un mes-fonds : un fond livré ne part jamais ainsi (il reviendrait)
    # Vrai chemin (liens résolus) : dans un mes-fonds sous ~/Pictures/Wallpapers, ou dans celui du dossier en cours
    p=$(realpath -e -- "$2" 2>/dev/null) || refus "$(t "Fichier introuvable." "File not found.")"
    fr=$(realpath -m -- "$FONDS"); mr=$(realpath -m -- "$mes"); d="${p%/*}"
    { [ -f "$p" ] && [ "${d##*/}" = mes-fonds ] && { [ "$d" = "$mr" ] || [[ "$p" == "$fr"/* ]]; }; } ||
      refus "$(t "Seuls tes fonds (Mes fonds) vont à la corbeille ; un fond livré se masque." "Only your wallpapers (My wallpapers) go to the trash; a bundled one is hidden instead.")"
    gio trash -- "$p" 2>/dev/null || refus "$(t "Corbeille impossible (gio absent ?) : rien n'est supprimé." "Cannot move to the trash (gio missing?): nothing deleted.")"
    echo "$(t "« ${p##*/} » est à la corbeille." "\"${p##*/}\" moved to the trash.")" ;;
  masquer)
    shift
    [ "${1:-}" = --notifier ] && { notifier=1; shift; }
    suivant=""
    [ "${2:-}" = --poser ] && [ $# -eq 3 ] && { suivant="$3"; set -- "$1"; }
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    # -s : chemin sans suivre les liens, comme le carrousel l'écrit (relatif à ~/Pictures/Wallpapers s'il y est)
    p=$(realpath -es -- "$1" 2>/dev/null) && [ -f "$p" ] || refus "$(t "Fichier introuvable." "File not found.")"
    [ "$(basename -- "$(dirname -- "$p")")" != mes-fonds ] ||
      refus "$(t "Un fond à toi ne se masque pas : mets-le à la corbeille." "Your own wallpaper is not hidden: move it to the trash.")"
    rel="${p#"$FONDS"/}"
    # Seulement un fond LIVRÉ, sous ~/Pictures/Wallpapers : une image à toi n'est jamais mise à la corbeille par ici
    { [ "$rel" != "$p" ] && livres | grep -qxF -- "$rel"; } ||
      refus "$(t "« ${p##*/} » n'est pas un fond livré : rien n'est masqué. Une image à toi se range avec « Ranger dans Mes fonds », puis se met à la corbeille depuis Mes fonds." "\"${p##*/}\" is not a bundled wallpaper: nothing hidden. Your own picture goes with \"Move to My wallpapers\", then to the trash from My wallpapers.")"
    # D'abord la liste (install.sh ne le recopiera plus), puis le fond suivant, puis la corbeille
    mkdir -p -- "${MASQUES%/*}" || refus "$(t "Impossible d'écrire $MASQUES." "Cannot write $MASQUES.")"
    grep -qxF -- "$rel" "$MASQUES" 2>/dev/null || printf '%s\n' "$rel" >> "$MASQUES" ||
      refus "$(t "Impossible d'écrire $MASQUES." "Cannot write $MASQUES.")"
    [ -n "$suivant" ] && [ -f "$suivant" ] && poser "$suivant"
    gio trash -- "$p" 2>/dev/null ||
      refus "$(t "« ${p##*/} » est masqué, mais pas mis à la corbeille (gio absent ?)." "\"${p##*/}\" is hidden, but not moved to the trash (gio missing?).")"
    dire "$(t "« ${p##*/} » est masqué et à la corbeille : il ne revient plus (Réglages → Fonds d'écran → Réafficher)." "\"${p##*/}\" is hidden and in the trash: it will not come back (Settings → Wallpapers → Show again).")" ;;
  reafficher)
    depot="$(cat "$HOME/.config/nc/depot" 2>/dev/null || true)"
    n=0; manque=0
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      case "/$rel/" in */../*|//*) continue ;; esac          # liste écrite à la main : jamais hors du dossier des fonds
      [ -e "$FONDS/$rel" ] && { n=$((n + 1)); continue; }
      if [ -n "$depot" ] && [ -f "$depot/home/Pictures/Wallpapers/$rel" ] && mkdir -p -- "$(dirname -- "$FONDS/$rel")" &&
         cp -- "$depot/home/Pictures/Wallpapers/$rel" "$FONDS/$rel.part" && mv -f -- "$FONDS/$rel.part" "$FONDS/$rel"; then
        n=$((n + 1))
      else
        rm -f -- "$FONDS/$rel.part"; manque=$((manque + 1))
      fi
    done < <(cat -- "$MASQUES" 2>/dev/null)
    rm -f -- "$MASQUES"
    [ "$n" -gt 0 ] && systemctl --user restart --no-block nc-carousel-thumbs.service >/dev/null 2>&1
    if [ "$manque" -gt 0 ]; then
      echo "$(t "$n fond(s) réaffiché(s) ; $manque introuvable(s) ici : lance la mise à jour (nc-maj), elle les remettra." "$n wallpaper(s) shown again; $manque not found here: run the update (nc-update), it will put them back.")"
    else
      echo "$(t "$n fond(s) réaffiché(s)." "$n wallpaper(s) shown again.")"
    fi ;;
  livres) livres ;;
  a-ranger)
    if [ -e "$RANGEMENT" ]; then echo 0; else a_ranger; echo "${#A_RANGER[@]}"; fi ;;
  ranger)
    shift
    [ "${1:-}" = --notifier ] && { notifier=1; shift; }
    affiche=""
    [ "${1:-}" = --affiche ] && [ $# -ge 2 ] && { affiche=$(realpath -ms -- "$2"); shift 2; }
    [ $# -le 1 ] || { usage >&2; exit 2; }
    seul=""
    [ $# -eq 1 ] && seul=$(realpath -ms -- "$1")
    a_ranger
    if [ -n "$seul" ]; then                     # une seule image : elle doit être une des tiennes à la racine
      pris=()
      for f in "${A_RANGER[@]}"; do [ "$(realpath -ms -- "$f")" = "$seul" ] && pris+=("$f"); done
      [ ${#pris[@]} -eq 1 ] || refus "$(t "Seule une image à toi, posée à la racine des fonds, se range ainsi." "Only a picture of yours, at the top of the wallpaper folder, can be moved this way.")"
      A_RANGER=("${pris[@]}")
    fi
    n=0
    if [ ${#A_RANGER[@]} -gt 0 ]; then
      mkdir -p -- "$FONDS/mes-fonds" || refus "$(t "Impossible de créer $FONDS/mes-fonds." "Cannot create $FONDS/mes-fonds.")"
      for f in "${A_RANGER[@]}"; do
        b="${f##*/}"; dest="$FONDS/mes-fonds/$b"; i=2
        while [ -e "$dest" ]; do dest="$FONDS/mes-fonds/${b%.*}-$i.${b##*.}"; i=$((i + 1)); done
        mv -n -- "$f" "$dest" && n=$((n + 1)) && [ "$f" = "$affiche" ] && poser "$dest"   # le fond affiché suit
      done
      systemctl --user restart --no-block nc-carousel-thumbs.service >/dev/null 2>&1 || true
    fi
    [ -n "$seul" ] || { mkdir -p -- "${RANGEMENT%/*}" && echo oui > "$RANGEMENT"; }
    dire "$(t "$n fond(s) rangé(s) dans Mes fonds." "$n wallpaper(s) moved to My wallpapers.")" ;;
  garder)
    mkdir -p -- "${RANGEMENT%/*}" && echo non > "$RANGEMENT"
    echo "$(t "Rien n'est déplacé ; la question ne reviendra plus." "Nothing moved; you will not be asked again.")" ;;
  -h|--help|aide) usage ;;
  *) usage >&2; exit 2 ;;
esac
exit 0
