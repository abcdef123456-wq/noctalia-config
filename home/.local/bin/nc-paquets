#!/usr/bin/env bash
# nc-paquets : les mises à jour du système (pas de la config : ça, c'est nc-maj).
#   nc-paquets compter        compte les paquets à mettre à jour (pacman et AUR avec paru ou yay, dnf, apt ou zypper,
#                             et Flatpak) ; résultat dans ~/.cache/nc/paquets (le nombre, puis un paquet par ligne : page
#                             Système de l'île) et le détail dans ~/.cache/nc/paquets.json (versions, sources, importants)
#   nc-paquets compter auto   le passage du minuteur (nc-paquets.timer, chaque heure) : ne compte que s'il est temps
#   nc-paquets compter local  sans resynchroniser les dépôts (juste après une mise à jour : instantané)
#   nc-paquets verifier       compte tout de suite et notifie le résultat, même « à jour » (page Notifications de l'île)
#   nc-paquets mettre-a-jour  ouvre un terminal qui met tout à jour (demande ton mot de passe), puis recompte
#   nc-paquets                le nombre et la liste
# Fréquence (nc-reglages → Mises à jour, MAJ_FREQUENCE : 1h, 3h, 6h, jour) adaptée pour ne pas gaspiller : au plus toutes
# les 3 h sur batterie, 6 h en Économie, 12 h sur une connexion limitée (partage de connexion du téléphone) ; un passage
# du minuteur qui n'a rien à faire ne lit que quelques fichiers. Le compte tourne en priorité basse (processeur, disque).
# Notification (MAJ_SYSTEME=notif) : quand de nouveaux paquets arrivent, avec leurs versions, les importants d'abord
# (noyau, pilotes, Mesa, systemd, Hyprland…), la répartition dépôts / AUR / Flatpak ; rappel s'il en reste
# (MAJ_RAPPEL : jour, semaine, jamais). Un clic sur « Mettre à jour » ouvre le terminal de mise à jour.
# Le recompte après la mise à jour se fait dans le terminal, avec les dépôts que la mise à jour vient de synchroniser
# (pacman -Qu, dnf sans --refresh), en quelques secondes, et va au bout même si la fenêtre est fermée avant ; si la
# mise à jour a échoué (mot de passe, réseau), c'est le compte complet qui est refait.
set -uo pipefail
. "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }
cache="${XDG_CACHE_HOME:-$HOME/.cache}/nc"
fichier="$cache/paquets"
reglage() { sed -n "s/^$1=//p" "$HOME/.config/nc/reglages.conf" 2>/dev/null | tail -1 | tr -d '"'; }
export LC_ALL=C          # sorties des gestionnaires de paquets en anglais (analysables) ; nos messages passent par t()

aur_outil() { [ "$(reglage MAJ_AUR)" = non ] && return 1; command -v paru 2>/dev/null || command -v yay 2>/dev/null; }

# Une source qui n'a pas pu être lue (réseau, dépôt indisponible, verrou) est notée dans $echecs : « rien à mettre à
# jour » et « pas pu vérifier » ne se confondent jamais (revue Codex PKG-01). Codes de sortie : checkupdates 2 = rien,
# pacman -Qu 1 = rien, dnf check-update 100 = des mises à jour, 0 = rien ; tout autre code est un échec.
echecs=""
echec() { [ -n "$echecs" ] && printf '%s\n' "$1" >> "$echecs"; }

details() {   # source<TAB>paquet<TAB>version actuelle<TAB>nouvelle ; « local » : dépôts déjà synchronisés
  local a sortie c err
  err="$cache/.paquets-erreurs.$$"
  if command -v pacman >/dev/null; then
    # checkupdates synchronise une copie des dépôts (long) ; juste après pacman -Syu, les vrais dépôts sont à jour
    sortie=""
    if [ "${1:-}" = local ]; then sortie="$(pacman -Qu 2>/dev/null)"; c=$?; [ "$c" -le 1 ] || echec depot
    elif command -v checkupdates >/dev/null; then sortie="$(checkupdates 2>/dev/null)"; c=$?; [ "$c" = 0 ] || [ "$c" = 2 ] || echec depot
    else echec depot; fi                 # Arch sans pacman-contrib (checkupdates) : les dépôts ne sont pas vérifiés
    printf '%s\n' "$sortie" | grep -v '\[ignored\]' | awk 'NF >= 1 {print "depot\t" $1 "\t" $2 "\t" $4}'
    # AUR : paru ou yay interrogent l'API de l'AUR (quelques Ko) ; sans mise à jour, ils finissent en code 1 sans
    # rien dire : seul un message « error » est un échec
    if a="$(aur_outil)"; then
      sortie="$("$a" -Qua --color never 2>"$err")"; c=$?
      [ "$c" = 0 ] || ! grep -qi 'error' "$err" || echec aur
      printf '%s\n' "$sortie" | grep -v '\[ignored\]' | awk 'NF >= 4 {print "aur\t" $1 "\t" $2 "\t" $4}'
    fi
  elif command -v dnf >/dev/null; then
    sortie="$(dnf -q check-update $([ "${1:-}" = local ] || echo --refresh) 2>/dev/null)"; c=$?
    [ "$c" = 0 ] || [ "$c" = 100 ] || echec depot
    printf '%s\n' "$sortie" | awk 'NF == 3 && $1 ~ /\./ {n = $1; sub(/\.[^.]*$/, "", n); print "depot\t" n "\t\t" $2}'
  elif command -v apt >/dev/null; then
    sortie="$(apt list --upgradable 2>/dev/null)" || echec depot
    printf '%s\n' "$sortie" |
      sed -n 's#^\([^/]*\)/[^ ]* \([^ ]*\) [^ ]* \[upgradable from: \([^]]*\)\].*#depot\t\1\t\3\t\2#p'
  elif command -v zypper >/dev/null; then
    # openSUSE : sans root, zypper ne rafraîchit pas les dépôts ; la liste vient de leur cache (rafraîchi par la mise à
    # jour elle-même, ou par le service de rafraîchissement de la distribution). Sortie XML : indépendante de la langue.
    # Codes 100 et plus : des informations (mises à jour, redémarrage), pas des échecs
    sortie="$(zypper --non-interactive --no-refresh --xmlout list-updates 2>/dev/null)"; c=$?
    [ "$c" = 0 ] || [ "$c" -ge 100 ] || echec depot
    printf '%s\n' "$sortie" | grep '<update ' | grep 'kind="package"' |
      while IFS= read -r l; do
        n="$(sed -n 's/.* name="\([^"]*\)".*/\1/p' <<<"$l")"; v="$(sed -n 's/.* edition="\([^"]*\)".*/\1/p' <<<"$l")"
        o="$(sed -n 's/.* edition-old="\([^"]*\)".*/\1/p' <<<"$l")"
        [ -n "$n" ] && printf 'depot\t%s\t%s\t%s\n' "$n" "$o" "$v"
      done
  fi
  if command -v flatpak >/dev/null; then
    sortie="$(flatpak remote-ls --updates --columns=application,version 2>/dev/null)" || echec flatpak
    printf '%s\n' "$sortie" | awk -F'\t' 'NF >= 1 && $1 != "" {print "flatpak\t" $1 "\t\t" $2}'
  fi
  rm -f "$err"
}

# Les paquets connus d'une source qui n'a pas pu être lue cette fois : ceux du dernier compte, gardés tels quels
anciens() {
  python3 - "$cache/paquets.json" "$@" <<'PY' 2>/dev/null
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit()
for p in d.get("paquets", []):
    if p.get("source") in sys.argv[2:]:
        print("\t".join(str(p.get(k, "")).replace("\t", " ") for k in ("source", "nom", "avant", "apres")))
PY
}

# Le minuteur passe chaque heure ; compter seulement s'il est temps (secteur, batterie, Économie, connexion limitée)
il_est_temps() {
  local base min=0 dernier maintenant secteur=0 bat=0 s
  case "$(reglage MAJ_FREQUENCE)" in 3h) base=180 ;; 6h) base=360 ;; jour) base=1440 ;; *) base=60 ;; esac
  for s in "${NC_POWER_SUPPLY:-/sys/class/power_supply}"/*; do
    [ -r "$s/type" ] || continue
    case "$(cat "$s/type" 2>/dev/null)" in Mains) [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && secteur=1 ;; Battery) bat=1 ;; esac
  done
  [ "$bat" = 1 ] && [ "$secteur" = 0 ] && min=180
  grep -q 'profil *= *"power-saver"' "$HOME/.config/hypr/nc/profil.lua" 2>/dev/null && [ "$min" -lt 360 ] && min=360
  # Connexion limitée selon NetworkManager (1 : oui, 3 : sans doute)
  case "${NC_METERED:-$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null)}" in
    "u 1"|"u 3") [ "$min" -lt 720 ] && min=720 ;;
  esac
  [ "$min" -gt "$base" ] && base=$min
  dernier=$(stat -c %Y "$fichier" 2>/dev/null || echo 0); maintenant=$(date +%s)
  [ $((maintenant - dernier)) -ge $((base * 60 - 300)) ]
}

# Détail (JSON), et ce qu'il faut notifier : « titre<TAB>texte » sur la sortie, ou rien
analyser() {
  # Le code passe par -c : l'entrée standard reste celle du tube (la liste des paquets)
  local code
  code="$(cat <<'PY'
import json, os, re, sys, time
mode, cache, choix, rappel, langue, manque = sys.argv[1:7]
manque = [m for m in manque.split(",") if m]
en = langue.startswith("en")
T = lambda fr, e: e if en else fr
lignes = [l.split("\t") for l in sys.stdin.read().splitlines() if l.strip()]
paquets, vus = [], set()
for c in lignes:
    c += [""] * (4 - len(c))
    source, nom, avant, apres = c[:4]
    if not nom or (source, nom) in vus:
        continue
    vus.add((source, nom))
    paquets.append(dict(source=source, nom=nom, avant=avant, apres=apres))
IMPORTANT = re.compile(r"^(linux(-lts|-zen|-hardened|-cachyos)?|linux-image-.*|kernel(-core)?|nvidia.*|mesa|vulkan-.*|systemd|glibc|"
                       r"hyprland|quickshell|noctalia.*|pipewire|wireplumber|xdg-desktop-portal.*|firmware|linux-firmware)$")
NOYAU = re.compile(r"^(linux(-lts|-zen|-hardened|-cachyos)?|linux-image-.*|kernel(-core)?)$")
for p in paquets:
    p["important"] = bool(IMPORTANT.match(p["nom"]))
paquets.sort(key=lambda p: (not p["important"], p["source"] != "depot", p["nom"]))
sources = {s: sum(1 for p in paquets if p["source"] == s) for s in ("depot", "aur", "flatpak")}
noyau = any(NOYAU.match(p["nom"]) for p in paquets)
etat_f = os.path.join(cache, "paquets-notif.json")
try:
    etat = json.load(open(etat_f))
except (OSError, ValueError):
    etat = {}
maintenant = int(time.time())
# date_ok : le dernier compte complet (« vérifié il y a… » de l'île) ; un compte incomplet garde celui d'avant
try:
    ancien = json.load(open(os.path.join(cache, "paquets.json")))
    date_ok = ancien.get("date_ok", 0 if ancien.get("incomplet") else ancien.get("date", 0))
except (OSError, ValueError, AttributeError):
    date_ok = 0
detail = dict(date=maintenant, date_ok=date_ok if manque else maintenant, total=len(paquets), sources=sources, noyau=noyau,
              paquets=paquets[:300], derniere_notif=etat.get("date", 0), incomplet=manque)
tmp = os.path.join(cache, "paquets.json.tmp")
json.dump(detail, open(tmp, "w"), ensure_ascii=False)
os.replace(tmp, os.path.join(cache, "paquets.json"))

def ligne(p):
    sans_epoque = lambda x: re.sub(r"^\d+:", "", x)           # « 1:26.2.4-1 » → « 26.2.4-1 »
    avant, apres = sans_epoque(p["avant"]), sans_epoque(p["apres"])
    v = f" {avant} → {apres}" if avant and apres else (f" {apres}" if apres else "")
    nom = p["nom"].split(".")[-1] if p["source"] == "flatpak" else p["nom"]
    return nom + v

NOMS = {"depot": T("dépôts", "repositories"), "aur": "AUR", "flatpak": "Flatpak"}
pas_lu = ", ".join(NOMS.get(m, m) for m in manque)

def texte():
    n = len(paquets)
    if manque and n == 0:
        return (T("Vérification impossible", "Could not check for updates"),
                T(f"Pas de réponse : {pas_lu} (réseau ou dépôt indisponible). Réessaie plus tard.",
                  f"No answer from: {pas_lu} (network or repository unavailable). Try again later."))
    if n == 0:
        return T("Système à jour", "System up to date"), T("Aucune mise à jour en attente.", "No pending update.")
    titre = T(f"{n} mise{'s' if n > 1 else ''} à jour", f"{n} update{'s' if n > 1 else ''}")
    corps = ", ".join(ligne(p) for p in paquets[:5]) + (T(f" et {n - 5} autres", f" and {n - 5} more") if n > 5 else "")
    parts = [f"{T('Dépôts', 'Repos')} {sources['depot']}" if sources["depot"] else "", f"AUR {sources['aur']}" if sources["aur"] else "",
             f"Flatpak {sources['flatpak']}" if sources["flatpak"] else ""]
    corps += "\n" + " · ".join(x for x in parts if x)
    if noyau:
        corps += "\n" + T("Nouveau noyau : redémarre après la mise à jour.", "New kernel: restart after updating.")
    if manque:
        corps += "\n" + T(f"Pas vérifié cette fois : {pas_lu} (dernier état gardé).", f"Not checked this time: {pas_lu} (last state kept).")
    return titre, corps

noms = sorted(f"{p['source']}:{p['nom']}:{p['apres']}" for p in paquets)
deja = set(etat.get("noms", []))
nouveaux = [x for x in noms if x not in deja]
envoyer = False
if mode == "force":
    envoyer = True
elif choix != "ile" and choix != "non" and paquets:
    delai = {"semaine": 7 * 86400, "jamais": None}.get(rappel, 86400)
    envoyer = bool(nouveaux) or (delai is not None and maintenant - etat.get("date", 0) >= delai)
if envoyer:
    json.dump(dict(date=maintenant, noms=noms), open(etat_f, "w"))
    titre, corps = texte()
    print(f"{titre}\t{corps}".replace("\n", "\\n"))
elif not paquets and not manque:
    try:
        os.remove(etat_f)            # tout est à jour : la prochaine mise à jour sera de nouveau annoncée
    except OSError:
        pass
PY
)"
  python3 -c "$code" "$1" "$cache" "$(reglage MAJ_SYSTEME)" "$(reglage MAJ_RAPPEL)" "${NC_LANGUE:-}" "${2:-}"
}

notifier() {  # titre, texte (\n pour les retours à la ligne) ; « Mettre à jour » ouvre le terminal
  local titre="$1" corps
  corps="$(printf '%b' "$2")"
  (
    if [ "$titre" = "$(t "Système à jour" "System up to date")" ]; then
      notify-send -a "$(t "Mises à jour" "Updates")" -i system-software-update "$titre" "$corps" 2>/dev/null
    else
      r="$(timeout 3600 notify-send -a "$(t "Mises à jour" "Updates")" -i system-software-update -A maj="$(t "Mettre à jour" "Update")" \
        "$titre" "$corps" 2>/dev/null)"
      [ "$r" = maj ] && exec "$0" mettre-a-jour
    fi
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# Instantané de / avant la mise à jour (MAJ_INSTANTANE, « auto » : seulement sur Btrfs) : pour revenir en arrière si une
# mise à jour casse quelque chose. Rien si un outil le fait déjà à chaque mise à jour (snap-pac sur Arch, snapper avec
# zypper ou dnf) ; sinon snapper ou Timeshift s'ils sont configurés ; sinon un instantané Btrfs en lecture seule dans
# /.snapshots, les 3 derniers de nc-paquets gardés. Démarrer dessus depuis GRUB demande grub-btrfs.
instantane() {
  [ "$(reglage MAJ_INSTANTANE)" = non ] && return 0
  [ "$(findmnt -no FSTYPE / 2>/dev/null)" = btrfs ] || return 0
  local quand; quand="$(date +%Y-%m-%d_%H-%M-%S)"
  # N'importe lequel de ces crochets suffit (un seul existe selon la distribution ; « ls a b » échouait dès qu'un
  # manquait, revue Codex PKG-02), et snapper doit avoir une configuration de / pour qu'il serve vraiment
  local h crochet=0
  for h in ${NC_CROCHETS_SNAPPER:-/usr/share/libalpm/hooks/*snap-pac* /usr/lib/zypp/plugins/commit/snapper* \
           /usr/lib/python3*/site-packages/dnf-plugins/snapper.py /etc/dnf/libdnf5-plugins/actions.d/snapper.actions}; do
    [ -e "$h" ] && crochet=1 && break
  done
  if [ "$crochet" = 1 ] && [ -e "${NC_SNAPPER_ROOT:-/etc/snapper/configs/root}" ]; then
    t "Instantané : fait par snapper à la mise à jour." "Snapshot: taken by snapper during the update."; echo; return 0
  fi
  t "Instantané du système avant la mise à jour…" "System snapshot before the update…"; echo
  if command -v snapper >/dev/null && sudo snapper -c root list >/dev/null 2>&1; then
    sudo snapper -c root create -t single -c number -d "nc-paquets : avant la mise à jour" && return 0
  elif command -v timeshift >/dev/null && sudo timeshift --list >/dev/null 2>&1; then
    sudo timeshift --create --scripted --tags O --comments "nc-paquets : avant la mise à jour" >/dev/null && return 0
  else
    [ -d /.snapshots ] || sudo btrfs subvolume create /.snapshots >/dev/null || return 0
    if sudo btrfs subvolume snapshot -r / "/.snapshots/nc-avant-maj-$quand" >/dev/null; then
      # Les 3 plus récents de nc-paquets gardés (les autres instantanés ne sont jamais touchés)
      sudo find /.snapshots -mindepth 1 -maxdepth 1 -name 'nc-avant-maj-*' -printf '%f\n' | sort -r | tail -n +4 |
        while read -r vieux; do sudo btrfs subvolume delete "/.snapshots/$vieux" >/dev/null; done
      t "Instantané : /.snapshots/nc-avant-maj-$quand" "Snapshot: /.snapshots/nc-avant-maj-$quand"; echo
      ls /etc/grub.d/*btrfs* >/dev/null 2>&1 ||
        { t "(pour démarrer dessus depuis GRUB : installe grub-btrfs)" "(to boot it from GRUB: install grub-btrfs)"; echo; }
      return 0
    fi
  fi
  t "Instantané impossible : la mise à jour continue sans." "Snapshot failed: the update goes on without it."; echo
}

action="${1:-}"
# Noms anglais (nc-packages count | update | check)
case "$action" in count) action=compter ;; update|upgrade) action=mettre-a-jour ;; check|verify) action=verifier ;; esac

case "$action" in
  compter|verifier)
    mode="${2:-}"; [ "$action" = verifier ] && mode=force
    [ "$(reglage MAJ_SYSTEME)" = non ] && [ "$mode" != force ] && { rm -f "$fichier" "$cache/paquets.json"; exit 0; }
    [ "$mode" = auto ] && ! il_est_temps && exit 0
    mkdir -p "$cache"
    echecs="$cache/.paquets-echecs.$$"; : > "$echecs"
    d="$(details "$([ "$mode" = local ] && echo local)")"
    manque="$(sort -u "$echecs" | tr '\n' ',' | sed 's/,$//')"; rm -f "$echecs"
    # Une source muette : ses paquets du dernier compte restent (jamais « à jour » faute de réponse), l'état est daté
    if [ -n "$manque" ]; then
      d="$d"$'\n'"$(anciens ${manque//,/ })"
      printf '%s\t%s\n' "$(date +%s)" "$manque" > "$cache/paquets-erreur"
    else
      rm -f "$cache/paquets-erreur"
    fi
    l="$(printf '%s\n' "$d" | awk -F'\t' 'NF >= 2 {print ($1 == "depot" ? "" : $1 ":") $2}' | sort -u)"
    n=$(printf '%s' "$l" | grep -c . || true)
    { echo "$n"; printf '%s\n' "$l"; } > "$fichier.tmp" && mv "$fichier.tmp" "$fichier"
    a_dire="$(printf '%s\n' "$d" | analyser "$mode" "$manque" 2>/dev/null)"
    if [ -n "$a_dire" ]; then notifier "${a_dire%%$'\t'*}" "${a_dire#*$'\t'}"; fi
    # Le minuteur se tait (il réessaiera) ; lancé à la main, un compte incomplet le dit et finit en échec
    if [ -n "$manque" ] && [ "$mode" != auto ]; then
      noms="$(sed -e "s/depot/$(t "dépôts" "repositories")/" -e 's/aur/AUR/' -e 's/flatpak/Flatpak/' -e 's/,/, /g' <<<"$manque")"
      t "Vérification incomplète, pas de réponse : $noms (dernier état gardé)" "Incomplete check, no answer from: $noms (last state kept)" >&2
      echo >&2; exit 1
    fi ;;
  mettre-a-jour)
    exec kitty --class nc-paquets --title "$(t "Mises à jour du système" "System Updates")" "$0" terminal ;;
  terminal)   # dans le terminal ouvert par mettre-a-jour : la mise à jour, puis le recompte
    # Fenêtre fermée pendant le recompte : il va quand même au bout (sinon l'île garderait l'ancien nombre)
    trap '' HUP
    unset LC_ALL     # la mise à jour parle la langue du système
    ok=0
    # La liste d'avant la mise à jour (versions, paquets importants) : pour le rapport de l'IA à la fin
    cp -f "$cache/paquets.json" "$cache/paquets-avant.json" 2>/dev/null || true
    instantane
    # Arch : paru ou yay mettent à jour les dépôts et l'AUR (ils demandent eux-mêmes le mot de passe)
    if command -v pacman >/dev/null; then
      if a="$(aur_outil)"; then "$a" -Syu || ok=1; else sudo pacman -Syu || ok=1; fi
    # Nobara : son outil fait la mise à jour et ses corrections (dnf seul est déconseillé par Nobara)
    elif command -v nobara-sync >/dev/null; then nobara-sync cli || ok=1
    elif command -v dnf >/dev/null; then sudo dnf upgrade --refresh || ok=1
    elif command -v apt >/dev/null; then { sudo apt update && sudo apt full-upgrade; } || ok=1
    # Tumbleweed et Slowroll : mise à jour de la distribution (zypper dup), comme le recommande openSUSE
    elif command -v zypper >/dev/null; then sudo zypper dup || ok=1
    else echo "$(t "Gestionnaire de paquets non reconnu." "Unrecognized package manager.")"; ok=1; fi
    if command -v flatpak >/dev/null; then flatpak update || ok=1; fi
    echo; t "Recompte des mises à jour…" "Recounting updates…"; echo
    incomplet=0
    if [ "$ok" = 0 ]; then "$0" compter local || incomplet=1; else "$0" compter || incomplet=1; fi
    # Rapport de l'IA (si elle est permise et joignable) : ce qui a changé, en clair, dans les réglages → Mises à jour
    if [ "$ok" = 0 ] && [ -x "$HOME/.local/bin/nc-ia" ] && [ -s "$cache/paquets-avant.json" ]; then
      setsid "$HOME/.local/bin/nc-ia" rapport-maj systeme "$cache/paquets-avant.json" >/dev/null 2>&1 < /dev/null &
    fi
    n=$(head -1 "$fichier" 2>/dev/null || echo 0)
    if [ "$incomplet" = 1 ]; then t "Recompte incomplet : relance « nc-paquets verifier » plus tard." "Incomplete recount: run “nc-packages check” later."
    elif [ "${n:-0}" -gt 0 ]; then t "$n mise(s) à jour encore en attente." "$n update(s) still pending."
    else t "Système à jour." "System up to date."; fi
    # Alerte Telegram de fin de mise à jour (nc-alertes décide : réglage ALERTES_TELEGRAM, connexion configurée)
    [ -x "$HOME/.local/bin/nc-alertes" ] && "$HOME/.local/bin/nc-alertes" maj "${n:-0}" >/dev/null 2>&1 || true
    echo; printf '%s' "$(t "Terminé. Entrée pour fermer." "Done. Press Enter to close.")"; read -r r 2>/dev/null || true ;;
  *)
    if [ -s "$fichier" ]; then t "$(head -1 "$fichier") mise(s) à jour :" "$(head -1 "$fichier") update(s):"; echo; tail -n +2 "$fichier"
    else t "Pas encore compté : nc-paquets compter" "Not counted yet: nc-packages count"; echo; fi ;;
esac
