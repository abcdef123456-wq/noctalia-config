#!/usr/bin/env python3
"""nc-diag : vérifie toute l'installation de noctalia-config et dit quoi faire quand quelque chose cloche.
  nc-diag            le bilan, en couleurs : ✓ ce qui va, ! ce qui manque (sans gravité), ✗ ce qui ne marche pas
  nc-diag ia         le bilan expliqué par l'IA du bureau, avec quoi faire (s'il y a quelque chose à corriger)
  nc-diag rapport    le même bilan en texte simple, copié dans le presse-papiers : à envoyer pour avoir de l'aide
  nc-diag court      seulement ce qui cloche (lancé par nc-maj après chaque mise à jour)
  nc-diag --json [--rapide]    ce qui cloche et les réparations proposées, en JSON (île, nc-ia) ; --rapide saute le plus long
  nc-diag reparer ID [--json]  une réparation proposée par --json (redémarrer un service en échec…), et rien d'autre
Ne change rien sur le PC, sauf « nc-diag reparer ».
"""
import contextlib
import fcntl
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time


# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


DOC_EN = """nc-diag: checks the whole noctalia-config installation and tells you what to do when something is wrong.
  nc-diag            the summary, in color: ✓ what works, ! what is missing (not serious), ✗ what does not work
  nc-diag ai         the summary explained by the desktop AI, with what to do (if something needs fixing)
  nc-diag report     the same summary as plain text, copied to the clipboard: send it when asking for help
  nc-diag short      only what is wrong (run by nc-update after each update)
  nc-diag --json [--rapide]    what is wrong and the proposed repairs, as JSON (island, nc-ai); --rapide skips the slowest
  nc-diag repair ID [--json]   one repair proposed by --json (restart a failed service…), and nothing else
Changes nothing on the PC, except “nc-diag repair”.
"""

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")


# « nc-diag --json --rapide » (Spotlight, nc-ia) : les vérifications longues sautées, chaque délai borné à 3 s
RAPIDE = False


def sortie(cmd, delai=5, plafond=3):
    if RAPIDE:
        delai = min(delai, plafond)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=delai)
        return (r.stdout + r.stderr).strip(), r.returncode
    except (OSError, subprocess.TimeoutExpired):
        return "", 127


def a(cmd):
    return shutil.which(cmd) is not None


# ── Réparations : une table FIXE, « nc-diag reparer ID » ne lance rien d'autre ──
# Unités de la session qu'on a le droit de (re)démarrer : (nom français, nom anglais), avec l'article
UNITES = {
    "noctalia.service": ("la barre de Noctalia", "the Noctalia bar"),
    "nc-ile.service": ("l'île dynamique", "the dynamic island"),
    "nc-profile-sync.service": ("les profils d'énergie", "the power profiles"),
    "nc-pouls.service": ("le halo musical", "the music glow"),
    "nc-ecran-externe.service": ("les écrans externes", "the external screens"),
    "hypridle.service": ("la veille automatique", "automatic sleep"),
    "nc-theme-sync.path": ("les couleurs du fond d'écran", "the wallpaper colors"),
    "nc-couvercle.service": ("le couvercle", "the lid"),
    "xdg-desktop-portal-hyprland.service": ("le portail de Hyprland (partage d'écran)", "the Hyprland portal (screen sharing)"),
    "plasma-polkit-agent.service": ("l'agent des mots de passe (polkit)", "the password prompt agent (polkit)"),
}
# Pas de « demarrer » pour nc-pouls (coupé exprès par Super + Alt + M : arrêté n'est pas une panne) ni pour nc-couvercle
# (inactif quand on n'a pas choisi « l'écran s'éteint, le PC continue ») : seulement les redémarrer s'ils sont en échec.
# Noctalia : « redemarrer » dès qu'elle ne répond pas ; la démarrer à côté d'une barre lancée hors de systemd en ferait deux
SANS_DEMARRER = ("nc-pouls.service", "nc-couvercle.service", "noctalia.service")
ID_UNITE = re.compile(r"(redemarrer|demarrer):[a-z0-9-]+\.(service|path)")
NOMS_FIXES = ("ia_conf_prive",)
# Casque Bluetooth : l'id porte la carte (bt_reconnecter:bluez_card.00_11_22_33_44_55), grammaire stricte ; l'entrée de la
# table est faite à la demande pour une carte de cette forme (rien d'autre n'entre dans la table)
ID_BT = re.compile(r"(bt_reconnecter|bt_musique):(bluez_card\.[0-9A-F_]{17})")
BT_PROFIL_APPEL, BT_PROFIL_CVSD = "headset-head-unit", "headset-head-unit-cvsd"
BT_A2DP = ("a2dp-sink-aac", "a2dp-sink-sbc_xq", "a2dp-sink")      # du meilleur au moins bon
SYS = os.environ.get("NC_DIAG_SYS", "/sys")                      # les tests y mettent un faux /sys


def _table():
    t = {}
    for u, (fr, en) in UNITES.items():
        ile = u == "nc-ile.service"
        t["redemarrer:" + u] = {
            "libelle": T(f"Redémarrer {fr}", f"Restart {en}"),
            "detail": T("L'île se ferme et revient ; une notification le dit." if ile else
                        f"{u} est en échec : son compteur est remis à zéro, puis il est redémarré.",
                        "The island closes and comes back; a notification says so." if ile else
                        f"{u} failed: its counter is reset, then it is restarted."),
            "danger": ile, "ferme_ile": ile}
        if u not in SANS_DEMARRER:
            t["demarrer:" + u] = {
                "libelle": T(f"Démarrer {fr} (pour cette session)", f"Start {en} (for this session)"),
                "detail": T(f"{u} est arrêté, peut-être coupé exprès : démarré pour cette session seulement, rien n'est "
                            "activé au démarrage du PC.",
                            f"{u} is stopped, maybe on purpose: started for this session only, nothing is enabled at boot."),
                "danger": False, "ferme_ile": False}
    t["ia_conf_prive"] = {
        "libelle": T("Protéger le fichier des clés d'IA", "Protect the AI keys file"),
        "detail": T("chmod 600 ~/.config/nc/ia.conf : lisible par toi seul.", "chmod 600 ~/.config/nc/ia.conf: readable by you only."),
        "danger": False, "ferme_ile": False}
    return t


def _entree_bt(ident):
    m = ID_BT.fullmatch(ident) if isinstance(ident, str) else None
    if not m:
        return None
    if m[1] == "bt_reconnecter":
        return {"libelle": T("Refaire la connexion Bluetooth du casque", "Redo the headset's Bluetooth connection"),
                "detail": T("Déconnecte puis reconnecte le casque (quelques secondes sans son), et remet le mode appel si une "
                            "appli utilise son micro. Le micro retrouve la bonne qualité.",
                            "Disconnects then reconnects the headset (a few seconds of silence), and puts the call mode back if "
                            "an app is using its microphone. The microphone gets its full quality back."),
                "danger": False, "ferme_ile": False}
    return {"libelle": T("Qualité musique (micro du PC pour les appels)", "Music quality (PC microphone for calls)"),
            "detail": T("Le casque repasse en lecture haute qualité (A2DP). Les applis utilisent le micro du PC tant que le "
                        "casque n'est pas remis en mode appel.",
                        "The headset goes back to high quality playback (A2DP). Apps use the PC microphone until the headset "
                        "is put back in call mode."),
            "danger": False, "ferme_ile": False}


class Table(dict):
    """La table des réparations : les entrées fixes, plus celles d'un casque Bluetooth dont l'id respecte la grammaire."""
    def __contains__(self, k):
        return dict.__contains__(self, k) or _entree_bt(k) is not None

    def __missing__(self, k):
        e = _entree_bt(k)
        if e is None:
            raise KeyError(k)
        return e


REPARATIONS = Table(_table())


def id_valide(ident):
    """Un id de réparation connu : la grammaire (unités, casque Bluetooth) ou un nom fixe, ET présent dans la table.
    Rien d'autre."""
    return (isinstance(ident, str) and (ID_UNITE.fullmatch(ident) is not None or ID_BT.fullmatch(ident) is not None
                                        or ident in NOMS_FIXES) and ident in REPARATIONS)


def unite_chargee(u):
    """Vrai si systemd connaît l'unité (LoadState=loaded) : une unité absente ne se démarre pas."""
    v, code = sortie(["systemctl", "--user", "show", "-p", "LoadState", "--value", u])
    return code == 0 and v.strip() == "loaded"


PROC = os.environ.get("NC_DIAG_PROC", "/proc")      # les tests y mettent un faux /proc


def ile_hors_systemd():
    """Vrai si une île « qs -c nc-ile » tourne déjà à toi (lancée à la main, hors de nc-ile.service) : en démarrer une
    seconde par systemd en ferait deux. Lu dans /proc (les clients « qs -c nc-ile ipc|log … » ne comptent pas)."""
    try:
        pids = [p for p in os.listdir(PROC) if p.isdigit()]
    except OSError:
        return False
    for p in pids:
        try:
            if os.stat(os.path.join(PROC, p)).st_uid != os.getuid():
                continue
            with open(os.path.join(PROC, p, "cmdline"), "rb") as f:
                argv = f.read(8192).decode("utf-8", "replace").split("\0")
        except OSError:
            continue
        for i in (0, 1):                         # « qs … » ou « interpréteur qs … »
            if i < len(argv) and os.path.basename(argv[i]) == "qs":
                reste = argv[i + 1:]
                if "-c" in reste and reste[reste.index("-c") + 1:][:1] == ["nc-ile"] and \
                        not {"ipc", "log"} & set(reste):
                    return True
    return False


def proposer(u, etat):
    """Les réparations d'une unité selon son état : la redémarrer si elle est en échec, la démarrer (pour la session)
    si elle est seulement arrêtée et existe ; rien sinon (hors session, état illisible, unité absente)."""
    if etat == "failed":
        return ["redemarrer:" + u]
    if etat == "inactive" and "demarrer:" + u in REPARATIONS and unite_chargee(u) \
            and not (u == "nc-ile.service" and ile_hors_systemd()):
        return ["demarrer:" + u]
    return []


class Bilan:
    """lignes : (genre, texte, quoi) pour le texte ; constats : les ! et ✗ avec leur clé stable (cle) et les réparations
    proposées (ids de REPARATIONS), pour « nc-diag --json »."""
    def __init__(self, couleurs):
        self.lignes, self.ko, self.attention, self.nb_ok = [], 0, 0, 0
        self.constats, self.section = [], ""
        self.c = couleurs

    def titre(self, t):
        self.section = t
        self.lignes.append(("titre", t, ""))

    def ok(self, t):
        self.nb_ok += 1
        self.lignes.append(("ok", t, ""))

    def _constat(self, niveau, t, quoi, cle, reparations, texte_ia):
        self.lignes.append((niveau, t, quoi))
        # texte_ia : ce qui peut partir vers une IA, SANS la ligne du journal (nom de réseau, titre de fenêtre ou de
        # musique, texte de notification…) ; par défaut, le texte affiché
        self.constats.append({"cle": cle or "autre", "niveau": niveau, "section": self.section, "texte": t, "quoi": quoi,
                              "texte_ia": t if texte_ia is None else texte_ia,
                              "reparations": [x for x in reparations if x in REPARATIONS]})

    def avert(self, t, quoi="", cle="", reparations=(), texte_ia=None):
        self.attention += 1
        self._constat("avert", t, quoi, cle, reparations, texte_ia)

    def faux(self, t, quoi="", cle="", reparations=(), texte_ia=None):
        self.ko += 1
        self._constat("faux", t, quoi, cle, reparations, texte_ia)

    def texte(self, court=False):
        if self.c:
            V, J, R, G, D, F = "\033[32m", "\033[33m", "\033[31m", "\033[1m", "\033[2m", "\033[0m"
        else:
            V = J = R = G = D = F = ""
        out = []
        for genre, t, quoi in self.lignes:
            if court and genre in ("titre", "ok"):
                continue
            if genre == "titre":
                out.append(f"\n{G}{t}{F}")
                continue
            signe = {"ok": f"{V}✓{F}", "avert": f"{J}!{F}", "faux": f"{R}✗{F}"}[genre]
            out.append(f"  {signe} {t}")
            if quoi:
                out.append(f"      {D}→ {quoi}{F}")
        return "\n".join(out)


def verifier(b):
    # ── Système ──
    b.titre(T("Système", "System"))
    osr = {}
    try:
        for l in open("/etc/os-release"):
            k, _, v = l.strip().partition("=")
            osr[k] = v.strip('"')
    except OSError:
        pass
    b.ok(f"{osr.get('PRETTY_NAME', 'Linux')} · " + T("noyau", "kernel") + f" {os.uname().release}")
    depot = ""
    try:
        depot = open(os.path.join(HOME, ".config/nc/depot")).read().strip()
    except OSError:
        pass
    if depot and os.path.isdir(os.path.join(depot, ".git")):
        rev, _ = sortie(["git", "-C", depot, "log", "-1", T("--format=%h du %cd", "--format=%h (%cd)"),
                         T("--date=format:%d/%m/%Y", "--date=short")])
        b.ok(T(f"noctalia-config : version {rev}", f"noctalia-config: version {rev}"))
    else:
        b.avert(T("dépôt noctalia-config introuvable", "noctalia-config repository not found"),
                T("relance install.sh depuis le dépôt cloné (nc-maj en a besoin)",
                  "run install.sh again from the cloned repository (nc-update needs it)"), cle="depot_introuvable")
    dossiers_xdg(b)

    # ── Hyprland ──
    b.titre("Hyprland")
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        b.faux(T("pas dans une session Hyprland", "not in a Hyprland session"),
               T("lance nc-diag depuis un terminal de ta session Hyprland", "run nc-diag from a terminal in your Hyprland session"),
               cle="hors_session")
    else:
        v, _ = sortie(["hyprctl", "version", "-j"])
        try:
            ver = json.loads(v).get("tag", "?").lstrip("v").split("-")[0]
        except ValueError:
            ver = "?"
        b.ok(f"Hyprland {ver}")
        err, _ = sortie(["hyprctl", "configerrors"])
        err = "\n".join(l for l in err.splitlines() if l.strip())
        if err:
            premiere = err.splitlines()[0][:160]
            b.faux(T(f"erreur dans la config Hyprland : {premiere}", f"error in the Hyprland config: {premiere}"),
                   T("nc-maj ; si ça reste, envoie « nc-diag rapport »", "nc-update; if it persists, send “nc-diag report”"),
                   cle="hyprland_config")
        else:
            b.ok(T("config Hyprland sans erreur", "Hyprland config has no errors"))
    # Marqueurs @…@ jamais remplis (fichier copié à la main depuis le dépôt) : casse la config
    restes = []
    for d in (".config/hypr", ".config/noctalia", ".config/kitty", ".config/quickshell"):
        for racine, _, fichiers in os.walk(os.path.join(HOME, d)):
            for f in fichiers:
                if not f.endswith((".lua", ".toml", ".conf", ".qml", ".json")):
                    continue
                p = os.path.join(racine, f)
                try:
                    t = open(p, encoding="utf-8", errors="ignore").read()
                except OSError:
                    continue
                for m in re.findall(r"@[A-Z][A-Z_]+[0-9]?@", t):
                    if m not in ("@DEFAULT_AUDIO_SINK@", "@DEFAULT_AUDIO_SOURCE@", "@DEFAULT_SINK@", "@DEFAULT_SOURCE@"):
                        restes.append(f"{p.replace(HOME, '~')} ({m})")
                        break
    if restes:
        b.faux(T("fichiers jamais complétés par l'installation : ", "files never completed by the installer: ") + ", ".join(restes[:3]),
               T("relance install.sh (ne copie pas les fichiers du dépôt à la main)",
                 "run install.sh again (do not copy the repository files by hand)"), cle="marqueurs_restes")

    # ── Noctalia et l'île ──
    b.titre(T("Barre et île", "Bar and island"))
    if a("noctalia"):
        v, _ = sortie(["noctalia", "--version"])
        b.ok(v.splitlines()[0] if v else T("Noctalia installée", "Noctalia installed"))
        _, code = sortie(["noctalia", "msg", "status"])
        if code != 0:
            b.faux(T("Noctalia ne tourne pas", "Noctalia is not running"), "systemctl --user restart noctalia.service",
                   cle="noctalia_arretee",
                   reparations=["redemarrer:noctalia.service"] if unite_chargee("noctalia.service") else [])
        val, code = sortie(["noctalia", "config", "validate"], 15)
        if code != 0:
            ligne = next((l for l in val.splitlines() if "ERR" in l or "error" in l.lower()), val.splitlines()[-1] if val else "")
            b.faux(T(f"config de Noctalia : {ligne[:160]}", f"Noctalia config: {ligne[:160]}"), T("nc-maj", "nc-update"),
                   cle="noctalia_config", texte_ia=T("config de Noctalia invalide", "Noctalia config invalid"))
    else:
        b.faux(T("Noctalia n'est pas installée", "Noctalia is not installed"), T("relance install.sh", "run install.sh again"),
               cle="noctalia_absente")
    if a("qs"):
        v, _ = sortie(["qs", "--version"])
        qv = (re.findall(r"\d+\.\d+(?:\.\d+)?", v) or ["?"])[0]
        if qv != "?" and tuple(int(x) for x in qv.split(".")[:2]) < (0, 3):
            b.avert(T(f"Quickshell {qv} : l'île demande la 0.3", f"Quickshell {qv}: the island needs 0.3"),
                    T("mets Quickshell à jour (Fedora : COPR errornointernet/quickshell)",
                      "update Quickshell (Fedora: COPR errornointernet/quickshell)"), cle="quickshell_ancien")
        else:
            b.ok(T(f"Quickshell {qv} (île dynamique)", f"Quickshell {qv} (dynamic island)"))
        capture = os.path.join(HOME, ".local/bin/nc-qs-capture")
        if RAPIDE:
            pass                                    # nc-qs-capture lance deux fois « qs -p » : trop long pour le Spotlight
        elif not os.path.isfile(capture):
            b.avert(T("vérificateur des modules Quickshell absent", "Quickshell module checker missing"),
                    T("réinstalle les fichiers de la configuration", "reinstall the configuration files"), cle="qs_verificateur_absent")
        elif sortie(["bash", capture, "--modules"], 15)[1] != 0:
            b.avert(T("modules Quickshell incomplets : l'île Quickshell ne peut pas être sélectionnée",
                      "Quickshell modules incomplete: the Quickshell island cannot be selected"),
                    T("relance nc-maj ; sur Debian, accepte la recompilation de Quickshell",
                      "run nc-update again; on Debian, accept rebuilding Quickshell"), cle="qs_modules")
        elif sortie(["bash", capture], 15)[1] != 0:
            b.avert(T("Quickshell sans capture ou sans réseau : vue des fenêtres (Super + A) ou suivi de la connexion indisponible, le reste de l'île marche",
                      "Quickshell without capture or networking: window overview (Super + A) or connection tracking unavailable, the rest of the island works"),
                    T("relance nc-maj ; sur Debian, accepte la recompilation de Quickshell",
                      "run nc-update again; on Debian, accept rebuilding Quickshell"), cle="qs_capture")
        _, active = sortie(["systemctl", "--user", "is-enabled", "nc-ile.service"])
        if active != 0:
            b.avert(T("île simplifiée du plugin Noctalia (l'île Quickshell n'est pas activée)",
                      "simplified island of the Noctalia plugin (the Quickshell island is not enabled)"),
                    T("relance install.sh", "run install.sh again"), cle="ile_desactivee")
        elif (ile := sortie(["systemctl", "--user", "is-active", "nc-ile.service"]))[1] != 0:
            b.faux(T("l'île dynamique ne tourne pas", "the dynamic island is not running"),
                   T("systemctl --user restart nc-ile.service ; journal : qs -c nc-ile log",
                     "systemctl --user restart nc-ile.service; log: qs -c nc-ile log"),
                   cle="ile_arretee", reparations=proposer("nc-ile.service", ile[0].strip()))
        elif not os.path.exists(os.path.join(HOME, ".local/share/fonts/MaterialSymbolsRounded.ttf")):
            b.avert(T("police des icônes de l'île absente (carrés à la place des icônes)",
                      "island icon font missing (squares instead of icons)"),
                    T("relance install.sh, qui la télécharge", "run install.sh again, it downloads it"), cle="ile_police")
    else:
        b.avert(T("Quickshell absent : île simplifiée du plugin Noctalia", "Quickshell missing: simplified island of the Noctalia plugin"),
                T("relance install.sh (il propose de l'installer)", "run install.sh again (it offers to install it)"),
                cle="quickshell_absent")

    # ── Services ──
    b.titre(T("Services de la session", "Session services"))
    services = {
        "noctalia.service": T("barre de Noctalia", "Noctalia bar"), "nc-profile-sync.service": T("profils d'énergie", "power profiles"),
        "nc-pouls.service": T("halo musical", "music glow"), "nc-ecran-externe.service": T("écrans externes", "external screens"),
        "hypridle.service": T("veille automatique", "automatic sleep"), "nc-theme-sync.path": T("couleurs du fond d'écran", "wallpaper colors"),
    }
    if os.path.exists(os.path.join(HOME, ".config/systemd/user/nc-couvercle.service")):
        services["nc-couvercle.service"] = T("couvercle", "lid")
    for s, nom in services.items():
        etat, _ = sortie(["systemctl", "--user", "is-active", s])
        if etat == "active":
            b.ok(f"{nom} ({s})")
        elif s == "nc-couvercle.service" and etat == "inactive":
            b.ok(T(f"{nom} : mise en veille normale", f"{nom}: normal sleep"))
        elif etat == "failed":
            journal, _ = sortie(["journalctl", "--user", "-u", s, "-n", "3", "--no-pager", "-o", "cat"])
            n = len(journal.splitlines())
            b.faux(T(f"{nom} ({s}) en échec : ", f"{nom} ({s}) failed: ") + (journal.splitlines()[-1][:140] if journal else ""),
                   f"systemctl --user restart {s}", cle="service:" + s, reparations=proposer(s, etat),
                   texte_ia=T(f"{nom} ({s}) en échec", f"{nom} ({s}) failed") + (T(f" ; journal : {n} ligne(s)", f"; log: {n} line(s)") if n else ""))
        else:
            b.avert(T(f"{nom} ({s}) : {etat or 'inconnu'}", f"{nom} ({s}): {etat or 'unknown'}"), f"systemctl --user enable --now {s}",
                    cle="service:" + s, reparations=proposer(s, etat))

    # Demandes de mot de passe (polkit) : l'agent de Noctalia (polkit_agent = true), sinon un agent qui tourne
    try:
        noct = open(os.path.join(HOME, ".config/noctalia/config.toml"), encoding="utf-8").read()
    except OSError:
        noct = ""
    if not re.search(r"^\s*polkit_agent\s*=\s*true", noct, re.M):
        agents, _ = sortie(["pgrep", "-l", "-f", "polkit-kde-authentication-agent|hyprpolkitagent|polkit-gnome-authentication|"
                                             "polkit-mate-authentication|lxpolkit|xfce-polkit"])
        if agents:
            b.ok(T("agent des demandes de mot de passe (polkit)", "password prompt agent (polkit)"))
        else:
            b.faux(T("aucun agent polkit : les fenêtres de mot de passe des applis ne s'affichent pas",
                     "no polkit agent: apps' password windows don't show"),
                   "systemctl --user reset-failed plasma-polkit-agent.service; systemctl --user start plasma-polkit-agent.service",
                   cle="polkit_absent", reparations=proposer("plasma-polkit-agent.service", sortie(
                       ["systemctl", "--user", "is-active", "plasma-polkit-agent.service"])[0].strip()))

    # ── Énergie ──
    b.titre(T("Énergie", "Power"))
    prof, code = sortie(["gdbus", "call", "--system", "--dest", "net.hadess.PowerProfiles", "--object-path",
                         "/net/hadess/PowerProfiles", "--method", "org.freedesktop.DBus.Properties.Get",
                         "net.hadess.PowerProfiles", "ActiveProfile"])
    if code == 0:
        p = re.findall(r"'([a-z-]+)'", prof)
        b.ok(T(f"profils d'énergie disponibles (actif : {p[0] if p else '?'})",
               f"power profiles available (active: {p[0] if p else '?'})"))
    else:
        b.avert(T("pas de service de profils d'énergie (Performance / Équilibré / Économie)",
                  "no power profile service (Performance / Balanced / Power Saver)"),
                T("relance install.sh (TLP + tlp-pd, ou power-profiles-daemon / tuned-ppd)",
                  "run install.sh again (TLP + tlp-pd, or power-profiles-daemon / tuned-ppd)"), cle="profils_energie")
    bats = [d for d in os.listdir("/sys/class/power_supply") if d.startswith("BAT")] if os.path.isdir("/sys/class/power_supply") else []
    if bats:
        v, _ = sortie([os.path.join(BIN, "nc-sysinfo"), "sante"])
        if v:
            sante, _, cycles = v.partition("\t")
            b.ok(T(f"batterie : santé {sante} %", f"battery: health {sante}%") + (f", {cycles} cycles" if cycles else ""))
        rb = [d for d in os.listdir("/sys/class/backlight")] if os.path.isdir("/sys/class/backlight") else []
        if not rb:
            b.avert(T("aucun rétroéclairage : les touches de luminosité ne feront rien",
                      "no backlight: the brightness keys will do nothing"),
                    T("écran externe seul, ou pilote graphique pas encore chargé",
                      "external screen only, or graphics driver not loaded yet"), cle="retroeclairage")
        energie_processeur(b, bats)

    if not RAPIDE:
        rtx(b)

    # ── Partage d'écran et applis Electron (Discord, VS Code…) : portails ──
    b.titre(T("Partage d'écran (Discord, navigateur…)", "Screen sharing (Discord, browser…)"))
    actif, _ = sortie(["systemctl", "--user", "is-active", "xdg-desktop-portal-hyprland"])
    if actif.strip() == "active":
        b.ok(T("portail de Hyprland actif (capture de l'écran)", "Hyprland portal active (screen capture)"))
    else:
        b.faux(T("portail de Hyprland arrêté : le partage d'écran sera noir",
                 "Hyprland portal stopped: screen sharing will be black"),
               T("installe xdg-desktop-portal-hyprland (nc-maj), puis déconnecte-toi et reconnecte-toi",
                 "install xdg-desktop-portal-hyprland (nc-update), then log out and back in"),
               cle="portail_arrete", reparations=proposer("xdg-desktop-portal-hyprland.service", actif.strip()))
    conf = os.path.join(HOME, ".config/xdg-desktop-portal/hyprland-portals.conf")
    autres = [n for n, f in (("GNOME", "gnome-portals.conf"), ("KDE", "kde-portals.conf"))
              if os.path.exists("/usr/share/xdg-desktop-portal/" + f)]
    if os.path.exists(conf) and "ScreenCast=hyprland" in open(conf, encoding="utf-8").read():
        b.ok(T("portails choisis pour Hyprland", "portals set for Hyprland")
             + (T(f" (celui de {', '.join(autres)} écarté)", f" ({', '.join(autres)} one left out)") if autres else ""))
    elif autres:
        b.faux(T(f"le portail de {', '.join(autres)} peut être pris : applis Electron lentes à démarrer, partage d'écran noir",
                 f"the {', '.join(autres)} portal may be used: Electron apps slow to start, black screen sharing"),
               T("nc-maj (installe ~/.config/xdg-desktop-portal/hyprland-portals.conf), puis déconnecte-toi",
                 "nc-update (installs ~/.config/xdg-desktop-portal/hyprland-portals.conf), then log out"),
               cle="portail_concurrent")
    else:
        b.avert(T("portails non choisis explicitement", "portals not set explicitly"), T("nc-maj", "nc-update"),
                cle="portails_non_choisis")
    if not a("hyprland-share-picker"):
        b.avert(T("hyprland-share-picker absent : pas de choix de l'écran ou de la fenêtre à partager",
                  "hyprland-share-picker missing: no way to choose the screen or window to share"),
                T("il vient avec xdg-desktop-portal-hyprland (ou hyprland-qtutils selon la distribution)",
                  "it comes with xdg-desktop-portal-hyprland (or hyprland-qtutils depending on the distribution)"),
                cle="share_picker_absent")
    attente, _ = sortie(["sh", "-c", "s=$(date +%s%N); busctl --user call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop "
                        "org.freedesktop.portal.Settings ReadOne ss org.freedesktop.appearance color-scheme >/dev/null 2>&1; "
                        "echo $(( ($(date +%s%N) - s) / 1000000 ))"], 30, plafond=5)
    if attente.strip().isdigit() and int(attente) > 2000:
        b.faux(T(f"le portail répond en {int(attente) / 1000:.0f} s : les applis Electron (Discord…) démarrent lentement",
                 f"the portal answers in {int(attente) / 1000:.0f} s: Electron apps (Discord…) start slowly"),
               T("nc-maj, puis déconnecte-toi et reconnecte-toi", "nc-update, then log out and back in"), cle="portail_lent")

    # ── Wi-Fi : veille entre deux paquets (messages en retard, voix des autres coupée en appel) ──
    b.titre("Wi-Fi")
    for carte in [x for x in (os.listdir("/sys/class/net") if os.path.isdir("/sys/class/net") else []) if x.startswith("wl")]:
        ps_, _ = sortie(["iw", "dev", carte, "get", "power_save"])
        if "Power save: on" in ps_:
            b.avert(T(f"Wi-Fi ({carte}) en veille entre deux paquets : messages en retard, voix des autres coupée en appel",
                      f"Wi-Fi ({carte}) sleeps between packets: late messages, other people's voices cut out in calls"),
                    T("nc-maj (désactive cette veille), ou tout de suite : sudo iw dev ",
                      "nc-update (turns this power saving off), or right now: sudo iw dev ") + carte + " set power_save off",
                    cle="wifi_veille:" + carte)
        elif "Power save: off" in ps_:
            b.ok(T(f"Wi-Fi ({carte}) réactif (pas de veille entre deux paquets)",
                   f"Wi-Fi ({carte}) responsive (no sleep between packets)"))

    bluetooth_appel(b)

    # ── Outils ──
    b.titre(T("Outils utilisés par la config", "Tools used by the config"))
    outils = {
        "kitty": "terminal", "jq": "scripts", "brightnessctl": T("luminosité", "brightness"), "playerctl": T("musique", "music"),
        "wpctl": "volume", "grim": T("captures", "screenshots"), "slurp": T("captures de zone", "area screenshots"),
        "wl-copy": T("presse-papiers", "clipboard"), "notify-send": "notifications", "cava": T("halo musical", "music glow"),
        "qalc": T("calculs du Spotlight", "Spotlight calculations"), "swappy": T("annoter les captures", "annotate screenshots"),
        "wf-recorder": T("vidéos de l'écran", "screen recordings"), "tesseract": T("copier le texte d'une capture", "copy text from a screenshot"),
        "fastfetch": T("accueil du terminal", "terminal greeting"), "magick": T("fonds d'écran", "wallpapers"),
    }
    if not RAPIDE:
        outils_polices(b, outils)

    # ── Intelligence artificielle (nc-ia) : sans réseau, sans clé affichée ──
    b.titre(T("Intelligence artificielle", "Artificial intelligence"))
    ia, _ = sortie([os.path.join(HOME, ".local/bin/nc-ia"), "etat", "--json"])
    try:
        e = json.loads(ia)
        dispo = [i["nom"] for i in e["ias"] if i["disponible"]]
        if e["coupee"]:
            b.ok(T("IA coupée partout (choisi dans nc-reglages)", "AI turned off everywhere (chosen in nc-settings)"))
        elif not dispo:
            b.avert(T("aucune IA disponible : Spotlight « ? », texte, terminal et captures sans réponse",
                      "no AI available: Spotlight “?”, text, terminal and screenshots get no answer"),
                    T("nc-ia configurer (une clé d'API), ou installe Claude Code, Codex, Gemini CLI, OpenCode ou Ollama",
                      "nc-ai configure (an API key), or install Claude Code, Codex, Gemini CLI, OpenCode or Ollama"), cle="ia_aucune")
        else:
            q = e["usages"]["question"]["nom"]
            b.ok(T(f"{q} répond ({len(dispo)} disponible(s) : {', '.join(dispo[:5])})",
                   f"{q} answers ({len(dispo)} available: {', '.join(dispo[:5])})"))
            if e["mode"] == "manuel" and not q:
                b.avert(T("l'IA choisie à la main n'est pas disponible", "the AI chosen manually is not available"),
                        T("nc-reglages → Intelligence artificielle", "nc-settings → Artificial intelligence"), cle="ia_manuelle_absente")
            if not e["usages"]["image"]["nom"]:
                b.avert(T("aucune IA disponible ne lit les images (Super + Maj + I)", "no available AI reads images (Super + Shift + I)"),
                        T("une clé Anthropic, OpenAI ou Gemini, Claude Code, Codex ou Ollama", "an Anthropic, OpenAI or Gemini key, Claude Code, Codex or Ollama"),
                        cle="ia_images")
        conf = os.path.join(HOME, ".config/nc/ia.conf")
        if os.path.exists(conf) and os.stat(conf).st_mode & 0o077:
            b.faux(T("~/.config/nc/ia.conf lisible par d'autres comptes (clés d'API)", "~/.config/nc/ia.conf readable by other accounts (API keys)"),
                   "chmod 600 ~/.config/nc/ia.conf", cle="ia_conf_lisible", reparations=["ia_conf_prive"])
    except (ValueError, KeyError, TypeError):
        b.avert(T("nc-ia ne répond pas", "nc-ai does not respond"), T("nc-maj", "nc-update"), cle="ia_muette")
    # Dictée (Super + D) : un enregistreur, et de quoi écrire dans la fenêtre (revue DIST-01)
    try:
        dictee = "IA_DICTEE=non" not in open(os.path.join(HOME, ".config/nc/reglages.conf"), encoding="utf-8").read().replace('"', "")
    except OSError:
        dictee = True
    if dictee:
        enr = next((x for x in ("parec", "pw-record", "arecord") if a(x)), "")
        ecrit = "wtype" if a("wtype") else ("wl-copy" if a("wl-copy") else "")
        if not enr:
            b.avert(T("dictée impossible : aucun enregistreur audio (pw-record, parec ou arecord)",
                      "dictation impossible: no audio recorder (pw-record, parec or arecord)"),
                    T("relance install.sh (paquet pipewire-audio, pipewire-utils, pipewire-bin ou pipewire-tools selon ta distribution)",
                      "run install.sh again (package pipewire-audio, pipewire-utils, pipewire-bin or pipewire-tools depending on your distribution)"),
                    cle="dictee_enregistreur")
        elif not ecrit:
            b.avert(T("dictée : rien pour écrire le texte (ni wtype, ni wl-copy)", "dictation: nothing to type the text (neither wtype nor wl-copy)"),
                    T("relance install.sh (wtype, wl-clipboard)", "run install.sh again (wtype, wl-clipboard)"), cle="dictee_ecriture")
        else:
            b.ok(T(f"dictée : {enr}, texte {'tapé (wtype)' if ecrit == 'wtype' else 'collé (wl-copy)'}",
                   f"dictation: {enr}, text {'typed (wtype)' if ecrit == 'wtype' else 'pasted (wl-copy)'}"))

    # ── Tes réglages ──
    b.titre(T("Tes réglages", "Your settings"))
    conf = os.path.join(HOME, ".config/nc/reglages.conf")
    n = 0
    if os.path.exists(conf):
        n = sum(1 for l in open(conf) if re.match(r"\s*[A-Z0-9_]+=", l))
    style = ""
    try:
        style = next((l.split("=", 1)[1].strip() for l in open(os.path.join(HOME, ".config/nc/style.conf")) if l.startswith("STYLE=")), "")
    except OSError:
        pass
    b.ok(T(f"{n} réglage(s) changé(s) dans nc-reglages", f"{n} setting(s) changed in nc-settings")
         + (f" · style {style}" if style and style != "noctalia" else ""))
    rac = os.path.join(HOME, ".config/nc/raccourcis.conf")
    if os.path.exists(rac):
        k = sum(1 for l in open(rac) if l.strip() and not l.startswith("#"))
        b.ok(T(f"{k} raccourci(s) personnalisé(s)", f"{k} custom shortcut(s)"))


def bt_cartes():
    """{carte: (profil actif, [profils])} des cartes bluez (nom valide) vues par pactl ; vide si pactl -f json manque."""
    out, code = sortie(["pactl", "-f", "json", "list", "cards"])
    if code:
        return {}
    try:
        liste = json.loads(out)
    except ValueError:
        return {}
    res = {}
    for c in liste if isinstance(liste, list) else []:
        nom = c.get("name") if isinstance(c, dict) else None
        if isinstance(nom, str) and re.fullmatch(r"bluez_card\.[0-9A-F_]{17}", nom):
            profils = c.get("profiles")
            res[nom] = (c.get("active_profile") if isinstance(c.get("active_profile"), str) else "",
                        sorted(p for p in profils if isinstance(p, str)) if isinstance(profils, dict) else [])
    return res


def bt_meilleur_a2dp(profils):
    return next((p for p in BT_A2DP if p in profils), None)


def bt_appel_en_cours(carte):
    """True/False selon nc-bt-appel (une appli enregistre sur le micro du casque) ; None si on ne sait pas."""
    code = sortie([os.path.join(BIN, "nc-bt-appel"), "appel", carte])[1]
    return {0: True, 1: False}.get(code)


def bluetooth_appel(b):
    """Micro du casque Bluetooth en mode appel : son réduit (CVSD) alors que mSBC est proposé ; conseil MediaTek."""
    if not glob.glob(os.path.join(SYS, "class/bluetooth/hci*")):
        return
    b.titre("Bluetooth")
    for carte, (actif, profils) in sorted(bt_cartes().items()):
        if actif != BT_PROFIL_CVSD or BT_PROFIL_APPEL not in profils:
            continue
        reps = ["bt_reconnecter:" + carte]
        if bt_meilleur_a2dp(profils) and bt_appel_en_cours(carte) is False:
            reps.append("bt_musique:" + carte)
        b.avert(T("micro du casque en mode appel : son réduit", "headset microphone in call mode: reduced sound"),
                T("Deux choix. 1) Refaire la connexion Bluetooth (réparation proposée) : le micro retrouve sa qualité, "
                  "l'appel est coupé quelques secondes. 2) Passer le casque en qualité musique et utiliser le micro du PC pour les "
                  "appels (réparation proposée ; nc-reglages → Son, « passer en mode appel tout seul » = non, pour que ça dure). "
                  "Sinon, tu peux rester ainsi : le son réduit marche toujours.",
                  "Two choices. 1) Redo the Bluetooth connection (repair offered): the microphone gets its quality back, the call "
                  "drops for a few seconds. 2) Put the headset in music quality and use the PC microphone for calls (repair "
                  "offered; nc-settings → Sound, “switch to call mode by itself” = no, to make it last). Or stay as is: the "
                  "reduced sound always works."),
                cle="bt_cvsd:" + carte, reparations=reps)
    # Adaptateur MediaTek (USB 0e8d) avec l'économie d'énergie de btusb : coupe souvent le son des appels. Conseil seulement.
    try:
        mediatek = any(open(f).read().strip().lower() == "0e8d"
                       for f in glob.glob(os.path.join(SYS, "bus/usb/devices/*/idVendor")))
        auto = open(os.path.join(SYS, "module/btusb/parameters/enable_autosuspend")).read().strip()
    except OSError:
        return
    if mediatek and auto == "Y":
        b.avert(T("adaptateur Bluetooth MediaTek : l'économie d'énergie de l'adaptateur coupe souvent le son des appels",
                  "MediaTek Bluetooth adapter: the adapter's power saving often cuts the sound of calls"),
                T("pour l'éviter : echo 'options btusb enable_autosuspend=n' | sudo tee /etc/modprobe.d/nc-btusb.conf "
                  "puis redémarrer (jamais appliqué tout seul)",
                  "to avoid it: echo 'options btusb enable_autosuspend=n' | sudo tee /etc/modprobe.d/nc-btusb.conf "
                  "then reboot (never applied automatically)"),
                cle="bt_mediatek_autosuspend")


def outils_polices(b, outils):
    """Outils absents, police Nerd Font, Neovim et npm : sautés par « --rapide » (rien d'urgent, et fc-list est lent)."""
    manquants = [f"{c} ({r})" for c, r in outils.items() if not a(c) and not (c == "magick" and a("convert"))]   # ImageMagick 6 : convert
    if manquants:
        b.avert(T("absents : ", "missing: ") + ", ".join(manquants),
                T("relance install.sh, ou installe-les avec ton gestionnaire de paquets",
                  "run install.sh again, or install them with your package manager"), cle="outils_absents")
    else:
        b.ok(T("tous présents", "all present"))
    polices, _ = sortie(["fc-list", ":", "family"])
    if "Nerd Font" not in polices:
        b.avert(T("aucune police « Nerd Font » : icônes du terminal en carrés", "no “Nerd Font” font: terminal icons show as squares"),
                T("relance install.sh (étape du terminal)", "run install.sh again (terminal step)"), cle="nerd_font_absente")
    neovim(b)
    npm_node(b)


def dossiers_xdg(b):
    """XDG_CONFIG_HOME ou XDG_STATE_HOME (et NOCTALIA_CONFIG_HOME, NOCTALIA_STATE_HOME, lues avant) ailleurs que ~/.config
    et ~/.local/state : Noctalia (src/util/file_utils.h), Hyprland et l'île lisent leurs réglages là, mais install.sh
    copie tout sous ~/.config et ~/.local/state. Pas pris en charge : avertissement. Vide ou absent : rien à dire (comme Noctalia) ; ~ développé, barre finale ignorée."""
    home = os.path.expanduser("~")
    for cle, defaut, lecteurs, lecteurs_en in (
            ("XDG_CONFIG_HOME", ".config", "Noctalia, Hyprland et l'île ne liront pas", "Noctalia, Hyprland and the island won't read"),
            ("XDG_STATE_HOME", ".local/state", "Noctalia ne lira pas", "Noctalia won't read"),
            # Lues par Noctalia avant XDG_* : le même cas
            ("NOCTALIA_CONFIG_HOME", ".config", "Noctalia ne lira pas", "Noctalia won't read"),
            ("NOCTALIA_STATE_HOME", ".local/state", "Noctalia ne lira pas", "Noctalia won't read")):
        v = os.environ.get(cle, "")
        if v and os.path.realpath(os.path.expanduser(v)) != os.path.realpath(os.path.join(home, defaut)):
            b.avert(T(f"{cle} pointe ailleurs ({v}) : noctalia-config s'installe dans ~/{defaut}, que {lecteurs} ; "
                      "ce cas n'est pas pris en charge",
                      f"{cle} points elsewhere ({v}): noctalia-config installs into ~/{defaut}, which {lecteurs_en}; "
                      "this setup is not supported"),
                    T(f"retire {cle} de ton environnement (ou mets-le à ~/{defaut}), puis ouvre une nouvelle session",
                      f"remove {cle} from your environment (or set it to ~/{defaut}), then log in again"),
                    cle=cle.lower() + "_ailleurs")


NVIM_MIN = (0, 11, 2)   # LazyVim (config Neovim du dépôt) ; Debian 13 n'a que la 0.10


def neovim(b):
    """Le Neovim du PATH (celui du terminal) trop ancien pour la config : avertissement. Absent : rien à dire."""
    nvim = shutil.which("nvim")
    if not nvim:
        return
    v, _ = sortie([nvim, "--version"])
    m = re.search(r"NVIM v?(\d+)\.(\d+)\.(\d+)", v)
    if not m:
        return
    ver = tuple(int(x) for x in m.groups())
    if ver < NVIM_MIN:
        a_, b_ = ".".join(map(str, ver)), ".".join(map(str, NVIM_MIN))
        b.avert(T(f"Neovim trop ancien pour la config ({a_} < {b_})", f"Neovim too old for the config ({a_} < {b_})"),
                T("relance install.sh, qui propose la version officielle", "run install.sh again; it offers the official release"),
                cle="neovim_ancien")


# Versions de Node que demande npm 12 (champ « engines » de npm 12.2.1) : sert si celui du npm installé est illisible
NPM12_NODE = "^22.22.2 || ^24.15.0 || >=26.0.0"
# CLI d'IA installées par npm : elles se mettent à jour seules par « npm install -g »
NPM_IAS = ("@openai/codex", "@google/gemini-cli", "@anthropic-ai/claude-code", "opencode-ai")
NPM_IAS_PROGS = ("codex", "gemini", "claude", "opencode")


def _version(texte):
    m = re.search(r"(\d+)(?:\.(\d+))?(?:\.(\d+))?", texte or "")
    return tuple(int(x or 0) for x in m.groups()) if m else None


def _satisfait(version, plage):
    """Plage semver simple (« ^22.22.2 || >=26 », ~, >, <, =) : vrai, faux, ou None si elle n'est pas lisible."""
    for alt in plage.split("||"):
        tous = True
        for c in alt.split():
            m = re.fullmatch(r"(\^|~|>=|<=|>|<|=)?v?(\d+)(?:\.(\d+|x|\*))?(?:\.(\d+|x|\*))?(?:-[0-9A-Za-z.]+)?", c)
            if not m:
                return None
            op, maj = m[1] or "", int(m[2])
            mi = int(m[3]) if m[3] and m[3].isdigit() else None
            pa = int(m[4]) if m[4] and m[4].isdigit() else None
            base = (maj, mi or 0, pa or 0)
            if op == "^":
                haut = (maj + 1, 0, 0) if maj or mi is None else (0, mi + 1, 0)
                ok = base <= version < haut
            elif op == "~":
                ok = base <= version < ((maj, mi + 1, 0) if mi is not None else (maj + 1, 0, 0))
            elif op in (">=", ">", "<=", "<"):
                ok = {">=": version >= base, ">": version > base, "<=": version <= base, "<": version < base}[op]
            else:
                n = 1 if mi is None else (2 if pa is None else 3)
                ok = version[:n] == base[:n]
            tous = tous and ok
        if tous:
            return True
    return False


def _ecrivable(chemin):
    while not os.path.exists(chemin) and os.path.dirname(chemin) != chemin:
        chemin = os.path.dirname(chemin)
    return os.access(chemin, os.W_OK)


def _paquet_proprio(chemin):
    """Le paquet de la distribution qui possède ce dossier ; vide s'il vient de « sudo npm install -g »."""
    for cmd in (["pacman", "-Qqo", chemin], ["dpkg-query", "-S", chemin], ["rpm", "-qf", "--qf", "%{NAME}\n", chemin]):
        if a(cmd[0]):
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                continue
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip().splitlines()[0].split(":")[0]
    return ""


def npm_node(b):
    """npm 12 sur un Node trop ancien, et les CLI d'IA de npm qui ne peuvent pas se mettre à jour seules (installées avec
    sudo dans /usr ou /usr/local). Sans npm, ou quand tout va bien : rien à dire."""
    npm = shutil.which("npm")
    if not npm:
        return
    # Version de npm et Node qu'il demande : dans son package.json (sans lancer npm), sinon « npm --version »
    npmv, plage = None, ""
    d = os.path.dirname(os.path.realpath(npm))
    for _ in range(4):
        try:
            with open(os.path.join(d, "package.json"), encoding="utf-8") as f:
                p = json.load(f)
            if p.get("name") == "npm":
                npmv, plage = _version(p.get("version")), str((p.get("engines") or {}).get("node") or "")
                break
        except (OSError, ValueError, AttributeError):
            pass
        d = os.path.dirname(d)
    if not npmv:
        v, _ = sortie([npm, "--version"], 10)   # la ligne de la version seule : un npm mal assorti avertit en plus
        m = re.search(r"^v?\d+\.\d+\.\d+\s*$", v, re.M)
        npmv = _version(m[0]) if m else None
    nodev = _version(sortie(["node", "--version"])[0]) if a("node") else None
    if npmv and nodev and npmv[0] >= 12:
        ok = _satisfait(nodev, plage) if plage else None
        if ok is None:
            plage, ok = NPM12_NODE, _satisfait(nodev, NPM12_NODE)
        if not ok:
            nv, pv = ".".join(map(str, nodev)), ".".join(map(str, npmv))
            b.avert(T(f"npm récent, mais Node trop ancien : mets Node à jour (npm {pv} demande Node {plage}, Node {nv} installé)",
                      f"recent npm, but Node too old: update Node (npm {pv} needs Node {plage}, Node {nv} installed)"),
                    T("paquet nodejs de ta distribution (Fedora : nodejs24) ou nodejs.org ; sinon, un npm fait pour ce Node",
                      "your distribution's nodejs package (Fedora: nodejs24) or nodejs.org; otherwise, an npm made for this Node"),
                    cle="npm_node_ancien")
    # CLI d'IA du PATH dans un préfixe de npm où l'on ne peut pas écrire (hors paquet de la distribution)
    vues = set()
    for prog in NPM_IAS_PROGS:
        chemin = shutil.which(prog)
        if not chemin:
            continue
        reel = os.path.realpath(chemin)
        m = re.match(r"(.+)/lib/node_modules/((?:@[^/]+/)?[^/]+)/", reel)
        if not m or m[2] not in NPM_IAS or m[2] in vues:
            continue
        pref, paquet = m[1], m[2]
        vues.add(paquet)
        if _ecrivable(os.path.join(pref, "lib/node_modules")) and _ecrivable(os.path.join(pref, "bin")):
            continue
        if _paquet_proprio(os.path.join(pref, "lib/node_modules", paquet)):
            continue   # paquet de la distribution : mis à jour avec le système
        b.avert(T(f"la CLI {prog} ({paquet}) est dans {pref}, où tu ne peux pas écrire : elle ne pourra pas se mettre à jour seule",
                  f"the {prog} CLI ({paquet}) is in {pref}, where you can't write: it won't be able to update itself"),
                T(f"npm config set prefix ~/.local ; npm install -g {paquet} ; puis, quand tu veux : "
                  f"sudo npm uninstall -g --prefix {pref} {paquet} (install.sh le propose)",
                  f"npm config set prefix ~/.local; npm install -g {paquet}; then, whenever you like: "
                  f"sudo npm uninstall -g --prefix {pref} {paquet} (install.sh offers it)"), cle="npm_bloque:" + paquet)


def energie_processeur(b, bats):
    """EPP du processeur et politique ASPM (PCIe) : sur batterie, balance_performance coûte 2 à 3 W pour rien (mesuré)."""
    def lire(f):
        try:
            return open(f).read().strip()
        except OSError:
            return ""
    epp = lire("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
    aspm = re.search(r"\[(\w+)\]", lire("/sys/module/pcie_aspm/parameters/policy"))
    aspm = aspm.group(1) if aspm else ""
    if not epp and not aspm:
        return
    secteur = any(lire(f"/sys/class/power_supply/{d}/online") == "1" for d in os.listdir("/sys/class/power_supply")
                  if lire(f"/sys/class/power_supply/{d}/type") in ("Mains", "USB", "USB_C"))
    texte = T(f"processeur : EPP {epp or '?'}, PCIe (ASPM) : {aspm or '?'}", f"processor: EPP {epp or '?'}, PCIe (ASPM): {aspm or '?'}")
    if bats and not secteur and epp == "balance_performance":
        b.avert(texte, T("sur batterie, CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power dans /etc/tlp.d économise 2 à 3 W",
                         "on battery, CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power in /etc/tlp.d saves 2 to 3 W"), cle="epp_batterie")
    else:
        b.ok(texte)


def rtx(b):
    """Section « RTX », sur un PC hybride seulement : la NVIDIA dort-elle (0 W) quand rien ne s'en sert ? L'état vient de
    nc-rtx-veille (lu dans /sys et /proc, sans réveiller la carte ; nvidia-smi seulement si elle est déjà allumée)."""
    voisin = os.path.join(os.path.dirname(os.path.realpath(__file__)), "nc-rtx-veille")
    v, _ = sortie([voisin if os.path.exists(voisin) else os.path.join(BIN, "nc-rtx-veille"), "etat", "--conso"], 20)
    try:
        e = json.loads(v)
    except ValueError:
        return
    if not e.get("hybride"):
        return
    b.titre("RTX")
    if e["mode"] == "dediee":
        b.ok(T("mode Dédiée : la carte NVIDIA porte l'écran interne, elle reste allumée",
               "Discrete mode: the NVIDIA GPU drives the built-in display, it stays on"))
        return
    cles = {c["cle"] for c in e["causes"]}
    dit = cles if e["runtime_status"] == "active" and e["doit_dormir"] else set()   # causes déjà dites en tête
    quoi_control = T(f"pour essayer : echo auto | sudo tee /sys/bus/pci/devices/{e['bus']}/power/control ; pour de bon, la règle "
                     "udev de la documentation NVIDIA (Dynamic Power Management)",
                     f"to try: echo auto | sudo tee /sys/bus/pci/devices/{e['bus']}/power/control; for good, the udev rule from "
                     "the NVIDIA documentation (Dynamic Power Management)")
    apps = ", ".join(f"{p['nom']} ({p['pid']})" for p in e["processus"])
    conso = f" · {e['conso']}" if e.get("conso") else ""
    etat = e["runtime_status"]
    if etat == "suspended":
        b.ok(T("carte NVIDIA endormie (0 W)", "NVIDIA GPU asleep (0 W)")
             + (T(f" ; ouverte par {apps}, sans la réveiller", f"; opened by {apps}, without waking it") if apps else ""))
    elif etat == "active" and e["doit_dormir"]:
        quoi = {"persistenced": T("sudo systemctl disable --now nvidia-persistenced (install.sh le propose)",
                                  "sudo systemctl disable --now nvidia-persistenced (install.sh offers it)"),
                "control": quoi_control,
                "inconnue": T("attends 30 s : elle s'endort parfois un peu après la dernière appli ; si ça reste, nc-diag rapport",
                              "wait 30 s: it sometimes sleeps a little after the last app; if it persists, nc-diag report")}
        c = e["causes"][0] if e["causes"] else {"cle": "inconnue", "texte": ""}
        b.avert(T("carte NVIDIA allumée alors qu'elle devrait dormir", "NVIDIA GPU on while it should be asleep") + conso
                + " : " + T(" ; ", "; ").join(x["texte"] for x in e["causes"]),
                quoi.get(c["cle"], T(f"relance {c.get('nom', '')} sur la carte intégrée (la notification le propose), ou ferme-le",
                                     f"restart {c.get('nom', '')} on the integrated GPU (the notification offers it), or close it")),
                cle="rtx_allumee")
    elif etat == "active":
        b.ok(T("carte NVIDIA allumée", "NVIDIA GPU on") + conso
             + (T(f" (Performance ou secteur) ; utilisée par {apps}", f" (Performance or plugged in); used by {apps}") if apps
                else T(" (Performance ou secteur)", " (Performance or plugged in)")))
    elif etat in ("suspending", "resuming"):
        b.ok(T(f"carte NVIDIA en train de changer d'état ({etat})", f"NVIDIA GPU changing state ({etat})"))
    else:
        b.avert(T(f"état de veille de la carte NVIDIA : {etat or 'illisible'}", f"NVIDIA GPU sleep state: {etat or 'unreadable'}"),
                T("le pilote ne gère pas la mise en veille de la carte (voir DynamicPowerManagement ci-dessous)",
                  "the driver doesn't handle putting the GPU to sleep (see DynamicPowerManagement below)"), cle="rtx_etat")
    # nvidia-persistenced (paquets NVIDIA d'Arch, Fedora, Debian) : la carte reste initialisée, donc allumée
    if not e["persistenced"]:
        b.ok(T("nvidia-persistenced arrêté", "nvidia-persistenced stopped"))
    elif "persistenced" in dit:
        pass
    elif e["portable"]:
        b.avert(T("nvidia-persistenced actif : la carte NVIDIA ne s'endort jamais (environ 5 W)",
                  "nvidia-persistenced running: the NVIDIA GPU never sleeps (about 5 W)"),
                T("sudo systemctl disable --now nvidia-persistenced (install.sh le propose)",
                  "sudo systemctl disable --now nvidia-persistenced (install.sh offers it)"), cle="rtx_persistenced")
    else:
        b.ok(T("nvidia-persistenced actif (PC fixe)", "nvidia-persistenced running (desktop PC)"))
    # power/control : « auto » laisse le noyau endormir la carte
    if e["control"] == "auto":
        b.ok(T("mise en veille par le noyau permise (power/control = auto)", "kernel sleep allowed (power/control = auto)"))
    elif e["control"] and "control" not in dit:
        b.avert(T(f"le noyau ne peut pas endormir la carte NVIDIA (power/control = {e['control']})",
                  f"the kernel can't put the NVIDIA GPU to sleep (power/control = {e['control']})"), quoi_control, cle="rtx_control")
    # DynamicPowerManagement du pilote NVIDIA : 2 ou 3 (défaut des cartes récentes) endorment la carte
    dpm = e["dynamic_pm"]
    if dpm is None:
        b.ok(T(f"pilote {e['pilote'] or '?'} : pas de /proc/driver/nvidia (réglage DynamicPowerManagement sans objet)",
               f"{e['pilote'] or '?'} driver: no /proc/driver/nvidia (DynamicPowerManagement setting not applicable)"))
    elif dpm in ("2", "3", "0x02", "0x03"):
        b.ok(f"DynamicPowerManagement = {dpm}")
    else:
        b.avert(T(f"DynamicPowerManagement = {dpm or '?'} : le pilote NVIDIA n'endort pas la carte",
                  f"DynamicPowerManagement = {dpm or '?'}: the NVIDIA driver doesn't put the GPU to sleep"),
                T("options nvidia NVreg_DynamicPowerManagement=0x02 dans /etc/modprobe.d/nvidia.conf, puis redémarrer",
                  "options nvidia NVreg_DynamicPowerManagement=0x02 in /etc/modprobe.d/nvidia.conf, then restart"), cle="rtx_dpm")


def details():
    """En plus dans « nc-diag rapport » : ce qui aide à comprendre un souci à distance. Rien de personnel (ni mot de
    passe, ni nom de réseau, ni fichier)."""
    l = ["", T("Détails (pour aider)", "Details (to help)")]

    def lire(f):
        try:
            return open(f, encoding="utf-8", errors="ignore").read().strip()
        except OSError:
            return ""
    dmi = "/sys/class/dmi/id/"
    l.append(T("  PC : ", "  PC: ") + " ".join(x for x in (lire(dmi + "sys_vendor"), lire(dmi + "product_version"), lire(dmi + "product_name")) if x))
    gpu, _ = sortie(["sh", "-c", "lspci 2>/dev/null | grep -iE 'vga|3d|display' | sed 's/^[^ ]* //'"])
    for g in gpu.splitlines():
        l.append(T("  carte graphique : ", "  graphics card: ") + g)
    try:
        for m in json.loads(sortie(["hyprctl", "monitors", "all", "-j"])[0] or "[]"):
            l.append(T(f"  écran {m['name']} : {m['width']}x{m['height']} à {round(m.get('refreshRate', 0))} Hz, échelle {m.get('scale')}",
                       f"  screen {m['name']}: {m['width']}x{m['height']} at {round(m.get('refreshRate', 0))} Hz, scale {m.get('scale')}")
                     + (T(" (éteint)", " (off)") if m.get("disabled") else ""))
    except ValueError:
        pass
    leds = [x for x in os.listdir("/sys/class/leds") if "kbd" in x] if os.path.isdir("/sys/class/leds") else []
    l.append(T("  éclairage du clavier : ", "  keyboard backlight: ")
             + (", ".join(leds) if leds else T("aucun réglable par Linux", "none that Linux can control")))
    noms = re.findall(r'N: Name="([^"]+)"', lire("/proc/bus/input/devices"))
    pointeurs = [n for n in noms if re.search(r"mouse|souris|touchpad|trackpad|pointer", n, re.I)]
    l.append(T("  souris / pavé : ", "  mouse / touchpad: ") + (", ".join(dict.fromkeys(pointeurs)) or T("rien de reconnu", "nothing recognized")))
    wifi, _ = sortie(["nmcli", "-t", "-f", "TYPE,STATE", "device"])
    etats = [x.split(":", 1)[1] for x in wifi.splitlines() if x.startswith("wifi:")]
    l.append(T("  Wi-Fi : ", "  Wi-Fi: ") + (", ".join(etats) if etats else T("pas de carte Wi-Fi vue par NetworkManager",
                                                                              "no Wi-Fi card seen by NetworkManager")))
    conf = os.path.join(HOME, ".config/nc/reglages.conf")
    changes = [x.strip() for x in lire(conf).splitlines() if "=" in x and not x.startswith("#") and not x.startswith("METEO_VILLE")]
    if changes:
        l.append(T("  réglages changés : ", "  changed settings: ") + ", ".join(changes))
    if a("nc-claude"):
        ias, _ = sortie([os.path.join(BIN, "nc-claude"), "diag"], 10)
        # La ligne de l'île (nc-ile.service) mise à part : seulement les IA
        branches = [x.strip()[2:] for x in ias.splitlines() if x.strip().startswith(("✓", "✗"))
                    and "île" not in x and "nc-ile.service" not in x]
        if branches:
            l.append(T("  IA : ", "  AI: ") + T(" ; ", "; ").join(branches))
    # Plantages de l'île ou de la barre (même si elle ne tourne plus) : ce que systemd et coredumpctl en ont gardé
    plant, _ = sortie(["sh", "-c", "journalctl --user -u nc-ile.service -u noctalia.service -n 400 -o cat --no-pager 2>/dev/null "
                       "| grep -iE 'segmentation|core dumped|abort|fatal|crash|failed with result|qt\\.qml.*error' | tail -6"])
    for x in plant.splitlines():
        l.append(T("  plantage : ", "  crash: ") + x.strip()[:200])
    # Message de PipeWire juste avant le plantage (Quickshell réinitialise sa connexion au son sur toute erreur)
    pw, _ = sortie(["sh", "-c", "d=$(ls -td \"$HOME\"/.cache/quickshell/crashes/*/ 2>/dev/null | head -1); [ -n \"$d\" ] && "
                    "grep -ahiE 'pipewire error|error on object|fatal' \"$d\"log.qslog.log 2>/dev/null | tail -3"])
    for x in pw.splitlines():
        l.append(T("  juste avant : ", "  just before: ") + re.sub(r"\x1b\[[0-9;]*m", "", x).strip()[:200])
    pwj, _ = sortie(["sh", "-c", "journalctl --user -u pipewire -u wireplumber -u pipewire-pulse -p warning -n 300 -o cat --no-pager "
                     "2>/dev/null | grep -viE 'rtkit|realtime' | tail -4"])
    for x in pwj.splitlines():
        l.append(T("  son (PipeWire) : ", "  sound (PipeWire): ") + x.strip()[:200])
    cores, _ = sortie(["sh", "-c", "coredumpctl list --no-pager --no-legend 2>/dev/null | grep -E '/(qs|quickshell|noctalia)( |$)' | tail -3"])
    for x in cores.splitlines():
        l.append(T("  plantage enregistré : ", "  recorded crash: ") + " ".join(x.split()[:2] + x.split()[-3:]))
    # Restes de GNOME (ou KDE) qui tournent encore dans la session Hyprland : ils peuvent ralentir ou gêner
    ps, _ = sortie(["ps", "-u", str(os.getuid()), "-o", "comm="])
    restes = sorted({c for c in ps.split() if re.match(r"^(gnome-shell|gsd-|gnome-software|evolution-|tracker-miner|localsearch|"
                                                       r"xdg-desktop-por.*gnome|xdg-desktop-por.*kde|ibus-daemon|kded|plasmashell|baloo)", c)})
    if restes:
        l.append(T("  bureau d'avant qui tourne encore : ", "  previous desktop still running: ") + ", ".join(restes))
    # Dernières erreurs : île, barre, Hyprland
    err, _ = sortie(["sh", "-c", "qs -c nc-ile log 2>/dev/null | grep -E 'ERROR|qml:.*(Error|error)' | tail -4"])
    err2, _ = sortie(["journalctl", "--user", "-u", "noctalia.service", "-p", "err", "-n", "4", "--no-pager", "-o", "cat"])
    for t, quoi in ((err, T("île", "island")), (err2 if "No entries" not in err2 else "", T("barre", "bar"))):
        for x in t.splitlines()[-4:]:
            l.append(T(f"  erreur ({quoi}) : ", f"  error ({quoi}): ") + re.sub(r"\x1b\[[0-9;]*m", "", x)[:200])
    return "\n".join(l)


def resume(b):
    """Le résumé du bilan, sans IA : les trois premiers ✗ et le nombre de !, ou « Tout est en ordre. »."""
    if not b.ko and not b.attention:
        return T("Tout est en ordre.", "Everything is in order.")
    if not b.ko:
        return T(f"Tout marche ; {b.attention} point(s) à améliorer.", f"Everything works; {b.attention} thing(s) to improve.")
    faux = [c["texte"] for c in b.constats if c["niveau"] == "faux"]
    t = T(f"{b.ko} problème(s) : ", f"{b.ko} problem(s): ") + T(" ; ", "; ").join(faux[:3])
    if b.ko > 3:
        t += T(f" ; et {b.ko - 3} autre(s)", f"; and {b.ko - 3} more")
    t += "."
    if b.attention:
        t += T(f" Et {b.attention} point(s) à améliorer.", f" And {b.attention} thing(s) to improve.")
    return t


def bilan_json(rapide=False):
    """« nc-diag --json [--rapide] » : un seul objet, lu par l'île (Spotlight, « Que se passe-t-il ? ») et nc-ia.
    Seulement les constats ! et ✗ ; la table des réparations qu'ils proposent (celle qui ferme l'île en dernier)."""
    global RAPIDE
    RAPIDE = rapide
    debut = time.monotonic()
    b = Bilan(couleurs=False)
    verifier(b)
    ids = sorted(dict.fromkeys(i for c in b.constats for i in c["reparations"]), key=lambda i: REPARATIONS[i]["ferme_ile"])
    return {"version": 1, "langue": "en" if EN else "fr", "duree_ms": int((time.monotonic() - debut) * 1000),
            "ko": b.ko, "attention": b.attention, "ok": b.nb_ok, "resume": resume(b), "constats": b.constats,
            "reparations": {i: REPARATIONS[i] for i in ids}}


@contextlib.contextmanager
def verrou(attente=120):
    """Une réparation à la fois (deux clics, ou le Spotlight et un terminal) : la seconde attend, puis revoit l'état."""
    d = os.environ.get("XDG_RUNTIME_DIR", "")
    chemin = (os.path.join(d, "nc-diag-reparer.lock") if d and os.path.isdir(d)
              else os.path.join(tempfile.gettempdir(), f"nc-diag-reparer-{os.getuid()}.lock"))
    fd = os.open(chemin, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fin = time.monotonic() + attente
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > fin:
                    raise
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


ETATS = ("active", "reloading", "inactive", "failed", "activating", "deactivating", "maintenance", "refreshing")


def _ile_systemd_run(verbe):
    """nc-ile.service (re)démarré HORS de son propre groupe : lancé depuis le Spotlight, nc-diag est dans le groupe de
    l'île, et « systemctl restart » l'arrêterait en même temps qu'elle, avant le start. Une unité de nom fixe (une seule
    à la fois) qui prévient d'une notification quand l'île est revenue (ou pas)."""
    if not a("systemd-run"):
        return "echec", T("systemd-run absent : rien n'est fait", "systemd-run missing: nothing done")
    subprocess.run(["systemctl", "--user", "reset-failed", "nc-ile.service"], capture_output=True, stdin=subprocess.DEVNULL, timeout=10)
    q = shlex.quote
    script = ("n() { command -v notify-send >/dev/null 2>&1 && notify-send -a " + q(T("Système", "System"))
              + ' -i dialog-information -- "$1" "$2"; }; '
              + f"systemctl --user {verbe} nc-ile.service; sleep 2; "
              + "if systemctl --user is-active --quiet nc-ile.service; then n "
              + q(T("L'île est revenue", "The island is back")) + " " + q("nc-diag reparer") + "; exit 0; else n "
              + q(T("L'île n'est pas revenue", "The island did not come back")) + " "
              + q(T("Bilan : nc-diag ; journal : qs -c nc-ile log", "Summary: nc-diag; log: qs -c nc-ile log")) + "; exit 1; fi")
    try:
        r = subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--wait", "--unit=nc-diag-reparer-ile",
                            "--", "sh", "-c", script], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=120)
    except subprocess.TimeoutExpired:
        return "echec", T("délai dépassé", "timed out")
    except OSError as e:
        return "echec", str(e)[-300:]
    if r.returncode and re.search(r"already (exists|loaded|active)|existe déjà", r.stderr, re.I):
        return "deja", T("l'île est déjà en train de redémarrer", "the island is already restarting")
    actif = sortie(["systemctl", "--user", "is-active", "nc-ile.service"])[0].strip()
    if actif == "active":
        return "fait", T("l'île est revenue", "the island is back")
    return "echec", (r.stderr.strip() or actif)[-300:]


def _reparer_bt(action, carte):
    """Casque Bluetooth : revoit l'état de la carte (« deja » s'il n'y a plus rien à faire), puis la réparation."""
    etat = bt_cartes().get(carte)
    if etat is None:
        return "echec", T("ce casque n'est pas connecté : rien n'est fait", "this headset is not connected: nothing done")
    actif, profils = etat
    if action == "bt_reconnecter":
        if actif != BT_PROFIL_CVSD:
            return "deja", T(f"le casque n'est plus en son réduit ({actif or 'inconnu'}) : rien à faire",
                             f"the headset is no longer in reduced sound ({actif or 'unknown'}): nothing to do")
        r = subprocess.run([os.path.join(BIN, "nc-bt-appel"), "reparer", carte], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=60)
        if r.returncode == 0:
            return "fait", T("connexion Bluetooth refaite", "Bluetooth connection redone")
        return "echec", T("la reconnexion n'a pas abouti", "the reconnection did not succeed")
    # bt_musique : seulement si aucune appli n'utilise le micro du casque
    if actif not in (BT_PROFIL_CVSD, BT_PROFIL_APPEL):
        return "deja", T(f"le casque est déjà en {actif or 'inconnu'} : rien à faire",
                         f"the headset is already in {actif or 'unknown'}: nothing to do")
    meilleur = bt_meilleur_a2dp(profils)
    if not meilleur:
        return "echec", T("aucun profil de qualité musique pour ce casque", "no music-quality profile for this headset")
    if bt_appel_en_cours(carte) is not False:
        return "echec", T("une appli utilise le micro du casque (ou l'état est inconnu) : rien n'est changé",
                          "an app is using the headset microphone (or the state is unknown): nothing changed")
    r = subprocess.run(["pactl", "set-card-profile", carte, meilleur], capture_output=True, text=True,
                       stdin=subprocess.DEVNULL, timeout=20)
    if r.returncode:
        return "echec", (r.stderr.strip() or "pactl")[-300:]
    return "fait", T(f"casque en {meilleur}", f"headset in {meilleur}")


def _reparer(ident):
    """Revoit l'état (« deja » s'il n'y a plus rien à faire), puis la réparation, sur le modèle de relancer() de
    nc-panne : compteur remis à zéro, (re)démarrage, deux secondes pour voir s'il tient. Jamais d'IA."""
    if ident == "ia_conf_prive":
        conf = os.path.join(HOME, ".config/nc/ia.conf")
        try:
            if not os.stat(conf).st_mode & 0o077:
                return "deja", T("~/.config/nc/ia.conf est déjà lisible par toi seul", "~/.config/nc/ia.conf is already readable by you only")
            os.chmod(conf, 0o600)
            ok = not os.stat(conf).st_mode & 0o077
        except FileNotFoundError:
            return "deja", T("pas de fichier ~/.config/nc/ia.conf : rien à protéger", "no ~/.config/nc/ia.conf file: nothing to protect")
        except OSError as e:
            return "echec", str(e)[-300:]
        return ("fait", T("lisible par toi seul", "readable by you only")) if ok else ("echec", "chmod 600")
    if ID_BT.fullmatch(ident):
        return _reparer_bt(*ident.split(":", 1))
    action, u = ident.split(":", 1)
    etat = sortie(["systemctl", "--user", "is-active", u])[0].strip()
    if etat not in ETATS:
        return "echec", T("systemd de la session ne répond pas (hors session ?) : rien n'est fait",
                          "the session's systemd does not answer (outside the session?): nothing done")
    if action == "redemarrer":
        besoin = etat == "failed" or (u == "noctalia.service" and sortie(["noctalia", "msg", "status"])[1] != 0)
    else:
        besoin = etat not in ("active", "activating", "reloading", "refreshing")
    if not besoin:
        return "deja", (T(f"{u} tourne déjà", f"{u} is already running") if etat == "active" else
                        T(f"{u} n'est plus en échec ({etat}) : rien à faire", f"{u} is no longer failed ({etat}): nothing to do"))
    if etat == "inactive" and not unite_chargee(u):
        return "echec", T(f"{u} n'est pas installé sur ce PC : rien n'est fait", f"{u} is not installed on this PC: nothing done")
    verbe = "restart" if action == "redemarrer" else "start"
    if u == "nc-ile.service" and verbe == "start" and ile_hors_systemd():
        return "deja", T("l'île tourne déjà (lancée à la main) : une seconde ne sera pas démarrée",
                         "the island is already running (started by hand): a second one will not be started")
    if u == "nc-ile.service":
        return _ile_systemd_run(verbe)
    subprocess.run(["systemctl", "--user", "reset-failed", u], capture_output=True, stdin=subprocess.DEVNULL, timeout=10)
    try:
        r = subprocess.run(["systemctl", "--user", verbe, u], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=90)
        erreur = r.stderr.strip() if r.returncode else ""
    except subprocess.TimeoutExpired:
        erreur = T("délai dépassé", "timed out")
    except OSError as e:
        erreur = str(e)
    time.sleep(2)
    actif = sortie(["systemctl", "--user", "is-active", u])[0].strip()
    if not erreur and actif == "active":
        return "fait", T(f"{u} tourne", f"{u} is running")
    return "echec", (erreur or actif)[-300:]


def reparer(args):
    """« nc-diag reparer ID [--json] » : une réparation de la table REPARATIONS, et rien d'autre. Un id inconnu : code 2,
    sans rien lancer. 0 : faite ou plus nécessaire (deja) ; 1 : échec."""
    en_json = "--json" in args
    reste = [x for x in args if x != "--json"]
    ident = reste[0] if len(reste) == 1 else ""
    if not id_valide(ident):
        res = {"id": ident[:80], "libelle": "", "resultat": "refuse", "ferme_ile": False,
               "texte": T("réparation inconnue : rien n'est fait", "unknown repair: nothing done")}
    else:
        try:
            with verrou():
                resultat, texte = _reparer(ident)
        except BlockingIOError:
            resultat, texte = "echec", T("une autre réparation ne finit pas", "another repair does not finish")
        except (OSError, subprocess.SubprocessError) as e:
            resultat, texte = "echec", str(e)[-300:]
        r = REPARATIONS[ident]
        res = {"id": ident, "libelle": r["libelle"], "resultat": resultat, "ferme_ile": r["ferme_ile"], "texte": texte}
    if en_json:
        print(json.dumps(res, ensure_ascii=False))
    elif res["resultat"] == "refuse":
        print(T("nc-diag reparer : ", "nc-diag repair: ") + res["texte"] + T(" (les réparations : nc-diag --json)",
                                                                             " (the repairs: nc-diag --json)"), file=sys.stderr)
    else:
        signe = "✗" if res["resultat"] == "echec" else "✓"
        print(f"{signe} {res['libelle']} : {res['texte']}" if not EN else f"{signe} {res['libelle']}: {res['texte']}")
    return {"fait": 0, "deja": 0, "echec": 1}.get(res["resultat"], 2)


def main():
    # L'île tourne avec le PATH du système : les outils installés pour l'utilisateur sont souvent ailleurs (comme nc-ia)
    os.environ["PATH"] = os.pathsep.join([os.path.join(HOME, d) for d in (".local/bin", "bin", ".npm-global/bin", ".bun/bin",
                                          ".opencode/bin", ".cargo/bin", ".deno/bin")] + [os.environ.get("PATH", "/usr/bin")])
    args = sys.argv[1:]
    if args and args[0] in ("reparer", "réparer", "repair"):
        sys.exit(reparer(args[1:]))
    if args and "--json" in args and set(args) <= {"--json", "--rapide", "--fast"}:
        print(json.dumps(bilan_json(rapide="--rapide" in args or "--fast" in args), ensure_ascii=False))
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("ia", "ai", "expliquer", "explain"):
        # Le bilan expliqué par l'IA du bureau (nc-ia diagnostic) : seulement s'il y a quelque chose à corriger
        os.execv(os.path.join(HOME, ".local/bin/nc-ia"), ["nc-ia", "diagnostic"])
    rapport = len(sys.argv) > 1 and sys.argv[1] in ("rapport", "--rapport", "report")
    court = len(sys.argv) > 1 and sys.argv[1] in ("court", "short")
    if len(sys.argv) > 1 and not (rapport or court):
        print(T(__doc__, DOC_EN).strip())
        return
    b = Bilan(couleurs=sys.stdout.isatty() and not rapport and not os.environ.get("NO_COLOR"))
    verifier(b)
    if court:
        if b.ko or b.attention:
            print(T("Vérification (nc-diag) :\n", "Check (nc-diag):\n") + b.texte(court=True))
            print(T("Détail : nc-diag · pour demander de l'aide : nc-diag rapport",
                    "Details: nc-diag · to ask for help: nc-diag report"))
        else:
            print(T("✓ Vérification : tout est en ordre.", "✓ Check: everything is in order."))
        return
    texte = b.texte()
    if b.ko:
        fin = T(f"{b.ko} problème(s) à corriger", f"{b.ko} problem(s) to fix")
    elif b.attention:
        fin = T(f"Tout marche ; {b.attention} point(s) à améliorer", f"Everything works; {b.attention} thing(s) to improve")
    else:
        fin = T("Tout est en ordre", "Everything is in order")
    texte = T("Bilan de noctalia-config (nc-diag)", "noctalia-config summary (nc-diag)") + texte + f"\n\n{fin}."
    if rapport:
        texte += "\n" + details()
    print(texte)
    if rapport:
        if a("wl-copy"):
            # wl-copy reste en fond pour garder le texte : sans ses sorties, sinon « nc-diag rapport | … » ne finit jamais
            subprocess.run(["wl-copy"], input=texte, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(T("\n(Copié : colle-le dans ton message.)", "\n(Copied: paste it into your message.)"))
    elif b.ko or b.attention:
        print(T("Pour demander de l'aide : nc-diag rapport (le bilan est copié, prêt à envoyer) ; nc-diag ia l'explique.",
                "To ask for help: nc-diag report (the summary is copied, ready to send); nc-diag ai explains it."))


if __name__ == "__main__":
    main()
