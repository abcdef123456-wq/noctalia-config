#!/usr/bin/env python3
"""nc-raccourci : tes raccourcis clavier, sans éditer de fichier.

  nc-raccourci                                    écran des raccourcis (dans nc-reglages)
  nc-raccourci liste                              tous les raccourcis, et tes changements
  nc-raccourci ajoute TOUCHES CIBLE [NOM]         nouveau raccourci. CIBLE :
        une appli (firefox, discord…)             va à sa fenêtre si elle est ouverte, sinon la lance
        bureau N                                  va au bureau N
        ile PAGE                                  ouvre une page de l'île (son, reseau, bluetooth, systeme…)
        toute autre commande                      lancée telle quelle
  nc-raccourci change ANCIENNES NOUVELLES         un raccourci de la config sur d'autres touches
  nc-raccourci desactive TOUCHES                  désactive un raccourci de la config
  nc-raccourci retablit TOUCHES | tout            annule un changement (ou tous)
  nc-raccourci retire TOUCHES                     retire un de tes raccourcis
Exemples : nc-raccourci ajoute "Super+B" firefox · nc-raccourci change "Super+Entrée" "Super+T"

Touches : Super, Ctrl, Alt, Maj, puis une lettre, un chiffre, F1…F12, Entrée, Espace, Tab, Échap, Impr, Suppr,
gauche/droite/haut/bas. Les lettres suivent la disposition active du clavier ; les chiffres, la rangée du haut.
Tout est gardé dans ~/.config/nc/raccourcis.conf, que les mises à jour ne touchent jamais ; tes raccourcis
apparaissent dans la fiche Super + / (section « Mes raccourcis »). Une combinaison déjà prise est refusée.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import unicodedata

# Langue (nc-reglages → Apparence → Langue : auto, fr, en) : T("texte français", "English text")
def _langue():
    l = os.environ.get("NC_LANGUE", "")
    if l not in ("fr", "en"):
        try:
            with open(os.path.expanduser("~/.config/nc/reglages.conf"), encoding="utf-8") as f:
                for x in f:
                    if x.startswith("LANGUE="):
                        l = x.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
    if l not in ("fr", "en"):
        loc = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
        if not loc:
            try:
                loc = re.search(r'LANG="?([^"\s]+)', open("/etc/locale.conf").read())[1]
            except (OSError, TypeError):
                loc = ""
        l = "fr" if loc.startswith("fr") else "en"
    return l


EN = _langue() == "en"


def T(fr, en):
    return en if EN else fr


USAGE_EN = """nc-shortcut: your keyboard shortcuts, without editing a file.

  nc-shortcut                                     shortcuts screen (in nc-settings)
  nc-shortcut list                                all shortcuts, and your changes
  nc-shortcut add KEYS TARGET [NAME]              new shortcut. TARGET:
        an app (firefox, discord…)                goes to its window if it is open, otherwise launches it
        desktop N                                 goes to desktop N
        island PAGE                               opens a page of the island (sound, network, bluetooth, system…)
        any other command                         run as is
  nc-shortcut remap OLD NEW                       moves a shortcut of the config to other keys
  nc-shortcut disable KEYS                        disables a shortcut of the config
  nc-shortcut restore KEYS | all                  undoes a change (or all of them)
  nc-shortcut remove KEYS                         removes one of your shortcuts
Examples: nc-shortcut add "Super+B" firefox · nc-shortcut remap "Super+Enter" "Super+T"

Keys: Super, Ctrl, Alt, Shift, then a letter, a digit, F1…F12, Enter, Space, Tab, Esc, Print, Delete,
left/right/up/down. Letters follow the active keyboard layout; digits, the top row.
Everything is kept in ~/.config/nc/raccourcis.conf, which updates never touch; your shortcuts
show up in the Super + / cheat sheet ("My Shortcuts" section). A combination already in use is refused."""

CONF = os.path.expanduser("~/.config/nc/raccourcis.conf")
PERSO = os.path.expanduser("~/.config/hypr/perso.lua")          # ancienne version : raccourcis dans perso.lua
TAG = "-- nc-raccourci"
BIN = os.path.expanduser("~/.local/bin")
PAGES = ["centre", "notifications", "son", "reseau", "bluetooth", "systeme", "calendrier", "minuteur"]
MODS = {"super": ("SUPER", 64), "win": ("SUPER", 64), "meta": ("SUPER", 64),
        "ctrl": ("CTRL", 4), "control": ("CTRL", 4), "alt": ("ALT", 8),
        "maj": ("SHIFT", 1), "shift": ("SHIFT", 1)}
NAMES = {"entrée": "Return", "entree": "Return", "enter": "Return", "return": "Return", "espace": "space",
         "space": "space", "tab": "Tab", "échap": "Escape", "echap": "Escape", "esc": "Escape", "escape": "Escape",
         "impr": "Print", "print": "Print", "suppr": "Delete", "delete": "Delete", "début": "Home", "home": "Home",
         "fin": "End", "end": "End", "gauche": "left", "left": "left", "droite": "right", "right": "right",
         "haut": "up", "up": "up", "bas": "down", "down": "down"}
# Touches désignées par leur position (comme dans la config) : mêmes touches en US, AZERTY…
CODES = {"Return": 36, "space": 65, "Tab": 23, "Escape": 9, "Delete": 119, "left": 113, "right": 114, "up": 111, "down": 116}

TTY = sys.stdout.isatty()
B, D, N = ("\033[1m", "\033[2m", "\033[0m") if TTY else ("", "", "")
ACC, MOD, OK, ERR = ("\033[34m", "\033[33m", "\033[32m", "\033[31m") if TTY else ("", "", "", "")

# Noms des touches et sections de la fiche Super + / : ceux de nc-keys
_chargeur = importlib.machinery.SourceFileLoader("nckeys", os.path.join(BIN, "nc-keys"))
nckeys = importlib.util.module_from_spec(importlib.util.spec_from_loader("nckeys", _chargeur))
_chargeur.exec_module(nckeys)


class Refus(Exception):
    pass


# ── Touches ─────────────────────────────────────────────────────────────────────────────────────────────────────
def parse_keys(text):
    """« Super+Maj+B » -> (texte Hyprland, masque, touche, codes possibles)."""
    parts = [p.strip() for p in text.replace(" ", "").split("+") if p.strip()]
    if not parts:
        raise Refus(T("combinaison vide", "empty combination"))
    mods, mask = [], 0
    for p in parts[:-1]:
        m = MODS.get(p.lower())
        if not m:
            raise Refus(T(f"modificateur inconnu : {p} (Super, Ctrl, Alt, Maj)", f"unknown modifier: {p} (Super, Ctrl, Alt, Shift)"))
        if m[0] not in mods:
            mods.append(m[0])
            mask |= m[1]
    k = parts[-1]
    codes = set()
    if re.fullmatch(r"[0-9]", k):
        codes = {19 if k == "0" else 9 + int(k)}   # rangée du haut : mêmes touches en US et en AZERTY
        key = f"code:{min(codes)}"
    elif re.fullmatch(r"[A-Za-z]", k):
        key = k.upper()
        codes = letter_codes(key)
    elif re.fullmatch(r"code:\d+", k):              # touche désignée par sa position (comme dans la config)
        key = k
        codes = {int(k[5:])}
    elif re.fullmatch(r"[Ff]([1-9]|1[0-2])", k):
        key = k.upper()
    elif k.lower() in NAMES:
        key = NAMES[k.lower()]
        if key in CODES:
            codes = {CODES[key]}
            key = f"code:{CODES[key]}"
    else:
        raise Refus(T(f"touche inconnue : {k}", f"unknown key: {k}"))
    if not mods and not re.fullmatch(r"F\d+", key) and key != "Print":      # F1…F12 seules, pas la lettre F
        raise Refus(T("ajoute au moins un modificateur (Super, Ctrl, Alt) : sinon la touche ne marcherait plus pour taper",
                      "add at least one modifier (Super, Ctrl, Alt): otherwise the key would no longer work for typing"))
    return " + ".join(mods + [key]), mask, key, codes


# Position (code) des lettres sur un clavier QWERTY, et différences des dispositions AZERTY / QWERTZ
QWERTY = {c: start + i for row, start in (("QWERTYUIOP", 24), ("ASDFGHJKL", 38), ("ZXCVBNM", 52)) for i, c in enumerate(row)}
AZERTY = {"A": 24, "Z": 25, "Q": 38, "M": 47, "W": 52}
QWERTZ = {"Z": 29, "Y": 52}


def letter_codes(letter):
    codes = {QWERTY.get(letter)}
    layouts = subprocess.run(["hyprctl", "getoption", "input:kb_layout"], capture_output=True, text=True).stdout
    for l in re.findall(r"[a-z]+", layouts.split("str:")[-1]):
        if l in ("fr", "be"):
            codes.add(AZERTY.get(letter, QWERTY.get(letter)))
        elif l in ("de", "ch", "at", "cz", "sk", "hu", "si", "hr", "rs"):
            codes.add(QWERTZ.get(letter, QWERTY.get(letter)))
    return {c for c in codes if c}


def id_of(bind):
    """Identifiant d'une combinaison au format Hyprland, comme la config le calcule (nc/raccourcis.lua)."""
    mask, key = 0, ""
    for m in bind.split("+"):
        m = m.strip()
        b = {"SUPER": 64, "CTRL": 4, "CONTROL": 4, "ALT": 8, "SHIFT": 1}.get(m.upper())
        if b:
            mask |= b
        else:
            key = m.lower()
    return f"{mask}:{key}"


def matches(ident, mask, key, codes):
    """L'identifiant « masque:touche » correspond-il à la combinaison tapée ?"""
    m, _, k = ident.partition(":")
    if m != str(mask):
        return False
    c = re.fullmatch(r"code:(\d+)", k)
    return (c and int(c.group(1)) in codes) or (not c and k == key.lower())


def human(ident_or_bind):
    """« 64:code:36 » ou « SUPER + code:36 » -> « Super + Entrée »."""
    if re.fullmatch(r"\d+:.*", ident_or_bind):
        m, _, k = ident_or_bind.partition(":")
        mask, last = int(m), k
    else:
        mask = int(id_of(ident_or_bind).split(":")[0])
        last = ident_or_bind.split("+")[-1].strip()
    mods = [name for bit, name in nckeys.MODS if mask & bit]
    if last.lower().startswith("xf86"):
        return T("Touches média", "Media keys")
    return " + ".join(mods + [nckeys.key_label(last)])


# ── Raccourcis actifs (hyprctl binds) ──────────────────────────────────────────────────────────────────────────
def live_binds():
    out = subprocess.run(["hyprctl", "binds"], capture_output=True, text=True).stdout
    res = []
    for b in nckeys.parse_binds(out):
        if b.get("submap", "").strip():
            continue
        try:
            mask = int(b.get("modmask", "0"))
        except ValueError:
            mask = 0
        last = b.get("key", "").split("+")[-1].strip()
        res.append({"id": f"{mask}:{last.lower()}", "desc": b.get("description", "").strip(), "arg": b.get("arg", "")})
    return res


def find_live(mask, key, codes, ignore=None):
    for b in live_binds():
        if b["id"] != ignore and matches(b["id"], mask, key, codes):
            return b
    return None


def desc_text(desc):
    sec, sep, text = desc.partition("|")
    return (text if sep else desc).strip() or T("un raccourci sans nom", "an unnamed shortcut")


# ── Fichier des changements ─────────────────────────────────────────────────────────────────────────────────────
def read_conf():
    try:
        with open(CONF, encoding="utf-8") as f:
            return [l.rstrip("\n").split("\t") for l in f if l.strip() and not l.startswith("#")]
    except FileNotFoundError:
        return []


def write_conf(entries):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".nc-new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# Tes raccourcis (commande nc-raccourci). Gardé tel quel par les mises à jour.\n"
                "# change MASQUE:TOUCHE NOUVELLES_TOUCHES (nom) · aucun MASQUE:TOUCHE (nom) · ajout TOUCHES TYPE VALEUR NOM\n")
        for e in entries:
            f.write("\t".join(x.replace("\t", " ") for x in e) + "\n")
    os.replace(tmp, CONF)


def reload_or_rollback(old_entries):
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    err = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True).stdout.strip()
    if err and err != "ok":
        write_conf(old_entries)
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        raise Refus(T("Hyprland a refusé ce changement, rien n'a été modifié :\n", "Hyprland refused this change, nothing was modified:\n") + err)


def original_id(live_id, entries):
    """Raccourci déplacé : identifiant d'origine (celui de la config), sinon le même."""
    for e in entries:
        if e[0] == "change" and len(e) > 2 and id_of(e[2]) == live_id:
            return e[1]
    return live_id


def legacy_lines():
    try:
        with open(PERSO, encoding="utf-8") as f:
            return [l for l in f.read().splitlines() if l.rstrip().endswith(TAG)]
    except FileNotFoundError:
        return []


# ── Applis ──────────────────────────────────────────────────────────────────────────────────────────────────────
def plain(t):
    return "".join(c for c in unicodedata.normalize("NFD", t.lower()) if unicodedata.category(c) != "Mn")


def apps():
    try:
        return json.loads(subprocess.run([os.path.join(BIN, "nc-apps"), "list"], capture_output=True, text=True).stdout)
    except (ValueError, OSError):
        return []


def find_app(name):
    n = plain(name)
    for a in apps():
        if n in (plain(a["id"]), plain(a["name"]), plain(a.get("exe") or "") if a.get("exe") != "env" else ""):
            return a
    return None


def cmd_ouvrir(app_id):
    """Va à la fenêtre de l'appli si elle est ouverte (la suivante si on y est déjà), sinon la lance."""
    a = next((x for x in apps() if x["id"] == app_id), None)
    names = {x.lower() for x in ([a["wmclass"], a["id"], "" if a["exe"] == "env" else a["exe"]] if a else [app_id]) if x}
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
    except ValueError:
        clients = []
    wins = sorted((c for c in clients if (c.get("class") or "").lower() in names), key=lambda c: c.get("focusHistoryID", 99))
    if wins:
        target = wins[1] if wins[0].get("focusHistoryID") == 0 and len(wins) > 1 else wins[0]
        subprocess.run(["hyprctl", "eval", f"hl.dispatch(hl.dsp.focus({{ window = 'address:{target['address']}' }}))"],
                       capture_output=True)
    else:
        subprocess.Popen([os.path.join(BIN, "nc-apps"), "launch", app_id], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── Commandes ───────────────────────────────────────────────────────────────────────────────────────────────────
def describe(e):
    """Ligne lisible d'un changement : (touches, texte)."""
    if e[0] == "change":
        nom = e[3] if len(e) > 3 else ""
        return human(e[2]), (f"{nom or T('raccourci de la config', 'config shortcut')}  "
                             f"{D}{T('(au lieu de ', '(instead of ')}{human(e[1])}){N}")
    if e[0] == "aucun":
        nom = e[2] if len(e) > 2 else ""
        return human(e[1]), f"{nom or T('raccourci de la config', 'config shortcut')}  {D}{T('(désactivé)', '(disabled)')}{N}"
    t = {"appli": T("appli", "app"), "bureau": T("bureau", "desktop"), "ile": T("île", "island"),
         "commande": T("commande", "command")}.get(e[2], e[2])
    val = f"  {D}({t}{T(' : ', ': ')}{e[3]}){N}" if e[2] != "appli" else f"  {D}({T('appli', 'app')}){N}"
    return human(e[1]), f"{e[4] or e[3]}{val}"


def changes():
    return read_conf()


def cmd_list():
    for sec in nckeys.collect():
        print(f"\n  {B}{ACC}{sec.get('label', sec['title'])}{N}")
        for r in sec["rows"]:
            print(f"    {' + '.join(r['keys']):<30} {r['text']}")
    ent = changes()
    if ent or legacy_lines():
        print(f"\n  {B}{ACC}{T('Tes changements', 'Your changes')}{N}  {D}({T('nc-raccourci', 'nc-shortcut')}){N}")
        for e in ent:
            k, t = describe(e)
            print(f"    {MOD}●{N} {k:<28} {t}")
        for l in legacy_lines():
            m = re.match(r'\s*hl\.bind\("([^"]+)"', l)
            print(f"    {MOD}●{N} {human(m.group(1)) if m else '?':<28} {D}{T('(dans perso.lua)', '(in perso.lua)')}{N}")
    print()


def target_of(cible, nom):
    """CIBLE -> (type, valeur, nom)."""
    m = re.fullmatch(r"(?i)(?:bureau|desktop|workspace)\s+(\d+)", cible.strip())
    if m:
        return "bureau", m.group(1), nom or T(f"Bureau {m.group(1)}", f"Desktop {m.group(1)}")
    m = re.fullmatch(r"(?i)(?:[iî]le|island)\s+(\S+)", cible.strip())
    if m:
        page = plain(m.group(1))
        page = {"wifi": "reseau", "wi-fi": "reseau", "bt": "bluetooth", "audio": "son", "agenda": "calendrier",
                "notifs": "notifications", "controle": "centre", "sound": "son", "network": "reseau",
                "system": "systeme", "calendar": "calendrier", "timer": "minuteur", "control": "centre",
                "center": "centre", "control-center": "centre"}.get(page, page)
        if page not in PAGES:
            raise Refus(T(f"page de l'île inconnue : {m.group(1)} ({', '.join(PAGES)})",
                          f"unknown island page: {m.group(1)} (centre, notifications, sound, network, bluetooth, "
                          f"system, calendar, timer)"))
        return "ile", page, nom or T(f"Île : {page}", f"Island: {page}")
    a = find_app(cible)
    if a:
        return "appli", a["id"], nom or a["name"]
    return "commande", cible, nom or cible


def cmd_add(keys, cible, nom=""):
    typ, val, nom = target_of(cible, nom)
    return ajouter(keys, typ, val, nom)


def ajouter(keys, typ, val, nom):
    """Nouveau raccourci : TYPE commande, appli (id du .desktop), bureau (numéro) ou ile (page)."""
    bind, mask, key, codes = parse_keys(keys)
    who = find_live(mask, key, codes)
    if who:
        raise Refus(T(f"{keys} est déjà pris : {desc_text(who['desc'])} "
                      f"(change-le ou désactive-le d'abord : nc-raccourci change / desactive)",
                      f"{keys} is already in use: {desc_text(who['desc'])} "
                      f"(remap or disable it first: nc-shortcut remap / disable)"))
    old = read_conf()
    reload_or_rollback_after(old, old + [["ajout", bind, typ, val, nom]])
    return (T(f"Ajouté : {human(bind)} → {nom}", f"Added: {human(bind)} → {nom}")
            + (T(" (va à sa fenêtre, sinon la lance)", " (goes to its window, otherwise launches it)") if typ == "appli" else ""))


def reload_or_rollback_after(old, new):
    write_conf(new)
    reload_or_rollback(old)


def find_config_bind(keys):
    """Raccourci actif désigné par ses touches -> (bind, entrée « ajout » si c'est un des tiens, sinon None)."""
    bind, mask, key, codes = parse_keys(keys)
    b = find_live(mask, key, codes)
    if not b:
        raise Refus(T(f"aucun raccourci sur {keys} (liste : nc-raccourci liste)", f"no shortcut on {keys} (list: nc-shortcut list)"))
    for e in read_conf():
        if e[0] == "ajout" and id_of(e[1]) == b["id"]:
            return b, e
    return b, None


def cmd_change(old_keys, new_keys):
    b, mine = find_config_bind(old_keys)
    nbind, mask, key, codes = parse_keys(new_keys)
    who = find_live(mask, key, codes, ignore=b["id"])
    if who:
        raise Refus(T(f"{new_keys} est déjà pris : {desc_text(who['desc'])}", f"{new_keys} is already in use: {desc_text(who['desc'])}"))
    old = read_conf()
    if mine:
        new = [(["ajout", nbind] + e[2:]) if e == mine else e for e in old]
    else:
        orig = original_id(b["id"], old)
        new = [e for e in old if not (e[0] in ("change", "aucun") and e[1] == orig)]
        if id_of(nbind) != orig:
            new.append(["change", orig, nbind, desc_text(b["desc"])])
    reload_or_rollback_after(old, new)
    return T(f"{desc_text(b['desc'])} : {human(nbind)}", f"{desc_text(b['desc'])}: {human(nbind)}")


def cmd_disable(keys):
    b, mine = find_config_bind(keys)
    if mine:
        raise Refus(T(f"{keys} est un de tes raccourcis : pour l'enlever, nc-raccourci retire \"{keys}\"",
                      f"{keys} is one of your shortcuts: to remove it, nc-shortcut remove \"{keys}\""))
    old = read_conf()
    orig = original_id(b["id"], old)
    new = [e for e in old if not (e[0] in ("change", "aucun") and e[1] == orig)] + [["aucun", orig, desc_text(b["desc"])]]
    reload_or_rollback_after(old, new)
    return T(f"Désactivé : {desc_text(b['desc'])} ({human(orig)})", f"Disabled: {desc_text(b['desc'])} ({human(orig)})")


def texte_de_id(ident):
    """« 64:code:36 » -> « Super+code:36 » (lisible par parse_keys)."""
    m, _, k = ident.partition(":")
    mods = [name for bit, name in ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Maj")) if int(m) & bit]
    return "+".join(mods + [k.upper() if len(k) == 1 else k])


def modifiable(ident):
    """Un raccourci peut changer de touches si sa touche est une lettre, un chiffre, une touche nommée ou une position."""
    try:
        parse_keys(texte_de_id(ident))
        return True
    except Refus:
        return False


def changer_id(live_id, new_keys):
    return cmd_change(texte_de_id(live_id), new_keys)


def desactiver_ids(live_ids, nom):
    old = read_conf()
    origs = [original_id(i, old) for i in live_ids]
    new = [e for e in old if not (e[0] in ("change", "aucun") and e[1] in origs)] + [["aucun", o, nom] for o in origs]
    reload_or_rollback_after(old, new)
    return T(f"Désactivé : {nom}", f"Disabled: {nom}")


def retablir_ids(orig_ids):
    old = read_conf()
    new = [e for e in old if not (e[0] in ("change", "aucun") and e[1] in orig_ids)]
    reload_or_rollback_after(old, new)
    return T("Rétabli comme dans la config", "Restored as in the config")


def retirer_ajout(bind):
    old = read_conf()
    new = [e for e in old if not (e[0] == "ajout" and e[1] == bind)]
    reload_or_rollback_after(old, new)
    return T("Retiré", "Removed")


def renommer_ajout(bind, nom):
    """Le nom affiché d'un de tes raccourcis (fiche Super + /, mode Modifier)."""
    nom = re.sub(r"[\t\n\r]", " ", str(nom)).strip()[:80]
    if not nom:
        raise Refus(T("nom vide", "empty name"))
    old = read_conf()
    if not any(e[0] == "ajout" and e[1] == bind for e in old):
        raise Refus(T("raccourci introuvable", "shortcut not found"))
    new = [(e[:4] + [nom] if e[0] == "ajout" and e[1] == bind else e) for e in old]
    reload_or_rollback_after(old, new)
    return T(f"Renommé : {nom}", f"Renamed: {nom}")


def cmd_restore(keys):
    old = read_conf()
    if keys in ("tout", "tous", "all"):
        new = [e for e in old if e[0] == "ajout"]
        reload_or_rollback_after(old, new)
        return T("Raccourcis de la config remis comme à l'origine (tes raccourcis ajoutés sont gardés).",
                 "Config shortcuts restored to their defaults (the shortcuts you added are kept).")
    bind, mask, key, codes = parse_keys(keys)
    # Par les touches actuelles (raccourci déplacé) ou d'origine (déplacé ou désactivé)
    hit = [e for e in old if e[0] in ("change", "aucun")
           and (matches(e[1], mask, key, codes) or (e[0] == "change" and matches(id_of(e[2]), mask, key, codes)))]
    if not hit:
        raise Refus(T(f"aucun changement sur {keys}", f"no change on {keys}"))
    reload_or_rollback_after(old, [e for e in old if e not in hit])
    return T("Rétabli : ", "Restored: ") + ", ".join(f"{(e[3] if e[0] == 'change' else e[2]) if len(e) > 2 else ''} ({human(e[1])})" for e in hit)


def cmd_remove(keys):
    bind, mask, key, codes = parse_keys(keys)
    old = read_conf()
    new = [e for e in old if not (e[0] == "ajout" and matches(id_of(e[1]), mask, key, codes))]
    if len(new) != len(old):
        reload_or_rollback_after(old, new)
        return T(f"Retiré : {keys}", f"Removed: {keys}")
    # Ancienne version : raccourci écrit dans perso.lua
    try:
        with open(PERSO, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    kept = [l for l in lines if not (l.rstrip().endswith(TAG) and
                                     (m := re.match(r'\s*hl\.bind\("([^"]+)"', l)) and matches(id_of(m.group(1)), mask, key, codes))]
    if len(kept) == len(lines):
        raise Refus(T(f"{keys} n'est pas un de tes raccourcis (liste : nc-raccourci liste)",
                      f"{keys} is not one of your shortcuts (list: nc-shortcut list)"))
    with open(PERSO, "w", encoding="utf-8") as f:
        f.write("\n".join(kept) + "\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    return T(f"Retiré : {keys}", f"Removed: {keys}")


if __name__ == "__main__":
    a = sys.argv[1:]
    try:
        if not a:
            # Le menu des raccourcis est dans l'écran de réglages (section Raccourcis)
            if sys.stdin.isatty():
                os.execv(os.path.join(BIN, "nc-reglages"), ["nc-reglages", "raccourcis"])
            cmd_list()
        elif a[0] in ("liste", "list"):
            cmd_list()
        elif a[0] in ("ajoute", "add") and len(a) in (3, 4):
            print(cmd_add(a[1], a[2], a[3] if len(a) == 4 else ""))
        elif a[0] in ("change", "remap") and len(a) == 3:
            print(cmd_change(a[1], a[2]))
        elif a[0] in ("desactive", "désactive", "disable") and len(a) == 2:
            print(cmd_disable(a[1]))
        elif a[0] in ("retablit", "rétablit", "restore") and len(a) == 2:
            print(cmd_restore(a[1]))
        elif a[0] in ("retire", "remove") and len(a) == 2:
            print(cmd_remove(a[1]))
        elif a[0] == "ouvrir" and len(a) == 2:
            cmd_ouvrir(a[1])
        else:
            print(T(__doc__.strip(), USAGE_EN))
            sys.exit(0 if a and a[0] in ("-h", "--help", "aide", "help") else 2)
    except Refus as e:
        print(T(f"nc-raccourci : {e}", f"nc-shortcut: {e}"), file=sys.stderr)
        sys.exit(1)
