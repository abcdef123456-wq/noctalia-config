#!/usr/bin/env bash
# nvidia-run : lance une commande sur la carte NVIDIA d'un PC hybride (PRIME render offload).
# Utile quand la session tourne sur la carte intégrée (Intel ou AMD) pour laisser la NVIDIA en veille :
# ce lanceur rétablit les pilotes NVIDIA pour cette seule commande.
# Il suit la règle de nc-gpu-regle (réglage GPU_REGLE, nc-reglages → Énergie) : là où elle veut la carte intégrée
# (en auto : Économie, ou Équilibré sur batterie), la commande est lancée telle quelle, sans les variables NVIDIA,
# même si l'appli la demande. NC_FORCER_RTX=1 nvidia-run <commande> : la NVIDIA quand même (essai à la main).
# Exemples : nvidia-run blender   ·   Steam, options de lancement : nvidia-run %command%
# Réglage mémoire propre à l'île (MALLOC_CONF, nc-ile.service) : pas pour les applis qu'elle lance
unset MALLOC_CONF
set -euo pipefail
langue() { . "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }; }
[ $# -ge 1 ] || { langue
  t "Usage : nvidia-run <commande> [arguments]" "Usage: nvidia-run <command> [arguments]" >&2; echo >&2; exit 1; }
EGL_DIR="${NC_EGL_DIR:-/usr/share/glvnd/egl_vendor.d}"
[ -r "$EGL_DIR/10_nvidia.json" ] || { langue
  t "nvidia-run : pilote NVIDIA introuvable, lancement normal." "nvidia-run: NVIDIA driver not found, launching normally." >&2; echo >&2; exec "$@"; }

# Règle de la carte graphique (profil d'énergie et alimentation du moment), sur un PC hybride seulement
regle="${BASH_SOURCE[0]%/*}/nc-gpu-regle"
[ -r "$regle" ] || regle="$HOME/.local/bin/nc-gpu-regle"
if [ "${NC_FORCER_RTX:-}" != 1 ] && [ -r "$regle" ] && . "$regle" && nc_pc_hybride; then
  profil=$(nc_profil_courant)
  bat=0; nc_sur_batterie && bat=1
  if ! rtx_voulue "$profil" "$bat"; then
    langue
    if [ "$(nc_gpu_reglage)" = jamais ]; then
      raison=$(t "réglage « Carte NVIDIA pour les applis » : jamais" "“NVIDIA graphics for apps” setting: never")
    elif [ "$profil" = power-saver ]; then
      raison=$(t "profil Économie" "Power Saver profile")
    else
      raison=$(t "Équilibré sur batterie" "Balanced on battery")
    fi
    t "nvidia-run : lancé sur la carte intégrée ($raison). La NVIDIA quand même : NC_FORCER_RTX=1 nvidia-run <commande>" \
      "nvidia-run: launched on the integrated GPU ($raison). NVIDIA anyway: NC_FORCER_RTX=1 nvidia-run <command>" >&2
    echo >&2
    exec "$@"
  fi
fi

# Pilote Vulkan NVIDIA : nvidia_icd.json, ou nvidia_icd.x86_64.json (Fedora, RPM Fusion)
vk=$(ls /usr/share/vulkan/icd.d/nvidia_icd*.json 2>/dev/null | grep -v i686 | paste -sd: || true)
vk=${vk:-/usr/share/vulkan/icd.d/nvidia_icd.json}
others=$(ls /usr/share/vulkan/icd.d/*.json 2>/dev/null | grep -vE 'nvidia|nouveau' | paste -sd: || true)
export __EGL_VENDOR_LIBRARY_FILENAMES=$EGL_DIR/10_nvidia.json:$EGL_DIR/50_mesa.json
export VK_DRIVER_FILES="$vk${others:+:$others}"
export __NV_PRIME_RENDER_OFFLOAD=1
export __VK_LAYER_NV_optimus=NVIDIA_only
export __GLX_VENDOR_LIBRARY_NAME=nvidia
exec "$@"
