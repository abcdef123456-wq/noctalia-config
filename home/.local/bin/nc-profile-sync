#!/usr/bin/env bash
# nc-profile-sync : adapte Hyprland au profil énergétique actif et à la source d'alimentation.
# Écrit ~/.config/hypr/nc/profil.lua (profil, batterie, fréquence voulue de l'écran interne) puis recharge Hyprland :
# la config Hyprland (nc/ecrans.lua, nc/energie.lua) en tire la fréquence, le flou, les ombres et les animations.
# Fonctionne avec tout service de profils compatible (power-profiles-daemon, tlp-pd, tuned-ppd).
# PC hybride (carte intégrée + NVIDIA) : choisit aussi la carte des applis lancées selon le profil.
# Réglages facultatifs (commande nc-reglages, ~/.config/nc/reglages.conf ; ancien fichier ~/.config/nc-profile.conf
# encore lu) :
#   HZ_PERFORMANCE=max  HZ_BALANCED_AC=max  HZ_BALANCED_BAT=max  HZ_ECO=low  ECO_BRIGHTNESS_MAX=40 (0 = ne pas toucher)
#   PROFIL_SECTEUR / PROFIL_BATTERIE=garder|performance|balanced|power-saver   profil choisi en branchant / débranchant
#   ECO_AUTO=20 (0 = jamais)   Économie sur batterie sous ce niveau, profil d'avant rendu en branchant
#   ECO_EFFETS / ECO_CLAVIER / ECO_BLUETOOTH=oui|non   ce que coupe l'Économie   GPU_PERFORMANCE=nvidia|integree
# Fréquences : « max » = la plus haute de l'écran interne, « low » = 60 Hz (sinon la plus basse), ou un nombre (ex. 120).
# Écran, rétroéclairage de l'écran et du clavier : détectés automatiquement.
set -uo pipefail
# Langue (nc-reglages → Apparence → Langue) : relue à chaque changement (le service tourne toute la session)
NC_LANGUE_ENV="${NC_LANGUE:-}"
langue() { NC_LANGUE="$NC_LANGUE_ENV"; . "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }; }
langue

OUT="$HOME/.config/hypr/nc/profil.lua"
# Noctalia v5 lit tous les *.toml de son dossier, par ordre alphabétique (le dernier l'emporte)
NOCTALIA_ECO="${NOCTALIA_CONFIG_HOME:-$HOME/.config}/noctalia/zz-economie.toml"
CFG="$HOME/.config/nc-profile.conf"
# Rétroéclairage de l'écran : le premier qui n'est pas celui de la carte NVIDIA
BACKLIGHT=$(for d in /sys/class/backlight/*; do n=${d##*/}; case $n in nvidia*|\*) ;; *) echo "$n"; break ;; esac; done)

HZ_PERFORMANCE=max
HZ_BALANCED_AC=max
HZ_BALANCED_BAT=max
HZ_ECO=low
ECO_BRIGHTNESS_MAX=40
PROFIL_SECTEUR=garder
PROFIL_BATTERIE=garder
ECO_AUTO=0
ECO_EFFETS=oui
ECO_CLAVIER=oui
ECO_BLUETOOTH=oui
GPU_PERFORMANCE=nvidia

for f in "$CFG" "$HOME/.config/nc/reglages.conf"; do
  [ -r "$f" ] || continue
  while IFS='=' read -r k v; do
    v="${v//\"/}"; v="${v%%[[:space:]]}"
    case "$k" in
      HZ_PERFORMANCE|HZ_BALANCED_AC|HZ_BALANCED_BAT|HZ_ECO|ECO_BRIGHTNESS_MAX)
        [[ "$v" =~ ^([0-9]{1,3}|max|low)$ ]] && printf -v "$k" '%s' "$v" || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      PROFIL_SECTEUR|PROFIL_BATTERIE)
        [[ "$v" =~ ^(garder|performance|balanced|power-saver)$ ]] && printf -v "$k" '%s' "$v" || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      ECO_AUTO) [[ "$v" =~ ^[0-9]{1,2}$ ]] && ECO_AUTO=$v || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      ECO_EFFETS|ECO_CLAVIER|ECO_BLUETOOTH) [[ "$v" =~ ^(oui|non)$ ]] && printf -v "$k" '%s' "$v" ;;
      GPU_PERFORMANCE) [[ "$v" =~ ^(nvidia|integree)$ ]] && GPU_PERFORMANCE=$v ;;
      *) ;;                                      # autres réglages : pour d'autres parties de la config
    esac
  done < "$f"
done

log() { echo "nc-profile-sync: $*"; }

get_profile() {
  gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
    --method org.freedesktop.DBus.Properties.Get net.hadess.PowerProfiles ActiveProfile 2>/dev/null \
    | sed -nE "s/^\(<'([a-z-]+)'>,\)$/\1/p"
}

on_battery() {
  local s
  for s in /sys/class/power_supply/*; do
    [ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && return 1
  done
  return 0
}

last_profile=""
last_bat=""
ECO_AUTO_FLAG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-eco-auto"   # profil d'avant l'Économie automatique

set_profile() {
  noctalia msg power-set "$1" >/dev/null 2>&1 ||
    gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
      --method org.freedesktop.DBus.Properties.Set net.hadess.PowerProfiles ActiveProfile "<'$1'>" >/dev/null 2>&1
}

batterie_pct() {
  local b
  for b in /sys/class/power_supply/BAT*; do [ -r "$b/capacity" ] && { cat "$b/capacity"; return; }; done
  echo 100
}

# Profil choisi en branchant / débranchant le chargeur, et Économie automatique sous ECO_AUTO % (nc-reglages → Énergie).
# Change « profile » de apply() (celui demandé, sans attendre que le service de profils l'ait annoncé) : pas de
# sous-shell, last_bat doit survivre d'un appel à l'autre.
profil_auto() {
  local voulu=""
  if [ -n "$last_bat" ] && [ "$bat" != "$last_bat" ]; then
    if [ "$bat" = 1 ]; then
      voulu=$PROFIL_BATTERIE
    else
      voulu=$PROFIL_SECTEUR
      # Chargeur branché après une Économie automatique : le profil d'avant revient (sauf profil choisi au branchement)
      [ "$voulu" = garder ] && [ -s "$ECO_AUTO_FLAG" ] && voulu=$(cat "$ECO_AUTO_FLAG")
      rm -f "$ECO_AUTO_FLAG"
    fi
  fi
  if [ "$bat" = 1 ] && [ "$ECO_AUTO" -gt 0 ] && [ ! -e "$ECO_AUTO_FLAG" ] && [ "$profile" != power-saver ] &&
     [ "$(batterie_pct)" -le "$ECO_AUTO" ]; then
    echo "$profile" > "$ECO_AUTO_FLAG"          # une fois par décharge : si tu repasses à un autre profil, il reste
    voulu=power-saver
    notify-send -a "$(t "Énergie" "Power")" -i battery-caution "$(t "Économie activée" "Power Saver on")" \
      "$(t "Batterie à $(batterie_pct) % : le profil d'avant reviendra quand tu brancheras le chargeur." "Battery at $(batterie_pct)%: your previous profile will come back when you plug in the charger.")" 2>/dev/null &
  fi
  last_bat=$bat
  if [ -n "$voulu" ] && [ "$voulu" != garder ] && [ "$voulu" != "$profile" ] && set_profile "$voulu"; then
    log "$(t "profil automatique : $voulu" "automatic profile: $voulu")"
    profile=$voulu
  fi
}

# PC hybride : une carte NVIDIA et une autre carte (Intel ou AMD), avec les pilotes EGL des deux
EGL_DIR=/usr/share/glvnd/egl_vendor.d
HYBRID=0
nv=0; other=0
for d in /sys/bus/pci/devices/*; do
  [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
  [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] && nv=1 || other=1
done
[ "$nv" = 1 ] && [ "$other" = 1 ] && [ -r "$EGL_DIR/10_nvidia.json" ] && [ -r "$EGL_DIR/50_mesa.json" ] && HYBRID=1
# Pilotes Vulkan de la carte intégrée (tous sauf NVIDIA)
IGPU_VK=$(ls /usr/share/vulkan/icd.d/*.json 2>/dev/null | grep -vE 'nvidia|nouveau' | paste -sd:)
GPU_STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-gpu-default"

# Carte des applis lancées (PC hybride) : NVIDIA en Performance, carte intégrée sinon.
# Seulement si la session tourne sur la carte intégrée seule (sinon on ne touche à rien).
#   - Noctalia lance via nc-launch, qui lit $GPU_STATE ;
#   - les raccourcis Hyprland héritent de l'environnement de Hyprland, mis à jour par « hyprctl eval hl.env(…) ».
set_gpu_default() {
  local want=integree
  [ "$HYBRID" = 1 ] || return 0
  case "${AQ_DRM_DEVICES:-}" in ""|*:*) return 0 ;; esac
  [ "$1" = performance ] && [ "$GPU_PERFORMANCE" = nvidia ] && want=nvidia
  [ "$(cat "$GPU_STATE" 2>/dev/null)" = "$want" ] && return 0
  local egl vk off layer glx
  if [ "$want" = nvidia ]; then
    egl=$EGL_DIR/10_nvidia.json:$EGL_DIR/50_mesa.json
    # nvidia_icd.json, ou nvidia_icd.x86_64.json (Fedora, RPM Fusion)
    vk=$(ls /usr/share/vulkan/icd.d/nvidia_icd*.json 2>/dev/null | grep -v i686 | paste -sd:)
    vk=${vk:-/usr/share/vulkan/icd.d/nvidia_icd.json}${IGPU_VK:+:$IGPU_VK}
    off=1; layer=NVIDIA_only; glx=nvidia
  else
    egl=$EGL_DIR/50_mesa.json
    vk=$IGPU_VK
    off=0; layer=non_NVIDIA_only; glx=mesa
  fi
  hyprctl eval "hl.env('__EGL_VENDOR_LIBRARY_FILENAMES', '$egl') hl.env('VK_DRIVER_FILES', '$vk') hl.env('__NV_PRIME_RENDER_OFFLOAD', '$off') hl.env('__VK_LAYER_NV_optimus', '$layer') hl.env('__GLX_VENDOR_LIBRARY_NAME', '$glx')" >/dev/null
  echo "$want" > "$GPU_STATE"
  log "$(t "GPU par défaut des nouvelles applis : $want" "default GPU for new apps: $want")"
}

# Passage en Performance alors que la session tourne sur la carte intégrée seule : la NVIDIA n'entre dans la
# session (prises HDMI / USB-C, rendu du bureau) qu'en la rouvrant ; la notification le propose, une fois par session.
proposer_nvidia() {
  local deja="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-nvidia-propose"
  [ "$HYBRID" = 1 ] && [ "$GPU_PERFORMANCE" = nvidia ] && [ "$1" = performance ] && [ -n "$last_profile" ] && [ "$last_profile" != performance ] || return 0
  case "${AQ_DRM_DEVICES:-}" in ""|*:*) return 0 ;; esac
  [ -e "$deja" ] && return 0
  : > "$deja"
  (
    # Dans le centre de notifications seulement : en pop-up, l'île montre déjà « ⚡ Performance » (x-nc-discret)
    choix="$(notify-send -a "$(t "Énergie" "Power")" -t 15000 -h boolean:x-nc-discret:true --action=session="$(t "Rouvrir la session" "Log Out and Back In")" \
      "$(t "Performance : carte NVIDIA" "Performance: NVIDIA GPU")" \
      "$(t "Les applis que tu lances l'utilisent déjà. Pour les prises HDMI / USB-C et tout le bureau, rouvre la session : elle démarrera avec la NVIDIA." "Apps you open already use it. For the HDMI / USB-C ports and the whole desktop, log out and back in: the session will start on the NVIDIA GPU.")" 2>/dev/null)"
    [ "$choix" = session ] && { uwsm stop 2>/dev/null || hyprctl dispatch 'hl.dsp.exit()'; }
  ) &
}

# Noctalia v5 en Économie : animations coupées, panneaux opaques (le flou de Hyprland est coupé),
# rotation des fonds en pause, verrouillage sans transition. Fichier retiré en sortant d'Économie.
noctalia_eco() {
  local dir want
  dir=$(dirname "$NOCTALIA_ECO")
  [ -d "$dir" ] || return 0
  if [ "$1" = power-saver ]; then
    want='# Généré par nc-profile-sync en mode Économie, supprimé en sortant. Ne pas éditer.
[shell.animation]
enabled = false

[shell.panel]
transparency_mode = "solid"

[wallpaper.automation]
enabled = false

[lockscreen]
transition = []'
    [ "$want" = "$(cat "$NOCTALIA_ECO" 2>/dev/null)" ] && return 0
    printf '%s\n' "$want" > "$NOCTALIA_ECO.tmp" && mv "$NOCTALIA_ECO.tmp" "$NOCTALIA_ECO"
    log "$(t "Noctalia : mode Économie (animations et rotation des fonds coupées)" "Noctalia: Power Saver mode (animations and wallpaper rotation off)")"
  else
    [ -e "$NOCTALIA_ECO" ] || return 0
    rm -f "$NOCTALIA_ECO"
    log "$(t "Noctalia : mode normal" "Noctalia: normal mode")"
  fi
  command -v noctalia >/dev/null && noctalia msg config-reload >/dev/null 2>&1
  return 0
}

apply() {
  hyprctl monitors -j >/dev/null 2>&1 || return 0
  local profile bat hz
  langue
  profile=$(get_profile)
  on_battery && bat=1 || bat=0
  profil_auto
  case "$profile" in
    performance) hz=$HZ_PERFORMANCE ;;
    power-saver) hz=$HZ_ECO ;;
    *)           if [ "$bat" = 1 ]; then hz=$HZ_BALANCED_BAT; else hz=$HZ_BALANCED_AC; fi ;;
  esac
  local batterie=false
  [ "$bat" = 1 ] && batterie=true

  local content="-- Généré par nc-profile-sync à chaque changement de profil énergétique. Ne pas éditer.
return { profil = \"${profile:-balanced}\", batterie = $batterie, hz = \"$hz\" }"
  if [ "$content" != "$(cat "$OUT" 2>/dev/null)" ]; then
    mkdir -p "$(dirname "$OUT")"
    printf '%s\n' "$content" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    hyprctl reload >/dev/null
    log "$(t "appliqué : profil=${profile:-inconnu} batterie=$bat fréquence=$hz" "applied: profile=${profile:-unknown} battery=$bat refresh=$hz")"
  fi

  set_gpu_default "$profile"
  proposer_nvidia "$profile"
  if [ "$ECO_EFFETS" = oui ]; then noctalia_eco "$profile"; else noctalia_eco balanced; fi

  # Bluetooth (si aucun appareil connecté) : coupé en Économie, rallumé en sortant
  # seulement si c'est ce script qui l'avait coupé.
  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ] && [ "$ECO_BLUETOOTH" = oui ]; then
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && [ -z "$(bluetoothctl devices Connected 2>/dev/null)" ]; then
      bluetoothctl power off >/dev/null 2>&1 && touch "$rt/nc-bt-off" && log "$(t "Bluetooth coupé (aucun appareil connecté)" "Bluetooth off (no device connected)")"
    fi
  elif [ "$profile" != power-saver ] && [ "$last_profile" = power-saver ]; then
    [ -e "$rt/nc-bt-off" ] && bluetoothctl power on >/dev/null 2>&1 && log "$(t "Bluetooth rallumé" "Bluetooth back on")"
    rm -f "$rt/nc-bt-off"
  fi

  # Rétroéclairage du clavier : éteint en Économie, niveau précédent restauré en sortant.
  local kbd kbd_saved="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-kbd-saved"
  kbd=$(ls /sys/class/leds 2>/dev/null | grep -m1 'kbd_backlight')
  if [ -n "$kbd" ] && [ -e "/sys/class/leds/$kbd" ] && { [ "$ECO_CLAVIER" = oui ] || [ -e "$kbd_saved" ]; }; then
    if [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ]; then
      # Ne pas écraser le niveau d'origine si le service redémarre alors qu'on est déjà en Économie.
      [ -e "$kbd_saved" ] || cat "/sys/class/leds/$kbd/brightness" > "$kbd_saved"
      brightnessctl -q -d "$kbd" set 0 && log "$(t "rétroéclairage clavier éteint" "keyboard backlight off")"
    elif [ "$profile" != power-saver ] && [ "$last_profile" = power-saver ] && [ -r "$kbd_saved" ]; then
      brightnessctl -q -d "$kbd" set "$(cat "$kbd_saved")" && log "$(t "rétroéclairage clavier restauré" "keyboard backlight restored")"
      rm -f "$kbd_saved"
    fi
  fi

  if [ -n "$BACKLIGHT" ] && [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ] && [ "$ECO_BRIGHTNESS_MAX" -gt 0 ]; then
    local cur max
    cur=$(brightnessctl -d "$BACKLIGHT" get 2>/dev/null) && max=$(brightnessctl -d "$BACKLIGHT" max 2>/dev/null) &&
      if [ $(( cur * 100 / max )) -gt "$ECO_BRIGHTNESS_MAX" ]; then
        brightnessctl -q -d "$BACKLIGHT" set "${ECO_BRIGHTNESS_MAX}%" && log "$(t "luminosité ramenée à ${ECO_BRIGHTNESS_MAX} %" "brightness lowered to ${ECO_BRIGHTNESS_MAX}%")"
      fi
  fi
  last_profile=$profile
}

# Nouvelle session : l'environnement de Hyprland repart de la valeur uwsm (AMD), on force la resynchronisation.
rm -f "$GPU_STATE"
apply

# Événements : changement de profil (tlp-pd) et de source d'alimentation (UPower). Vérification de secours toutes les 60 s.
{
  gdbus monitor --system --dest net.hadess.PowerProfiles &
  gdbus monitor --system --dest org.freedesktop.UPower --object-path /org/freedesktop/UPower &
  wait
} 2>/dev/null | while true; do
  read -r -t 60 _line
  rc=$?
  [ $rc -ne 0 ] && [ $rc -le 128 ] && { log "$(t "flux D-Bus interrompu" "D-Bus stream interrupted")"; exit 1; }
  sleep 0.3
  while read -r -t 0.2 _line; do :; done
  apply
done
