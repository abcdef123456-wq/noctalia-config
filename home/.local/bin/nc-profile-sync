#!/usr/bin/env bash
# nc-profile-sync : adapte Hyprland au profil énergétique actif et à la source d'alimentation.
# Écrit ~/.config/hypr/nc/profil.lua (profil, batterie, fréquence voulue de l'écran interne) puis recharge Hyprland :
# la config Hyprland (nc/ecrans.lua, nc/energie.lua) en tire la fréquence, le flou, les ombres et les animations.
# Fonctionne avec tout service de profils compatible (power-profiles-daemon, tlp-pd, tuned-ppd).
# PC hybride (carte intégrée + NVIDIA) : choisit aussi la carte des applis lancées selon le profil et l'alimentation
# (règle de nc-gpu-regle, réglage GPU_REGLE), et dit pourquoi la NVIDIA reste allumée quand elle devrait dormir
# (nc-rtx-veille).
# Portable à MUX (nc-gpu-mode : Hybride ou Dédiée) : en débranchant en mode Dédiée, une notification propose de repasser
# en Hybride (GPU_MUX_AVERTIR) ; en branchant en mode Hybride, elle propose le mode Dédiée (GPU_MUX_PROPOSER). En
# Dédiée, la carte des applis, la question de la session et le guet de la NVIDIA sont sans objet : tout est déjà sur
# la NVIDIA.
# Réglages facultatifs (commande nc-reglages, ~/.config/nc/reglages.conf ; ancien fichier ~/.config/nc-profile.conf
# encore lu) :
#   HZ_PERFORMANCE=max  HZ_BALANCED_AC=max  HZ_BALANCED_BAT=max  HZ_ECO=low  ECO_BRIGHTNESS_MAX=40 (0 = ne pas toucher)
#   PROFIL_SECTEUR / PROFIL_BATTERIE=garder|performance|balanced|power-saver   profil choisi en branchant / débranchant
#   ECO_AUTO=20 (0 = jamais)   Économie sur batterie sous ce niveau, profil d'avant rendu en branchant
#   ECO_EFFETS / ECO_CLAVIER / ECO_BLUETOOTH=oui|non   ce que coupe l'Économie
#   GPU_REGLE=auto|toujours|jamais   carte NVIDIA pour les applis (lu par nc-gpu-regle, avec l'ancien GPU_PERFORMANCE)
#   BAT_RELEVES=oui|non   sur batterie hors Performance, la barre Noctalia relève processeur, mémoire, réseau et disque
#                         moins souvent (et plus la carte graphique)
#   BAT_CLAVIER=oui|non   sur batterie hors Performance, clavier lumineux ramené au niveau 1 (s'il était plus haut),
#                         niveau d'avant rendu au branchement
#   GPU_MUX_PROPOSER=oui|non   portable à MUX en mode Hybride : en branchant, proposer le mode Dédiée (une fois par
#                              jour au plus ; plus jamais après trois « Non » de suite)
#   GPU_MUX_AVERTIR=oui|non    portable à MUX en mode Dédiée : en débranchant, prévenir que l'autonomie fond et proposer
#                              le mode Hybride (plus jamais après trois « Non » de suite ; compte à part)
#   Remettre l'un des deux à « oui » (nc-reglages) efface ses « Non » : le rappel revient.
# Fréquences : « max » = la plus haute de l'écran interne, « low » = 60 Hz (sinon la plus basse), ou un nombre (ex. 120).
# Écran, rétroéclairage de l'écran et du clavier : détectés automatiquement.
set -uo pipefail
# Langue (nc-reglages → Apparence → Langue) : relue à chaque changement (le service tourne toute la session)
NC_LANGUE_ENV="${NC_LANGUE:-}"
langue() { NC_LANGUE="$NC_LANGUE_ENV"; . "$HOME/.local/bin/nc-langue" 2>/dev/null || t() { printf '%s' "$1"; }; }
langue
# Règle de la carte graphique (PC hybride), profil d'énergie et alimentation : écrits une seule fois, dans nc-gpu-regle
. "${BASH_SOURCE[0]%/*}/nc-gpu-regle" 2>/dev/null || . "$HOME/.local/bin/nc-gpu-regle" ||
  { echo "nc-profile-sync: $(t "nc-gpu-regle introuvable (relance install.sh)" "nc-gpu-regle not found (run install.sh again)")" >&2; exit 1; }

OUT="$HOME/.config/hypr/nc/profil.lua"
# Noctalia v5 lit tous les *.toml de son dossier, par ordre alphabétique (le dernier l'emporte)
NOCTALIA_ECO="${NOCTALIA_CONFIG_HOME:-$HOME/.config}/noctalia/zz-economie.toml"
NOCTALIA_BAT="${NOCTALIA_CONFIG_HOME:-$HOME/.config}/noctalia/zz-batterie.toml"   # avant zz-economie : l'Économie gagne
# Dossiers du noyau (remplaçables pour les tests)
ALIM="${NC_POWER_SUPPLY:-/sys/class/power_supply}"
LEDS="${NC_LEDS:-/sys/class/leds}"
CFG="$HOME/.config/nc-profile.conf"
# Rétroéclairage de l'écran : le premier qui n'est pas celui de la carte NVIDIA
BACKLIGHT=$(for d in /sys/class/backlight/*; do n=${d##*/}; case $n in nvidia*|\*) ;; *) echo "$n"; break ;; esac; done)

HZ_PERFORMANCE=max
HZ_BALANCED_AC=max
HZ_BALANCED_BAT=max
HZ_ECO=low
ECO_BRIGHTNESS_MAX=40
PROFIL_SECTEUR=garder
PROFIL_BATTERIE=garder
ECO_AUTO=0
ECO_EFFETS=oui
ECO_CLAVIER=oui
ECO_BLUETOOTH=oui
BAT_RELEVES=oui
BAT_CLAVIER=oui
GPU_MUX_PROPOSER=oui
GPU_MUX_AVERTIR=oui

for f in "$CFG" "$HOME/.config/nc/reglages.conf"; do
  [ -r "$f" ] || continue
  while IFS='=' read -r k v; do
    v="${v//\"/}"; v="${v%%[[:space:]]}"
    case "$k" in
      HZ_PERFORMANCE|HZ_BALANCED_AC|HZ_BALANCED_BAT|HZ_ECO|ECO_BRIGHTNESS_MAX)
        [[ "$v" =~ ^([0-9]{1,3}|max|low)$ ]] && printf -v "$k" '%s' "$v" || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      PROFIL_SECTEUR|PROFIL_BATTERIE)
        [[ "$v" =~ ^(garder|performance|balanced|power-saver)$ ]] && printf -v "$k" '%s' "$v" || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      ECO_AUTO) [[ "$v" =~ ^[0-9]{1,2}$ ]] && ECO_AUTO=$v || echo "$(t "valeur ignorée : $k=$v" "ignored value: $k=$v")" >&2 ;;
      ECO_EFFETS|ECO_CLAVIER|ECO_BLUETOOTH|BAT_RELEVES|BAT_CLAVIER|GPU_MUX_PROPOSER|GPU_MUX_AVERTIR) [[ "$v" =~ ^(oui|non)$ ]] && printf -v "$k" '%s' "$v" ;;
      *) ;;                                      # autres réglages : pour d'autres parties de la config
    esac
  done < "$f"
done

log() { echo "nc-profile-sync: $*"; }

get_profile() { nc_profil_courant; }

# Sur batterie (nc-gpu-regle) : batterie présente et rien de branché ; PC sans batterie : secteur
on_battery() { NC_POWER_SUPPLY="$ALIM" nc_sur_batterie; }

last_profile=""
last_bat=""
last_kbd=""                                     # état du clavier lumineux au dernier passage : normal, bas, eteint
ECO_AUTO_FLAG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-eco-auto"   # profil d'avant l'Économie automatique

set_profile() {
  noctalia msg power-set "$1" >/dev/null 2>&1 ||
    gdbus call --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles \
      --method org.freedesktop.DBus.Properties.Set net.hadess.PowerProfiles ActiveProfile "<'$1'>" >/dev/null 2>&1
}

batterie_pct() {
  local b
  for b in "$ALIM"/BAT*; do [ -r "$b/capacity" ] && { cat "$b/capacity"; return; }; done
  echo 100
}

# Profil choisi en branchant / débranchant le chargeur, et Économie automatique sous ECO_AUTO % (nc-reglages → Énergie).
# Change « profile » de apply() (celui demandé, sans attendre que le service de profils l'ait annoncé) : pas de
# sous-shell, last_bat doit survivre d'un appel à l'autre.
profil_auto() {
  local voulu=""
  if [ -n "$last_bat" ] && [ "$bat" != "$last_bat" ]; then
    if [ "$bat" = 1 ]; then
      voulu=$PROFIL_BATTERIE
    else
      voulu=$PROFIL_SECTEUR
      # Chargeur branché après une Économie automatique : le profil d'avant revient (sauf profil choisi au branchement)
      [ "$voulu" = garder ] && [ -s "$ECO_AUTO_FLAG" ] && voulu=$(cat "$ECO_AUTO_FLAG")
      rm -f "$ECO_AUTO_FLAG"
    fi
  fi
  if [ "$bat" = 1 ] && [ "$ECO_AUTO" -gt 0 ] && [ ! -e "$ECO_AUTO_FLAG" ] && [ "$profile" != power-saver ] &&
     [ "$(batterie_pct)" -le "$ECO_AUTO" ]; then
    echo "$profile" > "$ECO_AUTO_FLAG"          # une fois par décharge : si tu repasses à un autre profil, il reste
    voulu=power-saver
    notify-send -a "$(t "Énergie" "Power")" -i battery-caution "$(t "Économie activée" "Power Saver on")" \
      "$(t "Batterie à $(batterie_pct) % : le profil d'avant reviendra quand tu brancheras le chargeur." "Battery at $(batterie_pct)%: your previous profile will come back when you plug in the charger.")" 2>/dev/null &
  fi
  last_bat=$bat
  if [ -n "$voulu" ] && [ "$voulu" != garder ] && [ "$voulu" != "$profile" ] && set_profile "$voulu"; then
    log "$(t "profil automatique : $voulu" "automatic profile: $voulu")"
    profile=$voulu
  fi
}

# PC hybride : une carte NVIDIA et une autre carte (Intel ou AMD), avec les pilotes EGL des deux (nc-gpu-regle)
EGL_DIR="${NC_EGL_DIR:-/usr/share/glvnd/egl_vendor.d}"
HYBRID=0
nc_pc_hybride && HYBRID=1
# Pilotes Vulkan de la carte intégrée (tous sauf NVIDIA)
IGPU_VK=$(ls /usr/share/vulkan/icd.d/*.json 2>/dev/null | grep -vE 'nvidia|nouveau' | paste -sd:)
GPU_STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-gpu-default"

# Carte des applis lancées (PC hybride), selon la règle de nc-gpu-regle (rtx_voulue PROFIL BAT) : NVIDIA sur secteur
# en Performance et en Équilibré, sur batterie seulement en Performance ; carte intégrée sinon. Rejouée à chaque
# passage (chaque événement D-Bus : profil ou alimentation), donc aussi en débranchant le chargeur.
# Seulement si la session a été ouverte par env-hyprland sur la carte intégrée, seule ou avec la NVIDIA (sinon :
# PC non hybride, écran interne sur la NVIDIA, mode « off » ; on ne touche à rien).
#   - Noctalia lance via nc-launch, qui lit $GPU_STATE ;
#   - les raccourcis Hyprland héritent de l'environnement de Hyprland, mis à jour par « hyprctl eval hl.env(…) ».
set_gpu_default() {
  local want=integree
  [ "$HYBRID" = 1 ] || return 0
  [ -n "${AQ_DRM_DEVICES:-}" ] || return 0
  en_dediee && return 0                         # écran interne sur la NVIDIA : tout y est déjà
  rtx_voulue "$1" "$2" && want=nvidia
  [ "$(cat "$GPU_STATE" 2>/dev/null)" = "$want" ] && return 0
  local egl vk off layer glx
  if [ "$want" = nvidia ]; then
    egl=$EGL_DIR/10_nvidia.json:$EGL_DIR/50_mesa.json
    # nvidia_icd.json, ou nvidia_icd.x86_64.json (Fedora, RPM Fusion)
    vk=$(ls /usr/share/vulkan/icd.d/nvidia_icd*.json 2>/dev/null | grep -v i686 | paste -sd:)
    vk=${vk:-/usr/share/vulkan/icd.d/nvidia_icd.json}${IGPU_VK:+:$IGPU_VK}
    off=1; layer=NVIDIA_only; glx=nvidia
  else
    egl=$EGL_DIR/50_mesa.json
    vk=$IGPU_VK
    off=0; layer=non_NVIDIA_only; glx=mesa
  fi
  hyprctl eval "hl.env('__EGL_VENDOR_LIBRARY_FILENAMES', '$egl') hl.env('VK_DRIVER_FILES', '$vk') hl.env('__NV_PRIME_RENDER_OFFLOAD', '$off') hl.env('__VK_LAYER_NV_optimus', '$layer') hl.env('__GLX_VENDOR_LIBRARY_NAME', '$glx')" >/dev/null
  echo "$want" > "$GPU_STATE"
  log "$(t "GPU par défaut des nouvelles applis : $want" "default GPU for new apps: $want")"
}

# Passage en Performance alors que la session tourne sur la carte intégrée seule : la NVIDIA n'entre dans la
# session (prises HDMI / USB-C, rendu du bureau) qu'en la rouvrant ; la notification le propose, une fois par session.
proposer_nvidia() {
  local deja="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-nvidia-propose"
  [ "$HYBRID" = 1 ] && [ "$1" = performance ] && rtx_voulue "$1" "$2" && [ -n "$last_profile" ] && [ "$last_profile" != performance ] || return 0
  case "${AQ_DRM_DEVICES:-}" in ""|*:*) return 0 ;; esac
  [ -e "$deja" ] && return 0
  en_dediee && return 0                         # la session tourne déjà sur la NVIDIA
  : > "$deja"
  (
    # Dans le centre de notifications seulement : en pop-up, l'île montre déjà « ⚡ Performance » (x-nc-discret)
    choix="$(notify-send -a "$(t "Énergie" "Power")" -t 15000 -h boolean:x-nc-discret:true --action=session="$(t "Rouvrir la session" "Log Out and Back In")" \
      "$(t "Performance : carte NVIDIA" "Performance: NVIDIA GPU")" \
      "$(t "Les applis que tu lances l'utilisent déjà. Pour les prises HDMI / USB-C et tout le bureau, rouvre la session : elle démarrera avec la NVIDIA." "Apps you open already use it. For the HDMI / USB-C ports and the whole desktop, log out and back in: the session will start on the NVIDIA GPU.")" 2>/dev/null)"
    [ "$choix" = session ] && { uwsm stop 2>/dev/null || hyprctl dispatch 'hl.dsp.exit()'; }
  ) &
}

# La NVIDIA doit dormir (0 W) en Économie, et sur batterie quand la règle ne la veut pas. Si elle reste allumée plus
# de RTX_DELAI secondes, nc-rtx-veille alerter le dit, une fois par cause (nvidia-persistenced, une appli ouverte
# dessus : « Relancer X sur la carte intégrée »). Le guet tourne à part (sous-shell en fond) : la boucle D-Bus
# n'attend jamais. Rien n'est lu en boucle : un fichier de /sys à chaque passage, sans réveiller la carte.
# Seulement si la session a été ouverte par env-hyprland (écran interne sur la carte intégrée).
RTX_DELAI="${NC_RTX_DELAI:-30}"
RTX_GUET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-rtx-guet"
RTX_VEILLE="${BASH_SOURCE[0]%/*}/nc-rtx-veille"
[ -x "$RTX_VEILLE" ] || RTX_VEILLE="$HOME/.local/bin/nc-rtx-veille"
RTX_ETAT=""                                     # power/runtime_status de la NVIDIA : « suspended » = 0 W
if [ "$HYBRID" = 1 ]; then
  for d in "${NC_SYSFS:-/sys}"/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
    case "$(cat "$d/class" 2>/dev/null)" in 0x03*) RTX_ETAT="$d/power/runtime_status"; break ;; esac
  done
fi

rtx_doit_dormir() {
  ! rtx_voulue "$1" "$2" && { [ "$1" = power-saver ] || [ "$2" = 1 ]; }
}

guetter_rtx() {
  [ -n "$RTX_ETAT" ] && [ -n "${AQ_DRM_DEVICES:-}" ] && [ -x "$RTX_VEILLE" ] || return 0
  rtx_doit_dormir "$1" "$2" || return 0
  [ "$(cat "$RTX_ETAT" 2>/dev/null)" = active ] || return 0
  en_dediee && return 0                         # en Dédiée, l'écran la tient allumée : rien à guetter
  [ -s "$RTX_GUET" ] && kill -0 "$(cat "$RTX_GUET" 2>/dev/null)" 2>/dev/null && return 0   # un seul guet à la fois
  (
    sleep "$RTX_DELAI"
    [ "$(cat "$RTX_ETAT" 2>/dev/null)" = active ] || exit 0
    p=$(get_profile); b=0; on_battery && b=1
    rtx_doit_dormir "$p" "$b" || exit 0
    # En fond, lui aussi : ses notifications à bouton attendent un clic, le guet suivant ne doit pas les attendre
    "$RTX_VEILLE" alerter &
  ) &
  echo "$!" > "$RTX_GUET"
}

# Portable à MUX (nc-gpu-mode) : le mode graphique, Hybride (écran sur la carte intégrée) ou Dédiée (écran sur la
# NVIDIA), ne change qu'au redémarrage. Lu une seule fois, au premier besoin (un branchement, un débranchement, ou une
# garde ci-dessus quand la session a été ouverte avec les cartes), jamais en boucle : nc-gpu-mode actuel lit /sys.
# NC_GPU_MODE_CMD, NC_REGLAGES_CMD : à la place de nc-gpu-mode et de nc-reglages (tests).
GPU_MODE_CMD="${NC_GPU_MODE_CMD:-${BASH_SOURCE[0]%/*}/nc-gpu-mode}"
[ -x "$GPU_MODE_CMD" ] || GPU_MODE_CMD="$HOME/.local/bin/nc-gpu-mode"
REGLAGES_CMD="${NC_REGLAGES_CMD:-${BASH_SOURCE[0]%/*}/nc-reglages}"
[ -x "$REGLAGES_CMD" ] || REGLAGES_CMD="$HOME/.local/bin/nc-reglages"
# Rappels du MUX (même dossier que dispositions.json), une ligne par valeur : jour= (dernière proposition au
# branchement), non= (ses « Non » de suite), avertir_non= (les « Non » de suite à l'avertissement du débranchement).
# nc-reglages efface les lignes d'un rappel quand son réglage repasse à « oui ».
MUX_ETAT="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia-config/gpu-mux"
MODE_GPU=""                                     # hybride, dediee ou sans-objet ; vide tant qu'il n'est pas lu

# Met MODE_GPU à jour : une seule lecture réussie par session (pas de sous-shell, la valeur doit rester)
mode_gpu() {
  [ -n "$MODE_GPU" ] && return 0
  MODE_GPU=$("$GPU_MODE_CMD" actuel 2>/dev/null)
  case "$MODE_GPU" in hybride|dediee|sans-objet) ;; *) MODE_GPU="" ;; esac
}
en_dediee() { mode_gpu; [ "$MODE_GPU" = dediee ]; }

# La carte de confirmation de l'île, vers ce mode (gpuModeVers) ; sans île (qs absent, arrêtée, trop lente, ou une
# ancienne île sans cette fonction) : nc-reglages mode-graphique (l'île si elle revient, sinon la question dans un
# terminal). Jamais de bascule sans la confirmation de l'une ou de l'autre.
changer_mode_gpu() {
  local r
  if command -v qs >/dev/null 2>&1 && r=$(timeout 5 qs -c nc-ile ipc call ile gpuModeVers "$1" 2>&1); then
    # Quickshell répond « Function not found. » avec le code 0 : le code seul ne suffit pas (comme nc-reglages)
    case "${r,,}" in *"not found"*|*"no function"*) ;; *) return 0 ;; esac
  fi
  "$REGLAGES_CMD" mode-graphique >/dev/null 2>&1
}

# Un compte du fichier d'état (0 s'il manque ou s'il est abîmé)
mux_compte() {
  local n; n=$(sed -n "s/^$1=//p" "$MUX_ETAT" 2>/dev/null | tail -n 1)
  [[ "$n" =~ ^[0-9]+$ ]] && echo "$n" || echo 0
}

# mux_noter cle=valeur… : change ces lignes et garde les autres (celles de l'autre rappel) ; fichier remplacé d'un coup
mux_noter() {
  local p tmp="$MUX_ETAT.$BASHPID" filtre=()
  for p; do filtre+=(-e "^${p%%=*}="); done
  mkdir -p "${MUX_ETAT%/*}" || return 0
  { grep -v "${filtre[@]}" "$MUX_ETAT" 2>/dev/null; printf '%s\n' "$@"; } > "$tmp" && mv -f "$tmp" "$MUX_ETAT"
}

# Débranché en mode Dédiée : la NVIDIA porte l'écran et ne dort jamais. Une notification par débranchement
# (GPU_MUX_AVERTIR), plus jamais après trois « Non » de suite (une notification fermée sans réponse ne compte pas).
# En fond : la boucle D-Bus n'attend pas le clic. Les « Non » sont relus à la réponse (nc-reglages a pu les effacer
# entre-temps) ; même chose au branchement.
mux_avertissable() { [ "$GPU_MUX_AVERTIR" = oui ] && [ "$(mux_compte avertir_non)" -lt 3 ]; }

mux_debranche() {
  (
    choix="$(notify-send -a "$(t "Énergie" "Power")" -i battery-caution -t 20000 \
      --action=changer="$(t "Changer de mode" "Switch mode")" --action=non="$(t "Non" "No")" \
      "$(t "Mode Dédiée sur batterie" "Discrete mode on battery")" \
      "$(t "Sur batterie en mode Dédiée : la carte NVIDIA reste allumée, l'autonomie fond. Repasser en mode Hybride ?" \
           "On battery in Discrete mode: the NVIDIA GPU stays on and the battery drains fast. Switch back to Hybrid mode?")" 2>/dev/null)"
    case "$choix" in
      changer) mux_noter avertir_non=0; changer_mode_gpu hybride ;;
      non) mux_noter "avertir_non=$(( $(mux_compte avertir_non) + 1 ))" ;;
    esac
  ) &
}

# Branché en mode Hybride : proposer le mode Dédiée (GPU_MUX_PROPOSER), au plus une fois par jour, plus jamais après
# trois « Non » de suite (une notification fermée sans réponse ne compte pas). Le jour est noté dès la proposition.
mux_proposable() {
  [ "$GPU_MUX_PROPOSER" = oui ] || return 1
  [ "$(mux_compte non)" -lt 3 ] && [ "$(sed -n 's/^jour=//p' "$MUX_ETAT" 2>/dev/null)" != "$(date +%F)" ]
}

mux_branche() {
  mux_noter "jour=$(date +%F)" "non=$(mux_compte non)"
  (
    choix="$(notify-send -a "$(t "Énergie" "Power")" -i video-display -t 20000 \
      --action=dediee="$(t "Passer en Dédiée" "Switch to Discrete")" --action=non="$(t "Non" "No")" \
      "$(t "Mode graphique" "Graphics mode")" \
      "$(t "Branché : passer en mode Dédiée pour un bureau plus fluide ?" \
           "Plugged in: switch to Discrete mode for a smoother desktop?")" 2>/dev/null)"
    case "$choix" in
      dediee) mux_noter non=0; changer_mode_gpu dediee ;;
      non) mux_noter "non=$(( $(mux_compte non) + 1 ))" ;;
    esac
  ) &
}

# Seulement quand l'alimentation vient de changer (1 : débranché, 0 : branché). Rappel coupé ou trois « Non » : pas même
# une lecture de nc-gpu-mode.
mux_alimentation() {
  if [ "$1" = 1 ]; then
    mux_avertissable || return 0
    en_dediee && mux_debranche
  else
    mux_proposable || return 0
    mode_gpu
    [ "$MODE_GPU" = hybride ] && mux_branche
  fi
  return 0
}

# Écrit (ou retire, si le contenu voulu est vide) un fichier de réglages de Noctalia ; réussit s'il a changé.
fichier_noctalia() {
  local f=$1 want=$2
  if [ -n "$want" ]; then
    [ "$want" = "$(cat "$f" 2>/dev/null)" ] && return 1
    printf '%s\n' "$want" > "$f.tmp" && mv "$f.tmp" "$f"
  else
    [ -e "$f" ] || return 1
    rm -f "$f"
  fi
}

# Noctalia v5, fichiers lus après sa config (ordre alphabétique, le dernier l'emporte) :
#   - zz-batterie.toml, sur batterie hors Performance (BAT_RELEVES) : la barre relève processeur, mémoire, réseau
#     et disque moins souvent, la carte graphique plus du tout (rien d'autre ne change à l'écran) ;
#   - zz-economie.toml, en Économie (ECO_EFFETS) : animations coupées, panneaux opaques (le flou de Hyprland est
#     coupé), rotation des fonds en pause, verrouillage sans transition, relevés encore plus espacés.
# Un seul « config-reload », et seulement si l'un des deux a changé.
noctalia_config() {
  local profile=$1 bat=$2 dir eco="" batt="" change=0
  dir=$(dirname "$NOCTALIA_ECO")
  [ -d "$dir" ] || return 0
  if [ "$profile" = power-saver ] && [ "$ECO_EFFETS" = oui ]; then
    eco='# Généré par nc-profile-sync en mode Économie, supprimé en sortant. Ne pas éditer.
[shell.animation]
enabled = false

[shell.panel]
transparency_mode = "solid"

[wallpaper.automation]
enabled = false

[lockscreen]
transition = []

[system.monitor]
cpu_poll_seconds = 10.0
memory_poll_seconds = 10.0
network_poll_seconds = 10.0
disk_poll_seconds = 60.0
gpu_poll_seconds = 0.0'
  fi
  if [ "$bat" = 1 ] && [ "$profile" != performance ] && [ "$BAT_RELEVES" = oui ]; then
    batt='# Généré par nc-profile-sync sur batterie (hors Performance), supprimé au branchement. Ne pas éditer.
[system.monitor]
cpu_poll_seconds = 5.0
memory_poll_seconds = 6.0
network_poll_seconds = 6.0
disk_poll_seconds = 30.0
gpu_poll_seconds = 0.0'
  fi
  if fichier_noctalia "$NOCTALIA_ECO" "$eco"; then
    change=1
    if [ -n "$eco" ]; then log "$(t "Noctalia : mode Économie (animations et rotation des fonds coupées)" "Noctalia: Power Saver mode (animations and wallpaper rotation off)")"
    else log "$(t "Noctalia : mode normal" "Noctalia: normal mode")"; fi
  fi
  if fichier_noctalia "$NOCTALIA_BAT" "$batt"; then
    change=1
    if [ -n "$batt" ]; then log "$(t "Noctalia : relevés de la barre espacés (batterie)" "Noctalia: fewer bar readings (battery)")"
    else log "$(t "Noctalia : relevés de la barre normaux" "Noctalia: normal bar readings")"; fi
  fi
  [ "$change" = 1 ] && command -v noctalia >/dev/null && noctalia msg config-reload >/dev/null 2>&1
  return 0
}

apply() {
  hyprctl monitors -j >/dev/null 2>&1 || return 0
  local profile bat hz avant=$last_bat
  langue
  profile=$(get_profile)
  on_battery && bat=1 || bat=0
  profil_auto
  case "$profile" in
    performance) hz=$HZ_PERFORMANCE ;;
    power-saver) hz=$HZ_ECO ;;
    *)           if [ "$bat" = 1 ]; then hz=$HZ_BALANCED_BAT; else hz=$HZ_BALANCED_AC; fi ;;
  esac
  local batterie=false
  [ "$bat" = 1 ] && batterie=true

  local content="-- Généré par nc-profile-sync à chaque changement de profil énergétique. Ne pas éditer.
return { profil = \"${profile:-balanced}\", batterie = $batterie, hz = \"$hz\" }"
  if [ "$content" != "$(cat "$OUT" 2>/dev/null)" ]; then
    mkdir -p "$(dirname "$OUT")"
    printf '%s\n' "$content" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    hyprctl reload >/dev/null
    log "$(t "appliqué : profil=${profile:-inconnu} batterie=$bat fréquence=$hz" "applied: profile=${profile:-unknown} battery=$bat refresh=$hz")"
  fi

  set_gpu_default "$profile" "$bat"
  proposer_nvidia "$profile" "$bat"
  guetter_rtx "$profile" "$bat"
  # Branchement, débranchement (pas au démarrage du service) : propositions du mode graphique (portable à MUX)
  [ -n "$avant" ] && [ "$bat" != "$avant" ] && mux_alimentation "$bat"
  noctalia_config "$profile" "$bat"

  # Bluetooth (si aucun appareil connecté) : coupé en Économie, rallumé en sortant
  # seulement si c'est ce script qui l'avait coupé.
  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ] && [ "$ECO_BLUETOOTH" = oui ]; then
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && [ -z "$(bluetoothctl devices Connected 2>/dev/null)" ]; then
      bluetoothctl power off >/dev/null 2>&1 && touch "$rt/nc-bt-off" && log "$(t "Bluetooth coupé (aucun appareil connecté)" "Bluetooth off (no device connected)")"
    fi
  elif [ "$profile" != power-saver ] && [ "$last_profile" = power-saver ]; then
    [ -e "$rt/nc-bt-off" ] && bluetoothctl power on >/dev/null 2>&1 && log "$(t "Bluetooth rallumé" "Bluetooth back on")"
    rm -f "$rt/nc-bt-off"
  fi

  # Rétroéclairage du clavier : éteint en Économie (ECO_CLAVIER), ramené au niveau 1 sur batterie hors Performance
  # (BAT_CLAVIER, s'il était plus haut) ; le niveau d'avant revient en sortant. Seulement aux changements : un niveau
  # choisi à la main entre-temps reste.
  local kbd kbd_mode=normal ref kbd_saved="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nc-kbd-saved"
  kbd=$(ls "$LEDS" 2>/dev/null | grep -m1 'kbd_backlight')
  if [ "$profile" = power-saver ] && [ "$ECO_CLAVIER" = oui ]; then kbd_mode=eteint
  elif [ "$bat" = 1 ] && [ "$profile" != performance ] && [ "$BAT_CLAVIER" = oui ]; then kbd_mode=bas
  fi
  if [ -n "$kbd" ] && [ -e "$LEDS/$kbd" ] && [ "$kbd_mode" != "$last_kbd" ]; then
    case $kbd_mode in
      eteint)
        # Ne pas écraser le niveau d'origine si le service redémarre alors qu'on est déjà en Économie.
        [ -e "$kbd_saved" ] || cat "$LEDS/$kbd/brightness" > "$kbd_saved"
        brightnessctl -q -d "$kbd" set 0 && log "$(t "rétroéclairage clavier éteint" "keyboard backlight off")" ;;
      bas)
        ref=$(cat "$kbd_saved" 2>/dev/null || cat "$LEDS/$kbd/brightness")
        if [ "${ref:-0}" -gt 1 ]; then
          [ -e "$kbd_saved" ] || echo "$ref" > "$kbd_saved"
          brightnessctl -q -d "$kbd" set 1 && log "$(t "rétroéclairage clavier au niveau 1 (batterie)" "keyboard backlight at level 1 (battery)")"
        elif [ -e "$kbd_saved" ]; then           # sortie d'Économie : le niveau d'avant, déjà 1 ou moins
          brightnessctl -q -d "$kbd" set "$ref" && log "$(t "rétroéclairage clavier restauré" "keyboard backlight restored")"
          rm -f "$kbd_saved"
        fi ;;
      *)
        if [ -r "$kbd_saved" ]; then
          brightnessctl -q -d "$kbd" set "$(cat "$kbd_saved")" && log "$(t "rétroéclairage clavier restauré" "keyboard backlight restored")"
          rm -f "$kbd_saved"
        fi ;;
    esac
  fi
  last_kbd=$kbd_mode

  if [ -n "$BACKLIGHT" ] && [ "$profile" = power-saver ] && [ "$last_profile" != power-saver ] && [ "$ECO_BRIGHTNESS_MAX" -gt 0 ]; then
    local cur max
    cur=$(brightnessctl -d "$BACKLIGHT" get 2>/dev/null) && max=$(brightnessctl -d "$BACKLIGHT" max 2>/dev/null) &&
      [ "${max:-0}" -gt 0 ] 2>/dev/null && [ $(( ${cur:-0} * 100 / max )) -gt "$ECO_BRIGHTNESS_MAX" ] && {
        brightnessctl -q -d "$BACKLIGHT" set "${ECO_BRIGHTNESS_MAX}%" && log "$(t "luminosité ramenée à ${ECO_BRIGHTNESS_MAX} %" "brightness lowered to ${ECO_BRIGHTNESS_MAX}%")"
      }
  fi
  last_profile=$profile
}

# Nouvelle session : l'environnement de Hyprland repart de la valeur uwsm, on force la resynchronisation.
# Le guet de la NVIDIA d'avant (s'il en reste un fichier) n'existe plus.
rm -f "$GPU_STATE" "$RTX_GUET"
apply

# Événements : changement de profil (tlp-pd) et de source d'alimentation (UPower). Vérification de secours toutes les 60 s.
{
  gdbus monitor --system --dest net.hadess.PowerProfiles &
  gdbus monitor --system --dest org.freedesktop.UPower --object-path /org/freedesktop/UPower &
  wait
} 2>/dev/null | while true; do
  read -r -t 60 _line
  rc=$?
  [ $rc -ne 0 ] && [ $rc -le 128 ] && { log "$(t "flux D-Bus interrompu" "D-Bus stream interrupted")"; exit 1; }
  sleep 0.3
  while read -r -t 0.2 _line; do :; done
  apply
done
