[Desktop Entry]
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
# Surcharge agent-linux : Discord utilise l'iGPU AMD (Mesa) pour laisser la RTX en veille.
# Supprimer ce fichier pour revenir au lanceur du paquet.
Exec=env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json __GLX_VENDOR_LIBRARY_NAME=mesa /usr/bin/discord --url -- %u
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
Path=/usr/bin
