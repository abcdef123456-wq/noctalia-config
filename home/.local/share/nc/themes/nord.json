          "border_width": 1
        }
      ],
      "start": [],
      "center": [
        "group:tout"
      ],
      "end": [
        "tray"
      ]
    },
    "widget.workspaces": {
      "style": "regular",
      "show_labels": true,
      "label_source": "id",
      "labels_only_when_occupied": false
    },
    "widget.t-taches": {
      "type": "taskbar",
      "show_running": true,
      "only_active_workspace": true,
      "show_window_title": false,
      "show_active_indicator": true,
      "active_indicator_color": "primary",
      "item_spacing": 8
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M}"
