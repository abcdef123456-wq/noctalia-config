{
  "nom": "synthwave",
  "libelle": {
    "fr": "Synthwave (néon des années 80)",
    "en": "Synthwave (80s neon)"
  },
  "palette": {
    "source": "custom",
    "nom": "Synthwave"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "degrade",
    "ILE_CONTOUR_EPAISSEUR": "2",
    "ILE_RAYON": "rond",
    "ILE_VERRE": "90",
    "ILE_ANIM": "ressort",
    "ILE_LUEUR": "oui",
    "FENETRES_ARRONDI": "4",
    "FENETRES_BORDURE": "3",
    "FENETRES_OMBRE": "34",
    "ILE_ACCENTS": "accent",
    "ILE_CONTOUR_FERMEE": "oui",
    "VERROU_COULEUR": "accent",
    "ILE_POLICE": "Orbitron, Inter",
    "ILE_MAJUSCULES": "non",
    "TERMINAL_POLICE": "FiraCode Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "86",
    "TERMINAL_MARGE": "12",
    "TERMINAL_CURSEUR": "block",
    "FENETRES_CARACTERE": "rebond",
    "FENETRES_OMBRE_DECALAGE": "auto",
    "FENETRES_DISPOSITION": "master",
    "FENETRES_COINS_FORME": "rond",
    "FENETRES_MAITRE_ORIENTATION": "haut",
    "DOCK": "non",
    "ILE_BANDE": "oui"
  },
  "noctalia": {
    "bar.default": {
      "position": "bottom",
      "margin_edge": 8,
      "margin_ends": 16,
      "thickness": 46,
      "capsule": true,
      "capsule_padding": 14,
      "widget_spacing": 12,
      "background_opacity": 0.0,
      "capsule_group": [
        {
          "id": "gauche",
          "members": [
            "logo",
            "workspaces"
          ]
        },
        {
          "id": "jour",
          "members": [
            "t-date"
          ]
        }
      ],
      "start": [
        "group:gauche"
      ],
      "center": [
        "group:jour"
      ],
      "end": [
        "tray",
        "group:status"
      ]
    },
    "widget.workspaces": {
      "style": "regular",
      "show_labels": false,
      "pill_scale": 1.3
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%A %d %B}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "synthwave",
  "fond_de_depart": "synthwave-soleil.jpg",
  "credits": [
    {
      "nom": "SynthWave '84 (couleurs de la palette)",
      "lien": "https://github.com/robb0wen/synthwave-vscode",
      "licence": "MIT"
    }
  ],
  "widgets": []
}
