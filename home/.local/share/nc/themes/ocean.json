{
  "nom": "ocean",
  "libelle": {
    "fr": "Océan (bleu profond)",
    "en": "Ocean (deep blue)"
  },
  "palette": {
    "source": "custom",
    "nom": "Ocean"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "degrade",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_CONTOUR_FERMEE": "non",
    "ILE_RAYON": "rond",
    "ILE_VERRE": "94",
    "ILE_POLICE": "Inter",
    "ILE_ANIM": "doux",
    "ILE_LUEUR": "oui",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "92",
    "TERMINAL_MARGE": "12",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "doux",
    "FENETRES_OMBRE_DECALAGE": "bas",
    "FENETRES_DISPOSITION": "master",
    "FENETRES_COINS_FORME": "rond",
    "FENETRES_MAITRE_ORIENTATION": "bas",
    "FENETRES_ARRONDI": "16",
    "FENETRES_BORDURE": "2",
    "FENETRES_OMBRE": "24",
    "ANIM_BUREAUX": "slidefadevert",
    "VERROU_COULEUR": "accent",
    "DOCK": "oui",
    "DOCK_POSITION": "left",
    "DOCK_AUTO": "oui",
    "DOCK_TAILLE": "44",
    "ILE_BANDE": "oui"
  },
  "noctalia": {
    "bar.default": {
      "position": "bottom",
      "margin_edge": 8,
      "margin_ends": 16,
      "thickness": 40,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_padding": 12,
      "widget_spacing": 10,
      "capsule_group": [
        {
          "id": "applis",
          "members": [
            "logo",
            "workspaces",
            "t-applis"
          ],
          "fill": "#0c2a47",
          "border": "#4fb3ff",
          "border_width": 2
        },
        {
          "id": "heure",
          "members": [
            "t-heure"
          ],
          "fill": "#4fb3ff",
          "foreground": "#06192e"
        },
        {
          "id": "etat",
          "members": [
            "tray",
            "network",
            "bluetooth",
            "volume",
            "nc/batterie:batterie"
          ],
          "fill": "#0c2a47",
          "border": "#2ec4b6",
          "border_width": 2
        },
        {
          "id": "sys",
          "fill": "#0c2a47",
          "border": "#2ec4b6",
          "border_width": 2
        }
      ],
      "start": [
        "group:applis"
      ],
      "center": [
        "group:heure"
      ],
      "end": [
        "group:etat"
      ]
    },
    "widget.workspaces": {
      "style": "regular",
      "show_labels": true,
      "pill_scale": 1.0,
      "label_source": "id",
      "labels_only_when_occupied": false
    },
    "widget.t-applis": {
      "type": "taskbar",
      "show_running": true,
      "only_active_workspace": true,
      "show_window_title": false,
      "show_active_indicator": true,
      "active_indicator_color": "primary",
      "item_spacing": 8
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M · %a %d}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "ocean",
  "fond_de_depart": "ocean-rayons.jpg",
  "credits": []
}
