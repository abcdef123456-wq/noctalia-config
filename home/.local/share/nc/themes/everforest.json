{
  "nom": "everforest",
  "libelle": {
    "fr": "Forêt (sombre, vert mousse)",
    "en": "Forest (dark, moss green)"
  },
  "palette": {
    "source": "custom",
    "nom": "Everforest"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "discret",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_CONTOUR_FERMEE": "non",
    "ILE_RAYON": "doux",
    "ILE_VERRE": "96",
    "ILE_POLICE": "Noto Serif, Inter",
    "ILE_ANIM": "doux",
    "ILE_LUEUR": "non",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "94",
    "TERMINAL_MARGE": "12",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "doux",
    "FENETRES_GESTE": "eventail",
    "FENETRES_OMBRE_DECALAGE": "bas",
    "FENETRES_DISPOSITION": "dwindle",
    "FENETRES_COINS_FORME": "doux",
    "FENETRES_MAITRE_ORIENTATION": "auto",
    "FENETRES_ARRONDI": "12",
    "FENETRES_BORDURE": "2",
    "FENETRES_OMBRE": "22",
    "ANIM_BUREAUX": "slidefade",
    "VERROU_COULEUR": "accent",
    "DOCK": "non",
    "ILE_BANDE": "non"
  },
  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 6,
      "margin_ends": 16,
      "thickness": 40,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_thickness": 0.74,
      "widget_spacing": 12,
      "font_weight": 600,
      "capsule_group": [
        {
          "id": "bureaux",
          "members": [
            "logo",
            "workspaces"
          ],
          "fill": "#a7c080",
          "foreground": "#2d353b",
          "padding": 12
        },
        {
          "id": "fenetre",
          "members": [
            "nc/fenetres:titre"
          ],
          "fill": "#475258",
          "foreground": "#d3c6aa",
          "padding": 12
        },
        {
          "id": "plateau",
          "members": [
            "tray"
          ],
          "fill": "#475258",
          "foreground": "#d3c6aa",
          "padding": 12
        },
        {
          "id": "jour",
          "members": [
            "t-date"
          ],
          "fill": "#dbbc7f",
          "foreground": "#2d353b",
          "padding": 12
        },
        {
          "id": "status",
          "fill": "#2f4a46",
          "foreground": "#d3c6aa",
          "padding": 12
        },
        {
          "id": "sys",
          "fill": "#475258",
          "foreground": "#d3c6aa",
          "padding": 12
        }
      ],
      "start": [
        "group:bureaux",
        "group:fenetre"
      ],
      "center": [],
      "end": [
        "group:plateau",
        "group:status",
        "group:jour"
      ]
    },
    "widget.workspaces": {
      "style": "minimal",
      "show_labels": true,
      "label_source": "id",
      "labels_only_when_occupied": false,
      "focused_color": "#1e2326",
      "occupied_color": "#4f5b58",
      "empty_color": "#7a8478"
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%a %d %b}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "everforest",
  "fond_de_depart": "everforest-sapins.jpg",
  "credits": [
    {
      "nom": "Everforest (palette moyenne, sombre et claire)",
      "lien": "https://github.com/sainnhe/everforest/blob/master/palette.md",
      "licence": "MIT"
    }
  ]
}
