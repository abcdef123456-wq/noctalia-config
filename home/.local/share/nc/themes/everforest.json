{
  "nom": "everforest",
  "libelle": {
    "fr": "Forêt (sombre, vert mousse)",
    "en": "Forest (dark, moss green)"
  },
  "palette": {
    "source": "custom",
    "nom": "Everforest"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "discret",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_CONTOUR_FERMEE": "non",
    "ILE_RAYON": "doux",
    "ILE_VERRE": "96",
    "ILE_POLICE": "Noto Serif, Inter",
    "ILE_ANIM": "doux",
    "ILE_LUEUR": "non",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "94",
    "TERMINAL_MARGE": "12",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "doux",
    "FENETRES_OMBRE_DECALAGE": "bas",
    "FENETRES_DISPOSITION": "dwindle",
    "FENETRES_COINS_FORME": "doux",
    "FENETRES_MAITRE_ORIENTATION": "auto",
    "FENETRES_ARRONDI": "12",
    "FENETRES_BORDURE": "2",
    "FENETRES_OMBRE": "22",
    "ANIM_BUREAUX": "slidefade",
    "VERROU_COULEUR": "accent",
    "DOCK": "non",
    "ILE_BANDE": "non"
  },
  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 0,
      "margin_ends": 16,
      "thickness": 40,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_thickness": 0.72,
      "capsule_padding": 12,
      "widget_spacing": 12,
      "capsule_group": [
        {
          "id": "gauche",
          "members": [
            "logo",
            "workspaces"
          ],
          "fill": "#343F44",
          "border": "#A7C080",
          "border_width": 2
        },
        {
          "id": "fenetre",
          "members": [
            "nc/fenetres:titre"
          ],
          "fill": "#343F44"
        },
        {
          "id": "plateau",
          "members": [
            "tray"
          ],
          "fill": "#343F44"
        },
        {
          "id": "jour",
          "members": [
            "t-date"
          ],
          "fill": "#A7C080",
          "foreground": "#2D353B"
        },
        {
          "id": "status",
          "fill": "#343F44",
          "border": "#7FBBB3",
          "border_width": 2
        },
        {
          "id": "sys",
          "fill": "#343F44",
          "border": "#7FBBB3",
          "border_width": 2
        }
      ],
      "start": [
        "group:gauche",
        "group:fenetre"
      ],
      "center": [],
      "end": [
        "group:plateau",
        "group:status",
        "group:jour"
      ]
    },
    "widget.workspaces": {
      "style": "regular",
      "show_labels": true,
      "label_source": "name"
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%a %d %b}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "everforest",
  "fond_de_depart": "everforest-sapins.jpg",
  "credits": [
    {
      "nom": "Everforest (palette moyenne, sombre et claire)",
      "lien": "https://github.com/sainnhe/everforest/blob/master/palette.md",
      "licence": "MIT"
    }
  ],
  "widgets": []
}
