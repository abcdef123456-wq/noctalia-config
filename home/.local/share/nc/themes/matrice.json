        }
      ],
      "start": [
        "group:gauche"
      ],
      "center": [],
      "end": [
        "group:droite"
      ]
    },
    "widget.workspaces": {
      "style": "focus_hint",
      "show_labels": true,
      "label_source": "id",
      "labels_only_when_occupied": false
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M}"
    }
