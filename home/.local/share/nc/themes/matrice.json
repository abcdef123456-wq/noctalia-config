        {
          "id": "tout",
          "members": [
            "logo",
            "workspaces",
            "network",
            "bluetooth",
            "volume",
            "nc/batterie:batterie",
            "t-heure"
          ],
          "fill": "#0d0d0d",
          "foreground": "#f2f2f2",
          "border": "#ffffff",
          "border_width": 1
        }
      ],
      "start": [],
      "center": [
        "group:tout"
      ],
      "end": []
    },
    "widget.workspaces": {
      "style": "focus_hint",
      "show_labels": true,
      "label_source": "id",
      "labels_only_when_occupied": false
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M}"
    }
