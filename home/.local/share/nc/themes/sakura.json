    "ILE_POLICE": "Noto Serif JP, Noto Serif, Inter",
    "ILE_ANIM": "doux",
    "ILE_LUEUR": "non",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "94",
    "TERMINAL_MARGE": "14",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "doux",
    "FENETRES_OMBRE_DECALAGE": "bas",
    "FENETRES_DISPOSITION": "master",
    "FENETRES_COINS_FORME": "rond",
