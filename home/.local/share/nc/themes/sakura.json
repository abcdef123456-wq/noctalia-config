  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 8,
      "margin_ends": 18,
      "thickness": 34,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_padding": 14,
      "widget_spacing": 12,
      "capsule_group": [
        {
          "id": "gauche",
          "members": [
            "logo",
            "workspaces"
          ],
          "fill": "#f7b6c8",
          "foreground": "#4a1f2c"
        },
        {
          "id": "droite",
          "members": [
            "tray",
            "t-date"
          ],
          "fill": "#c2255c",
          "foreground": "#ffffff"
        },
        {
          "id": "status",
          "fill": "#fde4ec",
          "foreground": "#4a1f2c",
          "border": "#e8799a",
          "border_width": 1
        },
        {
          "id": "sys",
          "fill": "#fde4ec",
          "foreground": "#4a1f2c",
          "border": "#e8799a",
          "border_width": 1
        }
      ],
      "start": [
        "group:gauche"
      ],
      "center": [],
      "end": [
        "group:status",
        "group:droite"
      ]
    },
    "widget.workspaces": {
      "style": "minimal",
      "show_labels": true,
      "label_source": "name"
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%d %B}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "noire"
  },
  "fonds": "sakura",
