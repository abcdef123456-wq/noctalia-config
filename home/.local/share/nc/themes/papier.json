{
  "nom": "papier",
  "libelle": {
    "fr": "Papier (clair, encre)",
    "en": "Paper (light, ink)"
  },
  "palette": {
    "source": "custom",
    "nom": "Papier"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "discret",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_CONTOUR_FERMEE": "oui",
    "ILE_RAYON": "carre",
    "ILE_VERRE": "100",
    "ILE_POLICE": "Source Serif 4, Noto Serif, Inter",
    "ILE_ANIM": "sec",
    "ILE_LUEUR": "non",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "100",
    "TERMINAL_MARGE": "10",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "aucun",
    "FENETRES_OMBRE_DECALAGE": "aucun",
    "FENETRES_DISPOSITION": "scrolling",
    "FENETRES_COINS_FORME": "carres",
    "FENETRES_MAITRE_ORIENTATION": "auto",
    "FENETRES_ARRONDI": "0",
    "FENETRES_BORDURE": "1",
    "FENETRES_OMBRE": "8",
    "FENETRES_ANIMATIONS": "non",
    "ANIM_BUREAUX": "fade",
    "VERROU_COULEUR": "blanc",
    "DOCK": "non",
    "THEME_MODE": "light"
  },
  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 0,
      "margin_ends": 8,
      "thickness": 40,
      "capsule": true,
      "background_opacity": 1.0,
      "capsule_fill": "surface_variant",
      "capsule_opacity": 1.0,
      "capsule_thickness": 0.78,
      "capsule_padding": 12,
      "widget_spacing": 8,
      "capsule_group": [
        {
          "id": "bureaux",
          "members": [
            "workspaces"
          ],
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        },
        {
          "id": "fenetre",
          "members": [
            "nc/fenetres:titre"
          ],
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        },
        {
          "id": "plateau",
          "members": [
            "tray"
          ],
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        },
        {
          "id": "jour",
          "members": [
            "t-date"
          ],
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        },
        {
          "id": "status",
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        },
        {
          "id": "sys",
          "fill": "#fffdf7",
          "foreground": "#111111",
          "border": "#111111",
          "border_width": 2,
          "radius": 0
        }
      ],
      "start": [
        "group:bureaux",
        "group:fenetre"
      ],
      "center": [],
      "end": [
        "group:plateau",
        "group:status",
        "group:jour"
      ]
    },
    "widget.workspaces": {
      "style": "minimal",
      "show_labels": true,
      "label_source": "id",
      "labels_only_when_occupied": false,
      "focused_color": "on_surface"
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%A %d %B}"
    }
  },
  "theme_sync": {
    "bordure": "gris",
    "ombre": "noire"
  },
  "fonds": "papier",
  "fond_de_depart": "papier-estampe.jpg",
  "credits": [],
  "widgets": []
}
