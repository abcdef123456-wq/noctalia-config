  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 8,
      "margin_ends": 24,
      "thickness": 38,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_padding": 14,
      "widget_spacing": 10,
      "capsule_group": [
        {
          "id": "un",
          "members": [
            "workspaces",
            "tray",
            "network",
            "bluetooth",
            "volume",
            "nc/batterie:batterie",
            "t-date"
          ]
        }
      ],
      "start": [],
      "center": [],
      "end": [
        "group:un"
      ]
    },
    "widget.workspaces": {
      "style": "minimal",
      "show_labels": true,
      "label_source": "name"
    },
    "dock": {
      "margin_edge": 14,
      "radius": 24
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%d/%m}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "vaporwave",
