{
  "nom": "tokyo",
  "libelle": {
    "fr": "Tokyo Night (néons de nuit)",
    "en": "Tokyo Night (night neons)"
  },
  "palette": {
    "source": "builtin",
    "nom": "Tokyo-Night"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "degrade",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_RAYON": "doux",
    "ILE_VERRE": "92",
    "ILE_ANIM": "vif",
    "ILE_LUEUR": "oui",
    "FENETRES_ARRONDI": "12",
    "FENETRES_BORDURE": "2",
    "FENETRES_OMBRE": "26",
    "ANIM_BUREAUX": "slidefade",
    "ILE_ACCENTS": "accent",
    "ILE_CONTOUR_FERMEE": "oui",
    "ILE_POLICE": "JetBrains Mono, Inter",
    "ILE_MAJUSCULES": "non",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "88",
    "TERMINAL_MARGE": "10",
    "TERMINAL_CURSEUR": "block",
    "FENETRES_CARACTERE": "vif",
    "FENETRES_OMBRE_DECALAGE": "auto",
    "FENETRES_DISPOSITION": "master",
    "FENETRES_MAITRE_ORIENTATION": "droite",
    "FENETRES_COINS_FORME": "doux",
    "DOCK": "non",
    "DOCK_POSITION": "bottom",
    "DOCK_AUTO": "non",
    "BARRE_SYSTEME": "non"
  },
  "noctalia": {
    "bar.default": {
      "position": "top",
      "margin_edge": 0,
      "margin_ends": 8,
      "thickness": 40,
      "background_opacity": 0.85,
      "capsule": true,
      "widget_spacing": 10,
      "capsule_group": [
        {
          "id": "jauges",
          "members": [
            "t-cpu",
            "t-temp",
            "t-ram",
            "t-disque"
          ]
        },
        {
          "id": "jour",
          "members": [
            "t-date"
          ]
        }
      ],
      "start": [
        "logo",
        "workspaces",
        "nc/fenetres:titre"
      ],
      "center": [],
      "end": [
        "tray",
        "group:jauges",
        "group:status",
        "group:jour"
      ]
    },
    "bar.bas": {
      "position": "bottom",
      "margin_edge": 6,
      "thickness": 44,
      "background_opacity": 0.0,
      "capsule": true,
      "capsule_padding": 12,
      "start": [],
      "center": [
        "t-taches"
      ],
      "end": []
    },
    "widget.workspaces": {
      "style": "regular",
      "show_labels": true,
      "label_source": "id"
    },
    "widget.t-cpu": {
      "type": "sysmon",
      "stat": "cpu_usage",
      "visualization": "gauge",
      "show_value": true
    },
    "widget.t-temp": {
      "type": "sysmon",
      "stat": "cpu_temp",
      "visualization": "gauge",
      "show_value": true
    },
    "widget.t-ram": {
      "type": "sysmon",
      "stat": "ram_used",
      "visualization": "gauge",
      "show_value": true
    },
    "widget.t-disque": {
      "type": "sysmon",
      "stat": "disk_used_pct",
      "visualization": "gauge",
      "show_value": true
    },
    "widget.t-taches": {
      "type": "taskbar",
      "show_running": true,
      "show_window_title": false,
      "show_active_indicator": true,
      "active_indicator_color": "primary",
      "item_spacing": 10,
      "icon_scale": 1.2
    },
    "widget.t-date": {
      "type": "clock",
      "format": "{:%a %d %b}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "tokyo",
  "fond_de_depart": "shinjuku-pluie.jpg",
  "credits": [],
  "widgets": []
}
