{
  "nom": "retro",
  "libelle": {
    "fr": "Rétro terminal (phosphore vert)",
    "en": "Retro terminal (green phosphor)"
  },
  "palette": {
    "source": "custom",
    "nom": "Retro"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "discret",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_RAYON": "carre",
    "ILE_VERRE": "100",
    "ILE_ANIM": "sec",
    "ILE_POLICE": "JetBrains Mono, DejaVu Sans Mono",
    "ILE_MAJUSCULES": "oui",
    "FENETRES_ARRONDI": "0",
    "FENETRES_BORDURE": "1",
    "FENETRES_OMBRE": "10",
    "ANIM_BUREAUX": "slide",
    "ILE_ACCENTS": "accent",
    "ILE_CONTOUR_FERMEE": "oui",
    "VERROU_COULEUR": "accent",
    "ILE_LUEUR": "non",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "100",
    "TERMINAL_MARGE": "6",
    "TERMINAL_CURSEUR": "block",
    "FENETRES_CARACTERE": "aucun",
    "FENETRES_OMBRE_DECALAGE": "dure",
    "FENETRES_DISPOSITION": "master",
    "FENETRES_COINS_FORME": "carres",
    "FENETRES_MAITRE_ORIENTATION": "bas",
    "FENETRES_ESPACE": "0",
    "DOCK": "non",
    "ILE_BANDE": "oui",
    "ILE_FORME": "cadre"
  },
  "noctalia": {
    "bar.default": {
      "position": "bottom",
      "margin_edge": 0,
      "margin_ends": 0,
      "thickness": 26,
      "capsule": false,
      "background_opacity": 1.0,
      "widget_spacing": 12,
      "start": [
        "t-session",
        "workspaces",
        "t-titre"
      ],
      "center": [],
      "end": [
        "volume",
        "nc/batterie:batterie",
        "t-heure"
      ],
      "radius": 0,
      "padding": 12
    },
    "widget.workspaces": {
      "style": "minimal",
      "show_labels": true,
      "label_source": "id"
    },
    "widget.t-session": {
      "type": "text",
      "text": "[nc]"
    },
    "widget.t-titre": {
      "type": "active_window",
      "display": "text_only",
      "max_length": 420,
      "title_scroll": "none"
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M %d-%b-%y}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "coloree"
  },
  "fonds": "retro",
  "fond_de_depart": "retro-grille.jpg",
  "credits": [],
  "widgets": []
}
