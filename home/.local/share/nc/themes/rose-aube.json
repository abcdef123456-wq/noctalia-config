{
  "nom": "rose-aube",
  "libelle": {
    "fr": "Rose aube (clair, serif doux)",
    "en": "Dawn rose (light, soft serif)"
  },
  "palette": {
    "source": "custom",
    "nom": "RoseAube"
  },
  "reglages": {
    "ILE_STYLE": "terminal",
    "ILE_CONTOUR": "discret",
    "ILE_CONTOUR_EPAISSEUR": "1",
    "ILE_CONTOUR_FERMEE": "non",
    "ILE_RAYON": "rond",
    "ILE_VERRE": "100",
    "ILE_POLICE": "Source Serif 4, Noto Serif, Inter",
    "ILE_ANIM": "doux",
    "ILE_LUEUR": "non",
    "ILE_MAJUSCULES": "non",
    "ILE_ACCENTS": "accent",
    "TERMINAL_POLICE": "JetBrainsMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono",
    "TERMINAL_OPACITE": "96",
    "TERMINAL_MARGE": "12",
    "TERMINAL_CURSEUR": "beam",
    "FENETRES_CARACTERE": "doux",
    "FENETRES_GESTE": "goutte",
    "FENETRES_OMBRE_DECALAGE": "bas",
    "FENETRES_DISPOSITION": "dwindle",
    "FENETRES_COINS_FORME": "doux",
    "FENETRES_MAITRE_ORIENTATION": "auto",
    "FENETRES_ARRONDI": "14",
    "FENETRES_BORDURE": "1",
    "FENETRES_OMBRE": "18",
    "ANIM_BUREAUX": "fade",
    "VERROU_COULEUR": "blanc",
    "DOCK": "non",
    "DOCK_POSITION": "bottom",
    "DOCK_AUTO": "non",
    "DOCK_TAILLE": "48",
    "THEME_MODE": "light",
    "ILE_BANDE": "oui"
  },
  "noctalia": {
    "bar.default": {
      "position": "bottom",
      "margin_edge": 8,
      "margin_ends": 16,
      "thickness": 44,
      "capsule": true,
      "background_opacity": 0.0,
      "capsule_padding": 14,
      "widget_spacing": 10,
      "capsule_group": [
        {
          "id": "gauche",
          "members": [
            "logo",
            "workspaces"
          ],
          "fill": "#fbe9ec",
          "foreground": "#3d2a32"
        },
        {
          "id": "dock",
          "members": [
            "t-dock"
          ],
          "fill": "#fbe9ec",
          "foreground": "#3d2a32",
          "border": "#d9778f",
          "border_width": 2
        },
        {
          "id": "droite",
          "members": [
            "network",
            "bluetooth",
            "volume",
            "nc/batterie:batterie",
            "t-heure"
          ],
          "fill": "#fbe9ec",
          "foreground": "#3d2a32"
        },
        {
          "id": "sys",
          "fill": "#fbe9ec",
          "foreground": "#3d2a32"
        }
      ],
      "start": [
        "group:gauche"
      ],
      "center": [
        "group:dock"
      ],
      "end": [
        "tray",
        "group:droite"
      ]
    },
    "widget.workspaces": {
      "style": "focus_hint",
      "show_labels": true,
      "label_source": "name"
    },
    "dock": {
      "radius": 30
    },
    "widget.t-dock": {
      "type": "taskbar",
      "show_running": true,
      "show_window_title": false,
      "show_active_indicator": true,
      "active_indicator_color": "primary",
      "item_spacing": 10,
      "icon_scale": 1.1
    },
    "widget.t-heure": {
      "type": "clock",
      "format": "{:%H:%M}"
    }
  },
  "theme_sync": {
    "bordure": "degrade",
    "ombre": "noire"
  },
  "fonds": "rose-aube",
  "fond_de_depart": "rose-aube-collines.jpg",
  "credits": [
    {
      "nom": "Rosé Pine Dawn (palette d'origine, primaire assombri pour le contraste)",
      "lien": "https://rosepinetheme.com/palette/",
      "licence": "MIT"
    }
  ],
  "widgets": []
}
