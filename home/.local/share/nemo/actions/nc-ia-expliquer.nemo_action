# Clic droit dans Nemo : l'IA du bureau (nc-ia) ; réponse en notification et copiée
[Nemo Action]
Name=IA : Expliquer
Name[en]=AI: Explain
Comment=nc-ia fichier
Exec=sh -c 'exec "$HOME/.local/bin/nc-ia" fichier "$@" expliquer --notifier' _ %F
Icon-Name=dialog-information
Selection=notnone
Extensions=any;
